import deployment.checked_program_digest
import std.io.write_text
import std.list.get
import std.list.length
import std.process.arguments
import std.result.Result
import std.text.length

fn main() {
    let args = arguments()
    assert std.list.length(args) == 4
    match checked_program_digest(get(args, 1), get(args, 2), get(args, 3)) {
        Result.Ok(value) => {
            assert std.text.length(value) == 64
            discard write_text(value)
        }
        Result.Err(_) => {
            assert false
        }
    }
}
