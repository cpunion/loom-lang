import std.list.new
import std.list.get
import std.list.push
import std.list.set
import std.list.length
import std.result.Result

fn orders(predicate Text) Table {
    let columns = new[Column]()
    push(columns, Column {
            id = "amount"
            name = "amount"
            kind = StorageType.Float
            required = true
            predicate = predicate
        })
    Table {
        id = "orders"
        name = "orders"
        columns = columns
    }
}

fn version(basis Text, predicate Text, notes Bool) Schema {
    let tables = new[Table]()
    push(tables, orders(predicate))
    if notes {
        let columns = new[Column]()
        push(columns, Column {
                id = "body"
                name = "body"
                kind = StorageType.Text
                required = true
                predicate = ""
            })
        push(tables, Table {
                id = "notes"
                name = "notes"
                columns = columns
            })
    }
    Schema {
        basis = basis
        tables = tables
    }
}

test fn direct_upgrade_and_downgrade_report_actual_conflicts() {
    let v1 = version("checked-v1", "amount >= 0", false)
    let v2 = version("checked-v2", "amount > 0", true)
    match conflicts(v1, v2) {
        Result.Ok(found) => {
            assert length(found) == 3
            let conflict = get(found, 0)
            assert conflict.kind == ConflictKind.ChangedPredicate
            assert conflict.table == "orders" && conflict.column == "amount"
            assert get(found, 1).kind == ConflictKind.AddedTable
            assert get(found, 1).table == "notes"
            assert get(found, 2).kind == ConflictKind.ChangedBasis
        }
        Result.Err(_) => {
            assert false
        }
    }
    match conflicts(v2, v1) {
        Result.Ok(found) => {
            assert length(found) == 3
            assert get(found, 0).kind == ConflictKind.ChangedPredicate
            assert get(found, 1).kind == ConflictKind.RemovedTable
            assert get(found, 1).table == "notes"
            assert get(found, 2).kind == ConflictKind.ChangedBasis
        }
        Result.Err(_) => {
            assert false
        }
    }
}

test fn a_hotfix_cannot_hide_a_schema_conflict_behind_a_version_label() {
    let same = conflicts(version("checked-v1", "amount >= 0", false), version("checked-hotfix", "amount >= 0", false))
    assert match same {
        Result.Ok(found) => length(found) == 1 && get(found, 0).kind == ConflictKind.ChangedBasis,
        Result.Err(_) => false
    }
    let changed = conflicts(version("checked-v1", "amount >= 0", false), version("checked-hotfix", "amount > 0", false))
    assert match changed {
        Result.Ok(found) => length(found) == 2,
        Result.Err(_) => false
    }
}

test fn duplicate_persistent_id_is_not_silently_unified() {
    let tables = new[Table]()
    push(tables, orders(""))
    push(tables, Table {
            id = "orders"
            name = "other"
            columns = new[Column]()
        })
    assert match validate(Schema {
            basis = "checked"
            tables = tables
        }) {
        Result.Ok(_) => false,
        Result.Err(_) => true
    }
}

test fn adding_optional_column_still_requires_a_physical_change() {
    let previous = version("checked-v1", "", false)
    let next = version("checked-v2", "", false)
    push(get(next.tables, 0).columns, Column {
            id = "label"
            name = "label"
            kind = StorageType.Text
            required = false
            predicate = ""
        })
    match conflicts(previous, next) {
        Result.Ok(found) => {
            assert length(found) == 2
            assert get(found, 0).kind == ConflictKind.AddedColumn
            assert get(found, 1).kind == ConflictKind.ChangedBasis
        }
        Result.Err(_) => {
            assert false
        }
    }
}

test fn changing_requiredness_needs_migration_coverage_in_both_directions() {
    let strict = version("strict", "", false)
    let optional = version("optional", "", false)
    let columns = get(optional.tables, 0).columns
    set(columns, 0, Column {
            required = false,
            ..get(columns, 0)
        })
    let directions = [(strict, optional), (optional, strict)]
    var index = 0
    while index < length(directions) {
        let from, to = get(directions, index)
        assert match conflicts(from, to) {
            Result.Ok(found) => length(found) == 2 &&
            get(found, 0).kind == ConflictKind.ChangedRequiredColumn &&
            get(found, 0).table == "orders" && get(found, 0).column == "amount"
            Result.Err(_) => false
        }
        let handlers = [Handling {
                kind = ConflictKind.ChangedBasis
                table = ""
                column = ""
                action = "verify_behavior"
            }]
        let catalog = MigrationCatalog {
            from_basis = from.basis
            to_basis = to.basis
            forward = handlers
            recovery = handlers
        }
        assert match coverage(from, to, catalog) {
            Result.Ok(missing) => length(missing.forward) == 1 && length(missing.recovery) == 1 &&
            get(missing.forward, 0).kind == ConflictKind.ChangedRequiredColumn &&
            get(missing.recovery, 0).kind == ConflictKind.ChangedRequiredColumn
            Result.Err(_) => false
        }
        push(handlers, Handling {
                kind = ConflictKind.ChangedRequiredColumn
                table = "orders"
                column = "amount"
                action = "change_requiredness"
            })
        assert match coverage(from, to, catalog) {
            Result.Ok(missing) => length(missing.forward) == 0 && length(missing.recovery) == 0
            Result.Err(_) => false
        }
        index = index + 1
    }
}
