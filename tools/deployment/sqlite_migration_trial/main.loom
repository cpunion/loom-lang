fn sql_bytes(value Text) Bytes {
    let output = std.bytes.new()
    var index = 0
    while index < std.text.length(value) {
        std.bytes.push(output, byte(value, index))
        index = index + 1
    }
    output
}

// Fixed test-fixture SQL only. The production upgrade API never accepts SQL.
fn fixture_sql(database Text, sql Text) Result[Text, Text] {
    let args = std.list.new[Text]()
    std.list.push(args, "/usr/bin/sqlite3")
    std.list.push(args, "-batch")
    std.list.push(args, "-bail")
    std.list.push(args, "-list")
    std.list.push(args, "--")
    std.list.push(args, database)
    match capture_input(args, sql_bytes(sql)) {
        Result.Ok(output) => match output.status {
            ExitStatus.Exited(code) => {
                if code == 0 {
                    Result.Ok(to_text(output.stdout))
                } else {
                    Result.Err("SQLite fixture failed")
                }
            }
            ExitStatus.Terminated => Result.Err("SQLite fixture terminated")
        },
        Result.Err(_) => Result.Err("cannot start SQLite fixture")
    }
}

fn hotfix_candidate(schema Schema, receipt Text) Result[Schema, Text] {
    bind_receipt_basis(Schema {
            basis = ""
            tables = schema.tables
        }, receipt)
}

fn started(database Text, bundle SqliteMigrationPackage, hotfix_receipt Text) Result[Bool, Text] {
    discard assume_historical("/usr/bin/sqlite3", database, "historical_v1", bundle.from_schema.basis)?
    let candidate = hotfix_candidate(bundle.from_schema, hotfix_receipt)?
    let hotfix = inspect_hotfix("/usr/bin/sqlite3", database, bundle.from_schema,
        candidate, bundle.from_receipt_path, hotfix_receipt)?
    assert match hotfix.starting {
        BasisEvidence.Assumed(basis) => basis == bundle.from_schema.basis,
        _ => false
    }
    assert hotfix.declared_mapping_unchanged &&
    hotfix.compatibility == HotfixCompatibility.Unproven && !hotfix.can_execute
    assert fixture_sql(database, "SELECT count(*) FROM loom_deploy_events;")? == "2\n"
    let inspection = inspect_sqlite_migration("/usr/bin/sqlite3", database, bundle)?
    assert match inspection.evidence {
        BasisEvidence.Assumed(basis) => basis == bundle.from_schema.basis,
        _ => false
    }
    assert length(inspection.missing.forward) == 0 && length(inspection.missing.recovery) == 0
    discard start_sqlite_migration("/usr/bin/sqlite3", database, bundle)?
    assert match inspect_hotfix("/usr/bin/sqlite3", database, bundle.from_schema,
        candidate, bundle.from_receipt_path, hotfix_receipt) {
        Result.Err(_) => true,
        Result.Ok(_) => false
    }
    Result.Ok(true)
}

fn changed_receipt_path(bundle SqliteMigrationPackage, path Text) SqliteMigrationPackage {
    SqliteMigrationPackage {
        id = bundle.id
        from_schema = bundle.from_schema
        to_schema = bundle.to_schema
        from_receipt_path = bundle.from_receipt_path
        to_receipt_path = path
        from_receipt_id = bundle.from_receipt_id
        to_receipt_id = bundle.to_receipt_id
        policy = bundle.policy
        catalog = bundle.catalog
        reupgrade = bundle.reupgrade
        operation = bundle.operation
    }
}

fn succeeds(database Text, old_receipt Text, new_receipt Text,
    hotfix_receipt Text) Result[Bool, Text] {
    discard fixture_sql(database, "CREATE TABLE \"orders\"(\"id\" INTEGER PRIMARY KEY, \"amount\" INTEGER NOT NULL CHECK(\"amount\">=0)) STRICT; INSERT INTO orders VALUES (1,0),(2,10),(3,0);")?
    let bundle = migration("orders_first", "upgrade_2", 1, old_receipt, new_receipt)?
    discard started(database, bundle, hotfix_receipt)?
    assert match inspect_live_sqlite_downgrade("/usr/bin/sqlite3", database, bundle) {
        Result.Err(_) => true,
        Result.Ok(_) => false
    }
    let events_before_live = fixture_sql(database, "SELECT count(*) FROM loom_deploy_events;")?
    let live = inspect_live_sqlite_upgrade("/usr/bin/sqlite3", database, bundle,
        SqliteLivePhase.FreshUpgrade)?
    assert live.attempt_state == DeploymentState.Started &&
    live.status == SqliteLiveStatus.ChecksPassed && !live.requires_resume
    assert fixture_sql(database, "SELECT count(*) FROM loom_deploy_events;")? == events_before_live
    discard fixture_sql(database, "PRAGMA ignore_check_constraints=ON; UPDATE orders SET amount=-1 WHERE id=1;")?
    let invalid_rows = inspect_live_sqlite_upgrade("/usr/bin/sqlite3", database, bundle,
        SqliteLivePhase.FreshUpgrade)?
    assert invalid_rows.status == SqliteLiveStatus.DataOrLineageMismatch
    discard fixture_sql(database, "UPDATE orders SET amount=0 WHERE id=1;")?
    assert fixture_sql(database, "SELECT state FROM loom_deploy_events WHERE attempt_id='historical_v1' ORDER BY sequence;")? == "0\n7\n"
    assert match sqlite_migration_identity(changed_receipt_path(bundle, old_receipt)) {
        Result.Err(_) => true,
        Result.Ok(_) => false
    }
    discard upgrade_sqlite_migration("/usr/bin/sqlite3", database, bundle)?
    let candidate = hotfix_candidate(bundle.from_schema, hotfix_receipt)?
    assert match inspect_hotfix("/usr/bin/sqlite3", database, bundle.from_schema,
        candidate, old_receipt, hotfix_receipt) {
        Result.Err(_) => true,
        Result.Ok(_) => false
    }
    assert match current("/usr/bin/sqlite3", database)? {
        BasisEvidence.Observed(basis) => basis == bundle.to_schema.basis,
        _ => false
    }
    assert fixture_sql(database, "SELECT id,amount FROM orders ORDER BY id;")? == "1|1\n2|10\n3|1\n"
    assert fixture_sql(database, "SELECT entity_id,original_amount FROM loom_archive_zero_amounts ORDER BY entity_id;")? == "1|0\n3|0\n"
    assert fixture_sql(database, "SELECT count(*) FROM notes;")? == "0\n"
    assert fixture_sql(database, "SELECT count(*) FROM loom_deploy_events WHERE attempt_id='upgrade_2' AND state=3;")? == "1\n"
    assert match fixture_sql(database, "INSERT INTO orders VALUES (3,0);") {
        Result.Err(_) => true,
        Result.Ok(_) => false
    }
    assert match fixture_sql(database, "UPDATE orders SET amount=0 WHERE id=2;") {
        Result.Err(_) => true,
        Result.Ok(_) => false
    }
    assert match fixture_sql(database, "INSERT INTO orders VALUES (5,'bogus');") {
        Result.Err(_) => true,
        Result.Ok(_) => false
    }
    assert match fixture_sql(database, "INSERT INTO notes VALUES (2,x'ff');") {
        Result.Err(_) => true,
        Result.Ok(_) => false
    }
    assert fixture_sql(database, "SELECT entity_id,original_amount,restorable FROM loom_archive_zero_amounts ORDER BY entity_id;")? == "1|0|1\n3|0|1\n"
    discard fixture_sql(database, "UPDATE orders SET id=id, amount=amount WHERE id=3;")?
    assert fixture_sql(database, "SELECT restorable FROM loom_archive_zero_amounts WHERE entity_id=3;")? == "1\n"
    discard fixture_sql(database, "UPDATE orders SET amount=2 WHERE id=1;")?
    assert fixture_sql(database, "SELECT entity_id,original_amount,restorable FROM loom_archive_zero_amounts ORDER BY entity_id;")? == "1|0|0\n3|0|1\n"
    discard fixture_sql(database, "INSERT INTO notes VALUES (1,'retained');")?
    let before_downgrade_inspection = fixture_sql(database, "SELECT count(*) FROM loom_deploy_events;")?
    let downgrade_source = inspect_live_sqlite_downgrade("/usr/bin/sqlite3", database, bundle)?
    assert downgrade_source.attempt_state == DeploymentState.Complete &&
    downgrade_source.status == SqliteLiveStatus.ChecksPassed && !downgrade_source.requires_retry
    assert fixture_sql(database, "SELECT count(*) FROM loom_deploy_events;")? == before_downgrade_inspection
    let unrelated = migration("orders_unrelated", "upgrade_2", 1, old_receipt, new_receipt)?
    assert match inspect_live_sqlite_downgrade("/usr/bin/sqlite3", database, unrelated) {
        Result.Err(_) => true,
        Result.Ok(_) => false
    }
    discard fixture_sql(database, "UPDATE loom_archive_zero_amounts SET original_amount=1 WHERE entity_id=3;")?
    let damaged_archive = inspect_live_sqlite_downgrade("/usr/bin/sqlite3", database, bundle)?
    assert damaged_archive.status == SqliteLiveStatus.DataOrLineageMismatch
    assert fixture_sql(database, "SELECT count(*) FROM loom_deploy_events;")? == before_downgrade_inspection
    discard fixture_sql(database, "UPDATE loom_archive_zero_amounts SET original_amount=0 WHERE entity_id=3;")?
    discard downgrade_sqlite_migration("/usr/bin/sqlite3", database, bundle)?
    assert match inspect_live_sqlite_downgrade("/usr/bin/sqlite3", database, bundle) {
        Result.Err(_) => true,
        Result.Ok(_) => false
    }
    assert match current("/usr/bin/sqlite3", database)? {
        BasisEvidence.Observed(basis) => basis == bundle.from_schema.basis,
        _ => false
    }
    assert fixture_sql(database, "SELECT id,amount FROM orders ORDER BY id;")? == "1|2\n2|10\n3|0\n"
    assert fixture_sql(database, "SELECT body FROM notes;")? == "retained\n"
    let before = fixture_sql(database, "SELECT count(*) FROM loom_deploy_events;")?
    let hotfix = inspect_hotfix("/usr/bin/sqlite3", database, bundle.from_schema,
        candidate, old_receipt, hotfix_receipt)?
    assert match hotfix.starting {
        BasisEvidence.Observed(basis) => basis == bundle.from_schema.basis,
        _ => false
    }
    assert hotfix.declared_mapping_unchanged &&
    hotfix.compatibility == HotfixCompatibility.Unproven && !hotfix.can_execute
    assert fixture_sql(database, "SELECT count(*) FROM loom_deploy_events;")? == before
    assert match inspect_hotfix("/usr/bin/sqlite3", database, bundle.from_schema,
        bundle.to_schema, old_receipt, new_receipt) {
        Result.Err(_) => true,
        Result.Ok(_) => false
    }
    assert match inspect_hotfix("/usr/bin/sqlite3", database, bundle.from_schema,
        candidate, old_receipt, old_receipt) {
        Result.Err(_) => true,
        Result.Ok(_) => false
    }
    // v1 writers resume after rollback. Their new positive value and note must
    // survive re-upgrade; only the new zero is eligible for replacement.
    discard fixture_sql(database, "UPDATE orders SET amount=7 WHERE id=3; INSERT INTO orders VALUES (4,0); UPDATE notes SET body='edited after rollback' WHERE id=1;")?
    assert fixture_sql(database, "SELECT id,amount FROM orders ORDER BY id;")? == "1|2\n2|10\n3|7\n4|0\n"
    assert fixture_sql(database, "SELECT body FROM notes;")? == "edited after rollback\n"
    let again = migration("orders_again", "upgrade_3", 2, old_receipt, new_receipt)?
    let retained = inspect_live_sqlite_upgrade("/usr/bin/sqlite3", database, again,
        SqliteLivePhase.RetainedReupgrade)?
    assert retained.attempt_state == DeploymentState.RollbackComplete &&
    retained.status == SqliteLiveStatus.ChecksPassed
    discard fixture_sql(database, "UPDATE loom_archive_zero_amounts SET original_amount=1 WHERE entity_id=3;")?
    let invalid_archive = inspect_live_sqlite_upgrade("/usr/bin/sqlite3", database, again,
        SqliteLivePhase.RetainedReupgrade)?
    assert invalid_archive.status == SqliteLiveStatus.DataOrLineageMismatch
    discard fixture_sql(database, "UPDATE loom_archive_zero_amounts SET original_amount=0 WHERE entity_id=3;")?
    assert sqlite_migration_identity(bundle)? != sqlite_migration_identity(again)?
    let inspection = inspect_sqlite_migration("/usr/bin/sqlite3", database, again)?
    assert match inspection.evidence {
        BasisEvidence.Observed(basis) => basis == again.from_schema.basis,
        _ => false
    }
    assert length(inspection.missing.forward) == 0 && length(inspection.missing.recovery) == 0
    discard start_sqlite_migration("/usr/bin/sqlite3", database, again)?
    let retry_source = inspect_live_sqlite_upgrade("/usr/bin/sqlite3", database, again,
        SqliteLivePhase.RetainedReupgrade)?
    assert retry_source.attempt_state == DeploymentState.Started &&
    retry_source.status == SqliteLiveStatus.ChecksPassed
    discard fixture_sql(database, "UPDATE loom_archive_zero_amounts SET original_amount=1 WHERE entity_id=3;")?
    assert match reupgrade_sqlite_migration("/usr/bin/sqlite3", database, again) {
        Result.Err(_) => true,
        Result.Ok(_) => false
    }
    assert fixture_sql(database, "SELECT id,amount FROM orders ORDER BY id;")? == "1|2\n2|10\n3|7\n4|0\n"
    assert fixture_sql(database, "SELECT body FROM notes;")? == "edited after rollback\n"
    assert fixture_sql(database, "SELECT entity_id,original_amount,restorable FROM loom_archive_zero_amounts ORDER BY entity_id;")? == "1|0|0\n3|1|1\n"
    assert fixture_sql(database, "SELECT state FROM loom_deploy_events WHERE attempt_id='upgrade_3' ORDER BY sequence;")? == "0\n1\n2\n"
    assert match current("/usr/bin/sqlite3", database)? {
        BasisEvidence.None => true,
        _ => false
    }
    let failed_reupgrade = inspect_live_sqlite_upgrade("/usr/bin/sqlite3", database, again,
        SqliteLivePhase.RetainedReupgrade)?
    assert failed_reupgrade.attempt_state == DeploymentState.Failed &&
    failed_reupgrade.status == SqliteLiveStatus.DataOrLineageMismatch &&
    failed_reupgrade.requires_resume
    discard fixture_sql(database, "UPDATE loom_archive_zero_amounts SET original_amount=0 WHERE entity_id=3;")?
    let repaired_reupgrade = inspect_live_sqlite_upgrade("/usr/bin/sqlite3", database, again,
        SqliteLivePhase.RetainedReupgrade)?
    assert repaired_reupgrade.attempt_state == DeploymentState.Failed &&
    repaired_reupgrade.status == SqliteLiveStatus.ChecksPassed &&
    repaired_reupgrade.requires_resume
    assert match reupgrade_sqlite_migration("/usr/bin/sqlite3", database, again) {
        Result.Err(_) => true,
        Result.Ok(_) => false
    }
    discard resume_failed_attempt("/usr/bin/sqlite3", database, again.operation.attempt_id)?
    discard reupgrade_sqlite_migration("/usr/bin/sqlite3", database, again)?
    assert match current("/usr/bin/sqlite3", database)? {
        BasisEvidence.Observed(basis) => basis == again.to_schema.basis,
        _ => false
    }
    assert fixture_sql(database, "SELECT state FROM loom_deploy_events WHERE attempt_id='upgrade_3' ORDER BY sequence;")? == "0\n1\n2\n1\n3\n"
    assert fixture_sql(database, "SELECT id,amount FROM orders ORDER BY id;")? == "1|2\n2|10\n3|7\n4|2\n"
    assert fixture_sql(database, "SELECT entity_id,original_amount,restorable FROM loom_archive_zero_amounts ORDER BY entity_id;")? == "1|0|0\n3|0|0\n4|0|1\n"
    assert fixture_sql(database, "SELECT body FROM notes;")? == "edited after rollback\n"
    assert match fixture_sql(database, "INSERT INTO orders VALUES (5,0);") {
        Result.Err(_) => true,
        Result.Ok(_) => false
    }
    discard fixture_sql(database, "UPDATE OR REPLACE orders SET rowid=3 WHERE id=2;")?
    assert fixture_sql(database, "SELECT restorable FROM loom_archive_zero_amounts WHERE entity_id=3;")? == "0\n"
    discard fixture_sql(database, "INSERT OR REPLACE INTO orders VALUES (3,2);")?
    discard fixture_sql(database, "DELETE FROM orders WHERE id=4;")?
    assert fixture_sql(database, "SELECT entity_id,original_amount,restorable FROM loom_archive_zero_amounts ORDER BY entity_id;")? == "1|0|0\n3|0|0\n4|0|0\n"
    Result.Ok(true)
}

fn rolls_back_failed_transaction(database Text, old_receipt Text, new_receipt Text,
    hotfix_receipt Text) Result[Bool, Text] {
    let bundle = migration("orders_failure", "upgrade_2", 1, old_receipt, new_receipt)?
    discard fixture_sql(database, "CREATE TABLE loom_deploy_events(sequence INTEGER PRIMARY KEY AUTOINCREMENT, attempt_id TEXT NOT NULL, from_basis TEXT NOT NULL, to_basis TEXT NOT NULL, plan_digest TEXT NOT NULL, policy INTEGER NOT NULL, state INTEGER NOT NULL); CREATE TRIGGER block_assumed BEFORE INSERT ON loom_deploy_events WHEN NEW.state=7 BEGIN SELECT RAISE(ABORT,'blocked'); END;")?
    assert match assume_historical("/usr/bin/sqlite3", database, "historical_v1", bundle.from_schema.basis) {
        Result.Err(_) => true,
        Result.Ok(_) => false
    }
    assert fixture_sql(database, "SELECT count(*) FROM loom_deploy_events;")? == "0\n"
    discard fixture_sql(database, concat("DROP TRIGGER block_assumed; INSERT INTO loom_deploy_events(attempt_id,from_basis,to_basis,plan_digest,policy,state) VALUES ('dangling','', '", concat(bundle.from_schema.basis, "','',0,0);")))?
    assert match assume_historical("/usr/bin/sqlite3", database, "second_import", bundle.from_schema.basis) {
        Result.Err(_) => true,
        Result.Ok(_) => false
    }
    assert fixture_sql(database, "SELECT attempt_id,state FROM loom_deploy_events;")? == "dangling|0\n"
    discard fixture_sql(database, "DROP TABLE loom_deploy_events;")?
    discard fixture_sql(database, "CREATE TABLE orders(id INTEGER PRIMARY KEY, amount INTEGER NOT NULL CHECK(amount >= 0)) STRICT; INSERT INTO orders VALUES (1,0);")?
    discard assume_historical("/usr/bin/sqlite3", database, "ddl_probe", bundle.from_schema.basis)?
    let changed_ddl = inspect_live_sqlite_upgrade("/usr/bin/sqlite3", database, bundle,
        SqliteLivePhase.FreshUpgrade)?
    assert changed_ddl.status == SqliteLiveStatus.LayoutMismatch
    discard fixture_sql(database, "DROP TABLE orders; DROP TABLE loom_deploy_events;")?
    discard fixture_sql(database, "CREATE TABLE \"orders\"(\"id\" INTEGER PRIMARY KEY, \"amount\" INTEGER NOT NULL CHECK(\"amount\">=0)) STRICT; INSERT INTO orders VALUES (1,0),(2,10); CREATE VIEW notes AS SELECT 1 AS id, 'collision' AS body;")?
    discard started(database, bundle, hotfix_receipt)?
    let blocked = inspect_live_sqlite_upgrade("/usr/bin/sqlite3", database, bundle,
        SqliteLivePhase.FreshUpgrade)?
    assert blocked.attempt_state == DeploymentState.Started &&
    blocked.status == SqliteLiveStatus.LayoutMismatch
    assert match upgrade_sqlite_migration("/usr/bin/sqlite3", database, bundle) {
        Result.Err(_) => true,
        Result.Ok(_) => false
    }
    assert fixture_sql(database, "SELECT id,amount FROM orders ORDER BY id;")? == "1|0\n2|10\n"
    assert fixture_sql(database, "SELECT count(*) FROM sqlite_master WHERE type='table' AND name='loom_archive_zero_amounts';")? == "0\n"
    assert fixture_sql(database, "SELECT count(*) FROM sqlite_master WHERE type='table' AND name='notes';")? == "0\n"
    assert fixture_sql(database, "SELECT count(*) FROM loom_deploy_events WHERE attempt_id='upgrade_2' AND state=3;")? == "0\n"
    assert fixture_sql(database, "SELECT state FROM loom_deploy_events ORDER BY sequence DESC LIMIT 1;")? == "2\n"
    assert match current("/usr/bin/sqlite3", database)? {
        BasisEvidence.None => true,
        _ => false
    }
    let failed = inspect_live_sqlite_upgrade("/usr/bin/sqlite3", database, bundle,
        SqliteLivePhase.FreshUpgrade)?
    assert failed.attempt_state == DeploymentState.Failed &&
    failed.status == SqliteLiveStatus.LayoutMismatch && failed.requires_resume
    discard fixture_sql(database, "DROP VIEW notes;")?
    let recovered = inspect_live_sqlite_upgrade("/usr/bin/sqlite3", database, bundle,
        SqliteLivePhase.FreshUpgrade)?
    assert recovered.attempt_state == DeploymentState.Failed &&
    recovered.status == SqliteLiveStatus.ChecksPassed && recovered.requires_resume
    discard resume_failed_attempt("/usr/bin/sqlite3", database, bundle.operation.attempt_id)?
    assert match current("/usr/bin/sqlite3", database)? {
        BasisEvidence.None => true,
        _ => false
    }
    let changed = migration("orders_failure", "upgrade_2", 2, old_receipt, new_receipt)?
    assert sqlite_migration_identity(changed)? != sqlite_migration_identity(bundle)?
    assert match upgrade_sqlite_migration("/usr/bin/sqlite3", database, changed) {
        Result.Err(_) => true,
        Result.Ok(_) => false
    }
    assert fixture_sql(database, "SELECT id,amount FROM orders ORDER BY id;")? == "1|0\n2|10\n"
    assert fixture_sql(database, "SELECT state FROM loom_deploy_events ORDER BY sequence DESC LIMIT 1;")? == "1\n"
    discard upgrade_sqlite_migration("/usr/bin/sqlite3", database, bundle)?
    assert match current("/usr/bin/sqlite3", database)? {
        BasisEvidence.Observed(basis) => basis == bundle.to_schema.basis,
        _ => false
    }
    assert fixture_sql(database, "SELECT id,amount FROM orders ORDER BY id;")? == "1|1\n2|10\n"
    discard fixture_sql(database, "DROP TRIGGER loom_archive_amount_update; CREATE TRIGGER loom_archive_amount_update AFTER UPDATE OF amount ON orders BEGIN SELECT 1; END;")?
    let before_downgrade_inspection = fixture_sql(database, "SELECT count(*) FROM loom_deploy_events;")?
    let tampered = inspect_live_sqlite_downgrade("/usr/bin/sqlite3", database, bundle)?
    assert tampered.attempt_state == DeploymentState.Complete &&
    tampered.status == SqliteLiveStatus.LayoutMismatch && !tampered.requires_retry
    assert fixture_sql(database, "SELECT count(*) FROM loom_deploy_events;")? == before_downgrade_inspection
    assert match downgrade_sqlite_migration("/usr/bin/sqlite3", database, bundle) {
        Result.Err(_) => true,
        Result.Ok(_) => false
    }
    assert fixture_sql(database, "SELECT id,amount FROM orders ORDER BY id;")? == "1|1\n2|10\n"
    assert fixture_sql(database, "SELECT count(*) FROM loom_deploy_events WHERE attempt_id='upgrade_2' AND state=6;")? == "0\n"
    let failed_rollback = inspect_live_sqlite_downgrade("/usr/bin/sqlite3", database, bundle)?
    assert failed_rollback.attempt_state == DeploymentState.RollbackFailed &&
    failed_rollback.status == SqliteLiveStatus.LayoutMismatch && failed_rollback.requires_retry
    Result.Ok(true)
}

fn hex_text(value Text) Text {
    let encoded = std.bytes.new()
    var index = 0
    while index < std.text.length(value) {
        let current = byte(value, index)
        std.bytes.push(encoded, byte("0123456789abcdef", current >> 4))
        std.bytes.push(encoded, byte("0123456789abcdef", current & 15))
        index = index + 1
    }
    to_text(encoded)
}

fn rejects_corrupt_receipt_and_artifact(database Text, receipt_path Text) Bool {
    let raw = match read_text(receipt_path) {
        Result.Ok(value) => value,
        Result.Err(_) => {
            return false
        }
    }
    let receipt = match read_build_receipt(receipt_path) {
        Result.Ok(value) => value,
        Result.Err(_) => {
            return false
        }
    }
    let original = match read_bytes(receipt.artifact_path) {
        Result.Ok(value) => value,
        Result.Err(_) => {
            return false
        }
    }
    let stage = concat(database, ".receipt-test")
    if !match create_dir(stage) {
        Result.Ok(_) => true,
        Result.Err(_) => false
    } {
        return false
    }
    let artifact_copy = join_path(stage, "artifact")
    let receipt_copy = join_path(stage, "receipt")
    let malformed = join_path(stage, "malformed")
    defer {
        discard remove_file(artifact_copy)
        discard remove_file(receipt_copy)
        discard remove_file(malformed)
        discard remove_empty_dir(stage)
    }
    if !match write_bytes(artifact_copy, original) {
        Result.Ok(_) => true,
        Result.Err(_) => false
    } {
        return false
    }
    let resolved = match canonicalize(artifact_copy) {
        Result.Ok(value) => value,
        Result.Err(_) => {
            return false
        }
    }
    let lines = split(raw, "\n")
    if length(lines) < 5 {
        return false
    }
    set(lines, 4, concat("artifact-path ", hex_text(resolved)))
    let adapted = join(lines, "\n")
    if !match write_text(receipt_copy, adapted) {
        Result.Ok(_) => true,
        Result.Err(_) => false
    } {
        return false
    }
    if !match read_build_receipt(receipt_copy) {
        Result.Ok(_) => true,
        Result.Err(_) => false
    } {
        return false
    }
    if !match write_text(malformed, concat(adapted, "x")) {
        Result.Ok(_) => true,
        Result.Err(_) => false
    } {
        return false
    }
    if !match read_build_receipt(malformed) {
        Result.Err(_) => true,
        Result.Ok(_) => false
    } {
        return false
    }
    let altered = match read_bytes(artifact_copy) {
        Result.Ok(value) => value,
        Result.Err(_) => {
            return false
        }
    }
    std.bytes.push(altered, 0)
    if !match write_bytes(artifact_copy, altered) {
        Result.Ok(_) => true,
        Result.Err(_) => false
    } {
        return false
    }
    match read_build_receipt(receipt_copy) {
        Result.Err(_) => true,
        Result.Ok(_) => false
    }
}

fn main() {
    let args = arguments()
    assert length(args) == 6
    assert match succeeds(get(args, 1), get(args, 3), get(args, 4), get(args, 5)) {
        Result.Ok(value) => value,
        Result.Err(_) => false
    }
    assert match rolls_back_failed_transaction(get(args, 2), get(args, 3), get(args, 4), get(args, 5)) {
        Result.Ok(value) => value,
        Result.Err(_) => false
    }
    assert rejects_corrupt_receipt_and_artifact(get(args, 2), get(args, 4))
}
