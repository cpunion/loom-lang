import std.int.to_text
import std.option.Option
import std.result.Result
import std.text.concat

fn trigger_present(name Text, table Text, definition Text) Text {
    concat("EXISTS (SELECT 1 FROM main.sqlite_master WHERE type='trigger' AND name=",
        concat(literal(name), concat(" AND tbl_name=", concat(literal(table),
                    concat(" AND sql=", concat(literal(definition), ")"))))))
}

fn positive_amount_rows(plan SqlitePositiveAmountUpgrade) Text {
    let amount = quoted(plan.amount)
    concat("NOT EXISTS (SELECT 1 FROM ",
        concat(quoted(plan.orders), concat(" WHERE typeof(", concat(amount,
                    concat(")!='integer' OR ", concat(amount, "<=0)"))))))
}

fn restorable_amount_rows(plan SqlitePositiveAmountUpgrade) Text {
    let orders = quoted(plan.orders)
    let archive = quoted(plan.archive)
    let key = quoted(plan.order_id)
    let amount = quoted(plan.amount)
    var condition = concat("NOT EXISTS (SELECT 1 FROM ",
        concat(archive, " WHERE restorable=1 AND NOT EXISTS (SELECT 1 FROM "))
    condition = concat(condition, orders)
    condition = concat(condition, concat(" WHERE ", concat(orders, concat(".", key))))
    condition = concat(condition, concat("=", concat(archive, ".entity_id AND ")))
    condition = concat(condition, concat(orders, concat(".", amount)))
    concat(condition, concat("=", concat(to_text(plan.replacement), "))")))
}

// Advisory read-only counterpart of the downgrade transaction's fixed source
// checks. Execution repeats every condition after BEGIN IMMEDIATE.
fn live_downgrade_layout(plan SqlitePositiveAmountUpgrade) Text {
    var condition = exact_table(plan.orders, source_ddl(plan))
    condition = and_sql(condition, exact_table(plan.archive, archive_ddl(plan)))
    condition = and_sql(condition, exact_table(plan.notes, notes_ddl(plan)))
    condition = and_sql(condition, "(SELECT count(*) FROM main.sqlite_master WHERE type='table' AND name NOT GLOB 'sqlite_*')=4")
    condition = and_sql(condition, concat("(SELECT count(*) FROM pragma_table_info(",
            concat(literal(plan.orders), "))=2")))
    condition = and_sql(condition, concat("(SELECT count(*) FROM pragma_table_info(",
            concat(literal(plan.archive), "))=3")))
    condition = and_sql(condition, concat("(SELECT count(*) FROM pragma_table_info(",
            concat(literal(plan.notes), "))=2")))
    condition = and_sql(condition, concat("NOT EXISTS (SELECT 1 FROM pragma_foreign_key_list(",
            concat(literal(plan.orders), "))")))
    condition = and_sql(condition, concat("NOT EXISTS (SELECT 1 FROM pragma_foreign_key_list(",
            concat(literal(plan.archive), "))")))
    condition = and_sql(condition, concat("NOT EXISTS (SELECT 1 FROM pragma_foreign_key_list(",
            concat(literal(plan.notes), "))")))
    condition = and_sql(condition, integer_key(plan.orders, plan.order_id))
    condition = and_sql(condition, required_integer(plan.orders, plan.amount))
    condition = and_sql(condition, integer_key(plan.archive, "entity_id"))
    condition = and_sql(condition, required_integer(plan.archive, "original_amount"))
    condition = and_sql(condition, required_integer(plan.archive, "restorable"))
    condition = and_sql(condition, integer_key(plan.notes, plan.note_id))
    condition = and_sql(condition, required_text(plan.notes, plan.note_body))
    condition = and_sql(condition, "(SELECT count(*) FROM main.sqlite_master WHERE type='trigger')=6")
    condition = and_sql(condition, "NOT EXISTS (SELECT 1 FROM main.sqlite_master WHERE type='index')")
    var index = 0
    while index < 6 {
        condition = and_sql(condition, trigger_present(trigger_name(index),
                plan.orders, trigger_sql(plan, index)))
        index = index + 1
    }
    condition
}

fn live_downgrade_data(plan SqlitePositiveAmountUpgrade) Text {
    var condition = positive_amount_rows(plan)
    condition = and_sql(condition, retained_archive_rows(plan))
    condition = and_sql(condition, retained_notes_rows(plan))
    and_sql(condition, restorable_amount_rows(plan))
}

fn inspect_live_downgrade_source(tool Text, database Text,
    plan SqlitePositiveAmountUpgrade) Result[SqliteLiveStatus, Text] {
    if !live_check(tool, database, live_downgrade_layout(plan))? {
        return Result.Ok(SqliteLiveStatus.LayoutMismatch)
    }
    if !live_check(tool, database, live_downgrade_data(plan))? {
        return Result.Ok(SqliteLiveStatus.DataOrLineageMismatch)
    }
    Result.Ok(SqliteLiveStatus.ChecksPassed)
}

fn upgrade_never_completed(plan SqlitePositiveAmountUpgrade) Text {
    concat("NOT EXISTS (SELECT 1 FROM loom_deploy_events WHERE attempt_id=",
        concat(literal(plan.attempt_id), concat(" AND state=",
                concat(to_text(state_number(DeploymentState.Complete)), ")"))))
}

// The failed upgrade transaction already restored its data by atomic rollback.
// Observe that source again under the write lock; never run the v2 downgrade
// against an uncommitted upgrade, and never equate a Fail event with recovery.
fn execute_failed_upgrade_recovery(tool Text, database Text, plan SqlitePositiveAmountUpgrade,
    plan_identity Text, retained Bool) Result[Attempt, Text] {
    let previous = match latest(tool, database)? {
        Option.Some(value) => value
        Option.None => {
            return Result.Err("deployment attempt is not registered")
        }
    }
    let attempt = previous.attempt
    if attempt.id != plan.attempt_id || attempt.from_basis != plan.from_basis ||
    attempt.to_basis != plan.to_basis || attempt.plan_digest != plan_identity ||
    attempt.policy != FailurePolicy.Rollback {
        return Result.Err("SQLite recovery does not match the failed upgrade")
    }
    let never_completed = upgrade_never_completed(plan)
    if !live_check(tool, database, never_completed)? {
        return Result.Err("a completed SQLite upgrade needs downgrade, not failed-upgrade recovery")
    }
    if attempt.state == DeploymentState.RollbackComplete {
        return Result.Ok(attempt)
    }
    if attempt.state == DeploymentState.Failed || attempt.state == DeploymentState.RollbackFailed {
        discard record_event(tool, database, plan.attempt_id, Transition.BeginRollback)?
    } else {
        if attempt.state != DeploymentState.RollbackStarted {
            return Result.Err("SQLite recovery requires a failed upgrade or pending rollback")
        }
    }
    let started = match latest(tool, database)? {
        Option.Some(value) => value
        Option.None => {
            return Result.Err("SQLite recovery attempt disappeared")
        }
    }
    if !same_attempt_plan(attempt, started.attempt) || started.attempt.state != DeploymentState.RollbackStarted {
        return Result.Err("SQLite recovery attempt changed")
    }
    let completed = advance(started.attempt, Transition.FinishRollback)?
    var script = "PRAGMA foreign_keys=ON;\nPRAGMA ignore_check_constraints=OFF;\nBEGIN IMMEDIATE;\nCREATE TEMP TABLE loom_migration_checks(ok INTEGER NOT NULL CHECK(ok=1));\n"
    script = concat(script, checked(migration_event_guard(started)))
    script = concat(script, checked(never_completed))
    script = concat(script, checked(live_source_layout(plan, retained)))
    script = concat(script, checked(live_source_data(plan, retained)))
    script = concat(script, migration_completion(started, completed))
    script = concat(script, "COMMIT;\n")
    match execute(tool, database, script) {
        Result.Ok(_) => Result.Ok(completed)
        Result.Err(_) => {
            match record_event(tool, database, plan.attempt_id, Transition.FailRollback) {
                Result.Ok(_) => Result.Err("SQLite failed-upgrade rollback was recorded as failed")
                Result.Err(_) => Result.Err("SQLite failed-upgrade rollback outcome needs inspection")
            }
        }
    }
}

// Only reverses this package's fixed positive-amount upgrade. The notes and
// archive tables are retained so downgrade never drops newly created data.
// An amount changed by v2 is not overwritten by an older archived zero.
fn execute_positive_amount_downgrade(tool Text, database Text,
    plan SqlitePositiveAmountUpgrade, plan_identity Text,
    policy FailurePolicy) Result[Attempt, Text] {
    let previous = match latest(tool, database)? {
        Option.Some(value) => value,
        Option.None => {
            return Result.Err("deployment attempt is not registered")
        }
    }
    if previous.attempt.id != plan.attempt_id || previous.attempt.from_basis != plan.from_basis ||
    previous.attempt.to_basis != plan.to_basis || previous.attempt.plan_digest != plan_identity ||
    previous.attempt.policy != policy {
        return Result.Err("SQLite downgrade does not match the deployed attempt")
    }
    if live_check(tool, database, upgrade_never_completed(plan))? {
        return Result.Err("SQLite downgrade requires an observed completed upgrade")
    }
    if previous.attempt.state == DeploymentState.Complete || previous.attempt.state == DeploymentState.RollbackFailed {
        discard record_event(tool, database, plan.attempt_id, Transition.BeginRollback)?
    } else {
        if previous.attempt.state != DeploymentState.RollbackStarted {
            return Result.Err("SQLite downgrade requires a completed or started rollback")
        }
    }
    let started = match latest(tool, database)? {
        Option.Some(value) => value,
        Option.None => {
            return Result.Err("rollback attempt disappeared")
        }
    }
    if started.attempt.id != plan.attempt_id || started.attempt.state != DeploymentState.RollbackStarted {
        return Result.Err("rollback attempt changed")
    }
    let completed = advance(started.attempt, Transition.FinishRollback)?
    let orders = quoted(plan.orders)
    let key = quoted(plan.order_id)
    let amount = quoted(plan.amount)
    let archive = quoted(plan.archive)

    var script = "PRAGMA foreign_keys=ON;\nPRAGMA ignore_check_constraints=OFF;\nBEGIN IMMEDIATE;\nCREATE TEMP TABLE loom_migration_checks(ok INTEGER NOT NULL CHECK(ok=1));\n"
    script = concat(script, checked(migration_event_guard(started)))
    script = concat(script, checked(concat("NOT ", upgrade_never_completed(plan))))
    script = concat(script, checked(exact_table(plan.orders, source_ddl(plan))))
    script = concat(script, checked(exact_table(plan.archive, archive_ddl(plan))))
    script = concat(script, checked(exact_table(plan.notes, notes_ddl(plan))))
    script = concat(script, checked("(SELECT count(*) FROM main.sqlite_master WHERE type='table' AND name NOT GLOB 'sqlite_*')=4"))
    script = concat(script, checked(concat("(SELECT count(*) FROM pragma_table_info(",
                concat(literal(plan.orders), "))=2"))))
    script = concat(script, checked(concat("NOT EXISTS (SELECT 1 FROM pragma_foreign_key_list(",
                concat(literal(plan.orders), "))"))))
    script = concat(script, checked(integer_key(plan.orders, plan.order_id)))
    script = concat(script, checked(required_integer(plan.orders, plan.amount)))
    script = concat(script, checked(integer_key(plan.archive, "entity_id")))
    script = concat(script, checked(required_integer(plan.archive, "original_amount")))
    script = concat(script, checked(required_integer(plan.archive, "restorable")))
    script = concat(script, checked(integer_key(plan.notes, plan.note_id)))
    script = concat(script, checked(required_text(plan.notes, plan.note_body)))
    script = concat(script, checked(concat("(SELECT count(*) FROM pragma_table_info(",
                concat(literal(plan.archive), "))=3"))))
    script = concat(script, checked(concat("(SELECT count(*) FROM pragma_table_info(",
                concat(literal(plan.notes), "))=2"))))
    script = concat(script, checked(concat("NOT EXISTS (SELECT 1 FROM pragma_foreign_key_list(",
                concat(literal(plan.archive), "))"))))
    script = concat(script, checked(concat("NOT EXISTS (SELECT 1 FROM pragma_foreign_key_list(",
                concat(literal(plan.notes), "))"))))
    script = concat(script, checked("(SELECT count(*) FROM main.sqlite_master WHERE type='trigger')=6"))
    script = concat(script, checked("NOT EXISTS (SELECT 1 FROM main.sqlite_master WHERE type='index')"))
    var trigger_index = 0
    while trigger_index < 6 {
        script = concat(script, checked(trigger_present(trigger_name(trigger_index),
                    plan.orders, trigger_sql(plan, trigger_index))))
        trigger_index = trigger_index + 1
    }
    script = concat(script, checked(positive_amount_rows(plan)))
    script = concat(script, checked(retained_archive_rows(plan)))
    script = concat(script, checked(retained_notes_rows(plan)))
    script = concat(script, checked(restorable_amount_rows(plan)))

    script = concat(script, "DROP TRIGGER loom_positive_insert;\nDROP TRIGGER loom_positive_update;\n")
    script = concat(script, "DROP TRIGGER loom_archive_amount_update;\nDROP TRIGGER loom_archive_key_update;\nDROP TRIGGER loom_archive_delete;\nDROP TRIGGER loom_archive_insert;\n")
    var restore = concat("UPDATE ", concat(orders, concat(" SET ", concat(amount, "=0 WHERE EXISTS (SELECT 1 FROM "))))
    restore = concat(restore, archive)
    restore = concat(restore, concat(" WHERE entity_id=", concat(orders, concat(".", key))))
    restore = concat(restore, concat(" AND restorable=1 AND original_amount=0 AND ", concat(orders, concat(".", amount))))
    restore = concat(restore, concat("=", concat(to_text(plan.replacement), ");\n")))
    script = concat(script, restore)
    let nonnegative = concat("NOT EXISTS (SELECT 1 FROM ",
        concat(orders, concat(" WHERE typeof(", concat(amount,
                    concat(")!='integer' OR ", concat(amount, "<0)"))))))
    script = concat(script, checked(nonnegative))
    script = concat(script, migration_completion(started, completed))
    script = concat(script, "COMMIT;\n")
    match execute(tool, database, script) {
        Result.Ok(_) => Result.Ok(completed),
        Result.Err(_) => {
            match record_event(tool, database, plan.attempt_id, Transition.FailRollback) {
                Result.Ok(_) => Result.Err("SQLite downgrade failed and was recorded as failed"),
                Result.Err(_) => Result.Err("SQLite downgrade outcome needs inspection")
            }
        }
    }
}
