import std.hash.sha256.hex
import std.list.new
import std.list.push
import std.process.capture
import std.process.ExitStatus
import std.result.Result

// A digest of the compiler's checked, proof-validated program output. It is
// one input to a deployment basis, not the complete deployment basis: target,
// native tool, schema mapping and tracked build inputs must also be bound.
pub fn checked_program_digest(compiler Text, package Text, std_root Text) Result[Text, Text] {
    if compiler == "" || package == "" || std_root == "" {
        return Result.Err("compiler, package and std root are required")
    }
    let args = std.list.new[Text]()
    std.list.push(args, compiler)
    std.list.push(args, "emit-checked")
    std.list.push(args, package)
    std.list.push(args, "--std")
    std.list.push(args, std_root)
    match capture(args) {
        Result.Ok(output) => match output.status {
            ExitStatus.Exited(code) => {
                if code == 0 {
                    Result.Ok(hex(output.stdout))
                } else {
                    Result.Err("checked program failed to build")
                }
            }
            ExitStatus.Terminated => Result.Err("compiler terminated while checking the program")
        },
        Result.Err(_) => Result.Err("cannot start compiler for checked program")
    }
}
