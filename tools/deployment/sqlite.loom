import std.build.target
import std.list.new
import std.list.push
import std.process.capture_input
import std.process.ExitStatus
import std.result.Result
import std.text.to_bytes
import std.text.replace
import std.text.starts_with
import std.text.slice
import std.text.length
import std.text.byte
import std.text.contains
import std.text.concat

// Filenames are literal filesystem paths, not caller-supplied URI parameters.
// URI modes express non-creation without depending on newer CLI switches.
fn database_filename(database Text, mode Text) Text {
    var path = database
    comptime if target("os") == "windows" {
        path = replace(path, "\\", "/")
        if starts_with(path, "//?/UNC/") {
            path = concat("//", slice(path, 8, std.text.length(path)))
        } else {
            if starts_with(path, "//?/") {
                path = slice(path, 4, std.text.length(path))
            }
        }
        if std.text.length(path) >= 2 && byte(path, 1) == 58 {
            path = concat("/", path)
        }
    }
    path = replace(replace(replace(path, "%", "%25"), "?", "%3f"), "#", "%23")
    let prefix = if starts_with(path, "//") {
        "file://"
    } else {
        "file:"
    }
    concat(prefix, concat(path, concat("?mode=", mode)))
}

// The SQLite executable is an explicit deployment-tool dependency, not a
// language runtime intrinsic. Child arguments are literal; no shell is used.
fn invoke(tool Text, database Text, sql Text, read_only Bool, require_existing Bool) Result[Bytes, Text] {
    if tool == "" || database == "" || database == ":memory:" || contains(database, "\0") {
        return Result.Err("SQLite tool and persistent database filename are required")
    }
    let args = std.list.new[Text]()
    std.list.push(args, tool)
    // Explicitly replace the user's startup file: output settings and arbitrary
    // .sqliterc commands must not participate in deployment queries.
    std.list.push(args, "-init")
    comptime if target("os") == "windows" {
        std.list.push(args, "NUL")
    } else {
        std.list.push(args, "/dev/null")
    }
    std.list.push(args, "-batch")
    std.list.push(args, "-bail")
    std.list.push(args, "-list")
    std.list.push(args, "-noheader")
    std.list.push(args, "-separator")
    std.list.push(args, "\t")
    if read_only {
        std.list.push(args, "-readonly")
    }
    std.list.push(args, "--")
    let mode = if read_only {
        "ro"
    } else {
        if require_existing {
            "rw"
        } else {
            "rwc"
        }
    }
    std.list.push(args, database_filename(database, mode))
    match capture_input(args, to_bytes(sql)) {
        Result.Ok(output) => match output.status {
            ExitStatus.Exited(code) => {
                if code == 0 {
                    Result.Ok(output.stdout)
                } else {
                    Result.Err("SQLite command failed")
                }
            }
            ExitStatus.Terminated => Result.Err("SQLite command terminated")
        },
        Result.Err(_) => Result.Err("cannot start SQLite tool")
    }
}

// Internal fixed queries only. `-readonly` does not sandbox arbitrary sqlite3
// stdin (dot commands can reopen a writable database), so this is not public.
// Diagnostics never echo SQL, database contents, paths, or SQLite stderr.
fn inspect(tool Text, database Text, sql Text) Result[Bytes, Text] {
    invoke(tool, database, sql, true, true)
}

// Internal SQL transport. Only generated statements with validated identifiers
// may cross this boundary; completion requires a separate checked transaction.
fn execute(tool Text, database Text, sql Text) Result[Bytes, Text] {
    invoke(tool, database, sql, false, false)
}

fn execute_existing(tool Text, database Text, sql Text) Result[Bytes, Text] {
    invoke(tool, database, sql, false, true)
}
