record Header {
    package_name Text
    identities List[Identity]
    next Int
    draft Text
    pending List[Text]
}

record Loaded {
    revision Revision
    sidecar Text
    commit Text
    next Int
}

record Review {
    merged Revision
    token Text
    next Int
}

record Context {
    production Project
    tests Project
    directory Text
    stamp Text
}

fn path(directory Text, name Text) Text {
    concat(concat(directory, "/"), name)
}

fn kind(name Text) Result[NodeKind, Text] {
    if name == "fn" {
        return Result.Ok(NodeKind.Function)
    }
    if name == "record" {
        return Result.Ok(NodeKind.Record)
    }
    if name == "enum" {
        return Result.Ok(NodeKind.Enum)
    }
    if name == "type" {
        return Result.Ok(NodeKind.Refined)
    }
    if name == "concept" {
        return Result.Ok(NodeKind.Concept)
    }
    if name == "impl" {
        return Result.Ok(NodeKind.Impl)
    }
    Result.Err("identity kind must be fn, record, enum, type, concept or impl")
}

fn kind_name(value NodeKind) Text {
    if value == NodeKind.Function {
        return "fn"
    }
    if value == NodeKind.Record {
        return "record"
    }
    if value == NodeKind.Enum {
        return "enum"
    }
    if value == NodeKind.Refined {
        return "type"
    }
    if value == NodeKind.Impl {
        return "impl"
    }
    "concept"
}

fn header(metadata Text, sidecar Text) Result[Header, Text] {
    let identities = new[Identity]()
    var package_name = ""
    var next = 0
    var seen_next = false
    var draft = ""
    let pending = new[Text]()
    var candidates = false
    let lines = split(metadata, "\n")
    var index = 0
    while index < length(lines) {
        let line = trim(get(lines, index))
        if line != "" && !starts_with(line, "#") {
            let words = split(line, " ")
            if length(words) == 2 && get(words, 0) == "package" && package_name == "" {
                package_name = get(words, 1)
            } else {
                if length(words) == 2 && get(words, 0) == "next" {
                    if seen_next {
                        return Result.Err("identity sidecar has more than one next line")
                    }
                    next = match std.int.parse(get(words, 1)) {
                        Result.Ok(value) => value,
                        Result.Err(_) => {
                            return Result.Err("identity allocator must be a positive decimal number")
                        }
                    }
                    if next < 1 || next >= 9223372036854775807 {
                        return Result.Err("identity allocator is outside its supported range")
                    }
                    seen_next = true
                } else {
                    if length(words) == 2 && get(words, 0) == "draft" && draft == "" {
                        draft = get(words, 1)
                        index = index + 1
                        continue
                    }
                    if length(words) == 5 && get(words, 0) == "candidate" {
                        discard draft_candidate(words)?
                        candidates = true
                        index = index + 1
                        continue
                    }
                    if length(words) != 6 || (get(words, 0) != "id" && get(words, 0) != "pending") {
                        return Result.Err(concat("invalid identity line in ", sidecar))
                    }
                    let id = get(words, 1)
                    if get(words, 0) == "pending" {
                        push(pending, id)
                    }
                    let name = get(words, 3)
                    let file = get(words, 4)
                    if starts_with(file, "/") || contains(file, "/") || contains(file, "\\") ||
                    !ends_with(file, ".loom") || trim(file) != file {
                        return Result.Err("identity file path must be a relative .loom filename")
                    }
                    push(identities, Identity {
                            id = id
                            path = file
                            kind = kind(get(words, 2))?
                            name = name
                            key = get(words, 5)
                        })
                }
            }
        }
        index = index + 1
    }
    if package_name == "" {
        return Result.Err("identity sidecar needs a package line")
    }
    if !seen_next {
        return Result.Err("identity sidecar needs exactly one next line")
    }
    if (draft == "" && (length(pending) != 0 || candidates)) ||
    (draft != "" && length(pending) == 0) {
        return Result.Err("identity draft needs a source basis and unresolved identities")
    }
    Result.Ok(Header {
            package_name = package_name
            identities = identities
            next = next
            draft = draft
            pending = pending
        })
}

fn checked_source_directory(directory Text) Result[Bool, Text] {
    discard checked_directory_path(directory, true)?
    match entry_kind(directory) {
        Result.Ok(FileKind.Directory) => Result.Ok(true),
        _ => Result.Err(concat("source is not a regular directory: ", directory))
    }
}

fn read_files(directory Text) Result[List[File], Text] {
    discard checked_source_directory(directory)?
    let names = match entries(directory) {
        Result.Ok(found) => found,
        Result.Err(_) => {
            return Result.Err(concat("cannot list ", directory))
        }
    }
    let files = new[File]()
    var index = 0
    while index < length(names) {
        let name = get(names, index)
        if ends_with(name, ".loom") {
            let source = path(directory, name)
            match entry_kind(source) {
                Result.Ok(FileKind.File) => {
                }
                _ => {
                    return Result.Err(concat("source is not a regular file: ", source))
                }
            }
            let contents = match read_text(source) {
                Result.Ok(value) => value,
                Result.Err(_) => {
                    return Result.Err(concat("cannot read ", source))
                }
            }
            push(files, File {
                    path = name
                    text = contents
                })
        }
        index = index + 1
    }
    Result.Ok(files)
}

fn read_state(directory Text) Result[(Loaded, Header), Text] {
    discard checked_source_directory(directory)?
    let sidecar = path(directory, ".loom-ids")
    match entry_kind(sidecar) {
        Result.Ok(FileKind.File) => {
        }
        _ => {
            return Result.Err(concat("identity sidecar is not a regular file: ", sidecar))
        }
    }
    let metadata = match read_text(sidecar) {
        Result.Ok(value) => value
        Result.Err(_) => {
            return Result.Err(concat("cannot read ", sidecar))
        }
    }
    let parsed = header(metadata, sidecar)?
    let files = read_files(directory)?
    Result.Ok((Loaded {
                revision = Revision {
                    package_name = parsed.package_name
                    files = files
                    identities = parsed.identities
                }
                sidecar = metadata
                commit = ""
                next = parsed.next
            }, parsed))
}

fn read(directory Text) Result[Loaded, Text] {
    let state = read_state(directory)?
    if state.1.draft != "" {
        return Result.Err(if state.1.draft != files_stamp(state.0.revision.files) {
                "identity draft is stale; run refresh --draft before resolution"
            } else {
                "identity draft has unresolved declarations; use explicit --move or --delete before merge"
            })
    }
    Result.Ok(state.0)
}

// Git arguments go directly to the process API, never through a shell. Apply
// supplies a private index and writes objects without updating refs or worktrees.
fn git_bytes(git_executable Text, repository Text, operation List[Text]) Result[Bytes, Text] {
    git_bytes(git_executable, repository, operation, std.bytes.new())
}

fn git_bytes(git_executable Text, repository Text, operation List[Text], input Bytes) Result[Bytes, Text] {
    git_bytes(git_executable, repository, operation, input, "")
}

fn git_bytes(git_executable Text, repository Text, operation List[Text], input Bytes, index_file Text) Result[Bytes, Text] {
    let command = new[Text]()
    push(command, git_executable)
    push(command, "--no-replace-objects")
    push(command, "--no-optional-locks")
    push(command, "-c")
    push(command, "core.fsmonitor=false")
    push(command, "-C")
    push(command, git_path(repository))
    var index = 0
    while index < length(operation) {
        push(command, get(operation, index))
        index = index + 1
    }
    let changes = [EnvChange.Set("GIT_NO_LAZY_FETCH", "1"), EnvChange.Set("GIT_TERMINAL_PROMPT", "0"),
        EnvChange.Set("GIT_ALLOW_PROTOCOL", "")]
    let overrides = ["GIT_DIR", "GIT_WORK_TREE", "GIT_COMMON_DIR", "GIT_OBJECT_DIRECTORY", "GIT_ALTERNATE_OBJECT_DIRECTORIES"]
    index = 0
    while index < length(overrides) {
        push(changes, EnvChange.Remove(get(overrides, index)))
        index = index + 1
    }
    push(changes, if index_file == "" {
            EnvChange.Remove("GIT_INDEX_FILE")
        } else {
            EnvChange.Set("GIT_INDEX_FILE", git_path(index_file))
        })
    let captured = match capture_input(command, input, Options {
            directory = Option.None
            clear_environment = false
            environment = changes
        }) {
        Result.Ok(value) => value
        Result.Err(_) => {
            return Result.Err("could not execute Git")
        }
    }
    match captured.status {
        ExitStatus.Exited(0) => Result.Ok(captured.stdout),
        _ => Result.Err("Git could not read the requested revision or path")
    }
}

fn git(git_executable Text, repository Text, operation List[Text]) Result[Text, Text] {
    match decode_utf8(git_bytes(git_executable, repository, operation)?) {
        Result.Ok(value) => Result.Ok(value)
        Result.Err(_) => Result.Err("Git output is not UTF-8")
    }
}

fn git_commit(git_executable Text, repository Text, revision Text) Result[Text, Text] {
    if revision == "" || starts_with(revision, "-") {
        return Result.Err("invalid Git revision")
    }
    let operation = new[Text]()
    push(operation, "rev-parse")
    push(operation, "--verify")
    push(operation, "--end-of-options")
    push(operation, concat(revision, "^{commit}"))
    let commit = trim(git(git_executable, repository, operation)?)
    if commit == "" || contains(commit, "\n") {
        return Result.Err("invalid Git commit identity")
    }
    Result.Ok(commit)
}

fn read_git(git_executable Text, repository Text, directory Text, revision Text) Result[Loaded, Text] {
    read_git_tree(git_executable, repository, git_tree(git_executable, repository, directory, revision)?)
}

fn read_git_commit(executable Text, repository Text, directory Text, commit Text) Result[Loaded, Text] {
    read_git_tree(executable, repository, git_commit_tree(executable, repository, directory, commit)?)
}

fn read_git_tree(git_executable Text, repository Text, snapshot GitTree) Result[Loaded, Text] {
    let selected = new[GitEntry]()
    var index = 0
    while index < length(snapshot.entries) {
        let entry = get(snapshot.entries, index)
        let name = entry.relative
        if !contains(name, "/") && (name == ".loom-ids" || ends_with(name, ".loom")) {
            if !entry.regular {
                return Result.Err(concat("Git source is not a regular blob: ", name))
            }
            push(selected, entry)
        }
        index = index + 1
    }
    let blobs = git_blobs(git_executable, repository, selected)?
    let files = new[File]()
    var metadata = ""
    index = 0
    while index < length(selected) {
        let contents = match decode_utf8(get(blobs, index)) {
            Result.Ok(value) => value
            Result.Err(_) => {
                return Result.Err("Git source or identity sidecar is not UTF-8")
            }
        }
        let name = get(selected, index).relative
        if name == ".loom-ids" {
            metadata = contents
        } else {
            push(files, File {
                    path = name
                    text = contents
                })
        }
        index = index + 1
    }
    git_loaded(files, metadata, snapshot.commit)
}

fn sidecar(revision Revision, next Int) Text {
    var output = concat("package ", concat(revision.package_name,
            concat("\nnext ", concat(to_text(next), "\n"))))
    var index = 0
    while index < length(revision.identities) {
        let identity = get(revision.identities, index)
        output = concat(output, identity_row("id", identity))
        index = index + 1
    }
    output
}

fn frame(output Bytes, value Text) {
    let size = to_text(std.text.length(value))
    var index = 0
    while index < std.text.length(size) {
        std.bytes.push(output, byte(size, index))
        index = index + 1
    }
    std.bytes.push(output, 58)
    index = 0
    while index < std.text.length(value) {
        std.bytes.push(output, byte(value, index))
        index = index + 1
    }
}

fn frame_files(output Bytes, files List[File]) {
    frame(output, to_text(length(files)))
    var index = 0
    while index < length(files) {
        let file = get(files, index)
        frame(output, file.path)
        frame(output, file.text)
        index = index + 1
    }
}

fn frame_loaded(output Bytes, loaded Loaded) {
    frame(output, loaded.commit)
    frame(output, loaded.sidecar)
    frame_files(output, loaded.revision.files)
}

fn framed_project(output Bytes, project Project) Result[Bool, Text] {
    framed_project(output, project, "", "")
}

fn basis_path(value Text, physical Text, logical Text) Text {
    if physical == "" {
        return value
    }
    if value == physical {
        return logical
    }
    let prefix = join_path(physical, "")
    if starts_with(value, prefix) {
        return join_path(logical, std.text.slice(value, std.text.length(prefix), std.text.length(value)))
    }
    value
}

fn basis_project(project Project, physical Text, logical Text) Project {
    if physical == "" {
        return project
    }
    let modules = new[ModuleInstance]()
    var index = 0
    while index < length(project.modules) {
        let module = get(project.modules, index)
        push(modules, ModuleInstance {
                source = basis_path(module.source, physical, logical),
                ..module
            })
        index = index + 1
    }
    let files = new[SourceFile]()
    index = 0
    while index < length(project.files) {
        let file = get(project.files, index)
        push(files, SourceFile {
                path = basis_path(file.path, physical, logical),
                ..file
            })
        index = index + 1
    }
    Project {
        modules = modules,
        files = files,
        ..project
    }
}

fn framed_project(output Bytes, project Project, physical Text, logical Text) Result[Bool, Text] {
    frame(output, to_text(project.root))
    frame(output, to_text(length(project.modules)))
    var index = 0
    while index < length(project.modules) {
        let module = get(project.modules, index)
        frame(output, module.name)
        frame(output, basis_path(module.source, physical, logical))
        if module.name != "std" {
            let manifest = join_path(module.source, "loom.toml")
            match entry_kind(manifest) {
                Result.Ok(FileKind.File) => {
                }
                _ => {
                    return Result.Err(concat("project context has no regular manifest: ", manifest))
                }
            }
            let contents = match read_text(manifest) {
                Result.Ok(value) => value,
                Result.Err(_) => {
                    return Result.Err(concat("cannot read project manifest: ", manifest))
                }
            }
            frame(output, contents)
        }
        index = index + 1
    }
    frame(output, to_text(length(project.packages)))
    index = 0
    while index < length(project.packages) {
        let package = get(project.packages, index)
        frame(output, to_text(package.instance))
        frame(output, package.relative)
        frame(output, to_text(length(package.imports)))
        var edge = 0
        while edge < length(package.imports) {
            let imported = get(package.imports, edge)
            frame(output, imported.spelling)
            frame(output, to_text(imported.target))
            edge = edge + 1
        }
        index = index + 1
    }
    frame(output, to_text(length(project.files)))
    index = 0
    while index < length(project.files) {
        let file = get(project.files, index)
        frame(output, to_text(file.package))
        frame(output, basis_path(file.path, physical, logical))
        frame(output, file.text)
        frame(output, if file.test_only {
                "test"
            } else {
                "production"
            })
        frame(output, if file.trusted_std {
                "trusted"
            } else {
                "untrusted"
            })
        index = index + 1
    }
    Result.Ok(true)
}

fn read_context(directory Text, standard Text) Result[Context, Text] {
    discard checked_source_directory(directory)?
    let canonical = match canonicalize(directory) {
        Result.Ok(value) => value,
        Result.Err(_) => {
            return Result.Err("cannot resolve project context package")
        }
    }
    let std_root = match canonicalize(standard) {
        Result.Ok(value) => value,
        Result.Err(_) => {
            return Result.Err("cannot resolve project context standard library")
        }
    }
    let production = load(canonical, std_root, false)?
    let tests = load(canonical, std_root, true)?
    let root = get(production.modules, get(production.packages, production.root).instance)
    if root.name == "std" || root.name == "" {
        return Result.Err("project context needs a named non-standard module")
    }
    let lock = join_path(root.source, "loom.lock")
    let bytes = std.bytes.new()
    frame(bytes, "loom-semantic-context-v2")
    frame(bytes, canonical)
    frame(bytes, std_root)
    // Loading above validates all reached Git edges without resolving them.
    // Preserve lock absence as input too: creating an empty lock invalidates
    // a review just as changing an existing lock does.
    match entry_kind(lock) {
        Result.Err(FsError.NotFound) => {
            frame(bytes, "absent")
        }
        Result.Ok(FileKind.File) => {
            frame(bytes, "present")
            let locked = match read_text(lock) {
                Result.Ok(value) => value,
                Result.Err(_) => {
                    return Result.Err("cannot read project context loom.lock")
                }
            }
            frame(bytes, locked)
        }
        _ => {
            return Result.Err("project context loom.lock must be absent or a regular file")
        }
    }
    discard framed_project(bytes, production)?
    discard framed_project(bytes, tests)?
    Result.Ok(Context {
            production = production
            tests = tests
            directory = canonical
            stamp = hex(bytes)
        })
}

fn loaded_stamp(loaded Loaded) Text {
    let output = std.bytes.new()
    frame_loaded(output, loaded)
    hex(output)
}

fn review(base Loaded, left Loaded, right Loaded) Result[Review, Text] {
    let merged = merge(base.revision, left.revision, right.revision, backend("z3"))?
    let next = std.int.maximum(std.int.maximum(base.next, left.next), right.next)
    let output = std.bytes.new()
    frame(output, "loom-semantic-review-v1")
    frame_loaded(output, base)
    frame_loaded(output, left)
    frame_loaded(output, right)
    frame(output, sidecar(merged, next))
    frame_files(output, merged.files)
    Result.Ok(Review {
            merged = merged
            token = hex(output)
            next = next
        })
}

fn review_context(base Loaded, left Loaded, right Loaded, context Context) Result[Review, Text] {
    let merged = merge_with_context(base.revision, left.revision, right.revision,
        context.production, context.tests, context.directory, backend("z3"))?
    let next = std.int.maximum(std.int.maximum(base.next, left.next), right.next)
    let output = std.bytes.new()
    frame(output, "loom-semantic-review-context-v1")
    frame_loaded(output, base)
    frame_loaded(output, left)
    frame_loaded(output, right)
    frame(output, context.stamp)
    frame(output, sidecar(merged, next))
    frame_files(output, merged.files)
    Result.Ok(Review {
            merged = merged
            token = hex(output)
            next = next
        })
}

fn show(value Review) Text {
    let output = concat("dry-run semantic merge; no source or Git state written\nreview token: ", concat(value.token, "\n"))
    concat(output, show_revision(value, ""))
}

fn show_revision(value Review, prefix Text) Text {
    let revision = value.merged
    var output = concat("=== ", concat(prefix, ".loom-ids ===\n"))
    output = concat(output, sidecar(revision, value.next))
    var index = 0
    while index < length(revision.files) {
        let file = get(revision.files, index)
        output = concat(output, concat("=== ", concat(prefix, concat(file.path, " ===\n"))))
        output = concat(output, file.text)
        if !ends_with(file.text, "\n") {
            output = concat(output, "\n")
        }
        index = index + 1
    }
    output
}

fn preview(base Result[Loaded, Text], left Result[Loaded, Text],
    right Result[Loaded, Text]) Result[Text, Text] {
    let original = base?
    let edited_left = left?
    let edited_right = right?
    Result.Ok(show(review(original, edited_left, edited_right)?))
}

fn preview_context(directory Text, standard Text, base Text, left Text, right Text) Result[Text, Text] {
    let original = read(base)?
    let edited_left = read(left)?
    let edited_right = read(right)?
    let context = read_context(directory, standard)?
    Result.Ok(show(review_context(original, edited_left, edited_right, context)?))
}

fn preview_git(executable Text, repository Text, package Text, base Text, left Text, right Text) Result[Text, Text] {
    let basis = git_basis(executable, repository, base, left, right)?
    Result.Ok(show(review(read_git_commit(executable, repository, package, basis.base)?,
                read_git_commit(executable, repository, package, basis.left)?,
                read_git_commit(executable, repository, package, basis.right)?)?))
}

fn preview_git_context(directory Text, standard Text, executable Text, repository Text,
    package Text, base Text, left Text, right Text) Result[Text, Text] {
    let basis = git_basis(executable, repository, base, left, right)?
    let original = read_git_commit(executable, repository, package, basis.base)?
    let edited_left = read_git_commit(executable, repository, package, basis.left)?
    let edited_right = read_git_commit(executable, repository, package, basis.right)?
    let context = read_context(directory, standard)?
    Result.Ok(show(review_context(original, edited_left, edited_right, context)?))
}

// Output names are single-package leaves. The package directory itself must
// be new, and every lexical ancestor must be an existing real directory.
// Current std.fs metadata is a snapshot, not an openat-style race guarantee.
fn checked_directory_path(value Text, include_last Bool) Result[Bool, Text] {
    if value == "" || contains(value, "\\") || contains(value, "\0") ||
    contains(value, "\n") || contains(value, "\r") {
        return Result.Err("directory path is invalid")
    }
    let parts = split(value, "/")
    let absolute = starts_with(value, "/")
    let drive = length(value) >= 3 && byte(value, 1) == 58 && byte(value, 2) == 47
    var prefix = if absolute {
        "/"
    } else {
        if drive {
            slice(value, 0, 3)
        } else {
            ""
        }
    }
    if absolute || drive {
        match entry_kind(prefix) {
            Result.Ok(FileKind.Directory) => {
            }
            _ => {
                return Result.Err(concat("directory root is missing or a symlink: ", prefix))
            }
        }
    }
    var index = if absolute || drive {
        1
    } else {
        0
    }
    while index < length(parts) {
        let component = get(parts, index)
        if component == "" || component == "." || component == ".." || contains(component, ":") {
            return Result.Err("directory path contains an unsafe component")
        }
        if include_last || index + 1 < length(parts) {
            prefix = if prefix == "" || ends_with(prefix, "/") {
                concat(prefix, component)
            } else {
                concat(concat(prefix, "/"), component)
            }
            match entry_kind(prefix) {
                Result.Ok(FileKind.Directory) => {
                }
                _ => {
                    return Result.Err(concat("directory ancestor is missing, not a directory, or a symlink: ", prefix))
                }
            }
        }
        index = index + 1
    }
    Result.Ok(true)
}

fn vacant(path Text) Result[Bool, Text] {
    match entry_kind(path) {
        Result.Err(FsError.NotFound) => Result.Ok(true),
        _ => Result.Err(concat("output entry already exists or cannot be checked: ", path))
    }
}

fn write_new(directory Text, value Review) Result[Bool, Text] {
    discard checked_directory_path(directory, false)?
    // merge has already checked every source/identity leaf and the complete
    // production/test program. No write happens until those checks pass.
    match create_dir(directory) {
        Result.Ok(_) => {
        }
        _ => {
            return Result.Err("output directory must be new and creatable")
        }
    }
    write_revision(directory, value)
}

fn write_revision(directory Text, value Review) Result[Bool, Text] {
    let merged = value.merged
    var index = 0
    while index < length(merged.files) {
        let file = get(merged.files, index)
        let target = path(directory, file.path)
        discard vacant(target)?
        match std.file.write_text(target, file.text) {
            Result.Ok(_) => {
            }
            _ => {
                return Result.Err(concat("could not write merged source: ", target))
            }
        }
        index = index + 1
    }
    // The identity sidecar is written last; a partial output is not a usable
    // semantic-change package. We never remove or overwrite an old tree.
    let target = path(directory, ".loom-ids")
    discard vacant(target)?
    match std.file.write_text(target, sidecar(merged, value.next)) {
        Result.Ok(_) => Result.Ok(true),
        _ => Result.Err(concat("could not write merged identities: ", target))
    }
}

fn publish(expected Text, directory Text, value Review, base Loaded, left Loaded, right Loaded,
    fresh_base Loaded, fresh_left Loaded, fresh_right Loaded) Result[Text, Text] {
    if value.token != expected {
        return Result.Err("review token does not match these source revisions or merged bytes")
    }
    if loaded_stamp(base) != loaded_stamp(fresh_base) ||
    loaded_stamp(left) != loaded_stamp(fresh_left) ||
    loaded_stamp(right) != loaded_stamp(fresh_right) {
        return Result.Err("source revision or Git ref changed while preparing apply")
    }
    discard write_new(directory, value)?
    Result.Ok(concat("wrote checked semantic merge to ", concat(directory, "\n")))
}

fn apply_directories(expected Text, destination Text, base Text, left Text, right Text) Result[Text, Text] {
    let original = read(base)?
    let edited_left = read(left)?
    let edited_right = read(right)?
    let value = review(original, edited_left, edited_right)?
    if value.token != expected {
        return Result.Err("review token does not match these source revisions or merged bytes")
    }
    publish(expected, destination, value, original, edited_left, edited_right,
        read(base)?, read(left)?, read(right)?)
}

fn apply_context(expected Text, destination Text, directory Text, standard Text,
    base Text, left Text, right Text) Result[Text, Text] {
    let original = read(base)?
    let edited_left = read(left)?
    let edited_right = read(right)?
    let context = read_context(directory, standard)?
    let value = review_context(original, edited_left, edited_right, context)?
    if value.token != expected {
        return Result.Err("review token does not match this project closure or merged bytes")
    }
    if read_context(directory, standard)?.stamp != context.stamp {
        return Result.Err("project context changed while preparing apply")
    }
    publish(expected, destination, value, original, edited_left, edited_right,
        read(base)?, read(left)?, read(right)?)
}

fn apply_git(expected Text, destination Text, executable Text, repository Text, directory Text,
    base Text, left Text, right Text) Result[Text, Text] {
    let basis = git_basis(executable, repository, base, left, right)?
    let original = read_git_commit(executable, repository, directory, basis.base)?
    let edited_left = read_git_commit(executable, repository, directory, basis.left)?
    let edited_right = read_git_commit(executable, repository, directory, basis.right)?
    let value = review(original, edited_left, edited_right)?
    if value.token != expected {
        return Result.Err("review token does not match these Git commits or merged bytes")
    }
    let fresh = git_basis(executable, repository, base, left, right)?
    publish(expected, destination, value, original, edited_left, edited_right,
        read_git_commit(executable, repository, directory, fresh.base)?,
        read_git_commit(executable, repository, directory, fresh.left)?,
        read_git_commit(executable, repository, directory, fresh.right)?)
}

fn apply_git_context(expected Text, destination Text, directory Text, standard Text,
    executable Text, repository Text, package Text, base Text, left Text, right Text) Result[Text, Text] {
    let basis = git_basis(executable, repository, base, left, right)?
    let original = read_git_commit(executable, repository, package, basis.base)?
    let edited_left = read_git_commit(executable, repository, package, basis.left)?
    let edited_right = read_git_commit(executable, repository, package, basis.right)?
    let context = read_context(directory, standard)?
    let value = review_context(original, edited_left, edited_right, context)?
    if value.token != expected {
        return Result.Err("review token does not match these Git commits, project closure or merged bytes")
    }
    if read_context(directory, standard)?.stamp != context.stamp {
        return Result.Err("project context changed while preparing apply")
    }
    let fresh = git_basis(executable, repository, base, left, right)?
    publish(expected, destination, value, original, edited_left, edited_right,
        read_git_commit(executable, repository, package, fresh.base)?,
        read_git_commit(executable, repository, package, fresh.left)?,
        read_git_commit(executable, repository, package, fresh.right)?)
}

fn main() {
    let args = arguments()
    let initializing = length(args) == 4 && get(args, 1) == "init"
    let scanning = length(args) == 3 && get(args, 1) == "scan"
    let refreshing = length(args) >= 3 && get(args, 1) == "refresh"
    let directories_preview = length(args) == 4 && get(args, 1) != "--apply" && get(args, 1) != "--git" &&
    get(args, 1) != "init" && get(args, 1) != "refresh" && get(args, 1) != "scan"
    let git_preview = length(args) == 8 && get(args, 1) == "--git"
    let context_preview = length(args) == 7 && get(args, 1) == "--context"
    let context_git_preview = length(args) == 11 && get(args, 1) == "--context" && get(args, 4) == "--git"
    let module_preview = length(args) == 6 && get(args, 1) == "--module"
    let automatic_preview = length(args) == 11 && get(args, 1) == "--git-module"
    let automatic_apply = length(args) == 13 && get(args, 1) == "--apply" && get(args, 3) == "--git-module"
    let module_git_preview = length(args) == 11 && get(args, 1) == "--module" && get(args, 4) == "--git"
    let directories_apply = length(args) == 7 && get(args, 1) == "--apply"
    let context_apply = length(args) == 10 && get(args, 1) == "--apply" && get(args, 4) == "--context"
    let context_git_apply = length(args) == 14 && get(args, 1) == "--apply" &&
    get(args, 4) == "--context" && get(args, 7) == "--git"
    let git_apply = length(args) == 11 && get(args, 1) == "--apply" && get(args, 4) == "--git"
    let module_apply = length(args) == 9 && get(args, 1) == "--apply" && get(args, 4) == "--module"
    let module_git_apply = length(args) == 14 && get(args, 1) == "--apply" &&
    get(args, 4) == "--module" && get(args, 7) == "--git"
    if !initializing && !scanning && !refreshing && !directories_preview && !git_preview && !context_preview &&
    !directories_apply && !context_apply && !git_apply && !module_preview && !module_apply &&
    !context_git_preview && !context_git_apply && !module_git_preview && !module_git_apply &&
    !automatic_preview && !automatic_apply {
        discard write_error("usage: semantic_change_trial init PACKAGE_NAME DIR\n")
        discard write_error("   or: semantic_change_trial scan DIR\n")
        discard write_error("   or: semantic_change_trial refresh DIR [--draft] [--move ID NEW_FILE NEW_NAME KEY | --delete ID]...\n")
        discard write_error("usage: semantic_change_trial BASE_DIR LEFT_DIR RIGHT_DIR\n")
        discard write_error("   or: semantic_change_trial --git GIT_EXE REPO PACKAGE_DIR BASE_REV LEFT_REV RIGHT_REV\n")
        discard write_error("   or: semantic_change_trial --context PACKAGE_DIR STD_ROOT BASE_DIR LEFT_DIR RIGHT_DIR\n")
        discard write_error("   or: semantic_change_trial --context PACKAGE_DIR STD_ROOT --git GIT_EXE REPO PACKAGE_DIR BASE_REV LEFT_REV RIGHT_REV\n")
        discard write_error("   or: semantic_change_trial --module STD_ROOT BASE_DIR LEFT_DIR RIGHT_DIR\n")
        discard write_error("   or: semantic_change_trial --module BASE_MODULE_DIR STD_ROOT --git GIT_EXE REPO MODULE_DIR BASE_REV LEFT_REV RIGHT_REV\n")
        discard write_error("   or: semantic_change_trial --git-module SCRATCH STD_ROOT CACHE_BASE GIT_EXE REPO MODULE_DIR BASE_REV LEFT_REV RIGHT_REV\n")
        discard write_error("   or: semantic_change_trial --apply TOKEN --git-module SCRATCH STD_ROOT CACHE_BASE GIT_EXE REPO MODULE_DIR BASE_REV LEFT_REV RIGHT_REV\n")
        discard write_error("   or: semantic_change_trial --apply TOKEN OUTPUT_DIR BASE_DIR LEFT_DIR RIGHT_DIR\n")
        discard write_error("   or: semantic_change_trial --apply TOKEN OUTPUT_DIR --context PACKAGE_DIR STD_ROOT BASE_DIR LEFT_DIR RIGHT_DIR\n")
        discard write_error("   or: semantic_change_trial --apply TOKEN OUTPUT_DIR --context PACKAGE_DIR STD_ROOT --git GIT_EXE REPO PACKAGE_DIR BASE_REV LEFT_REV RIGHT_REV\n")
        discard write_error("   or: semantic_change_trial --apply TOKEN OUTPUT_DIR --git GIT_EXE REPO PACKAGE_DIR BASE_REV LEFT_REV RIGHT_REV\n")
        discard write_error("   or: semantic_change_trial --apply TOKEN OUTPUT_DIR --module STD_ROOT BASE_DIR LEFT_DIR RIGHT_DIR\n")
        discard write_error("   or: semantic_change_trial --apply TOKEN OUTPUT_DIR --module BASE_MODULE_DIR STD_ROOT --git GIT_EXE REPO MODULE_DIR BASE_REV LEFT_REV RIGHT_REV\n")
        exit_code(2)
        return
    }
    let outcome = if automatic_preview {
        automatic_git_module(git_auto_request(args, 2), false, "")
    } else if automatic_apply {
        automatic_git_module(git_auto_request(args, 4), true, get(args, 2))
    } else if module_git_preview {
        preview_git_module(get(args, 2), get(args, 3), get(args, 5), get(args, 6),
            get(args, 7), get(args, 8), get(args, 9), get(args, 10))
    } else if module_git_apply {
        apply_git_module(get(args, 2), get(args, 3), get(args, 5), get(args, 6),
            get(args, 8), get(args, 9), get(args, 10), get(args, 11), get(args, 12), get(args, 13))
    } else if context_git_preview {
        preview_git_context(get(args, 2), get(args, 3), get(args, 5), get(args, 6),
            get(args, 7), get(args, 8), get(args, 9), get(args, 10))
    } else if context_git_apply {
        apply_git_context(get(args, 2), get(args, 3), get(args, 5), get(args, 6),
            get(args, 8), get(args, 9), get(args, 10), get(args, 11), get(args, 12), get(args, 13))
    } else if module_preview {
        preview_module(get(args, 2), get(args, 3), get(args, 4), get(args, 5))
    } else if module_apply {
        apply_module(get(args, 2), get(args, 3), get(args, 5), get(args, 6), get(args, 7), get(args, 8))
    } else if scanning {
        scan(get(args, 2))
    } else if initializing {
        initialize(get(args, 2), get(args, 3))
    } else {
        if refreshing {
            refresh_command(args)
        } else {
            if directories_preview {
                preview(read(get(args, 1)), read(get(args, 2)), read(get(args, 3)))
            } else {
                if context_preview {
                    preview_context(get(args, 2), get(args, 3), get(args, 4), get(args, 5), get(args, 6))
                } else {
                    if git_preview {
                        let executable = get(args, 2)
                        let repository = get(args, 3)
                        let directory = get(args, 4)
                        preview_git(executable, repository, directory, get(args, 5), get(args, 6), get(args, 7))
                    } else {
                        if directories_apply {
                            apply_directories(get(args, 2), get(args, 3), get(args, 4), get(args, 5), get(args, 6))
                        } else {
                            if context_apply {
                                apply_context(get(args, 2), get(args, 3), get(args, 5), get(args, 6),
                                    get(args, 7), get(args, 8), get(args, 9))
                            } else {
                                apply_git(get(args, 2), get(args, 3), get(args, 5), get(args, 6), get(args, 7),
                                    get(args, 8), get(args, 9), get(args, 10))
                            }
                        }
                    }
                }
            }
        }
    }
    match outcome {
        Result.Ok(summary) => {
            discard write_text(summary)
        }
        Result.Err(message) => {
            discard write_error(concat(message, "\n"))
            exit_code(1)
        }
    }
}
