import std.loom.ast.has
import std.loom.checking.macro_generator_candidates
import std.list.clone
import std.list.set

record DeclarationRename {
    id Text
    name Text
}

record RenameEdit {
    id Text
    start Int
    end Int
    text Text
}

record RenamedRevisions {
    original Revision
    left Revision
    right Revision
}

fn rename_name(entry Entry) Result[Token, Text] {
    rename_name(entry, false)
}

fn rename_name(entry Entry, public_allowed Bool) Result[Token, Text] {
    let tree = match parse(entry.body) {
        Result.Ok(value) => value
        Result.Err(problem) => {
            return Result.Err(problem.message)
        }
    }
    let declaration = get(tree.children, 0)
    if !declaration_supported(entry.kind) || entry.kind == NodeKind.Impl ||
    (!public_allowed && has(declaration, NodeKind.Public)) {
        return Result.Err("rename composition requires a named private declaration")
    }
    let tokens = match lex(entry.body) {
        Result.Ok(value) => value
        Result.Err(problem) => {
            return Result.Err(problem.message)
        }
    }
    var index = 0
    while index < length(tokens) {
        let token = get(tokens, index)
        if token.kind == Kind.Name && token.value == entry.name {
            return Result.Ok(token)
        }
        index = index + 1
    }
    Result.Err("renamed declaration has no declaration token")
}

fn declaration_renames(base Indexed, left Indexed, right Indexed) Result[List[DeclarationRename], Text] {
    declaration_renames(base, left, right, false)
}

fn declaration_renames(base Indexed, left Indexed, right Indexed, public_allowed Bool) Result[List[DeclarationRename], Text] {
    let renames = new[DeclarationRename]()
    var index = 0
    while index < length(base.entries) {
        let original = get(base.entries, index)
        let l = entry_index(left.entries, original.id)
        let r = entry_index(right.entries, original.id)
        if l >= 0 && r >= 0 {
            let a = get(left.entries, l)
            let b = get(right.entries, r)
            if a.name != original.name || b.name != original.name {
                if a.kind != original.kind || b.kind != original.kind {
                    return Result.Err("rename cannot change declaration kind")
                }
                if a.name != original.name && b.name != original.name && a.name != b.name {
                    return Result.Err("conflicting declaration renames require explicit resolution")
                }
                discard rename_name(original, public_allowed)?
                discard rename_name(a, public_allowed)?
                discard rename_name(b, public_allowed)?
                if public_allowed && (public_declaration(original)? != public_declaration(a)? ||
                    public_declaration(original)? != public_declaration(b)?) {
                    return Result.Err("rename cannot change declaration visibility; explicit resolution required")
                }
                let name = if a.name != original.name {
                    a.name
                } else {
                    b.name
                }
                // A name may select several overloads. Normalize only the
                // identified declaration and its checked reference tokens;
                // rechecking every binding decides whether composition is safe.
                push(renames, DeclarationRename {
                        id = original.id
                        name = name
                    })
            }
        }
        index = index + 1
    }
    Result.Ok(renames)
}

fn rename_requested(renames List[DeclarationRename], id Text) Text {
    var index = 0
    while index < length(renames) {
        let rename = get(renames, index)
        if rename.id == id {
            return rename.name
        }
        index = index + 1
    }
    ""
}

fn same_revision_names(before Revision, after Revision) Bool {
    var index = 0
    while index < length(before.identities) {
        if get(before.identities, index).name != get(after.identities, index).name {
            return false
        }
        index = index + 1
    }
    true
}

fn rename_site(sites List[Int], offset Int) Bool {
    var index = 0
    while index < length(sites) {
        if get(sites, index) == offset {
            return true
        }
        index = index + 1
    }
    false
}

// Spelling only selects query candidates. Checked declaration identity and the
// exact declaration-name span below decide whether a token may be rewritten.
fn rename_spelling(entries List[Entry], renames List[DeclarationRename], name Text) Bool {
    var index = 0
    while index < length(entries) {
        let entry = get(entries, index)
        if entry.name == name && rename_requested(renames, entry.id) != "" {
            return true
        }
        index = index + 1
    }
    false
}

fn rename_edits(revision Indexed, renames List[DeclarationRename], analysis Analysis, directory Text) Result[List[RenameEdit], Text] {
    let edits = new[RenameEdit]()
    var index = 0
    while index < length(revision.entries) {
        let entry = get(revision.entries, index)
        let sites = reference_sites(entry)?
        let requested = rename_requested(renames, entry.id)
        let declaration = if entry.kind == NodeKind.Impl {
            -1
        } else {
            rename_name(entry, true)?.span.start
        }
        let tokens = match lex(entry.body) {
            Result.Ok(value) => value
            Result.Err(problem) => {
                return Result.Err(problem.message)
            }
        }
        var token_index = 0
        while token_index < length(tokens) {
            let token = get(tokens, token_index)
            var name = if token.span.start == declaration {
                requested
            } else {
                ""
            }
            if token.span.start != declaration && (rename_site(sites, token.span.start) ||
                (token.kind == Kind.Name && rename_spelling(revision.entries, renames, token.value))) {
                let target = target_at(analysis, revision, directory, entry, token.span.start)?
                let selected = rename_requested(renames, target.id)
                if selected != "" {
                    let owner = get(revision.entries, entry_index(revision.entries, target.id))
                    let defined = rename_name(owner)?.span
                    if target.start == defined.start && target.end == defined.end {
                        name = selected
                    }
                }
            }
            if name != "" && token.value != name {
                push(edits, RenameEdit {
                        id = entry.id
                        start = token.span.start
                        end = token.span.end
                        text = name
                    })
            }
            token_index = token_index + 1
        }
        index = index + 1
    }
    Result.Ok(edits)
}

fn rename_body(entry Entry, edits List[RenameEdit]) Text {
    var output = ""
    var offset = 0
    var index = 0
    while index < length(edits) {
        let edit = get(edits, index)
        if edit.id == entry.id {
            output = concat(output, concat(slice(entry.body, offset, edit.start), edit.text))
            offset = edit.end
        }
        index = index + 1
    }
    concat(output, slice(entry.body, offset, length(entry.body)))
}

// Token normalization can change function/impl type spellings and therefore
// their revision-local keys, even when those owners are not themselves renamed.
// Preserve each explicit ID by its original declaration position, not its name.
fn renamed_identities(original Indexed, files List[File], renames List[DeclarationRename]) Result[List[Identity], Text] {
    let identities = clone(original.revision.identities)
    var file = 0
    while file < length(files) {
        let source = get(files, file)
        let tree = match parse(source.text) {
            Result.Ok(value) => value
            Result.Err(problem) => {
                return Result.Err(problem.message)
            }
        }
        var ordinal = 0
        var item = 0
        while item < length(tree.children) {
            let node = get(tree.children, item)
            if node.kind != NodeKind.Import {
                let position = entry_in_file(original.entries, source.path, ordinal)
                if position < 0 {
                    return Result.Err("rename changed the declaration structure")
                }
                let entry = get(original.entries, position)
                let requested = rename_requested(renames, entry.id)
                let name = if requested == "" {
                    entry.name
                } else {
                    requested
                }
                if node.kind != entry.kind || declaration_label(node) != name {
                    return Result.Err("rename changed the declaration structure")
                }
                let identity = identity_index(original.revision.identities, entry.path, entry.kind, entry.name, entry.key)
                set(identities, identity, Identity {
                        id = entry.id
                        path = entry.path
                        kind = entry.kind
                        name = name
                        key = declaration_key(node)?
                    })
                ordinal = ordinal + 1
            }
            item = item + 1
        }
        if entry_in_file(original.entries, source.path, ordinal) >= 0 {
            return Result.Err("rename changed the declaration structure")
        }
        file = file + 1
    }
    Result.Ok(identities)
}

fn renamed_revision(revision Indexed, renames List[DeclarationRename], edits List[RenameEdit]) Result[Revision, Text] {
    let files = new[File]()
    var index = 0
    while index < length(revision.revision.files) {
        let file = get(revision.revision.files, index)
        var output = ""
        var offset = 0
        var ordinal = 0
        while true {
            let position = entry_in_file(revision.entries, file.path, ordinal)
            if position < 0 {
                break
            }
            let entry = get(revision.entries, position)
            output = concat(output, concat(slice(file.text, offset, entry.start), rename_body(entry, edits)))
            offset = entry.end
            ordinal = ordinal + 1
        }
        push(files, File {
                path = file.path
                text = concat(output, slice(file.text, offset, length(file.text)))
            })
        index = index + 1
    }
    Result.Ok(Revision {
            package_name = revision.revision.package_name
            files = files
            identities = renamed_identities(revision, files, renames)?
        })
}

// Translate checked definition spans back through the exact token edits. A
// partial/generated definition inside a replaced token is not guessed.
fn rename_original_offset(edits List[RenameEdit], id Text, offset Int) Result[Int, Text] {
    var delta = 0
    var index = 0
    while index < length(edits) {
        let edit = get(edits, index)
        if edit.id == id {
            let start = edit.start + delta
            let end = start + length(edit.text)
            if offset <= start {
                return Result.Ok(offset - delta)
            }
            if offset < end {
                return Result.Err("renamed binding has a partial token definition")
            }
            delta = delta + length(edit.text) - (edit.end - edit.start)
        }
        index = index + 1
    }
    Result.Ok(offset - delta)
}

fn compare_renamed(before Analysis, original Indexed, after Analysis, updated Indexed, directory Text, edits List[RenameEdit]) Result[Bool, Text] {
    var index = 0
    while index < length(original.entries) {
        let entry = get(original.entries, index)
        if !package_entry_active(before, before.bindings.root, entry)? {
            index = index + 1
            continue
        }
        let changed = get(updated.entries, entry_index(updated.entries, entry.id))
        let sites = reference_sites(entry)?
        let current = reference_sites(changed)?
        if length(sites) != length(current) {
            return Result.Err("rename changed the reference structure")
        }
        var site = 0
        while site < length(sites) {
            let expected = target_at(before, original, directory, entry, get(sites, site))?
            let target = target_at(after, updated, directory, changed, get(current, site))?
            let anchor = rename_original_offset(edits, target.id, target.anchor)?
            let scope = if target.id == "" {
                target.scope
            } else {
                renamed_scope(get(original.entries, entry_index(original.entries, target.id)), target.scope, anchor)?
            }
            let restored = BindingTarget {
                scope = scope
                anchor = anchor
                start = rename_original_offset(edits, target.id, target.start)?
                end = rename_original_offset(edits, target.id, target.end)?
                ..target
            }
            if !same_target(expected, restored) {
                return Result.Err(concat("rename changed a checked reference binding in ",
                        concat(entry.path, concat(" at ", to_text(get(sites, site))))))
            }
            site = site + 1
        }
        index = index + 1
    }
    Result.Ok(true)
}

fn rename_analysis(revision Revision, directory Text, production Project, tests Project, testing Bool,
    backend ProofBackend) Result[Analysis, Text] {
    let project = if directory == "" {
        project_of(revision)?
    } else {
        contextual(if testing {
                tests
            } else {
                production
            }, directory, revision)?
    }
    match checked_analysis(project, testing, backend) {
        Result.Ok(value) => Result.Ok(value)
        Result.Err(problem) => Result.Err(concat("rename requires checked source: ", problem.diagnostic.message))
    }
}

fn checked_rename_generators(analysis Analysis, package Int, backend ProofBackend) Result[Bool, Text] {
    // An exported generator can retain definition-context references in Text
    // or AST output, including calls outside this package's checked closure.
    // Source-token comparison cannot account for those generated bindings.
    let generators = match macro_generator_candidates(analysis.bindings, proof_inputs(backend)) {
        Result.Ok(value) => value
        Result.Err(problem) => {
            return Result.Err(problem.diagnostic.message)
        }
    }
    var generator = 0
    while generator < length(generators) {
        let item = get(analysis.bindings.symbols, get(generators, generator))
        if item.public && get(analysis.bindings.files, item.file).package == package {
            return Result.Err("rename cannot account for generated definition-context references; explicit resolution required")
        }
        generator = generator + 1
    }
    Result.Ok(true)
}

fn normalize_rename(revision Revision, renames List[DeclarationRename], directory Text, production Project, tests Project,
    backend ProofBackend) Result[Revision, Text] {
    let original = indexed(revision)?
    let before = rename_analysis(revision, directory, production, tests, true, backend)?
    discard checked_rename_generators(before, before.bindings.root, backend)?
    let edits = rename_edits(original, renames, before, directory)?
    let renamed = renamed_revision(original, renames, edits)?
    let updated = indexed(renamed)?
    discard compare_renamed(before, original, rename_analysis(renamed, directory, production, tests, true, backend)?, updated, directory, edits)?
    discard compare_renamed(rename_analysis(revision, directory, production, tests, false, backend)?, original,
        rename_analysis(renamed, directory, production, tests, false, backend)?, updated, directory, edits)?
    Result.Ok(renamed)
}

fn normalize_renames(base Revision, left Revision, right Revision, directory Text, production Project, tests Project,
    backend ProofBackend) Result[RenamedRevisions, Text] {
    if base.package_name != left.package_name || base.package_name != right.package_name {
        return Result.Err("semantic merge cannot cross package identities")
    }
    let renames = declaration_renames(indexed(base)?, indexed(left)?, indexed(right)?)?
    if length(renames) != 0 && directory == "" &&
    (has_imports(base)? || has_imports(left)? || has_imports(right)? ||
        needs_result_import(base, true)? || needs_result_import(left, true)? || needs_result_import(right, true)?) {
        return Result.Err("import-bearing merges require an explicit pinned project context")
    }
    if length(renames) != 0 && directory != "" {
        discard checked_context(base, base, production, tests, directory, backend)?
    }
    Result.Ok(if length(renames) == 0 {
            RenamedRevisions {
                original = base
                left = left
                right = right
            }
        } else {
            RenamedRevisions {
                original = normalize_rename(base, renames, directory, production, tests, backend)?
                left = normalize_rename(left, renames, directory, production, tests, backend)?
                right = normalize_rename(right, renames, directory, production, tests, backend)?
            }
        })
}
