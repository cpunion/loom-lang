import std.loom.analysis.Analysis
import std.loom.analysis.Inspection
import std.loom.analysis.inspect_at
import std.loom.analysis.inspect_independent
import std.loom.analysis.inspect_references
import std.loom.analysis.reference_obligations
import std.loom.analysis.abstract_reference_scope
import std.loom.analysis.Location
import std.loom.ast.Node
import std.loom.ast.NodeKind
import std.loom.lexer.Kind
import std.loom.lexer.Token
import std.loom.lexer.lex
import std.loom.parser.parse
import std.loom.project.ModuleInstance
import std.loom.project.Package
import std.loom.project.PackageImport
import std.loom.project.Project
import std.loom.project.SourceFile
import std.loom.project.join_path
import std.loom.project.package_label
import std.loom.project.rebuild_imports
import std.loom.project.name
import std.list.get
import std.list.length
import std.list.new
import std.list.push
import std.int.to_text
import std.option.Option
import std.result.Result
import std.text.concat
import std.text.contains
import std.text.ends_with
import std.text.length
import std.text.slice

// Identity is deliberately supplied by the change store, not inferred from
// revision-relative AST spans or from a declaration's spelling. Each revision
// holds one package; checked batches retain the package scopes separately.
pub record File {
    path Text
    text Text
}

pub record Identity {
    id Text
    path Text
    kind NodeKind
    name Text
    key Text
}

pub record Revision {
    package_name Text
    files List[File]
    identities List[Identity]
}

record Entry {
    id Text
    path Text
    kind NodeKind
    name Text
    key Text
    start Int
    end Int
    body Text
    header Text
    abstract_body Bool
    members List[MemberScope]
}

record Indexed {
    revision Revision
    entries List[Entry]
}

// A source location is only stable across analyses after it is tied either to
// the change store's declaration identity or to the exact pinned dependency
// file. Compiler file/symbol indices are not persistent identities.
record BindingTarget {
    id Text
    package Int
    path Text
    scope Text
    anchor Int
    start Int
    end Int
}

fn source_leaf(path Text) Bool {
    path != "" && ends_with(path, ".loom") && !contains(path, "/") &&
    !contains(path, "\\") && !contains(path, " ") && !contains(path, "\t") &&
    !contains(path, "\0") && !contains(path, "\n") && !contains(path, "\r")
}

fn sidecar_word(value Text) Bool {
    value != "" && !contains(value, " ") && !contains(value, "\t") &&
    !contains(value, "\0") && !contains(value, "\n") && !contains(value, "\r")
}

fn file_index(files List[File], path Text) Int {
    var index = 0
    while index < length(files) {
        if get(files, index).path == path {
            return index
        }
        index = index + 1
    }
    -1
}

fn entry_index(entries List[Entry], id Text) Int {
    var index = 0
    while index < length(entries) {
        if get(entries, index).id == id {
            return index
        }
        index = index + 1
    }
    -1
}

fn identity_index(identities List[Identity], path Text, kind NodeKind, name Text, key Text) Int {
    var found = -1
    var index = 0
    while index < length(identities) {
        let value = get(identities, index)
        if value.path == path && value.kind == kind && value.name == name && value.key == key {
            if found >= 0 {
                return -2
            }
            found = index
        }
        index = index + 1
    }
    found
}

fn declaration_header(source Text, node Node) Text {
    if node.kind == NodeKind.Function {
        var index = 0
        while index < length(node.children) {
            let child = get(node.children, index)
            if child.kind == NodeKind.Block {
                return slice(source, node.span.start, child.span.start)
            }
            index = index + 1
        }
    }
    var position = node.span.start
    var output = ""
    var member = 0
    while member < length(node.children) {
        let declaration = get(node.children, member)
        if declaration.kind == NodeKind.Function {
            var part = 0
            while part < length(declaration.children) {
                let body = get(declaration.children, part)
                if body.kind == NodeKind.Block {
                    output = concat(output, concat(slice(source, position, body.span.start), "{}"))
                    position = body.span.end
                }
                part = part + 1
            }
        }
        member = member + 1
    }
    concat(output, slice(source, position, node.span.end))
}

fn indexed(revision Revision) Result[Indexed, Text] {
    if !sidecar_word(revision.package_name) {
        return Result.Err("revision needs a package identity")
    }
    let entries = new[Entry]()
    let empty_members = new[MemberScope]()
    var index = 0
    while index < length(revision.identities) {
        let identity = get(revision.identities, index)
        if !sidecar_word(identity.id) || !source_leaf(identity.path) || !sidecar_word(identity.name) ||
        !sidecar_word(identity.key) || !declaration_supported(identity.kind) {
            return Result.Err("invalid or unsupported declaration identity")
        }
        var previous = 0
        while previous < index {
            if get(revision.identities, previous).id == identity.id {
                return Result.Err("duplicate stable declaration identity")
            }
            previous = previous + 1
        }
        index = index + 1
    }
    index = 0
    while index < length(revision.files) {
        let file = get(revision.files, index)
        if !source_leaf(file.path) {
            return Result.Err("source file needs a root-level .loom filename")
        }
        var previous = 0
        while previous < index {
            if get(revision.files, previous).path == file.path {
                return Result.Err("duplicate source file path")
            }
            previous = previous + 1
        }
        let tree = match parse(file.text) {
            Result.Ok(tree) => tree
            Result.Err(problem) => {
                return Result.Err(concat(concat("cannot parse ", file.path),
                        concat(": ", problem.message)))
            }
        }
        var declaration = 0
        while declaration < length(tree.children) {
            let node = get(tree.children, declaration)
            if node.kind == NodeKind.Import {
                declaration = declaration + 1
                continue
            }
            if !declaration_supported(node.kind) {
                return Result.Err(concat("unsupported top-level declaration in ", file.path))
            }
            let binding = identity_index(revision.identities, file.path, node.kind, declaration_label(node),
                declaration_key(node)?)
            if binding < 0 {
                return Result.Err(concat("missing or ambiguous stable identity in ", file.path))
            }
            let id = get(revision.identities, binding).id
            if entry_index(entries, id) >= 0 {
                return Result.Err(concat("ambiguous declaration in ", file.path))
            }
            push(entries, Entry {
                    id = id
                    path = file.path
                    kind = node.kind
                    name = declaration_label(node)
                    key = get(revision.identities, binding).key
                    start = node.span.start
                    end = node.span.end
                    body = slice(file.text, node.span.start, node.span.end)
                    header = declaration_header(file.text, node)
                    abstract_body = abstract_reference_scope(node)
                    members = member_scopes(node, empty_members)?
                })
            declaration = declaration + 1
        }
        index = index + 1
    }
    if length(entries) != length(revision.identities) {
        return Result.Err("stable identity does not name exactly one declaration")
    }
    Result.Ok(Indexed {
            revision = revision
            entries = entries
        })
}

fn reference_sites(entry Entry) Result[List[Int], Text] {
    let tree = match parse(entry.body) {
        Result.Ok(value) => value
        Result.Err(_) => {
            return Result.Err("retained declaration cannot be parsed for binding comparison")
        }
    }
    if length(tree.children) != 1 || get(tree.children, 0).kind != entry.kind ||
    declaration_label(get(tree.children, 0)) != entry.name {
        return Result.Err("retained declaration has no unique source tree")
    }
    let tokens = match lex(entry.body) {
        Result.Ok(value) => value
        Result.Err(_) => {
            return Result.Err("retained declaration cannot be lexed for binding comparison")
        }
    }
    let obligations = reference_obligations(get(tree.children, 0), tokens)
    if length(obligations.unknown) != 0 {
        return Result.Err("source reference form has no binding comparison support")
    }
    // Generic bodies use the same per-site binding comparison. The compiler
    // can inspect a checked abstract declaration without a runtime instance;
    // missing or ambiguous evidence still rejects in reference_inspection.
    Result.Ok(obligations.offsets)
}

fn analysis_file(analysis Analysis, directory Text, path Text) Int {
    let target = if directory == "" {
        path
    } else {
        join_path(directory, path)
    }
    var index = 0
    while index < length(analysis.bindings.files) {
        let file = get(analysis.bindings.files, index)
        if file.package == analysis.bindings.root && file.path == target {
            return index
        }
        index = index + 1
    }
    -1
}

fn binding_target(analysis Analysis, revision Indexed, directory Text, location Location) Result[BindingTarget, Text] {
    if location.file < 0 || location.file >= length(analysis.bindings.files) {
        return Result.Err("checked definition has no source file")
    }
    let file = get(analysis.bindings.files, location.file)
    if file.package != analysis.bindings.root {
        // All before/after checks use the same pinned dependency project.
        return Result.Ok(BindingTarget {
                id = ""
                package = file.package
                path = file.path
                scope = ""
                anchor = 0
                start = location.span.start
                end = location.span.end
            })
    }
    var index = 0
    while index < length(revision.entries) {
        let entry = get(revision.entries, index)
        let path = if directory == "" {
            entry.path
        } else {
            join_path(directory, entry.path)
        }
        if file.path == path && location.span.start >= entry.start && location.span.end <= entry.end {
            return scoped_target(entry, file.package, location.span)
        }
        index = index + 1
    }
    Result.Err("checked definition has no stable declaration identity")
}

fn same_target(left BindingTarget, right BindingTarget) Bool {
    left.id == right.id && left.package == right.package && left.path == right.path && left.scope == right.scope &&
    left.start - left.anchor == right.start - right.anchor &&
    left.end - left.anchor == right.end - right.anchor
}

fn reference_inspection(analysis Analysis, file Int, offset Int, abstract_body Bool) Result[Inspection, Text] {
    reference_inspection(analysis, file, offset, abstract_body, inspect_at(analysis, file, offset))
}

fn reference_inspection(analysis Analysis, file Int, offset Int, abstract_body Bool,
    observed Option[Inspection]) Result[Inspection, Text] {
    let inspected = match observed {
        Option.Some(value) => value
        Option.None => {
            match inspect_independent(analysis, file, offset) {
                Option.Some(value) => value
                Option.None => {
                    return Result.Err(concat("retained reference has no checked binding evidence in ",
                            concat(get(analysis.bindings.files, file).path, concat(" at ", to_text(offset)))))
                }
            }
        }
    }
    if length(inspected.definitions) != 1 {
        return Result.Err("retained reference has no unique checked definition")
    }
    if abstract_body {
        // Observed specializations alone cannot account for a generic body.
        // Require declaration-wide evidence too, and retain the concrete check
        // above so different observed instances cannot silently select targets.
        let abstract = match inspect_independent(analysis, file, offset) {
            Option.Some(value) => value
            Option.None => {
                return Result.Err("generic reference has no abstract binding evidence")
            }
        }
        if length(abstract.definitions) != 1 {
            return Result.Err("generic reference has instance-dependent binding evidence")
        }
        let expected = get(abstract.definitions, 0)
        let observed = get(inspected.definitions, 0)
        if expected.file != observed.file || expected.span.start != observed.span.start ||
        expected.span.end != observed.span.end {
            return Result.Err("generic reference has instance-dependent binding evidence")
        }
    }
    Result.Ok(inspected)
}

fn target_at(analysis Analysis, revision Indexed, directory Text, entry Entry, offset Int) Result[BindingTarget, Text] {
    let file = analysis_file(analysis, directory, entry.path)
    if file < 0 {
        return Result.Err("retained reference has no analyzed source file")
    }
    let inspected = reference_inspection(analysis, file, entry.start + offset, entry.abstract_body)?
    binding_target(analysis, revision, directory, get(inspected.definitions, 0))
}

fn compare_retained(source Analysis, source_revision Indexed, merged Analysis, merged_revision Indexed,
    directory Text) Result[Bool, Text] {
    var index = 0
    while index < length(merged_revision.entries) {
        let after = get(merged_revision.entries, index)
        if !package_entry_active(merged, merged.bindings.root, after)? {
            index = index + 1
            continue
        }
        let source_index = entry_index(source_revision.entries, after.id)
        if source_index >= 0 {
            let before = get(source_revision.entries, source_index)
            if before.body == after.body {
                let sites = reference_sites(after)?
                let source_file = analysis_file(source, directory, before.path)
                let merged_file = analysis_file(merged, directory, after.path)
                if source_file < 0 || merged_file < 0 {
                    return Result.Err("retained reference has no analyzed source file")
                }
                let source_offsets = new[Int]()
                let merged_offsets = new[Int]()
                var site = 0
                while site < length(sites) {
                    push(source_offsets, before.start + get(sites, site))
                    push(merged_offsets, after.start + get(sites, site))
                    site = site + 1
                }
                let source_evidence = inspect_references(source, source_file, source_offsets)
                let merged_evidence = inspect_references(merged, merged_file, merged_offsets)
                site = 0
                while site < length(sites) {
                    let original = get(source_evidence, site)
                    let current = get(merged_evidence, site)
                    let original_inspection = reference_inspection(source, source_file, original.offset,
                        before.abstract_body, original.inspection)?
                    let current_inspection = reference_inspection(merged, merged_file, current.offset,
                        after.abstract_body, current.inspection)?
                    let original_target = binding_target(source, source_revision, directory,
                        get(original_inspection.definitions, 0))?
                    let current_target = binding_target(merged, merged_revision, directory,
                        get(current_inspection.definitions, 0))?
                    if !same_target(original_target, current_target) {
                        return Result.Err("retained reference changed its checked definition binding")
                    }
                    site = site + 1
                }
            }
        }
        index = index + 1
    }
    Result.Ok(true)
}

fn entry_in_file(entries List[Entry], path Text, ordinal Int) Int {
    var found = 0
    var index = 0
    while index < length(entries) {
        if get(entries, index).path == path {
            if found == ordinal {
                return index
            }
            found = found + 1
        }
        index = index + 1
    }
    -1
}

fn same_layout(base Indexed, branch Indexed) Bool {
    if length(base.revision.files) != length(branch.revision.files) {
        return false
    }
    var index = 0
    while index < length(base.revision.files) {
        let path = get(base.revision.files, index).path
        if file_index(branch.revision.files, path) < 0 {
            return false
        }
        var ordinal = 0
        while true {
            let original = entry_in_file(base.entries, path, ordinal)
            let changed = entry_in_file(branch.entries, path, ordinal)
            if original < 0 || changed < 0 {
                if original != changed {
                    return false
                }
                break
            }
            if get(base.entries, original).id != get(branch.entries, changed).id {
                return false
            }
            ordinal = ordinal + 1
        }
        index = index + 1
    }
    true
}

fn reuses_name(base Indexed, added Entry) Bool {
    var index = 0
    while index < length(base.entries) {
        if get(base.entries, index).name == added.name {
            return true
        }
        index = index + 1
    }
    false
}

// A new package declaration can change candidate lookup anywhere the other
// side kept an identifier, including types, contracts, and comptime code.
// Lexing excludes comments and string contents without predicting which AST
// kinds a future parser may use for references. This is a conservative guard,
// not a proof that a collision actually changes the binding.
fn retained_name_token(entries List[Entry], name Text) Result[Bool, Text] {
    var index = 0
    while index < length(entries) {
        let tokens = match lex(get(entries, index).body) {
            Result.Ok(value) => value
            Result.Err(problem) => {
                return Result.Err(concat("cannot lex retained declaration: ", problem.message))
            }
        }
        var token_index = 0
        while token_index < length(tokens) {
            let token = get(tokens, token_index)
            if token.kind == Kind.Name && token.value == name {
                return Result.Ok(true)
            }
            token_index = token_index + 1
        }
        index = index + 1
    }
    Result.Ok(false)
}

fn validate_changes(base Indexed, left Indexed, right Indexed) Result[Bool, Text] {
    var left_deleted = false
    var right_deleted = false
    var left_edited = false
    var right_edited = false
    var left_header_changed = false
    var right_header_changed = false
    var index = 0
    while index < length(base.entries) {
        let original = get(base.entries, index)
        let left_index = entry_index(left.entries, original.id)
        let right_index = entry_index(right.entries, original.id)
        if left_index < 0 && right_index < 0 {
            index = index + 1
            continue
        }
        if left_index < 0 {
            left_deleted = true
        }
        if right_index < 0 {
            right_deleted = true
        }
        if left_index < 0 || right_index < 0 {
            let remaining = if left_index < 0 {
                get(right.entries, right_index)
            }
            else {
                get(left.entries, left_index)
            }
            if remaining.body != original.body || remaining.path != original.path {
                return Result.Err(concat("delete versus edit or move: ", original.id))
            }
        } else {
            let edited_left = get(left.entries, left_index)
            let edited_right = get(right.entries, right_index)
            if edited_left.body != original.body && edited_left.body != edited_right.body {
                left_edited = true
            }
            if edited_right.body != original.body && edited_right.body != edited_left.body {
                right_edited = true
            }
            if edited_left.header != original.header && edited_left.header != edited_right.header {
                left_header_changed = true
            }
            if edited_right.header != original.header && edited_right.header != edited_left.header {
                right_header_changed = true
            }
            if ends_with(edited_left.path, "_test.loom") != ends_with(original.path, "_test.loom") ||
            ends_with(edited_right.path, "_test.loom") != ends_with(original.path, "_test.loom") {
                return Result.Err(concat("declaration crossed production/test boundary: ", original.id))
            }
            if edited_left.path != original.path && edited_right.path != original.path &&
            edited_left.path != edited_right.path {
                return Result.Err(concat("concurrent declaration destinations: ", original.id))
            }
            if edited_left.kind != original.kind || edited_left.name != original.name ||
            edited_right.kind != original.kind || edited_right.name != original.name {
                return Result.Err(concat("identity changed kind or name: ", original.id))
            }
            if edited_left.body != original.body && edited_right.body != original.body &&
            edited_left.body != edited_right.body {
                return Result.Err(concat("concurrent body edits: ", original.id))
            }
        }
        index = index + 1
    }
    // The merged program may type-check after a call silently chooses a
    // different overload. Do not compose these cross-side changes as safe.
    if (left_deleted && right_edited) || (right_deleted && left_edited) {
        return Result.Err("cross-side deletion and declaration edit may rebind references; explicit resolution required")
    }
    let left_added = validate_added(base, left, right)?
    let right_added = validate_added(base, right, left)?
    if (left_header_changed && (right_edited || right_added)) ||
    (right_header_changed && (left_edited || left_added)) {
        return Result.Err("cross-side signature or contract change may rebind references; explicit resolution required")
    }
    Result.Ok(true)
}

fn validate_added(base Indexed, branch Indexed, other Indexed) Result[Bool, Text] {
    var added = false
    var index = 0
    while index < length(branch.entries) {
        let entry = get(branch.entries, index)
        if entry_index(base.entries, entry.id) < 0 {
            let peer = entry_index(other.entries, entry.id)
            if peer >= 0 {
                let common = get(other.entries, peer)
                if common.path != entry.path || common.body != entry.body || common.kind != entry.kind ||
                common.name != entry.name || common.key != entry.key {
                    return Result.Err(concat("concurrent added declaration differs: ", entry.id))
                }
            } else {
                added = true
                if reuses_name(base, entry) {
                    return Result.Err("new declaration reuses an existing name; binding changes need explicit review")
                }
                if retained_name_token(other.entries, entry.name)? {
                    return Result.Err("new declaration collides with a name token retained on the other side; binding review required")
                }
            }
        }
        index = index + 1
    }
    Result.Ok(added)
}

fn chosen_entry(base Indexed, left Indexed, right Indexed, id Text) Entry {
    let edited_left = entry_index(left.entries, id)
    let edited_right = entry_index(right.entries, id)
    let base_index = entry_index(base.entries, id)
    if base_index < 0 {
        return if edited_left >= 0 {
            get(left.entries, edited_left)
        } else {
            get(right.entries, edited_right)
        }
    }
    let original = get(base.entries, base_index)
    if edited_left >= 0 && get(left.entries, edited_left).body != original.body {
        return get(left.entries, edited_left)
    }
    if edited_right >= 0 && get(right.entries, edited_right).body != original.body {
        return get(right.entries, edited_right)
    }
    original
}

fn project_of(revision Revision) Result[Project, Text] {
    let files = new[SourceFile]()
    var index = 0
    while index < length(revision.files) {
        let file = get(revision.files, index)
        let tree = match parse(file.text) {
            Result.Ok(tree) => tree
            Result.Err(problem) => {
                return Result.Err(concat("merged source does not parse: ", problem.message))
            }
        }
        push(files, SourceFile {
                package = 0
                path = file.path
                text = file.text
                tree = tree
                test_only = ends_with(file.path, "_test.loom")
                trusted_std = false
            })
        index = index + 1
    }
    let modules = new[ModuleInstance]()
    push(modules, ModuleInstance {
            name = revision.package_name
            source = "semantic-merge"
        })
    let packages = new[Package]()
    push(packages, Package {
            instance = 0
            relative = ""
            imports = new[PackageImport]()
        })
    Result.Ok(Project {
            files = files
            modules = modules
            packages = packages
            root = 0
        })
}

fn checked(revision Revision, backend ProofBackend) Result[Revision, Text] {
    let project = project_of(revision)?
    match checked_analysis(project, false, backend) {
        Result.Ok(_) => {
        }
        Result.Err(problem) => {
            return Result.Err(concat("merged program failed analysis (production): ",
                    problem.diagnostic.message))
        }
    }
    match checked_analysis(project, true, backend) {
        Result.Ok(_) => Result.Ok(revision)
        Result.Err(problem) => Result.Err(concat("merged program failed analysis (tests): ",
                problem.diagnostic.message))
    }
}

fn checked_bindings(left Revision, right Revision, merged Revision, directory Text,
    production Project, tests Project, backend ProofBackend) Result[Bool, Text] {
    let left_indexed = indexed(left)?
    let right_indexed = indexed(right)?
    let merged_indexed = indexed(merged)?
    var pass = 0
    while pass < 2 {
        let testing = pass == 1
        let left_project = if directory == "" {
            project_of(left)?
        } else {
            contextual(if testing {
                    tests
                } else {
                    production
                }, directory, left)?
        }
        let right_project = if directory == "" {
            project_of(right)?
        } else {
            contextual(if testing {
                    tests
                } else {
                    production
                }, directory, right)?
        }
        let merged_project = if directory == "" {
            project_of(merged)?
        } else {
            contextual(if testing {
                    tests
                } else {
                    production
                }, directory, merged)?
        }
        let left_analysis = match checked_analysis(left_project, testing, backend) {
            Result.Ok(value) => value
            Result.Err(problem) => {
                return Result.Err(concat("left source has no complete checked binding evidence: ", problem.diagnostic.message))
            }
        }
        let right_analysis = match checked_analysis(right_project, testing, backend) {
            Result.Ok(value) => value
            Result.Err(problem) => {
                return Result.Err(concat("right source has no complete checked binding evidence: ", problem.diagnostic.message))
            }
        }
        let merged_analysis = match checked_analysis(merged_project, testing, backend) {
            Result.Ok(value) => value
            Result.Err(problem) => {
                return Result.Err(concat("merged source has no complete checked binding evidence: ", problem.diagnostic.message))
            }
        }
        discard compare_retained(left_analysis, left_indexed, merged_analysis, merged_indexed, directory)?
        discard compare_retained(right_analysis, right_indexed, merged_analysis, merged_indexed, directory)?
        pass = pass + 1
    }
    Result.Ok(true)
}

fn imports_in_file(revision Revision, path Text) Result[List[Text], Text] {
    let imports = new[Text]()
    let index = file_index(revision.files, path)
    if index < 0 {
        return Result.Ok(imports)
    }
    let tree = match parse(get(revision.files, index).text) {
        Result.Ok(value) => value,
        Result.Err(problem) => {
            return Result.Err(problem.message)
        }
    }
    var item = 0
    while item < length(tree.children) {
        let node = get(tree.children, item)
        if node.kind == NodeKind.Import {
            push(imports, node.value)
        }
        item = item + 1
    }
    Result.Ok(imports)
}

fn same_imports(base Revision, branch Revision) Result[Bool, Text] {
    var index = 0
    while index < length(base.files) {
        let file = get(base.files, index)
        let original = imports_in_file(base, file.path)?
        let changed = imports_in_file(branch, file.path)?
        if length(original) != length(changed) {
            return Result.Ok(false)
        }
        var item = 0
        while item < length(original) {
            if get(original, item) != get(changed, item) {
                return Result.Ok(false)
            }
            item = item + 1
        }
        index = index + 1
    }
    index = 0
    while index < length(branch.files) {
        let file = get(branch.files, index)
        if file_index(base.files, file.path) < 0 && length(imports_in_file(branch, file.path)?) > 0 {
            return Result.Ok(false)
        }
        index = index + 1
    }
    Result.Ok(true)
}

fn has_imports(revision Revision) Result[Bool, Text] {
    var index = 0
    while index < length(revision.files) {
        if length(imports_in_file(revision, get(revision.files, index).path)?) > 0 {
            return Result.Ok(true)
        }
        index = index + 1
    }
    Result.Ok(false)
}

fn needs_result_import(revision Revision, tests Bool) Result[Bool, Text] {
    var index = 0
    while index < length(revision.files) {
        let file = get(revision.files, index)
        if tests || !ends_with(file.path, "_test.loom") {
            let tree = match parse(file.text) {
                Result.Ok(value) => value,
                Result.Err(problem) => {
                    return Result.Err(problem.message)
                }
            }
            var item = 0
            while item < length(tree.children) {
                if get(tree.children, item).kind == NodeKind.Refined {
                    return Result.Ok(true)
                }
                item = item + 1
            }
        }
        index = index + 1
    }
    Result.Ok(false)
}

fn same_implicit_imports(base Revision, branch Revision) Result[Bool, Text] {
    Result.Ok(needs_result_import(base, false)? == needs_result_import(branch, false)? &&
        needs_result_import(base, true)? == needs_result_import(branch, true)?)
}

fn added_import_name(base Indexed, branch Indexed) Result[Bool, Text] {
    var index = 0
    while index < length(branch.entries) {
        let added = get(branch.entries, index)
        if entry_index(base.entries, added.id) < 0 {
            var file = 0
            while file < length(base.revision.files) {
                let imports = imports_in_file(base.revision, get(base.revision.files, file).path)?
                var item = 0
                while item < length(imports) {
                    if name(get(imports, item)) == added.name {
                        return Result.Ok(true)
                    }
                    item = item + 1
                }
                file = file + 1
            }
        }
        index = index + 1
    }
    Result.Ok(false)
}

fn context_matches_base(project Project, directory Text, base Revision, tests Bool) Bool {
    package_context_matches(project, project.root, directory, base, tests)
}

fn package_context_matches(project Project, package Int, directory Text, base Revision, tests Bool) Bool {
    if package_label(project.modules, project.packages, package) != base.package_name {
        return false
    }
    var roots = 0
    var index = 0
    while index < length(project.files) {
        let file = get(project.files, index)
        if file.package == package {
            roots = roots + 1
            var found = false
            var item = 0
            while item < length(base.files) {
                let source = get(base.files, item)
                if file.path == join_path(directory, source.path) && file.text == source.text &&
                file.test_only == ends_with(source.path, "_test.loom") {
                    found = true
                }
                item = item + 1
            }
            if !found {
                return false
            }
        }
        index = index + 1
    }
    var expected = 0
    index = 0
    while index < length(base.files) {
        if tests || !ends_with(get(base.files, index).path, "_test.loom") {
            expected = expected + 1
        }
        index = index + 1
    }
    roots == expected
}

fn contextual(project Project, directory Text, revision Revision) Result[Project, Text] {
    contextual_package(project, project.root, directory, revision)
}

fn contextual_package(project Project, package Int, directory Text, revision Revision) Result[Project, Text] {
    let files = new[SourceFile]()
    var index = 0
    while index < length(project.files) {
        let file = get(project.files, index)
        if file.package != package {
            push(files, file)
        }
        index = index + 1
    }
    index = 0
    while index < length(revision.files) {
        let file = get(revision.files, index)
        let tree = match parse(file.text) {
            Result.Ok(value) => value,
            Result.Err(problem) => {
                return Result.Err(concat("merged source does not parse: ", problem.message))
            }
        }
        push(files, SourceFile {
                package = package
                path = join_path(directory, file.path)
                text = file.text
                tree = tree
                test_only = ends_with(file.path, "_test.loom")
                trusted_std = false
            })
        index = index + 1
    }
    Result.Ok(Project {
            files = files
            modules = project.modules
            packages = project.packages
            root = project.root
        })
}

fn checked_context(base Revision, merged Revision, production Project, tests Project, directory Text,
    backend ProofBackend) Result[Revision, Text] {
    if !context_matches_base(production, directory, base, false) ||
    !context_matches_base(tests, directory, base, true) {
        return Result.Err("project context must contain the exact baseline package")
    }
    match checked_analysis(contextual(production, directory, merged)?, false, backend) {
        Result.Ok(_) => {
        }
        Result.Err(problem) => {
            return Result.Err(concat("merged program failed analysis (production): ", problem.diagnostic.message))
        }
    }
    match checked_analysis(contextual(tests, directory, merged)?, true, backend) {
        Result.Ok(_) => {
        }
        Result.Err(problem) => {
            return Result.Err(concat("merged program failed analysis (tests): ", problem.diagnostic.message))
        }
    }
    // A changed dependency may make the baseline invalid while the proposed
    // merge happens to adapt to it. That is a cross-package change, not a
    // safe merge against this pinned project basis.
    match checked_analysis(production, false, backend) {
        Result.Ok(_) => {
        }
        Result.Err(problem) => {
            return Result.Err(concat("baseline program failed analysis (production): ", problem.diagnostic.message))
        }
    }
    match checked_analysis(tests, true, backend) {
        Result.Ok(_) => {
        }
        Result.Err(problem) => {
            return Result.Err(concat("baseline program failed analysis (tests): ", problem.diagnostic.message))
        }
    }
    Result.Ok(merged)
}

// Join file presentation and fill declaration slots by stable identity. Layout
// obligations are independent: files may carry different branches, but no ID
// may be lost, resurrected or duplicated.
fn proposed(base Revision, left Revision, right Revision) Result[Revision, Text] {
    let original = indexed(base)?
    let edited_left = indexed(left)?
    let edited_right = indexed(right)?
    if base.package_name != left.package_name || base.package_name != right.package_name {
        return Result.Err("semantic merge cannot cross package identities")
    }
    discard validate_changes(original, edited_left, edited_right)?
    let files = new[File]()
    let sources = source_files(original, edited_left, edited_right)
    var index = 0
    while index < length(sources) {
        let path = get(sources, index).path
        match rendered_file(original, edited_left, edited_right, path)? {
            Option.Some(file) => push(files, file)
            Option.None => {
            }
        }
        index = index + 1
    }
    let merged = Revision {
        package_name = base.package_name
        files = files
        identities = joined_identities(original, edited_left, edited_right)
    }
    discard indexed(merged)?
    Result.Ok(merged)
}

pub fn merge(base Revision, left Revision, right Revision) Result[Revision, Text] {
    merge(base, left, right, no_proof_backend())
}

pub fn merge(base Revision, left Revision, right Revision, backend ProofBackend) Result[Revision, Text] {
    let project = project_of(base)?
    let normalized = normalize_renames(base, left, right, "", project, project, backend)?
    merge_same_names(normalized.original, normalized.left, normalized.right, backend)
}

fn merge_same_names(base Revision, left Revision, right Revision, backend ProofBackend) Result[Revision, Text] {
    let merged = proposed(base, left, right)?
    if has_imports(base)? || has_imports(left)? || has_imports(right)? ||
    needs_result_import(base, true)? || needs_result_import(left, true)? ||
    needs_result_import(right, true)? {
        return Result.Err("import-bearing merges require an explicit pinned project context")
    }
    discard checked(merged, backend)?
    let original = indexed(base)?
    if !same_layout(original, indexed(left)?) || !same_layout(original, indexed(right)?) {
        let project = project_of(base)?
        discard checked_bindings(left, right, merged, "", project, project, backend)?
    }
    Result.Ok(merged)
}

pub fn merge_with_context(base Revision, left Revision, right Revision,
    production Project, tests Project, directory Text) Result[Revision, Text] {
    merge_with_context(base, left, right, production, tests, directory, no_proof_backend())
}

pub fn merge_with_context(base Revision, left Revision, right Revision,
    production Project, tests Project, directory Text, backend ProofBackend) Result[Revision, Text] {
    let normalized = normalize_renames(base, left, right, directory, production, tests, backend)?
    if same_revision_names(base, normalized.original) {
        return merge_same_names_with_context(base, left, right, production, tests, directory, backend)
    }
    merge_same_names_with_context(normalized.original, normalized.left, normalized.right,
        contextual(production, directory, normalized.original)?,
        contextual(tests, directory, normalized.original)?, directory, backend)
}

fn merge_same_names_with_context(base Revision, left Revision, right Revision,
    production Project, tests Project, directory Text, backend ProofBackend) Result[Revision, Text] {
    if !same_imports(base, left)? || !same_imports(base, right)? ||
    !same_implicit_imports(base, left)? || !same_implicit_imports(base, right)? {
        return Result.Err("import bindings changed; this merge needs explicit resolution")
    }
    let original = indexed(base)?
    if added_import_name(original, indexed(left)?)? || added_import_name(original, indexed(right)?)? {
        return Result.Err("new declaration shadows an import; binding changes need explicit review")
    }
    let merged = proposed(base, left, right)?
    if !same_imports(base, merged)? || !same_implicit_imports(base, merged)? {
        return Result.Err("merged imports differ from the pinned project context")
    }
    discard checked_context(base, merged, production, tests, directory, backend)?
    if !same_layout(original, indexed(left)?) || !same_layout(original, indexed(right)?) {
        discard checked_bindings(left, right, merged, directory, production, tests, backend)?
    }
    Result.Ok(merged)
}
