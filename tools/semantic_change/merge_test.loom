import std.loom.ast.NodeKind
import std.io.write_error
import std.list.get
import std.list.new
import std.list.push
import std.result.Result
import std.text.contains

fn identities(amount_path Text) List[Identity] {
    let bindings = new[Identity]()
    push(bindings, Identity {
            id = "amount-id"
            path = amount_path
            kind = NodeKind.Function
            name = "amount"
        })
    push(bindings, Identity {
            id = "entry-id"
            path = "app.loom"
            kind = NodeKind.Function
            name = "entry"
        })
    bindings
}

fn revision(amount_path Text, source Text, app Text) Revision {
    let files = new[File]()
    push(files, File {
            path = "value.loom"
            text = source
        })
    push(files, File {
            path = "app.loom"
            text = app
        })
    Revision {
        package_name = "sample"
        files = files
        identities = identities(amount_path)
    }
}

fn baseline() Revision {
    revision("value.loom", "fn amount() Int { 1 }\n",
        "fn entry() Int { amount() }\n")
}

test fn refined_declaration_changes_the_implicit_project_closure() {
    let before = baseline()
    let after = revision("value.loom", "type Positive = Int where self > 0\nfn amount() Int { 1 }\n",
        "fn entry() Int { amount() }\n")
    match same_implicit_imports(before, after) {
        Result.Ok(unchanged) => {
            assert !unchanged
        }
        Result.Err(_) => {
            assert false
        }
    }
}

test fn move_and_independent_edit_merge_without_reformatting() {
    let base = baseline()
    let moved = revision("app.loom", "",
        "// destination note\nfn amount() Int { 1 }\nfn entry() Int { amount() }\n")
    let edited = revision("value.loom", "fn amount() Int {\n    // explanation\n    2\n}\n",
        "fn entry() Int { amount() }\n")
    match merge(base, moved, edited) {
        Result.Ok(merged) => {
            assert get(merged.files, 0).text == ""
            assert get(merged.files, 1).text ==
            "// destination note\nfn amount() Int {\n    // explanation\n    2\n}\nfn entry() Int { amount() }\n"
            assert get(merged.identities, 0).path == "app.loom"
        }
        Result.Err(message) => {
            discard write_error(message)
            assert false
        }
    }
    match merge(base, edited, moved) {
        Result.Ok(merged) => {
            assert get(merged.files, 0).text == ""
            assert get(merged.files, 1).text ==
            "// destination note\nfn amount() Int {\n    // explanation\n    2\n}\nfn entry() Int { amount() }\n"
        }
        Result.Err(message) => {
            discard write_error(message)
            assert false
        }
    }
}

test fn a_carrier_addition_and_an_independent_body_edit_merge() {
    let base = baseline()
    let moved = revision("app.loom", "",
        "// destination note\nfn amount() Int { 1 }\nfn entry() Int { amount() }\nfn extra() Int { 9 }\n")
    push(moved.identities, Identity {
            id = "extra-id"
            path = "app.loom"
            kind = NodeKind.Function
            name = "extra"
        })
    let edited = revision("value.loom", "fn amount() Int { 2 }\n",
        "fn entry() Int { amount() }\n")
    match merge(base, moved, edited) {
        Result.Ok(merged) => {
            assert get(merged.files, 0).text == ""
            assert get(merged.files, 1).text ==
            "// destination note\nfn amount() Int { 2 }\nfn entry() Int { amount() }\nfn extra() Int { 9 }\n"
            assert get(merged.identities, 2).id == "extra-id"
        }
        Result.Err(message) => {
            discard write_error(message)
            assert false
        }
    }
    match merge(base, edited, moved) {
        Result.Ok(merged) => {
            assert get(merged.files, 1).text ==
            "// destination note\nfn amount() Int { 2 }\nfn entry() Int { amount() }\nfn extra() Int { 9 }\n"
        }
        Result.Err(message) => {
            discard write_error(message)
            assert false
        }
    }
}

test fn dual_additions_and_binding_sensitive_names_need_resolution() {
    let base = baseline()
    let left = revision("value.loom", "fn amount() Int { 1 }\nfn extra() Int { 3 }\n",
        "fn entry() Int { amount() }\n")
    push(left.identities, Identity {
            id = "extra-id"
            path = "value.loom"
            kind = NodeKind.Function
            name = "extra"
        })
    let right = revision("value.loom", "fn amount() Int { 1 }\n",
        "fn entry() Int { amount() }\nfn another() Int { 4 }\n")
    push(right.identities, Identity {
            id = "another-id"
            path = "app.loom"
            kind = NodeKind.Function
            name = "another"
        })
    match merge(base, left, right) {
        Result.Ok(_) => {
            assert false
        }
        Result.Err(message) => {
            assert contains(message, "concurrent added declarations")
        }
    }
    let reused = revision("value.loom", "fn amount() Int { 1 }\n",
        "fn entry() Int { amount() }\n")
    push(reused.files, File {
            path = "overload.loom"
            text = "fn amount(value Int) Int { value }\n"
        })
    push(reused.identities, Identity {
            id = "overload-id"
            path = "overload.loom"
            kind = NodeKind.Function
            name = "amount"
        })
    match merge(base, reused, base) {
        Result.Ok(_) => {
            assert false
        }
        Result.Err(message) => {
            assert contains(message, "binding changes need explicit review")
        }
    }
}

test fn deletion_conflicts_with_edit_or_move() {
    let base = baseline()
    let files = new[File]()
    push(files, File {
            path = "value.loom"
            text = ""
        })
    push(files, File {
            path = "app.loom"
            text = "fn entry() Int { 0 }\n"
        })
    let ids = new[Identity]()
    push(ids, Identity {
            id = "entry-id"
            path = "app.loom"
            kind = NodeKind.Function
            name = "entry"
        })
    let removed = Revision {
        package_name = "sample"
        files = files
        identities = ids
    }
    let edited = revision("value.loom", "fn amount() Int { 2 }\n",
        "fn entry() Int { amount() }\n")
    match merge(base, removed, edited) {
        Result.Ok(_) => {
            assert false
        }
        Result.Err(message) => {
            assert contains(message, "delete versus edit")
        }
    }
}

test fn deleting_a_local_candidate_while_other_side_edits_a_call_is_not_a_safe_merge() {
    let base = revision("value.loom",
        "import sample.math.amount\nfn amount(value Int) Int { value }\n",
        "fn entry() Int { amount(1) }\n")
    let files = new[File]()
    push(files, File {
            path = "value.loom"
            text = "import sample.math.amount\n"
        })
    push(files, File {
            path = "app.loom"
            text = "fn entry() Int { amount(1) }\n"
        })
    let ids = new[Identity]()
    push(ids, Identity {
            id = "entry-id"
            path = "app.loom"
            kind = NodeKind.Function
            name = "entry"
        })
    let removed = Revision {
        package_name = "sample"
        files = files
        identities = ids
    }
    let edited = revision("value.loom",
        "import sample.math.amount\nfn amount(value Int) Int { value }\n",
        "fn entry() Int { amount(2) }\n")
    match merge(base, removed, edited) {
        Result.Ok(_) => {
            assert false
        }
        Result.Err(message) => {
            assert contains(message, "cross-side deletion")
        }
    }
    match merge(base, edited, removed) {
        Result.Ok(_) => {
            assert false
        }
        Result.Err(message) => {
            assert contains(message, "cross-side deletion")
        }
    }
}

test fn signature_change_and_other_side_call_edit_need_resolution() {
    let base = revision("value.loom", "fn amount(value Int) Int { value }\n",
        "fn entry() Int { amount(1) }\n")
    let changed = revision("value.loom", "fn amount(value Float) Int { 1 }\n",
        "fn entry() Int { amount(1) }\n")
    let caller = revision("value.loom", "fn amount(value Int) Int { value }\n",
        "fn entry() Int { amount(2) }\n")
    match merge(base, changed, caller) {
        Result.Ok(_) => {
            assert false
        }
        Result.Err(message) => {
            assert contains(message, "signature or contract change")
        }
    }
}

test fn signature_change_and_other_side_addition_need_resolution() {
    let base = baseline()
    let changed = revision("value.loom", "fn amount(value Int) Int { value }\n",
        "fn entry() Int { amount() }\n")
    let added = revision("value.loom", "fn amount() Int { 1 }\n",
        "fn entry() Int { amount() }\nfn extra() Int { amount() }\n")
    push(added.identities, Identity {
            id = "extra-id"
            path = "app.loom"
            kind = NodeKind.Function
            name = "extra"
        })
    match merge(base, changed, added) {
        Result.Ok(_) => {
            assert false
        }
        Result.Err(message) => {
            assert contains(message, "signature or contract change")
        }
    }
    match merge(base, added, changed) {
        Result.Ok(_) => {
            assert false
        }
        Result.Err(message) => {
            assert contains(message, "signature or contract change")
        }
    }
}

test fn ambiguous_identity_and_conflicting_body_edits_fail_closed() {
    let base = baseline()
    let overloaded = revision("value.loom",
        "fn amount() Int { 1 }\nfn amount(value Int) Int { value }\n",
        "fn entry() Int { amount() }\n")
    match merge(base, overloaded, baseline()) {
        Result.Ok(_) => {
            assert false
        }
        Result.Err(message) => {
            assert contains(message, "ambiguous declaration")
        }
    }
    let one = revision("value.loom", "fn amount() Int { 2 }\n",
        "fn entry() Int { amount() }\n")
    let two = revision("value.loom", "fn amount() Int { 3 }\n",
        "fn entry() Int { amount() }\n")
    match merge(base, one, two) {
        Result.Ok(_) => {
            assert false
        }
        Result.Err(message) => {
            assert contains(message, "concurrent body edits")
        }
    }
}

test fn independent_body_edits_merge_without_layout_change() {
    let base = baseline()
    let left = revision("value.loom", "fn amount() Int { 2 }\n",
        "fn entry() Int { amount() }\n")
    let right = revision("value.loom", "fn amount() Int { 1 }\n",
        "fn entry() Int { amount() + 1 }\n")
    match merge(base, left, right) {
        Result.Ok(merged) => {
            assert get(merged.files, 0).text == "fn amount() Int { 2 }\n"
            assert get(merged.files, 1).text == "fn entry() Int { amount() + 1 }\n"
        }
        Result.Err(message) => {
            assert false
        }
    }
}

test fn noncarrier_trivia_changes_are_not_silently_lost() {
    let base = baseline()
    let moved = revision("app.loom", "",
        "fn amount() Int { 1 }\nfn entry() Int { amount() }\n")
    let edited = revision("value.loom", "// new note\nfn amount() Int { 2 }\n",
        "fn entry() Int { amount() }\n")
    match merge(base, moved, edited) {
        Result.Ok(_) => {
            assert false
        }
        Result.Err(message) => {
            assert contains(message, "outside declaration")
        }
    }
}

test fn merged_program_must_pass_type_analysis() {
    let base = revision("value.loom", "fn amount() Int { 1 }\n",
        "fn entry() {}\n")
    let left = revision("value.loom", "fn amount() Int { true }\n",
        "fn entry() {}\n")
    let right = revision("value.loom", "fn amount() Int { 1 }\n",
        "fn entry() { assert amount() == 1 }\n")
    match merge(base, left, right) {
        Result.Ok(_) => {
            assert false
        }
        Result.Err(message) => {
            assert contains(message, "failed analysis")
        }
    }
}

test fn test_only_helpers_cannot_satisfy_production_calls() {
    let files = new[File]()
    push(files, File {
            path = "app.loom"
            text = "fn entry() Int { 1 }\n"
        })
    push(files, File {
            path = "app_test.loom"
            text = "fn helper() Int { 2 }\n"
        })
    let ids = new[Identity]()
    push(ids, Identity {
            id = "entry-id"
            path = "app.loom"
            kind = NodeKind.Function
            name = "entry"
        })
    push(ids, Identity {
            id = "helper-id"
            path = "app_test.loom"
            kind = NodeKind.Function
            name = "helper"
        })
    let base = Revision {
        package_name = "sample"
        files = files
        identities = ids
    }
    let edited_files = new[File]()
    push(edited_files, File {
            path = "app.loom"
            text = "fn entry() Int { helper() }\n"
        })
    push(edited_files, File {
            path = "app_test.loom"
            text = "fn helper() Int { 2 }\n"
        })
    let edited = Revision {
        package_name = "sample"
        files = edited_files
        identities = ids
    }
    match merge(base, edited, base) {
        Result.Ok(_) => {
            assert false
        }
        Result.Err(message) => {
            assert contains(message, "failed analysis (production)")
        }
    }
    let invalid_test_files = new[File]()
    push(invalid_test_files, File {
            path = "app.loom"
            text = "fn entry() Int { 1 }\n"
        })
    push(invalid_test_files, File {
            path = "app_test.loom"
            text = "fn helper() Int { missing() }\n"
        })
    let invalid_test = Revision {
        package_name = "sample"
        files = invalid_test_files
        identities = ids
    }
    match merge(base, invalid_test, base) {
        Result.Ok(_) => {
            assert false
        }
        Result.Err(message) => {
            assert contains(message, "failed analysis (tests)")
        }
    }
}

fn boundary_revision(path Text, production Text, testing Text) Revision {
    let files = new[File]()
    push(files, File {
            path = "value.loom"
            text = production
        })
    push(files, File {
            path = "value_test.loom"
            text = testing
        })
    let ids = new[Identity]()
    push(ids, Identity {
            id = "amount-id"
            path = path
            kind = NodeKind.Function
            name = "amount"
        })
    Revision {
        package_name = "sample"
        files = files
        identities = ids
    }
}

test fn moving_a_declaration_into_tests_requires_explicit_resolution() {
    let base = boundary_revision("value.loom", "fn amount() Int { 1 }\n", "")
    let moved = boundary_revision("value_test.loom", "", "fn amount() Int { 1 }\n")
    let edited = boundary_revision("value.loom", "fn amount() Int { 2 }\n", "")
    match merge(base, moved, edited) {
        Result.Ok(_) => {
            assert false
        }
        Result.Err(message) => {
            assert contains(message, "production/test boundary")
        }
    }
}

test fn source_paths_cannot_escape_the_package_directory() {
    let files = [File {
            path = "../value.loom"
            text = "fn value() Int { 1 }\n"
        }]
    let ids = [Identity {
            id = "value-id"
            path = "../value.loom"
            kind = NodeKind.Function
            name = "value"
        }]
    let revision = Revision {
        package_name = "sample"
        files = files
        identities = ids
    }
    match merge(revision, revision, revision) {
        Result.Ok(_) => {
            assert false
        }
        Result.Err(message) => {
            assert contains(message, "invalid or unsupported declaration identity")
        }
    }
}
