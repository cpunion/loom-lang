fn member_scaffold_case(note Text, edited Bool, defaults Bool) Revision {
    let revision = if defaults {
        default_container_case(false, edited)
    } else {
        implementation_case(false, edited, false)
    }
    let files = clone(revision.files)
    let file = get(files, 1)
    set(files, 1, File {
            text = replace(file.text, "    fn second", concat(note, "    fn second"))
            ..file
        })
    Revision {
        files = files
        ..revision
    }
}

test fn inter_member_trivia_composes_with_checked_method_bodies() {
    let note = "    // Keep this explanation.\r\n\r\n"
    var mode = 0
    while mode < 2 {
        let base = member_scaffold_case("", false, mode == 0)
        let left = member_scaffold_case(note, false, mode == 0)
        let right = member_scaffold_case("", true, mode == 0)
        let merged = accepted_file_merge(base, left, right)
        assert same_file_result(merged, accepted_file_merge(base, right, left))
        let source = get(merged.files, 1).text
        assert contains(source, note) && contains(source, "let computed =")
        let context = rename_context(base)
        assert match merge_with_context(base, left, right, context, context, "pkg") {
            Result.Ok(value) => same_file_result(value, merged)
            Result.Err(message) => {
                discard write_error(message)
                false
            }
        }
        assert match merge_packages(generic_package_case(base), generic_package_case(left),
            generic_package_case(right), context, context) {
            Result.Ok(value) => same_file_result(get(value, 0).revision, merged)
            Result.Err(message) => {
                discard write_error(message)
                false
            }
        }
        mode = mode + 1
    }
}

test fn competing_member_trivia_and_interface_changes_still_require_resolution() {
    let base = member_scaffold_case("", false, false)
    let left = member_scaffold_case("    // Left explanation.\n", false, false)
    let right = member_scaffold_case("    // Right explanation.\n", true, false)
    assert match merge(base, left, right) {
        Result.Err(_) => true
        Result.Ok(_) => false
    }
    let api = member_scaffold_case("", false, true)
    let docs = member_scaffold_case("    // Interface explanation.\n", false, true)
    let files = clone(api.files)
    let file = get(files, 1)
    set(files, 1, File {
            text = replace(file.text, "fn second(self Self) Int {",
                "fn second(self Self) Int\n        ensures result == 2 {")
            ..file
        })
    let changed = Revision {
        files = files
        ..api
    }
    assert match checked(changed, no_proof_backend()) {
        Result.Ok(_) => true
        Result.Err(message) => {
            discard write_error(message)
            false
        }
    }
    assert match merge(api, docs, changed) {
        Result.Err(_) => true
        Result.Ok(_) => false
    }
}

test fn changed_member_trivia_does_not_hide_unknown_retained_references() {
    let base = comptime_helper_body_revision(false, false, true)
    let files = clone(base.files)
    let file = get(files, 0)
    set(files, 0, File {
            text = replace(file.text, "    fn second", "    // Retain this method.\n    fn second")
            ..file
        })
    let left = Revision {
        files = files
        ..base
    }
    let right = comptime_helper_body_revision(true, false, true)
    let candidate = match proposed(base, left, right) {
        Result.Ok(value) => value
        Result.Err(message) => {
            discard write_error(message)
            assert false
            base
        }
    }
    assert match checked(candidate, no_proof_backend()) {
        Result.Ok(_) => true
        Result.Err(_) => false
    }
    assert match merge(base, left, right) {
        Result.Err(message) => message == "retained source reference form has no binding comparison support"
        Result.Ok(_) => false
    }
}

fn member_scaffold_module(note Text, edited Bool) List[PackageRevision] {
    let library = member_scaffold_case(note, false, true)
    [package_fixture("sample.lib", "/module/lib", [File {
                    path = "api.loom"
                    text = replace(get(library.files, 1).text, "concept Read", "pub concept Read")
                }]),
        package_fixture("sample.app", "/module/app", [File {
                    path = "main.loom"
                    text = replace("""
                        import sample.lib.Read

                        impl Read for Int {
                        }

                        fn entry() Int {
                            let value = 7
                            value.first() + value.second() + EXTRA
                        }
                        """, "EXTRA", if edited {
                            "1"
                        } else {
                            "0"
                        })
                }, File {
                    path = "main_test.loom"
                    text = """
                        test fn uses_private_entry() {
                            assert entry() > 0
                        }
                        """
                }])]
}

test fn member_trivia_is_not_a_cross_package_interface_change() {
    let note = "    // Library explanation.\n"
    let base = member_scaffold_module("", false)
    let left = member_scaffold_module(note, false)
    let right = member_scaffold_module("", true)
    let branches = [left, right]
    let contexts = [independent_context(base, false), independent_context(base, true)]
    var scope = 0
    while scope < length(contexts) {
        push(get(get(contexts, scope).packages, 1).imports, PackageImport {
                spelling = "sample.lib"
                target = 0
            })
        scope = scope + 1
    }
    var order = 0
    while order < 2 {
        let merged = match merge_packages(base, get(branches, order), get(branches, 1 - order),
            get(contexts, 0), get(contexts, 1)) {
            Result.Ok(value) => value
            Result.Err(message) => {
                discard write_error(message)
                assert false
                base
            }
        }
        assert contains(get(get(merged, 0).revision.files, 0).text, note)
        assert contains(get(get(merged, 1).revision.files, 0).text, "value.second() + 1")
        order = order + 1
    }
}
