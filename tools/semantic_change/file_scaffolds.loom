import std.list.sorted
import std.text.byte

// A file skeleton is its declaration-ID order plus all bytes outside those
// declarations. Absence differs from an intentionally empty source file.
fn same_file_scaffold(left Indexed, right Indexed, path Text) Bool {
    let a = file_index(left.revision.files, path)
    let b = file_index(right.revision.files, path)
    if a < 0 || b < 0 {
        return a == b
    }
    let original = get(left.revision.files, a)
    let changed = get(right.revision.files, b)
    var before = 0
    var after = 0
    var ordinal = 0
    while true {
        let original_index = entry_in_file(left.entries, path, ordinal)
        let current = entry_in_file(right.entries, path, ordinal)
        if original_index < 0 || current < 0 {
            if original_index != current {
                return false
            }
            break
        }
        let a_entry = get(left.entries, original_index)
        let b_entry = get(right.entries, current)
        if a_entry.id != b_entry.id ||
        slice(original.text, before, a_entry.start) != slice(changed.text, after, b_entry.start) {
            return false
        }
        before = a_entry.end
        after = b_entry.end
        ordinal = ordinal + 1
    }
    slice(original.text, before, length(original.text)) == slice(changed.text, after, length(changed.text))
}

fn file_carrier(base Indexed, left Indexed, right Indexed, path Text) Result[Indexed, Text] {
    if same_file_scaffold(left, right, path) || same_file_scaffold(base, right, path) {
        return Result.Ok(left)
    }
    if same_file_scaffold(base, left, path) {
        return Result.Ok(right)
    }
    Result.Err(concat("conflicting file layout or text outside declaration bodies: ", path))
}

fn joined_source_gap(base Text, left Text, right Text, path Text) Result[Text, Text] {
    if left == right || base == right {
        return Result.Ok(left)
    }
    if base == left {
        return Result.Ok(right)
    }
    Result.Err(concat("conflicting text outside declaration bodies: ", path))
}

// Gap boundaries are comparable only with the same declaration-ID sequence in
// all three files. Never infer comment attachment across a move or reorder.
fn joined_file_gaps(base Indexed, left Indexed, right Indexed, path Text) Result[File, Text] {
    let a = file_index(base.revision.files, path)
    let b = file_index(left.revision.files, path)
    let c = file_index(right.revision.files, path)
    let conflict = concat("conflicting file layout or text outside declaration bodies: ", path)
    if a < 0 || b < 0 || c < 0 {
        return Result.Err(conflict)
    }
    let original = get(base.revision.files, a)
    let edited_left = get(left.revision.files, b)
    let edited_right = get(right.revision.files, c)
    var before = 0
    var left_offset = 0
    var right_offset = 0
    var ordinal = 0
    var output = ""
    while true {
        let a_entry = entry_in_file(base.entries, path, ordinal)
        let b_entry = entry_in_file(left.entries, path, ordinal)
        let c_entry = entry_in_file(right.entries, path, ordinal)
        if a_entry < 0 || b_entry < 0 || c_entry < 0 {
            if a_entry >= 0 || b_entry >= 0 || c_entry >= 0 {
                return Result.Err(conflict)
            }
            break
        }
        let entry = get(base.entries, a_entry)
        let a_changed = get(left.entries, b_entry)
        let b_changed = get(right.entries, c_entry)
        if entry.id != a_changed.id || entry.id != b_changed.id {
            return Result.Err(conflict)
        }
        let gap = joined_source_gap(slice(original.text, before, entry.start),
            slice(edited_left.text, left_offset, a_changed.start),
            slice(edited_right.text, right_offset, b_changed.start), path)?
        output = concat(output, concat(gap, chosen_entry(base, left, right, entry.id)?.body))
        before = entry.end
        left_offset = a_changed.end
        right_offset = b_changed.end
        ordinal = ordinal + 1
    }
    let tail = joined_source_gap(slice(original.text, before, length(original.text)),
        slice(edited_left.text, left_offset, length(edited_left.text)),
        slice(edited_right.text, right_offset, length(edited_right.text)), path)?
    Result.Ok(File {
            path = path
            text = concat(output, tail)
        })
}

fn rendered_file(base Indexed, left Indexed, right Indexed, path Text) Result[Option[File], Text] {
    let carrier = match file_carrier(base, left, right, path) {
        Result.Ok(value) => value
        Result.Err(_) => {
            return Result.Ok(Option.Some(joined_file_gaps(base, left, right, path)?))
        }
    }
    let selected = file_index(carrier.revision.files, path)
    if selected < 0 {
        return Result.Ok(Option.None)
    }
    let file = get(carrier.revision.files, selected)
    var output = ""
    var offset = 0
    var ordinal = 0
    while true {
        let position = entry_in_file(carrier.entries, path, ordinal)
        if position < 0 {
            break
        }
        let entry = get(carrier.entries, position)
        output = concat(output, slice(file.text, offset, entry.start))
        output = concat(output, chosen_entry(base, left, right, entry.id)?.body)
        offset = entry.end
        ordinal = ordinal + 1
    }
    Result.Ok(Option.Some(File {
                path = path
                text = concat(output, slice(file.text, offset, length(file.text)))
            }))
}

fn source_files(base Indexed, left Indexed, right Indexed) List[File] {
    let files = new[File]()
    let branches = [base, left, right]
    var branch = 0
    while branch < length(branches) {
        let sources = get(branches, branch).revision.files
        var index = 0
        while index < length(sources) {
            let file = get(sources, index)
            if file_index(files, file.path) < 0 {
                push(files, file)
            }
            index = index + 1
        }
        branch = branch + 1
    }
    files
}

fn identity_before(left Identity, right Identity) Bool {
    var index = 0
    while index < length(left.id) && index < length(right.id) {
        let a = std.text.byte(left.id, index)
        let b = std.text.byte(right.id, index)
        if a != b {
            return a < b
        }
        index = index + 1
    }
    length(left.id) < length(right.id)
}

fn placed_identity(entry Entry, path Text) Identity {
    Identity {
        id = entry.id
        path = path
        kind = entry.kind
        name = entry.name
        key = entry.key
    }
}

// Merge declaration placement independently of file presentation. Re-indexing
// the rendered source against these obligations catches lost, resurrected or
// duplicated declarations. Retained metadata order stays stable; fresh rows are
// sorted by ID so swapping branches cannot reorder persistent identity metadata.
fn joined_identities(base Indexed, left Indexed, right Indexed) Result[List[Identity], Text] {
    let output = new[Identity]()
    var index = 0
    while index < length(base.revision.identities) {
        let identity = get(base.revision.identities, index)
        let a = entry_index(left.entries, identity.id)
        let b = entry_index(right.entries, identity.id)
        if a >= 0 && b >= 0 {
            let a_path = get(left.entries, a).path
            let b_path = get(right.entries, b).path
            let selected = if a_path == identity.path {
                b_path
            } else {
                a_path
            }
            push(output, placed_identity(chosen_entry(base, left, right, identity.id)?, selected))
        }
        index = index + 1
    }
    let fresh = new[Identity]()
    let branches = [left, right]
    var branch = 0
    while branch < length(branches) {
        let entries = get(branches, branch).entries
        index = 0
        while index < length(entries) {
            let entry = get(entries, index)
            if entry_index(base.entries, entry.id) < 0 &&
            (branch == 0 || entry_index(left.entries, entry.id) < 0) {
                push(fresh, placed_identity(entry, entry.path))
            }
            index = index + 1
        }
        branch = branch + 1
    }
    let ordered = sorted(fresh, identity_before)
    index = 0
    while index < length(ordered) {
        push(output, get(ordered, index))
        index = index + 1
    }
    Result.Ok(output)
}
