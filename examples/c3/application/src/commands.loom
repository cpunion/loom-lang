module application.commands

import application.audit.accepted_event
import application.workflow.execute
import catalog.product.Product
import catalog.reporting.report_name
import foundation.error.CheckoutError
import foundation.money.Money
import foundation.quantity.Quantity

pub fn run_checkout() Unit {
    let product = Product {
        label = "compiler"
        price = Money(40.0)
        stock = Quantity(2)
    }
    let name = report_name(product)
    assert name == "compiler"
    match execute(product) {
        Ok(total) => {
            assert total == 45.0
            let event = accepted_event("checkout")
            assert event.accepted
            Unit
        }
        Err(CheckoutError.OutOfStock) => {
            assert false
            Unit
        }
        Err(CheckoutError.Rejected) => {
            assert false
            Unit
        }
    }
}
