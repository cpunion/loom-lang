import catalog.inventory.available
import catalog.product.Product
import catalog.shipping.standard_shipping
import foundation.error.CheckoutError
import foundation.money.Money

pub fn checkout(product Product) Result[Money, CheckoutError] {
    if !available(product) {
        return Err(CheckoutError.OutOfStock)
    }
    let shipping = standard_shipping()
    match Money(product.price + shipping) {
        Ok(total) => Ok(total)
        Err(_) => Err(CheckoutError.Rejected)
    }
}
