module example.concepts_polymorphism

pub record Label {
    text Text
}

pub dyn concept Labeled {
    method label(self) Text
}

impl Labeled for Label {
    method label(self) Text {
        self.text
    }
}

pub fn static_label(value Labeled) Text {
    value.label()
}

pub enum FormatError {
    Rejected
}

pub record IdentityFormatter {}

pub dyn concept Formatter {
    associated type Error
    method format(self, text Text) Result[Text, Self.Error]
}

impl Formatter for IdentityFormatter {
    associated type Error = FormatError

    method format(self, text Text) Result[Text, FormatError] {
        Ok(text)
    }
}

pub fn dynamic_format(
    formatter Formatter[Error = FormatError],
    text Text,
) Result[Text, FormatError] {
    formatter.format(text)
}

pub record Counter {
    value Int
}

pub dyn concept Source {
    associated type Item
    method next(mut self) Option[Self.Item]
}

impl Source for Counter {
    associated type Item = Int

    method next(mut self) Option[Int] {
        self.value = self.value + 1
        Some(self.value)
    }
}

pub fn take_one(source Source[Item = Int]) Option[Int] {
    source.next()
}

pub record LabelHolder {
    item dyn Labeled
}

pub enum LabelPacket {
    Item(dyn Labeled)
}

pub record LabelCollection {
    items List[dyn Labeled]
}

pub fn erase_label(value Label) dyn Labeled {
    value
}

pub fn forward_label(value Labeled) dyn Labeled {
    value
}

pub fn erase_source(value Counter) dyn Source[Item = Int] {
    value
}

pub fn main() {
    let label = Label { text = "loom" }
    let rendered = static_label(label)
    assert rendered == "loom"

    let formatter = IdentityFormatter {}
    match dynamic_format(formatter, "value") {
        Ok(text) => {
            assert text == "value"
            Unit
        }
        Err(_) => {
            assert false
            Unit
        }
    }

    var counter = Counter { value = 0 }
    match take_one(counter) {
        Some(value) => {
            assert value == 1
            Unit
        }
        None => {
            assert false
            Unit
        }
    }
}

test fn static_and_readonly_dynamic_dispatch() {
    let label = Label { text = "loom" }
    let rendered = static_label(label)
    assert rendered == "loom"

    let formatter = IdentityFormatter {}
    match dynamic_format(formatter, "value") {
        Ok(text) => {
            assert text == "value"
            Unit
        }
        Err(_) => {
            assert false
            Unit
        }
    }
}

test fn mutable_dynamic_dispatch_writes_the_owner() {
    var counter = Counter { value = 0 }
    match take_one(counter) {
        Some(value) => {
            assert value == 1
            Unit
        }
        None => {
            assert false
            Unit
        }
    }
}

test fn dynamic_interfaces_are_first_class_values() {
    let returned = erase_label(Label { text = "returned" })
    let forwarded = forward_label(returned)
    let returnedText = returned.label()
    let forwardedText = forwarded.label()
    assert returnedText == "returned"
    assert forwardedText == "returned"

    let holder = LabelHolder { item = returned }
    let holderText = holder.item.label()
    assert holderText == "returned"

    let packet = LabelPacket.Item(forwarded)
    match packet {
        Item(value) => {
            let packetText = value.label()
            assert packetText == "returned"
            Unit
        }
    }

    let collection = LabelCollection {
        items = [
            erase_label(Label { text = "one" }),
            erase_label(Label { text = "two" }),
        ]
    }
    let collectionLength = collection.items.length()
    assert collectionLength == 2

    var source = erase_source(Counter { value = 0 })
    var copied = source
    match copied.next() {
        Some(value) => {
            assert value == 1
            Unit
        }
        None => {
            assert false
            Unit
        }
    }
    match source.next() {
        Some(value) => {
            assert value == 1
            Unit
        }
        None => {
            assert false
            Unit
        }
    }
}
