import std.loom.checking.check_project_snapshot
import std.loom.checking.import_trusted_definition_cache

// One last successful definition basis per selected closure/configuration.
// File membership and contents deliberately do not key this slot: the checker
// matches definitions and invalidates changed names and transitive consumers.
fn definition_key(options Options, project Project, identity Text) Text {
    frontend_key(options, Project {
            files = new[SourceFile]()
            modules = project.modules
            packages = project.packages
            root = project.root
        }, identity)
}

fn definition_input(path Text, prefix Text, project Project, inputs BuildInputs) Option[Text] {
    if match entry_kind(path) {
        Result.Ok(kind) => kind == FileKind.File,
        _ => false
    } {
        match read_bytes(path) {
            Result.Ok(bytes) => {
                // The same bundle integrity and observed-input checks as whole
                // artifacts run BEFORE the trusted compiler-host import API.
                match frontend_decode_kind(bytes, prefix, project, "definitions", inputs) {
                    Option.Some(value) => {
                        return Option.Some(value.input)
                    }
                    Option.None => {
                    }
                }
            }
            Result.Err(_) => {
            }
        }
    }
    Option.None
}

fn definition_load(path Text, prefix Text, project Project, inputs BuildInputs) DefinitionCache {
    // Retire the raw bundle and decoded metadata before allocating cached IR.
    // Only the authenticated snapshot text crosses this call boundary.
    match definition_input(path, prefix, project, inputs) {
        Option.Some(text) => match import_trusted_definition_cache(text) {
            Result.Ok(cache) => cache
            Result.Err(_) => definition_cache()
        }
        Option.None => definition_cache()
    }
}

fn prepare_incremental(options Options, project Project, inputs BuildInputs, identity Text) Result[Prepared, Text] {
    let root = join_path(options.frontend_cache, "definitions-v2")
    discard cache_directory(root)?
    let key = definition_key(options, project, identity)
    let prefix = concat("loom-definition-cache 2\n", concat(key, "\n"))
    let path = join_path(root, concat(key, ".ldef"))
    let cache = definition_load(path, prefix, project, inputs)
    let checked = match check_project_snapshot(project, options.command == "test", inputs, cache) {
        Result.Ok(value) => value
        Result.Err(failed) => {
            return Result.Err(diagnostic(project.files, failed))
        }
    }
    cache_trace(concat("definitions reused ", concat(to_text(definitions_reused(cache)),
                concat(", bodies reused ", to_text(bodies_reused(cache))))))
    let prepared = prepare_checked(options, project, inputs, checked.checked.program)
    match checked.snapshot {
        Option.Some(snapshot) => {
            frontend_publish(root, path, prefix, Prepared {
                    inputs = prepared.inputs
                    targets = prepared.targets
                    input = snapshot
                    entry = prepared.entry
                    tests = prepared.tests
                    project = project
                })
        }
        Option.None => {
            cache_trace("definition snapshot unavailable")
        }
    }
    Result.Ok(prepared)
}
