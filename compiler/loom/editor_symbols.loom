import std.loom.analysis.Location
import std.loom.analysis.inspect_at
import std.loom.analysis.inspect_references
import std.loom.analysis.static_binding_at
import std.loom.ast.Node
import std.loom.ast.NodeKind
import std.loom.ast.has
import std.loom.binding.builtin_type_name
import std.loom.checking.macro_generator_candidates
import std.loom.lexer.Kind
import std.loom.lexer.Token
import std.loom.lexer.lex
import std.loom.project.SourceOverlay
import std.loom.source.Span
import std.loom.source.TextEdit
import std.loom.source.apply_ordered_edits
import std.option.Option
import std.text.join

fn editor_same_span(left Span, right Span) Bool {
    left.start == right.start && left.end == right.end
}

fn editor_same_location(left Location, right Location) Bool {
    left.file == right.file && editor_same_span(left.span, right.span)
}

fn editor_contains(locations List[Location], location Location) Bool {
    var index = 0
    while index < length(locations) {
        if editor_same_location(get(locations, index), location) {
            return true
        }
        index = index + 1
    }
    false
}

fn editor_push_location(locations List[Location], location Location) {
    if !editor_contains(locations, location) {
        push(locations, location)
    }
}

fn editor_all_definitions(targets List[Location], definitions List[Location]) Bool {
    if length(definitions) == 0 {
        return false
    }
    var index = 0
    while index < length(definitions) {
        if !editor_contains(targets, get(definitions, index)) {
            return false
        }
        index = index + 1
    }
    true
}

fn editor_token(tokens List[Token], offset Int) Option[Token] {
    var index = 0
    while index < length(tokens) {
        let token = get(tokens, index)
        if token.span.start <= offset && offset < token.span.end {
            return if token.kind == Kind.Name {
                Option.Some(token)
            } else {
                Option.None
            }
        }
        index = index + 1
    }
    Option.None
}

fn editor_name(tokens List[Token], node Node) Option[Span] {
    var index = 0
    while index < length(tokens) {
        let token = get(tokens, index)
        if token.span.start >= node.span.end {
            return Option.None
        }
        if token.span.start >= node.span.start && token.kind == Kind.Name && token.value == node.value {
            return Option.Some(token.span)
        }
        index = index + 1
    }
    Option.None
}

fn editor_declaration(node Node, tokens List[Token], target Span) Bool {
    editor_declaration_node(node, tokens, target, NodeKind.File)
}

fn editor_declaration_node(node Node, tokens List[Token], target Span, parent NodeKind) Bool {
    let kind = node.kind
    if kind == NodeKind.Function || kind == NodeKind.Record || kind == NodeKind.Enum ||
    kind == NodeKind.Refined || kind == NodeKind.Concept || kind == NodeKind.Let ||
    kind == NodeKind.Var || kind == NodeKind.Parameter || (kind == NodeKind.Field && parent == NodeKind.Record) ||
    kind == NodeKind.Variant || kind == NodeKind.AssociatedType {
        match editor_name(tokens, node) {
            Option.Some(span) => {
                if editor_same_span(span, target) {
                    return true
                }
            }
            Option.None => {
            }
        }
    }
    var index = 0
    while index < length(node.children) {
        if editor_declaration_node(get(node.children, index), tokens, target, kind) {
            return true
        }
        index = index + 1
    }
    false
}

fn editor_selected(analysis EditorAnalysis, file Int, offset Int, token Token, tokens List[Token]) Option[Location] {
    // A declaration token identifies itself even when expression inspection
    // finds several same-spelled overloads. This is an exact syntax span, not
    // a fallback guess for an ambiguous call or expression.
    if editor_declaration(get(editor_data(analysis).bindings.files, file).tree, tokens, token.span) {
        return Option.Some(Location {
                file = file
                span = token.span
            })
    }
    match inspect_at(analysis.snapshot, file, offset) {
        Option.Some(found) => {
            if length(found.definitions) == 1 {
                return Option.Some(get(found.definitions, 0))
            }
            if length(found.definitions) > 1 {
                let family = editor_method_family(analysis, get(found.definitions, 0), token.value)
                if editor_all_definitions(family.1, found.definitions) {
                    return Option.Some(family.0)
                }
            }
            // A checked expression with ambiguous definitions must not fall
            // through to a spelling-based declaration guess.
            return Option.None
        }
        Option.None => {
        }
    }
    match editor_import_selected(analysis, file, token, tokens) {
        Option.Some(found) => {
            return Option.Some(found)
        }
        Option.None => {
        }
    }
    Option.None
}

fn editor_references(analysis EditorAnalysis, target Location, spelling Text) List[Location] {
    editor_references(analysis, [target], spelling)
}

fn editor_references(analysis EditorAnalysis, targets List[Location], spelling Text) List[Location] {
    let references = new[Location]()
    var declaration = 0
    while declaration < length(targets) {
        editor_push_location(references, get(targets, declaration))
        declaration = declaration + 1
    }
    var file = 0
    while file < length(editor_data(analysis).bindings.files) {
        match inspect_references(analysis.snapshot, file, spelling) {
            Result.Ok(evidence) => {
                var index = 0
                while index < length(evidence) {
                    let candidate = get(evidence, index)
                    match candidate.inspection {
                        Option.Some(found) => {
                            if editor_all_definitions(targets, found.definitions) {
                                editor_push_location(references, Location {
                                        file = file
                                        span = Span {
                                            start = candidate.offset
                                            end = candidate.offset + std.text.length(spelling)
                                        }
                                    })
                            }
                        }
                        Option.None => {
                        }
                    }
                    index = index + 1
                }
            }
            Result.Err(_) => {
            }
        }
        file = file + 1
    }
    references
}

fn editor_unsafe_body(node Node) Bool {
    var index = 0
    while index < length(node.children) {
        let child = get(node.children, index)
        // A static parameter marker or selected branch does not invalidate
        // runtime binding evidence. editor_covered still requires every use
        // to be accounted for across the actual checked specializations.
        if child.kind == NodeKind.Function ||
        child.kind == NodeKind.ComptimeFor || child.kind == NodeKind.ComptimeMap ||
        editor_unsafe_body(child) {
            return true
        }
        index = index + 1
    }
    false
}

fn editor_local(node Node, tokens List[Token], target Span) Bool {
    if node.kind == NodeKind.Let || node.kind == NodeKind.Var || node.kind == NodeKind.Scoped ||
    node.kind == NodeKind.Parameter {
        match editor_name(tokens, node) {
            Option.Some(span) => {
                if editor_same_span(span, target) {
                    return true
                }
            }
            Option.None => {
            }
        }
    }
    if (node.kind == NodeKind.Destructure || node.kind == NodeKind.Arm) && length(node.children) > 0 {
        if editor_pattern_local(get(node.children, 0), tokens, target) {
            return true
        }
    }
    var index = 0
    while index < length(node.children) {
        if editor_local(get(node.children, index), tokens, target) {
            return true
        }
        index = index + 1
    }
    false
}

fn editor_pattern_local(node Node, tokens List[Token], target Span) Bool {
    if node.kind == NodeKind.Name || (node.kind == NodeKind.Pattern && length(node.children) == 0) {
        match editor_name(tokens, node) {
            Option.Some(span) => {
                return editor_same_span(span, target)
            }
            Option.None => {
            }
        }
    }
    var index = 0
    while index < length(node.children) {
        if editor_pattern_local(get(node.children, index), tokens, target) {
            return true
        }
        index = index + 1
    }
    false
}

fn editor_local_scope(analysis EditorAnalysis, target Location) Option[Span] {
    let source = get(editor_data(analysis).bindings.files, target.file)
    let tokens = match lex(source.text) {
        Result.Ok(value) => value,
        Result.Err(_) => {
            return Option.None
        }
    }
    var index = 0
    while index < length(editor_data(analysis).bindings.symbols) {
        let symbol = get(editor_data(analysis).bindings.symbols, index)
        if symbol.file == target.file && symbol.node.value != "" && symbol.node.kind == NodeKind.Function &&
        !editor_unsafe_body(symbol.node) && editor_local(symbol.node, tokens, target.span) {
            var checked = 0
            while checked < length(editor_data(analysis).functions) {
                if get(editor_data(analysis).functions, checked) == index {
                    // A bare match pattern can be a variant, not a binding.
                    // Require declaration evidence from the checked local ID.
                    match inspect_at(analysis.snapshot, target.file, target.span.start) {
                        Option.Some(found) => {
                            if length(found.definitions) == 1 && editor_same_location(get(found.definitions, 0), target) {
                                return Option.Some(symbol.node.span)
                            }
                        }
                        Option.None => {
                        }
                    }
                }
                checked = checked + 1
            }
        }
        index = index + 1
    }
    Option.None
}

fn editor_covered(analysis EditorAnalysis, target Location, spelling Text, scope Span, references List[Location]) Bool {
    let text = get(editor_data(analysis).bindings.files, target.file).text
    let tokens = match lex(text) {
        Result.Ok(value) => value,
        Result.Err(_) => {
            return false
        }
    }
    var index = 0
    while index < length(tokens) {
        let token = get(tokens, index)
        if token.kind == Kind.Name && token.value == spelling &&
        token.span.start >= scope.start && token.span.end <= scope.end &&
        !editor_contains(references, Location {
                file = target.file
                span = token.span
            }) {
            if !editor_declaration(get(editor_data(analysis).bindings.files, target.file).tree, tokens, token.span) {
                match inspect_at(analysis.snapshot, target.file, token.span.start) {
                    Option.Some(found) => {
                        if length(found.definitions) != 1 ||
                        editor_same_location(get(found.definitions, 0), target) {
                            return false
                        }
                    }
                    Option.None => {
                        return false
                    }
                }
            }
        }
        index = index + 1
    }
    true
}

fn editor_valid_new_name(name Text) Bool {
    if builtin_type_name(name) || name == "result" {
        return false
    }
    let tokens = match lex(name) {
        Result.Ok(value) => value,
        Result.Err(_) => {
            return false
        }
    }
    if length(tokens) != 2 || get(tokens, 0).kind != Kind.Name || get(tokens, 0).value != name ||
    get(tokens, 0).span.end != length(name) {
        return false
    }
    match std.loom.parser.parse(concat("fn ", concat(name, "() {}"))) {
        Result.Ok(_) => true
        Result.Err(_) => false
    }
}

fn editor_name_conflict(analysis EditorAnalysis, file Int, scope Span, name Text) Bool {
    let tokens = match lex(get(editor_data(analysis).bindings.files, file).text) {
        Result.Ok(value) => value,
        Result.Err(_) => {
            return true
        }
    }
    var index = 0
    while index < length(tokens) {
        let token = get(tokens, index)
        if token.kind == Kind.Name && token.value == name &&
        token.span.start >= scope.start && token.span.end <= scope.end {
            return true
        }
        index = index + 1
    }
    false
}

// Private declarations cannot be imported by another package. Select an exact
// ordinary declaration; a function may leave an overload set. Public
// edits use module-wide package checks instead.
fn editor_declaration_authority(analysis EditorAnalysis, target Location, public Bool) Bool {
    let files = editor_data(analysis).bindings.files
    let root = editor_data(analysis).bindings.root
    let package = get(files, target.file).package
    if (!public && package != root) ||
    get(editor_data(analysis).bindings.packages, package).instance != get(editor_data(analysis).bindings.packages, root).instance {
        return false
    }
    true
}

fn editor_top_declaration(analysis EditorAnalysis, target Location, spelling Text, public Bool) Bool {
    if !editor_declaration_authority(analysis, target, public) {
        return false
    }
    let files = editor_data(analysis).bindings.files
    let package = get(files, target.file).package
    var matches = 0
    var selected = false
    var selected_function = false
    var index = 0
    while index < length(editor_data(analysis).bindings.symbols) {
        let symbol = get(editor_data(analysis).bindings.symbols, index)
        if symbol.owner < 0 && symbol.name == spelling &&
        get(files, symbol.file).package == package {
            matches = matches + 1
            let kind = symbol.node.kind
            if (kind == NodeKind.Function || kind == NodeKind.Record || kind == NodeKind.Enum || kind == NodeKind.Refined || kind == NodeKind.Concept) &&
            symbol.file == target.file && symbol.public == public && !symbol.test_only && !std.loom.ast.has(symbol.node, NodeKind.ExpansionId) &&
            !get(files, symbol.file).test_only {
                match lex(get(files, symbol.file).text) {
                    Result.Ok(tokens) => {
                        match editor_name(tokens, symbol.node) {
                            Option.Some(span) => {
                                if editor_same_span(span, target.span) {
                                    selected = true
                                    selected_function = kind == NodeKind.Function
                                }
                            }
                            Option.None => {
                            }
                        }
                    }
                    Result.Err(_) => {
                    }
                }
            }
        }
        index = index + 1
    }
    selected && (matches == 1 || selected_function)
}

// An unaccounted same-spelled token could be an unchecked use (for example in
// an uninstantiated body). Refuse the edit even if an ordinary check succeeds.
fn editor_private_covered(analysis EditorAnalysis, targets List[Location], spelling Text, references List[Location], inputs BuildInputs) Bool {
    // Raw syntax retains declaration stages erased from expanded bindings.
    var file = 0
    while file < length(editor_data(analysis).source.files) {
        let source = get(editor_data(analysis).source.files, file)
        if source.package == editor_data(analysis).source.root && editor_generated(source.tree) {
            return false
        }
        file = file + 1
    }
    // Exported generators can refer to private declarations in their definition
    // context, even when no invocation occurs in this package's import closure.
    let generators = match std.loom.checking.macro_generator_candidates(editor_data(analysis).bindings, inputs) {
        Result.Ok(value) => value
        Result.Err(_) => {
            return false
        }
    }
    var generator = 0
    while generator < length(generators) {
        let item = get(editor_data(analysis).bindings.symbols, get(generators, generator))
        if item.public && item.owner < 0 && get(editor_data(analysis).bindings.files, item.file).package == editor_data(analysis).bindings.root {
            return false
        }
        generator = generator + 1
    }
    let files = editor_data(analysis).bindings.files
    let root = editor_data(analysis).bindings.root
    var index = 0
    while index < length(references) {
        if get(files, get(references, index).file).package != root {
            return false
        }
        index = index + 1
    }
    file = 0
    while file < length(files) {
        let source = get(files, file)
        if source.package == root {
            let tokens = match lex(source.text) {
                Result.Ok(value) => value
                Result.Err(_) => {
                    return false
                }
            }
            index = 0
            while index < length(tokens) {
                let token = get(tokens, index)
                if token.kind == Kind.Name && token.value == spelling &&
                !editor_contains(references, Location {
                        file = file
                        span = token.span
                    }) {
                    if !editor_binding_outside(analysis, file, token, tokens, targets) {
                        return false
                    }
                }
                index = index + 1
            }
        }
        file = file + 1
    }
    true
}

fn editor_private_conflict(analysis EditorAnalysis, name Text) Bool {
    var index = 0
    while index < length(editor_data(analysis).bindings.symbols) {
        let symbol = get(editor_data(analysis).bindings.symbols, index)
        if symbol.owner < 0 && symbol.name == name {
            return true
        }
        index = index + 1
    }
    var file = 0
    while file < length(editor_data(analysis).bindings.files) {
        let source = get(editor_data(analysis).bindings.files, file)
        if source.package == editor_data(analysis).bindings.root && editor_name_conflict(analysis, file,
            Span {
                start = 0
                end = length(source.text)
            }, name) {
            return true
        }
        file = file + 1
    }
    false
}

fn editor_same_source_path(left Text, right Text) Bool {
    if left == right {
        return true
    }
    let physical = match canonicalize(left) {
        Result.Ok(value) => value
        Result.Err(_) => {
            return false
        }
    }
    match canonicalize(right) {
        Result.Ok(value) => value == physical
        Result.Err(_) => false
    }
}

fn editor_root_source(bindings std.loom.binding.Program, path Text) Bool {
    var file = 0
    while file < length(bindings.files) {
        let source = get(bindings.files, file)
        if source.package == bindings.root && editor_same_source_path(source.path, path) {
            return true
        }
        file = file + 1
    }
    false
}

fn editor_replaced_references(text Text, file Int, references List[Location], name Text) Option[Text] {
    let tokens = match lex(text) {
        Result.Ok(value) => value
        Result.Err(_) => {
            return Option.None
        }
    }
    let edits = new[TextEdit]()
    var index = 0
    while index < length(tokens) {
        let token = get(tokens, index)
        if editor_contains(references, Location {
                file = file
                span = token.span
            }) {
            push(edits, TextEdit {
                    span = token.span
                    text = name
                })
        }
        index = index + 1
    }
    match apply_ordered_edits(text, edits) {
        Result.Ok(value) => Option.Some(value)
        Result.Err(_) => Option.None
    }
}

fn editor_private_overlays(options EditorOptions, bindings std.loom.binding.Program,
    references List[Location], name Text) Option[List[SourceOverlay]] {
    let overlays = new[SourceOverlay]()
    var index = 0
    while index < length(options.overlays) {
        let overlay = get(options.overlays, index)
        if !editor_root_source(bindings, overlay.path) {
            push(overlays, overlay)
        }
        index = index + 1
    }
    var file = 0
    while file < length(bindings.files) {
        let source = get(bindings.files, file)
        if source.package == bindings.root {
            let revised = match editor_replaced_references(source.text, file, references, name) {
                Option.Some(value) => value
                Option.None => {
                    return Option.None
                }
            }
            push(overlays, SourceOverlay {
                    path = source.path
                    text = revised
                })
        }
        file = file + 1
    }
    Option.Some(overlays)
}

fn editor_location_json(bindings std.loom.binding.Program, location Location) Text {
    let path = get(bindings.files, location.file).path
    editor_change_json(path, location.span, Option.None)
}

fn editor_change_json(path Text, span Span, text Option[Text]) Text {
    let prefix = concat("{\"path\":", concat(editor_quoted(path), concat(",\"start\":", to_text(span.start))))
    let range = concat(prefix, concat(",\"end\":", to_text(span.end)))
    concat(match text {
            Option.Some(value) => concat(range, concat(",\"text\":", editor_quoted(value)))
            Option.None => range
        }, "}")
}

fn editor_locations_json(bindings std.loom.binding.Program, locations List[Location]) Text {
    var output = "["
    var index = 0
    while index < length(locations) {
        if index > 0 {
            output = concat(output, ",")
        }
        output = concat(output, editor_location_json(bindings, get(locations, index)))
        index = index + 1
    }
    concat(output, "]")
}

fn editor_no_symbols(rename Bool) EditorOutput {
    EditorOutput {
        text = if rename {
            "{\"diagnostics\":[],\"changes\":[]}\n"
        } else {
            "{\"diagnostics\":[],\"declaration\":null,\"references\":[]}\n"
        }
        failed = false
    }
}

fn editor_rename_output(bindings std.loom.binding.Program, references List[Location], name Text) EditorOutput {
    let changes = new[Text]()
    var index = 0
    while index < length(references) {
        let location = get(references, index)
        push(changes, editor_change_json(get(bindings.files, location.file).path, location.span, Option.Some(name)))
        index = index + 1
    }
    EditorOutput {
        text = concat("{\"diagnostics\":[],\"changes\":[", concat(std.text.join(changes, ","), "]}\n"))
        failed = false
    }
}

fn editor_symbols(options EditorOptions, analysis EditorAnalysis,
    file Int, offset Int, inputs BuildInputs) EditorOutput {
    let bindings = editor_data(analysis).bindings
    let new_name = options.new_name
    let rename = new_name != ""
    let tokens = match lex(get(bindings.files, file).text) {
        Result.Ok(value) => value,
        Result.Err(_) => {
            return editor_no_symbols(rename)
        }
    }
    let token = match editor_token(tokens, offset) {
        Option.Some(value) => value,
        Option.None => {
            return editor_no_symbols(rename)
        }
    }
    match static_binding_at(analysis.snapshot, file, token.span.start) {
        Option.Some(binding) => {
            if rename {
                if !editor_valid_new_name(new_name) {
                    return editor_error("Rename needs a valid non-reserved Loom identifier")
                }
                if !editor_covered(analysis, binding.declaration, token.value, binding.scope, binding.references) {
                    return editor_error("Rename cannot account for every occurrence of this compile-time parameter")
                }
                if new_name != token.value && editor_name_conflict(analysis, file, binding.scope, new_name) {
                    return editor_error("Rename would conflict with a name in this function")
                }
                return editor_checked_rename(options, bindings, binding.references, new_name)
            }
            return EditorOutput {
                text = concat("{\"diagnostics\":[],\"declaration\":", concat(editor_location_json(bindings, binding.declaration),
                        concat(",\"references\":", concat(editor_locations_json(bindings, binding.references), "}\n"))))
                failed = false
            }
        }
        Option.None => {
        }
    }
    let target = match editor_selected(analysis, file, offset, token, tokens) {
        Option.Some(value) => value,
        Option.None => {
            return editor_no_symbols(rename)
        }
    }
    let family = editor_method_family(analysis, target, token.value)
    let references = editor_references(analysis, family.1, token.value)
    let field_owner = editor_field_owner(analysis, target, token.value)
    let public_field = field_owner >= 0 && get(bindings.symbols, field_owner).public &&
    editor_declaration_authority(analysis, target, true)
    if editor_top_declaration(analysis, target, token.value, true) || public_field {
        return editor_public_symbols(options, analysis, target, token.value, inputs)
    }
    if rename {
        if !editor_valid_new_name(new_name) {
            return editor_error("Rename needs a valid non-reserved Loom identifier")
        }
        if editor_method_declaration(analysis, family.0, token.value) {
            return editor_private_method_rename(options, analysis, family, token.value, references, inputs)
        }
        match editor_local_scope(analysis, target) {
            Option.Some(scope) => {
                if !editor_covered(analysis, target, token.value, scope, references) {
                    return editor_error("Rename cannot account for every occurrence of this local binding")
                }
                if new_name != token.value && editor_name_conflict(analysis, target.file, scope, new_name) {
                    return editor_error("Rename would conflict with a name in this function")
                }
                return editor_checked_rename(options, bindings, references, new_name)
            }
            Option.None => {
            }
        }
        let private_field = field_owner >= 0 && !get(bindings.symbols, field_owner).public &&
        editor_declaration_authority(analysis, target, false)
        if !editor_top_declaration(analysis, target, token.value, false) && !private_field {
            return editor_error("Rename supports checked local bindings and parameters, one top-level function, nominal type or concept, or a record field in the selected module")
        }
        if !options.tests {
            return editor_error("Private declaration rename requires --tests to account for test-file uses")
        }
        if !editor_private_covered(analysis, [target], token.value, references, inputs) {
            return editor_error("Rename cannot account for every occurrence of this private declaration")
        }
        if new_name != token.value && editor_private_conflict(analysis, new_name) {
            return editor_error("Rename would conflict with a name in the package or import closure")
        }
        return editor_checked_rename(options, bindings, references, new_name)
    }
    let declaration = editor_location_json(bindings, family.0)
    EditorOutput {
        text = concat("{\"diagnostics\":[],\"declaration\":", concat(declaration,
                concat(",\"references\":", concat(editor_locations_json(bindings, references), "}\n"))))
        failed = false
    }
}

fn editor_checked_rename(options EditorOptions, bindings std.loom.binding.Program,
    references List[Location], new_name Text) EditorOutput {
    var index = 0
    while index < length(references) {
        if get(bindings.files, get(references, index).file).package != bindings.root {
            return editor_error("Rename target is outside the selected package")
        }
        index = index + 1
    }
    let overlays = match editor_private_overlays(options, bindings, references, new_name) {
        Option.Some(value) => value
        Option.None => {
            return editor_error("Rename could not build an in-memory edit for this package")
        }
    }
    if !editor_overlay_checks(options, overlays) {
        return editor_error("Rename would invalidate the checked package")
    }
    editor_rename_output(bindings, references, new_name)
}
