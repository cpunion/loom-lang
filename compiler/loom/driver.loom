import std.loom.project.load
import std.loom.project.resolve
import std.loom.project.is_windows_path
import std.loom.project.join_path
import std.fs.canonicalize
import std.loom.binding.bind
import std.loom.binding.Failure
import std.loom.project.SourceFile
import std.loom.checking.check
import std.loom.lowering.lower
import frontend.artifact.encode
import std.loom.typed.Program
import std.loom.source.render
import std.int.to_text
import std.list.new
import std.list.push
import std.list.get
import std.list.length
import std.process.run
import std.process.run_input
import std.process.exit_code
import std.result.Result
import std.text.concat
import std.text.byte
import std.text.length

record Options {
    command Text
    path Text
    std_root Text
    output Text
    ir Text
    native_tool Text
    no_run Bool
    tests Bool
    git_tool Text
    object_cache Text
    program_args List[Text]
}

fn options(args List[Text]) Result[Options, Text] {
    let command = get(args, 1)
    var path = "."
    var selected = false
    var standard = ""
    var output = ""
    var ir = ""
    var tool = ""
    var no_run = false
    var tests = false
    var git_tool = "git"
    var object_cache = ""
    let program_args = new[Text]()
    var forwarding = false
    var index = 2
    while index < length(args) {
        let arg = get(args, index)
        if forwarding {
            push(program_args, arg)
        } else {
            if arg == "--" {
                if command != "run" {
                    return Result.Err("-- is only available with run")
                }
                forwarding = true
            } else {
                if arg == "--tests" {
                    if tests {
                        return Result.Err("duplicate --tests")
                    }
                    tests = true
                } else {
                    if arg == "--no-run" {
                        if no_run {
                            return Result.Err("duplicate --no-run")
                        }
                        no_run = true
                    } else {
                        if arg == "--std" || arg == "--output" || arg == "-o" || arg == "--emit-ir" || arg == "--native-tool" || arg == "--git-tool" || arg == "--object-cache" {
                            index = index + 1
                            if index == length(args) {
                                return Result.Err(concat(arg, " needs a value"))
                            }
                            let value = get(args, index)
                            if arg == "--std" {
                                standard = value
                            }
                            if arg == "--native-tool" {
                                tool = value
                            }
                            if arg == "--object-cache" {
                                if object_cache != "" {
                                    return Result.Err("duplicate --object-cache")
                                }
                                if value == "" {
                                    return Result.Err("--object-cache needs a nonempty path")
                                }
                                if command != "build" && command != "test" && command != "run" {
                                    return Result.Err("--object-cache requires build, test or run")
                                }
                                object_cache = value
                            }
                            if arg == "--git-tool" {
                                if command != "resolve" {
                                    return Result.Err("--git-tool is only available with resolve")
                                }
                                git_tool = value
                            }
                            if arg == "--output" || arg == "-o" {
                                if output != "" {
                                    return Result.Err("duplicate --output")
                                }
                                output = value
                            }
                            if arg == "--emit-ir" {
                                if ir != "" {
                                    return Result.Err("duplicate --emit-ir")
                                }
                                ir = value
                            }
                        } else {
                            if length(arg) > 0 && byte(arg, 0) == 45 {
                                return Result.Err(concat("unknown option ", arg))
                            }
                            if selected {
                                return Result.Err("select one package directory")
                            }
                            selected = true
                            path = arg
                        }
                    }
                }
            }
        }
        index = index + 1
    }
    if no_run && command != "test" {
        return Result.Err("--no-run is only available with test")
    }
    if tests && command != "resolve" {
        return Result.Err("--tests is only available with resolve")
    }
    if command != "build" && !(command == "test" && no_run) && output != "" {
        return Result.Err("--output requires build or test --no-run")
    }
    if (command == "check" || command == "emit-checked" || command == "resolve") && ir != "" {
        return Result.Err("this command does not emit LLVM IR")
    }
    path = match canonicalize(path) {
        Result.Ok(value) => value
        Result.Err(_) => {
            return Result.Err(concat("cannot resolve package path ", path))
        }
    }
    let tools = development_tools(get(args, 0), standard, tool, command == "build" || command == "test" || command == "run")?
    Result.Ok(Options {
            command = command
            path = path
            std_root = tools.std_root
            output = output
            ir = ir
            native_tool = tools.native_tool
            no_run = no_run
            tests = tests
            git_tool = git_tool
            object_cache = object_cache
            program_args = program_args
        })
}

fn diagnostic(files List[SourceFile], failure Failure) Text {
    let source = get(files, failure.source)
    render(source.path, source.text, failure.diagnostic)
}

fn prepared(options Options) Result[std.loom.typed.Program, Text] {
    let loaded = load(options.path, options.std_root, options.command == "test")?
    let bound = match bind(loaded, options.command == "test") {
        Result.Ok(value) => value
        Result.Err(failure) => {
            return Result.Err(diagnostic(loaded.files, failure))
        }
    }
    match check(bound) {
        Result.Ok(value) => Result.Ok(value)
        Result.Err(failure) => Result.Err(diagnostic(loaded.files, failure))
    }
}

fn child_status(arguments List[Text]) Result[Int, Text] {
    match run(arguments) {
        Result.Ok(code) => Result.Ok(code)
        Result.Err(_) => Result.Err("cannot run native program")
    }
}

fn compile(options Options, program std.loom.typed.Program, output Text) Result[Bool, Text] {
    let input = encode(lower(program))
    if options.object_cache != "" && options.ir == "" {
        if compile_cached(options, input, options.command != "test" && program.entry < 0, output)? {
            return Result.Ok(true)
        }
    }
    let arguments = new[Text]()
    push(arguments, options.native_tool)
    push(arguments, "-")
    push(arguments, "--output")
    push(arguments, output)
    if options.command == "test" {
        push(arguments, "--test")
    }
    if options.ir != "" {
        push(arguments, "--emit-ir")
        push(arguments, options.ir)
    }
    let status = match run_input(arguments, input) {
        Result.Ok(code) => code
        Result.Err(_) => {
            return Result.Err("cannot invoke the native LLVM tool")
        }
    }
    if status != 0 {
        return Result.Err("native LLVM compilation failed")
    }
    Result.Ok(true)
}

fn execute(args List[Text]) Result[Text, Text] {
    let selected = options(args)?
    if selected.command == "resolve" {
        discard resolve(selected.path, selected.std_root, selected.tests, selected.git_tool)?
        return Result.Ok("resolved package dependencies\n")
    }
    let program = prepared(selected)?
    if selected.command == "check" {
        return Result.Ok("checked package\n")
    }
    if selected.command == "emit-checked" {
        return Result.Ok(encode(lower(program)))
    }
    if selected.command == "run" && program.entry < 0 {
        return Result.Err("run requires fn main() in the selected package")
    }
    if selected.command == "test" && length(program.tests) == 0 {
        return Result.Ok("0 tests\n")
    }
    let windows = is_windows_path(selected.path)
    let filename = if selected.command == "test" {
        if windows {
            "tests.exe"
        } else {
            "tests"
        }
    } else {
        if program.entry < 0 {
            if windows {
                "package.obj"
            } else {
                "package.o"
            }
        } else {
            if windows {
                "main.exe"
            } else {
                "main"
            }
        }
    }
    let output = if selected.output != "" {
        selected.output
    } else {
        join_path(join_path(selected.path, "target"), filename)
    }
    discard compile(selected, program, output)?
    if selected.command == "build" {
        return Result.Ok(concat("built ", concat(output, "\n")))
    }
    if selected.no_run {
        return Result.Ok(concat("compiled ", concat(to_text(length(program.tests)), concat(" tests to ", concat(output, "\n")))))
    }
    let arguments = new[Text]()
    push(arguments, output)
    var index = 0
    while index < length(selected.program_args) {
        push(arguments, get(selected.program_args, index))
        index = index + 1
    }
    let status = child_status(arguments)?
    if selected.command == "run" && status >= 0 && status <= 255 {
        exit_code(status)
        return Result.Ok("")
    }
    if status != 0 {
        return Result.Err("native program failed")
    }
    if selected.command == "test" {
        return Result.Ok(concat(to_text(length(program.tests)), " tests passed\n"))
    }
    Result.Ok("")
}
