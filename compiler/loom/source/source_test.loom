test fn line_endings_and_scalar_columns() {
    let empty = position("", 0)
    assert empty.line == 1 && empty.column == 1
    let mixed = "a\r\né\rb\n😀"
    let crlf = position(mixed, 2)
    assert crlf.line == 2 && crlf.column == 1
    let accented = position(mixed, 5)
    assert accented.line == 2 && accented.column == 2
    let cr = position(mixed, 6)
    assert cr.line == 3 && cr.column == 1
    let end = position(mixed, 12)
    assert end.line == 4 && end.column == 2
    let newline = position("x\n", 2)
    assert newline.line == 2 && newline.column == 1
}

test fn diagnostic_text() {
    let error = Diagnostic { span = Span { start = 3 end = 4 } message = "expected a name" }
    assert render("demo.loom", "é ?", error) == "demo.loom:1:3: expected a name"
}
