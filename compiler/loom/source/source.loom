import std.int.to_text
import std.text.byte
import std.text.concat
import std.text.length
import std.text.width

pub record Span {
    start Int
    end Int
}

pub record Diagnostic {
    span Span
    message Text
}

pub record Position {
    line Int
    column Int
}

// Offsets count bytes; displayed columns count Unicode scalar values, not cells.
// CRLF, CR and LF each end one line. The position within CRLF is the new line.
pub fn position(text Text, offset Int) Position {
    assert offset >= 0 && offset <= length(text)
    var cursor = 0
    var line = 1
    var column = 1
    while cursor < offset {
        let current = byte(text, cursor)
        if current == 13 {
            cursor = cursor + 1
            if cursor < offset && byte(text, cursor) == 10 {
                cursor = cursor + 1
            }
            line = line + 1
            column = 1
        } else {
            if current == 10 {
                cursor = cursor + 1
                line = line + 1
                column = 1
            } else {
                cursor = cursor + width(text, cursor)
                assert cursor <= offset
                column = column + 1
            }
        }
    }
    Position { line = line column = column }
}

pub fn render(path Text, text Text, error Diagnostic) Text {
    let location = position(text, error.span.start)
    let line = concat(concat(path, ":"), to_text(location.line))
    let column = concat(concat(line, ":"), to_text(location.column))
    concat(concat(column, ": "), error.message)
}
