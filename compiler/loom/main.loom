import frontend.lexer.lex
import frontend.parser.parse
import frontend.source.Diagnostic
import frontend.source.render
import std.file.read_text
import std.int.to_text
import std.io.write_text
import std.io.write_error
import std.list.get
import std.list.length
import std.process.arguments
import std.process.exit_code
import std.result.Result
import std.text.concat

fn report(message Text) {
    discard write_error(concat(message, "\n"))
}

fn inspect(text Text, parse_mode Bool) Result[Text, Diagnostic] {
    if parse_mode {
        let tree = parse(text)?
        Result.Ok(concat(to_text(length(tree.children)), " declarations\n"))
    } else {
        let tokens = lex(text)?
        Result.Ok(concat(to_text(length(tokens) - 1), " tokens\n"))
    }
}

fn main() {
    let args = arguments()
    if length(args) < 2 {
        report("usage: loom <check|build|test|run> [package] [--std path] [--output path]")
        exit_code(2)
        return
    }
    let mode = get(args, 1)
    if mode == "--help" || mode == "-h" {
        discard write_text("Loom source compiler\n  loom <check|build|test|run> [package] [--std path] [--output path] [--emit-ir path]\n  loom <lex|parse> <source files...>\n  --native-tool selects the development LLVM/platform tool.\n")
        return
    }
    if mode == "--version" { discard write_text("loom source compiler (development)\n")
        return }
    if mode == "check" || mode == "build" || mode == "test" || mode == "run" {
        match execute(args) {
            Result.Ok(message) => { discard write_text(message) }
            Result.Err(message) => { report(message)
                exit_code(1) }
        }
        return
    }
    if mode != "lex" && mode != "parse" {
        report("unknown command; use --help")
        exit_code(2)
        return
    }
    if length(args) < 3 {
        report("lex and parse require source file paths")
        exit_code(2)
        return
    }
    var failed = false
    var index = 2
    while index < length(args) {
        let path = get(args, index)
        match read_text(path) {
            Result.Ok(text) => {
                match inspect(text, mode == "parse") {
                    Result.Ok(summary) => {
                        let message = concat(path, concat(": ", summary))
                        match write_text(message) {
                            Result.Ok(_) => {}
                            Result.Err(_) => { failed = true }
                        }
                    }
                    Result.Err(error) => {
                        report(render(path, text, error))
                        failed = true
                    }
                }
            }
            Result.Err(_) => {
                report(concat(path, ": cannot read UTF-8 source"))
                failed = true
            }
        }
        index = index + 1
    }
    if failed { exit_code(1) }
}
