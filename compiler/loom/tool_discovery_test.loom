test fn development_tools_use_one_executable_relative_checkout() {
    let root = match canonicalize(".") {
        Result.Ok(value) => value
        Result.Err(_) => {
            assert false
            ""
        }
    }
    let compiler_name = if is_windows_path(root) {
        "loom.exe"
    } else {
        "loom"
    }
    let invoked = join_path(join_path(root, "target"), compiler_name)
    match development_tools(invoked, "", "", true) {
        Result.Ok(value) => {
            assert value.std_root == join_path(root, "compiler/std")
            let native_name = if is_windows_path(root) {
                "loom-native.exe"
            } else {
                "loom-native"
            }
            assert value.native_tool == join_path(join_path(join_path(root, "target"), "debug"), native_name)
        }
        Result.Err(_) => {
            assert false
        }
    }
    assert match compiler_checkout("loom") {
        Result.Err(_) => true,
        _ => false
    }
    match development_tools("not-an-executable", "selected-std", "selected-native", true) {
        Result.Ok(value) => {
            assert value.std_root == "selected-std" && value.native_tool == "selected-native"
        }
        Result.Err(_) => {
            assert false
        }
    }
    match development_tools("not-an-executable", "selected-std", "", false) {
        Result.Ok(value) => {
            assert value.std_root == "selected-std" && value.native_tool == ""
        }
        Result.Err(_) => {
            assert false
        }
    }
}

test fn executable_directory_keeps_native_root_spelling() {
    assert executable_directory("/checkout/target/loom") == "/checkout/target/"
    assert executable_directory("/loom") == "/"
    assert executable_directory("C:\\checkout\\target\\loom.exe") == "C:\\checkout\\target\\"
    assert executable_directory("\\\\?\\C:\\checkout\\target\\loom.exe") == "\\\\?\\C:\\checkout\\target\\"
}
