import std.loom.analysis.is_current_with_inputs
import std.loom.project.BuildInput
import std.loom.binding.Failure
import std.io.read_chunk
import std.loom.checking.DefinitionCache
import std.loom.checking.DeclarationReference
import std.loom.checking.definition_cache
import std.loom.checking.definitions_reused
import std.loom.checking.bodies_reused
import std.loom.checking.check_project_cached
import std.loom.checking.has_declaration_stages
import std.loom.binding.bind_headers

record EditorCache {
    analysis List[Analysis]
    hits List[Int]
    definitions DefinitionCache
}

fn editor_cache() EditorCache {
    let hits = new[Int]()
    push(hits, 0)
    EditorCache {
        analysis = new[Analysis]()
        hits = hits
        definitions = definition_cache()
    }
}

// Reload the project before asking for reuse. Never trust a file timestamp or
// a client's change notification for source, build-input, or target freshness.
fn editor_reuse(cache EditorCache, project Project, tests Bool, inputs BuildInputs) Option[Analysis] {
    if length(cache.analysis) == 0 {
        return Option.None
    }
    let saved = get(cache.analysis, 0)
    if !is_current_with_inputs(saved, project, tests, saved.inputs, inputs.options, saved.targets) {
        return Option.None
    }
    let files = new[BuildInput]()
    var index = 0
    while index < length(saved.inputs) {
        let request = get(saved.inputs, index).request
        let file = match inputs.read(request) {
            Result.Ok(value) => value
            Result.Err(_) => {
                return Option.None
            }
        }
        push(files, BuildInput {
                request = request
                file = file
            })
        index = index + 1
    }
    index = 0
    while index < length(saved.targets) {
        match target_value(inputs, get(saved.targets, index).name) {
            Result.Ok(_) => {
            }
            Result.Err(_) => {
                return Option.None
            }
        }
        index = index + 1
    }
    if !is_current_with_inputs(saved, project, tests, files, inputs.options, inputs.targets) {
        return Option.None
    }
    index = 0
    while index < length(files) {
        let input = get(files, index)
        push(inputs.files, input)
        push(inputs.requests, input.request)
        index = index + 1
    }
    set(cache.hits, 0, get(cache.hits, 0) + 1)
    Option.Some(saved)
}

fn editor_checked(bindings std.loom.binding.Program, inputs BuildInputs, cache EditorCache) Result[Analysis, Failure] {
    let checked = check_project_cached(Project {
            files = bindings.files
            modules = bindings.modules
            packages = bindings.packages
            root = bindings.root
        }, bindings.tests, inputs, cache.definitions)?
    let analysis = Analysis {
        source = checked.source
        bindings = checked.bindings
        program = checked.program
        inputs = inputs.files
        options = inputs.options
        targets = inputs.targets
        proof_backend = inputs.proof_backend
        declarations = new[List[std.loom.checking.DeclarationReference]]()
    }
    if length(cache.analysis) == 0 {
        push(cache.analysis, analysis)
    } else {
        set(cache.analysis, 0, analysis)
    }
    Result.Ok(analysis)
}

// Private transport: each request is a length-prefixed UTF-8 field containing
// the argument count, followed by that many fields. Responses are one JSON line.
// Lengths count bytes, so paths and overlays may contain newlines or Unicode.
fn editor_session_field() Result[Option[Text], Text] {
    let header = std.bytes.new()
    var ended = false
    while !ended {
        let count = match read_chunk(header, 1) {
            Result.Ok(value) => value
            Result.Err(_) => {
                return Result.Err("cannot read editor request")
            }
        }
        if count == 0 {
            if std.bytes.length(header) == 0 {
                return Result.Ok(Option.None)
            }
            return Result.Err("truncated editor request length")
        }
        ended = std.bytes.get(header, std.bytes.length(header) - 1) == 10
    }
    let text = match std.bytes.decode_utf8(header) {
        Result.Ok(value) => value
        Result.Err(_) => {
            return Result.Err("invalid editor request length")
        }
    }
    let size = match std.int.parse(slice(text, 0, std.text.length(text) - 1)) {
        Result.Ok(value) => value
        Result.Err(_) => {
            return Result.Err("invalid editor request length")
        }
    }
    if size < 0 {
        return Result.Err("negative editor request length")
    }
    let body = std.bytes.new()
    while std.bytes.length(body) < size {
        match read_chunk(body, size - std.bytes.length(body)) {
            Result.Ok(count) => {
                if count == 0 {
                    return Result.Err("truncated editor request")
                }
            }
            Result.Err(_) => {
                return Result.Err("cannot read editor request")
            }
        }
    }
    match std.bytes.decode_utf8(body) {
        Result.Ok(value) => Result.Ok(Option.Some(value))
        Result.Err(_) => Result.Err("editor request is not UTF-8")
    }
}

fn editor_session_request(executable Text) Result[Option[List[Text]], Text] {
    let header = match editor_session_field()? {
        Option.Some(value) => value
        Option.None => {
            return Result.Ok(Option.None)
        }
    }
    let count = match std.int.parse(header) {
        Result.Ok(value) => value
        Result.Err(_) => {
            return Result.Err("invalid editor argument count")
        }
    }
    if count < 1 {
        return Result.Err("editor request needs a command")
    }
    let args = new[Text]()
    push(args, executable)
    var index = 0
    while index < count {
        match editor_session_field()? {
            Option.Some(value) => {
                push(args, value)
            }
            Option.None => {
                return Result.Err("truncated editor arguments")
            }
        }
        index = index + 1
    }
    if !editor_mode(get(args, 1)) {
        return Result.Err("invalid editor session command")
    }
    Result.Ok(Option.Some(args))
}

fn editor_mode(mode Text) Bool {
    mode == "editor-check" || mode == "editor-query" || mode == "editor-complete" ||
    mode == "editor-references" || mode == "editor-rename" || mode == "editor-auto-import"
}

fn editor_session(executable Text) Result[Bool, Text] {
    let cache = editor_cache()
    while true {
        let args = match editor_session_request(executable)? {
            Option.Some(value) => value
            Option.None => {
                return Result.Ok(true)
            }
        }
        let hits = get(cache.hits, 0)
        let definitions = definitions_reused(cache.definitions)
        let bodies = bodies_reused(cache.definitions)
        let output = editor_execute(args, cache)
        let reused = if get(cache.hits, 0) > hits {
            "true"
        } else {
            "false"
        }
        let response = concat("{\"bodiesReused\":", concat(to_text(bodies_reused(cache.definitions) - bodies),
                concat(",\"analysisReused\":", concat(reused, concat(",\"definitionsReused\":",
                            concat(to_text(definitions_reused(cache.definitions) - definitions), concat(",", slice(output.text, 1, std.text.length(output.text)))))))))
        match write_text(response) {
            Result.Ok(_) => {
            }
            Result.Err(_) => {
                return Result.Err("cannot write editor response")
            }
        }
    }
    Result.Ok(true)
}
