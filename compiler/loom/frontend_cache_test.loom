import std.loom.checking.no_input_reader

fn cache_target_snapshot(os Text) Result[List[BuildOption], Text] {
    Result.Ok([BuildOption {
                name = "os"
                value = os
            }])
}

test fn frontend_bundles_bind_metadata_and_artifact_bytes() {
    let project = match load("compiler/examples/scalar", "compiler/std", false) {
        Result.Ok(value) => value
        Result.Err(_) => {
            assert false
            return
        }
    }
    let selected = match options(driver_arguments("check")) {
        Result.Ok(value) => value
        Result.Err(_) => {
            assert false
            return
        }
    }
    let key = frontend_key(selected, project, "compiler-one")
    assert key != frontend_key(selected, project, "compiler-two")
    let source = get(project.files, 0)
    std.list.set(project.files, 0, SourceFile {
            package = source.package
            path = source.path
            text = source.text
            tree = source.tree
            test_only = source.test_only
            trusted_std = !source.trusted_std
        })
    assert key != frontend_key(selected, project, "compiler-one")
    let prefix = frontend_prefix(key)
    let checked = Prepared {
        inputs = new[BuildInput]()
        targets = new[BuildOption]()
        input = "loom-checked-1\nartifact\0🧵\n"
        entry = 2
        tests = 3
        project = project
    }
    let bundle = frontend_bundle(prefix, checked)
    let inputs = build_inputs(std.loom.checking.no_input_reader)
    match frontend_decode(bundle, prefix, project, false, inputs) {
        Option.Some(value) => {
            assert value.entry == 2 && value.tests == 3 && value.input == checked.input
        }
        Option.None => {
            assert false
        }
    }
    assert match frontend_decode(bundle, prefix, project, true, inputs) {
        Option.None => true,
        _ => false
    }
    assert match frontend_decode(bundle, frontend_prefix("other"), project, false, inputs) {
        Option.None => true,
        _ => false
    }
    // Reuse revalidates the target snapshot requested by the check.
    push(checked.targets, BuildOption {
            name = "os"
            value = "linux"
        })
    let targeted = frontend_bundle(prefix, checked)
    let target_inputs = build_inputs(no_input_reader, new[BuildOption](), cache_target_snapshot, "linux")
    assert match frontend_decode(targeted, prefix, project, false, target_inputs) {
        Option.Some(_) => true
        Option.None => false
    }
    let changed = build_inputs(no_input_reader, new[BuildOption](), cache_target_snapshot, "macos")
    assert match frontend_decode(targeted, prefix, project, false, changed) {
        Option.None => true
        Option.Some(_) => false
    }
    assert match frontend_decode(targeted, prefix, project, false, inputs) {
        Option.None => true
        Option.Some(_) => false
    }
    // Every byte, including the textual checksum, participates in validation.
    var position = 0
    while position < std.bytes.length(bundle) {
        let damaged = cache_copy(bundle, 0, std.bytes.length(bundle))
        std.bytes.set(damaged, position, std.bytes.get(damaged, position) ^ 1)
        assert match frontend_decode(damaged, prefix, project, false, inputs) {
            Option.None => true,
            _ => false
        }
        position = position + 1
    }
    let malformed = cache_bytes(concat(prefix, "64\n"))
    cache_append(malformed, hex(malformed))
    // A valid checksum cannot supply bytes to a truncated metadata field.
    assert match frontend_decode(malformed, prefix, project, false, inputs) {
        Option.None => true,
        _ => false
    }
}
