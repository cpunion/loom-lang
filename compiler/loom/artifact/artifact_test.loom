import std.loom.typed.Function
import std.loom.typed.Field
import std.loom.typed.Variant
import std.loom.typed.Method
import std.loom.typed.Interface
import std.loom.typed.Witness
import std.loom.typed.Arm
import std.loom.source.Span
import std.list.new
import std.list.push
import std.text.ends_with

test fn counted_fields_preserve_utf8_newlines_and_nuls() {
    let buffer = std.bytes.new()
    integer(buffer, -9223372036854775808)
    text(buffer, "é\n\0")
    assert std.bytes.to_text(buffer) == "-9223372036854775808\n4\né\n\0"
}

fn encoded_expression(kind ExprKind, marker Text, index Int) Text {
    let buffer = std.bytes.new()
    expression(buffer, Expr {
            kind = kind
            ty = 0
            span = Span {
                start = 0
                end = 1
            }
            text = marker
            index = index
            falls = true
            children = std.list.new[Expr]()
            arms = std.list.new[Arm]()
        })
    std.bytes.to_text(buffer)
}

test fn resource_pattern_roles_do_not_change_executable_artifacts() {
    let kinds = [ExprKind.Match, ExprKind.If, ExprKind.Record, ExprKind.Variant, ExprKind.Block]
    let markers = ["pattern-decision", "pattern-literal", "pattern-rebuild", "pattern-rebuild", "pattern-product"]
    var index = 0
    while index < std.list.length(kinds) {
        let kind = std.list.get(kinds, index)
        let marker = std.list.get(markers, index)
        assert encoded_expression(kind, marker, 7) == encoded_expression(kind, "", if kind == ExprKind.Block {
                -1
            } else {
                7
            })
        // The same bytes in a source literal remain observable data.
        assert encoded_expression(ExprKind.Text, marker, -1) != encoded_expression(ExprKind.Text, "", -1)
        index = index + 1
    }
}

test fn empty_checked_program_has_a_deterministic_stream() {
    let program = std.loom.typed.Program {
        types = std.list.new[Type]()
        functions = std.list.new[Function]()
        entry = -1
        tests = std.list.new[Int]()
        test_names = std.list.new[Text]()
        exports = std.list.new[Int]()
        interfaces = std.list.new[Interface]()
        witnesses = std.list.new[Witness]()
    }
    assert encode(program) == "loom-checked-1\n0\n0\n-1\n0\n0\n"
    push(program.tests, 0)
    push(program.test_names, "pkg.例")
    assert ends_with(encode(program), "2\n1\n7\npkg.例")
}

test fn abstract_associated_types_use_non_executable_placeholders() {
    let receiver = std.list.new[Int]()
    std.list.push(receiver, 42)
    let value = Type {
        kind = TypeKind.Associated
        symbol = 7
        arguments = receiver
        pack_widths = std.list.new[Int]()
        fields = std.list.new[Field]()
        variants = std.list.new[Variant]()
        constraint = std.list.new[Expr]()
    }
    let buffer = std.bytes.new()
    data(buffer, value)
    assert std.bytes.to_text(buffer) == "5\n7\n"
}

test fn function_signatures_are_structural_and_references_are_explicit() {
    let signature = std.list.new[Int]()
    std.list.push(signature, 1)
    std.list.push(signature, 3)
    let value = Type {
        kind = TypeKind.Function
        symbol = -1
        arguments = signature
        pack_widths = std.list.new[Int]()
        fields = std.list.new[Field]()
        variants = std.list.new[Variant]()
        constraint = std.list.new[Expr]()
    }
    let buffer = std.bytes.new()
    data(buffer, value)
    assert std.bytes.to_text(buffer) == "12\n-1\n1\n1\n3\n"
    assert expression_tag(ExprKind.FunctionRef) == 24 && expression_tag(ExprKind.IndirectCall) == 25
    assert expression_tag(ExprKind.ClosureEnvironment) == 34
}

test fn lowered_tasks_and_frames_have_explicit_native_storage_tags() {
    let arguments = std.list.new[Int]()
    push(arguments, 3)
    let task = Type {
        kind = TypeKind.Task
        symbol = -1
        arguments = arguments
        pack_widths = std.list.new[Int]()
        fields = std.list.new[Field]()
        variants = std.list.new[Variant]()
        constraint = std.list.new[Expr]()
    }
    let buffer = std.bytes.new()
    data(buffer, task)
    assert std.bytes.to_text(buffer) == "13\n-1\n3\n"
    let fields = std.list.new[Field]()
    push(fields, Field {
            name = "result"
            ty = 0
        })
    push(fields, Field {
            name = "pc"
            ty = 1
        })
    let frame = Type {
        kind = TypeKind.Frame
        symbol = -1
        arguments = std.list.new[Int]()
        pack_widths = std.list.new[Int]()
        fields = fields
        variants = std.list.new[Variant]()
        constraint = std.list.new[Expr]()
    }
    let encoded = std.bytes.new()
    data(encoded, frame)
    assert std.bytes.to_text(encoded) == "14\n-1\n2\n6\nresult0\n2\npc1\n"
    assert expression_tag(ExprKind.FrameNew) == 31 && expression_tag(ExprKind.FrameStore) == 32
}

test fn dynamic_metadata_is_an_explicit_sparse_tail() {
    let types = std.list.new[Type]()
    std.list.push(types, Type {
            kind = TypeKind.Dyn
            symbol = 0
            arguments = std.list.new[Int]()
            pack_widths = std.list.new[Int]()
            fields = std.list.new[Field]()
            variants = std.list.new[Variant]()
            constraint = std.list.new[Expr]()
        })
    let params = std.list.new[Int]()
    std.list.push(params, 3)
    let methods = std.list.new[Method]()
    std.list.push(methods, Method {
            is_async = false
            name = "display"
            params = params
            result = 3
        })
    let interfaces = std.list.new[Interface]()
    std.list.push(interfaces, Interface {
            symbol = 42
            methods = methods
        })
    let slots = std.list.new[Int]()
    std.list.push(slots, -1)
    let witnesses = std.list.new[Witness]()
    std.list.push(witnesses, Witness {
            interface = 0
            concrete = 1
            methods = slots
        })
    let program = std.loom.typed.Program {
        types = types
        functions = std.list.new[Function]()
        entry = -1
        tests = std.list.new[Int]()
        test_names = std.list.new[Text]()
        exports = std.list.new[Int]()
        interfaces = interfaces
        witnesses = witnesses
    }
    // Source names and symbol 42 are intentionally absent; slots retain -1.
    assert encode(program) == "loom-checked-1\n1\n11\n0\n0\n-1\n0\n0\n1\n1\n1\n1\n3\n3\n1\n0\n1\n1\n-1\n"
    assert type_tag(TypeKind.Dyn) == 11
    assert expression_tag(ExprKind.DynBox) == 22 && expression_tag(ExprKind.DynCall) == 23
}
