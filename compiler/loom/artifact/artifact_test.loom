import std.loom.typed.Function
import std.loom.typed.Field
import std.loom.typed.Variant
import std.loom.typed.Method
import std.loom.typed.Interface
import std.loom.typed.Witness
import std.list.new
import std.list.push

test fn counted_fields_preserve_utf8_newlines_and_nuls() {
    let buffer = std.bytes.new()
    integer(buffer, -9223372036854775808)
    text(buffer, "é\n\0")
    assert std.bytes.to_text(buffer) == "-9223372036854775808\n4\né\n\0"
}

test fn empty_checked_program_has_a_deterministic_stream() {
    let program = Program {
        types = std.list.new[Type]() functions = std.list.new[Function]() entry = -1
        tests = std.list.new[Int]() exports = std.list.new[Int]()
        interfaces = std.list.new[Interface]() witnesses = std.list.new[Witness]()
    }
    assert encode(program) == "loom-checked-1\n0\n0\n-1\n0\n0\n"
}

test fn abstract_associated_types_use_non_executable_placeholders() {
    let receiver = std.list.new[Int]()
    std.list.push(receiver, 42)
    let value = Type { kind = TypeKind.Associated symbol = 7 arguments = receiver
        fields = std.list.new[Field]() variants = std.list.new[Variant]() constraint = std.list.new[Expr]() }
    let buffer = std.bytes.new()
    data(buffer, value)
    assert std.bytes.to_text(buffer) == "5\n7\n"
}

test fn function_signatures_are_structural_and_references_are_explicit() {
    let signature = std.list.new[Int]()
    std.list.push(signature, 1)
    std.list.push(signature, 3)
    let value = Type { kind = TypeKind.Function symbol = -1 arguments = signature
        fields = std.list.new[Field]() variants = std.list.new[Variant]() constraint = std.list.new[Expr]() }
    let buffer = std.bytes.new()
    data(buffer, value)
    assert std.bytes.to_text(buffer) == "12\n-1\n1\n1\n3\n"
    assert expression_tag(ExprKind.FunctionRef) == 24 && expression_tag(ExprKind.IndirectCall) == 25
}

test fn dynamic_metadata_is_an_explicit_sparse_tail() {
    let types = std.list.new[Type]()
    std.list.push(types, Type { kind = TypeKind.Dyn symbol = 0 arguments = std.list.new[Int]()
        fields = std.list.new[Field]() variants = std.list.new[Variant]() constraint = std.list.new[Expr]() })
    let params = std.list.new[Int]()
    std.list.push(params, 3)
    let methods = std.list.new[Method]()
    std.list.push(methods, Method { name = "display" params = params result = 3 })
    let interfaces = std.list.new[Interface]()
    std.list.push(interfaces, Interface { symbol = 42 methods = methods })
    let slots = std.list.new[Int]()
    std.list.push(slots, -1)
    let witnesses = std.list.new[Witness]()
    std.list.push(witnesses, Witness { interface = 0 concrete = 1 methods = slots })
    let program = Program { types = types functions = std.list.new[Function]() entry = -1
        tests = std.list.new[Int]() exports = std.list.new[Int]() interfaces = interfaces witnesses = witnesses }
    // Source names and symbol 42 are intentionally absent; slots retain -1.
    assert encode(program) == "loom-checked-1\n1\n11\n0\n0\n-1\n0\n0\n1\n1\n1\n1\n3\n3\n1\n0\n1\n1\n-1\n"
    assert type_tag(TypeKind.Dyn) == 11
    assert expression_tag(ExprKind.DynBox) == 22 && expression_tag(ExprKind.DynCall) == 23
}
