// Whole selected-closure reuse after loading: no persistent source IDs, AST
// decoder or second semantic model. Loading still validates manifests, locked
// snapshots, file membership and syntax before any cached proof is accepted.
fn frontend_field(output Bytes, value Text) {
    cache_append(output, to_text(length(value)))
    cache_append(output, "\n")
    cache_append(output, value)
}

fn frontend_number(output Bytes, value Int) {
    frontend_field(output, to_text(value))
}

fn frontend_key(options Options, project Project, identity Text) Text {
    let output = cache_bytes("loom-frontend-key 3\n")
    frontend_field(output, identity)
    frontend_number(output, length(options.build_options))
    var option = 0
    while option < length(options.build_options) {
        let value = get(options.build_options, option)
        frontend_field(output, value.name)
        frontend_field(output, value.value)
        option = option + 1
    }
    // check does not lower. build/run/emit-checked share a production artifact;
    // test uses its own root, isolated imports and executable entry points.
    frontend_field(output, if options.command == "check" {
            "check"
        } else {
            if options.command == "test" {
                "test"
            } else {
                "native"
            }
        })
    frontend_number(output, project.root)
    frontend_number(output, length(project.modules))
    var index = 0
    while index < length(project.modules) {
        let module = get(project.modules, index)
        frontend_field(output, module.name)
        frontend_field(output, module.source)
        index = index + 1
    }
    frontend_number(output, length(project.packages))
    index = 0
    while index < length(project.packages) {
        let package = get(project.packages, index)
        frontend_number(output, package.instance)
        frontend_field(output, package.relative)
        frontend_number(output, length(package.imports))
        var edge = 0
        while edge < length(package.imports) {
            let imported = get(package.imports, edge)
            frontend_field(output, imported.spelling)
            frontend_number(output, imported.target)
            edge = edge + 1
        }
        index = index + 1
    }
    frontend_number(output, length(project.files))
    index = 0
    while index < length(project.files) {
        let source = get(project.files, index)
        frontend_number(output, source.package)
        frontend_field(output, source.path)
        frontend_field(output, source.text)
        frontend_number(output, if source.test_only {
                1
            } else {
                0
            })
        frontend_number(output, if source.trusted_std {
                1
            } else {
                0
            })
        index = index + 1
    }
    hex(output)
}

fn frontend_identity() Option[Text] {
    let invoked = get(std.process.arguments(), 0)
    // Do not guess a PATH resolution or trust a version/mtime sidecar.
    if !contains(invoked, "/") && !is_windows_path(invoked) {
        return Option.None
    }
    let executable = match canonicalize(invoked) {
        Result.Ok(value) => value,
        Result.Err(_) => {
            return Option.None
        }
    }
    match read_bytes(executable) {
        Result.Ok(bytes) => Option.Some(hex(bytes)),
        Result.Err(_) => Option.None
    }
}

fn frontend_prefix(key Text) Text {
    concat("loom-frontend-cache 3\n", concat(key, "\n"))
}

fn frontend_bundle(prefix Text, value Prepared) Bytes {
    let output = cache_bytes(prefix)
    frontend_number(output, value.entry)
    frontend_number(output, value.tests)
    frontend_number(output, length(value.targets))
    var target = 0
    while target < length(value.targets) {
        let property = get(value.targets, target)
        frontend_field(output, property.name)
        frontend_field(output, property.value)
        target = target + 1
    }
    frontend_number(output, length(value.inputs))
    var index = 0
    while index < length(value.inputs) {
        let input = get(value.inputs, index)
        frontend_field(output, input.request.root)
        frontend_field(output, input.request.source)
        frontend_field(output, input.request.path)
        frontend_field(output, input.file.path)
        frontend_field(output, hex(input.file.bytes))
        index = index + 1
    }
    cache_append(output, value.input)
    // The complete bundle stays UTF-8, including its checksum. After in-place
    // validation it needs one Text copy, not an intermediate full Bytes copy.
    cache_append(output, hex(output))
    output
}

fn frontend_decode(bytes Bytes, prefix Text, project Project, checking Bool, inputs BuildInputs) Option[Prepared] {
    frontend_decode_kind(bytes, prefix, project, if checking {
            "check"
        } else {
            "native"
        }, inputs)
}

fn frontend_decode_kind(bytes Bytes, prefix Text, project Project, format Text, inputs BuildInputs) Option[Prepared] {
    if cache_payload_end(bytes, prefix, true) < 0 {
        return Option.None
    }
    let text = match decode_utf8(bytes) {
        Result.Ok(value) => value,
        Result.Err(_) => {
            return Option.None
        }
    }
    match frontend_payload(text, length(prefix), length(text) - 64, project, format, inputs) {
        Result.Ok(value) => Option.Some(value)
        Result.Err(_) => Option.None
    }
}

record FrontendReader {
    text Text
    cursor List[Int]
    end Int
}

fn frontend_read(reader FrontendReader) Result[Text, Text] {
    let start = get(reader.cursor, 0)
    var end = start
    while end < reader.end && byte(reader.text, end) != 10 {
        end = end + 1
    }
    let size = match std.int.parse(slice(reader.text, start, end)) {
        Result.Ok(value) => value
        Result.Err(_) => {
            return Result.Err("invalid cache field size")
        }
    }
    if size < 0 || end >= reader.end || size > reader.end - end - 1 {
        return Result.Err("truncated cache field")
    }
    std.list.set(reader.cursor, 0, end + 1 + size)
    Result.Ok(slice(reader.text, end + 1, end + 1 + size))
}

fn frontend_read_number(reader FrontendReader) Result[Int, Text] {
    match std.int.parse(frontend_read(reader)?) {
        Result.Ok(value) => Result.Ok(value)
        Result.Err(_) => Result.Err("invalid cache number")
    }
}

fn frontend_payload(text Text, start Int, end Int, project Project, format Text, context BuildInputs) Result[Prepared, Text] {
    let cursor = new[Int]()
    push(cursor, start)
    let reader = FrontendReader {
        text = text
        cursor = cursor
        end = end
    }
    let entry = frontend_read_number(reader)?
    let tests = frontend_read_number(reader)?
    let target_count = frontend_read_number(reader)?
    if target_count < 0 || target_count > 4 {
        return Result.Err("invalid cached target count")
    }
    let targets = new[BuildOption]()
    var target = 0
    while target < target_count {
        let name = frontend_read(reader)?
        let value = frontend_read(reader)?
        if !valid_target_property(name) || target_value(context, name)? != value {
            return Result.Err("cached target property changed")
        }
        push(targets, BuildOption {
                name = name
                value = value
            })
        target = target + 1
    }
    discard build_option_snapshot(targets)?
    let count = frontend_read_number(reader)?
    if count < 0 || count > length(text) {
        return Result.Err("invalid cache input count")
    }
    let inputs = new[BuildInput]()
    var index = 0
    while index < count {
        let request = std.loom.project.InputRequest {
            root = frontend_read(reader)?
            source = frontend_read(reader)?
            path = frontend_read(reader)?
        }
        let path = frontend_read(reader)?
        let digest = frontend_read(reader)?
        var source = 0
        while source < length(project.files) && get(project.files, source).path != request.source {
            source = source + 1
        }
        if source == length(project.files) {
            return Result.Err("cached input source changed")
        }
        let owner = get(project.packages, get(project.files, source).package).instance
        if get(project.modules, owner).source != request.root {
            return Result.Err("cached input module changed")
        }
        let file = read_input(request)?
        if file.path != path || hex(file.bytes) != digest {
            return Result.Err("cached input changed")
        }
        push(inputs, BuildInput {
                request = request
                file = file
            })
        index = index + 1
    }
    let input = slice(text, get(cursor, 0), end)
    if entry < -1 || tests < 0 || (format == "check" && input != "") ||
    (format == "native" && !std.text.starts_with(input, "loom-checked-1\n")) {
        return Result.Err("invalid cached artifact")
    }
    Result.Ok(Prepared {
            inputs = inputs
            targets = targets
            input = input
            entry = entry
            tests = tests
            project = project
        })
}

fn frontend_cached(options Options, project Project, inputs BuildInputs) Result[Prepared, Text] {
    let identity = match frontend_identity() {
        Option.Some(value) => value
        Option.None => {
            cache_trace("frontend unavailable")
            return prepare_loaded(options, project, inputs)
        }
    }
    let key = frontend_key(options, project, identity)
    let prefix = frontend_prefix(key)
    discard cache_directory(options.frontend_cache)?
    let root = join_path(options.frontend_cache, "checked-v3")
    discard cache_directory(root)?
    let path = join_path(root, concat(key, ".lchecked"))
    if match entry_kind(path) {
        Result.Ok(value) => value == FileKind.File,
        _ => false
    } {
        match read_bytes(path) {
            Result.Ok(bytes) => {
                match frontend_decode(bytes, prefix, project, options.command == "check", inputs) {
                    Option.Some(value) => {
                        cache_trace("frontend hit")
                        return Result.Ok(value)
                    }
                    Option.None => {
                    }
                }
            }
            Result.Err(_) => {
            }
        }
    }
    cache_trace("frontend miss")
    let checked = prepare_incremental(options, project, inputs, identity)?
    // Publish only successful checks. Readers see one complete, content-checked
    // bundle; concurrent producers own separate staging directories.
    frontend_publish(root, path, prefix, checked)
    Result.Ok(checked)
}

fn frontend_publish(root Text, path Text, prefix Text, checked Prepared) {
    let stage = match cache_staging(root) {
        Result.Ok(value) => value
        Result.Err(_) => {
            return
        }
    }
    defer {
        cache_cleanup(stage)
    }
    let bundle = join_path(stage, "bundle")
    if match write_bytes(bundle, frontend_bundle(prefix, checked)) {
        Result.Ok(_) => true,
        _ => false
    } {
        if match entry_kind(path) {
            Result.Ok(value) => value == FileKind.File,
            Result.Err(error) => error == FsError.NotFound
        } {
            discard rename(bundle, path)
        }
    }
}
