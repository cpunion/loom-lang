import std.loom.analysis.method_conformances

fn editor_method_declaration(analysis EditorAnalysis, target Location, spelling Text) Bool {
    editor_method_symbol(analysis, target, spelling) >= 0
}

fn editor_method_symbol(analysis EditorAnalysis, target Location, spelling Text) Int {
    let bindings = editor_data(analysis).bindings
    var index = 0
    while index < length(bindings.symbols) {
        let symbol = get(bindings.symbols, index)
        if symbol.owner >= 0 && symbol.file == target.file && symbol.name == spelling &&
        symbol.node.kind == NodeKind.Function &&
        symbol.node.span.start <= target.span.start && target.span.end <= symbol.node.span.end {
            let owner = get(bindings.symbols, symbol.owner)
            if owner.node.kind == NodeKind.Impl || owner.node.kind == NodeKind.Concept {
                match lex(get(bindings.files, target.file).text) {
                    Result.Ok(tokens) => match editor_name(tokens, symbol.node) {
                        Option.Some(span) => {
                            if editor_same_span(span, target.span) {
                                return index
                            }
                        }
                        Option.None => {
                        }
                    }
                    Result.Err(_) => {
                    }
                }
            }
        }
        index = index + 1
    }
    -1
}

// Positive edges identify one source slot. Editing separately requires complete
// use coverage and authority over its concept and implementation declarations.
fn editor_method_family(analysis EditorAnalysis, target Location, spelling Text) (Location, List[Location]) {
    if !editor_method_declaration(analysis, target, spelling) {
        return (target, [target])
    }
    let edges = match method_conformances(analysis.snapshot) {
        Result.Ok(value) => value
        Result.Err(_) => {
            return (target, [target])
        }
    }
    var declaration = target
    var matched = false
    var index = 0
    while index < length(edges) {
        let edge = get(edges, index)
        if editor_same_location(edge.0, target) {
            if matched && !editor_same_location(declaration, edge.1) {
                // One source method may participate in distinct selected
                // pack overloads. Do not silently combine those families.
                return (target, [target])
            }
            declaration = edge.1
            matched = true
        }
        index = index + 1
    }
    let members = [declaration]
    index = 0
    while index < length(edges) {
        let edge = get(edges, index)
        if editor_same_location(edge.1, declaration) {
            editor_push_location(members, edge.0)
        }
        index = index + 1
    }
    editor_push_location(members, target)
    (declaration, members)
}

fn editor_public_method(analysis EditorAnalysis, target Location, spelling Text) Bool {
    let member = editor_method_symbol(analysis, target, spelling)
    if member < 0 {
        return false
    }
    let declaration = get(editor_data(analysis).bindings.symbols, member)
    let owner = get(editor_data(analysis).bindings.symbols, declaration.owner)
    owner.node.kind == NodeKind.Concept && owner.public &&
    !has(declaration.node, NodeKind.ExpansionId) && !has(owner.node, NodeKind.ExpansionId) &&
    editor_declaration_authority(analysis, target, true)
}

fn editor_method_header_coverage(analysis EditorAnalysis,
    family (Location, List[Location]), spelling Text) Result[Bool, Text] {
    let bindings = editor_data(analysis).bindings
    let edges = match method_conformances(analysis.snapshot) {
        Result.Ok(value) => value
        Result.Err(_) => {
            return Result.Err("Method rename needs checked source conformance headers")
        }
    }
    // Positive query results are not a completeness claim. Account for every
    // same-spelled implementation declaration in this package before editing.
    var source = 0
    while source < length(bindings.symbols) {
        let member = get(bindings.symbols, source)
        if member.owner >= 0 && get(bindings.symbols, member.owner).node.kind == NodeKind.Impl &&
        member.node.kind == NodeKind.Function && member.name == spelling &&
        get(bindings.files, member.file).package == bindings.root {
            let tokens = match lex(get(bindings.files, member.file).text) {
                Result.Ok(value) => value
                Result.Err(_) => {
                    return Result.Err("Method rename cannot lex an implementation declaration")
                }
            }
            let span = match editor_name(tokens, member.node) {
                Option.Some(value) => value
                Option.None => {
                    return Result.Err("Method rename needs an ordinary source declaration")
                }
            }
            let location = Location {
                file = member.file
                span = span
            }
            var covered = false
            var index = 0
            while index < length(edges) {
                let edge = get(edges, index)
                if editor_same_location(edge.0, location) {
                    covered = true
                    if editor_contains(family.1, location) && !editor_same_location(edge.1, family.0) {
                        return Result.Err("Method rename cannot combine ambiguous conformance slots")
                    }
                }
                index = index + 1
            }
            if !covered {
                return Result.Err("Method rename cannot account for an implementation declaration")
            }
        }
        source = source + 1
    }
    Result.Ok(true)
}

fn editor_private_method_rename(options EditorOptions, analysis EditorAnalysis,
    family (Location, List[Location]), spelling Text, references List[Location], inputs BuildInputs) EditorOutput {
    let bindings = editor_data(analysis).bindings
    let declaration = editor_method_symbol(analysis, family.0, spelling)
    if declaration < 0 {
        return editor_error("Method rename needs one checked concept slot")
    }
    let owner = get(bindings.symbols, get(bindings.symbols, declaration).owner)
    if owner.node.kind != NodeKind.Concept {
        return editor_error("Method rename cannot combine ambiguous conformance slots")
    }
    if owner.public {
        return editor_error("Method rename target is outside the selected module")
    }
    if !options.tests {
        return editor_error("Method rename requires --tests to account for test-file uses")
    }
    match editor_method_header_coverage(analysis, family, spelling) {
        Result.Ok(_) => {
        }
        Result.Err(message) => {
            return editor_error(message)
        }
    }
    var index = 0
    while index < length(family.1) {
        let location = get(family.1, index)
        let member = editor_method_symbol(analysis, location, spelling)
        if member < 0 || !editor_declaration_authority(analysis, location, false) ||
        has(get(bindings.symbols, member).node, NodeKind.ExpansionId) {
            return editor_error("Method rename cannot edit an external or generated declaration")
        }
        index = index + 1
    }
    if !editor_private_covered(analysis, family.1, spelling, references, inputs) {
        return editor_error("Method rename cannot account for every occurrence of this concept slot")
    }
    if options.new_name != spelling && editor_private_conflict(analysis, options.new_name) {
        return editor_error("Method rename would conflict with a name in the package or import closure")
    }
    editor_checked_rename(options, bindings, references, options.new_name)
}
