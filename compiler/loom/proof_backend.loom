import std.loom.proof.ProofBackend
import std.loom.checking.with_proof_backend
import std.bytes.length
import std.text.trim
import std.map.new
import std.map.get
import std.map.insert
import std.map.length
import std.map.clear

// The complete query includes all declarations, premises and conclusions.
// Reuse only a determinate answer in this compiler context, never a partial
// proof key, an error or an exhausted search. Nothing is persisted to disk.
fn cached_proof_backend(tool Text, solve fn(Text, Text) Result[Bool, Text]) ProofBackend {
    let decisions = std.map.new[Text, Bool]()
    let stored_bytes = [0]
    ProofBackend {
        enabled = true
        context = tool
        solve = fn(context Text, query Text) Result[Bool, Text] {
            let size = std.text.length(query)
            if context != tool || size > 4194304 {
                return solve(context, query)
            }
            match std.map.get(decisions, query) {
                Option.Some(answer) => {
                    return Result.Ok(answer)
                }
                Option.None => {
                }
            }
            let answer = solve(context, query)?
            if std.map.length(decisions) >= 256 || get(stored_bytes, 0) > 4194304 - size {
                std.map.clear(decisions)
                set(stored_bytes, 0, 0)
            }
            discard std.map.insert(decisions, query, answer)
            set(stored_bytes, 0, get(stored_bytes, 0) + size)
            Result.Ok(answer)
        }
    }
}

// Z3 is a compiler tool, never a linked dependency of a Loom application.
// Literal arguments and stdin carry the query without shell interpretation.
fn solve_obligation(tool Text, query Text) Result[Bool, Text] {
    let arguments = new[Text]()
    push(arguments, tool)
    push(arguments, "-in")
    push(arguments, "-smt2")
    push(arguments, "-T:2")
    // Normalize polynomial identities before search. Z3 bounds monomial
    // expansion; the same timeout and exact-unsat acceptance rule still apply.
    push(arguments, "rewriter.som=true")
    let input = std.bytes.new()
    var index = 0
    while index < std.text.length(query) {
        std.bytes.push(input, byte(query, index))
        index = index + 1
    }
    let output = match capture_input(arguments, input) {
        Result.Ok(value) => value
        Result.Err(_) => {
            return Result.Err("required proof needs Z3; install z3 and make it available on PATH")
        }
    }
    if !cache_success(output) || std.bytes.length(output.stderr) != 0 {
        return Result.Err("SMT solver failed; required proof was not established")
    }
    let answer = match decode_utf8(output.stdout) {
        Result.Ok(value) => trim(value)
        Result.Err(_) => {
            return Result.Err("invalid SMT response; required proof was not established")
        }
    }
    if answer == "unsat" {
        return Result.Ok(true)
    }
    if answer == "sat" {
        return Result.Ok(false)
    }
    Result.Err("SMT solver returned unknown or timed out; required proof was not established")
}
