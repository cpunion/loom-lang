import std.loom.analysis.inspect_at
import std.loom.analysis.inspect_independent
import std.loom.analysis.Analysis
import std.loom.analysis.Inspection
import std.option.Option
import std.loom.binding.Program
import std.loom.project.Project

fn editor_source(project Project, path Text) Result[Int, Text] {
    var index = 0
    while index < length(project.files) {
        // Overlay spellings and explicit package identities take precedence.
        if get(project.files, index).path == path { return Result.Ok(index) }
        index = index + 1
    }
    let physical = match canonicalize(path) {
        Result.Ok(value) => value,
        Result.Err(_) => { return Result.Err("query source is outside the selected package and import closure") }
    }
    var selected = -1
    index = 0
    while index < length(project.files) {
        let file = get(project.files, index)
        let same = if file.path == physical { true } else {
            match canonicalize(file.path) { Result.Ok(value) => value == physical, Result.Err(_) => false }
        }
        if same {
            if selected >= 0 { return Result.Err("query source has multiple package identities; use its loaded source path") }
            selected = index
        }
        index = index + 1
    }
    if selected < 0 { return Result.Err("query source is outside the selected package and import closure") }
    Result.Ok(selected)
}

fn editor_query(bindings std.loom.binding.Program, file Int, offset Int) EditorOutput {
    match check(bindings) {
        Result.Ok(program) => editor_inspection(bindings,
            inspect_at(Analysis {
                    bindings = bindings
                    program = program
                }, file, offset), "")
        Result.Err(failed) => {
            let diagnostic = editor_diagnostic_json(get(bindings.files, failed.source).path, failed.diagnostic)
            editor_inspection(bindings, inspect_independent(bindings, file, offset), diagnostic)
        }
    }
}

fn editor_inspection(bindings std.loom.binding.Program, inspection Option[Inspection], diagnostic Text) EditorOutput {
    let prefix = concat("{\"diagnostics\":[", concat(diagnostic, "],\"hover\":"))
    let information = match inspection {
        Option.Some(value) => value
        Option.None => {
            return EditorOutput {
                text = concat(prefix, "null,\"definitions\":[]}\n")
                failed = diagnostic != ""
            }
        }
    }
    var types = "["
    var index = 0
    while index < length(information.types) {
        if index > 0 {
            types = concat(types, ",")
        }
        types = concat(types, editor_quoted(get(information.types, index)))
        index = index + 1
    }
    types = concat(types, "]")
    var definitions = "["
    index = 0
    while index < length(information.definitions) {
        if index > 0 {
            definitions = concat(definitions, ",")
        }
        let target = get(information.definitions, index)
        let path = get(bindings.files, target.file).path
        let location = concat("{\"path\":", concat(editor_quoted(path), concat(",\"start\":", to_text(target.span.start))))
        definitions = concat(definitions, concat(location, concat(",\"end\":", concat(to_text(target.span.end), "}"))))
        index = index + 1
    }
    definitions = concat(definitions, "]")
    let hover = concat("{\"start\":", concat(to_text(information.span.start), concat(",\"end\":", to_text(information.span.end))))
    let payload = concat(prefix, concat(hover, concat(",\"types\":", concat(types, "},\"definitions\":"))))
    EditorOutput {
        text = concat(payload, concat(definitions, "}\n"))
        failed = diagnostic != ""
    }
}

test fn query_options_require_an_explicit_source_and_byte_offset() {
    let args = cli_arguments("editor-query")
    std.list.push(args, "--std")
    std.list.push(args, "selected-std")
    std.list.push(args, "/app")
    match editor_options(args) {
        Result.Err(_) => {
        }
        Result.Ok(_) => {
            assert false
        }
    }
    std.list.push(args, "--at")
    std.list.push(args, "/app/main.loom")
    std.list.push(args, "12")
    match editor_options(args) {
        Result.Ok(value) => {
            assert value.query_path == "/app/main.loom" && value.offset == 12
        }
        Result.Err(_) => {
            assert false
        }
    }
    std.list.push(args, "--at")
    match editor_options(args) {
        Result.Err(_) => {
        }
        Result.Ok(_) => {
            assert false
        }
    }
}
