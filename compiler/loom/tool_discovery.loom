import std.fs.kind
import std.fs.FileKind
import std.text.slice
import std.text.contains

record Toolchain {
    std_root Text
    native_tool Text
}

fn tool_file(path Text) Bool {
    match kind(path) {
        Result.Ok(value) => value == FileKind.File,
        Result.Err(_) => false
    }
}

fn executable_directory(path Text) Text {
    let windows = is_windows_path(path)
    var index = length(path)
    while index > 0 {
        index = index - 1
        if byte(path, index) == 47 ||(windows && byte(path, index) == 92) {
            return slice(path, 0, index + 1)
        }
    }
    ""
}

fn checkout_source(root Text, component Text) Text {
    join_path(join_path(root, "compiler"), component)
}

fn compiler_directory(invoked Text) Result[Text, Text] {
    if !contains(invoked, "/") && !is_windows_path(invoked) {
        return Result.Err("cannot locate the toolchain from a bare command name; invoke Loom with a path or pass --std and --native-tool")
    }
    let executable = match canonicalize(invoked) {
        Result.Ok(value) => value
        Result.Err(_) => {
            return Result.Err("cannot resolve the compiler executable; pass --std and --native-tool")
        }
    }
    match canonicalize(executable_directory(executable)) {
        Result.Ok(value) => Result.Ok(value),
        Result.Err(_) => Result.Err("cannot resolve the compiler directory; pass --std and --native-tool")
    }
}

fn compiler_parent(directory Text) Result[Text, Text] {
    // Canonical Windows paths are verbatim: do not append '/' or '..'.
    match canonicalize(executable_directory(directory)) {
        Result.Ok(value) => Result.Ok(value),
        Result.Err(_) => Result.Err("cannot locate the toolchain; pass --std and --native-tool")
    }
}

// Development stages share one checkout's std and native bridge. Never search
// the caller's package directory or mix a cached checkpoint's source with it.
fn checkout_root(start Text) Result[Text, Text] {
    var directory = start
    while directory != "" {
        if tool_file(join_path(checkout_source(directory, "loom"), "loom.toml")) && tool_file(join_path(join_path(checkout_source(directory, "std"), "result"), "result.loom")) {
            return Result.Ok(directory)
        }
        let parent = compiler_parent(directory)?
        if parent == directory {
            directory = ""
        } else {
            directory = parent
        }
    }
    Result.Err("cannot locate the toolchain; pass --std and --native-tool")
}

fn discovered_tools(invoked Text) Result[Toolchain, Text] {
    let directory = compiler_directory(invoked)?
    let prefix = compiler_parent(directory)?
    let installed = join_path(join_path(prefix, "lib"), "loom")
    let standard = join_path(installed, "std")
    let name = if is_windows_path(directory) { "loom-native.exe" } else { "loom-native" }
    if tool_file(join_path(join_path(standard, "result"), "result.loom")) {
        return Result.Ok(Toolchain { std_root = standard native_tool = join_path(installed, name) })
    }
    let root = checkout_root(directory)?
    Result.Ok(Toolchain { std_root = checkout_source(root, "std")
        native_tool = join_path(join_path(join_path(root, "target"), "debug"), name) })
}

fn compiler_tools(invoked Text, standard Text, native Text, needs_native Bool) Result[Toolchain, Text] {
    if standard != "" &&(!needs_native || native != "") {
        return Result.Ok(Toolchain {
                std_root = standard
                native_tool = native
            })
    }
    let discovered = discovered_tools(invoked)?
    let std_root = if standard != "" {
        standard
    } else {
        discovered.std_root
    }
    var native_tool = native
    if needs_native && native_tool == "" {
        native_tool = discovered.native_tool
        if !tool_file(native_tool) {
            return Result.Err("cannot find the toolchain's native tool; build or install it, or pass --native-tool")
        }
    }
    Result.Ok(Toolchain {
            std_root = std_root
            native_tool = native_tool
        })
}
