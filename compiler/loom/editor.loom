import std.loom.project.SourceOverlay
import std.loom.project.load_overlaid
import std.loom.binding.bind
import std.loom.source.Diagnostic
import std.loom.source.Span
import std.bytes.new
import std.bytes.push
import std.bytes.to_text
import std.text.starts_with
import std.int.parse
import std.loom.checking.BuildInputs
import std.loom.project.input_path

record EditorOptions {
    path Text
    std_root Text
    tests Bool
    overlays List[SourceOverlay]
    query_path Text
    offset Int
    new_name Text
    build_options List[BuildOption]
    native_tool Text
}

record EditorOutput {
    text Text
    failed Bool
}

fn editor_input_report(inputs BuildInputs, report EditorOutput) EditorOutput {
    var paths = "["
    var index = 0
    while index < length(inputs.requests) {
        if index > 0 { paths = concat(paths, ",") }
        paths = concat(paths, editor_quoted(input_path(get(inputs.requests, index))))
        index = index + 1
    }
    var file = 0
    while file < length(inputs.files) {
        if index > 0 || file > 0 { paths = concat(paths, ",") }
        paths = concat(paths, editor_quoted(get(inputs.files, file).file.path))
        file = file + 1
    }
    EditorOutput { text = concat("{\"buildInputs\":", concat(paths,
        concat("],", slice(report.text, 1, std.text.length(report.text))))) failed = report.failed }
}

// This fixed editor protocol belongs to the compiler driver, not the runtime
// or a general JSON API. UTF-8 bytes stay intact; JSON control bytes are escaped.
fn editor_quoted(value Text) Text {
    let bytes = std.bytes.new()
    std.bytes.push(bytes, 34)
    var index = 0
    while index < std.text.length(value) {
        let current = std.text.byte(value, index)
        if current == 34 || current == 92 {
            std.bytes.push(bytes, 92)
            std.bytes.push(bytes, current)
        } else {
            if current < 32 {
                std.bytes.push(bytes, 92)
                std.bytes.push(bytes, 117)
                std.bytes.push(bytes, 48)
                std.bytes.push(bytes, 48)
                std.bytes.push(bytes, std.text.byte("0123456789abcdef", current / 16))
                std.bytes.push(bytes, std.text.byte("0123456789abcdef", current % 16))
            } else {
                std.bytes.push(bytes, current)
            }
        }
        index = index + 1
    }
    std.bytes.push(bytes, 34)
    std.bytes.to_text(bytes)
}

fn editor_error(message Text) EditorOutput {
    EditorOutput {
        text = concat("{\"diagnostics\":[],\"error\":", concat(editor_quoted(message), "}\n"))
        failed = true
    }
}

fn editor_diagnostic_json(path Text, diagnostic Diagnostic) Text {
    let fields = concat("{\"path\":", concat(editor_quoted(path), concat(",\"message\":", editor_quoted(diagnostic.message))))
    let start = concat(fields, concat(",\"start\":", to_text(diagnostic.span.start)))
    concat(start, concat(",\"end\":", concat(to_text(diagnostic.span.end), "}")))
}

fn editor_diagnostic(path Text, diagnostic Diagnostic) EditorOutput {
    EditorOutput {
        text = concat("{\"diagnostics\":[", concat(editor_diagnostic_json(path, diagnostic), "]}\n"))
        failed = true
    }
}

fn editor_options(args List[Text]) Result[EditorOptions, Text] {
    var path = ""
    var standard = ""
    var native_tool = ""
    var tests = false
    var query_path = ""
    var offset = -1
    var new_name = ""
    let build_options = std.list.new[BuildOption]()
    let mode = get(args, 1)
    let query = mode == "editor-query" || mode == "editor-complete" ||
    mode == "editor-references" || mode == "editor-rename" || mode == "editor-auto-import"
    let overlays = std.list.new[SourceOverlay]()
    var index = 2
    while index < std.list.length(args) {
        let argument = get(args, index)
        if argument == "--native-tool" {
            index = index + 1
            if index == std.list.length(args) {
                return Result.Err("--native-tool needs a value")
            }
            native_tool = get(args, index)
        } else if argument == "--build-option" {
            index = index + 1
            if index == std.list.length(args) {
                return Result.Err("--build-option needs a value")
            }
            std.list.push(build_options, build_option_argument(get(args, index))?)
        } else if argument == "--at" {
            if !query || query_path != "" || index + 2 >= std.list.length(args) {
                return Result.Err("editor queries require one --at source-path byte-offset")
            }
            query_path = get(args, index + 1)
            if !starts_with(query_path, "/") && !is_windows_path(query_path) {
                return Result.Err("editor queries require an absolute source path")
            }
            offset = match std.int.parse(get(args, index + 2)) {
                Result.Ok(value) => value
                Result.Err(_) => {
                    return Result.Err("query byte offset must be a nonnegative integer")
                }
            }
            if offset < 0 {
                return Result.Err("query byte offset must be a nonnegative integer")
            }
            index = index + 2
        } else {
            if argument == "--to" {
                if mode != "editor-rename" || new_name != "" || index + 1 >= std.list.length(args) {
                    return Result.Err("editor-rename requires one --to name")
                }
                new_name = get(args, index + 1)
                index = index + 1
            } else {
                if argument == "--tests" {
                    if tests {
                        return Result.Err("duplicate --tests")
                    }
                    tests = true
                } else {
                    if argument == "--std" {
                        index = index + 1
                        if index == std.list.length(args) {
                            return Result.Err("--std needs a path")
                        }
                        standard = get(args, index)
                    } else {
                        if argument == "--overlay" {
                            if index + 2 >= std.list.length(args) {
                                return Result.Err("--overlay needs an original file path and a UTF-8 snapshot file")
                            }
                            let original = get(args, index + 1)
                            let snapshot = get(args, index + 2)
                            let text = match read_text(snapshot) {
                                Result.Ok(value) => value
                                Result.Err(_) => {
                                    return Result.Err(concat(original, ": cannot read UTF-8 overlay snapshot"))
                                }
                            }
                            std.list.push(overlays, SourceOverlay {
                                    path = original
                                    text = text
                                })
                            index = index + 2
                        } else {
                            if starts_with(argument, "-") {
                                return Result.Err(concat("unknown editor-check option ", argument))
                            }
                            if path != "" {
                                return Result.Err("editor-check selects one package directory")
                            }
                            path = argument
                        }
                    }
                }
            }
        }
        index = index + 1
    }
    if query && query_path == "" {
        return Result.Err("editor queries require --at source-path byte-offset")
    }
    if mode == "editor-rename" && new_name == "" {
        return Result.Err("editor-rename requires one --to name")
    }
    if path == "" {
        return Result.Err("editor-check requires an absolute package directory")
    }
    if !starts_with(path, "/") && !is_windows_path(path) {
        return Result.Err("editor-check requires an absolute package directory")
    }
    let tools = compiler_tools(get(args, 0), standard, "", false)?
    Result.Ok(EditorOptions {
            path = path
            std_root = tools.std_root
            tests = tests
            overlays = overlays
            query_path = query_path
            offset = offset
            new_name = new_name
            build_options = build_option_snapshot(build_options)?
            native_tool = native_tool
        })
}

fn editor_execute(args List[Text]) EditorOutput {
    editor_execute(args, editor_cache())
}

fn editor_execute(args List[Text], cache EditorCache) EditorOutput {
    let options = match editor_options(args) {
        Result.Ok(value) => value
        Result.Err(message) => {
            return editor_error(message)
        }
    }
    if get(args, 1) == "editor-auto-import" {
        return editor_auto_import(options)
    }
    if get(args, 1) == "editor-complete" {
        match editor_import_completion(options) {
            Option.Some(value) => {
                return value
            }
            Option.None => {
            }
        }
    }
    var recovery = EditorRecovery {
        changed = false
        inserted = false
    }
    var loaded = load_overlaid(options.path, options.std_root, options.tests, options.overlays)
    if get(args, 1) == "editor-complete" {
        match loaded {
            Result.Ok(_) => {
            }
            Result.Err(_) => {
                recovery = editor_recover(options)
                if recovery.changed {
                    loaded = load_overlaid(options.path, options.std_root, options.tests, options.overlays)
                }
            }
        }
    }
    let project = match loaded {
        Result.Ok(value) => value
        Result.Err(failed) => {
            // Repaired snapshots supply candidates only. Diagnostics still come
            // from editor-check on the original buffers, not synthetic text.
            if recovery.changed {
                return editor_no_completion()
            }
            return if failed.path == "" {
                editor_error(failed.diagnostic.message)
            } else {
                editor_diagnostic(failed.path, failed.diagnostic)
            }
        }
    }
    let inputs = driver_build_inputs(options.build_options, options.native_tool)
    if get(args, 1) != "editor-complete" {
        match editor_reuse(cache, project, options.tests, inputs) {
            Option.Some(analysis) => {
                return editor_analyzed(args, options, project, analysis, inputs)
            }
            Option.None => {}
        }
    }
    let staging = std.loom.checking.has_declaration_stages(project, options.tests)
    let completion_project = if staging && get(args, 1) == "editor-complete" {
        match expand_project(project, options.tests, inputs) {
            Result.Ok(value) => value
            Result.Err(_) => project
        }
    } else { project }
    let bound = match (if staging { std.loom.binding.bind_headers(completion_project, options.tests) } else { bind(project, options.tests) }) {
        Result.Ok(value) => value
        Result.Err(failed) => {
            if recovery.changed {
                return editor_no_completion()
            }
            return editor_diagnostic(get(project.files, failed.source).path, failed.diagnostic)
        }
    }
    if options.query_path != "" {
        let index = match editor_source(project, options.query_path) {
            Result.Ok(value) => value,
            Result.Err(message) => {
                return editor_error(message)
            }
        }
        if options.offset > std.text.length(get(project.files, index).text) {
            return editor_error("query byte offset is outside the source")
        }
        if get(args, 1) == "editor-complete" {
            return editor_completion(bound, index, options.offset, recovery.inserted, driver_build_inputs(options.build_options, options.native_tool))
        }
    }
    match editor_checked(bound, inputs, cache) {
        Result.Ok(analysis) => editor_analyzed(args, options, project, analysis, inputs)
        Result.Err(failed) => {
            if get(args, 1) == "editor-query" {
                let index = match editor_source(project, options.query_path) {
                    Result.Ok(value) => value
                    Result.Err(message) => { return editor_error(message) }
                }
                let diagnostic = editor_diagnostic_json(get(project.files, failed.source).path, failed.diagnostic)
                return editor_input_report(inputs, editor_inspection(bound,
                    inspect_independent(bound, index, options.offset, inputs), diagnostic))
            }
            editor_input_report(inputs, editor_diagnostic(get(project.files, failed.source).path, failed.diagnostic))
        }
    }
}

fn editor_analyzed(args List[Text], options EditorOptions, project Project, analysis Analysis, inputs BuildInputs) EditorOutput {
    if options.query_path != "" {
        let index = match editor_source(project, options.query_path) {
            Result.Ok(value) => value
            Result.Err(message) => { return editor_error(message) }
        }
        if options.offset > std.text.length(get(project.files, index).text) {
            return editor_error("query byte offset is outside the source")
        }
        let output = if get(args, 1) == "editor-references" || get(args, 1) == "editor-rename" {
            editor_symbols(options, analysis, index, options.offset, inputs)
        } else {
            editor_inspection(analysis.bindings, editor_bound_inspection(analysis, index, options.offset, inputs), "")
        }
        return editor_input_report(inputs, output)
    }
    editor_input_report(inputs, EditorOutput {
        text = "{\"diagnostics\":[]}\n"
        failed = false
    })
}

test fn editor_protocol_quotes_control_bytes_without_reencoding_unicode() {
    assert editor_quoted("a\n\t\"\\😀") == "\"a\\u000a\\u0009\\\"\\\\😀\""
    let output = editor_diagnostic("/a\".loom", Diagnostic {
            span = Span {
                start = 4
                end = 8
            }
            message = "bad\ntext"
        })
    assert output.failed && output.text == "{\"diagnostics\":[{\"path\":\"/a\\\".loom\",\"message\":\"bad\\u000atext\",\"start\":4,\"end\":8}]}\n"
}
