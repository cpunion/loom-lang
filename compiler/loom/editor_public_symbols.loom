import std.loom.binding.candidates
import std.loom.project.name
import std.loom.analysis.import_edits
import std.loom.analysis.import_definition_at
import std.loom.source.apply_edits

// Public declaration edits cover this module, not external consumers or dependency
// snapshots. Each directory keeps its own private test scope and checked IDs.
fn editor_import_selected(analysis EditorAnalysis, file Int, token Token, tokens List[Token]) Option[Location] {
    import_definition_at(analysis.snapshot, file, token.span.start)
}

fn editor_generated(node Node) Bool {
    if node.kind == NodeKind.MacroCall {
        return true
    }
    var index = 0
    while index < length(node.children) {
        let child = get(node.children, index)
        if (node.kind == NodeKind.File && child.kind == NodeKind.Comptime) || editor_generated(child) {
            return true
        }
        index = index + 1
    }
    false
}

record EditorPublicEdit {
    path Text
    text Text
    changes List[TextEdit]
}

fn editor_public_edit(edits List[EditorPublicEdit], path Text, text Text, change TextEdit) Bool {
    var index = 0
    while index < length(edits) {
        let edit = get(edits, index)
        if edit.path == path {
            if edit.text != text {
                return false
            }
            var item = 0
            while item < length(edit.changes) {
                let existing = get(edit.changes, item)
                if editor_same_span(existing.span, change.span) {
                    return existing.text == change.text
                }
                item = item + 1
            }
            push(edit.changes, change)
            return true
        }
        index = index + 1
    }
    let changes = [change]
    push(edits, EditorPublicEdit {
            path = path
            text = text
            changes = changes
        })
    true
}

fn editor_public_imports(analysis EditorAnalysis, file Int, target Location, tokens List[Token],
    spelling Text, name Text, edits List[EditorPublicEdit]) Result[List[Location], Text] {
    let source = get(editor_data(analysis).bindings.files, file)
    let covered = new[Location]()
    var index = 0
    while index < length(source.tree.children) {
        let node = get(source.tree.children, index)
        if node.kind == NodeKind.Import {
            let candidates = std.loom.binding.candidates(editor_data(analysis).bindings, file, source.test_only, node.value)
            var selected = false
            var item = 0
            while item < length(candidates) {
                let symbol = get(editor_data(analysis).bindings.symbols, get(candidates, item))
                if symbol.file == target.file && symbol.node.span.start <= target.span.start &&
                target.span.end <= symbol.node.span.end {
                    selected = true
                }
                item = item + 1
            }
            if selected {
                var member = node.span
                item = 0
                while item < length(tokens) {
                    let token = get(tokens, item)
                    if token.kind == Kind.Name && token.span.start >= node.span.start && token.span.end <= node.span.end {
                        member = token.span
                    }
                    item = item + 1
                }
                push(covered, Location {
                        file = file
                        span = member
                    })
                let changes = if name == "" {
                    [TextEdit {
                            span = member
                            text = spelling
                        }]
                } else {
                    import_edits(source.text, node, if length(candidates) > 1 && name != spelling {
                            [spelling, name]
                        } else {
                            [name]
                        })?
                }
                item = 0
                while item < length(changes) {
                    if !editor_public_edit(edits, source.path, source.text, get(changes, item)) {
                        return Result.Err("Public rename cannot edit a changing source file")
                    }
                    item = item + 1
                }
            }
        }
        index = index + 1
    }
    Result.Ok(covered)
}

fn editor_public_target(analysis EditorAnalysis, path Text, span Span) Option[Location] {
    var file = 0
    while file < length(editor_data(analysis).bindings.files) {
        if get(editor_data(analysis).bindings.files, file).path == path {
            return Option.Some(Location {
                    file = file
                    span = span
                })
        }
        file = file + 1
    }
    Option.None
}

fn editor_public_visible(analysis EditorAnalysis, file Int, target Location, spelling Text) Bool {
    let candidates = std.loom.binding.candidates(editor_data(analysis).bindings, file, true, spelling)
    var index = 0
    while index < length(candidates) {
        let symbol = get(editor_data(analysis).bindings.symbols, get(candidates, index))
        if symbol.file == target.file {
            return true
        }
        index = index + 1
    }
    false
}

fn editor_public_collect(analysis EditorAnalysis, module Text, path Text, span Span,
    spelling Text, name Text, field Bool, edits List[EditorPublicEdit]) Result[Bool, Text] {
    let target = match editor_public_target(analysis, path, span) {
        Option.Some(value) => value
        Option.None => {
            if field && name != "" && editor_field_unobserved(analysis, spelling) {
                return Result.Err("Rename cannot account for every occurrence of this public field")
            }
            return Result.Ok(true)
        }
    }
    let owner = editor_field_owner(analysis, target, spelling)
    let public_field = owner >= 0 && get(editor_data(analysis).bindings.symbols, owner).public &&
    editor_declaration_authority(analysis, target, true)
    if !(if field {
            public_field
        } else {
            editor_top_declaration(analysis, target, spelling, true)
        }) {
        return Result.Err("Public rename requires one selected ordinary declaration or record field, not a generated declaration")
    }
    let references = editor_references(analysis, target, spelling)
    var file = 0
    while file < length(editor_data(analysis).bindings.files) {
        let source = get(editor_data(analysis).bindings.files, file)
        // Imported packages omit their tests in this analysis. Their own root
        // analysis accounts for those uses; never mistake omission for evidence.
        if source.package == editor_data(analysis).bindings.root {
            if !std.text.starts_with(source.path, join_path(module, "")) {
                return Result.Err("Public rename cannot edit an external source file")
            }
            let visible = field || editor_public_visible(analysis, file, target, spelling)
            if name != "" && (editor_generated(source.tree) || std.loom.checking.has_declaration_stages(editor_data(analysis).source, true)) {
                return Result.Err("Public rename cannot account for generated source references")
            }
            let tokens = match lex(source.text) {
                Result.Ok(value) => value
                Result.Err(_) => {
                    return Result.Err("Cannot lex a module source file")
                }
            }
            let imports = if field {
                new[Location]()
            } else {
                editor_public_imports(analysis, file, target, tokens, spelling, name, edits)?
            }
            var index = 0
            while index < length(tokens) {
                let token = get(tokens, index)
                let location = Location {
                    file = file
                    span = token.span
                }
                if visible && name != "" && name != spelling && token.kind == Kind.Name && token.value == name {
                    return Result.Err("Rename would conflict with a name in an affected package")
                }
                if token.kind == Kind.Name && token.value == spelling && !editor_contains(imports, location) {
                    if editor_contains(references, location) {
                        if !editor_public_edit(edits, source.path, source.text, TextEdit {
                                span = token.span
                                text = name
                            }) {
                            return Result.Err("Public rename cannot edit an external or changing source file")
                        }
                    } else if visible && name != "" {
                        // A distinct checked binding is not a reference. Unknown
                        // occurrences may live in an uninstantiated body.
                        if !editor_other_binding(analysis, file, token, tokens, Option.Some(target)) {
                            return Result.Err("Rename cannot account for every occurrence of this public declaration")
                        }
                    }
                }
                index = index + 1
            }
        }
        file = file + 1
    }
    Result.Ok(true)
}

fn editor_public_overlays(options EditorOptions, edits List[EditorPublicEdit]) Result[List[SourceOverlay], Text] {
    let overlays = new[SourceOverlay]()
    var index = 0
    while index < length(options.overlays) {
        let overlay = get(options.overlays, index)
        var edited = false
        var item = 0
        while item < length(edits) {
            if editor_same_source_path(overlay.path, get(edits, item).path) {
                edited = true
            }
            item = item + 1
        }
        if !edited {
            push(overlays, overlay)
        }
        index = index + 1
    }
    index = 0
    while index < length(edits) {
        let edit = get(edits, index)
        let revised = match apply_edits(edit.text, edit.changes) {
            Result.Ok(value) => value
            Result.Err(_) => {
                return Result.Err("Public rename has overlapping or stale source edits")
            }
        }
        push(overlays, SourceOverlay {
                path = edit.path
                text = revised
            })
        index = index + 1
    }
    Result.Ok(overlays)
}

fn editor_module_analysis(options EditorOptions, directory Text, overlays List[SourceOverlay],
    inputs BuildInputs, cache EditorCache) Result[EditorAnalysis, Text] {
    let project = match load_overlaid(directory, options.std_root, true, overlays) {
        Result.Ok(value) => value
        Result.Err(failed) => {
            return Result.Err(failed.diagnostic.message)
        }
    }
    let bindings = match bind_headers(project, true) {
        Result.Ok(value) => value
        Result.Err(failed) => {
            return Result.Err(failed.diagnostic.message)
        }
    }
    match editor_checked(bindings, inputs, cache) {
        Result.Ok(value) => Result.Ok(value)
        Result.Err(failed) => Result.Err(failed.diagnostic.message)
    }
}

fn editor_public_symbols(options EditorOptions, initial EditorAnalysis, target Location,
    spelling Text, inputs BuildInputs) EditorOutput {
    let rename = options.new_name != ""
    let field = editor_field_owner(initial, target, spelling) >= 0
    if rename && !editor_valid_new_name(options.new_name) {
        return editor_error("Rename needs a valid non-reserved Loom identifier")
    }
    if !options.tests {
        return editor_error("Public declaration queries require --tests to account for every package's tests")
    }
    let root = get(editor_data(initial).bindings.packages, editor_data(initial).bindings.root)
    let module = get(editor_data(initial).bindings.modules, root.instance).source
    let path = get(editor_data(initial).bindings.files, target.file).path
    let extra = new[Text]()
    var index = 0
    while index < length(options.overlays) {
        match canonicalize(executable_directory(get(options.overlays, index).path)) {
            Result.Ok(directory) => {
                push(extra, directory)
            }
            Result.Err(_) => {
            }
        }
        index = index + 1
    }
    let packages = new[Text]()
    match package_directories(module, true, packages, extra) {
        Result.Err(message) => {
            return editor_error(message)
        }
        Result.Ok(_) => {
        }
    }
    let edits = new[EditorPublicEdit]()
    let cache = editor_cache()
    index = 0
    while index < length(packages) {
        let directory = get(packages, index)
        let analysis = if editor_same_source_path(directory, options.path) {
            initial
        } else {
            match editor_module_analysis(options, directory, options.overlays, inputs, cache) {
                Result.Ok(value) => value
                Result.Err(message) => {
                    return editor_error(concat("Cannot check module package: ", message))
                }
            }
        }
        match editor_public_collect(analysis, module, path, target.span, spelling, options.new_name, field, edits) {
            Result.Err(message) => {
                return editor_error(message)
            }
            Result.Ok(_) => {
            }
        }
        index = index + 1
    }
    if rename {
        let overlays = match editor_public_overlays(options, edits) {
            Result.Ok(value) => value
            Result.Err(message) => {
                return editor_error(message)
            }
        }
        index = 0
        while index < length(packages) {
            match editor_module_analysis(options, get(packages, index), overlays, inputs, cache) {
                Result.Err(_) => {
                    return editor_error("Rename would invalidate a module package")
                }
                Result.Ok(_) => {
                }
            }
            index = index + 1
        }
    }
    var locations = "["
    index = 0
    var count = 0
    while index < length(edits) {
        let edit = get(edits, index)
        var item = 0
        while item < length(edit.changes) {
            let change = get(edit.changes, item)
            let span = change.span
            if count > 0 {
                locations = concat(locations, ",")
            }
            locations = concat(locations, editor_change_json(edit.path, span, if rename {
                        Option.Some(change.text)
                    } else {
                        Option.None
                    }))
            count = count + 1
            item = item + 1
        }
        index = index + 1
    }
    let prefix = if rename {
        "{\"diagnostics\":[],\"changes\":"
    } else {
        concat("{\"diagnostics\":[],\"declaration\":", concat(editor_location_json(editor_data(initial).bindings, target), ",\"references\":"))
    }
    EditorOutput {
        text = concat(prefix, concat(locations, "]}\n"))
        failed = false
    }
}
