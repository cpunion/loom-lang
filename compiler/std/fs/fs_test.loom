import std.list.push
import std.list.get

test fn deterministic_byte_order() {
    let names = std.list.new[Text]()
    push(names, "z")
    push(names, "a")
    push(names, "ä")
    push(names, "aa")
    push(names, "A")
    push(names, "a")
    let ordered = sorted(names, before)
    assert get(ordered, 0) == "A"
    assert get(ordered, 1) == "a"
    assert get(ordered, 2) == "a"
    assert get(ordered, 3) == "aa"
    assert get(ordered, 4) == "z"
    assert get(ordered, 5) == "ä"
}
