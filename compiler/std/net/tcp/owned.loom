import std.resource.Dispose
import std.resource.MustScope

// Unlike a copyable socket token, this result carries its cleanup through Tasks.
pub record Connection {
    state ConnectionState
}

record ConnectionState {
    socket Stream
    closed List[Bool]
}

fn owned_connection(token Int) Connection {
    Connection {
        state = ConnectionState {
            socket = Stream {
                state = State {
                    token = token
                }
            }
            closed = [false]
        }
    }
}

// Construct the owner in the acquisition Task itself. Wrapping connect().await
// in another Task could abandon an unclaimed, non-resource socket result.
pub async fn open(address Text) Result[Connection, TcpError] {
    let token = socket_connect(address)
    if token < 0 {
        return Result.Err(TcpError.Connect)
    }
    var transferred = false
    defer {
        if !transferred {
            discard socket_close(token)
        }
    }
    if !connected(token).await {
        return Result.Err(TcpError.Connect)
    }
    transferred = true
    Result.Ok(owned_connection(token))
}

pub async fn accept_owned(listener Listener) Result[Connection, TcpError] {
    while true {
        let token = socket_accept(listener.state.token)
        if token >= 0 {
            return Result.Ok(owned_connection(token))
        }
        if token != -2 {
            return Result.Err(TcpError.Accept)
        }
        socket_wait(listener.state.token, 1).await
    }
}

pub fn close(connection Connection) Result[Int, TcpError] {
    if connection.state.closed[0] {
        return Result.Ok(0)
    }
    let status = close_stream(connection.state.socket)
    match status {
        Result.Ok(_) => {
            connection.state.closed[0] = true
        }
        Result.Err(_) => {
        }
    }
    status
}

pub async fn read(connection Connection, output Bytes, limit Int) Result[Int, TcpError] {
    read(connection.state.socket, output, limit).await
}

pub async fn write_bytes(connection Connection, input Bytes) Result[Int, TcpError] {
    write_bytes(connection.state.socket, input).await
}

pub fn shutdown_write(connection Connection) Result[Int, TcpError] {
    shutdown_write(connection.state.socket)
}

pub fn local_address(connection Connection) Result[Text, TcpError] {
    local_address(connection.state.socket)
}

pub fn peer_address(connection Connection) Result[Text, TcpError] {
    peer_address(connection.state.socket)
}

pub fn set_nodelay(connection Connection, enabled Bool) Result[Int, TcpError] {
    set_nodelay(connection.state.socket, enabled)
}

impl MustScope for Connection {
}

impl Dispose for Connection {
    fn dispose(self Connection) {
        discard close(self)
    }
}
