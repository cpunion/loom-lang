import std.result.Result
import std.bytes.length
import std.net.dns.resolve
import std.list.length
import std.list.get

// Tokens are owner-local identities, never operating-system descriptors.
// Copying a wrapper copies its identity, not the native socket: after close,
// every copy becomes stale. Close fails while a task has a readiness lease.
record State {
    token Int
}

pub record Listener {
    state State
}

pub record Stream {
    state State
}

pub enum TcpError {
    Listen
    Resolve
    Connect
    Port
    Accept
    Read
    Write
    Close
    Address
    Option
    Shutdown
}

intrinsic fn socket_listen(address Text) Int

intrinsic fn socket_connect(address Text) Int

intrinsic fn socket_connect_status(token Int) Int

intrinsic fn socket_local_port(token Int) Int

intrinsic fn socket_address(token Int, peer Int) Text

intrinsic fn socket_set_nodelay(token Int, enabled Int) Int

intrinsic fn socket_shutdown_write(token Int) Int

intrinsic fn socket_accept(token Int) Int

intrinsic fn socket_read(token Int, buffer Bytes, limit Int) Int

intrinsic fn socket_write_bytes(token Int, value Bytes, offset Int) Int

intrinsic fn socket_close(token Int) Int

async intrinsic fn socket_wait(token Int, interest Int)

// Listening takes a numeric IPv4/IPv6 socket address.
pub async fn listen(address Text) Result[Listener, TcpError] {
    let token = socket_listen(address)
    if token < 0 {
        return Result.Err(TcpError.Listen)
    }
    Result.Ok(Listener {
            state = State {
                token = token
            }
        })
}

// A native socket is private to this Task until connect succeeds immediately or
// readiness and SO_ERROR/peer checks confirm a connection. The defer closes
// it after failure or cancellation, once any wait lease retires.
pub async fn connect(address Text) Result[Stream, TcpError] {
    let token = socket_connect(address)
    if token < 0 {
        return Result.Err(TcpError.Connect)
    }
    var transferred = false
    defer {
        if !transferred {
            discard socket_close(token)
        }
    }
    while true {
        let status = socket_connect_status(token)
        if status == 0 {
            transferred = true
            return Result.Ok(Stream {
                    state = State {
                        token = token
                    }
                })
        }
        if status != -2 {
            return Result.Err(TcpError.Connect)
        }
        socket_wait(token, 2).await
    }
}

// Resolve a host, then try each address in OS order. Failed attempts close
// before the next one starts. No implicit timeout or parallel address racing.
pub async fn connect(host Text, port Int) Result[Stream, TcpError] {
    let addresses = match std.net.dns.resolve(host, port).await {
        Result.Ok(values) => values
        Result.Err(_) => {
            return Result.Err(TcpError.Resolve)
        }
    }
    var index = 0
    while index < std.list.length(addresses) {
        match connect(std.list.get(addresses, index)).await {
            Result.Ok(stream) => {
                return Result.Ok(stream)
            }
            Result.Err(_) => {
            }
        }
        index = index + 1
    }
    Result.Err(TcpError.Connect)
}

pub fn local_port(listener Listener) Result[Int, TcpError] {
    let port = socket_local_port(listener.state.token)
    if port < 0 {
        return Result.Err(TcpError.Port)
    }
    Result.Ok(port)
}

pub fn local_port(stream Stream) Result[Int, TcpError] {
    let port = socket_local_port(stream.state.token)
    if port < 0 {
        return Result.Err(TcpError.Port)
    }
    Result.Ok(port)
}

fn address(token Int, peer Int) Result[Text, TcpError] {
    let value = socket_address(token, peer)
    if value == "" {
        return Result.Err(TcpError.Address)
    }
    Result.Ok(value)
}

// Numeric endpoints: IPv4 host:port or bracketed IPv6 [host]:port. No DNS.
pub fn local_address(listener Listener) Result[Text, TcpError] {
    address(listener.state.token, 0)
}

pub fn local_address(stream Stream) Result[Text, TcpError] {
    address(stream.state.token, 0)
}

pub fn peer_address(stream Stream) Result[Text, TcpError] {
    address(stream.state.token, 1)
}

pub fn set_nodelay(stream Stream, enabled Bool) Result[Int, TcpError] {
    if socket_set_nodelay(stream.state.token, if enabled {
            1
        } else {
            0
        }) < 0 {
        return Result.Err(TcpError.Option)
    }
    Result.Ok(0)
}

// Ends only sending; reads and their registrations remain valid. Pending or
// subsequent writes may fail, so finish intended writes before this operation.
// This does not close/revoke the token. Close after all child waits have drained.
pub fn shutdown_write(stream Stream) Result[Int, TcpError] {
    if socket_shutdown_write(stream.state.token) < 0 {
        return Result.Err(TcpError.Shutdown)
    }
    Result.Ok(0)
}

pub async fn accept(listener Listener) Result[Stream, TcpError] {
    while true {
        let token = socket_accept(listener.state.token)
        if token >= 0 {
            return Result.Ok(Stream {
                    state = State {
                        token = token
                    }
                })
        }
        if token != -2 {
            return Result.Err(TcpError.Accept)
        }
        socket_wait(listener.state.token, 1).await
    }
}

// Append up to a positive limit. Ok(0) is EOF; readiness races retry safely.
pub async fn read(stream Stream, buffer Bytes, limit Int) Result[Int, TcpError] {
    if limit <= 0 {
        return Result.Err(TcpError.Read)
    }
    while true {
        let count = socket_read(stream.state.token, buffer, limit)
        if count >= 0 {
            return Result.Ok(count)
        }
        if count != -2 {
            return Result.Err(TcpError.Read)
        }
        socket_wait(stream.state.token, 1).await
    }
}

// Write the initial Bytes length, including partial nonblocking writes.
// The shared buffer is not snapshotted: alias mutation while this Task is
// pending can change the sent bytes or make a later offset invalid.
pub async fn write_bytes(stream Stream, value Bytes) Result[Int, TcpError] {
    let size = length(value)
    var offset = 0
    while offset < size {
        let count = socket_write_bytes(stream.state.token, value, offset)
        if count == -2 {
            socket_wait(stream.state.token, 2).await
        } else {
            if count <= 0 {
                return Result.Err(TcpError.Write)
            }
            offset = offset + count
        }
    }
    Result.Ok(offset)
}

pub fn close_listener(listener Listener) Result[Int, TcpError] {
    if socket_close(listener.state.token) < 0 {
        return Result.Err(TcpError.Close)
    }
    Result.Ok(0)
}

pub fn close_stream(stream Stream) Result[Int, TcpError] {
    if socket_close(stream.state.token) < 0 {
        return Result.Err(TcpError.Close)
    }
    Result.Ok(0)
}
