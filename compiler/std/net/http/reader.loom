record Cursor {
    chunk Bytes
    position Int
    eof Bool
    retired Bool
    busy Bool
}

pub record Reader[S Stream, E] {
    state State[S, E]
}

record State[S Stream, E] {
    source S
    bytes fn(S.Item) Result[Bytes, E]
    limits Limits
    cursor List[Cursor]
}

// Borrow the producer. Callers serialize reads and own transport cleanup.
// Limits include all start/field/chunk-extension/trailer line octets and CRLFs.
pub fn reader[S Stream, E](source S, bytes fn(S.Item) Result[Bytes, E], maximum Limits) Reader[S, E]
requires valid_limits(maximum)
{
    Reader[S, E] {
        state = State[S, E] {
            source = source
            bytes = bytes
            limits = maximum
            cursor = [Cursor {
                    chunk = std.bytes.new()
                    position = 0
                    eof = false
                    retired = false
                    busy = false
                }]
        }
    }
}

fn retire(state List[Cursor]) {
    state[0] = Cursor {
        chunk = std.bytes.new()
        position = 0
        retired = true
        busy = false
        ..state[0]
    }
}

fn begin(state List[Cursor]) Result[Bool, ProtocolError] {
    if state[0].busy {
        return Result.Err(ProtocolError.Busy)
    }
    if state[0].retired {
        return Result.Err(ProtocolError.Closed)
    }
    state[0] = Cursor {
        busy = true
        ..state[0]
    }
    Result.Ok(true)
}

async fn available[S Stream, E](input Reader[S, E]) Result[Bool, ReadError[E]] {
    while input.state.cursor[0].position == length(input.state.cursor[0].chunk) {
        if input.state.cursor[0].eof {
            return Result.Ok(false)
        }
        let chunk = match input.state.source.next().await {
            Option.None => {
                input.state.cursor[0] = Cursor {
                    chunk = std.bytes.new()
                    position = 0
                    eof = true
                    ..input.state.cursor[0]
                }
                return Result.Ok(false)
            }
            Option.Some(item) => match input.state.bytes(item) {
                Result.Ok(bytes) => bytes
                Result.Err(error) => {
                    return Result.Err(ReadError.Input(error))
                }
            }
        }
        input.state.cursor[0] = Cursor {
            chunk = chunk
            position = 0
            ..input.state.cursor[0]
        }
    }
    Result.Ok(true)
}

fn protocol[T, E](value Result[T, ProtocolError]) Result[T, ReadError[E]] {
    match value {
        Result.Ok(value) => Result.Ok(value)
        Result.Err(error) => Result.Err(ReadError.Protocol(error))
    }
}

// Scan buffered octets synchronously. Tasks occur per line/chunk, not per byte.
async fn line[S Stream, E](input Reader[S, E], budget List[Int]) Result[Option[Bytes], ReadError[E]] {
    let output = std.bytes.new()
    var carriage = false
    while available(input).await? {
        let current = input.state.cursor[0]
        var position = current.position
        while position < length(current.chunk) {
            if budget[0] == 0 {
                return Result.Err(ReadError.Protocol(ProtocolError.Limit))
            }
            budget[0] = budget[0] - 1
            let next = get(current.chunk, position)
            position = position + 1
            if carriage {
                if next != 10 {
                    return Result.Err(ReadError.Protocol(ProtocolError.Syntax))
                }
                input.state.cursor[0] = Cursor {
                    position = position
                    ..current
                }
                return Result.Ok(Option.Some(output))
            }
            if next == 13 {
                carriage = true
            } else {
                if next == 10 {
                    return Result.Err(ReadError.Protocol(ProtocolError.Syntax))
                }
                if length(output) == input.state.limits.line_bytes {
                    return Result.Err(ReadError.Protocol(ProtocolError.Limit))
                }
                push(output, next)
            }
        }
        input.state.cursor[0] = Cursor {
            position = position
            ..current
        }
    }
    if carriage || length(output) != 0 {
        return Result.Err(ReadError.Protocol(ProtocolError.Truncated))
    }
    Result.Ok(Option.None)
}

async fn required_line[S Stream, E](input Reader[S, E], budget List[Int]) Result[Bytes, ReadError[E]] {
    match line(input, budget).await? {
        Option.Some(value) => Result.Ok(value)
        Option.None => Result.Err(ReadError.Protocol(ProtocolError.Truncated))
    }
}

async fn fields[S Stream, E](input Reader[S, E], budget List[Int], trailers Bool) Result[List[Header], ReadError[E]] {
    let output = std.list.new[Header]()
    while true {
        let next = required_line(input, budget).await?
        if length(next) == 0 {
            return Result.Ok(output)
        }
        let entry = protocol[Header, E](field(next))?
        if trailers && !trailer(entry) {
            return Result.Err(ReadError.Protocol(ProtocolError.Framing))
        }
        std.list.push(output, entry)
    }
    Result.Ok(output)
}

async fn collected_body[S Stream, E](body Body[S, E]) Result[(Bytes, List[Header]), ReadError[E]] {
    let output = std.bytes.new()
    while true {
        match body.next().await {
            Option.None => {
                return Result.Ok((output, protocol[List[Header], E](trailers(body))?))
            }
            Option.Some(value) => {
                append(output, value?)
            }
        }
    }
    Result.Ok((output, std.list.new[Header]()))
}

pub async fn read_request[S Stream, E](input Reader[S, E]) Result[Option[Request], ReadError[E]] {
    scoped next = open_request(input, 16384).await?
    match next {
        Option.None => Result.Ok(Option.None)
        Option.Some(value) => {
            let contents = collected_body(value.body).await?
            Result.Ok(Option.Some(Request {
                        method = value.method
                        target = value.target
                        headers = value.headers
                        body = contents.0
                        trailers = contents.1
                    }))
        }
    }
}

// The caller supplies the corresponding request method, including HEAD/CONNECT.
// Informational responses are returned individually, not silently skipped.
pub async fn read_response[S Stream, E](input Reader[S, E], method Text) Result[Option[Response], ReadError[E]] {
    scoped next = open_response(input, method, 16384).await?
    match next {
        Option.None => Result.Ok(Option.None)
        Option.Some(value) => {
            let contents = collected_body(value.body).await?
            Result.Ok(Option.Some(Response {
                        status = value.status
                        reason = value.reason
                        headers = value.headers
                        body = contents.0
                        trailers = contents.1
                    }))
        }
    }
}

// Retire HTTP parsing and transfer a copy of unread prefetched octets. The
// producer remains caller-owned; use this once when switching protocols.
pub fn take_buffered[S Stream, E](input Reader[S, E]) Result[Bytes, ProtocolError] {
    if input.state.cursor[0].busy {
        return Result.Err(ProtocolError.Busy)
    }
    let current = input.state.cursor[0]
    let output = portion(current.chunk, current.position, length(current.chunk))
    retire(input.state.cursor)
    Result.Ok(output)
}
