import std.list.length

fn accepted(value Text) Url {
    match parse(value) {
        Result.Ok(url) => url
        Result.Err(_) => {
            assert false
            Url {
                secure = false
                host = ""
                port = 0
                authority = ""
                target = ""
                fragment = ""
            }
        }
    }
}

test fn urls_separate_connection_authority_target_and_local_fragment() {
    let url = accepted("HtTpS://EXAMPLE.com:00443/a%2Fb?name=x+y&next=/c??#local?x")
    assert url.secure && url.host == "example.com" && url.port == 443
    assert url.authority == "example.com"
    assert url.target == "/a%2Fb?name=x+y&next=/c??" && url.fragment == "local?x"
    assert accepted("http://example.com").target == "/"
    assert accepted("http://example.com?#").target == "/?"
    assert accepted("http://example.com#local").target == "/"
    assert accepted("http://example.com:").port == 80
    let numeric = accepted("http://127.0.0.1:08081/?q=%00")
    assert !numeric.secure && numeric.port == 8081 && numeric.authority == "127.0.0.1:8081"
    assert numeric.target == "/?q=%00"
}

test fn ipv6_authorities_keep_brackets_out_of_connection_hosts() {
    let inputs = ["::", "::1", "2001:DB8::1", "1:2:3:4:5:6:7:8", "::ffff:192.0.2.1", "1:2:3:4:5:6:192.0.2.1"]
    var index = 0
    while index < std.list.length(inputs) {
        let value = accepted(concat("https://[", concat(inputs[index], "]:8443/a")))
        assert value.host == lowercase(inputs[index]) && value.port == 8443
        assert value.authority == concat("[", concat(value.host, "]:8443"))
        index = index + 1
    }
    assert accepted("http://[::1]:80").authority == "[::1]"
}

test fn malformed_ambiguous_and_unsupported_urls_do_not_get_repaired() {
    let inputs = ["", "/relative", "//example.com/a", "ftp://example.com", "http:///a",
        "http://user:secret@example.com/", "http://example.com:65536/", "http://example.com:-1/",
        "http://example.com:+80/", "http://example.com:80:90/", "http://[::1]suffix/",
        "http://::1/", "http://[]/", "http://[:::1]/", "http://[1::2::3]/",
        "http://[1:2:3:4:5:6:7]/", "http://[1:2:3:4:5:6:7:8::]/", "http://[1:2:3:4:5:6:7:8:9]/",
        "http://[::ffff:192.0.2.256]/", "http://[::ffff:192.0.02.1]/", "http://[::ffff:192.0.2.1:2]/",
        "http://[fe80::1%25en0]/", "http://[v1.test]/", "http://%65xample.com/", "http://例子.test/",
        "http://example.com\\@other/", "http://example.com/a b", "http://example.com/\r\nX:bad",
        "http://example.com/%", "http://example.com/%2", "http://example.com/%zz", "http://example.com/?q=[x]",
        "http://example.com/#one#two", "http://example.com/#%", "http://example.com/\0"]
    var index = 0
    while index < std.list.length(inputs) {
        assert match parse(inputs[index]) {
            Result.Err(_) => true
            Result.Ok(_) => false
        }
        index = index + 1
    }
}

test fn url_parsing_uses_the_same_pure_rules_at_compile_time() {
    let parsed = comptime {
        parse("https://[2001:db8::1]:9443/a%2Fb?q=1#local")
    }
    assert match parsed {
        Result.Ok(value) => value.host == "2001:db8::1" && value.port == 9443 &&
        value.target == "/a%2Fb?q=1" && value.fragment == "local"
        Result.Err(_) => false
    }
}
