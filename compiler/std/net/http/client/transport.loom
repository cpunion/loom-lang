import std.stream.Stream
import std.net.tcp.Stream
import std.net.tls.Stream

enum Transport {
    Tcp(std.net.tcp.Stream)
    Tls(std.net.tls.Stream)
}

record Chunks {
    transport Transport
    ended List[Bool]
}

fn abort_transport(transport Transport) {
    match transport {
        Transport.Tcp(stream) => {
            discard std.net.tcp.abort(stream)
        }
        Transport.Tls(stream) => {
            discard std.net.tls.abort(stream)
        }
    }
}

async fn write_request(transport Transport, bytes Bytes) Result[Int, Error] {
    var success = false
    defer {
        if !success {
            abort_transport(transport)
        }
    }
    let outcome Result[Int, TransportError] = match transport {
        Transport.Tcp(stream) => match std.net.tcp.write_bytes(stream, bytes).await {
            Result.Ok(count) => Result.Ok(count)
            Result.Err(error) => Result.Err(TransportError.Tcp(error))
        }
        Transport.Tls(stream) => match std.net.tls.write_bytes(stream, bytes).await {
            Result.Ok(count) => Result.Ok(count)
            Result.Err(error) => Result.Err(TransportError.Tls(error))
        }
    }
    success = match outcome {
        Result.Ok(_) => true
        Result.Err(_) => false
    }
    match outcome {
        Result.Ok(count) => Result.Ok(count)
        Result.Err(error) => Result.Err(Error.Transport(error))
    }
}

impl std.stream.Stream for Chunks {
    type Item = Result[Bytes, TransportError]

    async fn next(self Chunks) Option[Result[Bytes, TransportError]] {
        if self.ended[0] {
            return Option.None
        }
        let bytes = std.bytes.new()
        let outcome Result[Int, TransportError] = match self.transport {
            Transport.Tcp(stream) => match std.net.tcp.read(stream, bytes, 16384).await {
                Result.Ok(count) => Result.Ok(count)
                Result.Err(error) => Result.Err(TransportError.Tcp(error))
            }
            Transport.Tls(stream) => match std.net.tls.read(stream, bytes, 16384).await {
                Result.Ok(count) => Result.Ok(count)
                Result.Err(error) => Result.Err(TransportError.Tls(error))
            }
        }
        match outcome {
            Result.Ok(count) => {
                if count == 0 {
                    self.ended[0] = true
                    return Option.None
                }
                Option.Some(Result.Ok(bytes))
            }
            Result.Err(error) => {
                self.ended[0] = true
                Option.Some(Result.Err(error))
            }
        }
    }
}

fn packet(value Result[Bytes, TransportError]) Result[Bytes, TransportError] {
    value
}

async fn transact[T](transport Transport, prepared Prepared[Bytes], handler fn(Incoming) Task[Result[T, Error]]) Result[T, Error] {
    let writing = fn(transport Transport) Task[Result[Int, Error]] {
        write_request(transport, prepared.payload)
    }
    transact[T, Error, Bytes](transport, prepared, writing, handler, client_error).await
}

fn client_error(error Error) Error {
    error
}

async fn transact[T, E, P](transport Transport, prepared Prepared[P], writer fn(Transport) Task[Result[Int, E]],
    handler fn(Incoming) Task[Result[T, Error]], failed fn(Error) E) Result[T, E] {
    // Read while uploading too: an early final response must not wait for a
    // peer that refuses the remaining request body to drain our send window.
    let writing = writer(transport)
    let response = handled_response[T, P](transport, prepared, handler).await
    match cancel(writing) {
        Outcome.Faulted(error) => {
            fault_text(error.message)
        }
        Outcome.Completed(Result.Err(error)) => match response {
            Result.Err(_) => {
                return Result.Err(error)
            }
            Result.Ok(_) => {
            }
        }
        _ => {
        }
    }
    match response {
        Result.Ok(value) => Result.Ok(value)
        Result.Err(error) => Result.Err(failed(error))
    }
}

async fn exchange[T](prepared Prepared[Bytes], handler fn(Incoming) Task[Result[T, Error]]) Result[T, Error] {
    let writing = fn(transport Transport) Task[Result[Int, Error]] {
        write_request(transport, prepared.payload)
    }
    exchange[T, Error, Bytes](prepared, writing, handler, client_error).await
}

async fn exchange[T, E, P](prepared Prepared[P], writer fn(Transport) Task[Result[Int, E]],
    handler fn(Incoming) Task[Result[T, Error]], failed fn(Error) E) Result[T, E] {
    if prepared.endpoint.secure {
        scoped acquired = match std.net.tls.open(prepared.endpoint.host, prepared.endpoint.port, prepared.tls).await {
            Result.Ok(value) => value
            Result.Err(error) => {
                return Result.Err(failed(Error.Transport(TransportError.Tls(error))))
            }
        }
        let stream = match std.net.tls.detach(acquired) {
            Result.Ok(value) => value
            Result.Err(error) => {
                return Result.Err(failed(Error.Transport(TransportError.Tls(error))))
            }
        }
        defer {
            discard std.net.tls.close(stream)
        }
        match std.net.tls.protocol(stream) {
            Result.Ok(Option.None) => {
            }
            Result.Ok(Option.Some(value)) => {
                if value != "http/1.1" {
                    return Result.Err(failed(Error.Unsupported))
                }
            }
            Result.Err(error) => {
                return Result.Err(failed(Error.Transport(TransportError.Tls(error))))
            }
        }
        transact[T, E, P](Transport.Tls(stream), prepared, writer, handler, failed).await
    } else {
        scoped acquired = match std.net.tcp.open(prepared.endpoint.host, prepared.endpoint.port).await {
            Result.Ok(value) => value
            Result.Err(error) => {
                return Result.Err(failed(Error.Transport(TransportError.Tcp(error))))
            }
        }
        let stream = match std.net.tcp.detach(acquired) {
            Result.Ok(value) => value
            Result.Err(error) => {
                return Result.Err(failed(Error.Transport(TransportError.Tcp(error))))
            }
        }
        defer {
            discard close_stream(stream)
        }
        transact[T, E, P](Transport.Tcp(stream), prepared, writer, handler, failed).await
    }
}
