import std.reflect.from_fields
import std.int.parse
import std.float.parse
import std.meta.refinement_base
import std.reflect.predicates.implies

pub enum DecodeError {
    Syntax(ParseError)
    TypeMismatch
    InvalidNumber
    FieldCount
    MissingField(Text)
    UnsupportedType
    DepthExceeded
    Rejected
}

fn object_field(fields List[(Text, Value)], name Text) Result[Value, DecodeError] {
    var index = 0
    while index < std.list.length(fields) {
        let field = get(fields, index)
        if field.0 == name {
            return Result.Ok(field.1)
        }
        index = index + 1
    }
    Result.Err(DecodeError.MissingField(name))
}

fn decode_number(raw Text) Result[Text, DecodeError] {
    match number_end(raw, 0) {
        Result.Ok(end) => {
            if end == std.text.length(raw) {
                return Result.Ok(raw)
            }
        }
        Result.Err(_) => {
        }
    }
    Result.Err(DecodeError.InvalidNumber)
}

concept JsonListShape {
    type Element
}

impl[Item] JsonListShape for List[Item] {
    type Element = Item
}

fn decoding_base[T]() Bool {
    let kind = describe[T]().types[0].kind
    T == Value || kind == Kind.Bool || kind == Kind.Int || kind == Kind.Float ||
    kind == Kind.Text || kind == Kind.Tuple || kind == Kind.Record
}

// Construct a refined List before publishing its fresh header. Returning a raw
// List through another helper first would lose that unpublished-storage fact.
fn decode_items[Shape JsonListShape, Output](value Value, depth Int) Result[Output, DecodeError] {
    comptime if Shape == List[Shape.Element] {
        if depth >= 64 {
            return Result.Err(DecodeError.DepthExceeded)
        }
        return match value {
            Value.Array(items) => {
                let output = std.list.new[Shape.Element]()
                var index = 0
                while index < std.list.length(items) {
                    std.list.push(output, decode_value[Shape.Element](get(items, index), depth + 1)?)
                    index = index + 1
                }
                comptime if Output == Shape {
                    Result.Ok(output)
                } else {
                    comptime if implies[Shape, Output]() {
                        Result.Ok(Output(output))
                    } else {
                        match Output(output) {
                            Result.Ok(accepted) => Result.Ok(accepted)
                            Result.Err(_) => Result.Err(DecodeError.Rejected)
                        }
                    }
                }
            }
            _ => Result.Err(DecodeError.TypeMismatch)
        }
    }
    Result.Err(DecodeError.UnsupportedType)
}

fn decode_value[T](value Value, depth Int) Result[T, DecodeError] {
    comptime if T == Value {
        return Result.Ok(value)
    }
    comptime if describe[T]().types[0].kind == Kind.Refined {
        let Base = comptime {
            match refinement_base[T]() {
                Option.Some(base) => base
                Option.None => T
            }
        }
        comptime if Base != T {
            comptime if Base implements JsonListShape {
                return decode_items[Base, T](value, depth)
            } else {
                comptime if decoding_base[Base]() {
                    let decoded = decode_value[Base](value, depth)?
                    comptime if implies[Base, T]() {
                        return Result.Ok(T(decoded))
                    } else {
                        return match T(decoded) {
                            Result.Ok(accepted) => Result.Ok(accepted)
                            Result.Err(_) => Result.Err(DecodeError.Rejected)
                        }
                    }
                }
            }
        }
        return Result.Err(DecodeError.UnsupportedType)
    }
    comptime if T == Bool {
        return match value {
            Value.Boolean(flag) => Result.Ok(flag)
            _ => Result.Err(DecodeError.TypeMismatch)
        }
    }
    comptime if T == Int {
        return match value {
            Value.Number(raw) => match std.int.parse(decode_number(raw)?) {
                Result.Ok(number) => Result.Ok(number)
                Result.Err(_) => Result.Err(DecodeError.InvalidNumber)
            }
            _ => Result.Err(DecodeError.TypeMismatch)
        }
    }
    comptime if T == Float {
        return match value {
            Value.Number(raw) => match std.float.parse(decode_number(raw)?) {
                Result.Ok(number) => {
                    if !is_finite(number) {
                        return Result.Err(DecodeError.InvalidNumber)
                    }
                    Result.Ok(number)
                }
                Result.Err(_) => Result.Err(DecodeError.InvalidNumber)
            }
            _ => Result.Err(DecodeError.TypeMismatch)
        }
    }
    comptime if T == Text {
        return match value {
            Value.String(text) => Result.Ok(text)
            _ => Result.Err(DecodeError.TypeMismatch)
        }
    }
    comptime if T implements JsonListShape {
        return decode_items[T, T](value, depth)
    }
    comptime if describe[T]().types[0].kind == Kind.Tuple {
        if depth >= 64 {
            return Result.Err(DecodeError.DepthExceeded)
        }
        return match value {
            Value.Array(items) => {
                let count = comptime {
                    std.list.length(describe[T]().types[0].arguments)
                }
                if std.list.length(items) != count {
                    return Result.Err(DecodeError.FieldCount)
                }
                let fields = comptime map index, Field in T {
                    decode_value[Field](get(items, index), depth + 1)?
                }
                Result.Ok(fields)
            }
            _ => Result.Err(DecodeError.TypeMismatch)
        }
    }
    comptime if describe[T]().types[0].kind == Kind.Record {
        if depth >= 64 {
            return Result.Err(DecodeError.DepthExceeded)
        }
        return match value {
            Value.Object(items) => {
                let count = comptime {
                    std.list.length(describe[T]().types[0].fields)
                }
                if std.list.length(items) != count {
                    return Result.Err(DecodeError.FieldCount)
                }
                let fields = comptime map name, Field in T {
                    decode_value[Field](object_field(items, name)?, depth + 1)?
                }
                let assembled T = from_fields(fields)
                Result.Ok(assembled)
            }
            _ => Result.Err(DecodeError.TypeMismatch)
        }
    }
    Result.Err(DecodeError.UnsupportedType)
}

// Convert an existing tree without serializing/reparsing it. Construction uses
// the same visible shapes as decode; mutable recursive inputs stay bounded.
pub fn from_value[T](value Value) Result[T, DecodeError] {
    decode_value[T](value, 0)
}

// Exact visible shapes with checked refinements; no implicit enum/null policy.
// Parse first so duplicate keys, number syntax and nesting have one definition.
pub fn decode[T](input Text) Result[T, DecodeError] {
    let value = match std.json.parse(input) {
        Result.Ok(parsed) => parsed
        Result.Err(problem) => {
            return Result.Err(DecodeError.Syntax(problem))
        }
    }
    from_value[T](value)
}
