import std.json.encoder
import std.json.next
import std.json.WriteError
import std.bytes.length
import std.text.to_bytes

pub enum OutputError[E] {
    Sink(E)
    Encoding(WriteError)
    Count(Int, Int)
}

fn checked_write[E](expected Int, outcome Result[Int, E]) Result[Int, OutputError[E]] {
    let written = match outcome {
        Result.Ok(value) => value
        Result.Err(failed) => {
            return Result.Err(OutputError.Sink(failed))
        }
    }
    if written != expected {
        return Result.Err(OutputError.Count(expected, written))
    }
    Result.Ok(written)
}

// The sink must finish writing each chunk or report an error. A mismatched
// count is explicit, never silently dropped or retried as if no bytes escaped.
pub async fn write[T, E](value T, chunk_size Int, sink fn(Bytes) Task[Result[Int, E]])
Result[Int, OutputError[E]]
requires chunk_size > 0
{
    let cursor = encoder(value, chunk_size)
    var count = 0
    while true {
        match std.json.next(cursor) {
            Option.None => {
                break
            }
            Option.Some(Result.Err(failed)) => {
                return Result.Err(OutputError.Encoding(failed))
            }
            Option.Some(Result.Ok(chunk)) => {
                // Snapshot the size before the sink can modify its input.
                let expected = std.bytes.length(chunk)
                count = count + checked_write(expected, sink(chunk).await)?
            }
        }
    }
    Result.Ok(count)
}

// Finish each document and its LF before requesting another producer item.
// Errors and cancellation leave emitted bytes intact and never retry a record.
pub async fn write_lines[S Stream, E](source S, chunk_size Int,
    sink fn(Bytes) Task[Result[Int, E]]) Result[Int, OutputError[E]]
requires chunk_size > 0
{
    var count = 0
    while true {
        match source.next().await {
            Option.None => {
                return Result.Ok(count)
            }
            Option.Some(value) => {
                count = count + write[S.Item, E](value, chunk_size, sink).await?
                count = count + checked_write[E](1, sink(std.text.to_bytes("\n")).await)?
            }
        }
    }
    Result.Ok(count)
}
