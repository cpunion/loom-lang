import std.bytes.set
import std.bytes.length
import std.task.worker.run

test fn utf8_bytes_and_concatenation() {
    assert length("hé") == 3
    assert byte("hé", 0) == 104
    assert byte("hé", 1) == 195
    assert byte("hé", 2) == 169
    assert concat("lo", "om") == "loom"
    assert concat("", "hé") == "hé"
    assert concat("a", "b") != "ba"
}

test fn scalar_operations() {
    let text = "Aé中😀"
    assert width(text, 0) == 1
    assert width(text, 1) == 2
    assert width(text, 3) == 3
    assert width(text, 6) == 4
    assert codepoint(text, 0) == 65
    assert codepoint(text, 1) == 233
    assert codepoint(text, 3) == 20013
    assert codepoint(text, 6) == 128512
    assert from_codepoint(65) == "A"
    assert from_codepoint(233) == "é"
    assert from_codepoint(20013) == "中"
    assert from_codepoint(128512) == "😀"
    assert from_codepoint(1114111) == "\u{10ffff}"
    assert from_codepoint(0) == "\0"
    assert slice(text, 1, 6) == "é中"
    assert slice(text, 10, 10) == ""
}

test fn utf8_encoding_is_an_isolated_mutable_copy() {
    let text = "Aé中😀\0"
    let first = to_bytes(text)
    let second = to_bytes(text)
    assert std.bytes.length(first) == length(text) && std.bytes.length(second) == length(text)
    assert std.bytes.to_text(first) == text
    std.bytes.set(first, 0, 66)
    assert text == "Aé中😀\0"
    assert std.bytes.to_text(second) == text
    assert std.bytes.to_text(first) == "Bé中😀\0"
    assert std.bytes.length(to_bytes("")) == 0
    assert std.bytes.to_text(comptime {
            to_bytes("é\0")
        }) == "é\0"
}

test async fn immutable_text_encoding_contracts_hold_in_shared_worker_builds() {
    let bytes = run(fn() Bytes {
            to_bytes("é😀")
        }).await
    assert std.bytes.length(bytes) == 6
}

type SixBytes = Text where length(self) == 6

fn six_byte_join(first Text, second Text) SixBytes
requires length(first) == 2 && length(second) == 4
{
    SixBytes(concat(first, second))
}

fn six_byte_slice(value Text, start Int, end Int) SixBytes
requires end - start == 6
{
    SixBytes(slice(value, start, end))
}

test async fn library_text_contracts_construct_refinements_in_ctfe_and_workers() {
    assert six_byte_join("é", "😀") == "é😀"
    assert six_byte_slice("Aé😀Z", 1, 7) == "é😀"
    let constant = comptime {
        six_byte_slice(six_byte_join("é", "😀"), 0, 6)
    }
    assert constant == "é😀"
    let shared = run(fn() SixBytes {
            six_byte_join("é", "😀")
        }).await
    assert shared == "é😀"
}

test fn scalar_boundaries_include_endpoints_and_reject_continuation_bytes() {
    let text = "Aé中😀"
    let boundaries = [true, true, false, true, false, false, true, false, false, false, true]
    var offset = 0
    while offset < std.list.length(boundaries) {
        assert is_boundary(text, offset) == std.list.get(boundaries, offset)
        offset = offset + 1
    }
    assert !is_boundary(text, -1) && !is_boundary(text, 11)
    assert is_boundary("", 0) && !is_boundary("", 1)
    assert comptime {
        is_boundary("é😀", 2) && !is_boundary("é😀", 1)
    }
}
