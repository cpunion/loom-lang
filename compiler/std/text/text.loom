import std.bytes.new
import std.bytes.push
import std.bytes.to_text

intrinsic fn text_len(value Text) Int
intrinsic fn text_byte(value Text, index Int) Int
intrinsic fn text_concat(a Text, b Text) Text
intrinsic fn text_slice(value Text, start Int, end Int) Text

// Text is immutable UTF-8. Length and indexing count bytes.
pub fn length(value Text) Int {
    text_len(value)
}

pub fn byte(value Text, index Int) Int {
    text_byte(value, index)
}

pub fn concat(a Text, b Text) Text {
    text_concat(a, b)
}

// Bounds are byte offsets and must both be UTF-8 scalar boundaries.
pub fn slice(value Text, start Int, end Int) Text {
    text_slice(value, start, end)
}

// The input Text is valid UTF-8; offset must point at a scalar's first byte.
pub fn width(value Text, offset Int) Int {
    let first = byte(value, offset)
    assert first < 128 || first >= 192
    if first < 128 { return 1 }
    if first < 224 { return 2 }
    if first < 240 { return 3 }
    4
}

pub fn codepoint(value Text, offset Int) Int {
    let size = width(value, offset)
    let first = byte(value, offset)
    if size == 1 { return first }
    var scalar = first % (if size == 2 { 32 } else { if size == 3 { 16 } else { 8 } })
    var index = 1
    while index < size {
        scalar = scalar * 64 + byte(value, offset + index) % 64
        index = index + 1
    }
    scalar
}

pub fn from_codepoint(value Int) Text
requires value >= 0 && value <= 1114111
requires value < 55296 || value > 57343
{
    let buffer = new()
    if value < 128 {
        push(buffer, value)
    } else {
        if value < 2048 {
            push(buffer, 192 + value / 64)
        } else {
            if value < 65536 {
                push(buffer, 224 + value / 4096)
            } else {
                push(buffer, 240 + value / 262144)
                push(buffer, 128 + value / 4096 % 64)
            }
            push(buffer, 128 + value / 64 % 64)
        }
        push(buffer, 128 + value % 64)
    }
    to_text(buffer)
}
