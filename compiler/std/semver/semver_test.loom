fn version(text Text) Version {
    match parse_version(text) {
        Result.Ok(value) => value,
        Result.Err(_) => {
            assert false
            Version {
                major = "0"
                minor = "0"
                patch = "0"
                prerelease = ""
                metadata = ""
            }
        }
    }
}

fn accepts_text(range Text, text Text) Bool {
    match requirement(range) {
        Result.Ok(value) => matches(value, version(text)),
        Result.Err(_) => {
            assert false
            false
        }
    }
}

test fn semver_precedence_and_unbounded_numeric_components() {
    let ordered = ["1.0.0-alpha", "1.0.0-alpha.1", "1.0.0-alpha.beta", "1.0.0-beta", "1.0.0-beta.2", "1.0.0-beta.11", "1.0.0-rc.1", "1.0.0", "1.10.0", "2.0.0", "999999999999999999999999999999.0.0"]
    var index = 1
    while index < length(ordered) {
        assert compare(version(get(ordered, index - 1)), version(get(ordered, index))) < 0
        index = index + 1
    }
    assert compare(version("1.2.3+001"), version("1.2.3+other")) == 0
    let invalid = ["", "v1.2.3", "1.2", "01.2.3", "1.2.03", "1.2.3-01", "1.2.3-", "1.2.3+", "1.2.3-a..b", "1.2.3+two+three", "1.2.3\n", "1.2.3-α"]
    index = 0
    while index < length(invalid) {
        assert match parse_version(get(invalid, index)) {
            Result.Err(_) => true,
            Result.Ok(_) => false
        }
        index = index + 1
    }
}

test fn ranges_zero_major_and_prerelease_opt_in() {
    assert accepts_text("^1.2", "1.9.0") && !accepts_text("^1.2", "2.0.0")
    assert accepts_text("0.2.3", "0.2.9") && !accepts_text("0.2.3", "0.3.0")
    assert accepts_text("^0.0.3", "0.0.3") && !accepts_text("^0.0.3", "0.0.4")
    assert accepts_text("^0", "0.9.0") && accepts_text("^0.0", "0.0.9")
    assert accepts_text("~1.2", "1.2.99") && !accepts_text("~1.2", "1.3.0")
    assert accepts_text("~1", "1.9.0") && !accepts_text("~1", "2.0.0")
    assert accepts_text("1.*", "1.9.9") && accepts_text("1.2.x", "1.2.99")
    assert !accepts_text("1.2.*", "1.3.0") && accepts_text("*", "99.0.0")
    assert !accepts_text("*", "1.2.3-alpha")
    assert accepts_text(">=1.2.3-alpha, <2.0.0", "1.2.3-beta")
    assert !accepts_text(">=1.2.3-alpha, <2.0.0", "1.3.0-beta")
    assert accepts_text("=1.2.3", "1.2.3+build") && !accepts_text("=1.2.3", "1.2.4")
    assert accepts_text(">1.2.3, <=1.4.0", "1.3.0") && !accepts_text(">1.2.3, <=1.4.0", "1.2.3")
    let invalid = ["", "^", "1.2.3,", ">=1.2", "=1", "1.2.*.4", "^1.*", "1 || 2", "1.2 - 1.4", "*.*", "01.2"]
    var index = 0
    while index < length(invalid) {
        assert match requirement(get(invalid, index)) {
            Result.Err(_) => true,
            Result.Ok(_) => false
        }
        index = index + 1
    }
}
