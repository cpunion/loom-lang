import std.option.Option
import std.result.Result
import std.bytes.new
import std.bytes.to_text

intrinsic fn env_get(name Text, output Bytes) Int

pub enum EnvError { InvalidName Utf8 }

// Reads a fresh UTF-8 copy. Some("") is distinct from an absent variable.
// Names must be nonempty and contain neither '=' nor NUL. Errors carry no
// environment contents, and this external read is unavailable at compile time.
pub fn get(name Text) Result[Option[Text], EnvError] {
    let buffer = new()
    let status = env_get(name, buffer)
    if status == 0 { return Result.Ok(Option.Some(to_text(buffer))) }
    if status == 1 { return Result.Ok(Option.None) }
    Result.Err(if status == -1 { EnvError.InvalidName } else { EnvError.Utf8 })
}
