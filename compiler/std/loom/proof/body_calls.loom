// Remap checked locals into a nested invocation, not function/observation IDs.
// Unsupported alternatives must reject rather than disappear during remapping.
fn call_body_at(value Expr, offset Int, depth Int) Result[Expr, Text] {
    if depth <= 0 {
        return Result.Err("source helper proof body depth exhausted")
    }
    let children = new[Expr]()
    var index = 0
    while index < length(value.children) {
        push(children, call_body_at(get(value.children, index), offset, depth - 1)?)
        index = index + 1
    }
    let arms = new[Arm]()
    index = 0
    while index < length(value.arms) {
        let arm = get(value.arms, index)
        let bindings = new[Int]()
        var field = 0
        while field < length(arm.bindings) {
            let local = get(arm.bindings, field)
            push(bindings, if local < 0 {
                    -1
                } else {
                    local + offset
                })
            field = field + 1
        }
        let body = new[Expr]()
        field = 0
        while field < length(arm.body) {
            push(body, call_body_at(get(arm.body, field), offset, depth - 1)?)
            field = field + 1
        }
        push(arms, Arm {
                variant = arm.variant
                bindings = bindings
                whole = if arm.whole < 0 {
                    -1
                } else {
                    arm.whole + offset
                }
                body = body
            })
        index = index + 1
    }
    let local = value.kind == ExprKind.Local || value.kind == ExprKind.Let ||
    value.kind == ExprKind.Assign || value.kind == ExprKind.ResourceDrain
    Result.Ok(Expr {
            kind = value.kind
            ty = value.ty
            span = value.span
            text = value.text
            index = if local {
                value.index + offset
            } else {
                value.index
            }
            children = children
            arms = arms
            falls = value.falls
        })
}

fn inference_frame(proof Verification, query ProofQuery) Verification {
    Verification {
        function = proof.function
        program = proof.program
        fresh = proof.fresh
        budget = proof.budget
        loop_control = Option.None
        query = query
        shared = proof.shared
        preservation = proof.preservation
        body_calls = proof.body_calls
        capture_returns = false
        returns = new[Outcome]()
    }
}

// Optional body evidence commits obligations only after every path succeeds.
// Unknown effects fall back at the caller, never to a partially inferred state.
// Fresh identities and the shared work budget are not rewound on failure.
fn inferred_body_call(proof Verification, target Int, function Function, input CallArguments,
    completion Bool, depth Int) Result[List[Outcome], Text] {
    let candidate = inference_frame(proof, proof_query(proof.query.backend))
    let completed = source_body_call(candidate, target, function, input, completion, depth)?
    var index = 0
    while index < length(candidate.query.obligations) {
        push(proof.query.obligations, get(candidate.query.obligations, index))
        index = index + 1
    }
    Result.Ok(completed)
}

// Ordinary helper calls and continuing-invariant checks share one symbolic
// call frame. Inputs already ran once. This executes checked source effects,
// not runtime code or a new evaluator; budgets and unknown operations still fail.
fn source_body_call(proof Verification, target Int, function Function, input CallArguments,
    completion Bool, depth Int) Result[List[Outcome], Text] {
    discard loop_step(proof)?
    if depth <= 0 || function.runtime_name != "" || function.is_async != completion ||
    function.body.kind == ExprKind.Deferred || length(function.params) != length(input.values) {
        return Result.Err("body proof needs a finite checked source body")
    }
    if length(proof.body_calls) >= 32 {
        return Result.Err("source helper call depth budget exhausted")
    }
    var active = 0
    while active < length(proof.body_calls) {
        if get(proof.body_calls, active) == target {
            return Result.Err("recursive source helper proof is unsupported")
        }
        active = active + 1
    }
    let calls = std.list.clone(proof.body_calls)
    push(calls, target)
    let boundary = length(input.state.locals)
    let values = new[Value]()
    let locals = new[Local]()
    var index = 0
    while index < boundary {
        push(locals, if index < length(proof.function.locals) {
                get(proof.function.locals, index)
            } else {
                Local {
                    name = ""
                    ty = 0
                    mutable = false
                    is_scoped = false
                }
            })
        index = index + 1
    }
    index = 0
    while index < length(function.locals) {
        push(locals, get(function.locals, index))
        push(values, if index < length(input.values) {
                get(input.values, index)
            } else {
                Value.Empty
            })
        index = index + 1
    }
    let preconditions = new[Expr]()
    index = 0
    while index < length(function.preconditions) {
        push(preconditions, call_body_at(get(function.preconditions, index), boundary, 256)?)
        index = index + 1
    }
    let scope = expanded_contracts(proof.program, Function {
            is_async = function.is_async
            symbol = function.symbol
            arguments = function.arguments
            params = new[Int]()
            result = function.result
            locals = locals
            preconditions = preconditions
            postconditions = new[Expr]()
            result_cleanup = new[Expr]()
            result_local = -1
            body = call_body_at(function.body, boundary, 256)?
            runtime_name = ""
            span = function.span
        }, proof.fresh)?
    let frame = Verification {
        function = scope
        program = proof.program
        fresh = proof.fresh
        budget = proof.budget
        loop_control = Option.None
        query = proof.query
        shared = proof.shared
        preservation = proof.preservation
        body_calls = calls
        capture_returns = true
        returns = new[Outcome]()
    }
    var state = call_scope(input.state, values)
    index = 0
    while index < length(function.params) {
        state = typed_value_state(frame, get(function.params, index), get(input.values, index), state)
        index = index + 1
    }
    let entries = established_entry(frame, state)?
    index = 0
    while index < length(entries) {
        discard append(frame.returns, execute(frame, scope.body, get(entries, index).state, depth - 1)?)?
        index = index + 1
    }
    let output = new[Outcome]()
    index = 0
    while index < length(frame.returns) {
        let returned = get(frame.returns, index)
        discard add_outcome(output, Outcome {
                state = caller_state(returned.state, boundary)
                value = returned.value
            })?
        index = index + 1
    }
    Result.Ok(output)
}
