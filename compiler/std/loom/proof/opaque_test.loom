test fn opaque_frames_require_real_unpublished_allocations() {
    let initial = State {
        locals = []
        facts = []
        extents = []
        observations = []
    }
    let state = with_extent(10, constant(integer(1)), true, initial)
    let extent = match list_state(10, state) {
        Result.Ok(extent) => extent
        Result.Err(_) => {
            assert false
            return
        }
    }
    assert opaque_frame(Value.Opaque(10, []), extent)
    assert !opaque_frame(Value.Opaque(11, []), extent)
    assert opaque_frame(Value.Opaque(-1, [10]), extent)
    assert !opaque_frame(Value.Opaque(-1, [10]), private_extent(extent, false))
    let unknown = with_extent(10, constant(integer(1)), false, initial)
    assert match list_state(10, unknown) {
        Result.Ok(extent) => !opaque_frame(Value.Opaque(0, [10]), extent)
        Result.Err(_) => false
    }
    // Widening a loop local must erase both entry-time and call-result facts.
    assert !opaque_frame(loop_opaque_head(Value.Opaque(0, [10])), extent)
    assert match loop_header_at(loop_opaque_head(Value.Opaque(0, [])), [], 10, true, 0) {
        Result.Ok(value) => opaque_frame(value, extent)
        Result.Err(_) => false
    }
    assert match opaque_completion(Value.Opaque(11, []), state, 11) {
        Value.Opaque(_, excluded) => storage_identity_member(excluded, 10)
        _ => false
    }
    assert match opaque_completion(Value.Opaque(11, []), published_storage(state), 11) {
        Value.Opaque(_, excluded) => length(excluded) == 0
        _ => false
    }
    // Symbolic sibling handles are not later allocations, whichever field
    // the result sampler visits first.
    let sibling = get(fresh_storage(Value.List(20), state).extents, 1)
    assert opaque_frame(Value.Opaque(20, []), sibling)
    assert !opaque_frame(opaque_completion(Value.Opaque(20, []), state, 21), sibling)
    let returned = completion_separation(Value.List(20), list_bounds(Value.List(20), state))
    assert match list_state(20, returned) {
        Result.Ok(root) => !extent_overlap(root, extent)
        Result.Err(_) => false
    }
    let later = list_bounds(Value.List(30), returned)
    assert match list_state(30, later) {
        Result.Ok(root) => extent_overlap(root, extent)
        Result.Err(_) => false
    }
    // Losing privacy never reconstructs an exclusion from an old result.
    assert match list_state(20, published_storage(returned)) {
        Result.Ok(root) => extent_overlap(root, private_extent(extent, false))
        Result.Err(_) => false
    }
}

test fn allocation_epochs_do_not_turn_sampled_headers_into_distinct_allocations() {
    var state = with_extent(10, constant(integer(1)), true, State {
            locals = [Value.List(20)]
            facts = []
            extents = []
            observations = []
        })
    state = list_bounds(Value.Record([Value.List(5), Value.List(20), Value.List(21)]), state)
    state = framed_completion_storage(Value.Record([Value.List(20), Value.List(21)]),
        storage_birth(20, 10, storage_birth(21, 10, state)))
    let original = get(state.extents, 0)
    let sampled = get(state.extents, 2)
    let sibling = get(state.extents, 3)
    assert sampled.birth_floor == 10 && !sampled.allocated
    assert extent_overlap(original, sampled) && extent_overlap(sampled, sibling)
    assert !extent_overlap(get(state.extents, 1), sampled)
    assert opaque_frame(Value.Opaque(10, []), sampled)
    assert !opaque_frame(Value.Opaque(11, []), sampled)
    assert !opaque_frame(Value.Opaque(10, []), private_extent(sampled, false))
    let proof = verification(fixture(literal("0"), [], literal("true")), empty_proof_program())
    let candidate = LoopCandidate.Born(0, [], 10)
    assert loop_candidate_preserved(proof, candidate, state)
    assert loop_header_count([candidate]) == 1
    assert !loop_candidate_preserved(proof, candidate, assigned(state, 0, Value.List(5)))
    assert match loop_birth_floor(0, [], 12, [Outcome {
                state = assigned(state, 0, Value.List(10))
                value = Value.Empty
            }]) {
        Result.Ok(floor) => floor == 10
        Result.Err(_) => false
    }
    assert match loop_birth_floor(0, [], 10, [Outcome {
                state = assigned(state, 0, Value.List(5))
                value = Value.Empty
            }]) {
        Result.Ok(floor) => floor == -1
        Result.Err(_) => false
    }
}
