fn list_operation(name Text) Bool {
    name == "list_new" || name == "list_new_capacity" || name == "list_len" || name == "list_get" ||
    name == "list_set" || name == "list_push" || name == "list_retain_range" ||
    name == "list_append" || name == "list_take" || name == "list_replace"
}

fn list_stored_index(name Text) Int {
    if name == "list_push" || name == "list_append" {
        1
    } else if name == "list_set" || name == "list_replace" {
        2
    } else {
        -1
    }
}

fn list_mutation(name Text) Bool {
    list_stored_index(name) >= 0 || name == "list_take"
}

// Recognize an ordinary forwarding body by checked structure, never its source
// name. No argument reordering, extra evaluation or entry checks may disappear.
fn forwarded_list_operation(functions List[Function], function Function, depth Int) Text {
    if depth >= 16 || function.is_async || length(function.preconditions) != 0 ||
    length(function.postconditions) != 0 {
        return ""
    }
    if list_operation(function.runtime_name) {
        return function.runtime_name
    }
    var body = function.body
    var wrappers = 0
    while wrappers < 16 && (body.kind == ExprKind.Block || body.kind == ExprKind.Return) &&
    length(body.children) == 1 {
        body = get(body.children, 0)
        wrappers = wrappers + 1
    }
    if body.kind != ExprKind.Call || body.index < 0 ||
    body.index >= length(functions) || length(body.children) != length(function.params) {
        return ""
    }
    var index = 0
    while index < length(body.children) {
        let argument = get(body.children, index)
        if argument.kind != ExprKind.Local || argument.index != index {
            return ""
        }
        index = index + 1
    }
    forwarded_list_operation(functions, get(functions, body.index), depth + 1)
}

// Classify one atomic store: 1 replaces an element, 2 appends. Ordinary
// argument-preserving forwarders count; source names grant no promise.
pub fn single_list_write(functions List[Function], value Expr) Int {
    if value.ty != 0 {
        return 0
    }
    let operation = if value.kind == ExprKind.Intrinsic {
        value.text
    } else if value.kind == ExprKind.Call && value.index >= 0 &&
    value.index < length(functions) {
        forwarded_list_operation(functions, get(functions, value.index), 0)
    } else {
        ""
    }
    if operation == "list_set" && length(value.children) == 3 {
        1
    } else if operation == "list_push" && length(value.children) == 2 {
        2
    } else {
        0
    }
}

fn list_operation_outcomes(proof Verification, name Text, ty Int, receiver_type Int, inputs CallArguments) Result[List[Outcome], Text] {
    var state = inputs.state
    if name == "list_retain_range" && length(inputs.values) == 4 {
        let start = list_value_index(get(inputs.values, 2))?
        let end = list_value_index(get(inputs.values, 3))?
        // Native range validation has succeeded on normal continuation. Its
        // registry can later append retained cells after another alias shrinks
        // the source. Do not grant private origin or a frame for that storage.
        state = forget_extents(proof, published_storage(state))
        state = assume(assume(state, Predicate.Compare(">=", start)),
            Predicate.Compare(">=", add(end, scale(start, integer(-1)))))
        return Result.Ok(outcomes(state, Value.Empty))
    }
    if length(inputs.values) > 0 {
        match get(inputs.values, 0) {
            Value.EntryList(size, _) => {
                if name == "list_get" && length(inputs.values) == 2 {
                    let index = list_value_index(get(inputs.values, 1))?
                    // These are established callee facts, not caller goals.
                    state = assume(assume(state, Predicate.Compare(">=", index)),
                        Predicate.Compare("<", add(index, scale(size, integer(-1)))))
                } else if name != "list_len" || length(inputs.values) != 1 {
                    return Result.Err("entry List values cannot be mutated")
                }
                let value = intrinsic_value(name, ty, inputs.values, state)?
                return Result.Ok(outcomes(bounded(value, state), value))
            }
            _ => {
            }
        }
    }
    let stored = list_stored_index(name)
    if stored >= 0 && stored < length(inputs.values) && mutable_value(get(inputs.values, stored)) {
        let private_target = match get(inputs.values, 0) {
            Value.List(identity) => match list_state(identity, state) {
                Result.Ok(extent) => extent.private_storage
                Result.Err(_) => false
            }
            _ => false
        }
        if !private_target {
            state = published_storage(state)
        }
    }
    state = interference(proof, state)
    if proof.shared && list_mutation(name) && length(proof.preservation) != 0 {
        // The continuing invariant is true immediately before this atomic
        // store. Argument values remain earlier snapshots: they do not recover
        // equality with cells another worker may have changed in the meantime.
        let atomic = preservation_snapshot(proof)
        let entries = established_conditions(atomic, proof.preservation, state)?
        let output = new[Outcome]()
        var path = 0
        while path < length(entries) {
            discard append(output, list_operation_outcomes(atomic, name, ty, receiver_type, CallArguments {
                        state = get(entries, path).state
                        values = inputs.values
                    })?)?
            path = path + 1
        }
        return Result.Ok(output)
    }
    if (name == "list_new" && length(inputs.values) == 0) ||
    (name == "list_new_capacity" && length(inputs.values) == 1) {
        let value = record_parameter_value(proof, ty, 0)
        return match value {
            Value.List(identity) => Result.Ok(outcomes(
                    with_extent(identity, constant(integer(0)), true, state), value))
            _ => Result.Err("List allocation proof requires a List result")
        }
    }
    if length(inputs.values) == 0 {
        return Result.Err("List operation proof requires a receiver")
    }
    let identity = match get(inputs.values, 0) {
        Value.List(identity) => identity
        _ => {
            return Result.Err("List operation proof requires a tracked handle")
        }
    }
    if stored >= 0 {
        state = array_contents(proof, identity, state)?
    }
    let size = list_extent(identity, state)?
    if name == "list_len" && length(inputs.values) == 1 {
        return Result.Ok(outcomes(state, Value.Number(size)))
    }
    if name == "list_take" && length(inputs.values) == 1 {
        return list_take_outcomes(proof, ty, receiver_type, identity, state)
    }
    if name == "list_replace" && length(inputs.values) == 3 {
        return list_replace_outcomes(proof, ty, receiver_type, identity, inputs.values, state)
    }
    if (name == "list_push" || name == "list_append") && length(inputs.values) == 2 {
        // Other handles may alias this receiver. Only exact handle copies keep
        // the precise update; every possibly overlapping extent is forgotten.
        let modified = new[Int]()
        push(modified, identity)
        let previous = list_state(identity, state)?
        let after = forget_modified_extents(proof, state, modified)
        let grown = with_extent(identity, add(size, constant(integer(1))), previous.allocated, after)
        let written = remember_element(identity, size, get(inputs.values, 1),
            with_cells(identity, previous.cells, grown))?
        return Result.Ok(outcomes(array_write(proof, previous, size, get(inputs.values, 1), written)?,
                if name == "list_append" {
                    Value.List(identity)
                } else {
                    Value.Empty
                }))
    }
    if (name == "list_get" && length(inputs.values) == 2) ||
    (name == "list_set" && length(inputs.values) == 3) {
        let index = match get(inputs.values, 1) {
            Value.Number(value) => value
            _ => {
                return Result.Err("List indexing proof requires an Int index")
            }
        }
        // Native bounds checks have succeeded on normal continuation. Reuse
        // established observations; an unknown read supplies an arbitrary value.
        state = assume(assume(state, Predicate.Compare(">=", index)),
            Predicate.Compare("<", add(index, scale(size, integer(-1)))))
        if name == "list_get" {
            return read_element_outcomes(proof, ty, identity, index, state)
        }
        return Result.Ok(outcomes(written_element(proof, identity, index, get(inputs.values, 2), state)?, Value.Empty))
    }
    Result.Err("unsupported List operation in required proof")
}

fn execute_list_operation(proof Verification, expr Expr, name Text, state State, depth Int) Result[List[Outcome], Text] {
    let inputs = call_arguments(proof, expr, state, depth)?
    let output = new[Outcome]()
    var index = 0
    while index < length(inputs) {
        let receiver_type = if length(expr.children) > 0 {
            get(expr.children, 0).ty
        } else {
            -1
        }
        let written = list_operation_outcomes(proof, name, expr.ty, receiver_type, get(inputs, index))?
        if length(proof.preservation) != 0 && list_mutation(name) {
            let atomic = preservation_snapshot(proof)
            var path = 0
            while path < length(written) {
                let state = required_conditions(atomic, proof.preservation, get(written, path).state)?
                let established = established_conditions(atomic, proof.preservation, state)?
                var branch = 0
                while branch < length(established) {
                    discard add_outcome(output, Outcome {
                            state = get(established, branch).state
                            value = get(written, path).value
                        })?
                    branch = branch + 1
                }
                path = path + 1
            }
        } else {
            discard append(output, written)?
        }
        index = index + 1
    }
    Result.Ok(output)
}
