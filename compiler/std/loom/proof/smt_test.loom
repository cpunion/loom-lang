import std.text.contains

fn encoding(obligations List[Obligation]) Text {
    match smt_query(obligations) {
        Result.Ok(query) => query
        Result.Err(_) => {
            assert false
            ""
        }
    }
}

test fn smt_encoding_keeps_exact_numbers_domains_and_one_counterexample() {
    assert smt_number(integer(-9223372036854775808)) == "(- 9223372036854775808)"
    assert smt_number(decimal("1000000000000000000000000007")) == "1000000000000000000000000007"
    assert smt_number(integer(0)) == "0"
    let query = encoding([Obligation {
                facts = [Predicate.Variable(7)]
                conclusion = Predicate.TextEqual(TextValue.Variable(7), TextValue.Literal("雪"))
            }])
    assert contains(query, "(declare-const b7 Bool)")
    assert contains(query, "(declare-const t7 (Seq (_ BitVec 8)))")
    assert contains(query, "(assert (= n7 (seq.len t7)))")
    assert contains(query, "(_ bv233 8)") && contains(query, "(_ bv155 8)") && contains(query, "(_ bv170 8)")
    assert encoding([Obligation {
                facts = []
                conclusion = Predicate.Constant(false)
            }]) == "(assert (not (and true (=> (and true) false))))\n(check-sat)\n"
}

fn failed_solver(context Text, query Text) Result[Bool, Text] {
    Result.Err("test backend failure")
}

test fn backend_failures_propagate_and_easy_or_unsupported_proofs_do_not_call_it() {
    let backend = ProofBackend {
        enabled = true
        context = ""
        solve = failed_solver
    }
    let x = local(0)
    let returned = local(1)
    assert match verify_with_types([], fixture(x, [], operation("==", returned, x)), backend) {
        Result.Ok(_) => true
        _ => false
    }
    assert match verify_with_types([], fixture(x, [], operation(">", returned, x)), backend) {
        Result.Err(message) => message == "test backend failure"
        _ => false
    }
    assert match verify_with_types([], fixture(literal("0"), [],
            operation(">", operation("/", x, literal("0")), x)), backend) {
        Result.Err(message) => message != "test backend failure"
        _ => false
    }
}

test fn optional_implication_retains_checks_when_the_backend_fails() {
    let backend = ProofBackend {
        enabled = true
        context = ""
        solve = failed_solver
    }
    let x = local(0)
    let positive = operation(">", x, literal("0"))
    assert implies(positive, operation(">=", x, literal("0")), backend)
    let unit_square = operation("==", operation("*", x, x), literal("1"))
    assert !implies(unit_square, positive, backend)
    assert !implies_facts([unit_square], operation("!=", x, literal("0")), backend)
    assert implies_facts([positive], operation(">=", x, literal("0")), backend)
}

test fn array_encoding_preserves_versions_indices_and_observation_guards() {
    let index = variable(1)
    let value = IntegerTerm.Linear(variable(2))
    let query = encoding([Obligation {
                facts = [Predicate.ArrayRead(10, [], index, ArrayScalar.Integer(value), [Predicate.Variable(3)]),
                    Predicate.ArrayWrite(10, 11, [], index, ArrayScalar.Integer(value))]
                conclusion = Predicate.IntegerCompare("==", IntegerTerm.Select(11, [], index), value)
            }])
    assert contains(query, "(declare-const a10 (Array Int Int))")
    assert contains(query, "(declare-const a11 (Array Int Int))")
    assert contains(query, "(=> b3 (= (select a10")
    assert contains(query, "(= a11 (store a10 (+ 0 (* 1 n1)) (+ 0 (* 1 n2))))")
    assert contains(query, "(= (select a11")
    assert !integer_interval("==", IntegerTerm.Select(11, [], index), value, [])
    assert immutable_snapshot(Value.Nonlinear(IntegerTerm.Select(11, [], index)))
}

test fn bounded_quantifiers_keep_their_binder_inside_the_range_and_body() {
    let query = encoding([Obligation {
                facts = []
                conclusion = Predicate.Forall(-7, constant(integer(0)), constant(integer(2)),
                    [Predicate.IntegerCompare(">=", IntegerTerm.Select(10, [], variable(-7)),
                            IntegerTerm.Linear(constant(integer(0))))])
            }])
    assert contains(query, "(forall ((n-7 Int)) (=> (and (<= (+ 0) n-7) (< n-7 (+ 2))) ")
    assert contains(query, "(select a10 (+ 0 (* 1 n-7)))")
}

test fn projected_arrays_keep_nested_fields_distinct_from_elements_and_each_other() {
    let index = variable(1)
    let value = IntegerTerm.Linear(variable(2))
    let query = encoding([Obligation {
                facts = [Predicate.ArrayRead(10, [1, 23], index, ArrayScalar.Integer(value), [Predicate.Variable(3)]),
                    Predicate.ArrayWrite(10, 11, [1, 23], index, ArrayScalar.Integer(value))]
                conclusion = Predicate.IntegerCompare("==", IntegerTerm.Select(11, [12, 3], index), value)
            }])
    assert contains(query, "(declare-const a10_f1_f23 (Array Int Int))")
    assert contains(query, "(declare-const a11_f1_f23 (Array Int Int))")
    assert contains(query, "(declare-const a11_f12_f3 (Array Int Int))")
    assert !contains(query, "(declare-const a11 (Array Int Int))")
    let first = IntegerTerm.Select(11, [1, 23], index)
    let second = IntegerTerm.Select(11, [12, 3], index)
    assert !same_integer_term(first, second, [512])
    assert !immutable_snapshot(Value.Projected(11, [1], index))
    assert mutable_value(Value.Projected(11, [1], index))
    let equality = Predicate.IntegerCompare("==", first, IntegerTerm.Select(10, [1, 23], index))
    assert match pointwise_bag(Predicate.Forall(1, constant(integer(0)), variable(4), [equality])) {
        Option.None => true
        Option.Some(_) => false
    }
}

test fn scalar_columns_keep_their_sorts_and_float_storage_is_not_ieee_equality() {
    let index = variable(1)
    let label = TextValue.Select(10, [2], index)
    let negative_zero = ArrayScalar.Float(FloatValue.Literal("-0"))
    let query = encoding([Obligation {
                facts = [Predicate.ArrayRead(10, [0, 0], index, ArrayScalar.Boolean([Predicate.Variable(3)]),
                        [Predicate.Constant(true)]),
                    Predicate.ArrayWrite(10, 11, [0, 1], index, ArrayScalar.Boolean([Predicate.Constant(false)])),
                    Predicate.ArrayWrite(10, 11, [2], index, ArrayScalar.Text(TextValue.Literal("雪"))),
                    Predicate.ArrayWrite(10, 11, [3], index, negative_zero)]
                conclusion = Predicate.And([
                        Predicate.IntegerCompare(">", text_length(label), IntegerTerm.Linear(constant(integer(0)))),
                        Predicate.FloatCompare("==", FloatValue.Select(11, [3], index), FloatValue.Literal("-0"))])
            }])
    assert contains(query, "(declare-const a10_f0_f0_bool (Array Int Bool))")
    assert contains(query, "(declare-const a11_f0_f1_bool (Array Int Bool))")
    assert contains(query, "(declare-const a10_f2_text (Array Int (Seq (_ BitVec 8))))")
    assert contains(query, "(declare-const a11_f3_float (Array Int (_ FloatingPoint 11 53)))")
    assert contains(query, "(seq.len (select a10_f2_text")
    assert contains(query, "(= a11_f3_float (store a10_f3_float")
    assert contains(query, "(fp.eq (select a11_f3_float")
    assert contains(query, "(_ -zero 11 53)")
    assert !same_array_scalar(ArrayScalar.Boolean([Predicate.Constant(true)]),
        ArrayScalar.Integer(IntegerTerm.Linear(constant(integer(1)))))
    assert !same_array_scalar(negative_zero, ArrayScalar.Float(FloatValue.Literal("0")))
    assert text_size_defined(text_length(label), State {
            locals = []
            facts = []
            extents = []
            observations = []
        })
}

test fn tautological_quantifiers_do_not_repeat_the_context_or_assume_float_reflexivity() {
    let query = encoding([Obligation {
                facts = [Predicate.Variable(99)]
                conclusion = Predicate.Forall(-1, constant(integer(0)), constant(integer(10)),
                    [Predicate.Or([Predicate.Variable(1), Predicate.Constant(true)])])
            }])
    assert !contains(query, "b99") && !contains(query, "forall")
    assert contains(query, "(assert (not (and true)))")
    let ratio = FloatValue.Select(10, [2], variable(1))
    assert contains(encoding([Obligation {
                    facts = []
                    conclusion = Predicate.FloatCompare("==", ratio, ratio)
                }]), "fp.eq")
}

test fn pointwise_prefix_equality_supplies_only_the_matching_histogram_law() {
    let bound = variable(-7)
    let size = variable(4)
    let equal = Predicate.IntegerCompare("==", IntegerTerm.Select(10, [], bound), IntegerTerm.Select(11, [], bound))
    let prefix = Predicate.Forall(-7, constant(integer(0)), size, [equal])
    let bag = Predicate.BagEqual(10, size, 11, size)
    assert match pointwise_bag(prefix) {
        Option.Some(value) => same(value, bag)
        Option.None => false
    }
    assert match pointwise_bag(Predicate.Forall(-7, constant(integer(1)), size, [equal])) {
        Option.None => true
        _ => false
    }
    let shifted = Predicate.IntegerCompare("==", IntegerTerm.Select(10, [], bound),
        IntegerTerm.Select(11, [], add(bound, constant(integer(1)))))
    assert match pointwise_bag(Predicate.Forall(-7, constant(integer(0)), size, [shifted])) {
        Option.None => true
        _ => false
    }
    let query = encoding([Obligation {
                facts = [prefix]
                conclusion = bag
            }])
    assert contains(query, "(assert (=> (forall ((n-7 Int))")
    assert contains(query, "(= (loom_bag a10 (+ 0 (* 1 n4))) (loom_bag a11 (+ 0 (* 1 n4))))")
    assert !contains(encoding([Obligation {
                    facts = [prefix]
                    conclusion = prefix
                }]), "loom_bag")
}

test fn repeated_assumptions_keep_one_fact_and_all_derived_text_bounds() {
    let facts = new[Predicate]()
    let equal = Predicate.TextEqual(TextValue.Variable(1), TextValue.Variable(2))
    append_facts(facts, Predicate.And([equal, equal]))
    append_facts(facts, Predicate.Constant(true))
    assert length(facts) == 2
    assert same(get(facts, 0), equal)
    assert same(get(facts, 1), Predicate.Compare("==", add(variable(1), scale(variable(2), integer(-1)))))
    append_facts(facts, Predicate.Constant(false))
    assert length(facts) == 3 && holds(Predicate.Constant(false), facts)
}
