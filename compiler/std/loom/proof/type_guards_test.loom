test fn private_type_decisions_are_fresh_but_other_deferred_values_remain_unproved() {
    let guard = expression(ExprKind.Deferred, 2, "$typeguard", -1, [])
    let body = expression(ExprKind.If, 1, "", -1, [guard, literal("1"), literal("0")])
    assert verified(fixture(body, [], operation(">=", local(1), literal("0"))))
    let pending = expression(ExprKind.Deferred, 2, "comptime selection", -1, [])
    let unknown = expression(ExprKind.If, 1, "", -1, [pending, literal("1"), literal("0")])
    assert !verified(fixture(unknown, [], operation(">=", local(1), literal("0"))))
    let proof = verification(fixture(body, [], operation(">=", local(1), literal("0"))), empty_proof_program())
    let state = State {
        locals = []
        facts = []
        extents = []
        observations = []
    }
    let first = match execute(proof, guard, state, 16) {
        Result.Ok(values) => get(values, 0).value
        Result.Err(_) => {
            assert false
            Value.Empty
        }
    }
    let second = match execute(proof, guard, state, 16) {
        Result.Ok(values) => get(values, 0).value
        Result.Err(_) => {
            assert false
            Value.Empty
        }
    }
    assert !holds(match binary("==", first, second) {
            Result.Ok(value) => match value {
                Value.Boolean(fact) => fact
                _ => Predicate.Constant(true)
            }
            Result.Err(_) => Predicate.Constant(true)
        }, [])
}

test fn private_pack_entries_are_fresh_and_require_abstract_types() {
    let entry = expression(ExprKind.Deferred, 0, "$packentry", -1, [])
    let proof = verification(fixture(literal("0"), [], literal("true")),
        proof_program_with_types([publication_shape(TypeKind.Parameter, [])]))
    let state = State {
        locals = []
        facts = []
        extents = []
        observations = []
    }
    let before = get(proof.fresh, 0)
    var index = 0
    while index < 2 {
        assert match execute(proof, entry, state, 16) {
            Result.Ok(values) => match get(values, 0).value {
                Value.Opaque(frontier, excluded) => frontier == before + index && length(excluded) == 0
                _ => false
            }
            Result.Err(_) => false
        }
        index = index + 1
    }
    assert get(proof.fresh, 0) == before + 2
    let invalid = expression(ExprKind.Deferred, 1, "$packentry", -1, [])
    assert match execute(proof, invalid, state, 16) {
        Result.Err(_) => true
        Result.Ok(_) => false
    }
}
