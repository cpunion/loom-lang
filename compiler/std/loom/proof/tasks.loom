// A promise retains checked call identity and once-evaluated arguments. It is
// proof-only data: native coroutine frames and scheduling are unchanged.
fn task_reference(proof Verification, call Expr, state State, depth Int) Result[List[Outcome], Text] {
    if call.index < 0 || call.index >= length(proof.program.functions) {
        return Result.Err("task proof has no checked function instance")
    }
    if call.kind == ExprKind.TaskCall && !get(proof.program.functions, call.index).is_async {
        return Result.Err("task proof needs an async function")
    }
    let arguments = call_arguments(proof, call, state, depth)?
    let output = new[Outcome]()
    var index = 0
    while index < length(arguments) {
        let current = get(arguments, index)
        discard add_outcome(output, if call.kind == ExprKind.FunctionRef {
                Outcome {
                    state = current.state
                    value = Value.Function(call.index, current.values)
                }
            } else {
                created_task(proof, call.index, current.values, current.state)
            })?
        index = index + 1
    }
    Result.Ok(output)
}

fn suspension_state(proof Verification, state State) State {
    // Other ready Tasks can reach published aliases during suspension. Past
    // scalar reads, unpublished storage and validated invariants frame
    // current observations. Caller heap state is not an async callee's entry.
    interference(proof, state, true)
}

fn unknown_completion(proof Verification, source Expr, state State) Outcome {
    let value = record_parameter_value(proof, source.ty, 0)
    Outcome {
        state = typed_value_state(proof, source.ty, value, state)
        value = value
    }
}

fn task_operation(name Text) Bool {
    name == "task_observe" || name == "task_drain" || name == "fault_text" ||
    name == "task_ready_result" || name == "task_ready_outcome" || name == "task_cancel"
}

// These are checked runtime boundaries, not join-policy summaries. Registration
// returns the same typed handle; draining may run arbitrary child cleanup;
// fault_text has no normal continuation. Arguments still execute exactly once.
fn execute_task_operation(proof Verification, call Expr, name Text, state State,
    depth Int) Result[List[Outcome], Text] {
    let arguments = call_arguments(proof, call, state, depth)?
    let output = new[Outcome]()
    var index = 0
    while index < length(arguments) {
        let current = get(arguments, index)
        if name == "task_observe" && length(current.values) == 2 {
            discard add_outcome(output, Outcome {
                    state = interference(proof, current.state)
                    value = get(current.values, 0)
                })?
        } else if name == "task_drain" && length(current.values) == 2 {
            discard add_outcome(output, Outcome {
                    state = suspension_state(proof, current.state)
                    value = Value.Empty
                })?
        } else if (name == "task_ready_result" || name == "task_ready_outcome" ||
            name == "task_cancel") && length(current.values) == 1 {
            let entry = suspension_state(proof, current.state)
            let completed = if name == "task_ready_result" {
                promise_completion(proof, call, get(current.values, 0), entry, depth)?
            } else {
                outcome_completion(proof, call, get(current.values, 0), entry, depth)?
            }
            var path = 0
            while path < length(completed) {
                let returned = get(completed, path)
                discard add_outcome(output, Outcome {
                        state = suspension_state(proof, returned.state)
                        value = returned.value
                    })?
                path = path + 1
            }
        } else if name != "fault_text" || length(current.values) != 1 {
            return Result.Err("unsupported task proof operation")
        }
        index = index + 1
    }
    Result.Ok(output)
}

fn completion_body_call(proof Verification, target Int, function Function, input CallArguments,
    source Expr, fallback State, depth Int) Result[List[Outcome], Text] {
    match inferred_body_call(proof, target, function, input, true, depth) {
        Result.Ok(completed) => Result.Ok(completed)
        Result.Err(_) => {
            let unknown = unknown_completion(proof, source, fallback)
            Result.Ok(outcomes(unknown.state, unknown.value))
        }
    }
}

fn promise_completion(proof Verification, source Expr, promise Value, entry State,
    depth Int) Result[List[Outcome], Text] {
    match promise {
        Value.Task(target, values, entries) => {
            if target >= 0 && target < length(proof.program.functions) {
                let function = get(proof.program.functions, target)
                if function.result != source.ty || length(function.params) != length(values) {
                    return Result.Err("task proof has no matching completion signature")
                }
                let input = CallArguments {
                    state = restored_task_entry(entries, entry)
                    values = values
                }
                if length(function.postconditions) != 0 {
                    let call = proof_expr(source, ExprKind.Call, source.ty, "", target, new[Expr]())
                    return applied_call(proof, call, function, input, depth)
                }
                return completion_body_call(proof, target, function, input, source, entry, depth)
            }
        }
        _ => {
        }
    }
    let unknown = unknown_completion(proof, source, entry)
    Result.Ok(outcomes(unknown.state, unknown.value))
}

fn task_completion(proof Verification, expression Expr, state State, depth Int) Result[List[Outcome], Text] {
    let arguments = call_arguments(proof, expression, state, depth)?
    let output = new[Outcome]()
    var index = 0
    while index < length(arguments) {
        let current = get(arguments, index)
        let entry = suspension_state(proof, current.state)
        let promise = if expression.kind == ExprKind.Await && length(current.values) == 1 {
            get(current.values, 0)
        } else {
            Value.Empty
        }
        let completed = if expression.kind == ExprKind.Suspend && expression.text == "task_outcome" &&
        length(current.values) == 1 {
            outcome_completion(proof, expression, get(current.values, 0), entry, depth)?
        } else {
            promise_completion(proof, expression, promise, entry, depth)?
        }
        var path = 0
        while path < length(completed) {
            let returned = get(completed, path)
            // Another ready Task may change shared storage before the caller
            // observes it. Immutable results and terminal alternatives survive.
            discard add_outcome(output, Outcome {
                    state = suspension_state(proof, returned.state)
                    value = returned.value
                })?
            path = path + 1
        }
        index = index + 1
    }
    Result.Ok(output)
}

fn indirect_body_call(proof Verification, call Expr, state State, depth Int) Result[List[Outcome], Text] {
    let arguments = call_arguments(proof, call, state, depth)?
    let output = new[Outcome]()
    var index = 0
    while index < length(arguments) {
        let current = get(arguments, index)
        if length(current.values) == 0 {
            return Result.Err("indirect proof call has no function value")
        }
        match get(current.values, 0) {
            Value.Function(target, captures) => {
                if target < 0 || target >= length(proof.program.functions) {
                    return Result.Err("indirect proof call has no checked target")
                }
                let function = get(proof.program.functions, target)
                let inputs = clone(captures)
                var argument = 1
                while argument < length(current.values) {
                    push(inputs, get(current.values, argument))
                    argument = argument + 1
                }
                if length(inputs) != length(function.params) {
                    return Result.Err("indirect proof call has no matching signature")
                }
                if function.is_async {
                    discard add_outcome(output, created_task(proof, target, inputs, current.state))?
                } else {
                    let direct = proof_expr(call, ExprKind.Call, call.ty, "", target, new[Expr]())
                    discard append(output, applied_call(proof, direct, function, CallArguments {
                                state = current.state
                                values = inputs
                            }, depth)?)?
                }
            }
            _ => {
                // An unknown callback contributes only its checked output
                // type, not a guessed target or a hidden contract.
                discard add_outcome(output, unknown_completion(proof, call,
                        suspension_state(proof, published_storage(current.state))))?
            }
        }
        index = index + 1
    }
    Result.Ok(output)
}
