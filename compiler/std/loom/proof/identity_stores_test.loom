test fn identity_updates_compare_the_current_cell_not_a_previous_shared_read() {
    let program = atomic_pair_program()
    let locals = [Local {
            name = "values"
            ty = 7
            mutable = false
            is_scoped = false
        }]
    let receiver = get(atomic_pair_store("2", literal("0")).children, 0)
    let read = expression(ExprKind.Intrinsic, 1, "list_get", -1, [receiver, literal("0")])
    let operation = atomic_pair_store("2", read)
    assert match preserves_update_identity(program, locals, operation, no_proof_backend(), false) {
        Result.Ok(proved) => proved
        Result.Err(_) => false
    }
    assert match preserves_update_identity(program, locals, operation, no_proof_backend(), true) {
        Result.Ok(proved) => !proved
        Result.Err(_) => true
    }
    assert match preserves_update_identity(program, locals, atomic_pair_store("1", read), no_proof_backend(), false) {
        Result.Ok(proved) => !proved
        Result.Err(_) => true
    }
}

test fn identity_preservation_does_not_treat_every_allocation_as_private_scratch() {
    let program = atomic_pair_program()
    let receiver = expression(ExprKind.Local, 6, "", 0, [])
    let body = expression(ExprKind.Intrinsic, 0, "list_push", -1, [receiver, literal("7")])
    let function = contract_fixture([6], 0, body, [], [proof_bool(body, true)])
    assert match verify_preservation(program, function, no_proof_backend(), false, [], [0], []) {
        Result.Ok(proved) => proved
        Result.Err(_) => false
    }
    // This input is known allocated, not known unpublished. Neither a local
    // allocation label nor successful ordinary verification grants privacy.
    assert match verify_preservation(program, function, no_proof_backend(), false, [], [0], [], true) {
        Result.Err(_) => true
        Result.Ok(proved) => !proved
    }
}

test fn identity_stores_use_the_continuing_predicate_at_the_atomic_read() {
    let program = atomic_pair_program()
    let shape = get(program.types, 7)
    let predicate = get(shape.constraint, 0)
    let first = get(get(predicate.children, 1).children, 0)
    set(program.types, 7, Type {
            kind = shape.kind
            symbol = shape.symbol
            arguments = shape.arguments
            pack_widths = shape.pack_widths
            fields = shape.fields
            variants = shape.variants
            constraint = [operation("&&", get(predicate.children, 0), operation("==", first, literal("7")))]
        })
    let body = atomic_pair_store("2", literal("7"))
    let locals = contract_fixture([7], 0, body, [], []).locals
    assert match preserves_update_identity(program, locals, body, no_proof_backend(), true) {
        Result.Ok(proved) => proved
        Result.Err(_) => false
    }
    assert match preserves_update_identity(program, locals, atomic_pair_store("2", literal("8")), no_proof_backend(), true) {
        Result.Err(_) => true
        Result.Ok(proved) => !proved
    }
}

test fn stored_identity_is_not_ieee_equality_or_opaque_graph_provenance() {
    let proof = verification(contract_fixture([], 0, expression(ExprKind.Block, 0, "", -1, []), [], []), empty_proof_program())
    let nan = Value.Float(FloatValue.Literal("NaN"))
    let row = Value.Record([Value.Number(variable(1)), Value.Boolean(Predicate.Variable(2)),
            Value.Text(TextValue.Variable(3)), nan, Value.List(4)])
    assert match stored_identity(proof, row, row, 0) {
        Result.Ok(equal) => holds(equal, [])
        Result.Err(_) => false
    }
    assert match stored_identity(proof, nan, nan, 0) {
        Result.Ok(equal) => holds(equal, [])
        Result.Err(_) => false
    }
    assert match stored_identity(proof, Value.Float(FloatValue.Literal("0")), Value.Float(FloatValue.Literal("-0")), 0) {
        Result.Err(_) => true
        Result.Ok(equal) => !holds(equal, [])
    }
    let opaque = Value.Opaque(10, [])
    assert match stored_identity(proof, opaque, opaque, 0) {
        Result.Err(_) => true
        Result.Ok(_) => false
    }
}

test fn stored_float_identity_uses_ieee_values_without_collapsing_signed_zero() {
    let current = FloatValue.Variable(1)
    let replacement = FloatValue.Variable(2)
    let equal = match stored_float_identity(current, replacement) {
        Result.Ok(predicate) => predicate
        Result.Err(_) => {
            assert false
            return
        }
    }
    let numeric = Predicate.FloatCompare("==", current, replacement)
    // Equal numeric values alone may be opposite signed zeros.
    assert !holds(equal, [numeric])
    assert holds(equal, [numeric, Predicate.FloatCompare("==", current, FloatValue.Literal("7.25"))])
    assert holds(equal, [numeric, Predicate.FloatCompare("==", current, FloatValue.Literal("inf"))])
    let inverse = FloatValue.Apply("/", [FloatValue.Literal("1"), current])
    assert match stored_float_identity(current, FloatValue.Literal("-0")) {
        Result.Ok(predicate) => holds(predicate, [
                Predicate.FloatCompare("==", current, FloatValue.Literal("0")),
                Predicate.FloatCompare("==", inverse, FloatValue.Literal("-inf"))])
        Result.Err(_) => false
    }
    assert match stored_float_identity(current, FloatValue.Literal("NaN")) {
        Result.Ok(predicate) => !holds(predicate, [])
        Result.Err(_) => true
    }
}
