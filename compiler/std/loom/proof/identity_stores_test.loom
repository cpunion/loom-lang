test fn identity_updates_compare_the_current_cell_not_a_previous_shared_read() {
    let program = atomic_pair_program()
    let locals = [Local {
            name = "values"
            ty = 7
            mutable = false
            is_scoped = false
        }]
    let receiver = get(atomic_pair_store("2", literal("0")).children, 0)
    let read = expression(ExprKind.Intrinsic, 1, "list_get", -1, [receiver, literal("0")])
    let operation = atomic_pair_store("2", read)
    assert match preserves_update_identity(program, locals, operation, no_proof_backend(), false) {
        Result.Ok(proved) => proved
        Result.Err(_) => false
    }
    assert match preserves_update_identity(program, locals, operation, no_proof_backend(), true) {
        Result.Ok(proved) => !proved
        Result.Err(_) => true
    }
    assert match preserves_update_identity(program, locals, atomic_pair_store("1", read), no_proof_backend(), false) {
        Result.Ok(proved) => !proved
        Result.Err(_) => true
    }
}

test fn identity_preservation_does_not_treat_every_allocation_as_private_scratch() {
    let program = atomic_pair_program()
    let receiver = expression(ExprKind.Local, 6, "", 0, [])
    let body = expression(ExprKind.Intrinsic, 0, "list_push", -1, [receiver, literal("7")])
    let function = contract_fixture([6], 0, body, [], [proof_bool(body, true)])
    assert match verify_preservation(program, function, no_proof_backend(), false, [], [0], []) {
        Result.Ok(proved) => proved
        Result.Err(_) => false
    }
    // This input is known allocated, not known unpublished. Neither a local
    // allocation label nor successful ordinary verification grants privacy.
    assert match verify_preservation(program, function, no_proof_backend(), false, [], [0], [], true) {
        Result.Err(_) => true
        Result.Ok(proved) => !proved
    }
}

test fn stored_identity_is_not_ieee_equality_or_opaque_graph_provenance() {
    let proof = verification(contract_fixture([], 0, expression(ExprKind.Block, 0, "", -1, []), [], []), empty_proof_program())
    let nan = Value.Float(FloatValue.Literal("NaN"))
    let row = Value.Record([Value.Number(variable(1)), Value.Boolean(Predicate.Variable(2)),
            Value.Text(TextValue.Variable(3)), nan, Value.List(4)])
    assert match stored_identity(proof, row, row, 0) {
        Result.Ok(equal) => holds(equal, [])
        Result.Err(_) => false
    }
    assert match stored_identity(proof, nan, nan, 0) {
        Result.Ok(equal) => holds(equal, [])
        Result.Err(_) => false
    }
    assert match stored_identity(proof, Value.Float(FloatValue.Literal("0")), Value.Float(FloatValue.Literal("-0")), 0) {
        Result.Err(_) => true
        Result.Ok(_) => false
    }
    let opaque = Value.Opaque(10, [])
    assert match stored_identity(proof, opaque, opaque, 0) {
        Result.Err(_) => true
        Result.Ok(_) => false
    }
}
