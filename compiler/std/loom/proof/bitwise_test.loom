test fn integer_bit_rules_keep_signed_words_masks_and_literal_counts() {
    let x = local(0)
    let masked = expression(ExprKind.Binary, 1, "&", -1, [x, literal("7")])
    let range = operation("&&", operation(">=", local(1), literal("0")), operation("<=", local(1), literal("7")))
    assert verified(fixture(masked, [], range))
    assert !verified(fixture(masked, [], operation("<", local(1), literal("7"))))
    let union = expression(ExprKind.Binary, 1, "|", -1, [x, literal("7")])
    assert !verified(fixture(union, [], operation(">=", local(1), literal("0"))))
    let shifted = expression(ExprKind.Binary, 1, "<<", -1, [x, literal("63")])
    let identity = operation("==", shifted, shifted)
    assert verified(fixture(literal("0"), [], identity))
    let counts = [-1, 64]
    var index = 0
    while index < length(counts) {
        let fault = expression(ExprKind.Binary, 1, "<<", -1, [x, literal(std.int.to_text(get(counts, index)))])
        assert !verified(fixture(literal("0"), [], operation("==", fault, fault)))
        index = index + 1
    }
    // Word truncation does not make an eagerly evaluated addition safe.
    let eager = expression(ExprKind.Binary, 1, "&", -1, [operation("+", x, literal("1")), literal("0")])
    assert !verified(fixture(literal("0"), [], operation("==", eager, literal("0"))))
    let cancelled = expression(ExprKind.Binary, 1, "^", -1,
        [operation("+", x, literal("1")), operation("+", x, literal("1"))])
    assert !verified(fixture(literal("0"), [], operation("==", cancelled, literal("0"))))
    let safe = [operation("<", x, literal("9223372036854775807"))]
    assert verified(fixture(literal("0"), safe, operation("==", eager, literal("0"))))
    assert verified(fixture(literal("0"), safe, operation("==", cancelled, literal("0"))))
    assert verified(fixture(expression(ExprKind.Unary, 1, "~", -1, [literal("0")]), [],
            operation("==", local(1), literal("-1"))))
    let negative = expression(ExprKind.Binary, 1, ">>", -1, [literal("-8"), literal("2")])
    assert verified(fixture(negative, [], operation("==", local(1), literal("-2"))))
}

test fn bit_encoding_keeps_word_width_signedness_and_arithmetic_right_shift() {
    let value = IntegerTerm.Linear(variable(0))
    let shifted = IntegerTerm.Apply(">>", [value, IntegerTerm.Linear(constant(integer(1)))])
    let query = encoding([Obligation {
                facts = []
                conclusion = integer_limit("<=", shifted, 9223372036854775807)
            }])
    assert std.text.contains(query, "(sbv_to_int (bvashr ((_ int_to_bv 64) (+ 0 (* 1 n0))) ((_ int_to_bv 64) (+ 1))))")
}

fn checked_word_interval(operator Text, low Int, high Int, first Int, last Int,
    expected_low Int, expected_high Int) {
    let x = IntegerTerm.Linear(variable(0))
    let y = IntegerTerm.Linear(variable(1))
    let facts = [integer_limit(">=", x, low), integer_limit("<=", x, high),
        integer_limit(">=", y, first), integer_limit("<=", y, last)]
    let inputs = if operator == "~" {
        [x]
    } else {
        [x, y]
    }
    assert match integer_bitwise_bounds(operator, inputs, facts, [256]) {
        Result.Ok(bounds) => compare(bounds.low, integer(expected_low)) == 0 &&
        compare(bounds.high, integer(expected_high)) == 0
        Result.Err(_) => false
    }
}

test fn bitwise_intervals_compose_signs_complements_and_holey_upper_bounds() {
    checked_word_interval("&", -8, -2, -7, -1, -9223372036854775808, -2)
    checked_word_interval("|", 1, 4, 2, 3, 2, 7)
    checked_word_interval("|", -8, -3, 0, 2, -8, -1)
    checked_word_interval("|", -8, -3, -4, -2, -4, -1)
    checked_word_interval("^", 0, 4, 0, 3, 0, 7)
    checked_word_interval("^", -8, -1, -4, -1, 0, 7)
    checked_word_interval("^", -8, -1, 0, 3, -8, -1)
    checked_word_interval("~", 0, 255, 0, 0, -256, -1)
    checked_word_interval("~", -9223372036854775808, -9223372036854775808, 0, 0,
        9223372036854775807, 9223372036854775807)
}

test fn bitwise_shift_intervals_keep_counts_and_possible_word_truncation() {
    checked_word_interval(">>", -8, 7, 1, 3, -4, 3)
    checked_word_interval(">>", 8, 31, 1, 3, 1, 15)
    checked_word_interval(">>", -32, -8, 1, 3, -16, -1)
    checked_word_interval(">>", -9223372036854775808, 9223372036854775807, 63, 63, -1, 0)
    checked_word_interval("<<", -3, 5, 1, 3, -24, 40)
    checked_word_interval("<<", -3, -1, 1, 3, -24, -2)
    checked_word_interval("<<", 1, 1, 63, 63, -9223372036854775808, 9223372036854775807)
    checked_word_interval(">>", -8, 7, -1, 0, -9223372036854775808, 9223372036854775807)
    checked_word_interval(">>", -8, 7, 0, 64, -9223372036854775808, 9223372036854775807)
    assert match integer_bounds(IntegerTerm.Apply("~", [IntegerTerm.Linear(variable(0))]), [], [0]) {
        Result.Err(_) => true
        Result.Ok(_) => false
    }
}
