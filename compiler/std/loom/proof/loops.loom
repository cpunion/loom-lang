import std.loom.typed.Expr
import std.loom.typed.ExprKind
import std.list.new
import std.list.get
import std.list.set
import std.list.push
import std.list.length
import std.result.Result
import std.option.Option

enum LoopCandidate {
    Entry(Int, List[Int], Text, Value)
    Guard(Expr)
    ExtentLocal(Int, Int, Linear)
    EntryExtent(Int, List[Int], Text, Linear)
    Element(Int, Linear, Text, Value)
}

record LoopControl {
    backedges List[Outcome]
    exits List[Outcome]
}

fn with_loop_control(proof Verification, control Option[LoopControl]) Verification {
    Verification {
        function = proof.function
        program = proof.program
        fresh = proof.fresh
        budget = proof.budget
        loop_control = control
        query = proof.query
        shared = proof.shared
    }
}

fn loop_jump(proof Verification, expr Expr, state State) Result[List[Outcome], Text] {
    match proof.loop_control {
        Option.Some(control) => {
            let output = if expr.kind == ExprKind.Break {
                control.exits
            } else {
                control.backedges
            }
            discard add_outcome(output, Outcome {
                    state = state
                    value = Value.Empty
                })?
            // A jump cannot execute the remaining expressions in its block.
            Result.Ok(new[Outcome]())
        }
        Option.None => Result.Err("loop control requires an enclosing proof loop")
    }
}

fn loop_step(proof Verification) Result[Bool, Text] {
    let remaining = get(proof.budget, 0)
    if remaining <= 0 {
        return Result.Err("loop proof budget exhausted")
    }
    set(proof.budget, 0, remaining - 1)
    Result.Ok(true)
}

fn loop_local_type(proof Verification, ty Int, depth Int) Bool {
    if ty == 1 || ty == 2 || ty == 3 {
        return true
    }
    if depth >= 16 || ty < 0 || ty >= length(proof.program.types) {
        return false
    }
    let shape = get(proof.program.types, ty)
    if shape.kind == TypeKind.List {
        return true
    }
    if shape.kind == TypeKind.Refined && length(shape.fields) == 1 {
        return loop_local_type(proof, get(shape.fields, 0).ty, depth + 1)
    }
    if shape.kind != TypeKind.Record && shape.kind != TypeKind.Tuple {
        return false
    }
    var index = 0
    while index < length(shape.fields) {
        if !loop_local_type(proof, get(shape.fields, index).ty, depth + 1) {
            return false
        }
        index = index + 1
    }
    true
}

// Enumerate all writes, including declarations and nested loops. Unknown effects
// cannot keep stale facts about a local, an alias, or a captured mutable cell.
fn loop_writes(proof Verification, expr Expr, writes List[Bool], guard Bool, depth Int) Result[Bool, Text] {
    discard loop_step(proof)?
    if depth <= 0 {
        return Result.Err("loop proof depth budget exhausted")
    }
    let kind = expr.kind
    let scalar = kind == ExprKind.Integer || kind == ExprKind.Bool || kind == ExprKind.Text || kind == ExprKind.Local ||
    kind == ExprKind.Unary || kind == ExprKind.Binary || kind == ExprKind.Coerce ||
    kind == ExprKind.Field || kind == ExprKind.Record || kind == ExprKind.List
    if !scalar && kind != ExprKind.Call &&
    !(kind == ExprKind.Intrinsic && list_operation(expr.text)) {
        if guard || (kind != ExprKind.Block && kind != ExprKind.If && kind != ExprKind.While &&
            kind != ExprKind.Let && kind != ExprKind.Assign && kind != ExprKind.Return &&
            kind != ExprKind.Assert && kind != ExprKind.Discard &&
            kind != ExprKind.Break && kind != ExprKind.Continue &&
            kind != ExprKind.Defer && kind != ExprKind.Cleanup) {
            return Result.Err("unsupported effect or control flow in required loop proof")
        }
    }
    if (kind == ExprKind.Defer || kind == ExprKind.Cleanup) && expr.text != "" {
        return Result.Err("required loop proof needs ordinary scalar cleanup")
    }
    if kind == ExprKind.Let || kind == ExprKind.Assign {
        let ty = get(proof.function.locals, expr.index).ty
        if !loop_local_type(proof, ty, 0) {
            return Result.Err("required loop proof needs scalar, List or supported inline aggregate local assignments")
        }
        set(writes, expr.index, true)
    }
    // Direct calls reuse body_call's checked scalar/aggregate summaries
    // or finite pure expansion. List primitives have explicit extent effects;
    // opaque summaries freshen heap facts. Captured/indirect calls still reject.
    var index = 0
    while index < length(expr.children) {
        discard loop_writes(proof, get(expr.children, index), writes,
            guard || (kind == ExprKind.While && index == 0), depth - 1)?
        index = index + 1
    }
    Result.Ok(true)
}

fn loop_predicate(candidate LoopCandidate, state State) Result[Predicate, Text] {
    match candidate {
        LoopCandidate.Element(identity, index, relation, initial) =>
        boolean(binary(relation, known_element(identity, index, state)?, initial)?)
        LoopCandidate.Entry(index, path, relation, initial) => {
            var value = get(state.locals, index)
            var field = 0
            while field < length(path) {
                value = match value {
                    Value.Record(fields) => get(fields, get(path, field))
                    _ => {
                        return Result.Err("loop invariant needs an inline aggregate field")
                    }
                }
                field = field + 1
            }
            boolean(binary(relation, value, initial)?)
        }
        LoopCandidate.Guard(expr) => Result.Ok(bag_fact(boolean(pure(expr, state)?)?, state.facts))
        LoopCandidate.ExtentLocal(identity, local, offset) => boolean(binary("==",
                Value.Number(list_extent(identity, state)?),
                Value.Number(add(list_value_index(get(state.locals, local))?, offset)))?)
        LoopCandidate.EntryExtent(index, path, relation, initial) => {
            var value = get(state.locals, index)
            var field = 0
            while field < length(path) {
                value = match value {
                    Value.Record(fields) => get(fields, get(path, field))
                    _ => {
                        return Result.Err("loop extent invariant needs an inline aggregate field")
                    }
                }
                field = field + 1
            }
            match value {
                Value.List(identity) => boolean(binary(relation,
                        Value.Number(list_extent(identity, state)?), Value.Number(initial))?)
                _ => Result.Err("loop extent invariant needs a tracked List")
            }
        }
    }
}

fn loop_holds(fact Predicate, state State) Bool {
    holds(fact, state.facts) || difference_holds(fact, state.facts)
}

fn add_loop_candidate(candidates List[LoopCandidate], candidate LoopCandidate, entry State) Result[Bool, Text] {
    if loop_holds(loop_predicate(candidate, entry)?, entry) {
        if length(candidates) >= 64 {
            return Result.Err("loop invariant candidate budget exhausted")
        }
        push(candidates, candidate)
    }
    Result.Ok(true)
}

fn loop_call_free(expr Expr) Bool {
    if expr.kind == ExprKind.Call {
        return false
    }
    var index = 0
    while index < length(expr.children) {
        if !loop_call_free(get(expr.children, index)) {
            return false
        }
        index = index + 1
    }
    true
}

fn loop_candidate_guard(proof Verification, guard Expr) Expr {
    if loop_call_free(guard) {
        return guard
    }
    let bindings = new[ExpansionBinding]()
    var index = 0
    while index < length(proof.function.locals) {
        push(bindings, ExpansionBinding {
                local = index
                value = proof_expr(guard, ExprKind.Local, get(proof.function.locals, index).ty,
                    "", index, new[Expr]())
            })
        index = index + 1
    }
    // Pure expansion proposes useful scalar predicates, not call equivalence or
    // established facts. Every proposal still needs entry and backedge proofs.
    // A failed optional proposal cannot consume the mandatory proof's budget.
    let budget = new[Int]()
    push(budget, 256)
    let context = Expansion {
        program = proof.program
        list_lengths = false
        budget = budget
        active = new[Int]()
        checks = new[Evaluation]()
        observations = new[Int]()
        origins = new[ObservationOrigin]()
        binders = proof.fresh
    }
    match expanded(context, guard, proof_bool(guard, true), bindings,
        proof.function.locals, false, 0, 0) {
        Result.Ok(value) => if bounded_contract(value) {
            value
        } else {
            guard
        }
        Result.Err(_) => guard
    }
}

fn loop_guard_candidates(expr Expr, candidates List[LoopCandidate], entry State) Result[Bool, Text] {
    if expr.kind != ExprKind.Binary {
        return Result.Ok(true)
    }
    if expr.text == "&&" {
        discard loop_guard_candidates(get(expr.children, 0), candidates, entry)?
        return loop_guard_candidates(get(expr.children, 1), candidates, entry)
    }
    // Calls execute afresh at each tested head, with their own result identities
    // and established checks. A syntactic call is not a stable invariant term:
    // only its verified facts on that execution may constrain the exit state.
    if !loop_call_free(expr) {
        return Result.Ok(true)
    }
    // A strict continuation bound can become a non-strict loop invariant.
    // Do not split disjunctions or assume that every guard is inductive.
    if expr.text == "<" || expr.text == "<=" || expr.text == ">" || expr.text == ">=" || expr.text == "==" {
        let relation = if expr.text == "<" {
            "<="
        } else {
            if expr.text == ">" {
                ">="
            } else {
                expr.text
            }
        }
        let weak = proof_expr(expr, ExprKind.Binary, 2, relation, -1, expr.children)
        discard add_loop_candidate(candidates, LoopCandidate.Guard(weak), entry)?
    }
    Result.Ok(true)
}

fn loop_entry_candidates(proof Verification, candidates List[LoopCandidate], index Int, path List[Int], initial Value, entry State) Result[Bool, Text] {
    discard loop_step(proof)?
    match initial {
        Value.Number(term) => {
            discard add_loop_candidate(candidates, LoopCandidate.Entry(index, path, ">=", initial), entry)?
            discard add_loop_candidate(candidates, LoopCandidate.Entry(index, path, "<=", initial), entry)?
            // A nested loop may preserve a scalar range even when the
            // stronger relation to its symbolic entry value needs
            // arithmetic outside the difference solver's fragment.
            if length(term.terms) != 0 {
                let bounds = range(term, entry.facts)
                if compare(bounds.low, integer(-9223372036854775808)) > 0 {
                    discard add_loop_candidate(candidates,
                        LoopCandidate.Entry(index, path, ">=", Value.Number(constant(bounds.low))), entry)?
                }
                if compare(bounds.high, integer(9223372036854775807)) < 0 {
                    discard add_loop_candidate(candidates,
                        LoopCandidate.Entry(index, path, "<=", Value.Number(constant(bounds.high))), entry)?
                }
            }
        }
        Value.Boolean(_) => {
            discard add_loop_candidate(candidates, LoopCandidate.Entry(index, path, "==", initial), entry)?
        }
        Value.Text(_) => {
            discard add_loop_candidate(candidates, LoopCandidate.Entry(index, path, "==", initial), entry)?
        }
        Value.List(identity) => {
            let size = list_extent(identity, entry)?
            discard add_loop_candidate(candidates, LoopCandidate.EntryExtent(index, path, ">=", size), entry)?
            discard add_loop_candidate(candidates, LoopCandidate.EntryExtent(index, path, "<=", size), entry)?
        }
        Value.Record(fields) => {
            var field = 0
            while field < length(fields) {
                let nested = new[Int]()
                var part = 0
                while part < length(path) {
                    push(nested, get(path, part))
                    part = part + 1
                }
                push(nested, field)
                discard loop_entry_candidates(proof, candidates, index, nested, get(fields, field), entry)?
                field = field + 1
            }
        }
        _ => {
        }
    }
    Result.Ok(true)
}

fn loop_candidates(proof Verification, guard Expr, writes List[Bool], resized List[Int], entry State) Result[List[LoopCandidate], Text] {
    let candidates = new[LoopCandidate]()
    var index = 0
    while index < length(writes) {
        if get(writes, index) {
            discard loop_entry_candidates(proof, candidates, index, new[Int](), get(entry.locals, index), entry)?
        }
        index = index + 1
    }
    discard loop_guard_candidates(guard, candidates, entry)?
    discard loop_extent_candidates(proof, candidates, writes, resized, entry)?
    Result.Ok(candidates)
}

fn loop_bounds(value Value, entry State) State {
    var state = entry
    match value {
        Value.Record(fields) => {
            var index = 0
            while index < length(fields) {
                state = loop_bounds(get(fields, index), state)
                index = index + 1
            }
        }
        _ => {
            state = bounded(value, state)
        }
    }
    state
}

fn loop_head(proof Verification, writes List[Bool], entry State) State {
    var state = entry
    var index = 0
    while index < length(writes) {
        if get(writes, index) {
            match get(entry.locals, index) {
                // Body-local declarations are initialized when their body
                // executes; no hypothetical value is needed at the head.
                Value.Empty => {
                }
                _ => {
                    let value = record_parameter_value(proof, get(proof.function.locals, index).ty, 0)
                    let ty = get(proof.function.locals, index).ty
                    state = invariant_facts(proof.program.types, ty, value,
                        loop_bounds(value, assigned(state, index, value)), 0)
                }
            }
        }
        index = index + 1
    }
    // Facts still mention immutable entry identities, never the fresh values.
    state
}

fn loop_assumptions(head State, candidates List[LoopCandidate]) Result[State, Text] {
    var state = head
    var index = 0
    while index < length(candidates) {
        state = assume(state, loop_predicate(get(candidates, index), head)?)
        index = index + 1
    }
    Result.Ok(state)
}

fn entered_loop(proof Verification, expr Expr, entry State, writes List[Bool], depth Int) Result[List[Outcome], Text] {
    let guard = get(expr.children, 0)
    let body = get(expr.children, 1)
    let clauses = loop_postconditions(proof.function)
    let observed = loop_query_views(proof, clauses, entry)
    let resized = loop_storage_targets(proof, expr, observed, writes, false)?
    var candidates = loop_candidates(proof, loop_candidate_guard(proof, guard), writes, resized, observed)?
    loop_quantified_candidates(proof, clauses, candidates, writes, guard, observed)
    var storage = forget_modified_extents(proof, observed, resized)
    if length(storage.extents) != 0 && !elements_preserving(proof.program, expr) {
        let modified = loop_storage_targets(proof, expr, observed, writes, true)?
        if extent_preserving(proof.program, expr) {
            storage = loop_element_head(proof, storage, modified)?
            discard loop_element_candidates(proof, clauses, candidates, entry)?
        } else {
            // Changing extents can invalidate entry indices. Do not create
            // hypothetical in-bounds cells or infer an opaque call's effects.
            storage = forget_modified_elements(storage, modified)
        }
    }
    var head = loop_head(proof, writes, storage)
    head = loop_query_views(proof, clauses, head)
    candidates = available_loop_candidates(candidates, head)
    while true {
        discard loop_step(proof)?
        let assumed = loop_assumptions(head, candidates)?
        let conditions = execute(proof, guard, assumed, depth - 1)?
        let control = LoopControl {
            backedges = new[Outcome]()
            exits = new[Outcome]()
        }
        // A nested loop gets a separate context; immutable verification values
        // restore the enclosing target on return. Each inference pass starts
        // fresh, so exits proved using a removed candidate cannot escape.
        let iteration = with_loop_control(proof, Option.Some(control))
        let backedges = control.backedges
        let exits = control.exits
        var index = 0
        while index < length(conditions) {
            let condition = get(conditions, index)
            let fact = boolean(condition.value)?
            discard append(backedges, execute(iteration, body, assume(condition.state, fact), depth - 1)?)?
            discard add_outcome(exits, Outcome {
                    state = assume(condition.state, not(fact))
                    value = Value.Empty
                })?
            index = index + 1
        }
        let survivors = new[LoopCandidate]()
        index = 0
        while index < length(candidates) {
            let candidate = get(candidates, index)
            var preserved = true
            var edge = 0
            while edge < length(backedges) && preserved {
                let state = get(backedges, edge).state
                preserved = quantified_candidate_preserved(proof, candidate, state)
                edge = edge + 1
            }
            if preserved {
                push(survivors, candidate)
            }
            index = index + 1
        }
        var published = false
        if proof.shared {
            index = 0
            while index < length(backedges) {
                if private_storage_lost(head, get(backedges, index).state) {
                    published = true
                }
                index = index + 1
            }
        }
        if length(survivors) == length(candidates) && !published {
            return Result.Ok(exits)
        }
        if published {
            // Privacy is an inductive fact too. A later iteration must not
            // recover the pre-loop exclusivity of an already published alias.
            head = published_storage(head)
        }
        // Recheck every survivor after a removal: a candidate may have relied
        // on the rejected one. The final pass also rechecks early returns.
        candidates = survivors
    }
    Result.Err("loop invariant inference did not converge")
}

fn loop_outcomes(proof Verification, expr Expr, state State, depth Int) Result[List[Outcome], Text] {
    let writes = new[Bool]()
    var index = 0
    while index < length(state.locals) {
        push(writes, false)
        index = index + 1
    }
    discard loop_writes(proof, expr, writes, false, depth)?
    let output = new[Outcome]()
    let conditions = execute(proof, get(expr.children, 0), state, depth - 1)?
    index = 0
    while index < length(conditions) {
        let condition = get(conditions, index)
        let fact = boolean(condition.value)?
        // The zero-iteration path need not satisfy inferred entered-loop bounds.
        discard add_outcome(output, Outcome {
                state = assume(condition.state, not(fact))
                value = Value.Empty
            })?
        let entry = assume(condition.state, fact)
        if !loop_holds(Predicate.Constant(false), entry) {
            discard append(output, entered_loop(proof, expr, entry, writes, depth - 1)?)?
        }
        index = index + 1
    }
    Result.Ok(output)
}
