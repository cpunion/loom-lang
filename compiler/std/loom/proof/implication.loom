import std.loom.typed.Expr
import std.loom.typed.ExprKind
import std.list.new
import std.list.get
import std.list.push
import std.list.set
import std.list.length
import std.result.Result

fn implication_form(expr Expr, budget List[Int], depth Int) Bool {
    if depth >= 64 || get(budget, 0) == 0 || (expr.ty != 1 && expr.ty != 2 && expr.ty != 3) {
        return false
    }
    set(budget, 0, get(budget, 0) - 1)
    if expr.kind == ExprKind.Integer || expr.kind == ExprKind.Bool || expr.kind == ExprKind.Text {
        return true
    }
    if expr.kind == ExprKind.Local {
        return expr.index == 0
    }
    let shape = proof_operation(expr)
    if shape.arity < 0 || shape.heap || shape.flow == OperandFlow.Choice {
        return false
    }
    var index = 0
    while index < length(expr.children) {
        if !implication_form(get(expr.children, index), budget, depth + 1) {
            return false
        }
        index = index + 1
    }
    true
}

fn implication(query ProofQuery, premise Expr, conclusion Expr) Result[Bool, Text] {
    if conjunction_implies(premise, conclusion) {
        return Result.Ok(true)
    }
    let budget = new[Int]()
    push(budget, 256)
    if !implication_form(premise, budget, 0) || !implication_form(conclusion, budget, 0) {
        return Result.Ok(false)
    }
    let initial = implication_initial(premise, conclusion)
    let state = assume(initial, boolean(pure(premise, initial)?)?)
    // The goal has not executed: never assume its overflow guards passed.
    condition_or_queue(query, conclusion, state)
}

// Checked scalar predicates share self local 0. The caller establishes that the
// premise already holds. True proves the goal both defined and true; false also
// covers unsupported forms or exhausted limits, and never authorizes removal.
pub fn implies(premise Expr, conclusion Expr) Bool {
    implies(premise, conclusion, no_proof_backend())
}

pub fn implies(premise Expr, conclusion Expr, backend ProofBackend) Bool {
    let query = proof_query(backend)
    match implication(query, premise, conclusion) {
        Result.Ok(accepted) => {
            if !accepted {
                return false
            }
            match discharge(query) {
                Result.Ok(proved) => proved
                Result.Err(_) => false
            }
        }
        _ => false
    }
}
