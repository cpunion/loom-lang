// These equations observe a local's current extent, not its original header.
// A transferred/replaced List gets no invented identity or alias separation.
fn loop_local_extent(value Value, path List[Int], state State) Result[Linear, Text] {
    var current = value
    var index = 0
    while index < length(path) {
        current = match current {
            Value.Record(fields) => get(fields, get(path, index))
            _ => {
                return Result.Err("loop extent relation needs an inline List projection")
            }
        }
        index = index + 1
    }
    match current {
        Value.List(identity) => list_extent(identity, state)
        _ => Result.Err("loop extent relation needs a tracked List")
    }
}

fn loop_transfer_leaf(proof Verification, candidates List[LoopCandidate], writes List[Bool], local Int, path List[Int], initial Value, entry State) Result[Bool, Text] {
    if length(candidates) >= 64 {
        return Result.Ok(true)
    }
    match initial {
        Value.List(identity) => {
            let size = list_extent(identity, entry)?
            var scalar = 0
            while scalar < length(writes) && length(candidates) < 64 {
                if get(writes, scalar) {
                    match get(entry.locals, scalar) {
                        Value.Number(value) => {
                            var sign = -1
                            while sign <= 1 && length(candidates) < 64 {
                                discard loop_step(proof)?
                                let factor = integer(sign)
                                discard add_loop_candidate(candidates,
                                    LoopCandidate.LocalExtent(local, path, scalar, factor,
                                        add(size, scale(value, factor))), entry)?
                                sign = sign + 2
                            }
                        }
                        _ => {
                        }
                    }
                }
                scalar = scalar + 1
            }
        }
        Value.Record(fields) => {
            var field = 0
            while field < length(fields) && length(candidates) < 64 {
                let nested = std.list.clone(path)
                push(nested, field)
                discard loop_transfer_leaf(proof, candidates, writes, local, nested,
                    get(fields, field), entry)?
                field = field + 1
            }
        }
        _ => {
        }
    }
    Result.Ok(true)
}

// Keep existing candidates first. Sum/difference conservation is a bounded
// proposal for rebound Lists; every entry and actual backedge must prove it.
fn loop_transfer_candidates(proof Verification, candidates List[LoopCandidate], writes List[Bool], resized List[Int], entry State) Result[Bool, Text] {
    if length(resized) == 0 {
        return Result.Ok(true)
    }
    var local = 0
    while local < length(writes) && length(candidates) < 64 {
        if get(writes, local) {
            discard loop_transfer_leaf(proof, candidates, writes, local, new[Int](),
                get(entry.locals, local), entry)?
        }
        local = local + 1
    }
    Result.Ok(true)
}
