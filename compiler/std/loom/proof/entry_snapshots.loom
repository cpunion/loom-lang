fn entry_length_expression(value Expr) Bool {
    value.kind == ExprKind.Intrinsic && value.text == "entry_list_len" &&
    value.ty == 1 && length(value.children) == 1
}

fn entry_element_expression(value Expr) Bool {
    value.kind == ExprKind.Intrinsic && value.text == "entry_list_get" &&
    length(value.children) == 2
}

fn entry_list_expression(value Expr) Bool {
    value.kind == ExprKind.Intrinsic && value.text == "entry_list" &&
    length(value.children) == 1
}

fn entry_observation_expression(value Expr) Bool {
    entry_length_expression(value) || entry_element_expression(value) || entry_list_expression(value)
}

fn entry_list_type(program Program, ty Int, depth Int) Bool {
    if depth >= 16 || ty < 0 || ty >= length(program.types) {
        return false
    }
    let shape = get(program.types, ty)
    if shape.kind == TypeKind.Refined && length(shape.fields) == 1 {
        return entry_list_type(program, get(shape.fields, 0).ty, depth + 1)
    }
    shape.kind == TypeKind.List && length(shape.arguments) == 1 && get(shape.arguments, 0) == 1
}

fn entry_list_value(context Expansion, value Expr) Expr {
    if value.kind == ExprKind.If && length(value.children) == 3 {
        return proof_choice(entry_reads(get(value.children, 0)),
            entry_list_value(context, get(value.children, 1)),
            entry_list_value(context, get(value.children, 2)))
    }
    let children = new[Expr]()
    push(children, entry_reads(value))
    // The operand's index is a local or field, not an observation identity.
    let snapshot = proof_expr(value, ExprKind.Intrinsic, value.ty, "entry_list", -1, children)
    let identity = if length(context.observations) != 0 {
        expanded_observation(context, snapshot)
    } else {
        -1
    }
    proof_expr(snapshot, snapshot.kind, snapshot.ty, snapshot.text, identity, children)
}

// Snapshot mutable observations, not their surrounding arithmetic. This keeps
// short-circuit guards and eager helper-argument definedness in the contract.
fn entry_reads(value Expr) Expr {
    if count_expression(value) {
        let receiver = get(value.children, 0)
        let snapshot = proof_expr(receiver, ExprKind.Intrinsic, receiver.ty, "entry_list", -1,
            snapshot_child(entry_reads(receiver)))
        return proof_expr(value, value.kind, value.ty, value.text, value.index,
            proof_children(snapshot, entry_reads(get(value.children, 1))))
    }
    if quantified_expression(value) {
        return quantified_value(value, value.index, entry_reads(get(value.children, 0)),
            entry_reads(get(value.children, 1)), entry_quantified_reads(get(value.children, 2)))
    }
    let children = new[Expr]()
    var index = 0
    while index < length(value.children) {
        push(children, entry_reads(get(value.children, index)))
        index = index + 1
    }
    proof_expr(value, value.kind, value.ty,
        if list_length_expression(value) {
            "entry_list_len"
        } else {
            if list_read_expression(value) {
                "entry_list_get"
            } else {
                value.text
            }
        },
        value.index, children)
}

fn snapshot_child(value Expr) List[Expr] {
    let values = new[Expr]()
    push(values, value)
    values
}

fn entry_quantified_reads(value Expr) Expr {
    if list_read_expression(value) {
        let receiver = get(value.children, 0)
        let snapshot = proof_expr(receiver, ExprKind.Intrinsic, receiver.ty, "entry_list", -1,
            snapshot_child(entry_reads(receiver)))
        return proof_expr(value, value.kind, value.ty, value.text, value.index,
            proof_children(snapshot, entry_quantified_reads(get(value.children, 1))))
    }
    if count_expression(value) || quantified_expression(value) {
        return entry_reads(value)
    }
    let children = new[Expr]()
    var index = 0
    while index < length(value.children) {
        push(children, entry_quantified_reads(get(value.children, index)))
        index = index + 1
    }
    proof_expr(value, value.kind, value.ty, value.text, value.index, children)
}

fn expanded_entry(context Expansion, value Expr, guard Expr,
    bindings List[ExpansionBinding], locals List[Local], self Bool,
    calls Int, depth Int) Result[Expr, Text] {
    let entry = Expansion {
        program = context.program
        list_lengths = false
        budget = context.budget
        active = context.active
        checks = new[Evaluation]()
        observations = context.observations
        origins = context.origins
        binders = context.binders
    }
    let observed = expanded(entry, get(value.children, 0), proof_bool(value, true),
        bindings, locals, self, calls, depth + 1)?
    var index = 0
    while index < length(entry.checks) {
        let check = get(entry.checks, index)
        discard evaluated(context, proof_and(guard, entry_reads(check.guard)),
            entry_reads(check.value), check.required, check.universal)?
        index = index + 1
    }
    Result.Ok(if entry_list_type(context.program, value.ty, 0) {
            entry_list_value(context, observed)
        } else {
            entry_reads(observed)
        })
}

record EntrySnapshot {
    expression Expr
    state State
    entry State
}

fn immutable_snapshot(value Value) Bool {
    match value {
        Value.Number(_) => true
        Value.Nonlinear(_) => true
        Value.EntryList(_, _) => true
        Value.Boolean(_) => true
        Value.Text(_) => true
        Value.Record(fields) => {
            var index = 0
            while index < length(fields) {
                if !immutable_snapshot(get(fields, index)) {
                    return false
                }
                index = index + 1
            }
            true
        }
        _ => false
    }
}

// Entry/current may differ for a callee summary. Read from its own invocation
// state, then place the scalar snapshot in the post-call proof scope. These
// locals are private to verification and never enter Function.locals or MIR.
fn capture_entry(proof Verification, value Expr, entry State, current State) Result[EntrySnapshot, Text] {
    capture_guarded_entry(proof, value, proof_bool(value, true), entry, current)
}

fn capture_guarded_entry(proof Verification, value Expr, guard Expr,
    entry State, current State) Result[EntrySnapshot, Text] {
    if entry_observation_expression(value) {
        match observation_value(value, guard, current) {
            Option.Some(observed) => {
                let captured = observation_reference(value, observed, current)
                let values = new[Value]()
                push(values, observed)
                return Result.Ok(EntrySnapshot {
                        expression = captured.expression
                        state = captured.state
                        entry = bounded(observed, call_scope(entry_scope(entry, current), values))
                    })
            }
            Option.None => {
            }
        }
    }
    let children = new[Expr]()
    var state = current
    var before = entry
    var index = 0
    let flow = proof_operation(value).flow
    while index < length(value.children) {
        let next = operand_guard(flow, index, children, guard)
        let captured = capture_guarded_entry(proof, get(value.children, index), next, before, state)?
        push(children, captured.expression)
        state = captured.state
        before = captured.entry
        index = index + 1
    }
    if entry_observation_expression(value) {
        // Nested snapshots use the extended proof scope, but exclusively the
        // invocation's heap and facts. Later appends cannot justify old reads.
        // Each old read is its own entry-time observation. A previous entry
        // predicate or another old expression cannot pin a shared heap cell.
        let view = interference(proof, entry_scope(before, state))
        let read = proof_expr(value, ExprKind.Intrinsic, value.ty,
            if entry_length_expression(value) {
                "list_len"
            } else {
                "list_get"
            }, -1, children)
        var observed = Value.Empty
        if entry_list_expression(value) {
            let receiver = pure(get(children, 0), view)?
            let identity = match receiver {
                Value.List(identity) => identity
                _ => {
                    return Result.Err("entry List snapshot requires a tracked handle")
                }
            }
            if proof.shared && !list_state(identity, view)?.private_storage {
                return Result.Err("entry List snapshot is not proved interference-safe")
            }
            before = array_contents(proof, identity, view)?
            let extent = list_state(identity, before)?
            observed = Value.EntryList(extent.size, extent.contents)
        } else if entry_element_expression(value) {
            let outcome = entry_element(proof, read, guard, view)?
            observed = outcome.value
            before = outcome.state
            if !immutable_snapshot(observed) {
                return Result.Err("old List elements require immutable scalar or inline values")
            }
        } else {
            observed = pure(read, view)?
            before = view
        }
        let values = new[Value]()
        push(values, observed)
        // Entry lengths already have bounds in both states. Repeated clauses
        // must not copy those same facts into every private snapshot scope.
        var after_scope = call_scope(state, values)
        after_scope = captured_array_facts(before, after_scope)
        after_scope = if proof.shared && entry_length_expression(value) {
            match observed {
                Value.Number(size) => extent_bounds(size, after_scope)
                _ => after_scope
            }
        } else {
            after_scope
        }
        let before_scope = call_scope(before, values)
        return Result.Ok(EntrySnapshot {
                expression = proof_expr(value, ExprKind.Local, value.ty, "", length(state.locals), new[Expr]())
                state = with_observation(value, guard, observed, if proof.shared || entry_element_expression(value) {
                        bounded(observed, after_scope)
                    } else {
                        after_scope
                    })
                entry = if entry_element_expression(value) {
                    bounded(observed, before_scope)
                } else {
                    before_scope
                }
            })
    }
    Result.Ok(EntrySnapshot {
            expression = proof_expr(value, value.kind, value.ty, value.text, value.index, children)
            state = state
            entry = before
        })
}

record EntryConditions {
    conditions List[Expr]
    state State
}

fn capture_conditions(proof Verification, conditions List[Expr], entry State) Result[EntryConditions, Text] {
    let output = new[Expr]()
    var state = entry
    var before = entry
    var index = 0
    while index < length(conditions) {
        let captured = capture_entry(proof, get(conditions, index), before, state)?
        push(output, captured.expression)
        state = captured.state
        before = captured.entry
        index = index + 1
    }
    Result.Ok(EntryConditions {
            conditions = output
            // Root verification has not executed the body yet. Its first read
            // must agree with these entry observations; call summaries must not
            // copy them into a potentially modified post-call heap.
            state = State {
                locals = state.locals
                facts = state.facts
                extents = before.extents
                observations = state.observations
            }
        })
}

fn snapshot_function(function Function, conditions List[Expr]) Function {
    Function {
        is_async = function.is_async
        symbol = function.symbol
        arguments = function.arguments
        params = function.params
        result = function.result
        locals = function.locals
        preconditions = function.preconditions
        postconditions = conditions
        result_local = function.result_local
        body = function.body
        runtime_name = function.runtime_name
        span = function.span
    }
}
