// An SMT array is a logical version, not runtime storage or a deep copy. Reads
// retain ordinary scalar symbols; select/store equations relate those symbols
// across arbitrary indices. Unknown effects discard versions, never reuse them.
fn array_identity(proof Verification) Int {
    let identity = get(proof.fresh, 0)
    set(proof.fresh, 0, identity + 1)
    identity
}

fn with_contents(identity Int, contents Int, state State) State {
    let extents = new[ListExtent]()
    var index = 0
    while index < length(state.extents) {
        let extent = get(state.extents, index)
        push(extents, if extent.identity == identity {
                element_contents(extent, contents, extent.cells)
            } else {
                extent
            })
        index = index + 1
    }
    State {
        locals = state.locals
        facts = state.facts
        extents = extents
        observations = state.observations
    }
}

fn array_observation(contents Int, index Linear, value Value, valid Predicate, state State) State {
    array_projection_read(contents, new[Int](), index, value, valid, state)
}

fn projection_field(path List[Int], field Int) List[Int] {
    let fields = clone(path)
    push(fields, field)
    fields
}

fn array_projection_read(contents Int, path List[Int], index Linear, value Value,
    valid Predicate, state State) State {
    match value {
        Value.Record(fields) => {
            var current = state
            var field = 0
            while field < length(fields) {
                current = array_projection_read(contents, projection_field(path, field), index,
                    get(fields, field), valid, current)
                field = field + 1
            }
            return current
        }
        Value.Sum(_, tag, payloads) => {
            var current = array_projection_read(contents, enum_tag_path(path), index,
                Value.Number(tag), valid, state)
            var variant = 0
            while variant < length(payloads) {
                let selected = Predicate.And(predicates(valid,
                        Predicate.Compare("==", add(tag, constant(integer(-variant))))))
                let fields = get(payloads, variant)
                var field = 0
                while field < length(fields) {
                    current = array_projection_read(contents, enum_payload_path(path, variant, field), index,
                        get(fields, field), selected, current)
                    field = field + 1
                }
                variant = variant + 1
            }
            return current
        }
        _ => {
        }
    }
    match array_scalar(value) {
        Result.Ok(term) => assume(state, Predicate.ArrayRead(contents, path, index, term, predicates(valid)))
        Result.Err(_) => state
    }
}

fn array_contents(proof Verification, identity Int, state State) Result[State, Text] {
    if !proof.query.backend.enabled {
        return Result.Ok(state)
    }
    let extent = list_state(identity, state)?
    if extent.contents >= 0 {
        return Result.Ok(state)
    }
    let contents = array_identity(proof)
    var current = with_contents(identity, contents, state)
    var index = 0
    while index < length(extent.cells) {
        let cell = get(extent.cells, index)
        current = array_observation(contents, cell.index, cell.value, cell.valid, current)
        index = index + 1
    }
    Result.Ok(current)
}

fn array_read(proof Verification, identity Int, index Linear, value Value,
    valid Predicate, state State) Result[State, Text] {
    let current = array_contents(proof, identity, state)?
    let contents = list_state(identity, current)?.contents
    Result.Ok(if contents >= 0 {
            array_observation(contents, index, value, valid, current)
        } else {
            current
        })
}

fn array_write(proof Verification, previous ListExtent, index Linear, value Value, state State) Result[State, Text] {
    if previous.contents < 0 {
        return Result.Ok(state)
    }
    let contents = array_identity(proof)
    let current = with_contents(previous.identity, contents, state)
    array_projection_write(proof, previous.contents, contents, new[Int](), index, value, current, 0)
}

fn array_projection_write(proof Verification, before Int, after Int, path List[Int], index Linear,
    value Value, state State, depth Int) Result[State, Text] {
    discard loop_step(proof)?
    if depth >= 16 {
        return Result.Err("array projection depth exhausted")
    }
    match value {
        Value.Record(fields) => {
            var current = state
            var field = 0
            while field < length(fields) {
                current = array_projection_write(proof, before, after, projection_field(path, field),
                    index, get(fields, field), current, depth + 1)?
                field = field + 1
            }
            return Result.Ok(current)
        }
        Value.Sum(owner, tag, payloads) => {
            var current = array_projection_write(proof, before, after, enum_tag_path(path), index,
                Value.Number(tag), state, depth + 1)?
            let variants = get(proof.program.types, owner).variants
            var variant = 0
            while variant < length(variants) {
                let types = get(variants, variant).fields
                var field = 0
                while field < length(types) {
                    // Inactive columns are unobservable at this index, but a
                    // store must still preserve them at every other index.
                    // Fresh arbitrary symbols supply no type assumptions.
                    let payload = if variant < length(payloads) && field < length(get(payloads, variant)) {
                        get(get(payloads, variant), field)
                    } else {
                        record_parameter_value(proof, get(types, field), depth + 1)
                    }
                    current = array_projection_write(proof, before, after, enum_payload_path(path, variant, field),
                        index, payload, current, depth + 1)?
                    field = field + 1
                }
                variant = variant + 1
            }
            return Result.Ok(current)
        }
        _ => {
        }
    }
    match array_scalar(value) {
        Result.Ok(term) => Result.Ok(assume(state, Predicate.ArrayWrite(before, after, path, index, term)))
        // Shared payloads remain opaque; no scalar interpretation is inferred.
        Result.Err(_) => Result.Ok(state)
    }
}

// Snapshot equations refer only to immutable scalar symbols and past heap
// versions. Export them to the post-call scope, not entry preconditions or cells.
fn captured_array_facts(entry State, current State) State {
    var state = current
    var index = 0
    while index < length(entry.facts) {
        let fact = get(entry.facts, index)
        let array = match fact {
            Predicate.ArrayRead(_, _, _, _, _) => true
            Predicate.ArrayWrite(_, _, _, _, _) => true
            _ => false
        }
        var found = false
        var position = 0
        while array && !found && position < length(state.facts) {
            found = same(fact, get(state.facts, position))
            position = position + 1
        }
        if array && !found {
            state = assume(state, fact)
        }
        index = index + 1
    }
    state
}
