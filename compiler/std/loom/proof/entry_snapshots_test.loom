test fn entry_scopes_keep_results_unavailable_across_snapshots() {
    let entry = State {
        locals = [Value.Number(constant(integer(3)))]
        facts = new[Predicate]()
        extents = new[ListExtent]()
        observations = new[Observation]()
    }
    let current = State {
        locals = [Value.Number(constant(integer(99))), Value.Number(constant(integer(7)))]
        facts = new[Predicate]()
        extents = new[ListExtent]()
        observations = new[Observation]()
    }
    let snapshot = [Value.Number(constant(integer(9)))]
    let before = call_scope(entry_scope(entry, current), snapshot)
    let after = call_scope(current, snapshot)
    let aligned = entry_scope(before, after)
    assert length(aligned.locals) == 3
    assert match get(aligned.locals, 0) {
        Value.Number(value) => index_relation("==", value, constant(integer(3)), aligned)
        _ => false
    }
    assert match get(aligned.locals, 1) {
        Value.Empty => true
        _ => false
    }
    assert match get(aligned.locals, 2) {
        Value.Number(value) => index_relation("==", value, constant(integer(9)), aligned)
        _ => false
    }
    assert !loop_holds(Predicate.Constant(false), guarded_entry(
            operation("==", local(1), literal("0")), aligned))
}

test fn entry_lists_do_not_reuse_a_locals_index_as_an_observation_identity() {
    let context = Expansion {
        program = empty_proof_program()
        list_lengths = false
        budget = [4096]
        active = []
        checks = []
        observations = [42]
        binders = [0]
        origins = [ObservationOrigin {
                source = 0
                identity = 7
            }]
    }
    let first = entry_list_value(context, local(0))
    let second = entry_list_value(context, local(0))
    assert first.index == 42 && second.index == 43
    assert get(context.observations, 0) == 44
    assert length(context.origins) == 1
}

test fn entry_lists_keep_their_length_and_content_version_without_a_current_header() {
    let state = State {
        locals = [Value.EntryList(constant(integer(2)), 7), Value.Number(constant(integer(1)))]
        facts = new[Predicate]()
        extents = new[ListExtent]()
        observations = new[Observation]()
    }
    let read = Expr {
        kind = ExprKind.Intrinsic
        ty = 1
        span = local(0).span
        text = "list_get"
        index = -1
        children = [local(0), local(1)]
        arms = []
        falls = true
    }
    assert match pure(read, state) {
        Result.Ok(value) => immutable_snapshot(value)
        _ => false
    }
    assert match defined(read, state) {
        Result.Ok(_) => true
        _ => false
    }
    assert match list_value_extent(get(state.locals, 0), state) {
        Result.Ok(size) => index_relation("==", size, constant(integer(2)), state)
        _ => false
    }
    assert match list_operation_outcomes(verification(fixture(local(0), [], literal("true")),
            empty_proof_program()), "list_set", 0, -1,
        CallArguments {
            state = state
            values = [get(state.locals, 0), get(state.locals, 1), get(state.locals, 1)]
        }) {
        Result.Err(_) => true
        _ => false
    }
}

test fn entry_receivers_keep_handles_without_rewinding_the_post_call_heap() {
    let program = capture_cell_program()
    push(program.types, Type {
            kind = TypeKind.List
            symbol = -1
            arguments = [1]
            pack_widths = []
            fields = []
            variants = []
            constraint = []
        })
    push(program.types, Type {
            kind = TypeKind.Frame
            symbol = -1
            arguments = [9]
            pack_widths = []
            fields = [Field {
                    name = "value"
                    ty = 9
                }]
            variants = []
            constraint = []
        })
    push(program.types, Type {
            kind = TypeKind.Refined
            symbol = -1
            arguments = []
            pack_widths = []
            fields = [Field {
                    name = "value"
                    ty = 7
                }]
            variants = []
            constraint = [operation(">", expression(ExprKind.Intrinsic, 1, "list_get", -1,
                        [expression(ExprKind.Local, 7, "", 0, []), literal("0")]), literal("0"))]
        })
    let function = contract_fixture([8], 1, literal("0"), [], [])
    let proof = verification(function, program)
    let initial = with_extent(20, constant(integer(2)), false, fixed_capture_cell(10, State {
                locals = [Value.List(10)]
                facts = []
                extents = []
                observations = []
            }))
    let cells = match remember_element(10, constant(integer(0)), Value.List(20), initial) {
        Result.Ok(value) => value
        Result.Err(_) => {
            assert false
            return
        }
    }
    let entry = match remember_element(20, constant(integer(0)), Value.Number(constant(integer(1))), cells) {
        Result.Ok(value) => value
        Result.Err(_) => {
            assert false
            return
        }
    }
    let changed = with_extent(20, constant(integer(5)), false, call_scope(entry, [Value.Number(constant(integer(42)))]))
    let current = match remember_element(20, constant(integer(0)), Value.Number(constant(integer(-1))), changed) {
        Result.Ok(value) => value
        Result.Err(_) => {
            assert false
            return
        }
    }
    let receiver = expression(ExprKind.Intrinsic, 9, "entry_list_get", 100,
        [expression(ExprKind.Local, 8, "", 0, []), literal("0")])
    let length = expression(ExprKind.Intrinsic, 1, "entry_list_len", 101, [receiver])
    let captured = match capture_entry(proof, length, entry, current) {
        Result.Ok(value) => value
        Result.Err(_) => {
            assert false
            return
        }
    }
    assert match pure(captured.expression, captured.state) {
        Result.Ok(Value.Number(value)) => index_relation("==", value, constant(integer(2)), captured.state)
        _ => false
    }
    assert match list_extent(20, captured.state) {
        Result.Ok(value) => index_relation("==", value, constant(integer(5)), captured.state)
        _ => false
    }
    // The old handle's nominal predicate must not be re-established on a
    // possibly aliased post-call object. That would assume a contradiction.
    assert loop_holds(Predicate.Constant(false), guarded_value_invariants(proof, 9, Value.List(20),
            Predicate.Constant(true), current))
    assert !loop_holds(Predicate.Constant(false), captured.state)
    // A handle accepted as an entry receiver is not a deep immutable value,
    // even when the same observation is now available in the snapshot cache.
    assert !immutable_snapshot(Value.List(20))
    assert entry_snapshot_value(Value.Record([Value.List(20)]), true)
    assert !immutable_snapshot(Value.Record([Value.List(20)]))
    assert entry_snapshot_value(Value.Record([Value.List(20), Value.Opaque(99, [])]), true)
    assert !immutable_snapshot(Value.Opaque(99, []))
    assert match capture_entry(proof, receiver, captured.entry, captured.state) {
        Result.Err(_) => true
        _ => false
    }
}
