fn atomic_pair_program() Program {
    let types = new[Type]()
    var index = 0
    while index < 6 {
        push(types, publication_shape(TypeKind.Int, []))
        index = index + 1
    }
    push(types, publication_shape(TypeKind.List, [1]))
    let self_value = expression(ExprKind.Local, 6, "", 0, [])
    let size = expression(ExprKind.Intrinsic, 1, "list_len", -1, [self_value])
    let first = expression(ExprKind.Intrinsic, 1, "list_get", -1, [self_value, literal("0")])
    push(types, Type {
            kind = TypeKind.Refined
            symbol = -1
            arguments = []
            pack_widths = []
            fields = [Field {
                    name = "self"
                    ty = 6
                }]
            variants = []
            constraint = [operation("&&", operation("==", size, literal("2")),
                    operation(">", first, literal("0")))]
        })
    proof_program_with_types(types)
}

fn atomic_pair_store(offset Text, replacement Expr) Expr {
    let input = expression(ExprKind.Local, 7, "", 99, [])
    let receiver = expression(ExprKind.Coerce, 6, "", -1, [input])
    let size = expression(ExprKind.Intrinsic, 1, "list_len", -1, [receiver])
    expression(ExprKind.Intrinsic, 0, "list_set", -1,
        [receiver, operation("-", size, literal(offset)), replacement])
}

test fn atomic_store_expressions_keep_input_identity_and_source_order() {
    let program = atomic_pair_program()
    let predicates = get(program.types, 7).constraint
    assert match preserves_update_expression(program, atomic_pair_store("1", literal("-1")),
        predicates, no_proof_backend(), false) {
        Result.Ok(proved) => proved
        Result.Err(_) => false
    }
    assert match preserves_update_expression(program, atomic_pair_store("1", literal("-1")),
        predicates, no_proof_backend(), true) {
        Result.Ok(proved) => proved
        Result.Err(_) => false
    }
    assert match preserves_update_expression(program, atomic_pair_store("2", literal("-1")),
        predicates, no_proof_backend(), false) {
        Result.Err(_) => true
        Result.Ok(proved) => !proved
    }
    let append = expression(ExprKind.Intrinsic, 0, "list_push", -1,
        [get(atomic_pair_store("1", literal("1")).children, 0), literal("1")])
    assert match preserves_update_expression(program, append, predicates, no_proof_backend(), false) {
        Result.Err(_) => true
        Result.Ok(proved) => !proved
    }
    let values = expression(ExprKind.Local, 6, "", 0, [])
    let invalid = expression(ExprKind.Intrinsic, 0, "list_set", -1, [values, literal("0"), literal("-1")])
    let restored = expression(ExprKind.Intrinsic, 0, "list_set", -1, [values, literal("0"), literal("1")])
    push(program.functions, contract_fixture([6], 1,
            expression(ExprKind.Block, 1, "", -1, [invalid, restored, literal("-1")]), [], []))
    let input = expression(ExprKind.Local, 7, "", 99, [])
    let replacement = helper_call(0, 1, [expression(ExprKind.Coerce, 6, "", -1, [input])])
    // Argument effects occur before the outer store and must preserve the
    // complete predicate themselves; a later restoration does not excuse them.
    assert match preserves_update_expression(program, atomic_pair_store("1", replacement),
        predicates, no_proof_backend(), false) {
        Result.Err(_) => true
        Result.Ok(proved) => !proved
    }
}
