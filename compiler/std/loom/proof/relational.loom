import std.loom.typed.Expr
import std.loom.typed.ExprKind
import std.list.new
import std.list.get
import std.list.push
import std.list.set
import std.list.length
import std.result.Result

record FactLocal {
    id Int
    ty Int
}

// Compact only referenced identities. A large original local ID is not an
// allocation size, and different scalar types must never share one identity.
fn fact_expression(value Expr, locals List[FactLocal], budget List[Int], depth Int) Result[Expr, Text] {
    if depth >= 64 || !conjunction_step(budget) || !scalar_type(value.ty) || length(value.arms) != 0 {
        return Result.Err("unsupported scalar fact")
    }
    var local = value.index
    if value.kind == ExprKind.Local {
        if value.index < 0 || length(value.children) != 0 {
            return Result.Err("invalid scalar identity")
        }
        local = 0
        while local < length(locals) && get(locals, local).id != value.index {
            local = local + 1
        }
        if local == length(locals) {
            if local >= 32 {
                return Result.Err("scalar identity budget exhausted")
            }
            push(locals, FactLocal {
                    id = value.index
                    ty = value.ty
                })
        }
        if get(locals, local).ty != value.ty {
            return Result.Err("inconsistent scalar identity")
        }
    } else {
        let literal = value.kind == ExprKind.Integer || value.kind == ExprKind.Float || value.kind == ExprKind.Bool || value.kind == ExprKind.Text
        let unary = value.kind == ExprKind.Unary || value.kind == ExprKind.Coerce
        if (!literal && !unary && value.kind != ExprKind.Binary) ||
        length(value.children) != (if literal {
                0
            } else {
                if unary {
                    1
                } else {
                    2
                }
            }) {
            return Result.Err("unsupported scalar fact expression")
        }
    }
    let children = new[Expr]()
    var index = 0
    while index < length(value.children) {
        push(children, fact_expression(get(value.children, index), locals, budget, depth + 1)?)
        index = index + 1
    }
    Result.Ok(Expr {
            kind = value.kind
            ty = value.ty
            span = value.span
            text = if value.kind == ExprKind.Local {
                ""
            } else {
                value.text
            }
            index = local
            children = children
            arms = value.arms
            falls = value.falls
        })
}

record Difference {
    left Int
    right Int
    limit Number
}

fn connected_fact(value Expr, locals List[FactLocal], budget List[Int], depth Int) Bool {
    if depth >= 64 || !conjunction_step(budget) {
        return false
    }
    if value.kind == ExprKind.Local {
        var index = 0
        while index < length(locals) {
            if get(locals, index).id == value.index {
                return true
            }
            index = index + 1
        }
    }
    var index = 0
    while index < length(value.children) {
        if connected_fact(get(value.children, index), locals, budget, depth + 1) {
            return true
        }
        index = index + 1
    }
    false
}

// Each edge is x - y <= limit. Missing variables denote the constant zero.
// Only unit coefficients qualify; all arithmetic here uses mathematical Ints.
fn difference_identity(identities List[Int], id Int) Result[Int, Text] {
    var index = 0
    while index < length(identities) {
        if get(identities, index) == id {
            return Result.Ok(index + 1)
        }
        index = index + 1
    }
    if id < 0 || length(identities) >= 32 {
        return Result.Err("difference identity budget exhausted")
    }
    push(identities, id)
    Result.Ok(length(identities))
}

fn difference_edges(edges List[Difference], identities List[Int], relation Text, value Linear) Result[Bool, Text] {
    if relation != "==" && relation != "<=" && relation != "<" && relation != ">=" && relation != ">" {
        return Result.Ok(false)
    }
    // Validate the shape before allocating identities for an unsupported term.
    var positive = -1
    var negative = -1
    var index = 0
    while index < length(value.terms) {
        let term = get(value.terms, index)
        if term.id < 0 {
            return Result.Err("invalid difference identity")
        }
        if compare(term.factor, integer(1)) == 0 && positive == -1 {
            positive = term.id
        } else {
            if compare(term.factor, integer(-1)) != 0 || negative != -1 {
                return Result.Ok(false)
            }
            negative = term.id
        }
        index = index + 1
    }
    let left = if positive == -1 {
        0
    } else {
        difference_identity(identities, positive)?
    }
    let right = if negative == -1 {
        0
    } else {
        difference_identity(identities, negative)?
    }
    let reverse = relation == ">" || relation == ">="
    let limit = if reverse {
        value.constant
    } else {
        negate(value.constant)
    }
    push(edges, Difference {
            left = if reverse {
                right
            } else {
                left
            }
            right = if reverse {
                left
            } else {
                right
            }
            limit = if relation == "<" || relation == ">" {
                subtract(limit, integer(1))
            } else {
                limit
            }
        })
    if relation == "==" {
        push(edges, Difference {
                left = right
                right = left
                limit = value.constant
            })
    }
    Result.Ok(true)
}

fn difference_facts(state State) State {
    // Symbol identities are not local slots: a local may contain an affine
    // expression, and record leaves / call results have fresh identities beyond
    // locals. Compact the actual terms; slot zero denotes mathematical zero.
    // Independent bounds already belong to range(). Avoid rebuilding them for
    // the common single-symbol proof, including nested short-circuit clauses.
    var coupled = false
    var index = 0
    while index < length(state.facts) && index < 256 && !coupled {
        match get(state.facts, index) {
            Predicate.Compare(_, value) => {
                coupled = length(value.terms) == 2
            }
            _ => {
            }
        }
        index = index + 1
    }
    if !coupled {
        return state
    }
    let identities = new[Int]()
    let edges = new[Difference]()
    index = 0
    while index < length(state.facts) && index < 256 {
        match get(state.facts, index) {
            Predicate.Compare(relation, value) => {
                match difference_edges(edges, identities, relation, value) {
                    Result.Ok(_) => {
                    }
                    Result.Err(_) => {
                        return state
                    }
                }
            }
            _ => {
            }
        }
        index = index + 1
    }
    let count = length(identities)
    if count == 0 {
        return state
    }
    let bounds = new[Bounds]()
    push(bounds, Bounds {
            low = integer(0)
            high = integer(0)
        })
    index = 0
    while index < count {
        push(bounds, Bounds {
                low = integer(-9223372036854775808)
                high = integer(9223372036854775807)
            })
        index = index + 1
    }
    // Monotone interval propagation, not a complete solver. Stopping early
    // only loses proofs; every retained bound follows from an actual edge.
    var round = 0
    var changed = true
    while changed && round <= count {
        changed = false
        index = 0
        while index < length(edges) {
            let edge = get(edges, index)
            let a = get(bounds, edge.left)
            let b = get(bounds, edge.right)
            let high = sum(b.high, edge.limit)
            let low = subtract(a.low, edge.limit)
            if compare(high, a.high) < 0 {
                set(bounds, edge.left, Bounds {
                        low = a.low
                        high = high
                    })
                changed = true
            }
            if compare(low, b.low) > 0 {
                let current = get(bounds, edge.right)
                set(bounds, edge.right, Bounds {
                        low = low
                        high = current.high
                    })
                changed = true
            }
            index = index + 1
        }
        round = round + 1
    }
    var output = state
    index = 0
    while index <= count {
        let bound = get(bounds, index)
        if compare(bound.low, bound.high) > 0 {
            return assume(state, Predicate.Constant(false))
        }
        if index > 0 {
            let value = variable(get(identities, index - 1))
            // range() already starts at machine bounds. Retain only improved
            // bounds on the symbol itself, never on a substituted local value.
            let known = range(value, state.facts)
            if compare(bound.low, known.low) > 0 {
                output = assume(output, Predicate.Compare(">=", add(value, constant(negate(bound.low)))))
            }
            if compare(bound.high, known.high) < 0 {
                output = assume(output, Predicate.Compare("<=", add(value, constant(negate(bound.high)))))
            }
        }
        index = index + 1
    }
    output
}

fn scalar_facts_imply(premises List[Expr], conclusion Expr, backend ProofBackend) Result[Bool, Text] {
    if conclusion.ty != 2 {
        return Result.Ok(false)
    }
    let locals = new[FactLocal]()
    let budget = new[Int]()
    push(budget, 4096)
    let goal = fact_expression(conclusion, locals, budget, 0)?
    if length(locals) == 0 {
        return Result.Ok(implies(proof_bool(goal, true), goal, backend))
    }
    let known = new[Expr]()
    let selected = new[Bool]()
    var index = 0
    while index < length(premises) && index < 256 {
        push(selected, false)
        index = index + 1
    }
    let search = new[Int]()
    push(search, 16384)
    var previous = -1
    // Start at the goal's identities; unrelated statements must not crowd out
    // useful evidence. Newly discovered bindings can connect earlier facts.
    while previous != length(locals) && get(search, 0) > 0 && length(known) < 32 {
        previous = length(locals)
        index = 0
        while index < length(selected) && get(search, 0) > 0 && length(known) < 32 {
            let premise = get(premises, index)
            if !get(selected, index) && premise.ty == 2 && connected_fact(premise, locals, search, 0) {
                set(selected, index, true)
                match fact_expression(premise, locals, budget, 0) {
                    Result.Ok(value) => push(known, value)
                    Result.Err(_) => {
                    }
                }
            }
            index = index + 1
        }
    }
    if length(known) == 0 {
        return Result.Ok(false)
    }
    var conjunction = get(known, 0)
    index = 1
    while index < length(known) {
        conjunction = proof_and(conjunction, get(known, index))
        index = index + 1
    }
    set(budget, 0, 4096)
    // Exact typed reuse also works for IEEE values and non-linear terms.
    if destination_conjuncts(conjunction, goal, budget) {
        return Result.Ok(true)
    }
    let values = new[Value]()
    index = 0
    while index < length(locals) {
        let ty = get(locals, index).ty
        push(values, if ty == 1 {
                Value.Number(variable(index))
            } else {
                if ty == 2 {
                    Value.Boolean(Predicate.Variable(index))
                } else {
                    if ty == 5 {
                        Value.Float(FloatValue.Variable(index))
                    } else {
                        if ty == 3 {
                            Value.Text(TextValue.Variable(index))
                        } else {
                            Value.Empty
                        }
                    }
                }
            })
        index = index + 1
    }
    var state = State {
        locals = values
        facts = new[Predicate]()
        extents = new[ListExtent]()
        observations = new[Observation]()
    }
    index = 0
    while index < length(known) {
        match established_scalar_condition(get(known, index), state, 256) {
            Result.Ok(next) => {
                state = next
            }
            // An unsupported extra fact must not hide sufficient evidence.
            Result.Err(_) => {
            }
        }
        index = index + 1
    }
    state = difference_facts(state)
    let query = proof_query(backend)
    discard condition_or_queue(query, goal, state)?
    discharge(query)
}

// The caller supplies checked, already-established facts over stable scalars.
// IDs identify values, not spelling. Unknowns and budget exhaustion retain checks.
pub fn implies_facts(premises List[Expr], conclusion Expr) Bool {
    implies_facts(premises, conclusion, no_proof_backend())
}

pub fn implies_facts(premises List[Expr], conclusion Expr, backend ProofBackend) Bool {
    match scalar_facts_imply(premises, conclusion, backend) {
        Result.Ok(proved) => proved
        Result.Err(_) => false
    }
}
