fn opaque_float_fact() Expr {
    let zero = expression(ExprKind.Float, 5, "0.0", -1, [])
    let one = expression(ExprKind.Float, 5, "1.0", -1, [])
    let value = expression(ExprKind.Local, 5, "", 0, [])
    let remainder = expression(ExprKind.Binary, 5, "%", -1, [value, one])
    operation("==", remainder, zero)
}

test fn established_scalar_facts_keep_opaque_conjunction_terms() {
    let value = expression(ExprKind.Local, 5, "", 0, [])
    let returned = expression(ExprKind.Local, 5, "", 1, [])
    let zero = expression(ExprKind.Float, 5, "0.0", -1, [])
    let positive = operation(">", value, zero)
    let opaque = opaque_float_fact()
    let goal = operation(">", returned, zero)
    assert verified(contract_fixture([5], 5, value, [opaque, positive], [goal]))
    assert verified(contract_fixture([5], 5, value, [operation("&&", positive, opaque)], [goal]))
    assert verified(contract_fixture([5], 5, value, [operation("&&", opaque, positive)], [goal]))
    assert !verified(contract_fixture([5], 5, value, [operation("||", positive, opaque)], [goal]))
    assert !verified(contract_fixture([5], 5, value, [opaque], [goal]))
    let conjunction = operation("&&", positive, opaque)
    let weaker = operation(">=", value, zero)
    assert implies(conjunction, weaker)
    assert implies_facts([conjunction], weaker)
    assert !implies(operation("||", positive, opaque), weaker)
    assert !implies_facts([operation("||", positive, opaque)], weaker)
    let yes = expression(ExprKind.Bool, 2, "true", -1, [])
    let helper = contract_fixture([5], 2, yes, [weaker], [])
    assert implies_with_helpers(proof_helpers([helper]), conjunction, helper_call(0, 2, [value]))
}

test fn opaque_entry_facts_never_establish_unrelated_truth_or_eager_safety() {
    let value = expression(ExprKind.Local, 5, "", 0, [])
    let opaque = opaque_float_fact()
    let no = expression(ExprKind.Bool, 2, "false", -1, [])
    assert !verified(contract_fixture([5], 5, value, [opaque], [no]))
    // An actually executed predicate is reusable, even when its arithmetic
    // stays opaque. It is not an axiom about a different result or operand.
    assert verified(contract_fixture([5], 5, value, [opaque], [opaque]))
    let unsafe = operation(">", operation("+", local(1), literal("1")), local(1))
    assert !verified(contract_fixture([5, 1], 5, value, [opaque], [unsafe]))
    let unaccounted = expression(ExprKind.Call, 2, "", 0, [local(0)])
    let yes = expression(ExprKind.Bool, 2, "true", -1, [])
    assert !verified(fixture(local(0), [unaccounted], yes))
}
