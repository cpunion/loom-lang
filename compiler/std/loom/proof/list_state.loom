// A List value denotes a shared handle. Its current length belongs to the
// execution state, not to an immutable scalar snapshot or a source variable.
fn list_length_expression(value Expr) Bool {
    value.kind == ExprKind.Intrinsic && value.text == "list_len" &&
    value.ty == 1 && length(value.children) == 1
}

fn list_state(identity Int, state State) Result[ListExtent, Text] {
    var index = 0
    while index < length(state.extents) {
        let extent = get(state.extents, index)
        if extent.identity == identity {
            return Result.Ok(extent)
        }
        index = index + 1
    }
    Result.Err("List length proof has no current state")
}

fn list_extent(identity Int, state State) Result[Linear, Text] {
    Result.Ok(list_state(identity, state)?.size)
}

fn stable_storage(extent ListExtent) Bool {
    extent.private_storage || extent.read_only
}

fn extent_bounds(size Linear, state State) State {
    assume(bounded(Value.Number(size), state), Predicate.Compare(">=", size))
}

fn with_extent(identity Int, size Linear, allocated Bool, state State) State {
    with_extent(identity, size, allocated, allocated, state)
}

fn with_extent(identity Int, size Linear, allocated Bool, initially_private Bool, state State) State {
    let extents = new[ListExtent]()
    var private_storage = initially_private
    var read_only = false
    var fixed_extent = false
    var invariant_type = -1
    var index = 0
    while index < length(state.extents) {
        let extent = get(state.extents, index)
        if extent.identity != identity {
            push(extents, extent)
        } else {
            private_storage = extent.private_storage
            read_only = extent.read_only
            fixed_extent = extent.fixed_extent
            invariant_type = extent.invariant_type
        }
        index = index + 1
    }
    push(extents, ListExtent {
            identity = identity
            size = size
            allocated = allocated
            private_storage = private_storage
            read_only = read_only
            fixed_extent = fixed_extent
            invariant_type = invariant_type
            contents = -1
            cells = new[ListCell]()
        })
    extent_bounds(size, State {
            locals = state.locals
            facts = state.facts
            extents = extents
            observations = state.observations
        })
}

fn list_bounds(value Value, state State) State {
    match value {
        Value.List(identity) => match list_extent(identity, state) {
            Result.Ok(_) => state
            Result.Err(_) => with_extent(identity, variable(identity), false, state)
        }
        Value.Record(fields) => {
            var bounded = state
            var index = 0
            while index < length(fields) {
                bounded = list_bounds(get(fields, index), bounded)
                index = index + 1
            }
            bounded
        }
        _ => state
    }
}

// An opaque call may resize any reachable alias, including a List concealed
// inside a dyn receiver. Retain facts about past scalar reads, but give every
// handle a fresh current extent. Different handles are not assumed disjoint.
fn forget_extents(proof Verification, state State) State {
    let modified = new[Int]()
    push(modified, -1)
    forget_modified_extents(proof, if proof.shared {
            published_storage(state)
        } else {
            state
        }, modified)
}

// Fresh handles are private until publication. Opaque calls or storing a
// mutable graph into shared storage discard this evidence conservatively.
// This is proof state, not a source ownership qualifier or a runtime monitor.
fn published_storage(state State) State {
    let extents = new[ListExtent]()
    var index = 0
    while index < length(state.extents) {
        let extent = get(state.extents, index)
        push(extents, ListExtent {
                identity = extent.identity
                size = extent.size
                allocated = extent.allocated
                private_storage = false
                read_only = extent.read_only
                fixed_extent = extent.fixed_extent
                invariant_type = extent.invariant_type
                contents = extent.contents
                cells = extent.cells
            })
        index = index + 1
    }
    State {
        locals = state.locals
        facts = state.facts
        extents = extents
        observations = state.observations
    }
}

fn mutable_value(value Value) Bool {
    match value {
        Value.List(_) => true
        Value.Projected(_, _, _) => true
        Value.Record(fields) => {
            var index = 0
            while index < length(fields) {
                if mutable_value(get(fields, index)) {
                    return true
                }
                index = index + 1
            }
            false
        }
        Value.Sum(_, _, payloads) => {
            var variant = 0
            while variant < length(payloads) {
                if mutable_value(Value.Record(get(payloads, variant))) {
                    return true
                }
                variant = variant + 1
            }
            false
        }
        _ => false
    }
}

fn interference(proof Verification, state State) State {
    interference(proof, state, proof.shared)
}

fn interference(proof Verification, state State, shared Bool) State {
    if !shared {
        return state
    }
    var current = state
    var index = 0
    while index < length(state.extents) {
        let extent = get(state.extents, index)
        if !stable_storage(extent) {
            let sample = if extent.fixed_extent {
                Value.Number(extent.size)
            } else {
                fresh_result(proof, 1)
            }
            match sample {
                Value.Number(size) => {
                    current = with_extent(extent.identity, size, extent.allocated, current)
                    if extent.invariant_type >= 6 {
                        current = invariant_facts(proof.program.types, extent.invariant_type,
                            Value.List(extent.identity), current, 0)
                    }
                }
                _ => {
                }
            }
        }
        index = index + 1
    }
    current
}

fn private_storage_lost(before State, after State) Bool {
    var index = 0
    while index < length(before.extents) {
        let extent = get(before.extents, index)
        if extent.private_storage {
            match list_state(extent.identity, after) {
                Result.Ok(current) => {
                    if !current.private_storage {
                        return true
                    }
                }
                Result.Err(_) => {
                    return true
                }
            }
        }
        index = index + 1
    }
    false
}

// A newly allocated header is distinct from every handle that already existed.
// A later unknown read/return may alias that allocation; different logical IDs
// alone never prove disjointness. IDs come from the shared monotonic counter.
fn extent_overlap(left ListExtent, right ListExtent) Bool {
    if left.identity == right.identity {
        return true
    }
    if left.allocated && (right.allocated || left.identity > right.identity) {
        return false
    }
    if right.allocated && right.identity > left.identity {
        return false
    }
    true
}

fn extent_modified(extent ListExtent, state State, modified List[Int]) Bool {
    var index = 0
    while index < length(modified) {
        match list_state(get(modified, index), state) {
            Result.Ok(target) => {
                if extent_overlap(extent, target) {
                    return true
                }
            }
            Result.Err(_) => {
                return true
            }
        }
        index = index + 1
    }
    false
}

fn forget_modified_extents(proof Verification, state State, modified List[Int]) State {
    var current = state
    var index = 0
    while index < length(state.extents) {
        let extent = get(state.extents, index)
        if extent_modified(extent, state, modified) {
            let sample = if extent.fixed_extent {
                Value.Number(extent.size)
            } else {
                fresh_result(proof, 1)
            }
            match sample {
                Value.Number(size) => {
                    current = with_extent(extent.identity, size, extent.allocated, current)
                }
                _ => {
                }
            }
        }
        index = index + 1
    }
    current
}

// Only checked, finite extent-preserving operations retain caller heap facts.
// Abstract summaries, recursion and unknown operations supply no frame rule.
enum StorageRequirement {
    Extent
    Elements
    Local
}

fn storage_operation(program Program, name Text, ty Int, arguments List[Expr], requirement StorageRequirement) Bool {
    let modeled = intrinsic_operation(name, ty, length(arguments)).arity >= 0
    if requirement == StorageRequirement.Local {
        return modeled || local_storage_operation(program, name, arguments)
    }
    modeled || name == "list_new" || name == "list_new_capacity" ||
    (requirement == StorageRequirement.Extent && (name == "list_set" || name == "list_replace"))
}

fn storage_expression(value Expr) Bool {
    let kind = value.kind
    if (kind == ExprKind.Defer || kind == ExprKind.Cleanup) && value.text != "" {
        return false
    }
    proof_operation(value).arity >= 0 || kind == ExprKind.Bytes || kind == ExprKind.List ||
    kind == ExprKind.Block || kind == ExprKind.If || kind == ExprKind.Match || kind == ExprKind.Variant || kind == ExprKind.While ||
    kind == ExprKind.Let || kind == ExprKind.Assign || kind == ExprKind.Return ||
    kind == ExprKind.Assert || kind == ExprKind.Discard ||
    kind == ExprKind.Defer || kind == ExprKind.Cleanup ||
    kind == ExprKind.Break || kind == ExprKind.Continue
}

fn preserves_list_state(program Program, value Expr, budget List[Int], requirement StorageRequirement, depth Int) Bool {
    if depth >= 32 || !conjunction_step(budget) {
        return false
    }
    let kind = value.kind
    if (kind == ExprKind.Defer || kind == ExprKind.Cleanup) && value.text != "" {
        return false
    }
    if kind == ExprKind.Call {
        if value.index < 0 || value.index >= length(program.functions) {
            return false
        }
        let function = get(program.functions, value.index)
        if function.is_async {
            return false
        }
        if function.runtime_name != "" {
            if !storage_operation(program, function.runtime_name, function.result, value.children, requirement) {
                return false
            }
        } else {
            if !preserves_list_state(program, function.body, budget, requirement, depth + 1) {
                return false
            }
        }
    } else {
        if !storage_expression(value) &&
        !(kind == ExprKind.Intrinsic && storage_operation(program, value.text, value.ty, value.children, requirement)) {
            return false
        }
    }
    var index = 0
    while index < length(value.children) {
        if !preserves_list_state(program, get(value.children, index), budget, requirement, depth + 1) {
            return false
        }
        index = index + 1
    }
    index = 0
    while index < length(value.arms) {
        let body = get(value.arms, index).body
        var item = 0
        while item < length(body) {
            if !preserves_list_state(program, get(body, item), budget, requirement, depth + 1) {
                return false
            }
            item = item + 1
        }
        index = index + 1
    }
    true
}

fn extent_preserving(program Program, value Expr) Bool {
    let budget = new[Int]()
    push(budget, 256)
    preserves_list_state(program, value, budget, StorageRequirement.Extent, 0)
}

fn elements_preserving(program Program, value Expr) Bool {
    let budget = new[Int]()
    push(budget, 256)
    preserves_list_state(program, value, budget, StorageRequirement.Elements, 0)
}
