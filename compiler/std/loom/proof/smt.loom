import std.bytes.new
import std.bytes.push
import std.bytes.to_text
import std.int.to_text
import std.text.concat

record SmtWriter {
    declarations Bytes
    names List[Text]
    budget List[Int]
    counts List[Linear]
}

fn smt_append(output Bytes, value Text) {
    var index = 0
    while index < std.text.length(value) {
        std.bytes.push(output, byte(value, index))
        index = index + 1
    }
}

fn smt_step(writer SmtWriter, depth Int) Result[Bool, Text] {
    if depth >= 256 || get(writer.budget, 0) <= 0 {
        return Result.Err("SMT obligation encoding budget exhausted")
    }
    set(writer.budget, 0, get(writer.budget, 0) - 1)
    Result.Ok(true)
}

fn smt_name(writer SmtWriter, prefix Text, id Int, sort Text) Text {
    smt_named(writer, concat(prefix, std.int.to_text(id)), sort)
}

fn smt_named(writer SmtWriter, name Text, sort Text) Text {
    var index = 0
    while index < length(writer.names) {
        if get(writer.names, index) == name {
            return name
        }
        index = index + 1
    }
    push(writer.names, name)
    smt_append(writer.declarations, concat("(declare-const ", concat(name, concat(" ", concat(sort, ")\n")))))
    name
}

// Field indices are framed segments, not hashes or declaration names. Empty
// paths describe scalar elements; nested paths describe inline projections.
fn smt_array(writer SmtWriter, identity Int, path List[Int]) Text {
    smt_array(writer, identity, path, ScalarDomain.Integer)
}

fn smt_array(writer SmtWriter, identity Int, path List[Int], domain ScalarDomain) Text {
    var name = concat("a", std.int.to_text(identity))
    var index = 0
    while index < length(path) {
        name = concat(name, concat("_f", std.int.to_text(get(path, index))))
        index = index + 1
    }
    let suffix, sort = match domain {
        ScalarDomain.Integer => ("", "Int")
        ScalarDomain.Boolean => ("_bool", "Bool")
        ScalarDomain.Text => ("_text", "(Seq (_ BitVec 8))")
        ScalarDomain.Float => ("_float", "(_ FloatingPoint 11 53)")
    }
    smt_named(writer, concat(name, suffix), concat("(Array Int ", concat(sort, ")")))
}

fn smt_select(writer SmtWriter, identity Int, path List[Int], index Linear,
    domain ScalarDomain) Result[Text, Text] {
    let array = smt_array(writer, identity, path, domain)
    Result.Ok(concat("(select ", concat(array, concat(" ", concat(smt_linear(writer, index)?, ")")))))
}

fn smt_scalar(writer SmtWriter, value ArrayScalar, depth Int) Result[Text, Text] {
    match value {
        ArrayScalar.Integer(term) => smt_integer(writer, term, depth)
        ArrayScalar.Boolean(values) => {
            if length(values) != 1 {
                return Result.Err("invalid Boolean array value")
            }
            smt_predicate(writer, get(values, 0), depth)
        }
        ArrayScalar.Text(term) => smt_text(writer, term, depth)
        ArrayScalar.Float(term) => smt_float(writer, term, depth)
    }
}

fn smt_number(value Number) Text {
    if length(value.digits) == 0 {
        return "0"
    }
    var index = length(value.digits) - 1
    var text = std.int.to_text(get(value.digits, index))
    while index > 0 {
        index = index - 1
        let part = std.int.to_text(get(value.digits, index))
        var padding = 9 - std.text.length(part)
        while padding > 0 {
            text = concat(text, "0")
            padding = padding - 1
        }
        text = concat(text, part)
    }
    if value.negative {
        concat("(- ", concat(text, ")"))
    } else {
        text
    }
}

fn smt_linear(writer SmtWriter, value Linear) Result[Text, Text] {
    let output = std.bytes.new()
    smt_append(output, concat("(+ ", smt_number(value.constant)))
    var index = 0
    while index < length(value.terms) {
        discard smt_step(writer, 0)?
        let term = get(value.terms, index)
        let name = smt_name(writer, "n", term.id, "Int")
        smt_append(output, concat(" (* ", concat(smt_number(term.factor), concat(" ", concat(name, ")")))))
        index = index + 1
    }
    smt_append(output, ")")
    Result.Ok(std.bytes.to_text(output))
}

// Text is a sequence of UTF-8 bytes, not SMT String's Unicode code points.
// The larger byte-sequence domain is a sound overapproximation of valid Text.
fn smt_text(writer SmtWriter, value TextValue, depth Int) Result[Text, Text] {
    discard smt_step(writer, depth)?
    match value {
        TextValue.Select(identity, path, index) => smt_select(writer, identity, path, index, ScalarDomain.Text)
        TextValue.Variable(id) => {
            let name = smt_name(writer, "t", id, "(Seq (_ BitVec 8))")
            let size = smt_name(writer, "n", id, "Int")
            smt_append(writer.declarations, concat("(assert (= ", concat(size, concat(" (seq.len ", concat(name, ")))\n")))))
            Result.Ok(name)
        }
        TextValue.Literal(text) => {
            let output = std.bytes.new()
            smt_append(output, "(seq.++ (as seq.empty (Seq (_ BitVec 8)))")
            var index = 0
            while index < std.text.length(text) {
                discard smt_step(writer, depth)?
                smt_append(output, concat(" (seq.unit (_ bv", concat(std.int.to_text(byte(text, index)), " 8))")))
                index = index + 1
            }
            smt_append(output, ")")
            Result.Ok(std.bytes.to_text(output))
        }
        TextValue.Joined(parts) => {
            let output = std.bytes.new()
            smt_append(output, "(seq.++ (as seq.empty (Seq (_ BitVec 8)))")
            var index = 0
            while index < length(parts) {
                smt_append(output, " ")
                smt_append(output, smt_text(writer, get(parts, index), depth + 1)?)
                index = index + 1
            }
            smt_append(output, ")")
            Result.Ok(std.bytes.to_text(output))
        }
    }
}

fn smt_pair(writer SmtWriter, operator Text, values List[Predicate], depth Int) Result[Text, Text] {
    if length(values) != 2 {
        return Result.Err("invalid binary proof predicate")
    }
    let first = smt_predicate(writer, get(values, 0), depth + 1)?
    let second = smt_predicate(writer, get(values, 1), depth + 1)?
    Result.Ok(smt_boolean_pair(operator, first, second))
}

fn smt_boolean_pair(operator Text, first Text, second Text) Text {
    // Fold only propositional constants after encoding both operands. Source
    // evaluation safety is proved separately; IEEE equality is not reflexive.
    if operator == "and" || operator == "or" {
        let absorbing = if operator == "and" {
            "false"
        } else {
            "true"
        }
        let neutral = if operator == "and" {
            "true"
        } else {
            "false"
        }
        if first == absorbing || second == absorbing {
            return absorbing
        }
        if first == neutral {
            return second
        }
        if second == neutral {
            return first
        }
    }
    concat("(", concat(operator, concat(" ", concat(first, concat(" ", concat(second, ")"))))))
}

// forall i. (P(i) && Q(i)) is the conjunction of the two quantifiers. Keep
// unrelated scalar columns out of one multi-pattern; each clause can match its
// own select/store terms. No source evaluation or safety obligation is removed.
fn smt_quantified(writer SmtWriter, identity Int, start Linear, end Linear,
    predicate Predicate, depth Int) Result[Text, Text] {
    discard smt_step(writer, depth)?
    match predicate {
        Predicate.And(parts) => {
            if length(parts) != 2 {
                return Result.Err("invalid quantified conjunction")
            }
            let first = smt_quantified(writer, identity, start, end, get(parts, 0), depth + 1)?
            let second = smt_quantified(writer, identity, start, end, get(parts, 1), depth + 1)?
            return Result.Ok(smt_boolean_pair("and", first, second))
        }
        _ => {
        }
    }
    let bound = concat("n", std.int.to_text(identity))
    let first = smt_linear(writer, start)?
    let last = smt_linear(writer, end)?
    let condition = smt_predicate(writer, predicate, depth + 1)?
    if condition == "true" {
        return Result.Ok("true")
    }
    let output = std.bytes.new()
    smt_append(output, concat("(forall ((", concat(bound, " Int)) (=> (and (<= ")))
    smt_append(output, concat(first, concat(" ", concat(bound, ") (< "))))
    smt_append(output, concat(bound, concat(" ", concat(last, ")) "))))
    smt_append(output, concat(condition, "))"))
    let quantified = std.bytes.to_text(output)
    if length(writer.counts) != 0 {
        match pointwise_bag(Predicate.Forall(identity, start, end, [predicate])) {
            Option.Some(bag) => {
                let law = concat("(=> ", concat(quantified,
                        concat(" ", concat(smt_predicate(writer, bag, depth + 1)?, ")"))))
                smt_append(writer.declarations, concat("(assert ", concat(bag_bound_scope(law, end), ")\n")))
            }
            Option.None => {
            }
        }
    }
    Result.Ok(quantified)
}

fn smt_relation(relation Text) Result[Text, Text] {
    if relation == "==" {
        return Result.Ok("=")
    }
    if relation == "!=" {
        return Result.Ok("distinct")
    }
    if relation == "<" || relation == "<=" || relation == ">" || relation == ">=" {
        return Result.Ok(relation)
    }
    Result.Err("invalid proof comparison")
}

fn smt_integer(writer SmtWriter, value IntegerTerm, depth Int) Result[Text, Text] {
    discard smt_step(writer, depth)?
    match value {
        IntegerTerm.Linear(term) => smt_linear(writer, term)
        IntegerTerm.Count(identity, inputs) => smt_count(writer, identity, inputs, depth)
        IntegerTerm.TextLength(text) => {
            Result.Ok(concat("(seq.len ", concat(smt_text(writer, text, depth + 1)?, ")")))
        }
        IntegerTerm.TextByte(text, inputs) => {
            if length(inputs) != 1 {
                return Result.Err("invalid Text byte operands")
            }
            let value = smt_text(writer, text, depth + 1)?
            let index = smt_integer(writer, get(inputs, 0), depth + 1)?
            Result.Ok(concat("(ubv_to_int (seq.nth ", concat(value, concat(" ", concat(index, "))")))))
        }
        IntegerTerm.Select(identity, path, index) => {
            smt_select(writer, identity, path, index, ScalarDomain.Integer)
        }
        IntegerTerm.Apply(operator, inputs) => {
            if integer_bitwise(operator) {
                return smt_bitwise(writer, operator, inputs, depth)
            }
            if (operator != "+" && operator != "-" && operator != "*" && !integer_division(operator)) || length(inputs) != 2 {
                return Result.Err("unsupported SMT integer operation")
            }
            let first = smt_integer(writer, get(inputs, 0), depth + 1)?
            let second = smt_integer(writer, get(inputs, 1), depth + 1)?
            if integer_division(operator) {
                return Result.Ok(smt_truncated_division(operator, first, second))
            }
            Result.Ok(concat("(", concat(operator, concat(" ", concat(first, concat(" ", concat(second, ")")))))))
        }
    }
}

// SMT div is not source signed division. Divide mathematical magnitudes, then
// restore the quotient's sign; remainder is dividend - quotient * divisor.
// Lexical lets encode operands once and work for MIN without machine abs.
// Safety is a separate obligation; these total SMT terms authorize no faults.
fn smt_truncated_division(operator Text, left Text, right Text) Text {
    let output = std.bytes.new()
    smt_append(output, concat("(let ((loom_dividend ", concat(left,
                concat(") (loom_divisor ", concat(right, ")) ")))))
    smt_append(output, "(let ((loom_magnitude (div (ite (< loom_dividend 0) (- loom_dividend) loom_dividend) (ite (< loom_divisor 0) (- loom_divisor) loom_divisor)))) ")
    smt_append(output, "(let ((loom_quotient (ite (= (< loom_dividend 0) (< loom_divisor 0)) loom_magnitude (- loom_magnitude)))) ")
    smt_append(output, if operator == "/" {
            "loom_quotient"
        } else {
            "(- loom_dividend (* loom_quotient loom_divisor))"
        })
    smt_append(output, ")))")
    std.bytes.to_text(output)
}

fn smt_predicate(writer SmtWriter, value Predicate, depth Int) Result[Text, Text] {
    discard smt_step(writer, depth)?
    match value {
        Predicate.Select(identity, path, index) => smt_select(writer, identity, path, index, ScalarDomain.Boolean)
        Predicate.Constant(value) => Result.Ok(if value {
                "true"
            } else {
                "false"
            })
        Predicate.Forall(identity, start, end, conditions) => {
            if length(conditions) != 1 {
                return Result.Err("invalid quantified proof predicate")
            }
            smt_quantified(writer, identity, start, end, get(conditions, 0), depth)
        }
        Predicate.Variable(id) => Result.Ok(smt_name(writer, "b", id, "Bool"))
        Predicate.BagEqual(before, size, after, count) => {
            let first = smt_bag(writer, smt_name(writer, "a", before, "(Array Int Int)"), size)?
            let second = smt_bag(writer, smt_name(writer, "a", after, "(Array Int Int)"), count)?
            Result.Ok(concat("(= ", concat(first, concat(" ", concat(second, ")")))))
        }
        Predicate.IntegerCompare(relation, left, right) => {
            let operator = smt_relation(relation)?
            let first = smt_integer(writer, left, depth + 1)?
            let second = smt_integer(writer, right, depth + 1)?
            Result.Ok(concat("(", concat(operator, concat(" ", concat(first, concat(" ", concat(second, ")")))))))
        }
        Predicate.FloatCompare(relation, left, right) => smt_float_relation(writer, relation, left, right, depth)
        Predicate.Compare(relation, value) => {
            let operator = smt_relation(relation)?
            Result.Ok(concat("(", concat(operator, concat(" ", concat(smt_linear(writer, value)?, " 0)")))))
        }
        Predicate.Not(values) => {
            if length(values) != 1 {
                return Result.Err("invalid proof negation")
            }
            Result.Ok(concat("(not ", concat(smt_predicate(writer, get(values, 0), depth + 1)?, ")")))
        }
        Predicate.And(values) => smt_pair(writer, "and", values, depth)
        Predicate.Or(values) => smt_pair(writer, "or", values, depth)
        Predicate.Equal(values) => smt_pair(writer, "=", values, depth)
        Predicate.TextEqual(left, right) => {
            let first = smt_text(writer, left, depth + 1)?
            let second = smt_text(writer, right, depth + 1)?
            Result.Ok(concat("(= ", concat(first, concat(" ", concat(second, ")")))))
        }
        Predicate.ArrayRead(identity, path, index, value, valid) => {
            if length(valid) != 1 {
                return Result.Err("invalid heap observation guard")
            }
            let array = smt_array(writer, identity, path, scalar_domain(value))
            let guard = smt_predicate(writer, get(valid, 0), depth + 1)?
            let position = smt_linear(writer, index)?
            let term = smt_scalar(writer, value, depth + 1)?
            Result.Ok(concat("(=> ", concat(guard, concat(" (= (select ", concat(array,
                                concat(" ", concat(position, concat(") ", concat(term, "))")))))))))
        }
        Predicate.ArrayWrite(before, after, path, index, value) => {
            let domain = scalar_domain(value)
            let previous = smt_array(writer, before, path, domain)
            let current = smt_array(writer, after, path, domain)
            let position = smt_linear(writer, index)?
            let term = smt_scalar(writer, value, depth + 1)?
            let stored = concat("(store ", concat(previous, concat(" ", concat(position,
                            concat(" ", concat(term, ")"))))))
            let equation = concat("(= ", concat(current, concat(" ", concat(stored, ")"))))
            if length(writer.counts) == 0 || domain != ScalarDomain.Integer {
                return Result.Ok(equation)
            }
            let output = std.bytes.new()
            smt_append(output, concat("(and ", equation))
            var extent = 0
            while extent < length(writer.counts) {
                smt_append(output, " ")
                smt_append(output, smt_bag_store(writer, previous, stored, position, term, get(writer.counts, extent))?)
                extent = extent + 1
            }
            smt_append(output, ")")
            Result.Ok(std.bytes.to_text(output))
        }
    }
}

fn smt_query(obligations List[Obligation]) Result[Text, Text] {
    let budget = new[Int]()
    push(budget, 65536)
    let counts = new[Linear]()
    var scan = 0
    while scan < length(obligations) {
        let obligation = get(obligations, scan)
        count_predicate_list(counts, obligation.facts, 256)
        count_predicate_extents(counts, obligation.conclusion, 256)
        scan = scan + 1
    }
    let writer = SmtWriter {
        declarations = std.bytes.new()
        names = new[Text]()
        budget = budget
        counts = counts
    }
    let body = std.bytes.new()
    smt_append(body, "(assert (not (and true")
    var index = 0
    while index < length(obligations) {
        let obligation = get(obligations, index)
        let conclusion = smt_predicate(writer, obligation.conclusion, 0)?
        if conclusion == "true" {
            index = index + 1
            continue
        }
        smt_append(body, " (=> (and true")
        var fact = 0
        while fact < length(obligation.facts) {
            smt_append(body, " ")
            smt_append(body, smt_predicate(writer, get(obligation.facts, fact), 0)?)
            fact = fact + 1
        }
        smt_append(body, ") ")
        smt_append(body, conclusion)
        smt_append(body, ")")
        index = index + 1
    }
    // Split at most one explicit alternative, then substitute branch-local
    // equalities before lowering arithmetic. Every branch must still be unsat;
    // default preserves Z3's theory selection and the backend's time budget.
    smt_append(body, ")))\n(check-sat-using (then simplify solve-eqs simplify (or-else split-clause skip) solve-eqs simplify default))\n")
    Result.Ok(concat(std.bytes.to_text(writer.declarations), std.bytes.to_text(body)))
}
