// Immutable content equalities form finite classes of logical values. Follow
// only established equality facts, never disjunctions or native pointer identity.
fn text_length(value TextValue) IntegerTerm {
    match value {
        TextValue.Literal(text) => IntegerTerm.Linear(constant(integer(std.text.length(text))))
        // This fresh identity denotes immutable bytes in the Text domain and
        // their byte length in the numeric domain, never another Int local.
        TextValue.Variable(id) => IntegerTerm.Linear(variable(id))
        TextValue.Select(_, _, _) => IntegerTerm.TextLength(value)
        TextValue.Joined(parts) => {
            var size = IntegerTerm.Linear(constant(integer(0)))
            var index = 0
            while index < length(parts) {
                size = added_integer_terms(size, text_length(get(parts, index)))
                index = index + 1
            }
            size
        }
    }
}

fn text_bounds(value Value, state State) State {
    match value {
        Value.Text(text) => assume(assume(state, integer_limit(">=", text_length(text), 0)),
            integer_limit("<=", text_length(text), 9223372036854775807))
        Value.Record(fields) => {
            var bounded = state
            var index = 0
            while index < length(fields) {
                bounded = text_bounds(get(fields, index), bounded)
                index = index + 1
            }
            bounded
        }
        _ => state
    }
}

// Optional refinement queries have one canonical self. Their checked, bounded
// syntax determines its domain; never treat immutable Text as an Int value.
fn scalar_self(value Expr, ty Int) Bool {
    if value.kind == ExprKind.Local && value.ty == ty {
        return true
    }
    var index = 0
    while index < length(value.children) {
        if scalar_self(get(value.children, index), ty) {
            return true
        }
        index = index + 1
    }
    false
}

fn implication_initial(premise Expr, conclusion Expr) State {
    let locals = new[Value]()
    push(locals, if scalar_self(premise, 3) || scalar_self(conclusion, 3) {
            Value.Text(TextValue.Variable(0))
        } else {
            if scalar_self(premise, 5) || scalar_self(conclusion, 5) {
                Value.Float(FloatValue.Variable(0))
            } else {
                Value.Number(variable(0))
            }
        })
    bounded(get(locals, 0), State {
            locals = locals
            facts = new[Predicate]()
            extents = new[ListExtent]()
            observations = new[Observation]()
        })
}

fn distinct_text_literals(left TextValue, right TextValue) Bool {
    text_literal(left) && text_literal(right) && !same_text(left, right)
}

fn text_member(values List[TextValue], value TextValue) Bool {
    var index = 0
    while index < length(values) {
        if same_text(get(values, index), value) {
            return true
        }
        index = index + 1
    }
    false
}

fn text_class(value TextValue, facts List[Predicate]) List[TextValue] {
    let values = new[TextValue]()
    push(values, value)
    var current = 0
    while current < length(values) {
        let known = get(values, current)
        var index = 0
        while index < length(facts) {
            match get(facts, index) {
                Predicate.TextEqual(left, right) => {
                    if same_text(known, left) && !text_member(values, right) {
                        push(values, right)
                    }
                    if same_text(known, right) && !text_member(values, left) {
                        push(values, left)
                    }
                }
                _ => {
                }
            }
            index = index + 1
        }
        current = current + 1
    }
    values
}

fn text_distinct(left TextValue, right TextValue, facts List[Predicate]) Bool {
    let first = text_class(left, facts)
    let second = text_class(right, facts)
    var index = 0
    while index < length(first) {
        let a = get(first, index)
        var other = 0
        while other < length(second) {
            let b = get(second, other)
            if distinct_text_literals(a, b) {
                return true
            }
            other = other + 1
        }
        index = index + 1
    }
    index = 0
    while index < length(facts) {
        match get(facts, index) {
            Predicate.Not(values) => match get(values, 0) {
                Predicate.TextEqual(a, b) => {
                    if (text_member(first, a) && text_member(second, b)) ||
                    (text_member(first, b) && text_member(second, a)) {
                        return true
                    }
                }
                _ => {
                }
            }
            _ => {
            }
        }
        index = index + 1
    }
    false
}
