import std.loom.typed.Function
import std.list.new
import std.list.push
import std.list.get
import std.list.length

record Term {
    id Int
    factor Number
}

record Linear {
    constant Number
    terms List[Term]
}

enum TextValue {
    Literal(Text)
    Variable(Int)
    Joined(List[TextValue])
    Select(Int, List[Int], Linear)
}

enum FloatValue {
    Literal(Text)
    Variable(Int)
    Apply(Text, List[FloatValue])
    Select(Int, List[Int], Linear)
}

enum IntegerTerm {
    Linear(Linear)
    Apply(Text, List[IntegerTerm])
    Select(Int, List[Int], Linear)
    Count(Int, List[IntegerTerm])
    TextLength(TextValue)
    TextByte(TextValue, List[IntegerTerm])
}

enum ScalarDomain {
    Integer
    Boolean
    Text
    Float
}

// Boolean expressions are indirect because predicates also contain array
// equations. The other scalar terms retain their ordinary inline representation.
enum ArrayScalar {
    Integer(IntegerTerm)
    Boolean(List[Predicate])
    Text(TextValue)
    Float(FloatValue)
}

enum Predicate {
    Constant(Bool)
    Variable(Int)
    Select(Int, List[Int], Linear)
    Compare(Text, Linear)
    Equal(List[Predicate])
    Not(List[Predicate])
    And(List[Predicate])
    Or(List[Predicate])
    TextEqual(TextValue, TextValue)
    IntegerCompare(Text, IntegerTerm, IntegerTerm)
    FloatCompare(Text, FloatValue, FloatValue)
    ArrayRead(Int, List[Int], Linear, ArrayScalar, List[Predicate])
    ArrayWrite(Int, Int, List[Int], Linear, ArrayScalar)
    Forall(Int, Linear, Linear, List[Predicate])
    BagEqual(Int, Linear, Int, Linear)
}

enum Value {
    Number(Linear)
    Nonlinear(IntegerTerm)
    Boolean(Predicate)
    Record(List[Value])
    // Nominal sum identity, immutable tag and variant-indexed payload snapshots.
    // Only the selected payload's type invariants may become branch facts.
    Sum(Int, Linear, List[List[Value]])
    Empty
    // An existing, otherwise unmodeled graph. The frontier excludes later
    // allocations; explicit exclusions are checked private call-frame facts.
    // Neither supplies a value, type-conformance or equality assumption.
    Opaque(Int, List[Int])
    Text(TextValue)
    Float(FloatValue)
    List(Int)
    EntryList(Linear, Int)
    Projected(Int, List[Int], Linear)
    // Checked targets and evaluated inputs, not executable coroutine frames.
    // Guarantees become available only on successful completion.
    Task(Int, List[Value], List[ListExtent])
    Function(Int, List[Value])
}

record ListCell {
    index Linear
    value Value
    valid Predicate
}

record ListExtent {
    identity Int
    size Linear
    allocated Bool
    private_storage Bool
    read_only Bool
    fixed_extent Bool
    invariant_type Int
    // Reachability provenance, widened by stores into possible descendants.
    frontier Int
    unreachable List[Int]
    contents Int
    cells List[ListCell]
}

record State {
    locals List[Value]
    facts List[Predicate]
    extents List[ListExtent]
    observations List[Observation]
}

record Outcome {
    state State
    value Value
}

record Bounds {
    low Number
    high Number
}

fn constant(value Number) Linear {
    Linear {
        constant = value
        terms = new[Term]()
    }
}

fn variable(index Int) Linear {
    let terms = new[Term]()
    push(terms, Term {
            id = index
            factor = integer(1)
        })
    Linear {
        constant = integer(0)
        terms = terms
    }
}

fn predicates(a Predicate) List[Predicate] {
    let values = new[Predicate]()
    push(values, a)
    values
}

fn predicates(a Predicate, b Predicate) List[Predicate] {
    let values = predicates(a)
    push(values, b)
    values
}

fn outcomes(state State, value Value) List[Outcome] {
    let values = new[Outcome]()
    push(values, Outcome {
            state = state
            value = value
        })
    values
}

fn inverse(relation Text) Text {
    if relation == "==" {
        return "!="
    }
    if relation == "!=" {
        return "=="
    }
    if relation == "<" {
        return ">="
    }
    if relation == "<=" {
        return ">"
    }
    if relation == ">" {
        return "<="
    }
    "<"
}

fn flip(relation Text) Text {
    if relation == "<" {
        return ">"
    }
    if relation == "<=" {
        return ">="
    }
    if relation == ">" {
        return "<"
    }
    if relation == ">=" {
        return "<="
    }
    relation
}

fn not(value Predicate) Predicate {
    match value {
        Predicate.Constant(value) => Predicate.Constant(!value)
        Predicate.Compare(relation, value) => Predicate.Compare(inverse(relation), value)
        Predicate.IntegerCompare(relation, left, right) => Predicate.IntegerCompare(inverse(relation), left, right)
        Predicate.Not(values) => get(values, 0)
        Predicate.And(values) => Predicate.Or(predicates(not(get(values, 0)), not(get(values, 1))))
        Predicate.Or(values) => Predicate.And(predicates(not(get(values, 0)), not(get(values, 1))))
        _ => Predicate.Not(predicates(value))
    }
}

fn distinct_fact(output List[Predicate], fact Predicate) {
    match fact {
        Predicate.Constant(value) => {
            if value {
                return
            }
        }
        _ => {
        }
    }
    var index = 0
    while index < length(output) {
        if same(get(output, index), fact) {
            return
        }
        index = index + 1
    }
    push(output, fact)
}

fn append_facts(output List[Predicate], fact Predicate) {
    match fact {
        Predicate.And(values) => {
            append_facts(output, get(values, 0))
            append_facts(output, get(values, 1))
        }
        Predicate.TextEqual(left, right) => {
            distinct_fact(output, fact)
            distinct_fact(output, integer_predicate("==", text_length(left), text_length(right)))
        }
        Predicate.Equal(values) => {
            // Boolean equivalence is two implications. Reuse bounded unit
            // propagation; equality alone establishes neither operand's truth.
            distinct_fact(output, fact)
            let left = get(values, 0)
            let right = get(values, 1)
            distinct_fact(output, Predicate.Or(predicates(not(left), right)))
            distinct_fact(output, Predicate.Or(predicates(not(right), left)))
        }
        _ => {
            distinct_fact(output, bag_fact(fact, output))
        }
    }
}

fn assume(state State, fact Predicate) State {
    let facts = new[Predicate]()
    var index = 0
    while index < length(state.facts) {
        push(facts, get(state.facts, index))
        index = index + 1
    }
    append_facts(facts, fact)
    State {
        locals = state.locals
        facts = facts
        extents = state.extents
        observations = state.observations
    }
}

fn assigned(state State, id Int, value Value) State {
    let locals = new[Value]()
    var index = 0
    while index < length(state.locals) {
        push(locals, if index == id {
                value
            } else {
                get(state.locals, index)
            })
        index = index + 1
    }
    State {
        locals = locals
        facts = state.facts
        extents = state.extents
        observations = state.observations
    }
}

// Unit propagation is valid for any disjunction: only a proved false alternative
// exposes the other one. This is not permission to split unknown alternatives.
fn conditional_facts(entry State) State {
    var state = entry
    var pass = 0
    var changed = true
    while changed && pass < 8 {
        let before = length(state.facts)
        var index = 0
        while index < length(state.facts) && index < 256 {
            match get(state.facts, index) {
                Predicate.Or(parts) => {
                    if holds(not(get(parts, 0)), state.facts) {
                        state = assume(state, get(parts, 1))
                    }
                    if holds(not(get(parts, 1)), state.facts) {
                        state = assume(state, get(parts, 0))
                    }
                }
                _ => {
                }
            }
            index = index + 1
        }
        changed = length(state.facts) != before
        pass = pass + 1
    }
    state
}
