// Propose mathematical differences between a written guard cursor and other
// written Int locals. Entry and every backedge still establish each relation;
// matching updates, sample iteration counts and source names are not evidence.
// Guard anchoring and the existing candidate budget avoid an all-locals matrix.
fn loop_difference_candidates(proof Verification, guard Expr, candidates List[LoopCandidate], writes List[Bool], entry State) Result[Bool, Text] {
    var left = 0
    while left < length(writes) && length(candidates) < 64 {
        if get(writes, left) && get(proof.function.locals, left).ty == 1 && scan_mentions(guard, left) {
            match get(entry.locals, left) {
                Value.Number(_) => {
                    var right = 0
                    while right < length(writes) && length(candidates) < 64 {
                        if right != left && get(writes, right) && get(proof.function.locals, right).ty == 1 &&
                        (!scan_mentions(guard, right) || right > left) {
                            match get(entry.locals, right) {
                                Value.Number(_) => {
                                    discard loop_step(proof)?
                                    let initial = binary("-", get(entry.locals, left), get(entry.locals, right))?
                                    discard add_loop_candidate(candidates, LoopCandidate.Difference(left, right, initial), entry)?
                                }
                                _ => {
                                }
                            }
                        }
                        right = right + 1
                    }
                }
                _ => {
                }
            }
        }
        left = left + 1
    }
    Result.Ok(true)
}
