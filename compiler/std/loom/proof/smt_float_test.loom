fn encoded_float_literal(text Text) Text {
    match smt_float_literal(text) {
        Result.Ok(value) => value
        Result.Err(_) => {
            assert false
            ""
        }
    }
}

test fn float_remainder_encoding_corrects_nearest_quotients_and_binds_operands_once() {
    let value = FloatValue.Apply("%", [FloatValue.Apply("%", [FloatValue.Variable(1),
                    FloatValue.Literal("4")]), FloatValue.Variable(2)])
    let query = encoding([Obligation {
                facts = []
                conclusion = Predicate.FloatCompare("<=", value, FloatValue.Literal("2"))
            }])
    assert contains(query, "(let ((fmod_x (let ((fmod_x f1)")
    assert contains(query, "(fmod_y (fp.abs f2))")
    assert contains(query, "(fp.rem (fp.abs fmod_x) fmod_y)")
    assert contains(query, "(ite (fp.isNegative fmod_r) (fp.add RNE fmod_r fmod_y) fmod_r)")
    assert contains(query, "(ite (fp.isNegative fmod_x) (fp.neg fmod_m) fmod_m)")
    assert contains(query, "(fp.isInfinite fmod_x) (fp.isZero fmod_y)) (_ NaN 11 53)")
    assert contains(query, "(ite (or (fp.isZero fmod_x) (fp.isInfinite fmod_y)) fmod_x ")
    assert !contains(query, "fp.div") && !contains(query, "fp.roundToIntegral")
}

test fn smt_float_encoding_preserves_ieee_values_rounding_and_order() {
    assert encoded_float_literal("-0.0") == "(_ -zero 11 53)"
    assert encoded_float_literal("0e300") == "(_ +zero 11 53)"
    assert encoded_float_literal("1e400") == "(_ +oo 11 53)"
    assert encoded_float_literal("-inf") == "(_ -oo 11 53)"
    assert encoded_float_literal("NaN") == "(_ NaN 11 53)"
    assert encoded_float_literal("1.25e-1") == "((_ to_fp 11 53) RNE (/ 125.0 1000.0))"
    assert match smt_float_literal("1) (assert false)") {
        Result.Err(_) => true
        _ => false
    }
    let x = FloatValue.Variable(7)
    let minus = FloatValue.Apply("-", [x])
    let query = encoding([Obligation {
                facts = [Predicate.Variable(7), Predicate.Compare(">=", variable(7))]
                conclusion = Predicate.FloatCompare("<=", minus, FloatValue.Apply("+", [x,
                            FloatValue.Apply("/", [FloatValue.Apply("*", [x, x]),
                                    FloatValue.Apply("-", [x, FloatValue.Literal("-0")])])]))
            }])
    assert contains(query, "(declare-const f7 (_ FloatingPoint 11 53))")
    assert contains(query, "(declare-const b7 Bool)") && contains(query, "(declare-const n7 Int)")
    assert contains(query, "(fp.leq (fp.neg f7) (fp.add RNE f7 (fp.div RNE (fp.mul RNE f7 f7) (fp.sub RNE f7 (_ -zero 11 53)))))")
    let different = encoding([Obligation {
                facts = []
                conclusion = Predicate.FloatCompare("!=", x, x)
            }])
    assert contains(different, "(not (not (fp.isNaN f7)))")
    assert !contains(different, "(= f7 f7)")
    let nonzero = encoding([Obligation {
                facts = []
                conclusion = Predicate.FloatCompare("==", x, FloatValue.Literal("3.5"))
            }])
    assert contains(nonzero, "(= f7 ((_ to_fp 11 53) RNE (/ 35.0 10.0)))")
    let zero = encoding([Obligation {
                facts = []
                conclusion = Predicate.FloatCompare("==", x, FloatValue.Literal("-0"))
            }])
    assert contains(zero, "(fp.isZero f7)")
    assert !float_exact_literal(FloatValue.Literal("NaN"))
    assert float_exact_literal(FloatValue.Literal("inf"))
    let subtraction = encoding([Obligation {
                facts = []
                conclusion = Predicate.FloatCompare("==", FloatValue.Apply("-", [x, x]),
                    FloatValue.Literal("0"))
            }])
    assert contains(subtraction, "(not (or (fp.isNaN f7) (fp.isInfinite f7)))")
}

test fn unsupported_float_operations_and_budget_exhaustion_supply_no_solver_axiom() {
    let x = FloatValue.Variable(1)
    assert match smt_query([Obligation {
                facts = []
                conclusion = Predicate.FloatCompare("==", FloatValue.Apply("unknown", [x,
                            FloatValue.Literal("2")]), FloatValue.Literal("0"))
            }]) {
        Result.Err(message) => message == "unsupported SMT Float operation"
        _ => false
    }
    let writer = SmtWriter {
        declarations = std.bytes.new()
        names = new[Text]()
        budget = [0]
        counts = []
    }
    assert match smt_float(writer, x, 0) {
        Result.Err(_) => true
        _ => false
    }
    assert match smt_float(writer, x, 256) {
        Result.Err(_) => true
        _ => false
    }
}
