// Interpret already evaluated operands. Structural traversal, branch guards and
// eager evaluation belong to the composition layer, not to individual theories.
fn intrinsic_value(name Text, ty Int, inputs List[Value], state State) Result[Value, Text] {
    if name == "proof_enum_tag" || name == "proof_enum_payload" {
        return enum_projection(name, inputs)
    }
    if name == "text_len" {
        return match get(inputs, 0) {
            Value.Text(text) => Result.Ok(integer_value(text_length(text)))
            _ => Result.Err("Text length proof requires immutable Text")
        }
    }
    if name == "text_concat" {
        return joined_text(get(inputs, 0), get(inputs, 1))
    }
    if name == "text_byte" {
        return match get(inputs, 0) {
            Value.Text(text) => Result.Ok(Value.Nonlinear(
                    IntegerTerm.TextByte(text, [integer_term(get(inputs, 1))?])))
            _ => Result.Err("Text byte proof requires immutable Text")
        }
    }
    if name == "list_len" {
        return Result.Ok(Value.Number(list_value_extent(get(inputs, 0), state)?))
    }
    if name == "list_get" {
        match get(inputs, 0) {
            Value.EntryList(_, contents) => {
                if contents < 0 {
                    return Result.Err("entry List contents need an enabled proof backend")
                }
                return Result.Ok(projected_value(contents, new[Int](), list_value_index(get(inputs, 1))?, ty))
            }
            _ => {
            }
        }
        let location = element_inputs(get(inputs, 0), get(inputs, 1))?
        let known = known_element(location.identity, location.index, state)
        if match known {
            Result.Ok(_) => false,
            Result.Err(_) => true
        } {
            let contents = list_state(location.identity, state)?.contents
            if contents >= 0 {
                return Result.Ok(projected_value(contents, new[Int](), location.index, ty))
            }
        }
        return known
    }
    Result.Err("unsupported or uncaptured intrinsic in required proof")
}

fn projected_value(contents Int, path List[Int], index Linear, ty Int) Value {
    if ty == 1 {
        return Value.Nonlinear(IntegerTerm.Select(contents, path, index))
    }
    if ty == 2 {
        return Value.Boolean(Predicate.Select(contents, path, index))
    }
    if ty == 3 {
        return Value.Text(TextValue.Select(contents, path, index))
    }
    if ty == 5 {
        return Value.Float(FloatValue.Select(contents, path, index))
    }
    Value.Projected(contents, path, index)
}

// Check this operation only; composition has checked each operand under the
// right guard. A hypothetical expression never establishes its own safety fact.
fn intrinsic_defined(expr Expr, state State) Result[Bool, Text] {
    if expr.text == "proof_enum_tag" || expr.text == "proof_enum_payload" {
        if enum_payload_expression(expr) && !loop_holds(enum_payload_guard(expr, state)?, state) {
            return Result.Err("enum proof payload requires its selected nominal tag")
        }
        let inputs = new[Value]()
        var index = 0
        while index < length(expr.children) {
            push(inputs, pure(get(expr.children, index), state)?)
            index = index + 1
        }
        discard enum_projection(expr.text, inputs)?
        return Result.Ok(true)
    }
    if count_expression(expr) {
        return Result.Ok(true)
    }
    if expr.text == "list_get" {
        return element_bounds(expr, state)
    }
    if expr.text == "text_byte" {
        let guard = text_byte_guard(pure(get(expr.children, 0), state)?,
            pure(get(expr.children, 1), state)?)?
        if !holds(guard, state.facts) && !difference_holds(guard, state.facts) {
            return Result.Err("postcondition Text byte index is not proved defined")
        }
        return Result.Ok(true)
    }
    if expr.text == "text_concat" {
        let size = match pure(expr, state)? {
            Value.Text(text) => text_length(text)
            _ => {
                return Result.Err("Text concatenation proof requires immutable Text")
            }
        }
        if !text_size_defined(size, state) {
            return Result.Err("postcondition Text concatenation size is not proved defined")
        }
        return Result.Ok(true)
    }
    if expr.text == "text_len" || expr.text == "list_len" {
        return Result.Ok(true)
    }
    Result.Err("unsupported or uncaptured intrinsic definedness")
}

fn operation_obligation(context Expansion, value Expr, guard Expr, shape ProofOperation) Result[Bool, Text] {
    if list_read_expression(value) {
        return read_obligation(context, value, guard)
    }
    // Entry reads have their own guarded capture/bounds check. Other partial
    // primitives retain an obligation even when their value is later discarded.
    if value.kind != ExprKind.Intrinsic || (!shape.total && !entry_element_expression(value)) {
        return evaluated(context, guard, value, false)
    }
    Result.Ok(true)
}

fn execute_immutable_operation(proof Verification, expr Expr, name Text, state State, depth Int) Result[List[Outcome], Text] {
    let inputs = call_arguments(proof, expr, state, depth)?
    let output = new[Outcome]()
    var index = 0
    while index < length(inputs) {
        let arguments = get(inputs, index)
        let value = intrinsic_value(name, expr.ty, arguments.values, arguments.state)?
        let current = if name == "text_byte" {
            assume(arguments.state, text_byte_guard(get(arguments.values, 0), get(arguments.values, 1))?)
        } else {
            arguments.state
        }
        // Successful execution, unlike a hypothetical contract expression, may
        // establish result bounds. No equation permits reordering arguments.
        if enum_payload_expression(expr) && !loop_holds(enum_projection_guard(arguments.values)?, current) {
            return Result.Err("enum proof payload requires its selected nominal tag")
        }
        discard add_outcome(output, Outcome {
                state = if enum_payload_expression(expr) {
                    typed_value_state(proof, expr.ty, value, current)
                } else {
                    bounded(value, current)
                }
                value = value
            })?
        index = index + 1
    }
    Result.Ok(output)
}

fn text_byte_guard(value Value, index Value) Result[Predicate, Text] {
    match value {
        Value.Text(text) => {
            let position = integer_term(index)?
            Result.Ok(Predicate.And(predicates(integer_limit(">=", position, 0),
                        integer_predicate("<", position, text_length(text)))))
        }
        _ => Result.Err("Text byte proof requires immutable Text")
    }
}
