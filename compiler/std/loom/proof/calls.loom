import std.loom.typed.Program
import std.loom.typed.Function
import std.loom.typed.Type
import std.loom.typed.Interface
import std.loom.typed.Witness
import std.loom.typed.Expr
import std.loom.typed.ExprKind
import std.loom.typed.Local
import std.loom.typed.TypeKind
import std.list.new
import std.list.get
import std.list.push
import std.list.set
import std.list.length
import std.result.Result
import std.option.Option

record CallArguments {
    state State
    values List[Value]
}

fn empty_proof_program() Program {
    Program {
        types = new[Type]()
        functions = new[Function]()
        entry = -1
        tests = new[Int]()
        test_names = new[Text]()
        exports = new[Int]()
        interfaces = new[Interface]()
        witnesses = new[Witness]()
    }
}

fn proof_program_with_types(types List[Type]) Program {
    Program {
        types = types
        functions = new[Function]()
        entry = -1
        tests = new[Int]()
        test_names = new[Text]()
        exports = new[Int]()
        interfaces = new[Interface]()
        witnesses = new[Witness]()
    }
}

fn verification(function Function, program Program) Verification {
    verification(function, program, no_proof_backend())
}

fn verification(function Function, program Program, backend ProofBackend) Verification {
    let fresh = new[Int]()
    push(fresh, length(function.locals))
    let budget = new[Int]()
    push(budget, 4096)
    Verification {
        function = function
        program = program
        fresh = fresh
        budget = budget
        loop_control = Option.None
        query = proof_query(backend)
        shared = false
    }
}

fn snapshot_values(values List[Value], value Value) List[Value] {
    let copied = new[Value]()
    var index = 0
    while index < length(values) {
        push(copied, get(values, index))
        index = index + 1
    }
    push(copied, value)
    copied
}

fn call_arguments(proof Verification, call Expr, state State, depth Int) Result[List[CallArguments], Text] {
    var paths = new[CallArguments]()
    push(paths, CallArguments {
            state = state
            values = new[Value]()
        })
    var index = 0
    while index < length(call.children) {
        let next = new[CallArguments]()
        var path = 0
        while path < length(paths) {
            let earlier = get(paths, path)
            let values = execute(proof, get(call.children, index), earlier.state, depth - 1)?
            var value = 0
            while value < length(values) {
                if length(next) >= 4096 {
                    return Result.Err("proof path budget exhausted")
                }
                let current = get(values, value)
                // Keep the evaluated value, not its source expression: a later
                // argument may assign a mutable caller local that it read.
                push(next, CallArguments {
                        state = current.state
                        values = snapshot_values(earlier.values, current.value)
                    })
                value = value + 1
            }
            path = path + 1
        }
        paths = next
        index = index + 1
    }
    Result.Ok(paths)
}

fn fresh_result(proof Verification, ty Int) Value {
    let identity = get(proof.fresh, 0)
    set(proof.fresh, 0, identity + 1)
    if ty == 3 {
        return Value.Text(TextValue.Variable(identity))
    }
    if ty == 1 {
        Value.Number(variable(identity))
    } else {
        Value.Boolean(Predicate.Variable(identity))
    }
}

fn opaque_parameter(kind TypeKind) Bool {
    kind == TypeKind.Dyn || kind == TypeKind.Parameter || kind == TypeKind.Associated ||
    kind == TypeKind.Text || kind == TypeKind.Bytes || kind == TypeKind.List
}

fn opaque_argument(program Program, ty Int, depth Int) Bool {
    if depth >= 16 || ty < 0 || ty >= length(program.types) {
        return false
    }
    let shape = get(program.types, ty)
    if opaque_parameter(shape.kind) {
        return true
    }
    if shape.kind == TypeKind.Refined && length(shape.fields) == 1 {
        return opaque_argument(program, get(shape.fields, 0).ty, depth + 1)
    }
    false
}

fn call_scope(state State, values List[Value]) State {
    let locals = new[Value]()
    var index = 0
    while index < length(state.locals) {
        push(locals, get(state.locals, index))
        index = index + 1
    }
    index = 0
    while index < length(values) {
        push(locals, get(values, index))
        index = index + 1
    }
    State {
        locals = locals
        facts = state.facts
        extents = state.extents
        observations = state.observations
    }
}

fn caller_state(state State, boundary Int) State {
    let locals = new[Value]()
    var index = 0
    while index < boundary {
        push(locals, get(state.locals, index))
        index = index + 1
    }
    State {
        locals = locals
        facts = state.facts
        extents = state.extents
        observations = state.observations
    }
}

// These facts are established by real entry/arithmetic checks, or by a callee's
// already verified postconditions. They are never hypothetical caller goals.
// Execute only their call-free scalar expressions through the existing prover.
fn established_checks(proof Verification, checks List[Evaluation], state State, depth Int) Result[List[Outcome], Text] {
    var paths = outcomes(state, Value.Empty)
    var index = 0
    while index < length(checks) {
        let check = get(checks, index)
        if !bounded_contract(check.guard) || !bounded_contract(check.value) {
            return Result.Err("body helper proof expansion budget exhausted")
        }
        if check.universal {
            var path = 0
            while path < length(paths) {
                let previous = get(paths, path)
                let current = quantified_views(proof, check.value, previous.state, false, 256)?
                discard condition_or_queue(proof.query, guarded_value(check.guard, check.value), current)?
                set(paths, path, Outcome {
                        state = current
                        value = previous.value
                    })
                path = path + 1
            }
        } else if check.required || !total_scalar(check.value) {
            let value = if check.required {
                check.value
            } else {
                proof_expr(check.value, ExprKind.Binary, 2, "==", -1, proof_children(check.value, check.value))
            }
            let predicate = guarded_value(check.guard, value)
            if !bounded_contract(predicate) {
                return Result.Err("body helper proof expansion budget exhausted")
            }
            let children = new[Expr]()
            push(children, predicate)
            let step = proof_expr(predicate, if check.required {
                    ExprKind.Assert
                } else {
                    ExprKind.Discard
                }, 0, "", -1, children)
            let next = new[Outcome]()
            var path = 0
            while path < length(paths) {
                discard append(next, execute(proof, step, get(paths, path).state, depth - 1)?)?
                path = path + 1
            }
            paths = next
        }
        index = index + 1
    }
    Result.Ok(paths)
}

fn summary_conditions(context Expansion, function Function, conditions List[Expr], bindings List[ExpansionBinding]) Result[Bool, Text] {
    var index = 0
    while index < length(conditions) {
        let source = get(conditions, index)
        let guard = proof_bool(source, true)
        let value = expanded(context, source, guard, bindings, function.locals, false, 0, 0)?
        discard evaluated(context, guard, value, true)?
        index = index + 1
    }
    Result.Ok(true)
}

fn mentions_result(value Expr, result_local Int) Bool {
    if value.kind == ExprKind.Local && value.index == result_local {
        return true
    }
    var index = 0
    while index < length(value.children) {
        if mentions_result(get(value.children, index), result_local) {
            return true
        }
        index = index + 1
    }
    false
}

fn same_result_path(left Expr, right Expr) Bool {
    if left.kind == ExprKind.Coerce {
        return same_result_path(get(left.children, 0), right)
    }
    if right.kind == ExprKind.Coerce {
        return same_result_path(left, get(right.children, 0))
    }
    if left.kind != right.kind || left.index != right.index {
        return false
    }
    if left.kind == ExprKind.Local {
        return true
    }
    left.kind == ExprKind.Field && same_result_path(get(left.children, 0), get(right.children, 0))
}

fn result_definition(value Expr, path Expr, result_local Int, output List[Expr]) {
    if length(output) != 0 {
        return
    }
    if value.kind == ExprKind.Binary && value.text == "&&" {
        result_definition(get(value.children, 0), path, result_local, output)
        result_definition(get(value.children, 1), path, result_local, output)
    } else {
        if value.kind == ExprKind.Binary && value.text == "==" {
            var index = 0
            while index < 2 {
                let left = get(value.children, index)
                let right = get(value.children, 1 - index)
                if same_result_path(left, path) && !mentions_result(right, result_local) {
                    push(output, right)
                    return
                }
                index = index + 1
            }
        }
    }
}

fn summarized_value(context Expansion, function Function, path Expr, snapshot Expr, bindings List[ExpansionBinding], depth Int) Result[Expr, Text] {
    discard expansion_step(context, depth)?
    let definitions = new[Expr]()
    var index = 0
    while index < length(function.postconditions) {
        let condition = get(function.postconditions, index)
        if !bounded_contract(condition) {
            return Result.Err("body helper proof expansion budget exhausted")
        }
        result_definition(condition, path, function.result_local, definitions)
        index = index + 1
    }
    if length(definitions) != 0 {
        return expanded(context, get(definitions, 0), proof_bool(path, true), bindings, function.locals, false, 0, depth + 1)
    }
    if path.ty < 0 || path.ty >= length(context.program.types) {
        return Result.Ok(snapshot)
    }
    let shape = get(context.program.types, path.ty)
    if shape.kind == TypeKind.Refined && length(shape.fields) == 1 {
        let base = get(shape.fields, 0).ty
        return summarized_value(context, function,
            proof_expr(path, path.kind, base, path.text, path.index, path.children), snapshot, bindings, depth + 1)
    }
    if shape.kind != TypeKind.Record && shape.kind != TypeKind.Tuple {
        return Result.Ok(snapshot)
    }
    let fields = new[Expr]()
    index = 0
    while index < length(shape.fields) {
        let ty = get(shape.fields, index).ty
        let path_children = new[Expr]()
        push(path_children, path)
        let saved_children = new[Expr]()
        push(saved_children, snapshot)
        let field = proof_expr(path, ExprKind.Field, ty, "", index, path_children)
        let saved = proof_expr(snapshot, ExprKind.Field, ty, "", index, saved_children)
        let input = summarized_value(context, function, field, saved, bindings, depth + 1)?
        let children = new[Expr]()
        push(children, input)
        push(fields, proof_expr(path, ExprKind.Field, ty, "", index, children))
        index = index + 1
    }
    Result.Ok(proof_expr(path, ExprKind.Record, path.ty, "", -1, fields))
}

fn applied_summary(proof Verification, call Expr, function Function, state State,
    bindings List[ExpansionBinding], boundary Int, depth Int) Result[List[Outcome], Text] {
    let entry = Expansion {
        program = proof.program
        list_lengths = false
        budget = proof.budget
        active = new[Int]()
        checks = new[Evaluation]()
        observations = if proof.shared {
            proof.fresh
        } else {
            new[Int]()
        }
        origins = new[ObservationOrigin]()
        binders = proof.fresh
    }
    discard summary_conditions(entry, function, function.preconditions, bindings)?
    let paths = established_checks(proof, entry.checks, state, depth)?
    let local_storage = !proof.shared || storage_local(proof.program, function.body)
    let private_result = private_factory(proof.program, function)
    let stable = local_storage && (length(state.extents) == 0 || extent_preserving(proof.program, function.body))
    let output = new[Outcome]()
    var index = 0
    while index < length(paths) {
        var before = get(paths, index).state
        let stable_contents = stable && length(before.extents) != 0 && elements_preserving(proof.program, function.body)
        // Preconditions describe entry. Keep their scalar snapshots, never
        // re-evaluate them as facts about storage after an opaque call.
        var after = if stable {
            interference(proof, before)
        } else {
            if local_storage {
                let modified = new[Int]()
                push(modified, -1)
                forget_modified_extents(proof, interference(proof, before), modified)
            } else {
                forget_extents(proof, before)
            }
        }
        if stable && length(before.extents) != 0 && !stable_contents {
            after = forget_elements(after)
        }
        let result_value = record_parameter_value(proof, function.result, 0)
        if private_result {
            after = fresh_storage(result_value, after)
        }
        let result_values = new[Value]()
        push(result_values, result_value)
        after = bounded(result_value, call_scope(after, result_values))
        let reference = proof_expr(call, ExprKind.Local, function.result, "",
            boundary + length(function.params), new[Expr]())
        let current_bindings = new[ExpansionBinding]()
        var binding = 0
        while binding < length(bindings) {
            push(current_bindings, get(bindings, binding))
            binding = binding + 1
        }
        push(current_bindings, ExpansionBinding {
                local = function.result_local
                value = reference
            })
        let context = Expansion {
            program = proof.program
            list_lengths = false
            budget = proof.budget
            active = new[Int]()
            checks = new[Evaluation]()
            observations = if proof.shared {
                proof.fresh
            } else {
                new[Int]()
            }
            origins = new[ObservationOrigin]()
            binders = proof.fresh
        }
        discard summary_conditions(context, function, function.postconditions, current_bindings)?
        let path = proof_expr(call, ExprKind.Local, function.result, "",
            function.result_local, new[Expr]())
        let value = summarized_value(context, function, path, reference, current_bindings, 0)?
        if !bounded_contract(value) {
            return Result.Err("body helper proof expansion budget exhausted")
        }
        let snapshots = Expansion {
            program = context.program
            list_lengths = false
            budget = context.budget
            active = context.active
            checks = new[Evaluation]()
            observations = context.observations
            origins = context.origins
            binders = context.binders
        }
        var check_index = 0
        while check_index < length(context.checks) {
            let check = get(context.checks, check_index)
            let guard = capture_entry(proof, check.guard, before, after)?
            let observed = capture_guarded_entry(proof, check.value, guard.expression,
                guard.entry, guard.state)?
            after = observed.state
            before = observed.entry
            discard evaluated(snapshots, guard.expression, observed.expression, check.required, check.universal)?
            check_index = check_index + 1
        }
        let captured = capture_entry(proof, value, before, after)?
        let current = if stable_contents {
            preserved_elements(captured.entry, captured.state, proof.shared)
        } else {
            if stable && length(state.extents) != 0 {
                preserved_call_elements(proof.program, function, boundary,
                    captured.entry, captured.state, proof.shared)
            } else {
                captured.state
            }
        }
        discard append(output, call_results(proof, captured.expression, snapshots,
                current, boundary, depth)?)?
        index = index + 1
    }
    Result.Ok(output)
}

fn applied_call(proof Verification, call Expr, function Function, arguments CallArguments, depth Int) Result[List[Outcome], Text] {
    let boundary = length(arguments.state.locals)
    let state = call_scope(arguments.state, arguments.values)
    let expressions = new[Expr]()
    let bindings = new[ExpansionBinding]()
    var index = 0
    while index < length(function.params) {
        let reference = proof_expr(call, ExprKind.Local, get(function.params, index), "", boundary + index, new[Expr]())
        push(expressions, reference)
        push(bindings, ExpansionBinding {
                local = index
                value = reference
            })
        index = index + 1
    }
    let context = Expansion {
        program = proof.program
        list_lengths = false
        budget = proof.budget
        active = new[Int]()
        checks = new[Evaluation]()
        observations = if proof.shared {
            proof.fresh
        } else {
            new[Int]()
        }
        origins = new[ObservationOrigin]()
        binders = proof.fresh
    }
    discard expansion_step(context, 0)?
    // A checked fresh factory needs no invented value contract. Its result is
    // arbitrary typed storage; the body footprint supplies only private origin.
    if length(function.postconditions) != 0 || function.result == 0 || private_factory(proof.program, function) {
        return applied_summary(proof, call, function, state, bindings, boundary, depth)
    }
    // Arguments already ran once. Only snapshot references and a finite pure
    // helper are expanded; unsupported storage effects cannot disappear.
    let references = new[ExpansionBinding]()
    index = 0
    while index < length(expressions) {
        let reference = get(expressions, index)
        push(references, ExpansionBinding {
                local = reference.index
                value = reference
            })
        index = index + 1
    }
    let prepared = proof_expr(call, ExprKind.Call, call.ty, call.text, call.index, expressions)
    let value = expanded_call(context, prepared, proof_bool(call, true), references, proof.function.locals, false, 0, 0)?
    if !bounded_contract(value) {
        return Result.Err("body helper proof expansion budget exhausted")
    }
    call_results(proof, value, context, state, boundary, depth)
}

fn call_results(proof Verification, value Expr, context Expansion, state State,
    boundary Int, depth Int) Result[List[Outcome], Text] {
    let paths = established_checks(proof, context.checks, state, depth)?
    let output = new[Outcome]()
    var index = 0
    while index < length(paths) {
        let current = get(paths, index).state
        if !holds(Predicate.Constant(false), current.facts) {
            let results = execute(proof, value, current, depth - 1)?
            var item = 0
            while item < length(results) {
                let returned = get(results, item)
                discard add_outcome(output, Outcome {
                        state = caller_state(returned.state, boundary)
                        value = returned.value
                    })?
                item = item + 1
            }
        }
        index = index + 1
    }
    Result.Ok(output)
}

fn body_call(proof Verification, call Expr, state State, depth Int) Result[List[Outcome], Text] {
    if call.index < 0 || call.index >= length(proof.program.functions) {
        return Result.Err("body proof call has no checked helper instance")
    }
    let function = get(proof.program.functions, call.index)
    let operation = intrinsic_operation(function.runtime_name, function.result, length(call.children))
    if operation.arity >= 0 && !operation.heap {
        return execute_immutable_operation(proof, call, function.runtime_name, state, depth)
    }
    let primitive = forwarded_list_operation(proof.program, function, 0)
    if primitive != "" {
        return execute_list_operation(proof, call, primitive, state, depth)
    }
    // A no-result helper needs no invented result specification. A finite
    // checked effect footprint can frame its storage; no body value is assumed.
    let framed_unit = function.result == 0 && (length(function.postconditions) != 0 ||
        extent_preserving(proof.program, function.body))
    if function.runtime_name != "" || (!helper_type(proof.program, function.result, 0) && !framed_unit) || function.result == 5 || length(function.params) != length(call.children) {
        return Result.Err("body proof needs a checked scalar or inline aggregate source function")
    }
    var index = 0
    while index < length(function.params) {
        let ty = get(function.params, index)
        // Contracted abstract/dyn arguments contribute no proof facts. Their
        // concrete implementation or hidden witness is never guessed.
        let opaque = opaque_argument(proof.program, ty, 0) && length(function.postconditions) != 0
        if (!helper_type(proof.program, ty, 0) || ty == 5) && !opaque {
            return Result.Err("body proof helper parameters must be Int, Bool, Text or inline aggregates, apart from contracted opaque arguments")
        }
        index = index + 1
    }
    let arguments = call_arguments(proof, call, state, depth)?
    let output = new[Outcome]()
    index = 0
    while index < length(arguments) {
        discard append(output, applied_call(proof, call, function, get(arguments, index), depth)?)?
        index = index + 1
    }
    Result.Ok(output)
}
