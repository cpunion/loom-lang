import std.loom.typed.Program
import std.loom.typed.Function
import std.loom.typed.Expr
import std.loom.typed.ExprKind
import std.loom.typed.Local
import std.loom.typed.Arm
import std.list.new
import std.list.get
import std.list.push
import std.list.set
import std.list.length
import std.result.Result

record ExpansionBinding {
    local Int
    value Expr
}

record Evaluation {
    guard Expr
    value Expr
    required Bool
    universal Bool
}

record ObservationOrigin {
    source Int
    identity Int
}

record Expansion {
    program Program
    list_lengths Bool
    budget List[Int]
    active List[Int]
    checks List[Evaluation]
    observations List[Int]
    origins List[ObservationOrigin]
    binders List[Int]
}

fn scalar_type(ty Int) Bool {
    ty == 1 || ty == 2 || ty == 3 || ty == 5
}

fn helper_type(program Program, ty Int, depth Int) Bool {
    if scalar_type(ty) {
        return true
    }
    if depth >= 16 || ty < 0 || ty >= length(program.types) {
        return false
    }
    let shape = get(program.types, ty)
    if shape.kind == TypeKind.Refined && length(shape.fields) == 1 {
        return helper_type(program, get(shape.fields, 0).ty, depth + 1)
    }
    // Inline aggregate leaves may be opaque. Projection does not establish
    // facts about their shared storage or permit operations on that storage.
    shape.kind == TypeKind.Record || shape.kind == TypeKind.Tuple || shape.kind == TypeKind.List || shape.kind == TypeKind.Task
}

fn expanded_field(context Expansion, field Expr, value Expr, depth Int) Result[Expr, Text] {
    discard expansion_step(context, depth)?
    if value.kind == ExprKind.Record {
        var index = 0
        while index < length(value.children) {
            let member = get(value.children, index)
            if member.index == field.index {
                return Result.Ok(get(member.children, 0))
            }
            index = index + 1
        }
        return Result.Err("invalid helper record projection")
    }
    if value.kind == ExprKind.If {
        let yes = expanded_field(context, field, get(value.children, 1), depth + 1)?
        let no = expanded_field(context, field, get(value.children, 2), depth + 1)?
        return Result.Ok(proof_choice(get(value.children, 0), yes, no))
    }
    let children = new[Expr]()
    push(children, value)
    Result.Ok(proof_expr(field, ExprKind.Field, field.ty, "", field.index, children))
}

fn expansion_step(context Expansion, depth Int) Result[Bool, Text] {
    if depth >= 64 || get(context.budget, 0) == 0 {
        return Result.Err("helper proof expansion budget exhausted")
    }
    set(context.budget, 0, get(context.budget, 0) - 1)
    Result.Ok(true)
}

fn proof_expr(source Expr, kind ExprKind, ty Int, text Text, index Int, children List[Expr]) Expr {
    Expr {
        kind = kind
        ty = ty
        span = source.span
        text = text
        index = index
        children = children
        arms = new[Arm]()
        falls = true
    }
}

fn proof_bool(source Expr, value Bool) Expr {
    proof_expr(source, ExprKind.Bool, 2, if value {
            "true"
        } else {
            "false"
        }, -1, new[Expr]())
}

fn is_bool(value Expr, truth Bool) Bool {
    value.kind == ExprKind.Bool && value.text == (if truth {
            "true"
        } else {
            "false"
        })
}

fn proof_children(left Expr, right Expr) List[Expr] {
    let children = new[Expr]()
    push(children, left)
    push(children, right)
    children
}

fn proof_not(value Expr) Expr {
    if value.kind == ExprKind.Bool {
        return proof_bool(value, value.text != "true")
    }
    if value.kind == ExprKind.Unary && value.text == "!" {
        return get(value.children, 0)
    }
    let children = new[Expr]()
    push(children, value)
    proof_expr(value, ExprKind.Unary, 2, "!", -1, children)
}

fn proof_and(left Expr, right Expr) Expr {
    if is_bool(left, true) {
        return right
    }
    if is_bool(right, true) || is_bool(left, false) {
        return left
    }
    proof_expr(left, ExprKind.Binary, 2, "&&", -1, proof_children(left, right))
}

fn guarded_value(guard Expr, value Expr) Expr {
    if is_bool(guard, true) {
        return value
    }
    if is_bool(guard, false) {
        return proof_bool(guard, true)
    }
    if is_bool(value, true) {
        return value
    }
    if is_bool(value, false) {
        return proof_not(guard)
    }
    proof_expr(guard, ExprKind.Binary, 2, "||", -1, proof_children(proof_not(guard), value))
}

fn evaluated(context Expansion, guard Expr, value Expr, required Bool) Result[Bool, Text] {
    evaluated(context, guard, value, required, false)
}

fn evaluated(context Expansion, guard Expr, value Expr, required Bool, universal Bool) Result[Bool, Text] {
    if length(context.checks) >= 256 {
        return Result.Err("helper evaluation budget exhausted")
    }
    push(context.checks, Evaluation {
            guard = guard
            value = value
            required = required
            universal = universal
        })
    Result.Ok(true)
}

fn expanded_call(context Expansion, value Expr, guard Expr, bindings List[ExpansionBinding], locals List[Local], self Bool, calls Int, depth Int) Result[Expr, Text] {
    if value.index < 0 || value.index >= length(context.program.functions) || calls >= 32 {
        return Result.Err("helper has no bounded checked instance")
    }
    let function = get(context.program.functions, value.index)
    if runtime_proof_operation(context.program, function, value) {
        return expanded(context, proof_expr(value, ExprKind.Intrinsic, function.result,
                function.runtime_name, -1, value.children), guard, bindings, locals, self, calls, depth + 1)
    }
    if function.runtime_name != "" || !helper_type(context.program, function.result, 0) || length(function.params) != length(value.children) {
        return Result.Err("helper proof needs a source scalar or inline aggregate function")
    }
    var index = 0
    while index < calls {
        if get(context.active, index) == value.index {
            return Result.Err("recursive helper proof is unsupported")
        }
        index = index + 1
    }
    let arguments = new[ExpansionBinding]()
    index = 0
    // Call arguments execute eagerly, even when an unused parameter or the
    // helper's own short circuit would omit their substituted expressions.
    while index < length(function.params) {
        let ty = get(function.params, index)
        if !helper_type(context.program, ty, 0) && !(context.list_lengths && proof_list_type(context.program, ty)) {
            return Result.Err("helper parameters must be scalars or inline aggregates")
        }
        let argument = expanded(context, get(value.children, index), guard, bindings, locals, self, calls, depth + 1)?
        push(arguments, ExpansionBinding {
                local = index
                value = argument
            })
        index = index + 1
    }
    if calls == length(context.active) {
        push(context.active, value.index)
    } else {
        set(context.active, calls, value.index)
    }
    index = 0
    while index < length(function.preconditions) {
        let condition = expanded(context, get(function.preconditions, index), guard, arguments, function.locals, false, calls + 1, depth + 1)?
        discard evaluated(context, guard, condition, true)?
        index = index + 1
    }
    // Declared postconditions have already been checked normally. They are not
    // assumptions for this expansion; only the actual body supplies its value.
    expanded_block(context, function.body, guard, arguments, function.locals, false, calls + 1, depth + 1, true)
}

fn expanded_block(context Expansion, value Expr, guard Expr, bindings List[ExpansionBinding], locals List[Local], self Bool, calls Int, depth Int, returns Bool) Result[Expr, Text] {
    discard expansion_step(context, depth)?
    if value.kind != ExprKind.Block || length(value.children) == 0 {
        return Result.Err("helper needs a scalar body")
    }
    if scan_block(value) {
        return expanded_scan(context, value, guard, bindings, locals, self, calls, depth + 1)
    }
    // Keep the common straight-line path free of path lists; control-flow helpers
    // use the same expression expansion and guarded evaluation obligations.
    var scan = 0
    while scan < length(value.children) {
        let member = get(value.children, scan)
        if member.kind == ExprKind.If || member.kind == ExprKind.Block || (member.kind == ExprKind.Return && scan + 1 < length(value.children)) || member.kind == ExprKind.Assert {
            return expanded_branches(context, value, guard, bindings, locals, self, calls, depth + 1, returns)
        }
        scan = scan + 1
    }
    var index = 0
    while index < length(value.children) {
        let member = get(value.children, index)
        let last = index + 1 == length(value.children)
        if member.kind == ExprKind.Let || member.kind == ExprKind.Assign {
            if last {
                return Result.Err("helper body has no scalar result")
            }
            discard expanded_binding(context, member, guard, bindings, locals, self, calls, depth + 1)?
        } else {
            if member.kind == ExprKind.Discard && !last {
                discard expanded(context, get(member.children, 0), guard, bindings, locals, self, calls, depth + 1)?
            } else {
                if !last {
                    return Result.Err("helper control flow is unsupported")
                }
                if member.kind == ExprKind.Return && returns && length(member.children) == 1 {
                    return expanded(context, get(member.children, 0), guard, bindings, locals, self, calls, depth + 1)
                }
                return expanded(context, member, guard, bindings, locals, self, calls, depth + 1)
            }
        }
        index = index + 1
    }
    Result.Err("helper body has no scalar result")
}

fn expanded(context Expansion, value Expr, guard Expr, bindings List[ExpansionBinding], locals List[Local], self Bool, calls Int, depth Int) Result[Expr, Text] {
    discard expansion_step(context, depth)?
    if quantified_expression(value) {
        return expanded_quantifier(context, value, guard, bindings, locals, self, calls, depth + 1)
    }
    if bound_expression(value) {
        return Result.Ok(value)
    }
    if value.kind == ExprKind.Block {
        return expanded_block(context, value, guard, bindings, locals, self, calls, depth + 1, false)
    }
    if value.kind == ExprKind.If {
        return expanded_branches(context, value, guard, bindings, locals, self, calls, depth + 1, false)
    }
    if length(value.arms) != 0 {
        return Result.Err("helper expression has unsupported match paths")
    }
    if value.kind == ExprKind.Intrinsic && value.text == "contract_old" && length(value.children) == 1 {
        return expanded_entry(context, value, guard, bindings, locals, self, calls, depth + 1)
    }
    if value.kind == ExprKind.Local {
        var index = length(bindings)
        while index > 0 {
            index = index - 1
            let binding = get(bindings, index)
            if binding.local == value.index {
                return Result.Ok(binding.value)
            }
        }
        if self && value.index == 0 {
            return Result.Ok(proof_expr(value, ExprKind.Local,
                    if context.list_lengths && proof_list_type(context.program, value.ty) {
                        1
                    } else {
                        value.ty
                    },
                    "self", 0, new[Expr]()))
        }
        return Result.Err("helper expression has an unbound local")
    }
    if value.kind == ExprKind.Integer || value.kind == ExprKind.Float || value.kind == ExprKind.Bool || value.kind == ExprKind.Text {
        return Result.Ok(value)
    }
    if value.kind == ExprKind.Call {
        return expanded_call(context, value, guard, bindings, locals, self, calls, depth + 1)
    }
    if context.list_lengths && value.kind == ExprKind.Intrinsic && value.text == "list_len" && length(value.children) == 1 {
        return expanded(context, get(value.children, 0), guard, bindings, locals, self, calls, depth + 1)
    }
    if value.kind == ExprKind.Coerce {
        return expanded(context, get(value.children, 0), guard, bindings, locals, self, calls, depth + 1)
    }
    if value.kind == ExprKind.Field {
        let receiver = expanded(context, get(value.children, 0), guard, bindings, locals, self, calls, depth + 1)?
        return expanded_field(context, value, receiver, depth + 1)
    }
    if value.kind == ExprKind.Record {
        let fields = new[Expr]()
        var index = 0
        while index < length(value.children) {
            let field = get(value.children, index)
            let input = expanded(context, get(field.children, 0), guard, bindings, locals, self, calls, depth + 1)?
            let children = new[Expr]()
            push(children, input)
            push(fields, proof_expr(field, ExprKind.Field, field.ty, "", field.index, children))
            index = index + 1
        }
        return Result.Ok(proof_expr(value, ExprKind.Record, value.ty, "", -1, fields))
    }
    let shape = proof_operation(value)
    if shape.arity < 0 || (value.kind != ExprKind.Intrinsic && !scalar_type(value.ty)) {
        return Result.Err("unsupported helper proof expression")
    }
    let children = new[Expr]()
    var operand = 0
    while operand < shape.arity {
        let child = get(value.children, operand)
        let next = operand_guard(shape.flow, operand, children, guard)
        if operand == 1 && (shape.flow == OperandFlow.And || shape.flow == OperandFlow.Or) && helper_writes(child) {
            // The right operand may rebind helper locals, but only on the
            // evaluated path. Earlier operands already hold immutable values.
            let right = clone(bindings)
            push(children, expanded(context, child, next, right, locals, self, calls, depth + 1)?)
            join_bindings(bindings, right, if shape.flow == OperandFlow.And {
                    get(children, 0)
                } else {
                    proof_not(get(children, 0))
                })
        } else {
            push(children, expanded(context, child, next, bindings, locals, self, calls, depth + 1)?)
        }
        operand = operand + 1
    }
    var observation = -1
    if length(context.observations) != 0 && (list_length_expression(value) || list_read_expression(value) ||
        entry_observation_expression(value)) {
        observation = expanded_observation(context, value)
    }
    let output = proof_expr(value, value.kind, value.ty, value.text, observation, children)
    discard operation_obligation(context, output, guard, shape)?
    Result.Ok(output)
}

// Primitive Float arithmetic is total IEEE arithmetic. Keep evaluation metadata
// separate from equality: a successfully evaluated NaN is not equal to itself.
fn total_scalar(value Expr) Bool {
    let shape = proof_operation(value)
    if shape.arity < 0 || !shape.total {
        return false
    }
    var index = 0
    while index < length(value.children) {
        if !total_scalar(get(value.children, index)) {
            return false
        }
        index = index + 1
    }
    true
}

fn bounded_expression(value Expr) Bool {
    let budget = new[Int]()
    push(budget, 256)
    scalar_structure(value, budget, 0)
}

fn bounded_evaluations(context Expansion) Bool {
    var index = 0
    while index < length(context.checks) {
        let check = get(context.checks, index)
        if !bounded_contract(check.guard) || !bounded_contract(check.value) {
            return false
        }
        index = index + 1
    }
    true
}

fn exact_expression(left Expr, right Expr) Bool {
    let budget = new[Int]()
    push(budget, 512)
    same_structure(left, right, budget)
}

fn known_evaluation(premise Expr, goal Evaluation, source List[Evaluation]) Bool {
    var index = 0
    while index < length(source) {
        let known = get(source, index)
        if !known.universal && (!goal.required || known.required) && exact_expression(goal.value, known.value) &&
        (is_bool(known.guard, true) || exact_expression(goal.guard, known.guard) || implies(premise, guarded_value(goal.guard, known.guard))) {
            return true
        }
        index = index + 1
    }
    false
}

fn evaluation_proved(query ProofQuery, premise Expr, guard Expr, value Expr, required Bool) Result[Bool, Text] {
    let predicate = if required {
        value
    } else {
        proof_expr(value, ExprKind.Binary, 2, "==", -1, proof_children(value, value))
    }
    let condition = normalized_predicate(guarded_value(guard, predicate))?
    let initial = implication_initial(premise, condition)
    let state = established_scalar_condition(premise, initial, 256)?
    condition_or_queue(query, condition, state)
}

fn helper_implication(program Program, premise Expr, conclusion Expr, list_lengths Bool, backend ProofBackend) Result[Bool, Text] {
    let budget = new[Int]()
    push(budget, 1024)
    let binders = new[Int]()
    push(binders, 0)
    let source = Expansion {
        program = program
        list_lengths = list_lengths
        budget = budget
        active = new[Int]()
        checks = new[Evaluation]()
        observations = new[Int]()
        origins = new[ObservationOrigin]()
        binders = binders
    }
    let left = normalized_predicate(expanded(source, premise, proof_bool(premise, true), new[ExpansionBinding](), new[Local](), true, 0, 0)?)?
    let target = Expansion {
        program = program
        list_lengths = list_lengths
        budget = budget
        active = new[Int]()
        checks = new[Evaluation]()
        observations = new[Int]()
        origins = new[ObservationOrigin]()
        binders = binders
    }
    let right = normalized_predicate(expanded(target, conclusion, proof_bool(conclusion, true), new[ExpansionBinding](), new[Local](), true, 0, 0)?)?
    // Parameter substitution can share a small DAG whose unfolded tree is huge.
    // Bound every expression before unbudgeted symbolic/definedness traversal.
    if !bounded_expression(left) || !bounded_expression(right) || !bounded_evaluations(source) || !bounded_evaluations(target) {
        return Result.Ok(false)
    }
    var facts = left
    var index = 0
    while index < length(source.checks) {
        let check = get(source.checks, index)
        if check.required && !check.universal {
            facts = proof_and(facts, normalized_predicate(guarded_value(check.guard, check.value))?)
        }
        index = index + 1
    }
    if !bounded_expression(facts) {
        return Result.Ok(false)
    }
    let query = proof_query(backend)
    index = 0
    while index < length(target.checks) {
        let check = get(target.checks, index)
        if !is_bool(check.guard, false) && !known_evaluation(facts, check, source.checks) {
            if check.required {
                if !implies(facts, normalized_predicate(guarded_value(check.guard, check.value))?) &&
                !evaluation_proved(query, facts, check.guard, check.value, true)? {
                    return Result.Ok(false)
                }
            } else {
                if !total_scalar(check.value) {
                    if !evaluation_proved(query, facts, check.guard, check.value, false)? {
                        return Result.Ok(false)
                    }
                }
            }
        }
        index = index + 1
    }
    if !implication(query, facts, right)? {
        return Result.Ok(false)
    }
    discharge(query)
}

// Inputs belong to this prepared Program and use canonical self local 0. This
// optional query never turns unsupported forms or failed preparation into facts.
pub fn implies_with_helpers(program Program, premise Expr, conclusion Expr) Bool {
    implies_with_helpers(program, premise, conclusion, no_proof_backend())
}

pub fn implies_with_helpers(program Program, premise Expr, conclusion Expr, backend ProofBackend) Bool {
    match helper_implication(program, premise, conclusion, false, backend) {
        Result.Ok(proved) => proved,
        Result.Err(_) => false
    }
}

// Expansion validates the scalar grammar. This bounds its substituted trees
// without imposing refinement implication's canonical self-local identity.
fn contract_size(value Expr, budget List[Int], depth Int) Bool {
    if depth >= 64 || !conjunction_step(budget) {
        return false
    }
    var index = 0
    while index < length(value.children) {
        if !contract_size(get(value.children, index), budget, depth + 1) {
            return false
        }
        index = index + 1
    }
    true
}

fn bounded_contract(value Expr) Bool {
    let budget = new[Int]()
    push(budget, 256)
    contract_size(value, budget, 0)
}

fn contract_at(value Expr, source Expr) Expr {
    let children = new[Expr]()
    var index = 0
    while index < length(value.children) {
        push(children, contract_at(get(value.children, index), source))
        index = index + 1
    }
    proof_expr(source, value.kind, value.ty, value.text, value.index, children)
}

fn contract_clause(output List[Expr], value Expr, source Expr) Result[Bool, Text] {
    let predicate = normalized_predicate(value)?
    if length(output) >= 1024 {
        return Result.Err("contract helper proof expansion budget exhausted")
    }
    push(output, contract_at(predicate, source))
    Result.Ok(true)
}

fn evaluated_bounds(value Expr) Expr {
    let low = proof_expr(value, ExprKind.Integer, 1, "-9223372036854775808", -1, new[Expr]())
    let high = proof_expr(value, ExprKind.Integer, 1, "9223372036854775807", -1, new[Expr]())
    proof_and(proof_expr(value, ExprKind.Binary, 2, ">=", -1, proof_children(value, low)),
        proof_expr(value, ExprKind.Binary, 2, "<=", -1, proof_children(value, high)))
}

fn contract_predicates(program Program, locals List[Local], inputs List[Expr], entry Bool, budget List[Int], observations List[Int], origins List[ObservationOrigin]) Result[List[Expr], Text] {
    let output = new[Expr]()
    let bindings = new[ExpansionBinding]()
    let binders = if length(observations) != 0 {
        observations
    } else {
        let fresh = new[Int]()
        push(fresh, 0)
        fresh
    }
    var index = 0
    while index < length(locals) && length(inputs) > 0 {
        let reference = proof_expr(get(inputs, 0), ExprKind.Local, get(locals, index).ty, "", index, new[Expr]())
        push(bindings, ExpansionBinding {
                local = index
                value = reference
            })
        index = index + 1
    }
    index = 0
    while index < length(inputs) {
        let input = get(inputs, index)
        let context = Expansion {
            program = program
            list_lengths = false
            budget = budget
            active = new[Int]()
            checks = new[Evaluation]()
            observations = observations
            origins = origins
            binders = binders
        }
        let predicate = expanded(context, input, proof_bool(input, true), bindings, locals, false, 0, 0)?
        var check_index = 0
        while check_index < length(context.checks) {
            let check = get(context.checks, check_index)
            if !bounded_contract(check.guard) || !bounded_contract(check.value) {
                return Result.Err("contract helper proof expansion budget exhausted")
            }
            if entry && check.universal {
                // A false scan may stop before later checks execute.
            } else if check.required {
                discard contract_clause(output, guarded_value(check.guard, check.value), input)?
            } else {
                if !total_scalar(check.value) {
                    if entry {
                        // An entry predicate has already run. Successful checked
                        // arithmetic supplies bounds only on the path that ran it.
                        if check.value.ty == 1 {
                            discard contract_clause(output, guarded_value(check.guard, evaluated_bounds(check.value)), input)?
                        }
                    } else {
                        // This value has not executed. Reflexive equality asks the
                        // existing verifier to prove its evaluation defined first,
                        // including arguments and discarded helper calculations.
                        let defined_value = proof_expr(check.value, ExprKind.Binary, 2, "==", -1, proof_children(check.value, check.value))
                        discard contract_clause(output, guarded_value(check.guard, defined_value), input)?
                    }
                }
            }
            check_index = check_index + 1
        }
        discard contract_clause(output, predicate, input)?
        index = index + 1
    }
    Result.Ok(output)
}

fn expanded_contracts(program Program, function Function, observations List[Int]) Result[Function, Text] {
    let budget = new[Int]()
    push(budget, 4096)
    let origins = new[ObservationOrigin]()
    let preconditions = contract_predicates(program, function.locals, function.preconditions, true, budget, observations, origins)?
    let postconditions = contract_predicates(program, function.locals, function.postconditions, false, budget, observations, origins)?
    Result.Ok(Function {
            is_async = function.is_async
            symbol = function.symbol
            arguments = function.arguments
            params = function.params
            result = function.result
            locals = function.locals
            preconditions = preconditions
            postconditions = postconditions
            result_cleanup = function.result_cleanup
            result_local = function.result_local
            body = function.body
            runtime_name = function.runtime_name
            span = function.span
        })
}

// The checked predicate belongs to this prepared closure and uses self local 0.
// Successful construction has already evaluated it: retain guarded helper
// preconditions and arithmetic bounds, not just the helper's Boolean result.
pub fn invariant_predicates(program Program, base Int, predicate Expr) Result[List[Expr], Text] {
    let locals = new[Local]()
    push(locals, Local {
            name = "self"
            ty = base
            mutable = false
            is_scoped = false
        })
    established_predicates(program, locals, predicate)
}

// An already evaluated predicate over stable input snapshots. Unsupported
// effects fail closed; neither declared guarantees nor helper names are axioms.
pub fn established_predicates(program Program, locals List[Local], predicate Expr) Result[List[Expr], Text] {
    let inputs = [predicate]
    let budget = new[Int]()
    push(budget, 4096)
    contract_predicates(program, locals, inputs, true, budget, new[Int](), new[ObservationOrigin]())
}
