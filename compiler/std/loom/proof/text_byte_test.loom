test fn immutable_text_bytes_keep_ranges_identity_and_access_domains() {
    let text = expression(ExprKind.Local, 3, "", 0, [])
    let index = local(1)
    let byte = expression(ExprKind.Intrinsic, 1, "text_byte", -1, [text, index])
    let size = expression(ExprKind.Intrinsic, 1, "text_len", -1, [text])
    let domain = [operation(">=", index, literal("0")), operation("<", index, size)]
    let returned = local(2)
    let range = operation("&&", operation(">=", returned, literal("0")), operation("<=", returned, literal("255")))
    assert verified(contract_fixture([3, 1], 1, byte, [], [range]))
    assert !verified(contract_fixture([3, 1], 1, byte, [], [operation("<", returned, literal("255"))]))
    let yes = expression(ExprKind.Bool, 2, "true", -1, [])
    let identity = operation("==", byte, byte)
    assert verified(contract_fixture([3, 1], 2, yes, domain, [identity]))
    assert !verified(contract_fixture([3, 1], 2, yes, [], [identity]))
    assert !verified(contract_fixture([3, 1], 2, yes, [get(domain, 0)], [identity]))
    assert !verified(contract_fixture([3, 1], 2, yes, [get(domain, 1)], [identity]))
    let eager = operation("==", operation("*", literal("0"), byte), literal("0"))
    assert verified(contract_fixture([3, 1], 2, yes, domain, [eager]))
    assert !verified(contract_fixture([3, 1], 2, yes, [], [eager]))
    let early = operation("||", yes, identity)
    assert verified(contract_fixture([3, 1], 2, yes, [], [early]))
    let first = IntegerTerm.TextByte(TextValue.Variable(0), [IntegerTerm.Linear(variable(1))])
    let other_text = IntegerTerm.TextByte(TextValue.Variable(2), [IntegerTerm.Linear(variable(1))])
    let other_index = IntegerTerm.TextByte(TextValue.Variable(0), [IntegerTerm.Linear(variable(2))])
    assert same_integer_term(first, first, [256])
    assert !same_integer_term(first, other_text, [256])
    assert !same_integer_term(first, other_index, [256])
}
