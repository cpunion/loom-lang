// Materialize hypothetical reads as typed scalar snapshots. Shared mutable
// reads remain independent; sequential reads reuse their current heap version.
// The ordinary expression algebra then proves truth *and* definedness. Never
// execute the predicate as a body assertion: that would assume its own success.
fn contract_observations(proof Verification, value Expr, guard Expr, state State) Result[EntrySnapshot, Text] {
    if quantified_expression(value) {
        let current = quantified_views(proof, value, state, false, 256)?
        return Result.Ok(EntrySnapshot {
                expression = value
                state = current
                entry = current
            })
    }
    match observation_value(value, guard, state) {
        Option.Some(observed) => {
            return Result.Ok(observation_reference(value, observed, state))
        }
        Option.None => {
        }
    }
    let children = new[Expr]()
    var current = state
    var index = 0
    let flow = proof_operation(value).flow
    while index < length(value.children) {
        let next = operand_guard(flow, index, children, guard)
        let observed = contract_observations(proof, get(value.children, index), next, current)?
        push(children, observed.expression)
        current = observed.state
        index = index + 1
    }
    let expression = proof_expr(value, value.kind, value.ty, value.text, value.index, children)
    if list_length_expression(expression) || list_read_expression(expression) {
        let identity = match pure(get(children, 0), current)? {
            Value.List(identity) => identity
            Value.EntryList(_, _) => {
                // A logical entry value observes no current shared storage.
                return Result.Ok(EntrySnapshot {
                        expression = expression
                        state = current
                        entry = current
                    })
            }
            _ => {
                return Result.Err("shared contract observation requires a tracked List")
            }
        }
        let independent = proof.shared && !stable_storage(list_state(identity, current)?)
        let unknown = if list_read_expression(expression) {
            match pure(expression, current) {
                Result.Ok(_) => false
                Result.Err(_) => true
            }
        } else {
            false
        }
        if independent || unknown {
            if independent {
                current = interference(proof, current)
            }
            let observed = if list_read_expression(expression) {
                match entry_element(proof, expression, guard, current) {
                    Result.Ok(outcome) => {
                        current = outcome.state
                        outcome.value
                    }
                    Result.Err(_) => {
                        return Result.Err(if proof.shared {
                                "shared contract observation is not proved interference-safe: indexed access may be invalidated"
                            } else {
                                "postcondition List index is not proved in bounds"
                            })
                    }
                }
            } else {
                pure(expression, current)?
            }
            return Result.Ok(observation_reference(value, observed,
                    with_observation(value, guard, observed, current)))
        }
    }
    Result.Ok(EntrySnapshot {
            expression = expression
            state = current
            entry = current
        })
}
