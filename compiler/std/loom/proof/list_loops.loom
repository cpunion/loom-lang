fn loop_extent_writes(proof Verification, value Expr, entry State, modified List[Int], depth Int) Result[Bool, Text] {
    discard loop_step(proof)?
    if depth <= 0 {
        return Result.Err("loop extent analysis budget exhausted")
    }
    var primitive = if value.kind == ExprKind.Intrinsic {
        value.text
    } else {
        ""
    }
    if value.kind == ExprKind.Call {
        if value.index < 0 || value.index >= length(proof.program.functions) {
            push(modified, -1)
        } else {
            primitive = forwarded_list_operation(proof.program,
                get(proof.program.functions, value.index), 0)
            if primitive == "" && !extent_preserving(proof.program, value) {
                push(modified, -1)
            }
        }
    }
    if primitive == "list_push" && length(value.children) > 0 {
        let identity = match pure(get(value.children, 0), entry) {
            Result.Ok(receiver) => match receiver {
                Value.List(identity) => identity
                _ => -1
            }
            Result.Err(_) => -1
        }
        push(modified, identity)
    }
    var index = 0
    while index < length(value.children) {
        discard loop_extent_writes(proof, get(value.children, index), entry, modified, depth - 1)?
        index = index + 1
    }
    Result.Ok(true)
}

fn loop_list_type(proof Verification, ty Int, depth Int) Bool {
    if depth >= 16 || ty < 0 || ty >= length(proof.program.types) {
        return false
    }
    let shape = get(proof.program.types, ty)
    if shape.kind == TypeKind.List {
        return true
    }
    var index = 0
    while index < length(shape.fields) {
        if loop_list_type(proof, get(shape.fields, index).ty, depth + 1) {
            return true
        }
        index = index + 1
    }
    false
}

fn loop_extents(proof Verification, value Expr, entry State, writes List[Bool]) Result[State, Text] {
    if length(entry.extents) == 0 || extent_preserving(proof.program, value) {
        return Result.Ok(entry)
    }
    // Rebinding can change which handle a resize targets on any iteration.
    // Without a points-to invariant, freshen all possibly reachable extents;
    // never resolve that target using only the pre-loop local value.
    var index = 0
    while index < length(proof.function.locals) {
        if get(writes, index) && loop_list_type(proof, get(proof.function.locals, index).ty, 0) {
            return Result.Ok(forget_extents(proof, entry))
        }
        index = index + 1
    }
    let modified = new[Int]()
    discard loop_extent_writes(proof, value, entry, modified, 64)?
    Result.Ok(forget_modified_extents(proof, entry, modified))
}

// Copy/build loops commonly advance an index with an output length. Propose
// only equalities true at entry; ordinary backedge induction must preserve them.
fn loop_extent_candidates(proof Verification, candidates List[LoopCandidate], writes List[Bool], entry State) Result[Bool, Text] {
    var extent = 0
    while extent < length(entry.extents) {
        let identity = get(entry.extents, extent).identity
        var local = 0
        while local < length(writes) {
            if get(writes, local) {
                discard loop_step(proof)?
                match get(entry.locals, local) {
                    Value.Number(_) => {
                        discard add_loop_candidate(candidates,
                            LoopCandidate.ExtentLocal(identity, local), entry)?
                    }
                    _ => {
                    }
                }
            }
            local = local + 1
        }
        extent = extent + 1
    }
    Result.Ok(true)
}
