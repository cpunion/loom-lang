import std.loom.typed.Expr
import std.loom.typed.ExprKind
import std.list.get
import std.list.length
import std.list.new
import std.list.push
import std.list.set
import std.result.Result

fn boolean(value Value) Result[Predicate, Text] {
    match value {
        Value.Boolean(predicate) => Result.Ok(predicate),
        _ => Result.Err("expected a proof predicate")
    }
}

fn unary(operator Text, value Value) Result[Value, Text] {
    if operator == "~" {
        let term = integer_term(value)?
        match term {
            IntegerTerm.Linear(number) => {
                if length(number.terms) == 0 {
                    return Result.Ok(Value.Number(constant(integer(~machine(number.constant)?))))
                }
            }
            _ => {
            }
        }
        return Result.Ok(Value.Nonlinear(IntegerTerm.Apply(operator, [term])))
    }
    match value {
        Value.Float(term) => float_unary(operator, term)
        Value.Nonlinear(term) => {
            if operator == "-" {
                return integer_operation("-", IntegerTerm.Linear(constant(integer(0))), term)
            }
            Result.Err("unsupported proof unary operation")
        }
        Value.Number(term) => {
            if operator == "-" {
                return Result.Ok(Value.Number(scale(term, integer(-1))))
            }
            Result.Err("unsupported proof unary operation")
        }
        Value.Boolean(predicate) => {
            if operator == "!" {
                return Result.Ok(Value.Boolean(not(predicate)))
            }
            Result.Err("unsupported proof unary operation")
        }
        _ => Result.Err("unsupported proof unary operand")
    }
}

fn numeric(operator Text, a Linear, b Linear) Result[Value, Text] {
    if integer_bitwise(operator) {
        if length(a.terms) == 0 && length(b.terms) == 0 {
            return integer_bitwise_literal(operator, machine(a.constant)?, machine(b.constant)?)
        }
        return integer_operation(operator, IntegerTerm.Linear(a), IntegerTerm.Linear(b))
    }
    if operator == "+" {
        return Result.Ok(Value.Number(add(a, b)))
    }
    if operator == "-" {
        return Result.Ok(Value.Number(add(a, scale(b, integer(-1)))))
    }
    if operator == "*" {
        if length(a.terms) == 0 {
            return Result.Ok(Value.Number(scale(b, a.constant)))
        }
        if length(b.terms) == 0 {
            return Result.Ok(Value.Number(scale(a, b.constant)))
        }
        return integer_operation(operator, IntegerTerm.Linear(a), IntegerTerm.Linear(b))
    }
    if operator == "/" || operator == "%" {
        if length(a.terms) != 0 || length(b.terms) != 0 {
            return integer_operation(operator, IntegerTerm.Linear(a), IntegerTerm.Linear(b))
        }
        let left = machine(a.constant)?
        let right = machine(b.constant)?
        if right == 0 || (left == -9223372036854775808 && right == -1) {
            return Result.Err("undefined proof division")
        }
        let value = if operator == "/" {
            left / right
        } else {
            left % right
        }
        return Result.Ok(Value.Number(constant(integer(value))))
    }
    if operator == "==" || operator == "!=" || operator == "<" || operator == "<=" || operator == ">" || operator == ">=" {
        return Result.Ok(Value.Boolean(Predicate.Compare(operator, add(a, scale(b, integer(-1))))))
    }
    Result.Err("unsupported nonlinear proof arithmetic")
}

fn logical(operator Text, a Predicate, b Predicate) Result[Value, Text] {
    if operator == "&&" {
        return Result.Ok(Value.Boolean(bag_conjunction(a, b)))
    }
    if operator == "||" {
        return Result.Ok(Value.Boolean(Predicate.Or(predicates(a, b))))
    }
    if operator == "==" || operator == "!=" {
        match a {
            Predicate.Constant(value) => {
                let equal = if value {
                    b
                } else {
                    not(b)
                }
                return Result.Ok(Value.Boolean(if operator == "==" {
                            equal
                        } else {
                            not(equal)
                        }))
            }
            _ => {
            }
        }
        match b {
            Predicate.Constant(value) => {
                let equal = if value {
                    a
                } else {
                    not(a)
                }
                return Result.Ok(Value.Boolean(if operator == "==" {
                            equal
                        } else {
                            not(equal)
                        }))
            }
            _ => {
            }
        }
        let equal = if same(a, b) {
            Predicate.Constant(true)
        } else {
            if same(a, not(b)) {
                Predicate.Constant(false)
            } else {
                Predicate.Equal(predicates(a, b))
            }
        }
        return Result.Ok(Value.Boolean(if operator == "==" {
                    equal
                } else {
                    not(equal)
                }))
    }
    Result.Err("unsupported proof Boolean operation")
}

fn binary(operator Text, a Value, b Value) Result[Value, Text] {
    if nonlinear_value(a) || nonlinear_value(b) {
        return integer_operation(operator, integer_term(a)?, integer_term(b)?)
    }
    match a {
        Value.Float(left) => match b {
            Value.Float(right) => float_binary(operator, left, right)
            _ => Result.Err("proof operands differ")
        }
        Value.Number(left) => match b {
            Value.Number(right) => numeric(operator, left, right)
            _ => Result.Err("proof operands differ")
        }
        Value.Boolean(left) => match b {
            Value.Boolean(right) => logical(operator, left, right)
            _ => Result.Err("proof operands differ")
        }
        Value.Text(left) => match b {
            Value.Text(right) => {
                if operator != "==" && operator != "!=" {
                    return Result.Err("unsupported Text proof operation")
                }
                // Equal immutable symbolic values have equal bytes. Distinct
                // identities are not evidence of inequality: parameters may
                // contain the same Text, even with different native storage.
                if distinct_text_literals(left, right) {
                    return Result.Ok(Value.Boolean(Predicate.Constant(operator == "!=")))
                }
                if same_text(left, right) {
                    return Result.Ok(Value.Boolean(Predicate.Constant(operator == "==")))
                }
                let equal = Predicate.TextEqual(left, right)
                Result.Ok(Value.Boolean(if operator == "==" {
                            equal
                        } else {
                            not(equal)
                        }))
            }
            _ => Result.Err("proof operands differ")
        }
        _ => Result.Err("unsupported proof operand")
    }
}

fn pure(expr Expr, state State) Result[Value, Text] {
    if bound_expression(expr) {
        return Result.Ok(Value.Number(variable(expr.index)))
    }
    if quantified_expression(expr) {
        return Result.Ok(Value.Boolean(quantified_predicate(expr, state)?))
    }
    if count_expression(expr) {
        return counted_value(expr, state)
    }
    if observation_expression(expr) {
        match observation_value(expr, proof_bool(expr, true), state) {
            Option.Some(value) => {
                return Result.Ok(value)
            }
            Option.None => {
            }
        }
    }
    if expr.kind == ExprKind.Float {
        return Result.Ok(Value.Float(float_literal(expr.text)?))
    }
    if expr.kind == ExprKind.Integer {
        return Result.Ok(Value.Number(constant(decimal(expr.text))))
    }
    if expr.kind == ExprKind.Bool {
        return Result.Ok(Value.Boolean(Predicate.Constant(expr.text == "true")))
    }
    if expr.kind == ExprKind.Text {
        return Result.Ok(Value.Text(TextValue.Literal(expr.text)))
    }
    if expr.kind == ExprKind.Local {
        return Result.Ok(get(state.locals, expr.index))
    }
    if expr.kind == ExprKind.Coerce {
        return match pure(get(expr.children, 0), state)? {
            Value.Projected(contents, path, index) => Result.Ok(projected_value(contents, path, index, expr.ty))
            value => Result.Ok(value)
        }
    }
    if expr.kind == ExprKind.Field {
        match pure(get(expr.children, 0), state)? {
            Value.Record(fields) => {
                if expr.index < 0 || expr.index >= length(fields) {
                    return Result.Err("invalid proof record field")
                }
                return Result.Ok(get(fields, expr.index))
            }
            Value.Projected(contents, path, index) => {
                return Result.Ok(projected_value(contents, projection_field(path, expr.index), index, expr.ty))
            }
            _ => {
                return Result.Err("field proof requires a scalar record")
            }
        }
    }
    if expr.kind == ExprKind.Record {
        let fields = new[Value]()
        var index = 0
        while index < length(expr.children) {
            push(fields, Value.Empty)
            index = index + 1
        }
        index = 0
        while index < length(expr.children) {
            let field = get(expr.children, index)
            if field.kind != ExprKind.Field || field.index < 0 || field.index >= length(fields) {
                return Result.Err("invalid proof record initializer")
            }
            set(fields, field.index, pure(get(field.children, 0), state)?)
            index = index + 1
        }
        return Result.Ok(Value.Record(fields))
    }
    if expr.kind == ExprKind.Variant && expr.index >= 0 {
        let fields = new[Value]()
        var index = 0
        while index < length(expr.children) {
            push(fields, pure(get(expr.children, index), state)?)
            index = index + 1
        }
        // A known constructor needs only its selected payload. Parameter and
        // body values retain the complete checked nominal variant set.
        return Result.Ok(variant_value(expr.ty, expr.index, expr.index + 1, fields))
    }
    let shape = proof_operation(expr)
    if shape.arity < 0 || shape.flow == OperandFlow.Choice {
        return Result.Err("unsupported expression in required proof")
    }
    let inputs = new[Value]()
    var index = 0
    while index < shape.arity {
        if index == 1 && (shape.flow == OperandFlow.And || shape.flow == OperandFlow.Or) {
            let fact = boolean(get(inputs, 0))?
            let and = shape.flow == OperandFlow.And
            if holds(if and {
                    not(fact)
                } else {
                    fact
                }, state.facts) {
                return Result.Ok(Value.Boolean(Predicate.Constant(!and)))
            }
        }
        push(inputs, pure(get(expr.children, index), state)?)
        index = index + 1
    }
    if expr.kind == ExprKind.Unary {
        return unary(expr.text, get(inputs, 0))
    }
    if expr.kind == ExprKind.Binary {
        return binary(expr.text, get(inputs, 0), get(inputs, 1))
    }
    if expr.kind == ExprKind.Intrinsic {
        return intrinsic_value(expr.text, expr.ty, inputs, state)
    }
    Result.Err("unsupported expression in required proof")
}

fn bounded(value Value, state State) State {
    match value {
        Value.Sum(_, tag, payloads) => assume(assume(state,
                Predicate.Compare(">=", tag)),
            Predicate.Compare("<", add(tag, constant(integer(-length(payloads)))))),
        Value.Nonlinear(term) => assume(assume(state,
                integer_limit(">=", term, -9223372036854775808)),
            integer_limit("<=", term, 9223372036854775807))
        Value.Number(term) => {
            let low = Predicate.Compare(">=", add(term, constant(negate(integer(-9223372036854775808)))))
            let high = Predicate.Compare("<=", add(term, constant(integer(-9223372036854775807))))
            assume(assume(state, low), high)
        }
        _ => list_bounds(value, text_bounds(value, state))
    }
}

// Postcondition arithmetic has not executed. Establish definedness from facts;
// unlike body arithmetic, never assume a hypothetical overflow check passed.
fn defined(expr Expr, state State) Result[Bool, Text] {
    if bound_expression(expr) {
        return Result.Ok(true)
    }
    if quantified_expression(expr) {
        return quantified_defined(expr, state)
    }
    if observation_expression(expr) {
        match observation_value(expr, proof_bool(expr, true), state) {
            Option.Some(_) => {
                return Result.Ok(true)
            }
            Option.None => {
            }
        }
    }
    // Checked literals and stable scalar reads cannot fault. Do not rescan
    // the entire fact set for contradictions at every leaf of a predicate.
    if expr.kind == ExprKind.Integer || expr.kind == ExprKind.Float || expr.kind == ExprKind.Bool || expr.kind == ExprKind.Text || expr.kind == ExprKind.Local {
        return Result.Ok(true)
    }
    if holds(Predicate.Constant(false), state.facts) {
        return Result.Ok(true)
    }
    let shape = proof_operation(expr)
    if shape.arity < 0 {
        return Result.Err("unsupported operation in proof definedness")
    }
    var index = 0
    while index < shape.arity {
        var branch = state
        if index > 0 && shape.flow != OperandFlow.Eager {
            let guard = operand_guard(shape.flow, index, expr.children, proof_bool(expr, true))
            branch = difference_facts(assume(state, boolean(pure(guard, state)?)?))
        }
        discard defined(get(expr.children, index), branch)?
        index = index + 1
    }
    if expr.kind == ExprKind.Intrinsic {
        return intrinsic_defined(expr, state)
    }
    if (expr.kind == ExprKind.Unary && expr.text == "-") ||
    (expr.kind == ExprKind.Binary && (expr.text == "+" || expr.text == "-" || expr.text == "*" || expr.text == "/" || expr.text == "%" ||
            expr.text == "<<" || expr.text == ">>")) {
        if !holds(arithmetic_guard(expr, state)?, state.facts) {
            return Result.Err("postcondition arithmetic operand domain is not proved defined")
        }
        let value = pure(expr, state)?
        match value {
            Value.Float(_) => {
                // IEEE arithmetic is total, including overflow and division
                // by zero. It has no Int overflow obligation.
            }
            Value.Nonlinear(term) => {
                if !holds(integer_limit(">=", term, -9223372036854775808), state.facts) ||
                !holds(integer_limit("<=", term, 9223372036854775807), state.facts) {
                    return Result.Err("postcondition arithmetic is not proved defined")
                }
            }
            Value.Number(term) => {
                let bounds = range(term, state.facts)
                if compare(bounds.low, bounds.high) <= 0 &&
                (compare(bounds.low, integer(-9223372036854775808)) < 0 || compare(bounds.high, integer(9223372036854775807)) > 0) {
                    let low = Predicate.Compare(">=", add(term, constant(negate(integer(-9223372036854775808)))))
                    let high = Predicate.Compare("<=", add(term, constant(integer(-9223372036854775807))))
                    if !holds(low, state.facts) || !holds(high, state.facts) {
                        return Result.Err("postcondition arithmetic is not proved defined")
                    }
                }
            }
            _ => {
                return Result.Err("expected scalar proof arithmetic")
            }
        }
    }
    Result.Ok(true)
}
