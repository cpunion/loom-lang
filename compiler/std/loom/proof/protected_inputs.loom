// The source checker validates continuing predicates and permitted writes.
// Read-only bodies and handle spelling alone supply neither guarantee.
pub record InputGuarantee {
    ty Int
    // 0: no writes; 1: element replacement; 2: replacement and proved append.
    writes Int
}

fn protected_verification(proof Verification, protected List[InputGuarantee]) Verification {
    Verification {
        function = proof.function
        program = proof.program
        fresh = proof.fresh
        budget = proof.budget
        loop_control = proof.loop_control
        query = proof.query
        shared = proof.shared
        preservation = proof.preservation
        identity_stores = proof.identity_stores
        protected = protected
        body_calls = proof.body_calls
        capture_returns = proof.capture_returns
        returns = proof.returns
    }
}

fn input_guarantee(types List[InputGuarantee], ty Int) Option[InputGuarantee] {
    var index = 0
    while index < length(types) {
        let guarantee = get(types, index)
        if guarantee.ty == ty {
            return Option.Some(guarantee)
        }
        index = index + 1
    }
    Option.None
}

fn protected_extent(identity Int, guarantee InputGuarantee, state State) State {
    let extents = new[ListExtent]()
    var index = 0
    while index < length(state.extents) {
        let extent = get(state.extents, index)
        push(extents, ListExtent {
                identity = extent.identity
                size = extent.size
                allocated = extent.allocated
                birth_floor = extent.birth_floor
                private_storage = extent.private_storage
                read_only = extent.read_only || (extent.identity == identity && guarantee.writes == 0)
                fixed_extent = extent.fixed_extent || (extent.identity == identity && guarantee.writes <= 1)
                invariant_type = if extent.identity == identity {
                    guarantee.ty
                } else {
                    extent.invariant_type
                }
                frontier = extent.frontier
                unreachable = extent.unreachable
                contents = extent.contents
                cells = extent.cells
            })
        index = index + 1
    }
    State {
        locals = state.locals
        facts = state.facts
        extents = extents
        observations = state.observations
    }
}

fn protected_input(types List[Type], protected List[InputGuarantee], ty Int, value Value, state State, depth Int) State {
    if ty < 6 || ty >= length(types) || depth >= 16 {
        return state
    }
    let shape = get(types, ty)
    if shape.kind == TypeKind.Refined && length(shape.fields) == 1 {
        let current = protected_input(types, protected, get(shape.fields, 0).ty, value, state, depth + 1)
        match input_guarantee(protected, ty) {
            Option.Some(guarantee) => match value {
                Value.List(identity) => {
                    return protected_extent(identity, guarantee, current)
                }
                _ => {
                }
            }
            Option.None => {
            }
        }
        return current
    }
    if record_input_shape(shape) {
        match value {
            Value.Record(fields) => {
                var current = state
                var index = 0
                while index < length(fields) && index < length(shape.fields) {
                    current = protected_input(types, protected, get(shape.fields, index).ty,
                        get(fields, index), current, depth + 1)
                    index = index + 1
                }
                return current
            }
            _ => {
            }
        }
    }
    if shape.kind == TypeKind.Enum {
        match value {
            Value.Sum(_, _, payloads) => {
                var current = state
                var variant = 0
                while variant < length(payloads) && variant < length(shape.variants) {
                    let fields = get(payloads, variant)
                    let types_in_variant = get(shape.variants, variant).fields
                    var field = 0
                    while field < length(fields) && field < length(types_in_variant) {
                        current = protected_input(types, protected, get(types_in_variant, field),
                            get(fields, field), current, depth + 1)
                        field = field + 1
                    }
                    variant = variant + 1
                }
                return current
            }
            _ => {
            }
        }
    }
    state
}

fn invariant_reads_stable(value Expr, state State) Bool {
    if list_read_expression(value) || list_length_expression(value) {
        match pure(get(value.children, 0), state) {
            Result.Ok(receiver) => match receiver {
                Value.List(identity) => match list_state(identity, state) {
                    Result.Ok(extent) => {
                        if !stable_storage(extent) && !(list_length_expression(value) && extent.fixed_extent) {
                            return false
                        }
                    }
                    Result.Err(_) => {
                        return false
                    }
                }
                Value.EntryList(_, _) => {
                }
                _ => {
                    return false
                }
            }
            _ => {
                return false
            }
        }
    }
    var index = 0
    while index < length(value.children) {
        if !invariant_reads_stable(get(value.children, index), state) {
            return false
        }
        index = index + 1
    }
    true
}

// Length snapshots keep the continuing predicate for that sampled extent, not
// an equality with current storage or hypothetical entry/path assumptions.
fn captured_input_invariants(proof Verification, before State, after State) State {
    var scope = State {
        locals = after.locals
        facts = after.facts
        extents = before.extents
        observations = after.observations
    }
    var index = 0
    while index < length(before.extents) {
        let extent = get(before.extents, index)
        if extent.invariant_type >= 6 {
            scope = invariant_facts(proof.program.types, extent.invariant_type,
                Value.List(extent.identity), scope, 0)
        }
        index = index + 1
    }
    State {
        locals = after.locals
        facts = scope.facts
        extents = after.extents
        observations = after.observations
    }
}
