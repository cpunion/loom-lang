// Only the source checker's validated, no-write constrained types provide this
// evidence. A read-only function body or handle spelling supplies none.
fn protected_type(types List[Int], ty Int) Bool {
    var index = 0
    while index < length(types) {
        if get(types, index) == ty {
            return true
        }
        index = index + 1
    }
    false
}

fn protected_extent(identity Int, state State) State {
    let extents = new[ListExtent]()
    var index = 0
    while index < length(state.extents) {
        let extent = get(state.extents, index)
        push(extents, ListExtent {
                identity = extent.identity
                size = extent.size
                allocated = extent.allocated
                private_storage = extent.private_storage
                read_only = extent.read_only || extent.identity == identity
                contents = extent.contents
                cells = extent.cells
            })
        index = index + 1
    }
    State {
        locals = state.locals
        facts = state.facts
        extents = extents
        observations = state.observations
    }
}

fn protected_input(types List[Type], protected List[Int], ty Int, value Value, state State, depth Int) State {
    if ty < 6 || ty >= length(types) || depth >= 16 {
        return state
    }
    let shape = get(types, ty)
    if shape.kind == TypeKind.Refined && length(shape.fields) == 1 {
        let current = protected_input(types, protected, get(shape.fields, 0).ty, value, state, depth + 1)
        if protected_type(protected, ty) {
            match value {
                Value.List(identity) => {
                    return protected_extent(identity, current)
                }
                _ => {
                }
            }
        }
        return current
    }
    if shape.kind == TypeKind.Record || shape.kind == TypeKind.Tuple {
        match value {
            Value.Record(fields) => {
                var current = state
                var index = 0
                while index < length(fields) && index < length(shape.fields) {
                    current = protected_input(types, protected, get(shape.fields, index).ty,
                        get(fields, index), current, depth + 1)
                    index = index + 1
                }
                return current
            }
            _ => {
            }
        }
    }
    state
}

fn invariant_reads_stable(value Expr, state State) Bool {
    if list_read_expression(value) || list_length_expression(value) {
        match pure(get(value.children, 0), state) {
            Result.Ok(receiver) => match receiver {
                Value.List(identity) => match list_state(identity, state) {
                    Result.Ok(extent) => {
                        if !stable_storage(extent) {
                            return false
                        }
                    }
                    Result.Err(_) => {
                        return false
                    }
                }
                Value.EntryList(_, _) => {
                }
                _ => {
                    return false
                }
            }
            _ => {
                return false
            }
        }
    }
    var index = 0
    while index < length(value.children) {
        if !invariant_reads_stable(get(value.children, index), state) {
            return false
        }
        index = index + 1
    }
    true
}
