import std.loom.typed.Type
import std.loom.typed.TypeKind
import std.loom.typed.Expr
import std.loom.typed.ExprKind
import std.list.new
import std.list.push
import std.list.get
import std.list.length
import std.result.Result

// Construction has already established this predicate. Rebind only self to
// the actual immutable value, never to the caller's local slot zero.
fn invariant_predicate(predicate Expr, value Value, state State) State {
    if predicate.kind == ExprKind.Binary && predicate.text == "&&" {
        let left = invariant_predicate(get(predicate.children, 0), value, state)
        return invariant_predicate(get(predicate.children, 1), value, left)
    }
    let locals = new[Value]()
    push(locals, value)
    match pure(predicate, State {
            locals = locals
            facts = state.facts
            extents = state.extents
            observations = state.observations
        }) {
        Result.Ok(known) => match known {
            Value.Boolean(fact) => assume(state, fact)
            _ => state
        }
        // Templates may contain unbound helper calls or arithmetic outside the
        // scalar proof fragment. Unknown facts supply no evidence.
        Result.Err(_) => state
    }
}

// A typed read preserves scalar/inline facts. It does not renew a mutable
// container predicate after a possibly overlapping write invalidated it.
fn stable_invariant_predicate(predicate Expr, value Value, state State) State {
    if predicate.kind == ExprKind.Binary && predicate.text == "&&" {
        return stable_invariant_predicate(get(predicate.children, 1), value,
            stable_invariant_predicate(get(predicate.children, 0), value, state))
    }
    if entry_guard_expression(predicate) {
        return invariant_predicate(predicate, value, state)
    }
    state
}

fn invariant_facts(types List[Type], ty Int, value Value, state State, depth Int) State {
    invariant_facts(types, ty, value, state, depth, true)
}

fn invariant_facts(types List[Type], ty Int, value Value, state State, depth Int, heap Bool) State {
    // Built-in scalar/opaque IDs have no type predicates. Avoid loading their
    // aggregate Type metadata for every ordinary parameter or record leaf.
    if ty < 6 || depth >= 16 || ty >= length(types) {
        return state
    }
    let shape = get(types, ty)
    if capture_cell_shape(shape) {
        return match value {
            Value.List(identity) => fixed_capture_cell(identity, state)
            _ => state
        }
    }
    let observed = match value {
        Value.Projected(contents, path, index) => projected_type_value(types, ty, contents, path, index, depth)
        _ => value
    }
    if shape.kind == TypeKind.Refined && length(shape.fields) == 1 {
        var known = invariant_facts(types, get(shape.fields, 0).ty, observed, state, depth + 1, heap)
        var index = 0
        while index < length(shape.constraint) {
            let predicate = get(shape.constraint, index)
            if bounded_contract(predicate) {
                known = if heap {
                    invariant_predicate(predicate, observed, known)
                } else {
                    stable_invariant_predicate(predicate, observed, known)
                }
            }
            index = index + 1
        }
        return known
    }
    if record_input_shape(shape) {
        match observed {
            Value.Record(fields) => {
                var known = state
                var index = 0
                while index < length(fields) && index < length(shape.fields) {
                    known = invariant_facts(types, get(shape.fields, index).ty,
                        get(fields, index), known, depth + 1, heap)
                    index = index + 1
                }
                return known
            }
            _ => {
            }
        }
    }
    if shape.kind == TypeKind.Enum {
        let tag = match enum_projection("proof_enum_tag", 1, [observed]) {
            Result.Ok(value) => match integer_term(value) {
                Result.Ok(term) => term
                Result.Err(_) => {
                    return state
                }
            }
            Result.Err(_) => {
                return state
            }
        }
        var known = assume(assume(state, integer_limit(">=", tag, 0)),
            integer_limit("<", tag, length(shape.variants)))
        var variant = 0
        while variant < length(shape.variants) {
            let selected = integer_predicate("==", tag, IntegerTerm.Linear(constant(integer(variant))))
            let fields = get(shape.variants, variant).fields
            var field = 0
            while field < length(fields) {
                let field_ty = get(fields, field)
                match enum_projection("proof_enum_payload", field_ty,
                    [observed, Value.Number(constant(integer(variant))), Value.Number(constant(integer(field)))]) {
                    Result.Ok(payload) => {
                        let represented = match payload {
                            Value.Projected(contents, path, index) =>
                            projected_type_value(types, field_ty, contents, path, index, depth + 1)
                            _ => payload
                        }
                        known = guarded_type_invariants(types, field_ty, represented, selected, known, depth + 1, heap)
                    }
                    Result.Err(_) => {
                    }
                }
                field = field + 1
            }
            variant = variant + 1
        }
        return known
    }
    // Content type invariants do not supply indexed observations here.
    // A length predicate is an entry fact;
    // mutation or opaque calls must not retain it for a fresh current extent.
    state
}

// A successful typed boundary establishes the value's own predicate, not facts
// about another invocation or the storage from which this value was read.
fn typed_value_state(proof Verification, ty Int, value Value, state State) State {
    let bounded = task_private_value(proof, ty, value, bounded(value, state))
    let protected = if length(proof.protected) != 0 {
        protected_input(proof.program.types, proof.protected, ty, value, bounded, 0)
    } else {
        bounded
    }
    invariant_facts(proof.program.types, ty, value, protected, 0, false)
}

// Hypothetical entry reads establish a typed value only where the access is
// valid. Export those new facts with their premise, never the temporary guard.
fn guarded_value_invariants(proof Verification, ty Int, value Value, valid Predicate, state State) State {
    guarded_type_invariants(proof.program.types, ty, value, valid, state, 0)
}

fn guarded_type_invariants(types List[Type], ty Int, value Value,
    valid Predicate, state State, depth Int) State {
    guarded_type_invariants(types, ty, value, valid, state, depth, true)
}

fn guarded_type_invariants(types List[Type], ty Int, value Value,
    valid Predicate, state State, depth Int, heap Bool) State {
    let known = invariant_facts(types, ty, value, integer_input_bounds(value, state), depth, heap)
    if loop_holds(valid, state) {
        return known
    }
    var current = state
    var index = length(state.facts)
    while index < length(known.facts) {
        current = assume(current, Predicate.Or(predicates(not(valid), get(known.facts, index))))
        index = index + 1
    }
    current
}

// Refinements share their representation; inline fields select distinct array
// columns. Shared children stay opaque and supply no hypothetical heap facts.
fn projected_type_value(types List[Type], ty Int, contents Int, path List[Int], index Linear, depth Int) Value {
    if ty < 6 || depth >= 16 || ty >= length(types) {
        return projected_value(contents, path, index, ty)
    }
    let shape = get(types, ty)
    if shape.kind == TypeKind.Refined && length(shape.fields) == 1 {
        return projected_type_value(types, get(shape.fields, 0).ty, contents, path, index, depth + 1)
    }
    if shape.kind == TypeKind.Record || shape.kind == TypeKind.Tuple {
        let fields = new[Value]()
        var field = 0
        while field < length(shape.fields) {
            push(fields, projected_type_value(types, get(shape.fields, field).ty, contents,
                    projection_field(path, field), index, depth + 1))
            field = field + 1
        }
        return Value.Record(fields)
    }
    Value.Projected(contents, path, index)
}

// Checked element types hold only on the logical version's valid indices.
// The version's fresh positive ID also names its binder, distinct from source
// scan binders and scalar symbols. Repeated views then reuse the same formula.
// Export the element's type facts, never the scan's own bounds or result.
fn quantified_type_invariants(proof Verification, primitive Text, ty Int,
    contents Int, size Linear, state State) Result[State, Text] {
    if contents < 0 {
        return Result.Ok(state)
    }
    let value = projected_type_value(proof.program.types, ty, contents, new[Int](), variable(contents), 0)
    let known = sequence_read_state(primitive, value,
        guarded_value_invariants(proof, ty, value, Predicate.Constant(true), text_bounds(value, state)))?
    var current = state
    var index = length(state.facts)
    while index < length(known.facts) {
        current = assume(current, Predicate.Forall(contents, constant(integer(0)), size,
                predicates(get(known.facts, index))))
        index = index + 1
    }
    Result.Ok(current)
}
