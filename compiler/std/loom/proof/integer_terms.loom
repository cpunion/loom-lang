// Preserve compact affine values on the fast path. Non-affine arithmetic uses
// an expression algebra over the same symbols, never an application-specific
// predicate or an unconstrained fresh name for a product.
fn integer_term(value Value) Result[IntegerTerm, Text] {
    match value {
        Value.Number(term) => Result.Ok(IntegerTerm.Linear(term))
        Value.Nonlinear(term) => Result.Ok(term)
        _ => Result.Err("expected integer proof operands")
    }
}

fn nonlinear_value(value Value) Bool {
    match value {
        Value.Nonlinear(_) => true
        _ => false
    }
}

fn integer_value(term IntegerTerm) Value {
    match term {
        IntegerTerm.Linear(value) => Value.Number(value)
        _ => Value.Nonlinear(term)
    }
}

fn added_integer_terms(left IntegerTerm, right IntegerTerm) IntegerTerm {
    match left {
        IntegerTerm.Linear(a) => match right {
            IntegerTerm.Linear(b) => {
                return IntegerTerm.Linear(add(a, b))
            }
            _ => {
            }
        }
        _ => {
        }
    }
    IntegerTerm.Apply("+", [left, right])
}

fn integer_predicate(relation Text, left IntegerTerm, right IntegerTerm) Predicate {
    match left {
        IntegerTerm.Linear(a) => match right {
            IntegerTerm.Linear(b) => {
                return Predicate.Compare(relation, add(a, scale(b, integer(-1))))
            }
            _ => {
            }
        }
        _ => {
        }
    }
    Predicate.IntegerCompare(relation, left, right)
}

fn integer_operation(operator Text, left IntegerTerm, right IntegerTerm) Result[Value, Text] {
    if operator == "==" || operator == "!=" || operator == "<" || operator == "<=" || operator == ">" || operator == ">=" {
        return Result.Ok(Value.Boolean(Predicate.IntegerCompare(operator, left, right)))
    }
    if operator != "+" && operator != "-" && operator != "*" && !integer_division(operator) {
        return Result.Err("unsupported symbolic integer operation")
    }
    let inputs = new[IntegerTerm]()
    push(inputs, left)
    push(inputs, right)
    Result.Ok(Value.Nonlinear(IntegerTerm.Apply(operator, inputs)))
}

fn integer_division(operator Text) Bool {
    operator == "/" || operator == "%"
}

// Both operations fault on zero and MIN / -1, even though the mathematical
// remainder would be zero. Result bounds alone cannot establish definedness.
fn integer_division_guard(left IntegerTerm, right IntegerTerm) Predicate {
    Predicate.And(predicates(integer_limit("!=", right, 0),
            not(Predicate.And(predicates(integer_limit("==", left, -9223372036854775808),
                        integer_limit("==", right, -1))))))
}

fn arithmetic_guard(expr Expr, state State) Result[Predicate, Text] {
    if expr.kind == ExprKind.Binary && expr.ty == 1 && integer_division(expr.text) {
        return Result.Ok(integer_division_guard(integer_term(pure(get(expr.children, 0), state)?)?,
                integer_term(pure(get(expr.children, 1), state)?)?))
    }
    Result.Ok(Predicate.Constant(true))
}

fn same_integer_term(left IntegerTerm, right IntegerTerm, budget List[Int]) Bool {
    if get(budget, 0) <= 0 {
        return false
    }
    set(budget, 0, get(budget, 0) - 1)
    match left {
        IntegerTerm.TextLength(text) => match right {
            IntegerTerm.TextLength(other) => same_text(text, other)
            _ => false
        }
        IntegerTerm.Count(identity, inputs) => match right {
            IntegerTerm.Count(other, values) => {
                if identity != other || length(inputs) != length(values) {
                    return false
                }
                var index = 0
                while index < length(inputs) {
                    if !same_integer_term(get(inputs, index), get(values, index), budget) {
                        return false
                    }
                    index = index + 1
                }
                true
            }
            _ => false
        }
        IntegerTerm.Linear(first) => match right {
            IntegerTerm.Linear(second) => compare(first.constant, second.constant) == 0 &&
            same_terms(first.terms, second.terms)
            _ => false
        }
        IntegerTerm.Apply(operator, inputs) => match right {
            IntegerTerm.Apply(other, values) => {
                if operator != other || length(inputs) != length(values) {
                    return false
                }
                var index = 0
                while index < length(inputs) {
                    if !same_integer_term(get(inputs, index), get(values, index), budget) {
                        return false
                    }
                    index = index + 1
                }
                true
            }
            _ => false
        }
        IntegerTerm.Select(identity, path, index) => match right {
            IntegerTerm.Select(other, fields, position) => identity == other && same_projection(path, fields) &&
            compare(index.constant, position.constant) == 0 && same_terms(index.terms, position.terms)
            _ => false
        }
    }
}

fn same_projection(left List[Int], right List[Int]) Bool {
    if length(left) != length(right) {
        return false
    }
    var index = 0
    while index < length(left) {
        if get(left, index) != get(right, index) {
            return false
        }
        index = index + 1
    }
    true
}

fn integer_limit(relation Text, value IntegerTerm, limit Int) Predicate {
    integer_predicate(relation, value, IntegerTerm.Linear(constant(integer(limit))))
}
