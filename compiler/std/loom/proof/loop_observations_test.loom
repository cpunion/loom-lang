test fn affine_observations_follow_current_inline_values_not_initial_headers() {
    let entry = with_extent(42, constant(integer(3)), true,
        with_extent(43, constant(integer(5)), true, State {
                locals = [Value.Record([Value.List(42), Value.Number(constant(integer(2)))])]
                facts = []
                extents = []
                observations = []
            }))
    let terms = [LoopTerm {
            observation = LoopObservation.Local(0, [0])
            factor = integer(1)
        }, LoopTerm {
            observation = LoopObservation.Local(0, [1])
            factor = integer(1)
        }]
    let candidate = LoopCandidate.Affine(terms, "==", Value.Number(constant(integer(5))))
    let proof = verification(fixture(literal("0"), [], literal("true")), empty_proof_program())
    assert loop_candidate_preserved(proof, candidate, entry)
    let rebound = assigned(entry, 0, Value.Record([Value.List(43), Value.Number(constant(integer(2)))]))
    assert !loop_candidate_preserved(proof, candidate, rebound)
    assert match loop_observation_value(LoopObservation.Storage(42), rebound) {
        Result.Ok(value) => index_relation("==", value, constant(integer(3)), rebound)
        _ => false
    }
    let resized = with_extent(43, constant(integer(3)), true, rebound)
    assert loop_candidate_preserved(proof, candidate, resized)
    let unavailable = assigned(resized, 0, Value.Empty)
    assert match loop_predicate(candidate, unavailable) {
        Result.Err(_) => true
        _ => false
    }
}

test fn unpublished_loop_headers_retain_alias_overlap_and_require_every_backedge() {
    let entry = with_extent(10, constant(integer(1)), true,
        list_bounds(Value.List(20), State {
                locals = [Value.Record([Value.List(20)])]
                facts = []
                extents = []
                observations = []
            }))
    let candidate = LoopCandidate.Unpublished(0, [0])
    let proof = verification(fixture(literal("0"), [], literal("true")), empty_proof_program())
    assert !loop_candidate_preserved(proof, candidate, entry)
    let head = match loop_separated_head(0, get(entry.locals, 0), [candidate], entry) {
        Result.Ok(value) => value
        Result.Err(_) => {
            assert false
            return
        }
    }
    assert loop_candidate_preserved(proof, candidate, head)
    assert loop_header_count([candidate]) == 1
    let sampled = get(head.extents, 0)
    assert sampled.private_storage && !sampled.allocated
    assert extent_overlap(sampled, get(head.extents, 1))
    assert !loop_candidate_preserved(proof, candidate, published_storage(head))
}
