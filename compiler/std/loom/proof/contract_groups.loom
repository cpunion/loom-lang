pub record ContractGroupFailure {
    function Int
    message Text
}

// Partial correctness by induction on finite call depth: each member may use
// the group's declared normal-return guarantees, but every member body must
// prove its own guarantee. No result escapes if any proof fails. Predicates
// still expand actual finite pure bodies; recursion supplies no predicate axiom
// or termination promise. Non-members are independently checked host evidence.
pub fn verify_contract_group(program Program, members List[Bool], backend ProofBackend)
Result[List[List[Expr]], ContractGroupFailure] {
    if length(members) != length(program.functions) {
        return Result.Err(ContractGroupFailure {
                function = -1
                message = "invalid contract group membership"
            })
    }
    // Normalize each member's own obligations, but retain source-form summaries
    // in the closure. Calls expand them at their invocation boundary; normalizing
    // the entire closure first would expand safety clauses a second time.
    let conditions = new[List[Expr]]()
    var index = 0
    while index < length(program.functions) {
        if get(members, index) {
            let proof = match contract_verification(program, get(program.functions, index), backend, false) {
                Result.Ok(value) => value
                Result.Err(message) => {
                    return Result.Err(ContractGroupFailure {
                            function = index
                            message = message
                        })
                }
            }
            if length(proof.function.postconditions) != 0 {
                match verify_body(proof) {
                    Result.Ok(_) => {
                    }
                    Result.Err(message) => {
                        return Result.Err(ContractGroupFailure {
                                function = index
                                message = message
                            })
                    }
                }
            }
            push(conditions, proof.function.postconditions)
        } else {
            push(conditions, new[Expr]())
        }
        index = index + 1
    }
    // Publish only after every member passes. Callers keep source summaries in
    // their closure and may retain these call-free clauses for this snapshot.
    Result.Ok(conditions)
}
