pub record ContractGroupFailure {
    function Int
    message Text
}

// Partial correctness by induction on finite call depth: each member may use
// the group's declared normal-return guarantees, but every member body must
// prove its own guarantee. No result escapes if any proof fails. Predicates
// still expand actual finite pure bodies; recursion supplies no predicate axiom
// or termination promise. Non-members are independently checked host evidence.
pub fn verify_contract_group(program Program, members List[Bool], backend ProofBackend)
Result[Program, ContractGroupFailure] {
    if length(members) != length(program.functions) {
        return Result.Err(ContractGroupFailure {
                function = -1
                message = "invalid contract group membership"
            })
    }
    let proofs = new[Verification](length(program.functions))
    let functions = new[Function](length(program.functions))
    var index = 0
    while index < length(program.functions) {
        let proof = match contract_verification(program, get(program.functions, index), backend, false) {
            Result.Ok(value) => value
            Result.Err(message) => {
                return Result.Err(ContractGroupFailure {
                        function = index
                        message = message
                    })
            }
        }
        push(proofs, proof)
        push(functions, proof.function)
        index = index + 1
    }
    let normalized = Program {
        types = program.types
        functions = functions
        entry = program.entry
        tests = program.tests
        test_names = program.test_names
        exports = program.exports
        interfaces = program.interfaces
        witnesses = program.witnesses
    }
    index = 0
    while index < length(proofs) {
        let previous = get(proofs, index)
        if get(members, index) && length(previous.function.postconditions) != 0 {
            let proof = Verification {
                function = previous.function
                program = normalized
                fresh = previous.fresh
                budget = previous.budget
                loop_control = previous.loop_control
                query = previous.query
                shared = previous.shared
                preservation = previous.preservation
                returns = previous.returns
            }
            match verify_body(proof) {
                Result.Ok(_) => {
                }
                Result.Err(message) => {
                    return Result.Err(ContractGroupFailure {
                            function = index
                            message = message
                        })
                }
            }
        }
        index = index + 1
    }
    Result.Ok(normalized)
}
