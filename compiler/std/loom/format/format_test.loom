fn formatted(text Text) Text {
    match format(text) {
        Result.Ok(value) => value
        Result.Err(_) => {
            assert false
            ""
        }
    }
}

fn tree(text Text) Node {
    match parse(text) {
        Result.Ok(value) => value
        Result.Err(_) => {
            assert false
            tree("")
        }
    }
}

fn same_tree(left Node, right Node) Bool {
    if left.kind != right.kind || left.value != right.value || length(left.children) != length(right.children) {
        return false
    }
    var index = 0
    while index < length(left.children) {
        if !same_tree(get(left.children, index), get(right.children, index)) {
            return false
        }
        index = index + 1
    }
    true
}

fn round_trip(text Text) Text {
    let output = formatted(text)
    assert formatted(output) == output
    assert same_tree(tree(text), tree(output))
    output
}

test fn record_update_bases_format_as_a_final_field() {
    assert round_trip("""
        fn f(value Pair) Pair{Pair{first=1,..value}}
        """) == """
        fn f(value Pair) Pair {
            Pair {
                first = 1,
                ..value
            }
        }

        """
}

test fn record_semicolons_format_as_newlines_without_losing_comments() {
    assert round_trip("record Pair { first Int; second fn() Int; }") ==
    """
        record Pair {
            first Int
            second fn() Int
        }

        """
    assert round_trip("record Pair { first Int; // first\nsecond Text; // second\n}") ==
    """
        record Pair {
            first Int // first
            second Text // second
        }

        """
    discard round_trip("pub record Callbacks[T] { first fn(); second fn(T) T }")
}

test fn guarded_arms_format_without_changing_scope_or_condition() {
    assert round_trip("fn f(x Int) Int{match x{n if n>0=>n\n_=>0}}") ==
    """
        fn f(x Int) Int {
            match x {
                n if n > 0 => n
                _ => 0
            }
        }

        """
    discard round_trip("fn f(v Item) Int {match v{Item { value = n, .. } if { // guard\nn > 0 }=>n\n_=>0}}")
}

test fn inline_members_and_blocks_get_structural_line_breaks() {
    assert round_trip("fn f(v Box) {let Box{value=item,..}=v\nvar Box{value=(first,second)},_=other}") ==
    """
        fn f(v Box) {
            let Box {
                value = item,
                ..
            } = v
            var Box {
                value = (first, second)
            }, _ = other
        }

        """
    assert round_trip("fn f(v Pair) Int {match v{Pair{second=0,first=n,..}=>n\n_=>0}}") ==
    """
        fn f(v Pair) Int {
            match v {
                Pair {
                    second = 0,
                    first = n,
                    ..
                } => n
                _ => 0
            }
        }

        """
    discard round_trip("fn f(v Pair) Int {match v{Pair { first = n // binding\n.. // omitted\n}=>n}}")
    assert round_trip("record Pair[T] { first T; second Int }\nenum Choice[T] { None Some(T) }\nfn main(){ let x=Pair { first=1 second=2 }\nif x.first==1 { assert true } else { discard x } }") ==
    """
        record Pair[T] {
            first T
            second Int
        }

        enum Choice[T] {
            None
            Some(T)
        }

        fn main() {
            let x = Pair {
                first = 1
                second = 2
            }
            if x.first == 1 {
                assert true
            } else {
                discard x
            }
        }

        """
}

test fn imports_generics_contracts_and_control_flow_preserve_meaning() {
    discard round_trip("fn unchanged(x Int) Int ensures result==old(x){x}")
    discard round_trip("fn f(){scoped resource=acquire()\nif true{scoped next Resource=acquire()}\ndefer{finish()} }")
    assert round_trip("fn f() List[Int]{return[1,2]}\nfn g(){let xs List[List[Int]]=[[],[1]]\ndiscard xs}") ==
    """
        fn f() List[Int] {
            return [1, 2]
        }

        fn g() {
            let xs List[List[Int]] = [[], [1]]
            discard xs
        }

        """
    discard round_trip("fn f() { discard [\n1, // first\n2,\n] }")
    discard round_trip("fn f(){ while true { if false { continue }\nbreak } }")
    discard round_trip("import std.list.new\nimport std.list.push\npub concept C { type Item[T]\nfn map[T](self Self, value T) T }\nimpl C for Int { type Item[T] = List[T]\nfn map[T](self Int,value T) T { value } }\nfn twice(x Int) Int requires x>=0 ensures result==x+x { x+x }\nfn f[T](x T) (T,Int) {\nvar n=0\nwhile n<2 { n=n+1 }\ndefer { discard n }\n(x, n)\n}\n")
    discard round_trip("fn f(x Int) Int { match x { _ => if true { 1 } else { 2 } } }\nfn g(){ comptime if Int==Int { } else if false { } }")
    discard round_trip("fn f(v Result[Option[(Int, Text)], Text]) Int {match v{Result.Ok(Option.Some((number, // name\nlabel)))=>number\nResult.Ok(Option.None)=>0\nResult.Err(_)=>-1}}")
    assert round_trip("fn visit[Ts...](values Ts...){comptime for item in values{discard item}}") ==
    """
        fn visit[Ts...](values Ts...) {
            comptime for item in values {
                discard item
            }
        }

        """
}

test fn multiline_groups_postfix_and_unary_operators_stay_parseable() {
    discard round_trip("""
        fn visit[Ts...](values Ts...) {
            comptime for index,item in values { discard (index,item) }
            discard comptime map index,T in Ts { index }
        }
        """)
    assert round_trip("fn f(){call(1,pair...,other()...)\nlet copy=(pair...)\nlet list=[0,pair...,3]}") ==
    """
        fn f() {
            call(1, pair..., other()...)
            let copy = (pair...)
            let list = [0, pair..., 3]
        }

        """
    assert round_trip("fn f(){let(a,(b,_))=(1,(2,true))\nvar(c,)=(3,)}") ==
    """
        fn f() {
            let (a, (b, _)) = (1, (2, true))
            var (c,) = (3,)
        }

        """
    discard round_trip("fn f(){let ((a,), // binding\n_), (b,c) = (((1,),true),(2,3))\nvar d,(e,_)= (a,(b,c))\nlet (single,)=(d,)}")
    discard round_trip("pub async fn f[T](value T) T { value }\ntest async fn example(){let task=f(1)\ndiscard task.await}\nasync fn chained(){discard f(1).await?}")
    assert round_trip("fn f(){let xs=[1,2]\nxs[ 0 ]=xs[1]+1\ndiscard xs[0]}\n") == """
        fn f() {
            let xs = [1, 2]
            xs[0] = xs[1] + 1
            discard xs[0]
        }

        """
    discard round_trip("fn f(){discard matrix[i+1][choose()]\ndiscard callbacks[i](identity[Int](2))\ndiscard (holder()).items[0]}\n")
    discard round_trip("fn call[T](value T) T { value }\nfn f(x Int) Int { let tuple=(\n-x,\n-(-1),\n)\nlet values List[\n(Int,Int),\n]=call[\nList[(Int,Int)]\n](\ncall[List[(Int,Int)]](missing()),\n)\ndiscard values\n(call(x)+\ntuple.0) }")
    assert round_trip("fn f(x Int) Int { -x - -1 }\n") == """
        fn f(x Int) Int {
            -x - -1
        }

        """
    discard round_trip("fn f(){ discard 1 .0\ndiscard 1.0 .0\ndiscard ({ if true {} if false {} }) }")
}

test fn grouped_operands_have_spaces_but_calls_and_unary_prefixes_do_not() {
    assert round_trip("fn f(){let x=(1,2)\nlet y=1+(2*3)\nassert true&&(!false||true)\ndiscard choose(x,(y))\ndiscard -(1+2)\ndiscard !(false)\n}") ==
    """
        fn f() {
            let x = (1, 2)
            let y = 1 + (2 * 3)
            assert true && (!false || true)
            discard choose(x, (y))
            discard -(1 + 2)
            discard !(false)
        }

        """
    assert round_trip("fn f(x Int) Int requires(x>0) ensures(result>0){match x{_ =>(x)}}") ==
    """
        fn f(x Int) Int
        requires (x > 0)
        ensures (result > 0) {
            match x {
                _ => (x)
            }
        }

        """
    let calls = "fn f(){discard callbacks[0](1)\ndiscard (factory())(2)\ndiscard factory()?(3)\ndiscard (pair.0)(4)}"
    assert round_trip(calls) == """
        fn f() {
            discard callbacks[0](1)
            discard (factory())(2)
            discard factory()?(3)
            discard (pair.0)(4)
        }

        """
}

test fn comments_unicode_and_literal_spelling_are_not_rewritten() {
    assert round_trip("fn f(v Float) Int {match v{-0.00=>0\n1e0=>1\n_=>2}}") ==
    """
        fn f(v Float) Int {
            match v {
                -0.00 => 0
                1e0 => 1
                _ => 2
            }
        }

        """
    discard round_trip("fn f(v (Text, Bool)) Int {match v{(\"\\u{96ea}\", true)=>1\n_=>0}}")
    assert round_trip("// 注释\r\nrecord 数据 { 值 Text // 字段\r\n}\r\nfn 名称(){ // body\r\nlet 文本=\"a\\n\\u{41}\\\"\" // tail\r\nlet 数值=00012\r\nlet 浮点=1.20e+03\r\ndiscard 文本\r\ndiscard 数值\r\ndiscard 浮点\r\n}// end") ==
    """
        // 注释
        record 数据 {
            值 Text // 字段
        }

        fn 名称() { // body
            let 文本 = "a\n\u{41}\"" // tail
            let 数值 = 00012
            let 浮点 = 1.20e+03
            discard 文本
            discard 数值
            discard 浮点
        } // end

        """
    assert round_trip("// only\n\n") == """
        // only

        """
    assert round_trip("") == ""
    discard round_trip("fn f(){ // first\n// second\nlet x=(1, // item\n2)\ndiscard x\n}")
    assert round_trip("fn f(){}\n// g documentation\nfn g(){\nlet x=1\n\n\ndiscard x\n}\n\n") ==
    """
        fn f() {
        }

        // g documentation
        fn g() {
            let x = 1

            discard x
        }

        """
}

test fn multiline_text_preserves_content_and_delimiter_spelling() {
    discard round_trip(""""
        fn greeting() Text{ // outside
        """
          // text, not a comment
          { "quoted": "\n雪" }

            extra indent
          """ // after the delimiter
        }
        """")
    discard round_trip("""""
        fn source() Text {
            """"
                """
                nested text
                """
                """"
        }
        """"")
}

test fn invalid_source_reports_the_original_parser_diagnostic() {
    match format("fn f() { let x: Int = 1 }") {
        Result.Err(error) => {
            assert error.span.start == 14
        }
        Result.Ok(_) => {
            assert false
        }
    }
}
