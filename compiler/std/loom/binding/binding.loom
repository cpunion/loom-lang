import std.loom.source.Diagnostic
import std.loom.ast.Node
import std.loom.ast.NodeKind
import std.loom.ast.has
import std.loom.project.SourceFile
import std.loom.project.name
import std.loom.project.package
import std.loom.project.qualify
import std.list.new
import std.list.push
import std.list.get
import std.list.length
import std.result.Result

pub record Failure { source Int diagnostic Diagnostic }
pub record Symbol { file Int node Node name Text public Bool test_only Bool }
record Lookup { path Text symbols List[Int] }
record Scope { package Text production List[Lookup] testing List[Lookup] }
// Source-file and symbol indices are local to this binding result. Rebind after
// editing its input files or trees; the cached scopes are not an editing model.
pub record Program {
    files List[SourceFile]
    symbols List[Symbol]
    root Text
    tests Bool
    scopes List[Scope]
    file_scopes List[Int]
}

fn failure(file Int, node Node, message Text) Failure {
    Failure { source = file diagnostic = Diagnostic { span = node.span message = message } }
}
fn builtin(name Text) Bool {
    name == "Int" || name == "Bool" || name == "Text" || name == "Bytes" || name == "List" || name == "Unit"
}
fn contains(values List[Text], value Text) Bool {
    var index = 0
    while index < length(values) {
        if get(values, index) == value { return true }
        index = index + 1
    }
    false
}
fn data(kind NodeKind) Bool {
    kind == NodeKind.Record || kind == NodeKind.Enum || kind == NodeKind.Refined
}
fn selected(source SourceFile, root Text, tests Bool) Bool {
    !source.test_only || (tests && source.package == root)
}

fn add_lookup(lookups List[Lookup], path Text, symbol Int) {
    var index = 0
    while index < length(lookups) {
        let lookup = get(lookups, index)
        if lookup.path == path {
            push(lookup.symbols, symbol)
            return
        }
        index = index + 1
    }
    let symbols = new[Int]()
    push(symbols, symbol)
    push(lookups, Lookup { path = path symbols = symbols })
}
fn add_names(lookups List[Lookup], short Text, path Text, symbol Int) {
    add_lookup(lookups, short, symbol)
    if path != short { add_lookup(lookups, path, symbol) }
}

// Resolve package-wide imports once. Iterating the symbol table here preserves
// declaration order, including overloads interleaved across local/imported files.
fn scope(files List[SourceFile], symbols List[Symbol], paths List[Text], package Text, testing Bool) Scope {
    let production_imports = new[Text]()
    let test_imports = new[Text]()
    var index = 0
    while index < length(files) {
        let source = get(files, index)
        if source.package == package && (!source.test_only || testing) {
            var item = 0
            while item < length(source.tree.children) {
                let node = get(source.tree.children, item)
                if node.kind == NodeKind.Import {
                    if source.test_only { push(test_imports, node.value) }
                    else { push(production_imports, node.value) }
                }
                item = item + 1
            }
        }
        index = index + 1
    }
    let production = new[Lookup]()
    let tests = if testing { new[Lookup]() } else { production }
    index = 0
    while index < length(symbols) {
        let symbol = get(symbols, index)
        let target = get(files, symbol.file).package
        if target == package || symbol.public {
            let path = get(paths, index)
            let visible = target == package || contains(production_imports, path)
            if visible && !symbol.test_only { add_names(production, symbol.name, path, index) }
            if testing && (visible || contains(test_imports, path)) &&
                (!symbol.test_only || target == package) {
                add_names(tests, symbol.name, path, index)
            }
        }
        index = index + 1
    }
    Scope { package = package production = production testing = tests }
}

// Lookups return fresh candidate lists; overload selection belongs to typing.
// A test file's imports and declarations never extend production's scope.
pub fn candidates(program Program, file Int, test_only Bool, path Text) List[Int] {
    let scope = get(program.scopes, get(program.file_scopes, file))
    let testing = test_only && program.tests && scope.package == program.root
    let lookups = if testing { scope.testing } else { scope.production }
    let matches = new[Int]()
    var index = 0
    while index < length(lookups) {
        let lookup = get(lookups, index)
        if lookup.path == path {
            var item = 0
            while item < length(lookup.symbols) {
                push(matches, get(lookup.symbols, item))
                item = item + 1
            }
            return matches
        }
        index = index + 1
    }
    matches
}

fn names(file Int, nodes List[Node], reserved_types Bool) Result[Bool, Failure] {
    let seen = new[Text]()
    var index = 0
    while index < length(nodes) {
        let node = get(nodes, index)
        if contains(seen, node.value) || (reserved_types && builtin(node.value)) {
            return Result.Err(failure(file, node, if reserved_types {
                "duplicate or reserved type parameter"
            } else { "duplicate declaration member" }))
        }
        push(seen, node.value)
        index = index + 1
    }
    Result.Ok(true)
}
fn declaration_names(file Int, node Node) Result[Bool, Failure] {
    let members = new[Node]()
    var index = 0
    while index < length(node.children) {
        let child = get(node.children, index)
        if child.kind == NodeKind.TypeParameters { discard names(file, child.children, true)? }
        if child.kind == NodeKind.Parameters { discard names(file, child.children, false)? }
        if child.kind == NodeKind.Field || child.kind == NodeKind.Variant { push(members, child) }
        index = index + 1
    }
    discard names(file, members, false)?
    if node.kind == NodeKind.Enum && length(members) == 0 {
        return Result.Err(failure(file, node, "an enum needs at least one variant"))
    }
    Result.Ok(true)
}
fn accessible_import(program Program, file Int, path Text) Bool {
    let source = get(program.files, file)
    let target = package(path)
    let short = name(path)
    var index = 0
    while index < length(program.symbols) {
        let symbol = get(program.symbols, index)
        if symbol.name == short && get(program.files, symbol.file).package == target &&
            (symbol.public || source.package == target) &&
            (!symbol.test_only || (source.test_only && source.package == target)) {
            return true
        }
        index = index + 1
    }
    false
}
fn imports(program Program) Result[Bool, Failure] {
    var file = 0
    while file < length(program.files) {
        let source = get(program.files, file)
        if selected(source, program.root, program.tests) {
            var index = 0
            while index < length(source.tree.children) {
                let node = get(source.tree.children, index)
                if node.kind == NodeKind.Import {
                    if package(node.value) == "" {
                        return Result.Err(failure(file, node, "imports name a module/package and declaration"))
                    }
                    if !accessible_import(program, file, node.value) {
                        return Result.Err(failure(file, node, "import does not name an accessible declaration"))
                    }
                }
                index = index + 1
            }
        }
        file = file + 1
    }
    Result.Ok(true)
}

// Tests extend only the selected root package; production scopes stay separate.
pub fn bind(files List[SourceFile], root Text, tests Bool) Result[Program, Failure] {
    let symbols = new[Symbol]()
    let paths = new[Text]()
    var file = 0
    while file < length(files) {
        let source = get(files, file)
        if selected(source, root, tests) {
            var index = 0
            while index < length(source.tree.children) {
                let node = get(source.tree.children, index)
                let test_only = source.test_only || has(node, NodeKind.Test)
                if node.kind != NodeKind.Import && (!test_only || (tests && source.package == root)) {
                    discard declaration_names(file, node)?
                    if data(node.kind) {
                        if builtin(node.value) {
                            return Result.Err(failure(file, node, "duplicate or reserved data declaration"))
                        }
                        var other = 0
                        while other < length(symbols) {
                            let existing = get(symbols, other)
                            if data(existing.node.kind) && existing.name == node.value &&
                                get(files, existing.file).package == source.package {
                                return Result.Err(failure(file, node, "duplicate or reserved data declaration"))
                            }
                            other = other + 1
                        }
                    }
                    if has(node, NodeKind.Intrinsic) && (!source.trusted_std || test_only || has(node, NodeKind.Public)) {
                        return Result.Err(failure(file, node, "intrinsics are private declarations of the trusted standard library"))
                    }
                    push(symbols, Symbol { file = file node = node name = node.value
                        public = has(node, NodeKind.Public) test_only = test_only })
                    push(paths, qualify(source.package, node.value))
                }
                index = index + 1
            }
        }
        file = file + 1
    }
    let scopes = new[Scope]()
    let file_scopes = new[Int]()
    file = 0
    while file < length(files) {
        let package = get(files, file).package
        var index = 0
        while index < length(scopes) && get(scopes, index).package != package { index = index + 1 }
        if index == length(scopes) { push(scopes, scope(files, symbols, paths, package, tests && package == root)) }
        push(file_scopes, index)
        file = file + 1
    }
    let program = Program { files = files symbols = symbols root = root tests = tests
        scopes = scopes file_scopes = file_scopes }
    discard imports(program)?
    Result.Ok(program)
}
