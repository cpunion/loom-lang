import std.loom.typed.Expr
import std.loom.typed.ExprKind
import std.loom.typed.TypeKind
import std.loom.typed.contains_tasks
import std.list.get
import std.list.push
import std.list.length
import std.result.Result
import std.text.concat

fn pure_intrinsic(name Text) Bool {
    name == "float_from_int" || name == "float_to_int" || name == "float_parse" || name == "float_format" ||
    name == "text_len" || name == "text_byte" || name == "text_concat" || name == "text_equal" || name == "text_slice" ||
    name == "unicode_alphabetic" || name == "unicode_alphanumeric" || name == "unicode_whitespace" ||
    name == "list_new" || name == "list_len" || name == "list_get" || name == "list_push" || name == "list_set" || name == "list_append" || name == "list_take" || name == "list_replace" ||
    name == "bytes_new" || name == "bytes_len" || name == "bytes_push" || name == "bytes_get" || name == "bytes_set" ||
    name == "bytes_utf8" || name == "bytes_text_copy"
}

fn task_type(state State, ty Int) Bool {
    if ty < 0 || ty >= length(state.program.types) {
        return false
    }
    if ty <= 5 { return false }
    while length(state.task_types) <= ty { push(state.task_types, -1) }
    if get(state.task_types, ty) >= 0 { return get(state.task_types, ty) == 1 }
    let found = std.loom.typed.contains_tasks(state.program.types, ty, std.list.new[Int]())
    set(state.task_types, ty, if found { 1 } else { 0 })
    found
}

fn scan_function(state State, expr Expr, target Int, seen List[Int], depth Int) Result[Bool, Failure] {
    if target < 0 || target >= length(state.program.functions) {
        return Result.Err(failure(expr, "compile-time call has no checked function body"))
    }
    var index = 0
    while index < length(seen) && get(seen, index) != target {
        index = index + 1
    }
    if index < length(seen) {
        return Result.Ok(true)
    }
    push(seen, target)
    let function = get(state.program.functions, target)
    if function.is_async {
        return Result.Err(failure(expr, "compile-time evaluation cannot create or await tasks"))
    }
    if task_type(state, function.result) {
        return Result.Err(failure(expr, "compile-time evaluation cannot transfer tasks"))
    }
    index = 0
    while index < length(function.params) {
        if task_type(state, get(function.params, index)) {
            return Result.Err(failure(expr, "compile-time evaluation cannot transfer tasks"))
        }
        index = index + 1
    }
    if function.runtime_name != "" && !pure_intrinsic(function.runtime_name) {
        return Result.Err(failure(expr, concat("compile-time evaluation forbids intrinsic ", function.runtime_name)))
    }
    // A called function cannot transfer control into its caller's loop.
    discard scan(state, function.body, seen, depth + 1, 0)?
    index = 0
    while index < length(function.preconditions) {
        discard scan(state, get(function.preconditions, index), seen, depth + 1, 0)?
        index = index + 1
    }
    index = 0
    while index < length(function.postconditions) {
        discard scan(state, get(function.postconditions, index), seen, depth + 1, 0)?
        index = index + 1
    }
    Result.Ok(true)
}

fn scan(state State, expr Expr, seen List[Int], depth Int, loops Int) Result[Bool, Failure] {
    if expr.kind == ExprKind.TaskCall || expr.kind == ExprKind.Await || expr.kind == ExprKind.Suspend {
        return Result.Err(failure(expr, "compile-time evaluation cannot create or await tasks"))
    }
    if task_type(state, expr.ty) {
        return Result.Err(failure(expr, "compile-time evaluation cannot transfer tasks"))
    }
    if depth >= 256 {
        return Result.Err(failure(expr, "compile-time expression depth exhausted"))
    }
    discard spend(state, expr, 0, 1)?
    if (expr.kind == ExprKind.Break || expr.kind == ExprKind.Continue) && loops == 0 {
        return Result.Err(failure(expr, "compile-time loop control escaped its loop"))
    }
    if expr.kind == ExprKind.Deferred {
        return Result.Err(failure(expr, "compile-time expression still has unresolved types"))
    }
    if expr.ty >= 0 && expr.ty < length(state.program.types) && get(state.program.types, expr.ty).kind == TypeKind.Associated {
        return Result.Err(failure(expr, "compile-time expression still has an unresolved associated type"))
    }
    if state.partial && expr.kind != ExprKind.Integer && expr.kind != ExprKind.Float && expr.kind != ExprKind.Bool && expr.kind != ExprKind.Text &&
    expr.kind != ExprKind.Local && expr.kind != ExprKind.Unary && expr.kind != ExprKind.Binary && expr.kind != ExprKind.Coerce {
        return Result.Err(failure(expr, "expression is not a call-free scalar constant"))
    }
    if expr.kind == ExprKind.Intrinsic && !pure_intrinsic(expr.text) {
        return Result.Err(failure(expr, concat("compile-time evaluation forbids intrinsic ", expr.text)))
    }
    if expr.kind == ExprKind.Call || expr.kind == ExprKind.FunctionRef {
        discard scan_function(state, expr, expr.index, seen, depth)?
    }
    if expr.kind == ExprKind.DynCall {
        discard scan_dynamic(state, expr, seen, depth)?
    }
    var index = 0
    while index < length(expr.children) {
        // Registration does not execute the body, but its effects still belong
        // to this computation's purity closure. Cleanup has its own loop scope.
        let nested = if expr.kind == ExprKind.Defer || expr.kind == ExprKind.Cleanup {
            0
        } else {
            if expr.kind == ExprKind.While && index == 1 {
                loops + 1
            } else {
                loops
            }
        }
        discard scan(state, get(expr.children, index), seen, depth + 1, nested)?
        index = index + 1
    }
    index = 0
    while index < length(expr.arms) {
        let arm = get(expr.arms, index)
        var item = 0
        while item < length(arm.body) {
            discard scan(state, get(arm.body, item), seen, depth + 1, loops)?
            item = item + 1
        }
        index = index + 1
    }
    Result.Ok(true)
}
