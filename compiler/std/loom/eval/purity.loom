import std.loom.typed.Expr
import std.loom.typed.ExprKind
import std.loom.typed.TypeKind
import std.loom.typed.contains_tasks
import std.list.get
import std.list.push
import std.list.length
import std.result.Result
import std.text.concat

record Effects { state State references List[Expr] calls List[Expr] }

// Naming a callback does not execute it. Indirect calls add obligations for
// every reachable reference of their checked shape, including later discoveries.
fn purity(state State, expr Expr) Result[Bool, Failure] {
    // Optional scalar folding never needs callback queues or target discovery.
    if state.partial { return scalar_purity(state, expr, 0) }
    let effects = Effects { state = state references = std.list.new[Expr]() calls = std.list.new[Expr]() }
    let seen = std.list.new[Int]()
    discard scan(effects, expr, seen, 0, 0)?
    var references = -1
    var calls = -1
    while references != length(effects.references) || calls != length(effects.calls) {
        references = length(effects.references)
        calls = length(effects.calls)
        var index = 0
        while index < length(effects.calls) {
            let call = get(effects.calls, index)
            let shape = get(call.children, 0).ty
            var reference = 0
            while reference < length(effects.references) {
                discard spend(state, call, 0, 1)?
                let value = get(effects.references, reference)
                if value.ty == shape { discard scan_function(effects, call, value.index, seen, 0)? }
                reference = reference + 1
            }
            index = index + 1
        }
    }
    var index = 0
    while index < length(effects.calls) {
        let call = get(effects.calls, index)
        var found = false
        var reference = 0
        while reference < length(effects.references) {
            discard spend(state, call, 0, 1)?
            if get(effects.references, reference).ty == get(call.children, 0).ty { found = true }
            reference = reference + 1
        }
        if !found { return Result.Err(failure(call, "compile-time indirect call has no checked target")) }
        index = index + 1
    }
    Result.Ok(true)
}

fn scalar_purity(state State, expr Expr, depth Int) Result[Bool, Failure] {
    if task_type(state, expr.ty) { return Result.Err(failure(expr, "compile-time evaluation cannot transfer tasks")) }
    if depth >= 256 { return Result.Err(failure(expr, "compile-time expression depth exhausted")) }
    discard spend(state, expr, 0, 1)?
    if expr.kind != ExprKind.Integer && expr.kind != ExprKind.Float && expr.kind != ExprKind.Bool && expr.kind != ExprKind.Text &&
        expr.kind != ExprKind.Local && expr.kind != ExprKind.Unary && expr.kind != ExprKind.Binary && expr.kind != ExprKind.Coerce {
        return Result.Err(failure(expr, "expression is not a call-free scalar constant"))
    }
    if expr.ty >= 0 && expr.ty < length(state.program.types) && get(state.program.types, expr.ty).kind == TypeKind.Associated {
        return Result.Err(failure(expr, "compile-time expression still has an unresolved associated type"))
    }
    var index = 0
    while index < length(expr.children) {
        discard scalar_purity(state, get(expr.children, index), depth + 1)?
        index = index + 1
    }
    Result.Ok(true)
}

fn pure_intrinsic(name Text) Bool {
    name == "float_from_int" || name == "float_to_int" || name == "float_parse" || name == "float_format" ||
    name == "text_len" || name == "text_byte" || name == "text_concat" || name == "text_equal" || name == "text_slice" ||
    name == "unicode_alphabetic" || name == "unicode_alphanumeric" || name == "unicode_whitespace" ||
    name == "list_new" || name == "list_len" || name == "list_get" || name == "list_push" || name == "list_set" || name == "list_append" || name == "list_take" || name == "list_replace" ||
    name == "bytes_new" || name == "bytes_len" || name == "bytes_push" || name == "bytes_get" || name == "bytes_set" ||
    name == "bytes_utf8" || name == "bytes_text_copy"
}

fn task_type(state State, ty Int) Bool {
    if ty < 0 || ty >= length(state.program.types) {
        return false
    }
    if ty <= 5 { return false }
    while length(state.task_types) <= ty { push(state.task_types, -1) }
    if get(state.task_types, ty) >= 0 { return get(state.task_types, ty) == 1 }
    let found = std.loom.typed.contains_tasks(state.program.types, ty, std.list.new[Int]())
    set(state.task_types, ty, if found { 1 } else { 0 })
    found
}

fn reference_signature(state State, expr Expr, target Int) Result[Bool, Failure] {
    if target < 0 || target >= length(state.program.functions) {
        return Result.Err(failure(expr, "compile-time call has no checked function body"))
    }
    let function = get(state.program.functions, target)
    if function.is_async {
        return Result.Err(failure(expr, "compile-time evaluation cannot create or await tasks"))
    }
    if task_type(state, function.result) {
        return Result.Err(failure(expr, "compile-time evaluation cannot transfer tasks"))
    }
    var index = 0
    while index < length(function.params) {
        if task_type(state, get(function.params, index)) {
            return Result.Err(failure(expr, "compile-time evaluation cannot transfer tasks"))
        }
        index = index + 1
    }
    Result.Ok(true)
}

fn scan_function(effects Effects, expr Expr, target Int, seen List[Int], depth Int) Result[Bool, Failure] {
    let state = effects.state
    discard reference_signature(state, expr, target)?
    var index = 0
    while index < length(seen) && get(seen, index) != target { index = index + 1 }
    if index < length(seen) { return Result.Ok(true) }
    push(seen, target)
    let function = get(state.program.functions, target)
    if function.runtime_name != "" && !pure_intrinsic(function.runtime_name) {
        return Result.Err(failure(expr, concat("compile-time evaluation forbids intrinsic ", function.runtime_name)))
    }
    // A called function cannot transfer control into its caller's loop.
    discard scan(effects, function.body, seen, depth + 1, 0)?
    index = 0
    while index < length(function.preconditions) {
        discard scan(effects, get(function.preconditions, index), seen, depth + 1, 0)?
        index = index + 1
    }
    index = 0
    while index < length(function.postconditions) {
        discard scan(effects, get(function.postconditions, index), seen, depth + 1, 0)?
        index = index + 1
    }
    Result.Ok(true)
}

fn scan(effects Effects, expr Expr, seen List[Int], depth Int, loops Int) Result[Bool, Failure] {
    let state = effects.state
    if expr.kind == ExprKind.TaskCall || expr.kind == ExprKind.Await || expr.kind == ExprKind.Suspend {
        return Result.Err(failure(expr, "compile-time evaluation cannot create or await tasks"))
    }
    if task_type(state, expr.ty) {
        return Result.Err(failure(expr, "compile-time evaluation cannot transfer tasks"))
    }
    if depth >= 256 {
        return Result.Err(failure(expr, "compile-time expression depth exhausted"))
    }
    discard spend(state, expr, 0, 1)?
    if (expr.kind == ExprKind.Break || expr.kind == ExprKind.Continue) && loops == 0 {
        return Result.Err(failure(expr, "compile-time loop control escaped its loop"))
    }
    if expr.kind == ExprKind.Deferred {
        return Result.Err(failure(expr, "compile-time expression still has unresolved types"))
    }
    if expr.ty >= 0 && expr.ty < length(state.program.types) && get(state.program.types, expr.ty).kind == TypeKind.Associated {
        return Result.Err(failure(expr, "compile-time expression still has an unresolved associated type"))
    }
    if expr.kind == ExprKind.Intrinsic && !pure_intrinsic(expr.text) {
        return Result.Err(failure(expr, concat("compile-time evaluation forbids intrinsic ", expr.text)))
    }
    if expr.kind == ExprKind.Call {
        discard scan_function(effects, expr, expr.index, seen, depth)?
    }
    if expr.kind == ExprKind.FunctionRef {
        if expr.index < 0 || expr.index >= length(state.program.functions) {
            return Result.Err(failure(expr, "compile-time call has no checked function body"))
        }
        var index = 0
        var found = false
        while index < length(effects.references) {
            discard spend(state, expr, 0, 1)?
            let value = get(effects.references, index)
            if value.ty == expr.ty && value.index == expr.index { found = true }
            index = index + 1
        }
        if !found { push(effects.references, expr) }
    }
    if expr.kind == ExprKind.IndirectCall {
        discard child(expr, 0)?
        push(effects.calls, expr)
    }
    if expr.kind == ExprKind.DynCall {
        discard scan_dynamic(effects, expr, seen, depth)?
    }
    var index = 0
    while index < length(expr.children) {
        // Registration does not execute the body, but its effects still belong
        // to this computation's purity closure. Cleanup has its own loop scope.
        let nested = if expr.kind == ExprKind.Defer || expr.kind == ExprKind.Cleanup {
            0
        } else {
            if expr.kind == ExprKind.While && index == 1 {
                loops + 1
            } else {
                loops
            }
        }
        discard scan(effects, get(expr.children, index), seen, depth + 1, nested)?
        index = index + 1
    }
    index = 0
    while index < length(expr.arms) {
        let arm = get(expr.arms, index)
        var item = 0
        while item < length(arm.body) {
            discard scan(effects, get(arm.body, item), seen, depth + 1, loops)?
            item = item + 1
        }
        index = index + 1
    }
    Result.Ok(true)
}
