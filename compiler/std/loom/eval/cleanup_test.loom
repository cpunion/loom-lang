import std.loom.typed.Expr
import std.loom.typed.ExprKind
import std.list.new
import std.list.push

test fn cleanup_markers_delay_execution_and_preserve_local_updates() {
    let body = grouped(one(assigned(0, binary("+", 1, local(0, 1), literal(2)))))
    let registered = node(ExprKind.Defer, 0, "", 0, one(body))
    let cleaned = node(ExprKind.Cleanup, 0, "", 0, one(body))
    let statements = two(assigned(0, literal(1)), registered)
    push(statements, node(ExprKind.Assert, 0, "", -1, one(binary("==", 2, local(0, 1), literal(1)))))
    push(statements, assigned(0, literal(5)))
    push(statements, cleaned)
    push(statements, local(0, 1))
    assert accepted(empty(), grouped(statements), 1).number == 7

    // Even an unexecuted registration must not hide an external effect, or
    // grant its body permission to jump into the registration site's loop.
    let effect = node(ExprKind.Defer, 0, "", 0,
        one(grouped(one(node(ExprKind.Intrinsic, 0, "write", -1, new[Expr]())))))
    assert rejected(empty(), effect, 0).message == "compile-time evaluation forbids intrinsic write"
    let escaping = node(ExprKind.Defer, 0, "", 0, one(grouped(one(transfer(ExprKind.Break)))))
    assert rejected(empty(), looped(truth(true), escaping), 0).message == "compile-time loop control escaped its loop"
}
