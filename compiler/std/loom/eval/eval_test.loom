import std.loom.source.Span
import std.loom.typed.Expr
import std.loom.typed.ExprKind
import std.loom.typed.Arm
import std.loom.typed.Type
import std.loom.typed.TypeKind
import std.loom.typed.Field
import std.loom.typed.Variant
import std.loom.typed.Function
import std.loom.typed.Local
import std.loom.typed.Program
import std.int.to_text
import std.list.new
import std.list.push
import std.list.get
import std.list.length
import std.result.Result

fn node(kind ExprKind, ty Int, text Text, index Int, children List[Expr]) Expr {
    Expr { kind = kind ty = ty text = text index = index children = children arms = new[Arm]()
        span = Span { start = 7 end = 8 } falls = true }
}
fn one(value Expr) List[Expr] { let values = new[Expr]()
    push(values, value)
    values }
fn two(a Expr, b Expr) List[Expr] { let values = one(a)
    push(values, b)
    values }
fn literal(value Int) Expr { node(ExprKind.Integer, 1, to_text(value), -1, new[Expr]()) }
fn truth(value Bool) Expr { node(ExprKind.Bool, 2, if value { "true" } else { "false" }, -1, new[Expr]()) }
fn local(index Int, ty Int) Expr { node(ExprKind.Local, ty, "", index, new[Expr]()) }
fn binary(operator Text, ty Int, a Expr, b Expr) Expr { node(ExprKind.Binary, ty, operator, -1, two(a, b)) }
fn empty() Program { Program { types = new[Type]() functions = new[Function]() entry = -1 tests = new[Int]() test_names = new[Text]() exports = new[Int]()
    interfaces = new[Interface]() witnesses = new[Witness]() } }
fn accepted(program Program, expression Expr, locals Int) Value {
    match evaluate(program, expression, locals) {
        Result.Ok(value) => value
        Result.Err(_) => { assert false
            unknown() }
    }
}
fn rejected(program Program, expression Expr, locals Int) Failure {
    match evaluate(program, expression, locals) {
        Result.Err(error) => error
        Result.Ok(_) => { assert false
            failure(expression, "") }
    }
}

test fn checked_faults_short_circuit_and_purity() {
    let program = empty()
    let zero = binary("/", 1, literal(1), literal(0))
    assert rejected(program, zero, 0).message == "compile-time division by zero"
    assert rejected(program, binary("+", 1, literal(9223372036854775807), literal(1)), 0).message == "compile-time integer overflow"
    assert rejected(program, binary("/", 1, literal(-9223372036854775808), literal(-1)), 0).message == "compile-time integer overflow"
    let skipped = binary("||", 2, truth(true), binary("==", 2, zero, literal(0)))
    assert accepted(program, skipped, 0).number == 1
    let branches = two(truth(false), node(ExprKind.Intrinsic, 0, "write", -1, new[Expr]()))
    push(branches, literal(1))
    assert rejected(program, node(ExprKind.If, 1, "", -1, branches), 0).message == "compile-time evaluation forbids intrinsic write"
    assert rejected(program, local(0, 1), 1).message == "compile-time evaluation cannot capture runtime locals"
    assert match scalar(binary("+", 1, local(0, 1), literal(1)), unknown()) { Result.Ok(value) => value.ty == -1, _ => false }
    assert match scalar(node(ExprKind.Call, 1, "", 0, new[Expr]()), unknown()) { Result.Err(_) => true, _ => false }
    let loop = node(ExprKind.While, 0, "", -1, two(truth(true), node(ExprKind.Block, 0, "", -1, new[Expr]())))
    assert rejected(program, loop, 0).message == "compile-time work budget exhausted"
}

test fn calls_have_frames_preconditions_and_return_flow() {
    let program = empty()
    let locals = new[Local]()
    push(locals, Local { name = "n" ty = 1 mutable = true is_scoped = false })
    push(locals, Local { name = "sum" ty = 1 mutable = true is_scoped = false })
    push(locals, Local { name = "result" ty = 1 mutable = false is_scoped = false })
    let body = one(node(ExprKind.Let, 0, "", 1, one(literal(0))))
    let updates = two(node(ExprKind.Assign, 0, "", 1, one(binary("+", 1, local(1, 1), local(0, 1)))),
        node(ExprKind.Assign, 0, "", 0, one(binary("-", 1, local(0, 1), literal(1)))))
    push(body, node(ExprKind.While, 0, "", -1, two(binary(">", 2, local(0, 1), literal(0)), node(ExprKind.Block, 0, "", -1, updates))))
    push(body, node(ExprKind.Return, 0, "", -1, one(local(1, 1))))
    push(body, literal(999))
    let params = new[Int]()
    push(params, 1)
    push(program.functions, Function { is_async = false symbol = 0 arguments = new[Int]() params = params result = 1 locals = locals
        preconditions = one(binary(">=", 2, local(0, 1), literal(0))) postconditions = one(binary(">=", 2, local(2, 1), literal(0)))
        result_local = 2 body = node(ExprKind.Block, 1, "", -1, body) runtime_name = "" span = Span { start = 7 end = 8 } })
    let call = node(ExprKind.Call, 1, "", 0, one(literal(5)))
    assert accepted(program, binary("+", 1, call, literal(1)), 0).number == 16
    assert rejected(program, node(ExprKind.Call, 1, "", 0, one(literal(-1))), 0).message == "compile-time precondition failed"
    push(program.functions, Function { is_async = false symbol = 1 arguments = new[Int]() params = new[Int]() result = 0 locals = new[Local]()
        preconditions = new[Expr]() postconditions = new[Expr]() result_local = -1
        body = node(ExprKind.Return, 0, "", -1, new[Expr]()) runtime_name = "" span = Span { start = 7 end = 8 } })
    assert accepted(program, node(ExprKind.Call, 0, "", 1, new[Expr]()), 0).ty == 0
    push(program.functions, Function { is_async = false symbol = 2 arguments = new[Int]() params = new[Int]() result = 1 locals = new[Local]()
        preconditions = new[Expr]() postconditions = new[Expr]() result_local = -1
        body = node(ExprKind.Call, 1, "", 2, new[Expr]()) runtime_name = "" span = Span { start = 7 end = 8 } })
    assert rejected(program, node(ExprKind.Call, 1, "", 2, new[Expr]()), 0).message == "compile-time call depth exhausted"
}

fn shape(kind TypeKind) Type { Type { kind = kind symbol = -1 arguments = new[Int]() fields = new[Field]() variants = new[Variant]() constraint = new[Expr]() } }
test fn fresh_lists_preserve_aliases_and_records_preserve_field_order() {
    let program = empty()
    var index = 0
    while index < 5 { push(program.types, shape(TypeKind.Int))
        index = index + 1 }
    push(program.types, shape(TypeKind.List))
    let fields = new[Field]()
    push(fields, Field { name = "first" ty = 1 })
    push(fields, Field { name = "second" ty = 1 })
    push(program.types, Type { kind = TypeKind.Record symbol = 0 arguments = new[Int]() fields = fields variants = new[Variant]() constraint = new[Expr]() })
    let statements = two(node(ExprKind.Let, 0, "", 0, one(node(ExprKind.Intrinsic, 5, "list_new", -1, new[Expr]()))),
        node(ExprKind.Let, 0, "", 1, one(local(0, 5))))
    push(statements, node(ExprKind.Intrinsic, 0, "list_push", -1, two(local(1, 5), literal(4))))
    let args = two(local(0, 5), literal(0))
    push(args, literal(9))
    push(statements, node(ExprKind.Intrinsic, 0, "list_set", -1, args))
    push(statements, node(ExprKind.Intrinsic, 1, "list_get", -1, two(local(1, 5), literal(0))))
    assert accepted(program, node(ExprKind.Block, 1, "", -1, statements), 2).number == 9
    let constructed = node(ExprKind.Record, 6, "", -1, two(node(ExprKind.Field, 1, "", 1, one(literal(8))), node(ExprKind.Field, 1, "", 0, one(literal(2)))))
    let value = accepted(program, constructed, 0)
    assert get(value.items, 0).number == 2 && get(value.items, 1).number == 8
    let payload = new[Int]()
    push(payload, 6)
    let variants = new[Variant]()
    push(variants, Variant { name = "Pair" fields = payload })
    push(program.types, Type { kind = TypeKind.Enum symbol = 1 arguments = new[Int]() fields = new[Field]() variants = variants constraint = new[Expr]() })
    let bindings = new[Int]()
    push(bindings, 0)
    let arms = new[Arm]()
    push(arms, Arm { variant = 0 bindings = bindings whole = -1 body = one(node(ExprKind.Field, 1, "", 1, one(local(0, 6)))) })
    let matched = Expr { kind = ExprKind.Match ty = 1 text = "" index = -1
        children = one(node(ExprKind.Variant, 7, "", 0, one(constructed))) arms = arms span = Span { start = 7 end = 8 } falls = true }
    assert accepted(program, matched, 1).number == 8
    let bounds = node(ExprKind.Intrinsic, 1, "list_get", -1, two(node(ExprKind.Intrinsic, 5, "list_new", -1, new[Expr]()), literal(0)))
    assert rejected(program, bounds, 0).message == "compile-time List index out of bounds"
    let text_args = two(node(ExprKind.Text, 3, "é", -1, new[Expr]()), literal(1))
    push(text_args, literal(2))
    assert rejected(program, node(ExprKind.Intrinsic, 3, "text_slice", -1, text_args), 0).message == "compile-time Text slice is not a UTF-8 boundary"
}
