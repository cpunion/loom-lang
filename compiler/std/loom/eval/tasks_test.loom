test fn compile_time_purity_rejects_tasks_but_allows_async_references() {
    let program = empty()
    assert rejected(program, node(ExprKind.TaskCall, 1, "", 0, new[Expr]()), 0).message ==
    "compile-time evaluation cannot create or await tasks"
    assert rejected(program, node(ExprKind.Await, 1, "", -1, one(literal(1))), 0).message ==
    "compile-time evaluation cannot create or await tasks"
    assert rejected(program, node(ExprKind.Suspend, 0, "timer_until_ns", -1, one(literal(0))), 0).message ==
    "compile-time evaluation cannot create or await tasks"
    assert rejected(program, node(ExprKind.Intrinsic, 1, "clock_monotonic_ns", -1, new[Expr]()), 0).message ==
    "compile-time evaluation forbids intrinsic clock_monotonic_ns"
    push(program.functions, Function {
            is_async = true
            symbol = 0
            arguments = new[Int]()
            params = new[Int]()
            result = 1
            locals = new[Local]()
            preconditions = new[Expr]()
            postconditions = new[Expr]()
            result_local = -1
            body = literal(1)
            runtime_name = ""
            span = Span {
                start = 7
                end = 8
            }
        })
    assert match validate(program, node(ExprKind.FunctionRef, 1, "", 0, new[Expr]())) {
        Result.Ok(_) => true, Result.Err(_) => false
    }
    assert rejected(program, node(ExprKind.Call, 1, "", 0, new[Expr]()), 0).message ==
    "compile-time evaluation cannot create or await tasks"
}

test fn compile_time_purity_rejects_synchronous_task_parameters_and_results() {
    let program = empty()
    var index = 0
    while index < 6 {
        push(program.types, shape(TypeKind.Int))
        index = index + 1
    }
    let arguments = new[Int]()
    push(arguments, 1)
    push(program.types, Type { kind = TypeKind.Task symbol = -1 arguments = arguments
        fields = new[Field]() variants = new[Variant]() constraint = new[Expr]() })
    let params = new[Int]()
    push(params, 6)
    let locals = new[Local]()
    push(locals, Local { name = "task" ty = 6 mutable = false is_scoped = false })
    push(program.functions, Function { is_async = false symbol = 0 arguments = new[Int]() params = params result = 6 locals = locals
        preconditions = new[Expr]() postconditions = new[Expr]() result_local = -1 body = local(0, 6)
        runtime_name = "" span = Span { start = 7 end = 8 } })
    push(program.functions, Function { is_async = false symbol = 1 arguments = new[Int]() params = params result = 1 locals = locals
        preconditions = new[Expr]() postconditions = new[Expr]() result_local = -1 body = literal(1)
        runtime_name = "" span = Span { start = 7 end = 8 } })
    assert match validate(program, node(ExprKind.FunctionRef, 1, "", 0, new[Expr]())) {
        Result.Ok(_) => true, Result.Err(_) => false
    }
    assert rejected(program, node(ExprKind.Call, 1, "", 1, new[Expr]()), 0).message ==
    "compile-time evaluation cannot transfer tasks"
    assert rejected(program, local(0, 6), 1).message == "compile-time evaluation cannot transfer tasks"
}
