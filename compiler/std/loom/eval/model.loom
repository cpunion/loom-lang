import std.loom.source.Span
import std.loom.typed.Program
import std.loom.typed.Expr
import std.loom.typed.ExprKind
import std.loom.typed.Type
import std.loom.typed.Function
import std.loom.typed.Interface
import std.loom.typed.Witness
import std.list.new
import std.list.get
import std.list.push
import std.list.set
import std.list.length
import std.result.Result

// Mutable containers use a positive evaluation-local allocation ID in number;
// records use zero and enums keep their variant tag. These are not addresses.
// Named functions use their source symbol in number and Int-wrapped type IDs
// in items; these survive reification into a different function queue.
// A dyn value keeps its concrete type ID in number and its receiver in items[0],
// never a witness index tied to one staging or runtime function queue.
pub record Value { ty Int number Int floating Float text Text items List[Value] }
pub record Failure { span Span message Text }
enum Control { Normal Return Break Continue }
record Step { value Value control Control }
record Frame { locals List[Value] calls Int }
// Shared work/allocation counters and next container ID cover all calls.
record State { program Program budget List[Int] partial Bool task_types List[Int] }

pub fn unknown() Value { Value { ty = -1 number = 0 floating = 0.0 text = "" items = new[Value]() } }
pub fn number(value Int) Value { Value { ty = 1 number = value floating = 0.0 text = "" items = new[Value]() } }
pub fn floating(value Float) Value { Value { ty = 5 number = 0 floating = value text = "" items = new[Value]() } }
pub fn flag(value Bool) Value { Value { ty = 2 number = if value { 1 } else { 0 } floating = 0.0 text = "" items = new[Value]() } }
fn unit() Value { Value { ty = 0 number = 0 floating = 0.0 text = "" items = new[Value]() } }
fn string(value Text) Value { Value { ty = 3 number = 0 floating = 0.0 text = value items = new[Value]() } }
fn aggregate(ty Int, tag Int, items List[Value]) Value { Value { ty = ty number = tag floating = 0.0 text = "" items = items } }
fn step(value Value) Step { Step { value = value control = Control.Normal } }
fn failure(expr Expr, message Text) Failure { Failure { span = expr.span message = message } }
fn finished(expr Expr, value Step) Result[Value, Failure] {
    if value.control == Control.Break || value.control == Control.Continue {
        return Result.Err(failure(expr, "compile-time loop control escaped its loop"))
    }
    Result.Ok(value.value)
}
fn state(program Program, partial Bool) State {
    let budget = new[Int]()
    push(budget, 100000)
    push(budget, 16777216)
    push(budget, 0)
    State { program = program budget = budget partial = partial task_types = new[Int]() }
}
fn fresh(state State, ty Int, items List[Value]) Value {
    // execute's work budget bounds the number of allocations well below Int.
    let id = get(state.budget, 2) + 1
    set(state.budget, 2, id)
    aggregate(ty, id, items)
}
fn fresh(state State, ty Int) Value { fresh(state, ty, new[Value]()) }
fn spend(state State, expr Expr, index Int, amount Int) Result[Bool, Failure] {
    let remaining = get(state.budget, index)
    if amount < 0 || amount > remaining {
        return Result.Err(failure(expr, if index == 0 { "compile-time work budget exhausted" }
            else { "compile-time allocation budget exhausted" }))
    }
    set(state.budget, index, remaining - amount)
    Result.Ok(true)
}
fn slots(state State, expr Expr, count Int) Result[List[Value], Failure] {
    if count < 0 || count > get(state.budget, 1) / 64 {
        return Result.Err(failure(expr, "compile-time allocation budget exhausted"))
    }
    discard spend(state, expr, 0, count)?
    discard spend(state, expr, 1, count * 64)?
    let values = new[Value]()
    var index = 0
    while index < count { push(values, unknown())
        index = index + 1 }
    Result.Ok(values)
}
fn child(expr Expr, index Int) Result[Expr, Failure] {
    if index < 0 || index >= length(expr.children) { return Result.Err(failure(expr, "invalid checked expression children")) }
    Result.Ok(get(expr.children, index))
}
fn stored(frame Frame, expr Expr, index Int, value Value) Result[Bool, Failure] {
    if index < 0 || index >= length(frame.locals) { return Result.Err(failure(expr, "invalid compile-time local index")) }
    set(frame.locals, index, value)
    Result.Ok(true)
}
fn boolean(expr Expr, value Value) Result[Bool, Failure] {
    if value.ty != 2 { return Result.Err(failure(expr, "compile-time condition needs a known Bool")) }
    Result.Ok(value.number != 0)
}

// Check the supported operation/call closure without executing it. The caller
// supplies checked IR and establishes input isolation; this is not a general
// effect proof for functions that receive externally shared mutable objects.
pub fn validate(program Program, expression Expr) Result[Bool, Failure] {
    scan(state(program, false), expression, new[Int](), 0, 0)
}

pub fn evaluate(program Program, expression Expr, locals Int) Result[Value, Failure] {
    let state = state(program, false)
    discard scan(state, expression, new[Int](), 0, 0)?
    let frame = Frame { locals = slots(state, expression, locals)? calls = 0 }
    finished(expression, execute(state, expression, frame, 0)?)
}

// Optional constraint folding shares execution/arithmetic but cannot invoke a
// function or manufacture mutable state. Unknown self stays nonconstant.
pub fn scalar(expression Expr, self_value Value) Result[Value, Failure] {
    let program = Program { types = new[Type]() functions = new[Function]() entry = -1 tests = new[Int]() test_names = new[Text]() exports = new[Int]()
        interfaces = new[Interface]() witnesses = new[Witness]() }
    let state = state(program, true)
    discard scan(state, expression, new[Int](), 0, 0)?
    let locals = new[Value]()
    push(locals, self_value)
    finished(expression, execute(state, expression, Frame { locals = locals calls = 0 }, 0)?)
}
