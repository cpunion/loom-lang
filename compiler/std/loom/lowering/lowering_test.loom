import std.loom.source.Span
import std.loom.typed.Program
import std.loom.typed.Function
import std.loom.typed.Type
import std.loom.typed.TypeKind
import std.loom.typed.Field
import std.loom.typed.Variant
import std.loom.typed.Local
import std.loom.typed.Expr
import std.loom.typed.ExprKind
import std.loom.typed.Arm
import std.loom.typed.Interface
import std.loom.typed.Witness
import std.list.new
import std.list.push
import std.list.get
import std.list.length

fn test_span() Span {
    Span {
        start = 0
        end = 1
    }
}

fn test_local(ty Int) Local {
    Local {
        name = ""
        ty = ty
        mutable = true
        is_scoped = false
    }
}

fn test_function(params List[Int], output Int, locals List[Local], body Expr) Function {
    Function {
        is_async = true
        symbol = -1
        arguments = new[Int]()
        params = params
        result = output
        locals = locals
        preconditions = new[Expr]()
        postconditions = new[Expr]()
        result_local = -1
        body = body
        runtime_name = ""
        span = test_span()
    }
}

fn has_high(value Expr) Bool {
    if value.kind == ExprKind.TaskCall || value.kind == ExprKind.Await || value.kind == ExprKind.Suspend {
        return true
    }
    var index = 0
    while index < length(value.children) {
        if has_high(get(value.children, index)) {
            return true
        }
        index = index + 1
    }
    index = 0
    while index < length(value.arms) {
        let body = get(value.arms, index).body
        var item = 0
        while item < length(body) {
            if has_high(get(body, item)) {
                return true
            }
            item = item + 1
        }
        index = index + 1
    }
    false
}

fn operations(value Expr, name Text) Int {
    var count = if value.kind == ExprKind.Intrinsic && value.text == name {
        1
    } else {
        0
    }
    var index = 0
    while index < length(value.children) {
        count = count + operations(get(value.children, index), name)
        index = index + 1
    }
    index = 0
    while index < length(value.arms) {
        let body = get(value.arms, index).body
        var item = 0
        while item < length(body) {
            count = count + operations(get(body, item), name)
            item = item + 1
        }
        index = index + 1
    }
    count
}

fn test_types() List[Type] {
    let types = new[Type]()
    let kinds = new[TypeKind]()
    push(kinds, TypeKind.Unit)
    push(kinds, TypeKind.Int)
    push(kinds, TypeKind.Bool)
    push(kinds, TypeKind.Text)
    push(kinds, TypeKind.Bytes)
    push(kinds, TypeKind.Float)
    var index = 0
    while index < length(kinds) {
        push(types, Type {
                kind = get(kinds, index)
                symbol = -1
                arguments = new[Int]()
                fields = new[Field]()
                variants = new[Variant]()
                constraint = new[Expr]()
            })
        index = index + 1
    }
    types
}

test fn lowers_hot_constructors_and_spills_only_values_crossing_await() {
    let span = test_span()
    let types = test_types()
    var index = 0
    let task = shape(types, TypeKind.Task, ints(1))
    let functions = new[Function]()
    let child_locals = new[Local]()
    push(child_locals, test_local(1))
    push(functions, test_function(ints(1), 1, child_locals,
            block(one(node(ExprKind.Local, 1, span, 0, new[Expr]())), 1, span, true)))
    let locals = new[Local]()
    push(locals, test_local(1))
    push(locals, test_local(5))
    push(locals, test_local(task))
    push(locals, test_local(1))
    let values = one(node(ExprKind.Let, 0, span, 0, one(integer(7, span))))
    let unused = labeled(node(ExprKind.Float, 5, span, -1, new[Expr]()), "3.5")
    push(values, node(ExprKind.Let, 0, span, 1, one(unused)))
    let call = labeled(node(ExprKind.TaskCall, task, span, 0, one(integer(1, span))), "fixture: child creation")
    push(values, node(ExprKind.Let, 0, span, 2, one(call)))
    push(values, node(ExprKind.Let, 0, span, 3, one(node(ExprKind.Await, 1, span, -1,
                    one(node(ExprKind.Local, task, span, 2, new[Expr]()))))))
    let sum = labeled(node(ExprKind.Binary, 1, span, -1, pair(node(ExprKind.Local, 1, span, 0, new[Expr]()),
                node(ExprKind.Local, 1, span, 3, new[Expr]()))), "+")
    let equals = labeled(node(ExprKind.Binary, 2, span, -1, pair(sum, integer(8, span))), "==")
    push(values, node(ExprKind.Assert, 0, span, -1, one(equals)))
    push(functions, test_function(new[Int](), 0, locals, block(values, 0, span, true)))
    let source = Program {
        types = types
        functions = functions
        entry = 1
        tests = new[Int]()
        test_names = new[Text]()
        exports = new[Int]()
        interfaces = new[Interface]()
        witnesses = new[Witness]()
    }
    let lowered = lower(source)
    assert get(source.functions, 1).is_async
    assert lowered.entry != 1 && length(lowered.functions) == 6
    assert get(lowered.functions, 0).result == task
    assert length(get(lowered.functions, 0).params) == 2
    index = 0
    var frames = 0
    while index < length(lowered.types) {
        let ty = get(lowered.types, index)
        if ty.kind == TypeKind.Frame {
            frames = frames + 1
            if get(ty.fields, 0).ty == 0 {
                assert length(ty.fields) == 4
                var field = 0
                while field < length(ty.fields) {
                    assert get(ty.fields, field).ty != 5
                    field = field + 1
                }
            }
        }
        index = index + 1
    }
    assert frames == 2
    index = 0
    while index < length(lowered.functions) {
        let function = get(lowered.functions, index)
        assert !function.is_async && !has_high(function.body)
        index = index + 1
    }

    let text_task = shape(types, TypeKind.Task, ints(3))
    let parameters = ints(task)
    push(parameters, 1)
    push(parameters, text_task)
    let transfer_locals = new[Local]()
    push(transfer_locals, test_local(task))
    push(transfer_locals, test_local(1))
    push(transfer_locals, test_local(text_task))
    let transfer_body = one(node(ExprKind.Discard, 0, span, -1,
            one(node(ExprKind.Await, 3, span, -1, one(node(ExprKind.Local, text_task, span, 2, new[Expr]()))))))
    push(transfer_body, node(ExprKind.Local, task, span, 0, new[Expr]()))
    let transferred_functions = new[Function]()
    let transfer = test_function(parameters, task, transfer_locals, block(transfer_body, task, span, true))
    push(transferred_functions, transfer)
    let identity_locals = new[Local]()
    push(identity_locals, test_local(task))
    push(transferred_functions, generated(transfer, ints(task), task, identity_locals,
            block(one(node(ExprKind.Local, task, span, 0, new[Expr]())), task, span, true)))
    let transferred = lower(Program {
            types = types
            functions = transferred_functions
            entry = -1
            tests = new[Int]()
            test_names = new[Text]()
            exports = new[Int]()
            interfaces = new[Interface]()
            witnesses = new[Witness]()
        })
    let constructor = get(transferred.functions, 0)
    assert operations(constructor.body, "task_create") == 1
    assert operations(constructor.body, "task_adopt") == 2
    let constructed = get(constructor.body.children, 0)
    assert constructed.kind == ExprKind.Let && get(constructed.children, 0).text == "task_create"
    assert length(constructor.body.children) == 4
    let first_adopt = get(constructor.body.children, 1)
    let second_adopt = get(constructor.body.children, 2)
    assert get(first_adopt.children, 0).index == constructed.index
    assert get(second_adopt.children, 0).index == constructed.index
    assert get(first_adopt.children, 1).index == 0 && get(second_adopt.children, 1).index == 2
    assert get(constructor.body.children, 3).index == constructed.index
    assert get(get(transferred.types, constructor.result).arguments, 0) == task
    let resume = get(transferred.functions, 2)
    assert operations(resume.body, "task_return") == 1
    assert operations(resume.body, "task_result") == 1 && operations(resume.body, "task_release") == 1
    let ordinary = get(transferred.functions, 1)
    assert ordinary.result == task && length(ordinary.locals) == 1
    assert operations(ordinary.body, "task_adopt") == 0 && operations(ordinary.body, "task_return") == 0
    assert operations(get(lowered.functions, 0).body, "task_adopt") == 0
    assert operations(get(lowered.functions, 2).body, "task_return") == 0
}

test fn edge_bindings_and_argument_snapshots_are_live_at_the_correct_point() {
    let span = test_span()
    let locals = new[Local]()
    push(locals, test_local(1))
    push(locals, test_local(1))
    push(locals, test_local(1))
    push(locals, test_local(6))
    let graph = Graph {
        states = new[State]()
        locals = locals
        result = 1
        span = span
    }
    let wait = state(graph)
    let select = state(graph)
    let arm = state(graph)
    finish(graph, wait, Exit.Wait, local(graph, 3), edges(select), new[Arm]())
    let targets = new[Edge]()
    push(targets, Edge {
            target = arm
            bindings = ints(2)
        })
    finish(graph, select, Exit.Select, local(graph, 1), targets, new[Arm]())
    finish(graph, arm, Exit.Complete, local(graph, 2), new[Edge](), new[Arm]())
    let live = get(flows(graph), wait).live
    assert get(live, 1) && get(live, 3) && !get(live, 2)

    let ordered = Graph {
        states = new[State]()
        locals = new[Local]()
        result = 1
        span = span
    }
    push(ordered.locals, test_local(1))
    push(ordered.locals, test_local(1))
    push(ordered.locals, test_local(6))
    let first = state(ordered)
    let body = one(node(ExprKind.Assign, 0, span, 1, one(integer(2, span))))
    push(body, node(ExprKind.Await, 1, span, -1, one(local(ordered, 2))))
    let output = evaluate(ordered, node(ExprKind.Call, 1, span, 0,
            pair(local(ordered, 1), block(body, 1, span, true))), first, Loop {
            exit = -1
            again = -1
        })
    finish(ordered, output.state, Exit.Complete, output.expression, new[Edge](), new[Arm]())
    let saved = get(get(ordered.states, first).code, 0)
    assert saved.kind == ExprKind.Let && get(saved.children, 0).index == 1
    assert get(get(ordered.states, first).code, 1).kind == ExprKind.Assign
    let pending = get(flows(ordered), 1).live
    assert get(pending, saved.index) && !get(pending, 1)

    let timer = Graph {
        states = new[State]()
        locals = new[Local]()
        result = 0
        span = span
    }
    push(timer.locals, test_local(1))
    push(timer.locals, test_local(1))
    let initial = state(timer)
    let deadline = node(ExprKind.Call, 1, span, 99, one(local(timer, 1)))
    let suspended = labeled(node(ExprKind.Suspend, 0, span, -1, one(deadline)), "timer_until_ns")
    let continued = evaluate(timer, suspended, initial, Loop {
            exit = -1
            again = -1
        })
    finish(timer, continued.state, Exit.Complete, continued.expression, new[Edge](), new[Arm]())
    // The effectful deadline is evaluated once, before the persistent park state.
    let initialized = get(timer.states, initial).code
    assert length(initialized) == 1
    let snapshot = get(initialized, 0)
    assert snapshot.kind == ExprKind.Let && get(snapshot.children, 0).kind == ExprKind.Call
    let parked = get(timer.states, 1)
    assert parked.exit == Exit.Park && length(parked.code) == 0
    assert parked.value.kind == ExprKind.Intrinsic && parked.value.text == "task_wait_timer"
    assert get(parked.value.children, 0).index == snapshot.index
    let timer_live = flows(timer)
    assert get(get(timer_live, 1).live, snapshot.index) && !get(get(timer_live, 1).live, 1)
    let spills = new[Int]()
    push(spills, -1)
    push(spills, -1)
    push(spills, 2)
    let terminator = ending(timer, 1, temporary(timer, 1), spills, timer_live)
    let saved_state = get(get(terminator.children, 2).children, 1)
    assert saved_state.kind == ExprKind.FrameStore && saved_state.index == 1
    assert get(saved_state.children, 1).text == "1"
    assert length(get(timer.states, continued.state).code) == 0 && !has_high(terminator)
}
