import std.list.new
import std.list.get
import std.list.push

fn relation_shape(kind TypeKind, symbol Int) Type {
    Type {
        kind = kind
        symbol = symbol
        arguments = new[Int]()
        fields = new[Field]()
        variants = new[Variant]()
        constraint = new[Expr]()
    }
}

test fn type_relations_compose_without_guessing_formal_types() {
    let types = new[Type]()
    push(types, relation_shape(TypeKind.Unit, -1))
    push(types, relation_shape(TypeKind.Int, -1))
    push(types, relation_shape(TypeKind.Bool, -1))
    push(types, relation_shape(TypeKind.Text, -1))
    push(types, relation_shape(TypeKind.Bytes, -1))
    push(types, relation_shape(TypeKind.Float, -1))
    push(types, relation_shape(TypeKind.Parameter, 0))
    push(types, relation_shape(TypeKind.Parameter, 1))
    assert type_relation(types, 6, 6) == 1
    assert type_relation(types, 6, 7) == -1
    assert type_relation(types, 6, 1) == -1
    let formal = structural_type(types, TypeKind.Tuple, -1, [6, 3])
    let concrete = structural_type(types, TypeKind.Tuple, -1, [1, 3])
    let distinct = structural_type(types, TypeKind.Tuple, -1, [7, 2])
    assert type_relation(types, formal, concrete) == -1
    assert type_relation(types, formal, distinct) == 0
    assert type_relation(types, formal, structural_type(types, TypeKind.Function, -1, [6, 3])) == 0
    var left = 1
    var right = 2
    var unresolved = 6
    var index = 0
    while index < 32 {
        left = structural_type(types, TypeKind.Tuple, -1, [left, left])
        right = structural_type(types, TypeKind.Tuple, -1, [right, right])
        unresolved = structural_type(types, TypeKind.Tuple, -1, [unresolved, unresolved])
        index = index + 1
    }
    assert concrete_type(types, left)
    assert !concrete_type(types, unresolved)
    assert type_relation(types, left, right) == 0
    assert type_relation(types, left, unresolved) == -1
}
