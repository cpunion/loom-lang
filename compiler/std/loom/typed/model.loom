import std.loom.source.Span

// IDs address immutable entries in the checked program, never source names.
// A Block with text "macro" retains its generator's source symbol in index
// for navigation. It executes as an ordinary block; this is not a call edge.
pub enum TypeKind {
    Unit
    Int
    Bool
    Text
    Bytes
    Parameter
    List
    Record
    Enum
    Refined
    Tuple
    Float
    Dyn
    Associated
    Function
    Task
    Frame
    // Compile-time type identity, with no runtime representation.
    Meta
}

pub record Field {
    name Text
    ty Int
}

pub record Variant {
    name Text
    fields List[Int]
}

pub record Type {
    kind TypeKind
    // Associated uses the member's source symbol and [receiver, member arguments...].
    // Concrete projections normalize before executable IR reaches the backend.
    // Function has symbol -1 and arguments [parameter types..., result type].
    // Task has symbol -1 and [logical result]. Frame is private managed storage
    // for captures/cells or coroutines. Only coroutine frames require a result,
    // program counter, parameters and live spills in their lowering-defined order.
    // Dyn arguments are all associated bindings in concept declaration order;
    // its symbol identifies the exact concept-and-bindings interface instance.
    symbol Int
    arguments List[Int]
    // Nominal pack widths in declaration order. Arguments remain flat;
    // equal flattened arguments with different groups are distinct types.
    pack_widths List[Int]
    fields List[Field]
    variants List[Variant]
    // Predicate template: self is local 0; calls have index -1 until rebound
    // for a particular queue. These are not executable function references.
    constraint List[Expr]
}

pub record Local {
    name Text
    ty Int
    mutable Bool
    is_scoped Bool
}

pub enum ExprKind {
    Integer
    Bool
    Text
    Local
    Unary
    Binary
    Call
    Intrinsic
    Record
    Field
    Variant
    Block
    Let
    Assign
    Return
    Assert
    Discard
    While
    If
    Match
    Coerce
    Deferred
    Float
    DynBox
    DynCall
    FunctionRef
    IndirectCall
    Break
    Continue
    List
    Defer
    Cleanup
    TaskCall
    Await
    FrameNew
    FrameStore
    Suspend
    Bytes
    // A receiver-only drain refers to an enclosing traversal with the same
    // element-local index, keeping recursive layouts finite.
    ResourceDrain
    // index identifies a type in this checking session, never a runtime ID.
    TypeValue
}

// FunctionRef.index is a concrete scheduled function ID; an optional child is
// its managed environment, passed as the lifted target's first parameter.
// IndirectCall children
// are [callee, arguments...], evaluated once in source order.
// Deferred never reaches native emission. A "comptime selection" has possible
// Task-local captures, not evaluated arguments; ordinary deferred calls keep
// their checked runtime arguments. Neither form supplies proof evidence.
// List children are ordered, same-typed elements of a fresh shared container.
// Bytes.text is canonical lowercase hex for a fresh mutable byte buffer.
// Coerce.text == "comptime value" preserves a computed value's validated nominal
// type during private graph reconstruction; it is not a source construction.
// Computation checks original construction, escapes, and mutation rules; the
// complete graph is initialized before external publication.
// ResourceDrain exists only before lowering: child 0 is a scoped List, index
// binds one element, and the remaining children are independent cleanup steps.
// Defer/Cleanup index a function-local cleanup registration and retain its one
// body child with the owner's Local IDs. Only Cleanup executes that body.
// Assert.text is a static source diagnostic, or empty for source-less IR.
// Intrinsic contract_old / entry_list_len / entry_list_get occur only in postcondition metadata.
// They preserve entry observations until verification, never native operations.
// TaskCall/Await/Suspend exist only before coroutine lowering. Suspend names a
// checked private async operation and contains its already-typed arguments.
// FrameNew children are
// indexed Field initializers; omitted fields are zeroed. FrameStore children
// are [frame,value], index selects the field, and its result is Unit.
pub record Expr {
    kind ExprKind
    ty Int
    span Span
    text Text
    index Int
    children List[Expr]
    arms List[Arm]
    falls Bool
}

pub record Arm {
    variant Int
    bindings List[Int]
    whole Int
    body List[Expr]
}

pub record Function {
    is_async Bool
    symbol Int
    arguments List[Int]
    params List[Int]
    result Int
    locals List[Local]
    preconditions List[Expr]
    postconditions List[Expr]
    result_local Int
    body Expr
    runtime_name Text
    span Span
}

// Interface.symbol is a source concept ID; TypeKind.Dyn.symbol indexes this
// program's interfaces. Even unused associated bindings distinguish interface
// instances. Method parameters exclude the erased receiver; result is the call
// result (Task[T] for async methods). Lowering removes is_async and appends the
// private constructor label parameter before native emission.
pub record Method {
    is_async Bool
    name Text
    params List[Int]
    result Int
}

pub record Interface {
    symbol Int
    methods List[Method]
}

// Method entries are concrete function IDs, or -1 for unused slots.
pub record Witness {
    interface Int
    concrete Int
    methods List[Int]
}

pub record Program {
    types List[Type]
    functions List[Function]
    entry Int
    tests List[Int]
    test_names List[Text]
    exports List[Int]
    interfaces List[Interface]
    witnesses List[Witness]
}
