import std.loom.source.Span

// IDs address immutable entries in the checked program, never source names.
pub enum TypeKind { Unit Int Bool Text Bytes Parameter List Record Enum Refined Tuple Float }
pub record Field { name Text ty Int }
pub record Variant { name Text fields List[Int] }
pub record Type {
    kind TypeKind
    symbol Int
    arguments List[Int]
    fields List[Field]
    variants List[Variant]
    // Predicate template: self is local 0; calls have index -1 until rebound
    // for a particular queue. These are not executable function references.
    constraint List[Expr]
}
pub record Local { name Text ty Int mutable Bool }
pub enum ExprKind {
    Integer Bool Text Local Unary Binary Call Intrinsic Record Field Variant
    Block Let Assign Return Assert Discard While If Match Coerce Deferred Float
}
pub record Expr {
    kind ExprKind
    ty Int
    span Span
    text Text
    index Int
    children List[Expr]
    arms List[Arm]
    falls Bool
}
pub record Arm { variant Int bindings List[Int] whole Int body List[Expr] }
pub record Function {
    symbol Int
    arguments List[Int]
    params List[Int]
    result Int
    locals List[Local]
    preconditions List[Expr]
    postconditions List[Expr]
    result_local Int
    body Expr
    runtime_name Text
    span Span
}
pub record Program {
    types List[Type]
    functions List[Function]
    entry Int
    tests List[Int]
    exports List[Int]
}
