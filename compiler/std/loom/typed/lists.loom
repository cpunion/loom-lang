import std.list.get
import std.list.length

pub fn list_replace_result(types List[Type], ty Int, element Int, list Int) Bool {
    let shape = get(types, ty)
    shape.kind == TypeKind.Tuple && length(shape.fields) == 2 &&
    get(shape.fields, 0).ty == element && get(shape.fields, 1).ty == list
}

// The irreducible operation uses a structural optional pair. Names and variant
// order belong to the source enum, not the compiler or runtime.
pub fn list_take_result(types List[Type], ty Int, element Int, list Int) Bool {
    let shape = get(types, ty)
    if shape.kind != TypeKind.Enum || length(shape.variants) != 2 {
        return false
    }
    var empty = false
    var present = false
    var index = 0
    while index < 2 {
        let fields = get(shape.variants, index).fields
        if length(fields) == 0 {
            empty = true
        } else {
            if length(fields) != 1 {
                return false
            }
            let pair = get(types, get(fields, 0))
            if pair.kind != TypeKind.Tuple || length(pair.fields) != 2 {
                return false
            }
            if get(pair.fields, 0).ty != element || get(pair.fields, 1).ty != list {
                return false
            }
            present = true
        }
        index = index + 1
    }
    empty && present
}
