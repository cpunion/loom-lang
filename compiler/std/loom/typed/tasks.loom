import std.list.get
import std.list.length
import std.map.Map
import std.map.new
import std.map.get
import std.map.insert
import std.option.Option

pub fn contains_tasks(types List[Type], ty Int) Bool {
    if ty <= 5 {
        return false
    }
    contains_tasks(types, ty, std.map.new[Int, Int]())
}

// Follow stored values, not nominal parameters or callback/dyn signatures.
// A sparse bitmap visits each stored type once without initializing unrelated
// type IDs. The caller starts fresh for each independent reachability query.
pub fn contains_tasks(types List[Type], ty Int, seen Map[Int, Int]) Bool {
    if ty <= 5 {
        return false
    }
    let shape = get(types, ty)
    if shape.kind == TypeKind.Task {
        return true
    }
    if shape.kind != TypeKind.List && length(shape.fields) == 0 && length(shape.variants) == 0 {
        return false
    }
    let word = ty / 64
    let bit = 1 << (ty % 64)
    let flags = match std.map.get(seen, word) {
        Option.Some(value) => value
        Option.None => 0
    }
    if (flags & bit) != 0 {
        return false
    }
    discard std.map.insert(seen, word, flags | bit)
    if shape.kind == TypeKind.List {
        var index = 0
        while index < length(shape.arguments) {
            if contains_tasks(types, get(shape.arguments, index), seen) {
                return true
            }
            index = index + 1
        }
        return false
    }
    var index = 0
    while index < length(shape.fields) {
        if contains_tasks(types, get(shape.fields, index).ty, seen) {
            return true
        }
        index = index + 1
    }
    index = 0
    while index < length(shape.variants) {
        let fields = get(shape.variants, index).fields
        var field = 0
        while field < length(fields) {
            if contains_tasks(types, get(fields, field), seen) {
                return true
            }
            field = field + 1
        }
        index = index + 1
    }
    false
}
