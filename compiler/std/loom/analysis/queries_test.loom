import std.option.Option
import std.text.byte

fn query_offset(text Text, fragment Text) Int {
    var index = 0
    while index + length(fragment) <= length(text) {
        var matched = 0
        while matched < length(fragment) && byte(text, index + matched) == byte(fragment, matched) {
            matched = matched + 1
        }
        if matched == length(fragment) {
            return index
        }
        index = index + 1
    }
    assert false
    -1
}

fn inspection(analysis Analysis, text Text, fragment Text) Inspection {
    match inspect_at(analysis, 0, query_offset(text, fragment)) {
        Option.Some(found) => found
        Option.None => {
            assert false
            inspection(analysis, text, fragment)
        }
    }
}

fn only_type(found Inspection, expected Text) {
    assert length(found.types) == 1 && get(found.types, 0) == expected
}

test fn closure_queries_keep_source_parameters_and_captured_bindings() {
    let text = "record Item { count Int }\nfn make(start Int) fn(Int) Int { var current = Item { count = start }\nfn(step Int) Int { current = Item { count = current.count + step }\ncurrent.count } }\nfn main() { assert make(1)(2) == 3 }"
    let analysis = accepted(input(text))
    let parameter = inspection(analysis, text, "step }")
    only_type(parameter, "Int")
    let start = query_offset(text, "step Int")
    only_definition(parameter, start, start + 4)
    let captured = inspection(analysis, text, "current.count +")
    only_type(captured, "app.Item")
    let binding = query_offset(text, "current =")
    only_definition(captured, binding, binding + 7)
    let field = inspection(analysis, text, "count +")
    only_type(field, "Int")
    let member = query_offset(text, "count Int")
    only_definition(field, member, member + 5)
}

test fn async_calls_tasks_and_await_have_distinct_editor_types() {
    let text = "async fn item() Int { 7 }\nasync fn main() { let task = item()\nassert task.await == 7 }"
    let analysis = accepted(input(text))
    only_type(inspection(analysis, text, "item()\n"), "async fn() Int")
    only_type(inspection(analysis, text, "task.await"), "Task[Int]")
    only_type(inspection(analysis, text, "await =="), "Int")
    let call = inspection(analysis, text, "item()\n")
    assert length(call.definitions) == 1
    assert get(call.definitions, 0).span.start == 9
}

fn only_definition(found Inspection, start Int, end Int) {
    assert length(found.definitions) == 1
    let location = get(found.definitions, 0)
    assert location.file == 0 && location.span.start == start && location.span.end == end
}

fn absent(analysis Analysis, position Int) {
    match inspect_at(analysis, 0, position) {
        Option.None => {
        }
        Option.Some(_) => {
            assert false
        }
    }
}

fn query_bindings(project Project) std.loom.binding.Program {
    match bind(project, false) {
        Result.Ok(value) => value
        Result.Err(_) => {
            assert false
            query_bindings(project)
        }
    }
}

fn independent_found(bindings std.loom.binding.Program, text Text, fragment Text) Inspection {
    match inspect_independent(bindings, 0, query_offset(text, fragment)) {
        Option.Some(value) => value
        Option.None => {
            assert false
            independent_found(bindings, text, fragment)
        }
    }
}

test fn independent_queries_keep_good_functions_despite_same_or_sibling_file_errors() {
    let good = "fn identity(value Int) Int { value }\nfn identity(value Bool) Bool { value }\nfn good() { let count = identity(3)\nassert count == 3 }\nfn main() { good() }"
    let bad = "fn broken() Int { true }\n"
    var index = 0
    while index < 2 {
        let text = if index == 0 {
            concat(bad, good)
        } else {
            good
        }
        let project = input(text)
        if index == 1 {
            push(project.files, SourceFile {
                    package = 0
                    path = "broken.loom"
                    text = bad
                    tree = get(input(bad).files, 0).tree
                    test_only = false
                    trusted_std = false
                })
        }
        let bindings = query_bindings(project)
        assert match check(bindings) {
            Result.Err(_) => true,
            Result.Ok(_) => false
        }
        let local = independent_found(bindings, text, "count ==")
        only_type(local, "Int")
        let declaration = query_offset(text, "count =")
        only_definition(local, declaration, declaration + 5)
        let call = independent_found(bindings, text, "identity(3)")
        only_type(call, "fn(Int) Int")
        let target = query_offset(text, "identity(value Int)")
        only_definition(call, target, target + 8)
        index = index + 1
    }
}

test fn independent_queries_require_the_selected_function_and_its_complete_dependency_closure() {
    let programs = [
        "fn selected() { let count = 3\nlet wrong Bool = count }\nfn main() { selected() }",
        "fn bad() Int { true }\nfn selected() { let count = bad()\nassert count == 3 }\nfn main() { selected() }",
        "fn first(value Int) Int { second(value) }\nfn second(value Int) Int { if value > 0 { first(value - 1) } else { true } }\nfn selected() { let count = first(3)\nassert count == 3 }\nfn main() { selected() }"
    ]
    var index = 0
    while index < length(programs) {
        let text = get(programs, index)
        let bindings = query_bindings(input(text))
        assert match check(bindings) {
            Result.Err(_) => true,
            Result.Ok(_) => false
        }
        assert match inspect_independent(bindings, 0, query_offset(text, "count =")) {
            Option.None => true
            Option.Some(_) => false
        }
        index = index + 1
    }
}

test fn independent_queries_do_not_bypass_invalid_generic_declarations() {
    let text = "fn invalid[T](value T) Int { true }\nfn main() { let count = 3\nassert count == 3 }"
    let bindings = query_bindings(input(text))
    assert match check(bindings) {
        Result.Err(_) => true,
        Result.Ok(_) => false
    }
    assert match inspect_independent(bindings, 0, query_offset(text, "count ==")) {
        Option.None => true
        Option.Some(_) => false
    }
}

test fn inspections_follow_local_ids_through_shadowing_and_inference() {
    let text = "fn main() {\nlet value = 3\nif true {\nlet value = true\nassert value\n}\nassert value == 3\n}"
    let analysis = accepted(input(text))
    let inner = inspection(analysis, text, "value\n}")
    only_type(inner, "Bool")
    let inner_start = query_offset(text, "value = true")
    only_definition(inner, inner_start, inner_start + 5)
    let outer = inspection(analysis, text, "value ==")
    only_type(outer, "Int")
    let outer_start = query_offset(text, "value = 3")
    only_definition(outer, outer_start, outer_start + 5)
    only_type(inspection(analysis, text, "value = 3"), "Int")
}

test fn inspections_keep_list_elements_and_local_types() {
    let text = "fn identity(value Int) Int { value }\nfn main() { let values = [identity(3)]\ndiscard values }"
    let analysis = accepted(input(text))
    only_type(inspection(analysis, text, "values ="), "List[Int]")
    only_type(inspection(analysis, text, "3)]"), "Int")
    let call = inspection(analysis, text, "identity(3)")
    only_type(call, "fn(Int) Int")
    only_definition(call, 3, 11)
}

test fn inspections_distinguish_field_paths_receivers_and_initializers() {
    let text = "record Box[T] { value T }\nrecord Outer { inner Box[Int] }\nfn main() {\nlet item = Outer { inner = Box { value = 7 } }\nassert item.inner.value == 7\n}"
    let analysis = accepted(input(text))
    only_type(inspection(analysis, text, "item.inner.value"), "app.Outer")
    only_type(inspection(analysis, text, "inner.value"), "app.Box[Int]")
    let field = inspection(analysis, text, "value ==")
    only_type(field, "Int")
    only_definition(field, query_offset(text, "value T"), query_offset(text, "value T") + 5)
    let initializer = inspection(analysis, text, "value = 7")
    only_type(initializer, "Int")
    only_definition(initializer, query_offset(text, "value T"), query_offset(text, "value T") + 5)
    let constructor = inspection(analysis, text, "Box { value")
    only_type(constructor, "app.Box[Int]")
    only_definition(constructor, query_offset(text, "Box[T]"), query_offset(text, "Box[T]") + 3)
}

test fn inspections_use_resolved_overloads_function_references_and_all_instances() {
    let text = "fn choose(value Int) Int { value }\nfn choose(value Bool) Bool { value }\nfn identity[T](item T) T { item }\nfn main() {\nlet number = choose(3)\nlet function fn(Bool) Bool = choose\nassert function(true)\nassert identity(number) == 3\nassert identity(true)\n}"
    let analysis = accepted(input(text))
    let call = inspection(analysis, text, "choose(3)")
    only_type(call, "fn(Int) Int")
    only_definition(call, 3, 9)
    let reference = inspection(analysis, text, "choose\nassert")
    only_type(reference, "fn(Bool) Bool")
    let declaration = query_offset(text, "choose(value Bool)")
    only_definition(reference, declaration, declaration + 6)
    let generic = inspection(analysis, text, "item }")
    assert length(generic.types) == 2
    assert (get(generic.types, 0) == "Int" && get(generic.types, 1) == "Bool") ||
    (get(generic.types, 1) == "Int" && get(generic.types, 0) == "Bool")
    let parameter = query_offset(text, "item T")
    only_definition(generic, parameter, parameter + 4)
}

test fn inspections_navigate_static_methods_and_dynamic_concept_signatures() {
    let text = "concept Read { fn read(self Self) Int }\nimpl Read for Int { fn read(self Int) Int { self } }\nfn main() {\nlet item = 7\nassert item.read() == 7\nlet view dyn Read = item\nassert view.read() == 7\n}"
    let analysis = accepted(input(text))
    let static_call = inspection(analysis, text, "read() == 7")
    only_type(static_call, "fn(Int) Int")
    let implementation = query_offset(text, "read(self Int)")
    only_definition(static_call, implementation, implementation + 4)
    let dynamic = match inspect_at(analysis, 0, query_offset(text, "view.read()") + 5) {
        Option.Some(found) => found
        Option.None => {
            assert false
            static_call
        }
    }
    only_type(dynamic, "fn() Int")
    let prototype = query_offset(text, "read(self Self)")
    only_definition(dynamic, prototype, prototype + 4)
    only_type(inspection(analysis, text, "view.read()"), "dyn app.Read")
}

test fn async_method_queries_keep_logical_signatures_and_task_result_types() {
    let text = "concept Read { async fn read(self Self) Int }\nimpl Read for Int { async fn read(self Int) Int { self } }\nasync fn main() { let view dyn Read = 7\nlet task = view.read()\nassert task.await == 7 }"
    let analysis = accepted(input(text))
    let call = inspection(analysis, text, "read()")
    only_type(call, "async fn() Int")
    let prototype = query_offset(text, "read(self Self)")
    only_definition(call, prototype, prototype + 4)
    only_type(inspection(analysis, text, "task ="), "Task[Int]")
    only_type(inspection(analysis, text, "await"), "Int")
}

test fn async_function_values_keep_source_types_in_editor_queries() {
    let text = "async fn item(value Int) Int { value }\nasync fn main() { let callback = item\nlet pending = callback(7)\nassert pending.await == 7 }"
    let analysis = accepted(input(text))
    only_type(inspection(analysis, text, "callback ="), "fn(Int) Task[Int]")
    only_type(inspection(analysis, text, "callback(7)"), "fn(Int) Task[Int]")
    only_type(inspection(analysis, text, "pending ="), "Task[Int]")
    only_type(inspection(analysis, text, "await"), "Int")
    let declaration = query_offset(text, "item(value")
    only_definition(inspection(analysis, text, "item\n"), declaration, declaration + 4)
}

test fn inspections_do_not_invent_results_for_comments_punctuation_or_unchecked_bodies() {
    let text = "fn unused[T](value T) T { value }\nfn main() {\nlet 数量 = 3\n// 数量 has no reference here\nassert 数量 == 3\n}"
    let analysis = accepted(input(text))
    let local = inspection(analysis, text, "数量 ==")
    only_type(local, "Int")
    let start = query_offset(text, "数量 =")
    only_definition(local, start, start + length("数量"))
    absent(analysis, query_offset(text, "数量 has"))
    absent(analysis, query_offset(text, "=="))
    absent(analysis, query_offset(text, "let 数量") + 3)
    absent(analysis, query_offset(text, "value }"))
    absent(analysis, query_offset(text, "value T"))
    absent(analysis, length(text))
}

test fn inspections_do_not_guess_dynamic_overloads_or_generated_constraint_references() {
    let overloaded = "concept Pick { fn pick(self Self, value Int) Int\nfn pick(self Self, value Bool) Bool }\nimpl Pick for Int { fn pick(self Int, value Int) Int { value }\nfn pick(self Int, value Bool) Bool { value } }\nfn main() { let view dyn Pick = 1\nassert view.pick(3) == 3 }"
    let dynamic = inspection(accepted(input(overloaded)), overloaded, "pick(3)")
    only_type(dynamic, "fn(Int) Int")
    assert length(dynamic.definitions) == 0
    let text = "import std.result.Result\nimport std.result.ConstraintError\ntype Positive = Int where valid(self)\nfn valid(value Int) Bool { value > 0 }\npub fn make(value Int) Result[Positive, ConstraintError] { Positive(value) }"
    let project = input(text)
    push(project.modules, ModuleInstance {
            name = "std"
            source = "/std"
        })
    push(project.packages, Package {
            instance = 1
            relative = "result"
            imports = new[PackageImport]()
        })
    push(get(project.packages, 0).imports, PackageImport {
            spelling = "std.result"
            target = 1
        })
    let standard = "pub enum Result[T, E] { Ok(T) Err(E) }\npub enum ConstraintError { Rejected }"
    let tree = get(input(standard).files, 0).tree
    push(project.files, SourceFile {
            package = 1
            path = "/std/result.loom"
            text = standard
            tree = tree
            test_only = false
            trusted_std = true
        })
    let constructor = inspection(accepted(project), text, "Positive(value)")
    only_type(constructor, "std.result.Result[app.Positive, std.result.ConstraintError]")
    assert length(constructor.definitions) == 0
}
