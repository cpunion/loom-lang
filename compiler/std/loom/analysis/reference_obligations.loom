import std.loom.binding.builtin_type_name
import std.loom.parser.parse
import std.loom.source.Diagnostic

// Explicit named bindings to compare when relocating this source tree.
// Declaration labels and lexical type binders do not need external resolution.
// An empty unknown list only establishes syntax coverage, not checked bindings,
// proof success, implicit effect coverage, or authority to rewrite the source.
pub record ReferenceObligations {
    offsets List[Int]
    unknown List[Span]
}

// This declaration has generic/static bindings. Concepts also bind Self even
// without explicit type parameters. No concrete witness/value is implied.
pub fn abstract_reference_scope(node Node) Bool {
    if node.kind == NodeKind.Concept || !ordinary_query_owner(node) {
        return true
    }
    if node.kind == NodeKind.Impl {
        var index = 0
        while index < length(node.children) {
            let member = get(node.children, index)
            if member.kind == NodeKind.Function && !ordinary_query_owner(member) {
                return true
            }
            index = index + 1
        }
    }
    false
}

fn reference_bound(parameters List[Text], name Text) Bool {
    var index = 0
    while index < length(parameters) {
        if get(parameters, index) == name {
            return true
        }
        index = index + 1
    }
    false
}

fn reference_parameters(node Node, inherited List[Text]) List[Text] {
    let parameters = new[Text]()
    var index = 0
    while index < length(inherited) {
        push(parameters, get(inherited, index))
        index = index + 1
    }
    if node.kind == NodeKind.Concept || node.kind == NodeKind.Impl {
        push(parameters, "Self")
    }
    index = 0
    while index < length(node.children) {
        let group = get(node.children, index)
        if group.kind == NodeKind.TypeParameters {
            var parameter = 0
            while parameter < length(group.children) {
                push(parameters, get(group.children, parameter).value)
                parameter = parameter + 1
            }
        }
        index = index + 1
    }
    parameters
}

fn reference_children(node Node, tokens List[Token], parameters List[Text], output ReferenceObligations, pattern Bool, implicit_self Bool) {
    var index = 0
    while index < length(node.children) {
        let binding = if node.kind == NodeKind.Destructure || node.kind == NodeKind.Arm {
            index == 0
        } else {
            pattern
        }
        let role = if (node.kind == NodeKind.Impl && index == 0) ||
        (node.kind == NodeKind.Implements && index == 1) {
            NodeKind.Bounds
        } else {
            node.kind
        }
        reference_nodes(get(node.children, index), role, tokens, parameters, output, binding, implicit_self)
        index = index + 1
    }
}

fn reference_nodes(node Node, parent NodeKind, tokens List[Token], inherited List[Text], output ReferenceObligations, pattern Bool, inherited_self Bool) {
    let kind = node.kind
    if has(node, NodeKind.ExpansionId) || kind == NodeKind.ExpansionId {
        push(output.unknown, node.span)
        return
    }
    if kind == NodeKind.Comptime && length(node.children) != 0 {
        // An ordinary block keeps source-reference roles across staging. This
        // does not establish checked bindings or cover selected/generated AST.
        if length(node.children) != 1 || get(node.children, 0).kind != NodeKind.Block {
            push(output.unknown, node.span)
            return
        }
    }
    // Names inside patterns introduce locals. Their later uses are ordinary
    // references, while nominal paths and field labels still resolve bindings.
    if pattern && kind == NodeKind.Name {
        return
    }
    let parameters = if kind == NodeKind.Function || kind == NodeKind.Record ||
    kind == NodeKind.Enum || kind == NodeKind.Concept || kind == NodeKind.Refined ||
    kind == NodeKind.Impl || kind == NodeKind.AssociatedType {
        reference_parameters(node, inherited)
    } else {
        inherited
    }
    let implicit_self = inherited_self || kind == NodeKind.Refined
    if implicit_self && (kind == NodeKind.Name || kind == NodeKind.Call) && node.value == "self" {
        reference_children(node, tokens, parameters, output, pattern, implicit_self)
        return
    }
    if kind == NodeKind.TypeParameters {
        var index = 0
        while index < length(node.children) {
            let parameter = get(node.children, index)
            if parameter.kind != NodeKind.Name && parameter.kind != NodeKind.TypePack {
                push(output.unknown, parameter.span)
            } else {
                // A parameter's bounds are uses even though its label is not.
                var bound = 0
                while bound < length(parameter.children) {
                    reference_nodes(get(parameter.children, bound), NodeKind.Bounds, tokens, parameters, output, false, implicit_self)
                    bound = bound + 1
                }
            }
            index = index + 1
        }
        return
    }
    // Bounds resolve concepts in their own namespace, even if a type binder
    // has the same spelling. Ordinary type uses still resolve lexical binders.
    let type_expression = kind == NodeKind.Name && parent == NodeKind.Implements
    if type_expression && (builtin_type_name(node.value) || reference_bound(parameters, node.value)) {
        return
    }
    let named_type = kind == NodeKind.DynType || (kind == NodeKind.Type && (parent == NodeKind.Bounds ||
            (!builtin_type_name(node.value) && node.value != "type" && !reference_bound(parameters, node.value))))
    let associated_use = kind == NodeKind.AssociatedType && parent == NodeKind.DynType
    let field_use = kind == NodeKind.Field && (parent == NodeKind.Construct || parent == NodeKind.RecordPattern)
    let pattern_use = kind == NodeKind.Pattern || kind == NodeKind.RecordPattern
    if named_type || associated_use || field_use || pattern_use || kind == NodeKind.Name || kind == NodeKind.Call ||
    kind == NodeKind.Construct || kind == NodeKind.Assign || kind == NodeKind.Select || kind == NodeKind.MethodCall {
        let from = if (kind == NodeKind.Select || kind == NodeKind.MethodCall) && length(node.children) > 0 {
            get(node.children, 0).span.end
        } else {
            node.span.start
        }
        let until = if (named_type || associated_use || field_use || pattern_use || kind == NodeKind.Name || kind == NodeKind.Call ||
            kind == NodeKind.Construct || kind == NodeKind.Assign) && length(node.children) > 0 {
            get(node.children, 0).span.start
        } else {
            node.span.end
        }
        var selected = -1
        var index = 0
        while index < length(tokens) {
            let token = get(tokens, index)
            if token.span.start >= from && token.span.end <= until && token.kind == Kind.Name &&
            ((kind != NodeKind.Select && kind != NodeKind.MethodCall) || token.value == node.value) {
                if kind == NodeKind.Name && !(implicit_self && token.value == "self" && token.span.start == node.span.start) {
                    push(output.offsets, token.span.start)
                }
                selected = token.span.start
            }
            index = index + 1
        }
        if selected < 0 {
            push(output.unknown, node.span)
        } else if kind != NodeKind.Name {
            push(output.offsets, selected)
        }
    } else if kind != NodeKind.File && kind != NodeKind.Type && kind != NodeKind.Record &&
    kind != NodeKind.Enum && kind != NodeKind.Concept && kind != NodeKind.Variant &&
    kind != NodeKind.Refined && kind != NodeKind.Impl && kind != NodeKind.AssociatedType && kind != NodeKind.Implements &&
    !(kind == NodeKind.Field && (parent == NodeKind.Record || parent == NodeKind.Variant)) &&
    kind != NodeKind.Function && kind != NodeKind.Public && kind != NodeKind.Test &&
    kind != NodeKind.Intrinsic && kind != NodeKind.Parameters && kind != NodeKind.Parameter &&
    kind != NodeKind.TypeArguments && kind != NodeKind.Arguments && kind != NodeKind.Bounds &&
    kind != NodeKind.ReturnType && kind != NodeKind.Block && kind != NodeKind.Return &&
    kind != NodeKind.Assert && kind != NodeKind.Discard && kind != NodeKind.Integer &&
    kind != NodeKind.Text && kind != NodeKind.Bool && kind != NodeKind.Float &&
    kind != NodeKind.Unary && kind != NodeKind.Binary && kind != NodeKind.If &&
    kind != NodeKind.Let && kind != NodeKind.Var && kind != NodeKind.While &&
    kind != NodeKind.Requires && kind != NodeKind.Ensures && kind != NodeKind.Await &&
    kind != NodeKind.Tuple && kind != NodeKind.List && kind != NodeKind.Apply &&
    kind != NodeKind.Index && kind != NodeKind.IndexAssign && kind != NodeKind.Invoke &&
    kind != NodeKind.FunctionType && kind != NodeKind.TupleType && kind != NodeKind.Defer &&
    kind != NodeKind.Scoped && kind != NodeKind.Async && kind != NodeKind.Try &&
    kind != NodeKind.Old && kind != NodeKind.Spread && kind != NodeKind.Break &&
    kind != NodeKind.Continue && kind != NodeKind.Comptime && kind != NodeKind.Match &&
    kind != NodeKind.Arm && kind != NodeKind.Destructure && kind != NodeKind.Bindings &&
    kind != NodeKind.Wildcard && kind != NodeKind.RestPattern {
        push(output.unknown, node.span)
        return
    }
    reference_children(node, tokens, parameters, output, pattern, implicit_self)
}

// The AST and tokens must describe the same source snapshot. Positions follow
// AST traversal order; unsupported or missing-token ranges remain explicit.
pub fn reference_obligations(tree Node, tokens List[Token]) ReferenceObligations {
    let output = ReferenceObligations {
        offsets = new[Int]()
        unknown = new[Span]()
    }
    reference_nodes(tree, NodeKind.File, tokens, new[Text](), output, false, false)
    output
}

pub fn reference_obligations(source Text) Result[ReferenceObligations, Diagnostic] {
    let tree = parse(source)?
    let tokens = lex(source)?
    Result.Ok(reference_obligations(tree, tokens))
}
