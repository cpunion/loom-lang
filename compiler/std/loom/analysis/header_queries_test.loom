test fn checked_headers_navigate_nominal_types_inside_compound_signatures() {
    let text = """
        record Item {
            count Int
        }
        record Box[T] {
            value T
        }
        pub fn select(value Box[Item], pair (Item, List[Item]), read fn(Item) Item) Item {
            discard value
            read(pair.0)
        }
        """
    let analysis = accepted(input(text))
    let item = query_offset(text, "Item {")
    let box = query_offset(text, "Box[T]")
    let references = ["Item], pair", "Item, List", "Item]), read", "Item) Item", "Item) Item {", "Item {\n    discard"]
    var index = 0
    while index < length(references) {
        let found = inspection(analysis, text, get(references, index))
        only_type(found, "app.Item")
        only_definition(found, item, item + 4)
        index = index + 1
    }
    let constructor = inspection(analysis, text, "Box[Item]")
    only_type(constructor, "app.Box[app.Item]")
    only_definition(constructor, box, box + 3)
}

test fn specialized_header_parameters_do_not_guess_same_spelled_nominal_definitions() {
    let text = """
        record Item {
            count Int
        }
        fn identity[Item](value Item) Item {
            value
        }
        fn main() {
            let value = Item { count = 7 }
            assert identity(value).count == 7
        }
        """
    let analysis = accepted(input(text))
    let locations = ["Item](value", "Item) Item", "Item {\n    value"]
    var index = 0
    while index < length(locations) {
        let found = match inspect_at(analysis, 0, query_offset(text, get(locations, index))) {
            Option.Some(value) => value
            Option.None => {
                assert false
                return
            }
        }
        let parameter = query_offset(text, "Item](value")
        only_type(found, "Item")
        only_definition(found, parameter, parameter + 4)
        index = index + 1
    }
}

test fn source_generic_headers_do_not_mix_in_concrete_application_instances() {
    let source = """
        record Box[T] {
            value T
        }
        record Envelope[T] {
            value Box[T]
        }
        enum Choice[T] {
            Some(Box[T])
            Empty
        }
        fn identity[T](value Box[T]) Box[T] {
            value
        }
        fn concrete(value Envelope[Text]) {
            discard value
        }
        fn main() {
            let box = Box { value = 7 }
            discard Envelope { value = box }
            discard Choice.Some(Box { value = true })
            assert identity(box).value == 7
        }
        """
    let analysis = accepted(input(source))
    let declared = query_offset(source, "Box[T] {")
    let uses = ["Box[T]\n}", "Box[T])\n    Empty", "Box[T]) Box", "Box[T] {\n    value T", "Box[T] {\n    value\n}"]
    var index = 0
    while index < length(uses) {
        let fragment = get(uses, index)
        let found = inspection(analysis, source, fragment)
        only_type(found, "app.Box[T]")
        only_definition(found, declared, declared + 3)
        only_type(cached_inspection(analysis, source, fragment), "app.Box[T]")
        index = index + 1
    }
}

test fn recovered_data_headers_validate_layouts_before_publishing_query_facts() {
    let invalid = """
        record Loop {
            next Loop
        }
        fn main() {
            let wrong Int = true
            discard wrong
        }
        """
    let broken = query_bindings(input(invalid))
    assert match inspect_independent(broken, 0, query_offset(invalid, "Loop\n}")) {
        Option.None => true
        Option.Some(_) => false
    }
    let valid = """
        record Tree {
            children List[Tree]
        }
        fn main() {
            let wrong Int = true
            discard wrong
        }
        """
    let bindings = query_bindings(input(valid))
    let found = independent_found(bindings, valid, "Tree]")
    let declared = query_offset(valid, "Tree {\n")
    only_type(found, "app.Tree")
    only_definition(found, declared, declared + 4)
}

test fn data_and_local_annotations_use_checked_nominal_identities() {
    let text = """
        record Item {
            count Int
        }
        record Envelope {
            item Item
            history List[Item]
        }
        enum Choice {
            Some(Item)
            Empty
        }
        type Positive = Item where self.count > 0
        fn positive(value Positive) Item {
            value
        }
        fn main() {
            let current Item = Item { count = 7 }
            var saved List[Item] = [current]
            discard saved
            discard Envelope { item = current, history = [current] }
            let choice Choice = Choice.Some(current)
            assert match choice {
                Choice.Some(item) => item.count == 7
                Choice.Empty => false
            }
        }
        """
    let analysis = accepted(input(text))
    let item = query_offset(text, "Item {")
    let references = ["Item\n    history", "Item]\n}", "Item)\n    Empty", "Item where", "Item =", "Item] ="]
    var index = 0
    while index < length(references) {
        let found = inspection(analysis, text, get(references, index))
        only_type(found, "app.Item")
        only_definition(found, item, item + 4)
        index = index + 1
    }
    let choice = query_offset(text, "Choice {")
    let variants = ["Choice.Some(current)", "Choice.Some(item)", "Choice.Empty =>"]
    index = 0
    while index < length(variants) {
        let found = inspection(analysis, text, get(variants, index))
        only_type(found, "app.Choice")
        only_definition(found, choice, choice + 6)
        index = index + 1
    }
}

test fn variant_constructor_and_pattern_queries_do_not_select_the_enum_name() {
    let text = """
        enum Choice {
            Choice(Int)
            Empty
        }

        fn create(number Int) Choice {
            Choice.Choice(number)
        }

        fn selected() Int {
            match create(3) {
                Choice.Choice(item) => item
                Choice.Empty => 0
            }
        }

        fn main() {
            assert selected() == 3
        }
        """
    let analysis = accepted(input(text))
    let nominal = query_offset(text, "Choice {")
    let variant = query_offset(text, "Choice(Int)")
    let roots = ["Choice.Choice(number)", "Choice.Choice(item)"]
    let tags = ["Choice(number)", "Choice(item)"]
    var index = 0
    while index < length(roots) {
        only_definition(inspection(analysis, text, get(roots, index)), nominal, nominal + 6)
        only_definition(inspection(analysis, text, get(tags, index)), variant, variant + 6)
        index = index + 1
    }
}
