import std.loom.checking.DeclarationReference
import std.loom.checking.declaration_references

fn ordinary_query_owner(node Node) Bool {
    var index = 0
    while index < length(node.children) {
        let group = get(node.children, index)
        if group.kind == NodeKind.TypeParameters && length(group.children) != 0 {
            return false
        }
        if group.kind == NodeKind.Parameters {
            var parameter = 0
            while parameter < length(group.children) {
                if has(get(group.children, parameter), NodeKind.Comptime) {
                    return false
                }
                parameter = parameter + 1
            }
        }
        index = index + 1
    }
    true
}

fn inspect_declaration_references(view CheckedQuery, report Inspection, target Query, file Int, references List[DeclarationReference]) {
    var index = 0
    while index < length(references) {
        let reference = get(references, index)
        let node = reference.node
        // Type resolution rewrites selected receivers and wraps an applied
        // Name as a Type. Keep its source origin and checked path segment.
        let same_kind = node.kind == target.node.kind ||
        (node.kind == NodeKind.Type && target.node.kind == NodeKind.Name)
        if reference.file == file && node.span.start == target.node.span.start && node.span.end >= target.node.span.end &&
        same_kind && reference.segment == target.segment {
            let owner = get(view.bindings.symbols, reference.symbol)
            let member = if node.kind == NodeKind.Field {
                NodeKind.Field
            } else {
                if node.kind == NodeKind.Pattern && target.segment + 1 == target.segments {
                    NodeKind.Variant
                } else {
                    NodeKind.File
                }
            }
            var matched = false
            if member != NodeKind.File {
                var child = 0
                while child < length(owner.node.children) {
                    let declaration_node = get(owner.node.children, child)
                    if declaration_node.kind == member && declaration_node.value == target.token.value {
                        declaration(view, report, owner.file, declaration_node)
                        matched = true
                    }
                    child = child + 1
                }
            } else {
                if owner.name == target.token.value {
                    symbol_location(view, report, reference.symbol)
                    matched = true
                }
            }
            if matched && reference.label != "" {
                add_type(report, reference.label)
            }
        }
        index = index + 1
    }
}

fn analysis_query_inputs(analysis AnalysisState) BuildInputs {
    let inputs = with_proof_backend(build_inputs(no_input_reader, analysis.options), analysis.proof_backend)
    var index = 0
    while index < length(analysis.inputs) {
        push(inputs.files, get(analysis.inputs, index))
        index = index + 1
    }
    index = 0
    while index < length(analysis.targets) {
        push(inputs.targets, get(analysis.targets, index))
        index = index + 1
    }
    inputs
}

fn declaration_query_scope(bindings std.loom.binding.Program, file Int, offset Int) Location {
    var scope = Location {
        file = -1
        span = get(bindings.files, file).tree.span
    }
    var index = 0
    while index < length(bindings.symbols) {
        let symbol = get(bindings.symbols, index)
        let node = symbol.node
        if symbol.file == file && symbol.owner < 0 && node.kind == NodeKind.Function &&
        inside(node.span, offset) && ordinary_query_owner(node) {
            scope = Location {
                file = file
                span = node.span
            }
        }
        index = index + 1
    }
    scope
}

// Keep the cheap nominal records after a checked body view is evicted. Both
// query paths publish through this cache; headers never mark a body checked.
fn retain_declaration_scope(analysis AnalysisState, scope Location, references List[DeclarationReference]) {
    var index = 0
    while index < length(analysis.declaration_scopes) {
        let previous = get(analysis.declaration_scopes, index)
        if previous.file < 0 || (previous.file == scope.file && same_span(previous.span, scope.span)) {
            return
        }
        index = index + 1
    }
    push(analysis.declaration_scopes, scope)
    if length(analysis.declarations) == 0 {
        push(analysis.declarations, references)
    } else if scope.file < 0 {
        set(analysis.declarations, 0, references)
    } else {
        let stored = get(analysis.declarations, 0)
        index = 0
        while index < length(references) {
            push(stored, get(references, index))
            index = index + 1
        }
    }
}

// A successful analysis lazily records erased bindings per checked scope. Readers
// replay the analysis's observed input snapshots, never fresh filesystem data.
// Ordinary body queries and ordinary compilation do not run this extra check.
fn inspect_declaration_at(analysis AnalysisState, view CheckedQuery, file Int, offset Int, tokens List[Token]) Option[Inspection] {
    if file < 0 || file >= length(view.bindings.files) {
        return Option.None
    }
    var index = 0
    while index < length(analysis.declaration_scopes) {
        let scope = get(analysis.declaration_scopes, index)
        if scope.file < 0 || (scope.file == file && inside(scope.span, offset)) {
            return Option.None
        }
        index = index + 1
    }
    let source = get(view.bindings.files, file)
    let token = match token_at(tokens, offset) {
        Option.Some(value) => value
        Option.None => {
            return Option.None
        }
    }
    let target = match query(source.tree, token, tokens) {
        Option.Some(value) => value
        Option.None => {
            return Option.None
        }
    }
    var possible = target.node.kind == NodeKind.Pattern || target.node.kind == NodeKind.RecordPattern ||
    target.node.kind == NodeKind.Field
    index = 0
    while index < length(view.bindings.symbols) {
        let symbol = get(view.bindings.symbols, index)
        possible = possible || ((symbol.node.kind == NodeKind.Function || symbol.node.kind == NodeKind.Concept || symbol.node.kind == NodeKind.AssociatedType ||
                symbol.node.kind == NodeKind.Record || symbol.node.kind == NodeKind.Enum || symbol.node.kind == NodeKind.Refined) &&
            symbol.name == token.value)
        index = index + 1
    }
    if !possible {
        return Option.None
    }
    let inputs = analysis_query_inputs(analysis)
    // A successful analysis already checked unrelated bodies. Reuse the query
    // checker for an ordinary source function's closure; static/generic owners
    // still need application instances to account for their selected branches.
    let scope = declaration_query_scope(view.bindings, file, offset)
    let references = if scope.file >= 0 {
        match check_query(view.bindings, file, offset, inputs) {
            Result.Ok(value) => value.declarations
            Result.Err(_) => new[DeclarationReference]()
        }
    } else {
        match declaration_references(view.bindings, inputs) {
            Result.Ok(value) => value
            Result.Err(_) => new[DeclarationReference]()
        }
    }
    retain_declaration_scope(analysis, scope, references)
    let report = Inspection {
        span = token.span
        types = new[Text]()
        definitions = new[Location]()
    }
    inspect_declaration_references(view, report, target, file, references)
    if length(report.definitions) == 0 {
        return Option.None
    }
    Option.Some(report)
}
