test fn data_pack_headers_keep_fixed_parameters_and_symbolic_words_in_one_query_scope() {
    let text = """
        record Tag {
            value Int
        }
        record Box[T] {
            value T
        }
        record Bundle[Tag, As..., Middle, Bs..., Tail] {
            tag Tag
            first (As...)
            middle List[Middle]
            second (Bs...)
            read fn(Tail) Box[Tag]
        }
        enum Choice[Ts..., End] {
            Some((Ts...), Box[End])
            Empty
        }
        """
    let analysis = accepted(input(text))
    let fragments = ["Tag\n    first", "As...)\n    middle", "Middle]\n    second",
        "Bs...)\n    read", "Tail) Box", "Tag]\n}", "Ts...), Box", "End])"]
    let declarations = ["Tag, As...", "As..., Middle", "Middle, Bs...", "Bs..., Tail",
        "Tail] {", "Tag, As...", "Ts..., End", "End] {"]
    let labels = ["Tag", "As...", "Middle", "Bs...", "Tail", "Tag", "Ts...", "End"]
    let widths = [3, 2, 6, 2, 4, 3, 2, 3]
    var index = 0
    while index < length(fragments) {
        let found = cached_inspection(analysis, text, get(fragments, index))
        let declared = query_offset(text, get(declarations, index))
        only_type(found, get(labels, index))
        only_definition(found, declared, declared + get(widths, index))
        let binder = cached_inspection(analysis, text, get(declarations, index))
        only_type(binder, get(labels, index))
        only_definition(binder, declared, declared + get(widths, index))
        index = index + 1
    }
    let box = query_offset(text, "Box[T] {")
    let closed = cached_inspection(analysis, text, "Box[End]")
    only_type(closed, "app.Box[End]")
    only_definition(closed, box, box + 3)
    only_type(cached_inspection(analysis, text, "Box[Tag]"), "app.Box[Tag]")
    assert match get(analysis.independent_queries, 0) {
        Option.Some(saved) => saved.header && length(saved.view.functions) == 0 &&
        saved.scope.span.start == query_offset(text, "record Bundle[")
        Option.None => false
    }
}

test fn data_pack_header_queries_recover_unrelated_bodies_but_reject_invalid_headers() {
    let text = """
        record Box[T] {
            value T
        }
        record Bundle[Ts..., End] {
            values (Ts...)
            last Box[End]
        }
        fn main() {
            let wrong Int = true
            discard wrong
        }
        """
    let bindings = query_bindings(input(text))
    let declared = query_offset(text, "End] {")
    let found = independent_found(bindings, text, "End]\n}")
    only_type(found, "End")
    only_definition(found, declared, declared + 3)
    let invalid = std.text.replace(text, "last Box[End]", "last Box[End, Int]")
    assert match inspect_independent(query_bindings(input(invalid)), 0, query_offset(invalid, "Ts...)")) {
        Option.None => true
        Option.Some(_) => false
    }
}

test fn data_pack_projection_queries_keep_source_member_and_concept_segments() {
    let text = """
        concept Tagged {}
        concept Source {
            type Item Tagged
        }
        record Box[T Tagged] {
            value T
        }
        record Rows[Ts... Source] {
            values (Box[Ts.Source.Item]...)
            views (dyn Source[Item = Ts.Item]...)
        }
        """
    let analysis = accepted(input(text))
    let member = query_offset(text, "Item Tagged")
    only_definition(cached_inspection(analysis, text, "Item]..."), member, member + 4)
    only_definition(cached_inspection(analysis, text, "Item = Ts"), member, member + 4)
    let capability = query_offset(text, "Source {")
    only_definition(cached_inspection(analysis, text, "Source.Item"), capability, capability + 6)
    let invalid = std.text.replace(text, "Ts.Source.Item", "Ts.Missing")
    assert match inspect_independent(query_bindings(input(invalid)), 0, query_offset(invalid, "Ts... Source")) {
        Option.None => true
        Option.Some(_) => false
    }
}

test fn scoped_data_pack_family_parameters_shadow_outer_words_in_queries() {
    let text = """
        concept Family {
            type Item[T]
        }
        record Rows[Ts...] {
            sources (Ts...)
            value dyn Family[Item[Ts] = (Ts, Bool)]
        }
        """
    let analysis = accepted(input(text))
    let outer = query_offset(text, "Ts...]")
    let inner = query_offset(text, "Ts] =")
    only_definition(cached_inspection(analysis, text, "Ts...)"), outer, outer + 2)
    only_definition(cached_inspection(analysis, text, "Ts, Bool"), inner, inner + 2)
    only_definition(cached_inspection(analysis, text, "Ts] ="), inner, inner + 2)
    only_type(cached_inspection(analysis, text, "Ts, Bool"), "Ts")
}

test fn whole_word_family_headers_keep_checked_labels_and_local_binders() {
    let text = """
        concept Family {
            type Item[T]
        }
        record Rows[As..., Tail] {
            value dyn Family[Item[U] = (As..., Tail, U)]
        }
        """
    let analysis = accepted(input(text))
    let member = query_offset(text, "Item[T]")
    only_definition(cached_inspection(analysis, text, "Item[U] ="), member, member + 4)
    let word = query_offset(text, "As..., Tail]")
    only_definition(cached_inspection(analysis, text, "As..., Tail, U"), word, word + 2)
    let fixed = query_offset(text, "Tail] {")
    only_definition(cached_inspection(analysis, text, "Tail, U"), fixed, fixed + 4)
    let local = query_offset(text, "U] =")
    only_definition(cached_inspection(analysis, text, "U)]"), local, local + 1)
    only_type(cached_inspection(analysis, text, "U)]"), "U")
}
