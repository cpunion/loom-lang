fn source_contract_at(node Node, offset Int) Bool {
    if !inside(node.span, offset) {
        return false
    }
    if node.kind == NodeKind.Requires || node.kind == NodeKind.Ensures {
        return true
    }
    var index = 0
    while index < length(node.children) {
        if source_contract_at(get(node.children, index), offset) {
            return true
        }
        index = index + 1
    }
    false
}

// Normalized proof expressions deliberately have clause-wide spans. Lazily
// inspect separately checked source clauses instead of guessing their bindings.
// Inputs replay this successful analysis's snapshots, not the filesystem.
fn inspect_source_contract(analysis AnalysisState, file Int, offset Int, tokens List[Token]) Option[Inspection] {
    if length(analysis.contract_queries) == 0 {
        match check_query(analysis.bindings, analysis_query_inputs(analysis)) {
            Result.Ok(view) => {
                push(analysis.contract_queries, view)
            }
            Result.Err(_) => {
                return Option.None
            }
        }
    }
    var index = 0
    while index < length(analysis.contract_queries) {
        match inspect_view(get(analysis.contract_queries, index), file, offset, tokens) {
            Option.Some(found) => {
                return Option.Some(found)
            }
            Option.None => {
            }
        }
        index = index + 1
    }
    // An ordinary private function need not be reached from application roots.
    // Check its own closure; do not invent instances for uncalled templates.
    match check_query(analysis.bindings, file, offset, analysis_query_inputs(analysis)) {
        Result.Ok(view) => {
            let found = inspect_view(view, file, offset, tokens)
            match found {
                Option.Some(_) => {
                    push(analysis.contract_queries, view)
                }
                Option.None => {
                }
            }
            found
        }
        Result.Err(_) => Option.None
    }
}
