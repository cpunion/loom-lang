// One answer per requested source position. Missing, type-only and ambiguous
// inspections are retained, not interpreted as proof that a reference is absent.
pub record ReferenceEvidence {
    offset Int
    inspection Option[Inspection]
}

fn reference_tokens(analysis AnalysisState, file Int) Result[List[Token], Text] {
    if file < 0 || file >= length(analysis.bindings.files) {
        return Result.Err("reference query has no source file")
    }
    match lex(get(analysis.bindings.files, file).text) {
        Result.Ok(tokens) => Result.Ok(tokens)
        Result.Err(problem) => Result.Err(problem.message)
    }
}

fn reference_evidence(analysis AnalysisState, file Int, offsets List[Int], tokens Option[List[Token]]) List[ReferenceEvidence] {
    let references = new[ReferenceEvidence]()
    var index = 0
    while index < length(offsets) {
        let offset = get(offsets, index)
        push(references, ReferenceEvidence {
                offset = offset
                inspection = match tokens {
                    Option.Some(source) => checked_inspection(analysis, file, offset, source)
                    Option.None => Option.None
                }
            })
        index = index + 1
    }
    references
}

// A batch reuses one source token stream. Invalid sources still retain an
// unanswered entry for every requested position rather than dropping a site.
fn inspect_references(analysis AnalysisState, file Int, offsets List[Int]) List[ReferenceEvidence] {
    match reference_tokens(analysis, file) {
        Result.Ok(tokens) => reference_evidence(analysis, file, offsets, Option.Some(tokens))
        Result.Err(_) => reference_evidence(analysis, file, offsets, Option.None)
    }
}

// Scan exact source name tokens, excluding comments and text literals. This is
// candidate evidence, not complete semantic coverage of generated/static code.
// Consumers still need their own authority and unaccounted-use checks.
fn inspect_references(analysis AnalysisState, file Int, spelling Text) Result[List[ReferenceEvidence], Text] {
    let tokens = reference_tokens(analysis, file)?
    let offsets = new[Int]()
    var index = 0
    while index < length(tokens) {
        let token = get(tokens, index)
        if token.kind == Kind.Name && token.value == spelling {
            push(offsets, token.span.start)
        }
        index = index + 1
    }
    Result.Ok(reference_evidence(analysis, file, offsets, Option.Some(tokens)))
}
