import std.loom.project.InputRequest
import std.loom.project.InputFile
import std.encoding.hex.decode
import std.bytes.to_text
import std.bytes.set
import std.bytes.new
import std.loom.proof.ProofBackend
import std.loom.checking.with_proof_backend
import std.text.contains

fn analysis_test_backend(context Text, query Text) Result[Bool, Text] {
    assert std.text.contains(query, "(check-sat-using ")
    Result.Err(context)
}

test fn analysis_preserves_the_hosts_explicit_proof_backend() {
    let project = input("""
        fn square(value Int) Int
        ensures result >= 0
        {
            value * value
        }
        """)
    assert match analyze(project, false) {
        Result.Err(_) => true
        _ => false
    }
    let inputs = std.loom.checking.with_proof_backend(build_inputs(no_input_reader),
        ProofBackend {
            enabled = true
            context = "analysis backend sentinel"
            solve = analysis_test_backend
        })
    // Test capability forwarding, not a mocked successful mathematical proof.
    assert match analyze_with_inputs(project, false, inputs) {
        Result.Err(failed) => std.text.contains(failed.diagnostic.message, "analysis backend sentinel")
        _ => false
    }
}

fn input_bytes_fixture(text Text) Bytes {
    match std.encoding.hex.decode(text) {
        Result.Ok(bytes) => bytes
        Result.Err(_) => {
            assert false
            std.bytes.new()
        }
    }
}

test fn analysis_detaches_build_snapshots_and_freshness_checks_their_contents() {
    let project = input("""
        import std.build.input_file
        fn main() {
            let message = comptime {
                let captured = input_file("message.txt")
                captured
            }
            discard message
        }
        """)
    push(project.modules, ModuleInstance {
            name = "std"
            source = "/std"
        })
    push(project.packages, Package {
            instance = 1
            relative = "build"
            imports = new[PackageImport]()
        })
    push(get(project.packages, 0).imports, PackageImport {
            spelling = "std.build"
            target = 1
        })
    let declaration = "pub intrinsic fn input_file(comptime path Text) Text"
    let tree = match parse(declaration) {
        Result.Ok(value) => value
        Result.Err(_) => {
            assert false
            return
        }
    }
    push(project.files, SourceFile {
            package = 1
            path = "/std/build/build.loom"
            text = declaration
            tree = tree
            test_only = false
            trusted_std = true
        })
    let inputs = build_inputs(no_input_reader)
    push(inputs.options, BuildOption {
            name = "app.mode"
            value = "first"
        })
    let request = InputRequest {
        root = "/app"
        source = "main.loom"
        path = "message.txt"
    }
    push(inputs.files, BuildInput {
            request = request
            file = InputFile {
                path = "/app/message.txt"
                bytes = input_bytes_fixture("6669727374")
            }
        })
    let analysis = match analyze_with_inputs(project, false, inputs) {
        Result.Ok(value) => value.state
        Result.Err(_) => {
            assert false
            return
        }
    }
    assert !is_current(analysis, project, false)
    assert !is_current_with_inputs(analysis, project, false, inputs.files)
    assert is_current_with_inputs(analysis, project, false, inputs.files, inputs.options)
    std.bytes.set(get(inputs.files, 0).file.bytes, 0, 70)
    assert std.bytes.to_text(get(analysis.inputs, 0).file.bytes) == "first"
    assert !is_current_with_inputs(analysis, project, false, inputs.files, inputs.options)
    std.bytes.set(get(inputs.files, 0).file.bytes, 0, 102)
    set(inputs.options, 0, BuildOption {
            name = "app.mode"
            value = "other"
        })
    assert get(analysis.options, 0).value == "first"
    assert !is_current_with_inputs(analysis, project, false, inputs.files, inputs.options)
    set(inputs.options, 0, get(analysis.options, 0))
    push(inputs.targets, BuildOption {
            name = "os"
            value = "linux"
        })
    let targeted = match analyze_with_inputs(project, false, inputs) {
        Result.Ok(value) => value.state
        Result.Err(_) => {
            assert false
            return
        }
    }
    assert !is_current_with_inputs(targeted, project, false, inputs.files, inputs.options)
    assert is_current_with_inputs(targeted, project, false, inputs.files, inputs.options, inputs.targets)
    set(inputs.targets, 0, BuildOption {
            name = "os"
            value = "macos"
        })
    assert get(targeted.targets, 0).value == "linux"
    assert !is_current_with_inputs(targeted, project, false, inputs.files, inputs.options, inputs.targets)
    set(inputs.files, 0, BuildInput {
            request = request
            file = InputFile {
                path = "/app/message.txt"
                bytes = input_bytes_fixture("6f74686572")
            }
        })
    assert std.bytes.to_text(get(analysis.inputs, 0).file.bytes) == "first"
    assert !is_current_with_inputs(analysis, project, false, inputs.files, inputs.options)
    // Independent queries replay the successful analysis, not the subsequently
    // modified inputs or a new filesystem read (the reader here always fails).
    let site = query_offset(get(project.files, 0).text, "message\n")
    assert match inspect_independent(analysis.bindings, 0, site) {
        Option.None => true
        Option.Some(_) => false
    }
    assert match inspect_independent(analysis, 0, site) {
        Option.Some(found) => length(found.types) == 1 && get(found.types, 0) == "Text"
        Option.None => false
    }
    let staged = query_offset(get(project.files, 0).text, "captured\n")
    assert match inspect_independent(analysis.bindings, 0, staged) {
        Option.None => true
        Option.Some(_) => false
    }
    let found = match inspect_independent(analysis, 0, staged) {
        Option.Some(value) => value
        Option.None => {
            assert false
            return
        }
    }
    only_type(found, "Text")
    let declaration_site = query_offset(get(project.files, 0).text, "captured =")
    only_definition(found, declaration_site, declaration_site + 8)
}
