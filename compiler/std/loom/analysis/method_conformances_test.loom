test fn method_conformances_follow_checked_overload_slots_and_generic_headers() {
    let source = """
        concept Read {
            fn read(self Self, value Int) Int
            fn read(self Self, value Bool) Bool
        }
        record Box[T] {
            value T
        }
        impl[T] Read for Box[T] {
            fn read(self Box[T], value Bool) Bool {
                value
            }
            fn read(self Box[T], value Int) Int {
                value
            }
        }
        """
    let analysis = published(input(source))
    let edges = match method_conformances(analysis) {
        Result.Ok(value) => value
        Result.Err(_) => {
            assert false
            new[(Location, Location)]()
        }
    }
    assert length(edges) == 2
    var index = 0
    while index < length(edges) {
        let edge = get(edges, index)
        let integer = edge.0.span.start == query_offset(source, "read(self Box[T], value Int)")
        assert edge.0.file == 0 && edge.1.file == 0
        assert edge.1.span.start == query_offset(source, if integer {
                "read(self Self, value Int)"
            } else {
                "read(self Self, value Bool)"
            })
        index = index + 1
    }
    discard take_last(edges)
    assert match method_conformances(analysis) {
        Result.Ok(current) => length(current) == 2
        Result.Err(_) => false
    }
}

test fn method_conformances_keep_variadic_and_generic_source_slots_after_instantiation() {
    let source = """
        concept Keep {
            fn keep[Ts...](self Self, values Ts...) (Ts...)
            fn echo[T](self Self, value T) T
        }
        impl Keep for Bool {
            fn keep[Us...](self Bool, values Us...) (Us...) {
                values
            }
            fn echo[U](self Bool, value U) U {
                value
            }
        }
        fn main() {
            assert true.keep(1, "two", false).2 == false
            assert true.echo(7) == 7
        }
        """
    let edges = match method_conformances(published(input(source))) {
        Result.Ok(value) => value
        Result.Err(_) => {
            assert false
            new[(Location, Location)]()
        }
    }
    assert length(edges) == 2
    var index = 0
    while index < length(edges) {
        let edge = get(edges, index)
        let variadic = edge.0.span.start == query_offset(source, "keep[Us...")
        assert edge.1.span.start == query_offset(source, if variadic {
                "keep[Ts..."
            } else {
                "echo[T]"
            })
        index = index + 1
    }
}

import std.list.transfer.take_last

test fn method_conformances_include_uninstantiated_universally_checked_impl_headers() {
    let source = """
        concept Keep {
            fn keep[Us...](self Self, values Us...) (Us...)
        }
        impl[Ts...] Keep for (Ts...) {
            fn keep[Vs...](self Self, values Vs...) (Vs...) {
                values
            }
        }
        """
    let edges = match method_conformances(published(input(source))) {
        Result.Ok(value) => value
        Result.Err(_) => {
            assert false
            new[(Location, Location)]()
        }
    }
    assert length(edges) == 1
    assert get(edges, 0).0.span.start == query_offset(source, "keep[Vs...")
    assert get(edges, 0).1.span.start == query_offset(source, "keep[Us...")
}

test fn word_family_headers_keep_source_member_roles_after_schema_normalization() {
    let source = """
        concept Source {
            type Item
        }
        concept Family {
            type Item[T Source]
        }
        record Item[As..., Bs...] {
            left (As...)
            right (Bs...)
        }
        concept Pass {
            type Wrap[T Source]
            type Out
            fn pass(self Self, value Self.Out) Self.Out
        }
        impl[Ts...] Pass for (Ts...) {
            type Wrap[T] = Item[(T.Item,)..., (dyn Family[Item[V] = (T.Item, V.Item)],)...]
            type Out = dyn Family[Item[U] = (Ts..., Self.Wrap[U])]
            fn pass(self Self, value Self.Out) Self.Out {
                discard self
                value
            }
        }
        """
    let analysis = accepted(input(source))
    let record_start = query_offset(source, "Item[As...")
    only_definition(inspection(analysis, source, "Item[(T.Item"), record_start, record_start + 4)
    let family = query_offset(source, "Item[T Source]")
    only_definition(inspection(analysis, source, "Item[U] ="), family, family + 4)
    let edges = match method_conformances(published(input(source))) {
        Result.Ok(value) => value
        Result.Err(_) => {
            assert false
            new[(Location, Location)]()
        }
    }
    assert length(edges) == 1
    assert get(edges, 0).0.span.start == query_offset(source, "pass(self Self, value Self.Out) Self.Out {")
    assert get(edges, 0).1.span.start == query_offset(source, "pass(self Self, value Self.Out) Self.Out\n")
}
