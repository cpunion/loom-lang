// Results own a detached project/AST snapshot. Treat all result lists as read-only;
// IDs belong to this analysis, not to later analyses or persistent declarations.
pub record Analysis {
    source Project
    bindings std.loom.binding.Program
    program std.loom.typed.Program
    inputs List[BuildInput]
    options List[BuildOption]
    targets List[BuildOption]
}
pub record Expression {
    function Int
    expression Expr
}

// Uses the compiler's binding, typing and proof checks, without a CLI or backend.
pub fn analyze(project Project, tests Bool) Result[Analysis, Failure] {
    analyze_with_inputs(project, tests, build_inputs(no_input_reader))
}
pub fn analyze_with_inputs(project Project, tests Bool, inputs BuildInputs) Result[Analysis, Failure] {
    let source = snapshot(project)
    let detached = build_inputs(inputs.read, new[BuildOption](), inputs.read_target, inputs.target_context)
    var option = 0
    while option < length(inputs.options) {
        push(detached.options, get(inputs.options, option))
        option = option + 1
    }
    let files = detached.files
    var target = 0
    while target < length(inputs.targets) {
        push(detached.targets, get(inputs.targets, target))
        target = target + 1
    }
    var index = 0
    while index < length(inputs.files) {
        let input = get(inputs.files, index)
        push(files, BuildInput {
                request = input.request
                file = std.loom.project.input_snapshot(input.file)
            })
        index = index + 1
    }
    let bindings = bind(expand_project(source, tests, detached)?, tests)?
    let program = check_with_inputs(bindings, detached)?
    Result.Ok(Analysis {
            source = source
            bindings = bindings
            program = program
            inputs = files
            options = detached.options
            targets = detached.targets
        })
}

// This checks the supplied project, not the filesystem. Reload first to detect
// disk edits. Module origins and resolved edges are part of the basis, as are
// in-memory AST edits even when the source text is unchanged.
pub fn is_current(analysis Analysis, project Project, tests Bool) Bool {
    is_current_with_inputs(analysis, project, tests, new[BuildInput]())
}
pub fn is_current_with_inputs(analysis Analysis, project Project, tests Bool, inputs List[BuildInput]) Bool {
    is_current_with_inputs(analysis, project, tests, inputs, new[BuildOption]())
}

pub fn is_current_with_inputs(analysis Analysis, project Project, tests Bool, inputs List[BuildInput], options List[BuildOption]) Bool {
    is_current_with_inputs(analysis, project, tests, inputs, options, new[BuildOption]())
}

pub fn is_current_with_inputs(analysis Analysis, project Project, tests Bool, inputs List[BuildInput], options List[BuildOption], targets List[BuildOption]) Bool {
    if !same_build_options(analysis.options, options) || !same_build_options(analysis.targets, targets) {
        return false
    }
    if length(analysis.inputs) != length(inputs) { return false }
    var input = 0
    while input < length(inputs) {
        let left = get(analysis.inputs, input)
        let right = get(inputs, input)
        if !same_request(left.request, right.request) || !std.loom.project.same_input(left.file, right.file) { return false }
        input = input + 1
    }
    let saved = analysis.source
    if saved.root != project.root || analysis.bindings.tests != tests ||
        length(saved.modules) != length(project.modules) ||
        length(saved.packages) != length(project.packages) ||
        length(saved.files) != length(project.files) { return false }
    var index = 0
    while index < length(saved.modules) {
        let left = get(saved.modules, index)
        let right = get(project.modules, index)
        if left.name != right.name || left.source != right.source { return false }
        index = index + 1
    }
    index = 0
    while index < length(saved.packages) {
        let left = get(saved.packages, index)
        let right = get(project.packages, index)
        if left.instance != right.instance || left.relative != right.relative ||
            length(left.imports) != length(right.imports) { return false }
        var edge = 0
        while edge < length(left.imports) {
            let left_edge = get(left.imports, edge)
            let right_edge = get(right.imports, edge)
            if left_edge.spelling != right_edge.spelling || left_edge.target != right_edge.target { return false }
            edge = edge + 1
        }
        index = index + 1
    }
    index = 0
    while index < length(saved.files) {
        let left = get(saved.files, index)
        let right = get(project.files, index)
        if left.package != right.package || left.path != right.path || left.text != right.text ||
            left.test_only != right.test_only || left.trusted_std != right.trusted_std ||
            !same(left.tree, right.tree) { return false }
        index = index + 1
    }
    true
}

// Type IDs must come from this analysis.
pub fn type_name(analysis Analysis, ty Int) Text {
    std.loom.checking.type_name(analysis.bindings, analysis.program.types, analysis.program.interfaces, ty)
}

fn covering(value Expr, offset Int, found List[Expr]) {
    if offset < value.span.start || offset >= value.span.end { return }
    var index = 0
    while index < length(value.children) {
        covering(get(value.children, index), offset, found)
        index = index + 1
    }
    index = 0
    while index < length(value.arms) {
        let arm = get(value.arms, index)
        var child = 0
        while child < length(arm.body) {
            covering(get(arm.body, child), offset, found)
            child = child + 1
        }
        index = index + 1
    }
    if length(found) == 0 { push(found, value) } else {
        let previous = get(found, 0)
        if value.span.end - value.span.start <= previous.span.end - previous.span.start {
            set(found, 0, value)
        }
    }
}

// One smallest covering expression per reachable concrete function instance;
// Equal spans prefer the outer resolved expression (for selections/coercions).
// Offsets are half-open UTF-8 byte offsets.
// Call.index addresses program.functions, not declaration-binding candidates.
// Local/Let/Assign.index addresses that function's locals (including inferred ty).
// Uninstantiated templates and signature-only positions have no typed result.
pub fn expressions_at(analysis Analysis, file Int, offset Int) List[Expression] {
    let matches = new[Expression]()
    var index = 0
    while index < length(analysis.program.functions) {
        let function = get(analysis.program.functions, index)
        if get(analysis.bindings.symbols, function.symbol).file == file {
            let found = new[Expr]()
            covering(function.body, offset, found)
            var clause = 0
            while clause < length(function.preconditions) {
                covering(get(function.preconditions, clause), offset, found)
                clause = clause + 1
            }
            clause = 0
            while clause < length(function.postconditions) {
                covering(get(function.postconditions, clause), offset, found)
                clause = clause + 1
            }
            if length(found) > 0 {
                push(matches, Expression { function = index expression = get(found, 0) })
            }
        }
        index = index + 1
    }
    matches
}
