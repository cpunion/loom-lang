import std.loom.parser.parse
import std.loom.source.Span
import std.loom.ast.NodeKind
import std.loom.typed.ExprKind
import std.list.new
import std.list.get
import std.list.set
import std.list.push
import std.list.length
import std.text.length
import std.text.slice
import std.text.concat
import std.result.Result

fn input(text Text) Project {
    let tree = match parse(text) {
        Result.Ok(tree) => tree
        Result.Err(_) => { assert false
            get(input("").files, 0).tree }
    }
    let files = new[SourceFile]()
    push(files, SourceFile { package = 0 path = "main.loom" text = text tree = tree
        test_only = false trusted_std = false })
    let modules = new[ModuleInstance]()
    push(modules, ModuleInstance { name = "app" source = "/app" })
    let packages = new[Package]()
    push(packages, Package { instance = 0 relative = "" imports = new[PackageImport]() })
    Project { files = files modules = modules packages = packages root = 0 }
}
fn accepted(project Project) Analysis {
    match analyze(project, false) {
        Result.Ok(analysis) => analysis
        Result.Err(_) => { assert false
            accepted(project) }
    }
}
fn offset(text Text, fragment Text) Int {
    var index = 0
    while index + length(fragment) <= length(text) {
        if slice(text, index, index + length(fragment)) == fragment { return index }
        index = index + 1
    }
    assert false
    -1
}

test fn inferred_local_types_and_qualified_generic_names() {
    let text = "record Box[T] { value T }\nfn main() {\nlet count = 3\nassert count == 3\nlet boxed = Box { value = count }\nassert boxed.value == 3\ndiscard boxed\n}"
    let project = input(text)
    let analysis = accepted(project)
    assert is_current(analysis, project, false)
    let local = get(expressions_at(analysis, 0, offset(text, "count ==")), 0)
    assert local.expression.kind == ExprKind.Local
    assert type_name(analysis, local.expression.ty) == "Int"
    let function = get(analysis.program.functions, local.function)
    assert get(function.locals, local.expression.index).name == "count"
    assert get(function.locals, local.expression.index).ty == local.expression.ty
    let boxed = get(expressions_at(analysis, 0, offset(text, "discard boxed") + 8), 0)
    assert type_name(analysis, boxed.expression.ty) == "app.Box[Int]"
    let field = get(expressions_at(analysis, 0, offset(text, "boxed.value")), 0)
    assert field.expression.kind == ExprKind.Field
    assert type_name(analysis, field.expression.ty) == "Int"
    assert length(expressions_at(analysis, 0, offset(text, "fn main"))) == 0
    assert length(expressions_at(analysis, 0, length(text))) == 0
}

test fn dynamic_binding_names_preserve_phantom_identity_and_snapshot_basis() {
    let text = "concept Marker { type Item\ntype Tag }\nimpl Marker for Int { type Item = Int\ntype Tag = Bool }\nfn main() { let value dyn Marker[Tag = Bool, Item = Int] = 1\ndiscard value }"
    let project = input(text)
    let analysis = accepted(project)
    let value = get(expressions_at(analysis, 0, offset(text, "discard value") + 8), 0).expression
    assert type_name(analysis, value.ty) == "dyn app.Marker[Item = Int, Tag = Bool]"
    let main = get(get(project.files, 0).tree.children, 2)
    let body = get(main.children, length(main.children) - 1)
    let annotation = get(get(body.children, 0).children, 0)
    let binding = get(annotation.children, 0)
    let original = get(binding.children, 0)
    set(binding.children, 0, Node { kind = original.kind value = "Text" span = original.span children = original.children })
    assert !is_current(analysis, project, false)
    assert type_name(analysis, value.ty) == "dyn app.Marker[Item = Int, Tag = Bool]"
}

test fn associated_family_names_include_arguments_after_the_receiver() {
    let analysis = accepted(input("concept Family { type Plain\ntype Item[T, U] }\nfn keep[F Family](value F.Item[Int, Bool]) F.Item[Int, Bool] { value }\nfn plain[F Family](value F.Plain) F.Plain { value }"))
    var family = false
    var plain = false
    var index = 0
    while index < length(analysis.program.types) {
        let ty = get(analysis.program.types, index)
        if ty.kind == TypeKind.Associated {
            if length(ty.arguments) == 3 {
                assert type_name(analysis, index) == "T0.app.Family.Item[Int, Bool]"
                family = true
            }
            if length(ty.arguments) == 1 {
                assert type_name(analysis, index) == "T0.app.Family.Plain"
                plain = true
            }
        }
        index = index + 1
    }
    assert family && plain
}

test fn snapshots_detect_metadata_text_and_nested_ast_edits() {
    let project = input("fn main() { let count = 3\nassert count == 3 }")
    let analysis = accepted(project)
    assert !is_current(analysis, project, true)
    assert !is_current(analysis, Project { files = project.files modules = project.modules
        packages = project.packages root = 1 }, false)
    let file = get(project.files, 0)
    let declaration = get(file.tree.children, 0)
    let body = get(declaration.children, length(declaration.children) - 1)
    let statement = get(body.children, 0)
    set(body.children, 0, Node { kind = statement.kind value = "changed"
        span = statement.span children = statement.children })
    assert !is_current(analysis, project, false)
    let saved = get(get(analysis.bindings.files, 0).tree.children, 0)
    let saved_body = get(saved.children, length(saved.children) - 1)
    assert get(saved_body.children, 0).value == "count"
    set(body.children, 0, Node { kind = statement.kind value = statement.value
        span = Span { start = statement.span.start end = statement.span.end + 1 } children = statement.children })
    assert !is_current(analysis, project, false)
    set(body.children, 0, statement)
    assert is_current(analysis, project, false)
    set(project.files, 0, SourceFile { package = file.package path = "moved.loom" text = file.text
        tree = file.tree test_only = file.test_only trusted_std = file.trusted_std })
    assert !is_current(analysis, project, false)
    set(project.files, 0, SourceFile { package = file.package path = file.path text = concat(file.text, "\n")
        tree = file.tree test_only = file.test_only trusted_std = file.trusted_std })
    assert !is_current(analysis, project, false)
    assert get(analysis.bindings.files, 0).text == file.text
    set(project.files, 0, file)
    assert is_current(analysis, project, false)
    push(project.files, file)
    assert !is_current(analysis, project, false)
    assert length(analysis.bindings.files) == 1
}

test fn snapshots_track_module_origins_packages_and_import_edges() {
    let project = input("import helper.number\nfn main() { assert number() == 3 }")
    push(project.modules, ModuleInstance { name = "helper" source = "/helper" })
    push(project.packages, Package { instance = 1 relative = "" imports = new[PackageImport]() })
    let imports = get(project.packages, 0).imports
    push(imports, PackageImport { spelling = "helper" target = 1 })
    let text = "pub fn number() Int { 3 }"
    let tree = match parse(text) {
        Result.Ok(tree) => tree
        Result.Err(_) => { assert false
            get(project.files, 0).tree }
    }
    push(project.files, SourceFile { package = 1 path = "/helper/main.loom" text = text tree = tree
        test_only = false trusted_std = false })
    let analysis = accepted(project)
    assert is_current(analysis, project, false)

    let module = get(project.modules, 1)
    set(project.modules, 1, ModuleInstance { name = module.name source = "/other-helper" })
    assert !is_current(analysis, project, false)
    assert get(analysis.bindings.modules, 1).source == "/helper"
    set(project.modules, 1, ModuleInstance { name = "renamed" source = module.source })
    assert !is_current(analysis, project, false)
    set(project.modules, 1, module)
    assert is_current(analysis, project, false)

    let package = get(project.packages, 1)
    set(project.packages, 1, Package { instance = 0 relative = package.relative imports = package.imports })
    assert !is_current(analysis, project, false)
    set(project.packages, 1, Package { instance = package.instance relative = "nested" imports = package.imports })
    assert !is_current(analysis, project, false)
    assert get(analysis.bindings.packages, 1).relative == ""
    set(project.packages, 1, package)
    assert is_current(analysis, project, false)

    let edge = get(imports, 0)
    set(imports, 0, PackageImport { spelling = edge.spelling target = 0 })
    assert !is_current(analysis, project, false)
    assert get(get(analysis.bindings.packages, 0).imports, 0).target == 1
    set(imports, 0, PackageImport { spelling = "other" target = edge.target })
    assert !is_current(analysis, project, false)
    set(imports, 0, edge)
    assert is_current(analysis, project, false)
    push(imports, edge)
    assert !is_current(analysis, project, false)
    assert length(get(analysis.bindings.packages, 0).imports) == 1
}

test fn calls_resolve_overloads_and_each_concrete_generic_instance() {
    let text = "fn identity[T](x T) T { x }\nfn unused[T](x T) T { x }\nfn pick(x Int) Int { x }\nfn pick(x Bool) Bool { x }\nfn main() {\nassert pick(2) == 2\nassert pick(true)\nassert identity(2) == 2\nassert identity(true)\n}"
    let analysis = accepted(input(text))
    let int_call = get(expressions_at(analysis, 0, offset(text, "pick(2)")), 0).expression
    let bool_call = get(expressions_at(analysis, 0, offset(text, "pick(true)")), 0).expression
    assert int_call.kind == ExprKind.Call && bool_call.kind == ExprKind.Call
    let int_target = get(analysis.program.functions, int_call.index)
    let bool_target = get(analysis.program.functions, bool_call.index)
    assert int_target.symbol != bool_target.symbol
    assert type_name(analysis, int_target.result) == "Int"
    assert type_name(analysis, bool_target.result) == "Bool"
    let generic = get(expressions_at(analysis, 0, offset(text, "identity(true)")), 0).expression
    assert generic.kind == ExprKind.Call
    let target = get(analysis.program.functions, generic.index)
    assert type_name(analysis, get(target.arguments, 0)) == "Bool"
    let instances = expressions_at(analysis, 0, offset(text, "{ x }") + 2)
    assert length(instances) == 2
    let first = get(instances, 0)
    let second = get(instances, 1)
    assert first.function != second.function
    assert first.expression.kind == ExprKind.Local && second.expression.kind == ExprKind.Local
    assert type_name(analysis, first.expression.ty) == "Int"
    assert type_name(analysis, second.expression.ty) == "Bool"
    assert length(expressions_at(analysis, 0, offset(text, "fn unused") + 22)) == 0
}

test fn semantic_failures_keep_source_diagnostics() {
    match analyze(input("fn main() { assert 1 }"), false) {
        Result.Err(failure) => { assert failure.source == 0
            assert failure.diagnostic.span.start == 19 }
        Result.Ok(_) => { assert false }
    }
}

test fn method_calls_resolve_to_owned_implementation_symbols() {
    let text = "concept C { fn value(self Self) Int }\nrecord Item { number Int }\nimpl C for Item { fn value(self Item) Int { self.number } }\nfn main() { let item = Item { number = 7 }\nassert item.value() == 7 }"
    let analysis = accepted(input(text))
    let call = get(expressions_at(analysis, 0, offset(text, "item.value()") + 5), 0).expression
    assert call.kind == ExprKind.Call && type_name(analysis, call.ty) == "Int"
    let target = get(analysis.program.functions, call.index)
    let method = get(analysis.bindings.symbols, target.symbol)
    assert method.name == "value" && method.owner >= 0
    let implementation = get(analysis.bindings.symbols, method.owner)
    assert implementation.node.kind == NodeKind.Impl
    assert get(implementation.node.children, 1).value == "Item"
}

test fn structural_tuple_types_and_projections() {
    let text = "fn pair[T](value T) (T, (Bool,)) { (value, (true,)) }\nfn main() { let values = pair(3)\nassert values.0 == 3\nassert values.1.0\ndiscard values }"
    let analysis = accepted(input(text))
    let tuple = get(expressions_at(analysis, 0, offset(text, "discard values") + 8), 0).expression
    assert type_name(analysis, tuple.ty) == "(Int, (Bool,))"
    let field = get(expressions_at(analysis, 0, offset(text, "values.0") + 7), 0).expression
    assert field.kind == ExprKind.Field
    assert type_name(analysis, field.ty) == "Int"
}

test fn float_type_queries_preserve_overload_and_container_information() {
    let text = "record Box[T] { value T }\nfn pick(value Int) Int { value }\nfn pick(value Float) Float { value }\nfn main() { let boxed = Box { value = pick(1.5) }\nlet pair = (boxed.value, true)\ndiscard boxed\ndiscard pair }"
    let analysis = accepted(input(text))
    let literal = get(expressions_at(analysis, 0, offset(text, "1.5")), 0).expression
    assert literal.kind == ExprKind.Float
    assert type_name(analysis, literal.ty) == "Float"
    let call = get(expressions_at(analysis, 0, offset(text, "pick(1.5)")), 0).expression
    assert type_name(analysis, get(analysis.program.functions, call.index).result) == "Float"
    let boxed = get(expressions_at(analysis, 0, offset(text, "discard boxed") + 8), 0).expression
    assert type_name(analysis, boxed.ty) == "app.Box[Float]"
    let pair = get(expressions_at(analysis, 0, offset(text, "discard pair") + 8), 0).expression
    assert type_name(analysis, pair.ty) == "(Float, Bool)"
}
