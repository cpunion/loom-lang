import std.loom.source.TextEdit
import std.loom.project.name
import std.text.byte
import std.text.join

// Keep the original member when siblings still use it. Extra imports follow
// the entire original line, retaining its comment and line ending.
pub fn import_edits(text Text, node Node, names List[Text]) Result[List[TextEdit], Text] {
    let edits = new[TextEdit]()
    if length(names) == 0 {
        return Result.Ok(edits)
    }
    let member = std.loom.project.name(node.value)
    var selected = get(names, 0)
    var index = 0
    while index < length(names) {
        if get(names, index) == member {
            selected = member
        }
        index = index + 1
    }
    if selected != member {
        let tokens = match lex(slice(text, node.span.start, node.span.end)) {
            Result.Ok(value) => value
            Result.Err(problem) => {
                return Result.Err(problem.message)
            }
        }
        index = length(tokens) - 1
        while index >= 0 && get(tokens, index).kind != Kind.Name {
            index = index - 1
        }
        if index < 0 {
            return Result.Err("public import has no member token")
        }
        let token = get(tokens, index)
        push(edits, TextEdit {
                span = Span {
                    start = node.span.start + token.span.start
                    end = node.span.start + token.span.end
                }
                text = selected
            })
    }
    if length(names) == 1 {
        return Result.Ok(edits)
    }
    var end = node.span.end
    while end < length(text) && byte(text, end) != 10 {
        end = end + 1
    }
    if end < length(text) {
        end = end + 1
    }
    let newline = if end >= 2 && byte(text, end - 2) == 13 {
        "\r\n"
    } else {
        "\n"
    }
    let lines = new[Text]()
    if end > 0 && byte(text, end - 1) != 10 {
        push(lines, newline)
    }
    let prefix = slice(node.value, 0, length(node.value) - length(member))
    index = 0
    while index < length(names) {
        let name = get(names, index)
        if name != selected {
            push(lines, concat("import ", concat(prefix, concat(name, newline))))
        }
        index = index + 1
    }
    push(edits, TextEdit {
            span = Span {
                start = end
                end = end
            }
            text = join(lines, "")
        })
    Result.Ok(edits)
}
