fn implementation_header_source() Text {
    """
    concept Read {
        fn read(self Self) Int
    }
    record Box[T] {
        value T
    }
    impl[T] Read for Box[T] {
        fn read(self Self) Int {
            discard self
            7
        }
    }
    """
}

test fn implementation_headers_retain_symbolic_targets_without_a_concrete_caller() {
    let source = implementation_header_source()
    let analysis = accepted(input(source))
    let functions = length(analysis.program.functions)
    let declared = query_offset(source, "Box[T] {\n")
    let found = inspection(analysis, source, "Box[T] {\n    fn")
    only_definition(found, declared, declared + 3)
    only_type(found, "app.Box[T]")
    only_definition(independent_found(analysis.bindings, source, "Box[T] {\n    fn"), declared, declared + 3)
    assert length(analysis.program.functions) == functions
}

test fn implementation_header_queries_do_not_accept_invalid_type_arguments() {
    let source = std.text.replace(implementation_header_source(), "Read for Box[T]", "Read for Box[T, T]")
    assert match inspect_independent(query_bindings(input(source)), 0, query_offset(source, "Box[T, T]")) {
        Option.None => true
        Option.Some(_) => false
    }
}

test fn declaration_type_headers_reuse_one_scope_without_publishing_body_evidence() {
    let source = """
        concept Read {
            type Item
            fn read(self Self) Int
        }
        record Box[T] {
            value T
        }
        impl[T] Read for Box[T] {
            type Item = (Box[T], Box[T])
            fn read(self Self) Int {
                discard self
                7
            }
        }
        """
    let analysis = accepted(input(source))
    only_type(cached_inspection(analysis, source, "Box[T] {\n    type"), "app.Box[T]")
    assert match get(analysis.independent_queries, 0) {
        Option.Some(saved) => saved.header && length(saved.view.functions) == 0 &&
        saved.scope.span.start == query_offset(source, "impl[T]")
        Option.None => false
    }
    let uses = ["Box[T],", "Box[T])"]
    var index = 0
    while index < length(uses) {
        only_type(cached_inspection(analysis, source, get(uses, index)), "app.Box[T]")
        assert match get(analysis.independent_queries, 0) {
            Option.Some(saved) => saved.header && length(saved.view.functions) == 0 &&
            saved.scope.span.start == query_offset(source, "type Item =")
            Option.None => false
        }
        index = index + 1
    }
    only_type(cached_inspection(analysis, source, "self\n"), "app.Box[T]")
    assert match get(analysis.independent_queries, 0) {
        Option.Some(saved) => !saved.header && saved.scope.span.start == query_offset(source, "fn read(self Self) Int {\n")
        Option.None => false
    }
    only_type(cached_inspection(analysis, source, "Box[T],"), "app.Box[T]")
    assert match get(analysis.independent_queries, 0) {
        Option.Some(saved) => saved.header && length(saved.view.functions) == 0
        Option.None => false
    }
}
