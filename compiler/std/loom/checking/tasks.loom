import std.loom.ast.Node
import std.loom.ast.NodeKind
import std.loom.ast.has
import std.loom.typed.TypeKind
import std.loom.typed.Expr
import std.loom.typed.ExprKind
import std.loom.typed.contains_tasks
import std.loom.source.Diagnostic
import std.loom.source.render
import std.list.get
import std.list.new
import std.list.push
import std.list.length
import std.result.Result

fn async_signature(env Environment, signature Signature) Bool {
    has(symbol(env, signature.symbol).node, NodeKind.Async)
}

fn call_result(env Environment, signature Signature, logical Int) Int {
    if async_signature(env, signature) {
        intern(env, TypeKind.Task, -1, ints(logical))
    } else {
        logical
    }
}

fn direct_task(env Environment, ty Int) Bool {
    ty >= 0 && get(env.types, ty).kind == TypeKind.Task
}

// A synchronous helper exposes its owner requirement through its Task-bearing inputs
// or output. No hidden effect or source ownership annotation is introduced.
fn task_owner(context Context) Bool {
    if async_signature(context.env, context.signature) || task_value(context.env, context.signature.result) {
        return true
    }
    var index = 0
    while index < length(context.signature.params) {
        if !is_static(context.signature, index) && task_value(context.env, get(context.signature.params, index)) {
            return true
        }
        index = index + 1
    }
    false
}

fn task_creation_message(context Context, node Node) Text {
    if !context.emit {
        return ""
    }
    let source = get(context.env.source.files, symbol(context.env, context.signature.symbol).file)
    render(source.path, source.text, Diagnostic {
            span = node.span
            message = "task created here"
        })
}

fn tuple_await_signature(context Context, node Node, arity Int) Result[Int, Failure] {
    var owner = -1
    var index = 0
    while index < length(context.env.packs) {
        let pack = get(context.env.packs, index)
        if pack.arity == -1 {
            let item = symbol(context.env, pack.source)
            let file = get(context.env.source.files, item.file)
            let parameters = group(item.node, NodeKind.Parameters)
            if item.name == "all" && item.owner < 0 && item.public && !item.test_only &&
                file.trusted_std && package_label(context.env.source.modules, context.env.source.packages, file.package) == "std.task" &&
                has(item.node, NodeKind.Async) && length(parameters) == 1 && tuple_pack_parameter(get(parameters, 0)) {
                if owner >= 0 { return Result.Err(error(context, node, "ambiguous trusted std.task tuple all")) }
                owner = pack.source
            }
        }
        index = index + 1
    }
    if owner < 0 { return Result.Err(error(context, node, "tuple await requires trusted std.task.all")) }
    pack_signature(context.env, owner, arity)
}

fn awaited(context Context, node Node, expected Int) Result[Expr, Failure] {
    if !async_signature(context.env, context.signature) {
        return Result.Err(error(context, node, "await requires an async function"))
    }
    discard suspension_bindings(context, node)?
    let hint = if expected >= 0 {
        intern(context.env, TypeKind.Task, -1, ints(expected))
    } else {
        -1
    }
    let operand = child(node, 0)
    var operand_hint = hint
    // Probe both contextual shapes when the result is a tuple. A call may
    // infer its type arguments only from one of these hints; neither probe
    // evaluates the operand or contributes runtime IR.
    if expected >= 0 {
        let expected_shape = get(context.env.types, expected)
        if expected_shape.kind == TypeKind.Tuple {
            let members = new[Int]()
            var index = 0
            while index < length(expected_shape.arguments) {
                push(members, intern(context.env, TypeKind.Task, -1, ints(get(expected_shape.arguments, index))))
                index = index + 1
            }
            let tuple_hint = tuple_type(context.env, context.signature.symbol, operand, members)?
            var scalar = false
            var tuple = false
            match static_probe(context, operand, hint) {
                Result.Ok(checked) => { scalar = checked.ty == hint }
                Result.Err(_) => {}
            }
            match static_probe(context, operand, tuple_hint) {
                Result.Ok(checked) => { tuple = checked.ty == tuple_hint }
                Result.Err(_) => {}
            }
            if scalar && tuple {
                return Result.Err(error(context, operand, "ambiguous await operand: both a Task and a tuple of Tasks match"))
            }
            if tuple {
                operand_hint = tuple_hint
            } else if !scalar {
                match static_probe(context, operand, -1) {
                    Result.Ok(checked) => {
                        if get(context.env.types, checked.ty).kind == TypeKind.Tuple { operand_hint = -1 }
                    }
                    Result.Err(_) => {}
                }
            }
        } else {
            match static_probe(context, operand, -1) {
                Result.Ok(checked) => {
                    if get(context.env.types, checked.ty).kind == TypeKind.Tuple { operand_hint = -1 }
                }
                Result.Err(_) => {}
            }
        }
    }
    let value = expr(context, operand, operand_hint)?
    let shape = get(context.env.types, value.ty)
    let task = if shape.kind == TypeKind.Tuple {
        var index = 0
        while index < length(shape.arguments) {
            if !direct_task(context.env, get(shape.arguments, index)) {
                return Result.Err(error(context, operand, "tuple await requires Task values"))
            }
            index = index + 1
        }
        let selected = tuple_await_signature(context, node, length(shape.arguments))?
        invoke(context, node, ints(selected), new[Node](), plain_inputs(source_nodes(operand)), expressions(value), hint)?
    } else {
        value
    }
    let task_shape = get(context.env.types, task.ty)
    if task_shape.kind != TypeKind.Task {
        return Result.Err(error(context, node, "await requires a Task value"))
    }
    if task.kind == ExprKind.Suspend {
        return Result.Ok(expression(ExprKind.Suspend, get(task_shape.arguments, 0), node, task.text, -1, task.children, task.falls))
    }
    Result.Ok(expression(ExprKind.Await, get(task_shape.arguments, 0), node, "", -1, expressions(task), task.falls))
}

fn contains_task(env Environment, ty Int, seen List[Int]) Bool {
    if ty <= 5 { return false }
    let cached = get(env.type_states, ty).task_width
    if cached >= 0 { return cached > 0 }
    std.loom.typed.contains_tasks(env.types, ty, seen)
}

fn task_transfer_type(env Environment, signature Signature, ty Int, node Node) Result[Bool, Failure] {
    if ty <= 5 {
        return Result.Ok(true)
    }
    task_transfer_visit(env, signature, ty, node, new[Int]())
}

fn task_transfer_visit(env Environment, signature Signature, ty Int, node Node, seen List[Int]) Result[Bool, Failure] {
    if ty <= 5 || resource_seen(seen, ty) {
        return Result.Ok(true)
    }
    push(seen, ty)
    var payload = ty
    while direct_task(env, payload) {
        payload = get(get(env.types, payload).arguments, 0)
    }
    let nested = contains_task(env, payload, new[Int]())
    if nested {
        let shape = get(env.types, payload)
        if shape.kind == TypeKind.List {
            discard task_transfer_visit(env, signature, get(shape.arguments, 0), node, seen)?
        }
        let fields = get(env.types, payload).fields
        var index = 0
        while index < length(fields) {
            discard task_transfer_visit(env, signature, get(fields, index).ty, node, seen)?
            index = index + 1
        }
        let variants = get(env.types, payload).variants
        index = 0
        while index < length(variants) {
            let members = get(variants, index).fields
            var field = 0
            while field < length(members) {
                discard task_transfer_visit(env, signature, get(members, field), node, seen)?
                field = field + 1
            }
            index = index + 1
        }
    }
    if payload != ty && resource_type(env, signature.symbol, signature.requirements, payload, new[Int]())? {
        return Result.Err(failure(env, signature.symbol, node, "Task results containing MustScope resources are not yet implemented"))
    }
    if payload != ty && marker_type(env, signature.symbol, signature.requirements, payload,
        resource_concept(env, "NoSuspend"), new[Int]())? {
        return Result.Err(failure(env, signature.symbol, node, "Task results cannot contain NoSuspend values"))
    }
    Result.Ok(true)
}

fn task_signature(env Environment, signature Signature, node Node) Result[Bool, Failure] {
    let asynchronous = async_signature(env, signature)
    let marker = if asynchronous {
        resource_concept(env, "NoSuspend")
    } else {
        -1
    }
    var index = 0
    while index < length(signature.params) {
        discard task_transfer_type(env, signature, get(signature.params, index), node)?
        if asynchronous && !is_static(signature, index) && resource_type(env, signature.symbol,
            signature.requirements, get(signature.params, index), new[Int]())? {
            return Result.Err(failure(env, signature.symbol, node, "async parameters cannot contain MustScope resources"))
        }
        if marker >= 0 && !is_static(signature, index) && marker_type(env, signature.symbol,
            signature.requirements, get(signature.params, index), marker, new[Int]())? {
            return Result.Err(failure(env, signature.symbol, node, "async parameters cannot contain NoSuspend values"))
        }
        index = index + 1
    }
    let output = call_result(env, signature, signature.result)
    task_transfer_type(env, signature, output, node)
}

fn task_call_context(context Context, node Node, values List[Expr], output Int, asynchronous Bool) Result[Bool, Failure] {
    if task_value(context.env, output) {
        discard task_transfer_type(context.env, context.signature, output, node)?
    }
    var transfers = asynchronous || task_value(context.env, output)
    var index = 0
    while index < length(values) {
        let value = get(values, index)
        if task_value(context.env, value.ty) {
            discard task_transfer_type(context.env, context.signature, value.ty, node)?
        }
        transfers = transfers || task_value(context.env, value.ty)
        index = index + 1
    }
    if transfers && !task_owner(context) {
        return Result.Err(error(context, node, "task creation or transfer requires an async function or a Task-bearing parameter or return type"))
    }
    Result.Ok(true)
}
