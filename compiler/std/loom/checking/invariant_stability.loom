import std.loom.proof.predicate_stable

// This is a predicate-level proof, not permission to freeze an entire child.
// Validate its actual dependency closure before supplying continuing type facts.
fn invariant_stable(env Environment, program std.loom.typed.Program, base Int, predicate Expr,
    active List[Int]) Bool {
    let pending = ints(base)
    let seen = new[Int]()
    let validated = new[Int]()
    let protected = new[std.loom.proof.InputGuarantee]()
    var cursor = 0
    while cursor < length(pending) && cursor < 256 {
        let ty = get(pending, cursor)
        cursor = cursor + 1
        if !resource_seen(seen, ty) {
            push(seen, ty)
            let shape = get(env.types, ty)
            if shape.kind == TypeKind.Refined && !resource_seen(active, ty) {
                match validate_refinement(env, ty, Option.Some(active)) {
                    Result.Ok(_) => {
                    }
                    Result.Err(_) => {
                        return false
                    }
                }
                push(validated, ty)
                if constrained_sequence(env, ty) {
                    let policy = get(env.type_states, ty).sequence
                    push(protected, std.loom.proof.InputGuarantee {
                            ty = ty
                            // Checked predicates continue after legal writes;
                            // they grant no frozen contents or fixed extent.
                            writes = if sequence_dependency(policy) {
                                sequence_writes(policy)
                            } else {
                                2
                            }
                        })
                }
            }
            if shape.kind == TypeKind.List {
                push(pending, get(shape.arguments, 0))
            }
            var field = 0
            while field < length(shape.fields) {
                push(pending, get(shape.fields, field).ty)
                field = field + 1
            }
            var variant = 0
            while variant < length(shape.variants) {
                let fields = get(shape.variants, variant).fields
                field = 0
                while field < length(fields) {
                    push(pending, get(fields, field))
                    field = field + 1
                }
                variant = variant + 1
            }
        }
    }
    if cursor < length(pending) {
        return false
    }
    let expanded = match expanded_selected_invariants(env, validated) {
        Result.Ok(types) => types
        Result.Err(_) => {
            return false
        }
    }
    let types = new[Type]()
    cursor = 0
    while cursor < length(expanded) {
        let shape = get(expanded, cursor)
        // The predicate being proved, recursive ancestors and unvalidated
        // helper-local types can never supply their own proof assumptions.
        push(types, if shape.kind == TypeKind.Refined && !resource_seen(validated, cursor) {
                Type {
                    constraint = []
                    ..shape
                }
            } else {
                shape
            })
        cursor = cursor + 1
    }
    predicate_stable(proof_types(program, types), base, predicate,
        get(env.inputs, 0).build.proof_backend, protected)
}
