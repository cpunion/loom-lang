record InvariantReads {
    env Environment
    functions List[Function]
    // Visiting recursive helpers are safe only if the complete traversal
    // succeeds. Any observed shared read rejects the whole predicate.
    states List[Int]
}

fn invariant_helper_reads(reads InvariantReads, target Int, depth Int) Bool {
    if target < 0 || target >= length(reads.functions) || depth >= 64 { return false }
    if get(reads.states, target) != 0 { return true }
    set(reads.states, target, 1)
    let function = get(reads.functions, target)
    var index = 0
    while index < length(function.preconditions) {
        if !invariant_read(reads, get(function.preconditions, index), false, depth + 1) { return false }
        index = index + 1
    }
    invariant_read(reads, function.body, false, depth + 1)
}

// Copies and projections transport shared handles without observing contents.
// Follow helpers only when their actual arguments carry shared state; helpers
// over immutable inputs may still allocate and use their own fresh containers.
fn invariant_read(reads InvariantReads, value Expr, projection Bool, depth Int) Bool {
    let env = reads.env
    let path = projection && (value.kind == ExprKind.Local || value.kind == ExprKind.Field || value.kind == ExprKind.Coerce)
    if !path && value.ty != 0 && !inline_constraint_base(env, value.ty, 0) {
        return false
    }
    var shared_call = false
    var argument = 0
    while value.kind == ExprKind.Call && argument < length(value.children) {
        shared_call = shared_call || !inline_constraint_base(env, get(value.children, argument).ty, 0)
        argument = argument + 1
    }
    if shared_call && !invariant_helper_reads(reads, value.index, depth) { return false }
    var index = 0
    while index < length(value.children) {
        let projects = value.kind == ExprKind.Field || (path && value.kind == ExprKind.Coerce) ||
            value.kind == ExprKind.Let || value.kind == ExprKind.Assign || value.kind == ExprKind.Discard || shared_call
        if !invariant_read(reads, get(value.children, index), projects, depth) {
            return false
        }
        index = index + 1
    }
    index = 0
    while index < length(value.arms) {
        let body = get(value.arms, index).body
        var member = 0
        while member < length(body) {
            if !invariant_read(reads, get(body, member), false, depth) {
                return false
            }
            member = member + 1
        }
        index = index + 1
    }
    true
}

fn invariant_observation(env Environment, program std.loom.typed.Program, value Expr) Bool {
    let states = new[Int]()
    var index = 0
    while index < length(program.functions) {
        push(states, 0)
        index = index + 1
    }
    invariant_read(InvariantReads { env = env functions = program.functions states = states }, value, false, 0)
}
