import std.loom.typed.Expr
import std.loom.typed.ExprKind
import std.loom.ast.NodeKind
import std.loom.binding.Program
import std.loom.proof.implies_facts
import std.list.new
import std.list.get
import std.list.push
import std.list.length

fn refinement_declarations(source std.loom.binding.Program) Bool {
    var index = 0
    while index < length(source.symbols) {
        if get(source.symbols, index).node.kind == NodeKind.Refined {
            return true
        }
        index = index + 1
    }
    false
}

// Only immutable scalar bindings are stable. An immutable handle does not
// make a shared container's elements stable; calls and projections stay opaque.
fn fact_size(context Context, value Expr, depth Int) Int {
    let ty = base_type(context.env, value.ty)
    if depth >= 64 || (ty != 1 && ty != 2 && ty != 5) || length(value.arms) != 0 {
        return -1
    }
    if value.kind == ExprKind.Local {
        return if get(context.locals, value.index).mutable {
            -1
        } else {
            1
        }
    }
    if value.kind == ExprKind.Integer || value.kind == ExprKind.Float || value.kind == ExprKind.Bool {
        return 1
    }
    let unary = value.kind == ExprKind.Unary || value.kind == ExprKind.Coerce
    if (!unary && value.kind != ExprKind.Binary) || length(value.children) != (if unary {
            1
        } else {
            2
        }) {
        return -1
    }
    var size = 1
    var index = 0
    while index < length(value.children) {
        let found = fact_size(context, get(value.children, index), depth + 1)
        if found < 0 || size + found > 256 {
            return -1
        }
        size = size + found
        index = index + 1
    }
    size
}

// Proof inputs, never execution. Erasure preserves representation; real
// binding IDs remain distinct even when source names are shadowed.
fn normalized_fact(context Context, value Expr) Expr {
    if value.kind == ExprKind.Coerce {
        return normalized_fact(context, get(value.children, 0))
    }
    let children = new[Expr]()
    var index = 0
    while index < length(value.children) {
        push(children, normalized_fact(context, get(value.children, index)))
        index = index + 1
    }
    Expr {
        kind = value.kind
        ty = base_type(context.env, value.ty)
        span = value.span
        text = if value.kind == ExprKind.Local {
            ""
        } else {
            value.text
        }
        index = value.index
        children = children
        arms = value.arms
        falls = value.falls
    }
}

fn rebound_fact(value Expr, source Int, local Int) Expr {
    let children = new[Expr]()
    var index = 0
    while index < length(value.children) {
        push(children, rebound_fact(get(value.children, index), source, local))
        index = index + 1
    }
    Expr {
        kind = value.kind
        ty = value.ty
        span = value.span
        text = if value.kind == ExprKind.Local {
            ""
        } else {
            value.text
        }
        index = if value.kind == ExprKind.Local && value.index == source {
            local
        } else {
            value.index
        }
        children = children
        arms = value.arms
        falls = value.falls
    }
}

fn fact_mentions(value Expr, local Int) Bool {
    if value.kind == ExprKind.Local && value.index == local {
        return true
    }
    var index = 0
    while index < length(value.children) {
        if fact_mentions(get(value.children, index), local) {
            return true
        }
        index = index + 1
    }
    false
}

fn fact_operator(value Expr, text Text, children List[Expr]) Expr {
    Expr {
        kind = if length(children) == 1 {
            ExprKind.Unary
        } else {
            ExprKind.Binary
        }
        ty = 2
        span = value.span
        text = text
        index = -1
        children = children
        arms = value.arms
        falls = true
    }
}

fn fact_context(context Context, head Int) Context {
    Context {
        lexical = context.lexical
        env = context.env
        signature = context.signature
        arguments = context.arguments
        constants = context.constants
        locals = context.locals
        bindings = context.bindings
        head = context.head
        cleanups = context.cleanups
        cleanup_head = context.cleanup_head
        loop_boundary = context.loop_boundary
        facts = context.facts
        fact_head = head
        emit = context.emit
    }
}

fn remembered_fact(context Context, value Expr, truth Bool) Context {
    if fact_size(context, value, 0) < 0 {
        return context
    }
    let normalized = normalized_fact(context, value)
    let predicate = if truth {
        normalized
    } else {
        fact_operator(normalized, "!", expressions(normalized))
    }
    let head = length(context.facts)
    push(context.facts, Fact {
            predicate = predicate
            previous = context.fact_head
        })
    fact_context(context, head)
}

fn assuming(context Context, value Expr, truth Bool, depth Int) Context {
    if !context.env.has_refinements || depth >= 64 {
        return context
    }
    let known = remembered_fact(context, value, truth)
    // Only these short-circuit outcomes establish both operands. In particular,
    // !(x > 0.0) does not mean x <= 0.0 when x is NaN.
    if value.kind == ExprKind.Unary && value.text == "!" {
        return assuming(known, get(value.children, 0), !truth, depth + 1)
    }
    if value.kind == ExprKind.Binary && ((truth && value.text == "&&") || (!truth && value.text == "||")) {
        let left = assuming(known, get(value.children, 0), truth, depth + 1)
        return assuming(left, get(value.children, 1), truth, depth + 1)
    }
    known
}

fn fallthrough_facts(context Context, value Expr) Context {
    if !context.env.has_refinements || value.kind != ExprKind.If || !value.falls {
        return context
    }
    let yes = get(value.children, 1).falls
    let no = length(value.children) == 2 || get(value.children, 2).falls
    if yes == no {
        return context
    }
    assuming(context, get(value.children, 0), yes, 0)
}

fn fact_reference(context Context, value Expr) Int {
    if value.kind == ExprKind.Coerce {
        return fact_reference(context, get(value.children, 0))
    }
    if value.kind != ExprKind.Local || get(context.locals, value.index).mutable {
        return -1
    }
    let ty = base_type(context.env, value.ty)
    if ty == 1 || ty == 5 {
        value.index
    } else {
        -1
    }
}

fn copied_scalar_facts(context Context, value Expr, local Int) Context {
    if !context.env.has_refinements || get(context.locals, local).mutable {
        return context
    }
    let ty = base_type(context.env, value.ty)
    var established = context
    if (ty == 1 || ty == 2) && fact_size(context, value, 0) > 0 {
        let target = Expr {
            kind = ExprKind.Local
            ty = ty
            span = value.span
            text = ""
            index = local
            children = new[Expr]()
            arms = value.arms
            falls = true
        }
        // Equality holds after successful evaluation. The initializer remains
        // in the executable, once, with its original fault behavior.
        established = remembered_fact(context, fact_operator(value, "==", pair(target, value)), true)
    }
    let source = fact_reference(context, value)
    if source < 0 {
        return established
    }
    // Exact copies also preserve unsupported algebra. In particular, Float
    // copies use substitution only: IEEE equality is not identity for NaN.
    var next = established.fact_head
    var head = context.fact_head
    var steps = 0
    var count = 0
    while head >= 0 && steps < 256 && count < 32 {
        let fact = get(context.facts, head)
        if fact_mentions(fact.predicate, source) {
            let added = length(context.facts)
            push(context.facts, Fact {
                    predicate = rebound_fact(fact.predicate, source, local)
                    previous = next
                })
            next = added
            count = count + 1
        }
        head = fact.previous
        steps = steps + 1
    }
    fact_context(context, next)
}

fn facts_imply(context Context, value Expr, goal Expr) Bool {
    if context.fact_head < 0 {
        return false
    }
    let local = fact_reference(context, value)
    if local < 0 {
        return false
    }
    let premises = new[Expr]()
    var head = context.fact_head
    while head >= 0 && length(premises) < 256 {
        let fact = get(context.facts, head)
        push(premises, fact.predicate)
        head = fact.previous
    }
    implies_facts(premises, rebound_fact(goal, 0, local), get(context.env.inputs, 0).build.proof_backend)
}
