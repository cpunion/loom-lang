fn pack_forward_pack(caller Node, parameter Int) Int {
    let parameters = group(caller, NodeKind.TypeParameters)
    var index = 0
    var pack = 0
    while index < length(parameters) {
        if get(parameters, index).kind == NodeKind.TypePack {
            if index == parameter {
                return pack
            }
            pack = pack + 1
        }
        index = index + 1
    }
    -1
}

fn pack_forward_element(caller Node, schema Node) Int {
    let parameter = pack_schema_parameter(schema)
    if parameter >= 0 {
        return pack_forward_pack(caller, parameter)
    }
    var index = 0
    while index < length(schema.children) {
        let found = pack_forward_element(caller, child(schema, index))
        if found >= 0 {
            return found
        }
        index = index + 1
    }
    -1
}

fn pack_forward_extent(context Context, caller Node, sequence List[Node], site Node) Result[Node, Failure] {
    var extent = pack_node(site, NodeKind.Integer, "0", new[Node]())
    var index = 0
    while index < length(sequence) {
        let item = get(sequence, index)
        var count = pack_node(site, NodeKind.Integer, "1", new[Node]())
        if item.kind == NodeKind.Spread {
            let pack = pack_forward_element(caller, item)
            if pack < 0 {
                return Result.Err(error(context, site, "forwarded expansion needs an established source width"))
            }
            count = pack_node(site, NodeKind.Name, pack_proof_width(pack), new[Node]())
        }
        extent = pack_node(site, NodeKind.Binary, "+", [extent, count])
        index = index + 1
    }
    Result.Ok(extent)
}

fn pack_forward_source_node(context Context, caller Node, node Node, depth Int) Result[Node, Failure] {
    if depth >= 64 {
        return Result.Err(error(context, node, "forwarded type pattern nesting limit exceeded"))
    }
    // Explicit brackets parse expression syntax; annotations parse type syntax.
    // Use the same structural types for both, as ordinary type resolution does.
    if node.kind == NodeKind.Apply {
        return pack_forward_source_node(context, caller,
            pack_node(node, NodeKind.Type, child(node, 0).value, child(node, 1).children), depth + 1)
    }
    let kind = if node.kind == NodeKind.Name {
        NodeKind.Type
    } else {
        if node.kind == NodeKind.Tuple {
            NodeKind.TupleType
        } else {
            node.kind
        }
    }
    let root = slice(node.value, 0, first_dot(node.value))
    let packs = declared_packs(caller)
    var pack = false
    var index = 0
    while index < length(packs) {
        pack = pack || root == get(packs, index).value
        index = index + 1
    }
    let parameters = type_parameters(context.env, context.signature.symbol)
    var fixed = root == "Self"
    index = 0
    while index < length(parameters) {
        fixed = fixed || root == get(parameters, index).value
        index = index + 1
    }
    if kind == NodeKind.Type && fixed && !pack {
        return Result.Ok(meta_reference(node, resolve_bound(context.env, context.signature.symbol,
                    node, context.arguments, context.signature.requirements, 0)?))
    }
    let children = new[Node]()
    index = 0
    while index < length(node.children) {
        push(children, pack_forward_source_node(context, caller, child(node, index), depth + 1)?)
        index = index + 1
    }
    Result.Ok(pack_node(node, kind, node.value, children))
}

fn pack_forward_source_schema(context Context, caller Node, node Node) Result[Node, Failure] {
    type_pattern_schema(context.env, pack_proof_caller(context),
        pack_forward_source_node(context, caller, node, 0)?, true, 0, true)
}

// Recover the source node in this same snapshot, validating the complete schema
// as well as its span. Generated nodes may share spans, but not binding identity.
fn pack_forward_raw(context Context, node Node, schema Node, depth Int) Option[Node] {
    if depth >= 64 {
        return Option.None
    }
    if node.span.start == schema.span.start && node.span.end == schema.span.end {
        match pack_forward_source_schema(context, symbol(context.env, pack_proof_caller(context)).node, node) {
            Result.Ok(checked) => {
                if pack_schema_equal(checked, schema) {
                    return Option.Some(node)
                }
            }
            Result.Err(_) => {
            }
        }
    }
    var index = 0
    while index < length(node.children) {
        match pack_forward_raw(context, child(node, index), schema, depth + 1) {
            Option.Some(found) => {
                return Option.Some(found)
            }
            Option.None => {
            }
        }
        index = index + 1
    }
    Option.None
}

fn pack_forward_fixed_node(context Context, caller Node, node Node, depth Int) Result[Node, Failure] {
    if depth >= 64 || node.kind == NodeKind.Spread {
        return Result.Err(error(context, node, "forwarded fixed type needs an established layout"))
    }
    let packs = declared_packs(caller)
    var index = 0
    while index < length(packs) {
        if node.value == get(packs, index).value && length(node.children) == 0 {
            return Result.Ok(pack_node(node, NodeKind.Type, pack_proof_element_type(index), new[Node]()))
        }
        index = index + 1
    }
    let children = new[Node]()
    index = 0
    while index < length(node.children) {
        push(children, pack_forward_fixed_node(context, caller, child(node, index), depth + 1)?)
        index = index + 1
    }
    Result.Ok(pack_node(node, node.kind, node.value, children))
}

// Normalize selected type values as in an ordinary call, then match its type
// word jointly with input shapes. No symbolic word is expanded or sampled.
fn pack_forward_explicit(context Context, node Node, caller Node, target Int, work List[PackForwardShape]) Result[Node, Failure] {
    if length(child(node, 0).children) == 0 {
        return Result.Ok(child(node, 0))
    }
    let types = pack_forward_source_node(context, caller, meta_type_node(context, child(node, 0))?, 0)?
    let callee = symbol(context.env, target).node
    let parameters = group(callee, NodeKind.TypeParameters)
    let patterns = new[Node]()
    var index = 0
    while index < length(parameters) {
        let parameter = get(parameters, index)
        let pattern = pack_node(parameter, NodeKind.Type, parameter.value, new[Node]())
        push(patterns, if parameter.kind == NodeKind.TypePack {
                pack_node(parameter, NodeKind.Spread, "", source_nodes(pattern))
            } else {
                pattern
            })
        index = index + 1
    }
    push(work, PackForwardShape {
            pattern = type_pattern_schema(context.env, target,
                pack_node(callee, NodeKind.TupleType, "", patterns), false, 0, true)?
            actual = pack_forward_source_schema(context, caller,
                pack_node(types, NodeKind.TupleType, "", types.children))?
            element = false
        })
    Result.Ok(types)
}

// Recover a checked type identity, not a constructor decoded in another scope.
// One generic traversal covers tuples, functions and nominal type arguments.
fn pack_forward_checked_type(env Environment, ty Int, schema Node, seen List[Int], depth Int) Option[Int] {
    if depth >= 64 || length(seen) >= 512 || resource_seen(seen, ty) {
        return Option.None
    }
    push(seen, ty)
    if pack_schema_equal(impl_type_schema(env, ty, schema, true), schema) {
        return Option.Some(ty)
    }
    let arguments = get(env.types, ty).arguments
    var index = 0
    while index < length(arguments) {
        match pack_forward_checked_type(env, get(arguments, index), schema, seen, depth + 1) {
            Option.Some(found) => {
                return Option.Some(found)
            }
            Option.None => {
            }
        }
        index = index + 1
    }
    Option.None
}

fn pack_forward_operand_type(context Context, caller Node, node Node, schema Node, depth Int) Option[Int] {
    if depth >= 64 || pack_forwarded_parameter(caller, node) >= 0 {
        return Option.None
    }
    if node.span.start == schema.span.start && node.span.end == schema.span.end {
        match static_probe(context, node, -1) {
            Result.Ok(value) => {
                match pack_forward_checked_type(context.env, value.ty, schema, new[Int](), 0) {
                    Option.Some(found) => {
                        return Option.Some(found)
                    }
                    Option.None => {
                    }
                }
            }
            Result.Err(_) => {
            }
        }
    }
    if node.kind == NodeKind.Arguments || node.kind == NodeKind.Tuple {
        var index = 0
        while index < length(node.children) {
            match pack_forward_operand_type(context, caller, child(node, index), schema, depth + 1) {
                Option.Some(found) => {
                    return Option.Some(found)
                }
                Option.None => {
                }
            }
            index = index + 1
        }
    }
    Option.None
}

fn pack_forward_type(context Context, caller Node, schema Node, types Node, inputs Node) Result[Int, Failure] {
    let raw = match pack_forward_raw(context, child(caller, part(caller, NodeKind.Parameters)), schema, 0) {
        Option.Some(node) => Option.Some(node)
        Option.None => pack_forward_raw(context, types, schema, 0)
    }
    let node = match raw {
        Option.Some(node) => pack_forward_fixed_node(context, caller, node, 0)?
        Option.None => {
            match pack_forward_operand_type(context, caller, inputs, schema, 0) {
                Option.Some(ty) => meta_reference(schema, ty)
                Option.None => {
                    return Result.Err(error(context, schema, "forwarded fixed type needs an established source binding"))
                }
            }
        }
    }
    // Resolve as a header, not through same-spelled mutable body bindings.
    let ty = resolve_bound(context.env, context.signature.symbol, node, context.arguments, context.signature.requirements, 0)?
    discard well_formed(context.env, context.signature.symbol, ty, context.signature.requirements, node, 0)?
    Result.Ok(ty)
}

fn pack_forward_effects(context Context, caller Node, operand Node, position Int, effects List[InputEffect], depth Int) Result[Bool, Failure] {
    if depth >= 64 {
        return Result.Err(error(context, operand, "forwarded argument nesting limit exceeded"))
    }
    if pack_forwarded_parameter(caller, operand) >= 0 {
        return Result.Ok(true)
    }
    if operand.kind == NodeKind.Tuple && pack_forwarded_input(caller, operand, 0) {
        var index = 0
        while index < length(operand.children) {
            discard pack_forward_effects(context, caller, child(operand, index), position, effects, depth + 1)?
            index = index + 1
        }
    } else {
        let value = expr(context, operand, -1)?
        discard resource_binding(context, operand, value)?
        push(effects, InputEffect {
                position = position
                value = value
            })
    }
    Result.Ok(true)
}

fn pack_forward_invoke(context Context, node Node, caller Node, callee Node, bindings PackForwardMatch,
    signature Int, fixed List[Int], expected Int) Result[Expr, Failure] {
    let parameters = group(callee, NodeKind.TypeParameters)
    let selected = get(context.env.signatures, signature)
    let arguments = supplied_call(context, node, new[Node](), selected)?
    var ordinary = 0
    var index = 0
    while index < length(parameters) {
        if get(parameters, index).kind != NodeKind.TypePack {
            if get(bindings.known, index) {
                set(arguments, ordinary, pack_forward_type(context, caller, get(get(bindings.values, index), 0), child(node, 0), child(node, 1))?)
            }
            ordinary = ordinary + 1
        }
        index = index + 1
    }
    let source = child(node, 1).children
    let values = new[Node]()
    let checked = new[Expr]()
    let effects = new[InputEffect]()
    var position = 0
    index = 0
    while index < length(source) {
        let operand = get(source, index)
        if position < length(fixed) && get(fixed, position) == index {
            let value = expr(context, operand, hint(context, get(selected.params, position), arguments, node)?)?
            push(values, operand)
            push(checked, value)
            discard infer(context.env, get(selected.params, position), value.ty, arguments)
            position = position + 1
        } else {
            // Erasing a heterogeneous argument must not erase its evaluation.
            // Check original source order before attaching effects at each gap.
            discard pack_forward_effects(context, caller, operand, position, effects, 0)?
        }
        index = index + 1
    }
    var pack = 0
    index = 0
    while index < length(parameters) {
        let parameter = get(parameters, index)
        if parameter.kind == NodeKind.TypePack {
            if !get(bindings.known, index) {
                return Result.Err(error(context, node, "variadic forwarding cannot infer an unbound pack"))
            }
            let sequence = get(bindings.values, index)
            var element = -1
            var member = 0
            while member < length(sequence) && element < 0 {
                element = pack_forward_element(caller, get(sequence, member))
                member = member + 1
            }
            if length(parameter.children) != 0 {
                if length(sequence) != 1 || get(sequence, 0).kind != NodeKind.Spread ||
                pack_schema_parameter(child(get(sequence, 0), 0)) < 0 || element < 0 {
                    return Result.Err(error(context, node, "bounded forwarding needs one source pack with declared element requirements"))
                }
            }
            // Unconstrained summaries cannot observe element types/identity.
            // An existing abstract domain also represents an empty sequence.
            if element < 0 {
                element = 0
            }
            let value = pack_node(node, NodeKind.Name, pack_proof_element_value(element), new[Node]())
            push(values, value)
            push(values, pack_forward_extent(context, caller, sequence, node)?)
            set(arguments, ordinary + pack, context_type(context,
                    pack_node(node, NodeKind.Type, pack_proof_element_type(element), new[Node]()))?)
            pack = pack + 1
        }
        index = index + 1
    }
    let inputs = CallInputs {
        nodes = values
        ready = Option.None
        effects = Option.Some(effects)
    }
    index = 0
    while index < length(values) {
        let value = if index < length(fixed) {
            input_effects(context, inputs, index, get(values, index), get(checked, index))
        } else {
            input_value(context, inputs, index, hint(context, get(selected.params, index), arguments, node)?, false)?
        }
        if index < length(fixed) {
            set(checked, index, value)
        } else {
            push(checked, value)
        }
        discard infer(context.env, get(selected.params, index), value.ty, arguments)
        index = index + 1
    }
    if !complete(arguments) && expected >= 0 {
        discard infer(context.env, call_result(context.env, selected, selected.result), expected, arguments)
    }
    if !complete(arguments) {
        return Result.Err(error(context, node, "variadic forwarding cannot infer its fixed type arguments"))
    }
    let types = new[Node]()
    index = 0
    while index < length(arguments) {
        push(types, meta_reference(node, get(arguments, index)))
        index = index + 1
    }
    // Prefix expressions already contain their gap effects; do not apply twice.
    invoke(context, node, ints(signature), types, plain_inputs(values), checked, expected)
}
