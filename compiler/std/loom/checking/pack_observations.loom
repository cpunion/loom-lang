import std.text.split

fn pack_observation_patterns(context Context, parameter Int) List[Node] {
    let declaration = symbol(context.env, pack_proof_caller(context)).node
    let input = get(group(declaration, NodeKind.Parameters), parameter)
    let ty = child(input, 0)
    let patterns = if ty.kind == NodeKind.TupleType {
        ty.children
    } else {
        source_nodes(ty)
    }
    let output = new[Node]()
    var index = 0
    while index < length(patterns) {
        let item = get(patterns, index)
        let pattern = if item.kind == NodeKind.Spread {
            child(item, 0)
        } else {
            item
        }
        push(output, pattern)
        index = index + 1
    }
    output
}

fn pack_observation_type(context Context, pattern Node, node Node) Result[Int, Failure] {
    let caller = symbol(context.env, pack_proof_caller(context)).node
    let fixed = pack_forward_fixed_node(context, caller, pattern, 0)?
    let actual = resolve_bound(context.env, context.signature.symbol, fixed,
        context.arguments, context.signature.requirements, 0)?
    discard well_formed(context.env, context.signature.symbol, actual,
        context.signature.requirements, node, 0)?
    Result.Ok(actual)
}

fn pack_pattern_admitted(context Context, pattern Node, capability Int, node Node) Result[Bool, Failure] {
    let caller = symbol(context.env, pack_proof_caller(context)).node
    match pack_forward_source_schema(context, caller, pattern) {
        Result.Ok(schema) => {
            if !pack_layout_well_formed(context, caller, schema, ints(512), 0)? {
                return Result.Ok(false)
            }
            if pack_layout_admitted(context, caller, schema, capability, new[PackLayoutRequirement](), ints(512), 0)? {
                return Result.Ok(true)
            }
        }
        Result.Err(_) => {
        }
    }
    satisfies(context, pack_observation_type(context, pattern, node)?, capability)
}

// An element-dependent layout is not one fixed private type. Derive each
// visible capability from the complete schema, then select its methods on the
// independent entry. No layout, type equality or raw-element bound escapes.
fn pack_symbolic_options(context Context, node Node, source Node, receiver Expr,
    pattern Node, member Text, types List[Node], inputs CallInputs, expected Int) Result[List[Int], Failure] {
    let caller = symbol(context.env, pack_proof_caller(context)).node
    let schema = pack_forward_source_schema(context, caller, pattern)?
    if !pack_layout_well_formed(context, caller, schema, ints(512), 0)? {
        return Result.Err(error(context, pattern, "variadic element pattern needs well-formed data arguments for every member"))
    }
    let options = new[Int]()
    var index = 0
    while index < length(context.env.concepts) {
        let capability = get(context.env.concepts, index).symbol
        if visible_concept(context, capability) &&
        pack_layout_admitted(context, caller, schema, capability, new[PackLayoutRequirement](), ints(512), 0)? {
            let scope = with_evidence(context, receiver.ty, capability)
            let choices = method_options(scope, node, source, receiver, member, types, inputs, capability, expected)?
            var choice = 0
            while choice < length(choices) {
                let id = get(choices, choice)
                if !resource_seen(options, id) {
                    push(options, id)
                }
                choice = choice + 1
            }
        }
        index = index + 1
    }
    Result.Ok(options)
}

// Resolve capabilities on the full element pattern, but invoke their declared
// summaries on an independent opaque entry value. Neither a concrete member
// nor the constructor's implementation body represents the heterogeneous word.
fn pack_proof_method(context Context, node Node, source Node, receiver Expr, encoded Text,
    types List[Node], inputs CallInputs, expected Int) Result[Expr, Failure] {
    let owner = pack_proof_caller(context)
    if owner < 0 {
        return Result.Err(error(context, node, "variadic observations are private to checked family proofs"))
    }
    let parts = std.text.split(slice(encoded, length("$packobserve#"), length(encoded)), "#")
    let parameter = match std.int.parse(get(parts, 0)) {
        Result.Ok(value) => value
        Result.Err(_) => {
            return Result.Err(error(context, node, "invalid variadic observation parameter"))
        }
    }
    let member = get(parts, 1)
    var scope = pack_layout_evidence(context, symbol(context.env, owner).node)?
    let patterns = pack_observation_patterns(scope, parameter)
    let options = new[Int]()
    var common = new[Int]()
    var field = 0
    while field < length(patterns) {
        // A shape participates only in selection, never as a proof value.
        let pattern = get(patterns, field)
        let choices = match pack_observation_type(scope, pattern, node) {
            Result.Ok(ty) => {
                let shape = expression(ExprKind.Deferred, ty, node, "", -1, new[Expr](), true)
                method_options(scope, node, source, shape, member, types, inputs, -1, expected)?
            }
            Result.Err(failed) => {
                if !has_type_expansion(pattern) ||
                length(expansion_packs(pattern, pack_names(declared_packs(symbol(context.env, owner).node)))) == 0 {
                    return Result.Err(failed)
                }
                pack_symbolic_options(scope, node, source, receiver, pattern, member, types, inputs, expected)?
            }
        }
        if length(choices) == 0 {
            return Result.Err(error(context, node,
                    "variadic element observation needs an accessible concept and conformance for every element pattern"))
        }
        var choice = 0
        while choice < length(choices) {
            let id = get(choices, choice)
            if !resource_seen(options, id) {
                push(options, id)
            }
            choice = choice + 1
        }
        if field == 0 {
            common = choices
        } else {
            let shared = new[Int]()
            choice = 0
            while choice < length(common) {
                let id = get(common, choice)
                if resource_seen(choices, id) {
                    push(shared, id)
                }
                choice = choice + 1
            }
            common = shared
        }
        field = field + 1
    }
    var index = 0
    while index < length(options) {
        let method = get(context.env.signatures, get(options, index)).symbol
        discard pack_proof_method_contract(context.env, owner, symbol(context.env, method).node, node)?
        scope = with_evidence(scope, receiver.ty, symbol(context.env, method).owner)
        index = index + 1
    }
    // Keep alternatives when resolving overloads: intersection alone could
    // hide an ambiguity present on just one of the actual element patterns.
    invoke_shared(scope, node, options, types, input_receiver(inputs, source), expressions(receiver), expected, common)
}
