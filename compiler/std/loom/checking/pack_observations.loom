import std.text.split

// Resolve every member pattern in header scope. This list carries capability
// evidence, not representative values or a common concrete element layout.
fn pack_observation_types(context Context, parameter Int, node Node) Result[List[Int], Failure] {
    let declaration = symbol(context.env, pack_proof_caller(context)).node
    let input = get(group(declaration, NodeKind.Parameters), parameter)
    let ty = child(input, 0)
    let patterns = if ty.kind == NodeKind.TupleType {
        ty.children
    } else {
        source_nodes(ty)
    }
    let types = new[Int]()
    var index = 0
    while index < length(patterns) {
        let item = get(patterns, index)
        let pattern = if item.kind == NodeKind.Spread {
            child(item, 0)
        } else {
            item
        }
        let fixed = pack_forward_fixed_node(context, declaration, pattern, 0)?
        let actual = resolve_bound(context.env, context.signature.symbol, fixed,
            context.arguments, context.signature.requirements, 0)?
        discard well_formed(context.env, context.signature.symbol, actual,
            context.signature.requirements, node, 0)?
        push(types, actual)
        index = index + 1
    }
    Result.Ok(types)
}

// Resolve capabilities on the full element pattern, but invoke their declared
// summaries on an independent opaque entry value. Neither a concrete member
// nor the constructor's implementation body represents the heterogeneous word.
fn pack_proof_method(context Context, node Node, source Node, receiver Expr, encoded Text,
    types List[Node], inputs CallInputs, expected Int) Result[Expr, Failure] {
    let owner = pack_proof_caller(context)
    if owner < 0 {
        return Result.Err(error(context, node, "variadic observations are private to checked family proofs"))
    }
    let parts = std.text.split(slice(encoded, length("$packobserve#"), length(encoded)), "#")
    let parameter = match std.int.parse(get(parts, 0)) {
        Result.Ok(value) => value
        Result.Err(_) => {
            return Result.Err(error(context, node, "invalid variadic observation parameter"))
        }
    }
    let member = get(parts, 1)
    let patterns = pack_observation_types(context, parameter, node)?
    let options = new[Int]()
    var common = new[Int]()
    var field = 0
    while field < length(patterns) {
        // A shape participates only in selection, never as a proof value.
        let shape = expression(ExprKind.Deferred, get(patterns, field), node, "", -1, new[Expr](), true)
        let choices = method_options(context, node, source, shape, member, types, inputs, -1, expected)?
        if length(choices) == 0 {
            return Result.Err(error(context, node,
                    "variadic element observation needs an accessible concept and conformance for every element pattern"))
        }
        var choice = 0
        while choice < length(choices) {
            let id = get(choices, choice)
            if !resource_seen(options, id) {
                push(options, id)
            }
            choice = choice + 1
        }
        if field == 0 {
            common = choices
        } else {
            let shared = new[Int]()
            choice = 0
            while choice < length(common) {
                let id = get(common, choice)
                if resource_seen(choices, id) {
                    push(shared, id)
                }
                choice = choice + 1
            }
            common = shared
        }
        field = field + 1
    }
    var scope = context
    var index = 0
    while index < length(options) {
        let method = get(context.env.signatures, get(options, index)).symbol
        discard pack_proof_method_contract(context.env, owner, symbol(context.env, method).node, node)?
        scope = with_evidence(scope, receiver.ty, symbol(context.env, method).owner)
        index = index + 1
    }
    // Keep alternatives when resolving overloads: intersection alone could
    // hide an ambiguity present on just one of the actual element patterns.
    invoke_shared(scope, node, options, types, input_receiver(inputs, source), expressions(receiver), expected, common)
}
