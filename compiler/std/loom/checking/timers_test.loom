fn timer_files(declarations Text, caller Text) List[TestFile] {
    let files = source_files(caller)
    push(files, source_file("std.clock_fixture", declarations, true))
    files
}

fn rejects_timer(declarations Text, caller Text) {
    match checked(timer_files(declarations, caller)) {
        Result.Err(_) => {
        }
        Result.Ok(_) => {
            assert false
        }
    }
}

test fn private_async_intrinsics_produce_typed_suspension_not_blocking_calls() {
    let declarations = "intrinsic fn clock_monotonic_ns() Int\nasync intrinsic fn timer_until_ns(deadline Int)\npub fn now() Int { clock_monotonic_ns() }\npub async fn pause(deadline Int) { timer_until_ns(deadline).await }"
    let caller = "import std.clock_fixture.pause\nimport std.clock_fixture.now\nasync fn main() { pause(0).await\ndiscard now() }"
    match checked(timer_files(declarations, caller)) {
        Result.Ok(program) => {
            var timer = false
            var clock = false
            var index = 0
            while index < length(program.functions) {
                let function = get(program.functions, index)
                if function.runtime_name == "timer_until_ns" {
                    let operation = get(function.body.children, 0)
                    assert function.is_async && function.result == 0
                    assert operation.kind == ExprKind.Suspend && operation.ty == 0
                    assert operation.text == "timer_until_ns" && length(operation.children) == 1
                    assert get(operation.children, 0).ty == 1
                    timer = true
                }
                if function.runtime_name == "clock_monotonic_ns" {
                    assert !function.is_async && function.result == 1
                    assert get(function.body.children, 0).kind == ExprKind.Intrinsic
                    clock = true
                }
                index = index + 1
            }
            assert timer && clock
        }
        Result.Err(_) => {
            assert false
        }
    }
    rejects_timer(declarations, "import std.clock_fixture.now\nfn main() { discard comptime { now() } }")
    rejects_timer(declarations, "import std.clock_fixture.pause\nasync fn main() { comptime { pause(0).await } }")
}

test fn intrinsic_effect_and_type_metadata_cannot_be_changed_by_a_declaration() {
    rejects_timer("intrinsic fn timer_until_ns(deadline Int)\n", "")
    rejects_timer("async intrinsic fn clock_monotonic_ns() Int\n", "")
    rejects_timer("async intrinsic fn text_len(value Text) Int\n", "")
    rejects_timer("async intrinsic fn timer_until_ns(deadline Bool)\n", "")
    rejects_timer("async intrinsic fn timer_until_ns(deadline Int) Int\n", "")
    rejects_timer("intrinsic fn clock_monotonic_ns() Bool\n", "")
    rejects("async intrinsic fn timer_until_ns(deadline Int)\n")
}
