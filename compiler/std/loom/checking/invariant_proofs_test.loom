test fn required_contracts_use_immutable_input_invariants() {
    discard accepted("""
type Positive = Int where self > 0

record Pair {
    lower Int
    upper Int
}

type Ordered = Pair where self.upper > self.lower && self.lower >= 0

record Holder {
    amount Positive
    pair Ordered
    shared List[Int]
}

pub fn scalar(other Int, value Positive) Int
ensures result > 0
{
    value
}

pub fn record_value(value Ordered) Int
ensures result > 0
{
    value.upper
}

pub fn nested(value Holder) Int
ensures result > 0
{
    value.amount
}

pub fn nested_record(value Holder) Int
ensures result > 0
{
    value.pair.upper
}

pub fn tuple_value(value (Int, Positive)) Int
ensures result > 0
{
    value.1
}

fn consume(value Positive) Int
ensures result > 0
{
    value
}

pub fn forwarded(value Positive) Int
ensures result > 0
{
    consume(value)
}

fn selected(value Int) Bool {
    value != 13
}

type Selection = Int where self > 0 && selected(self)

pub fn supported_conjunct(value Selection) Int
ensures result > 0
{
    value
}
""")
}

test fn invariant_facts_preserve_identity_and_disjunctions() {
    rejects("""
type Positive = Int where self > 0

fn wrong(value Positive, other Int) Int
ensures result > 0
{
    other
}
""")
    rejects("""
type Positive = Int where self > 0

fn modified(value Positive) Int
ensures result > 0
{
    var current Int = value
    current = -1
    current
}
""")
    rejects("""
type Nonzero = Int where self > 0 || self < 0

fn either(value Nonzero) Int
ensures result > 0
{
    value
}
""")
    rejects("""
type Positive = Int where self > 0

fn unsafe(value Positive) Int
ensures result + 1 > result
{
    value
}
""")
    // Recursive helpers remain outside bounded symbolic expansion.
    rejects("""
fn positive(value Int) Bool {
    if value > 1 {
        return positive(value - 1)
    }
    value == 1
}

type Positive = Int where positive(self)

fn unsupported(value Positive) Int
ensures result > 0
{
    value
}
""")
}

test fn invariant_helpers_supply_value_and_evaluation_facts() {
    discard accepted("""
fn positive(value Int) Bool {
    value > 0
}

type Positive = Int where positive(self)

record Pair {
    lower Int
    upper Int
}

fn ordered(value Pair) Bool {
    value.upper > value.lower && value.lower >= 0
}

type Ordered = Pair where ordered(self)

record Holder {
    scalar Positive
    interval Ordered
    shared List[Int]
}

pub fn scalar(other Int, value Positive) Int
ensures result > 0
{
    value
}

pub fn aggregate(value Holder) Int
ensures result > 0
{
    value.interval.upper
}

pub fn tuple_value(value (Int, Positive)) Int
ensures result > 0
{
    value.1
}

fn identity(value Int) Int
ensures result == value
{
    value
}

pub fn forwarded(value Positive) Int
ensures result > 0
{
    identity(value)
}

fn checked(value Int) Bool
requires value > 0
{
    true
}

type Checked = Int where checked(self)

pub fn checked_precondition(value Checked) Int
ensures result > 0
{
    value
}

fn selected(value Int, ignored Int) Bool {
    value > 0
}

type Room = Int where selected(self, self + 1)

pub fn eager_argument(value Room) Int
ensures result + 1 > result
{
    value
}
""")
}

test fn invariant_helper_facts_cannot_escape_their_value_or_guard() {
    rejects("""
fn positive(value Int) Bool {
    value > 0
}

type Positive = Int where positive(self)

fn wrong(value Positive, other Int) Int
ensures result > 0
{
    other
}
""")
    rejects("""
fn positive(value Int) Bool {
    value > 0
}

type Positive = Int where positive(self)

fn overflow(value Positive) Int
ensures result + 1 > result
{
    value
}
""")
    rejects("""
fn positive(value Int) Bool {
    value > 0
}

type Choice = Int where self == 9223372036854775807 || positive(self + 1)

fn skipped_argument(value Choice) Int
ensures result + 1 > result
{
    value
}
""")
    rejects("""
fn checked(value Int) Bool
requires value > 0
{
    true
}

type Choice = Int where self == 0 || checked(self)

fn skipped_precondition(value Choice) Int
ensures result > 0
{
    value
}
""")
}
