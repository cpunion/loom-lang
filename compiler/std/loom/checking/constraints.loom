import std.loom.ast.Node
import std.loom.ast.NodeKind
import std.loom.typed.Expr
import std.loom.typed.ExprKind
import std.loom.typed.Local
import std.loom.typed.TypeKind
import std.loom.typed.Arm
import std.list.new
import std.list.get
import std.list.push
import std.list.set
import std.list.length
import std.text.concat
import std.float.to_text
import std.result.Result
import std.loom.eval.Value
import std.loom.eval.scalar
import std.loom.eval.unknown
import std.loom.eval.validate
import std.loom.eval.evaluate

fn predicate_form(node Node) Bool {
    if node.kind == NodeKind.Integer || node.kind == NodeKind.Float || node.kind == NodeKind.Bool || node.kind == NodeKind.Text { return true }
    if node.kind == NodeKind.Name { return node.value == "self" }
    if node.kind == NodeKind.Call {
        let arguments = child(node, 1).children
        var index = 0
        while index < length(arguments) {
            if !predicate_form(get(arguments, index)) { return false }
            index = index + 1
        }
        return true
    }
    if node.kind != NodeKind.Unary && node.kind != NodeKind.Binary { return false }
    var index = 0
    while index < length(node.children) {
        if !predicate_form(child(node, index)) { return false }
        index = index + 1
    }
    true
}
fn predicate_node(env Environment, owner Int) Node {
    let declaration = symbol(env, owner).node
    child(declaration, type_part(declaration) + 1)
}
fn predicate_context(env Environment, owner Int, locals List[Local], self_local Int, emit Bool) Context {
    let bindings = new[Binding]()
    push(bindings, Binding { local = self_local previous = -1 })
    Context { env = env signature = Signature { symbol = owner parameters = 0 params = ints(get(locals, self_local).ty) result = 2 requirements = new[Requirement]() }
        arguments = new[Int]() locals = locals bindings = bindings head = 0 emit = emit }
}
fn predicate_scope(env Environment, owner Int, base Int) Context {
    let locals = new[Local]()
    push(locals, Local { name = "self" ty = base mutable = false })
    predicate_context(env, owner, locals, 0, false)
}
fn refinement(env Environment, owner Int, base Int) Result[Expr, Failure] {
    let predicate = predicate_node(env, owner)
    if !predicate_form(predicate) { return Result.Err(failure(env, owner, predicate, "constraints require expressions over self and pure function calls")) }
    let context = predicate_scope(env, owner, base)
    let stage = staging(context, predicate)?
    let value = expr(stage, predicate, 2)?
    match std.loom.eval.validate(prepared(stage)?, value) {
        Result.Ok(_) => {}
        Result.Err(failed) => { return Result.Err(failure(env, owner, predicate, concat("type constraint: ", failed.message))) }
    }
    // The stored template has no executable call indices. Each construction
    // binds the source again into its own staging/runtime queue and self slot.
    expr(context, predicate, 2)
}
fn refinements(env Environment) Result[Bool, Failure] {
    var index = 0
    while index < length(env.types) {
        let ty = get(env.types, index)
        if ty.kind == TypeKind.Refined {
            let predicate = refinement(env, ty.symbol, get(ty.fields, 0).ty)?
            set(env.types, index, Type { kind = ty.kind symbol = ty.symbol arguments = ty.arguments
                fields = ty.fields variants = ty.variants constraint = expressions(predicate) })
        }
        index = index + 1
    }
    Result.Ok(true)
}
// Optional folding and explicit comptime execution share checked arithmetic.
// Unknown values retain their normal runtime construction boundary.
fn folded(value Expr, self_value Value) Value {
    match scalar(value, self_value) {
        Result.Ok(value) => value
        Result.Err(_) => unknown()
    }
}
fn folded_predicate(env Environment, owner Int, known Value) Result[Value, Failure] {
    let predicate = predicate_node(env, owner)
    let stage = staging(predicate_scope(env, owner, known.ty), predicate)?
    let value = expr(stage, predicate, 2)?
    let literal = if known.ty == 5 {
        expression(ExprKind.Float, 5, predicate, std.float.to_text(known.floating), -1, new[Expr](), true)
    } else { expression(ExprKind.Integer, 1, predicate, std.int.to_text(known.number), -1, new[Expr](), true) }
    let bind = expression(ExprKind.Let, 0, predicate, "", 0, expressions(literal), true)
    let initialized = expression(ExprKind.Block, 2, predicate, "", -1, pair(bind, value), true)
    match std.loom.eval.evaluate(prepared(stage)?, initialized, length(stage.locals)) {
        Result.Ok(value) => Result.Ok(value)
        Result.Err(_) => Result.Ok(unknown())
    }
}
fn predicate_at(value Expr, node Node) Expr {
    let children = new[Expr]()
    var index = 0
    while index < length(value.children) {
        push(children, predicate_at(get(value.children, index), node))
        index = index + 1
    }
    let arms = new[Arm]()
    index = 0
    while index < length(value.arms) {
        let arm = get(value.arms, index)
        let body = new[Expr]()
        var item = 0
        while item < length(arm.body) {
            push(body, predicate_at(get(arm.body, item), node))
            item = item + 1
        }
        push(arms, Arm { variant = arm.variant bindings = arm.bindings whole = arm.whole body = body })
        index = index + 1
    }
    Expr { kind = value.kind ty = value.ty span = node.span text = value.text index = value.index
        children = children arms = arms falls = value.falls }
}
fn constraint_error(context Context, node Node) Result[Int, Failure] {
    var declaration = -1
    var index = 0
    while index < length(context.env.source.symbols) {
        let item = symbol(context.env, index)
        let file = get(context.env.source.files, item.file)
        if file.package == "std.result" && file.trusted_std && item.public && !item.test_only && item.name == "ConstraintError" { declaration = index }
        index = index + 1
    }
    if declaration < 0 { return Result.Err(error(context, node, "checked construction requires std.result.ConstraintError")) }
    let ty = data_type(context.env, declaration, new[Int](), 0)?
    let shape = get(context.env.types, ty)
    if shape.kind != TypeKind.Enum || length(shape.variants) != 1 { return Result.Err(error(context, node, "ConstraintError must contain Rejected only")) }
    let variant = get(shape.variants, 0)
    if variant.name != "Rejected" || length(variant.fields) != 0 { return Result.Err(error(context, node, "ConstraintError must contain an empty Rejected variant")) }
    Result.Ok(ty)
}
fn constrained(context Context, node Node, declaration Int, types List[Node], inputs List[Node]) Result[Expr, Failure] {
    if length(types) != 0 || length(inputs) != 1 { return Result.Err(error(context, node, "a constrained constructor takes one value and no type arguments")) }
    let target = data_type(context.env, declaration, new[Int](), 0)?
    let base = base_type(context.env, target)
    let input = expr(context, get(inputs, 0), -1)?
    if input.ty == target { return Result.Ok(input) }
    let value = typed(context, node, input, base)?
    let known = folded(value, unknown())
    if known.ty == base {
        let checked = folded_predicate(context.env, declaration, known)?
        if checked.ty == 2 {
            if checked.number == 0 { return Result.Err(error(context, node, "this constant does not satisfy the type constraint")) }
            return Result.Ok(expression(ExprKind.Coerce, target, node, "", -1, expressions(value), value.falls))
        }
    }
    let shape = result_shape(context, node)?
    let error_type = constraint_error(context, node)?
    let output = result_type(context, node, shape, target, error_type)?
    let local = length(context.locals)
    push(context.locals, Local { name = "self" ty = base mutable = false })
    let saved = expression(ExprKind.Let, 0, node, "", local, expressions(value), value.falls)
    let reference = atom(ExprKind.Local, base, node, local)
    let refined = expression(ExprKind.Coerce, target, node, "", -1, expressions(reference), true)
    let accepted = expression(ExprKind.Variant, output, node, "", shape.ok, expressions(refined), true)
    let reason = expression(ExprKind.Variant, error_type, node, "", 0, new[Expr](), true)
    let rejected = expression(ExprKind.Variant, output, node, "", shape.err, expressions(reason), true)
    if context.env.stage_depth >= 32 {
        return Result.Err(error(context, node, "type constraint expansion depth exceeded; check for a dependency cycle"))
    }
    // Guard expansion shares this function queue, unlike compile-time staging.
    let env = Environment { source = context.env.source types = context.env.types signatures = context.env.signatures
        pending = context.env.pending stage_depth = context.env.stage_depth + 1 computations = context.env.computations
        concepts = context.env.concepts implementations = context.env.implementations interfaces = context.env.interfaces
        witnesses = context.env.witnesses uses = context.env.uses }
    let predicate = expr(predicate_context(env, declaration, context.locals, local, context.emit),
        predicate_node(context.env, declaration), 2)?
    let branches = expressions(predicate_at(predicate, node))
    push(branches, expression(ExprKind.Block, output, node, "", -1, expressions(accepted), true))
    push(branches, expression(ExprKind.Block, output, node, "", -1, expressions(rejected), true))
    let condition = expression(ExprKind.If, output, node, "", -1, branches, true)
    Result.Ok(expression(ExprKind.Block, output, node, "", -1, pair(saved, condition), value.falls))
}
