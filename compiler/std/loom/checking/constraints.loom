import std.loom.ast.Node
import std.loom.ast.NodeKind
import std.loom.typed.Expr
import std.loom.typed.ExprKind
import std.loom.typed.Function
import std.loom.typed.Local
import std.loom.typed.TypeKind
import std.loom.typed.Arm
import std.list.new
import std.list.get
import std.list.push
import std.list.set
import std.list.length
import std.text.concat
import std.text.starts_with
import std.float.to_text
import std.result.Result
import std.loom.eval.Value
import std.loom.eval.scalar
import std.loom.eval.unknown
import std.loom.eval.validate
import std.loom.eval.evaluate
import std.loom.proof.implies
import std.loom.proof.verify_with_types
import std.loom.proof.preserves_list_append

fn predicate_form(node Node, calls Bool) Bool {
    if node.kind == NodeKind.Integer || node.kind == NodeKind.Float || node.kind == NodeKind.Bool || node.kind == NodeKind.Text {
        return true
    }
    // Closed function references are valid arguments to pure predicate helpers.
    // Binding still exposes no runtime local other than self; purity and input
    // observation validate their reachable call targets after typing.
    if node.kind == NodeKind.Name {
        return calls || node.value == "self" || starts_with(node.value, "self.")
    }
    if node.kind == NodeKind.Select {
        return predicate_form(child(node, 0), calls)
    }
    if node.kind == NodeKind.Call || node.kind == NodeKind.MacroCall {
        if !calls {
            return false
        }
        let arguments = child(node, if node.kind == NodeKind.Call {
                1
            } else {
                0
            }).children
        var index = 0
        while index < length(arguments) {
            if !predicate_form(get(arguments, index), calls) {
                return false
            }
            index = index + 1
        }
        return true
    }
    if node.kind != NodeKind.Unary && node.kind != NodeKind.Binary {
        return false
    }
    var index = 0
    while index < length(node.children) {
        if !predicate_form(child(node, index), calls) {
            return false
        }
        index = index + 1
    }
    true
}

fn predicate_node(env Environment, owner Int) Node {
    let declaration = symbol(env, owner).node
    child(declaration, type_part(declaration) + 1)
}

fn predicate_context(env Environment, ty Int, locals List[Local], self_local Int, emit Bool) Result[Context, Failure] {
    let shape = get(env.types, ty)
    let owner = shape.symbol
    let obligations = requirements(env, owner, shape.arguments)?
    let bindings = new[Binding]()
    push(bindings, Binding {
            name = "self"
            local = self_local
            constant = -1
            previous = -1
        })
    Result.Ok(Context {
            lexical = new_lexical()
            env = env
            signature = Signature {
                symbol = owner
                parameters = length(shape.arguments)
                params = ints(base_type(env, ty))
                compile_time = new[Int]()
                result = 2
                requirements = obligations
            }
            arguments = shape.arguments
            constants = new[StaticValue]()
            locals = locals
            bindings = bindings
            head = 0
            cleanups = new[Cleanup]()
            cleanup_head = -1
            loop_boundary = -2
            facts = new[Fact]()
            fact_head = -1
            emit = emit
        })
}

fn predicate_scope(env Environment, ty Int) Result[Context, Failure] {
    let locals = new[Local]()
    push(locals, Local {
            name = "self"
            ty = base_type(env, ty)
            mutable = false
            is_scoped = false
        })
    predicate_context(env, ty, locals, 0, false)
}

fn refinement_expression(scope Context, ty Int) Result[Expr, Failure] {
    let state = get(scope.env.type_states, ty)
    // Phase 3 is a checked predicate in progress, not an incomplete layout.
    // A constructor cannot use the same invariant to establish itself. Restore
    // the ordinary state on both success and failure; no visiting state escapes.
    set(scope.env.type_states, ty, TypeState {
            phase = 3
            task_width = state.task_width
            list_writes = state.list_writes
        })
    let checked = expr(scope, predicate_node(scope.env, get(scope.env.types, ty).symbol), 2)
    set(scope.env.type_states, ty, state)
    checked
}

fn refinement(env Environment, ty Int) Result[Expr, Failure] {
    let owner = get(env.types, ty).symbol
    let predicate = predicate_node(env, owner)
    if !predicate_form(predicate, true) {
        return Result.Err(failure(env, owner, predicate, "constraints require expressions over self and pure function calls"))
    }
    // Templates are fully typed, but hold no executable call indices.
    refinement_expression(predicate_scope(env, ty)?, ty)
}

fn validate_refinement(env Environment, ty Int) Result[Int, Failure] {
    let owner = get(env.types, ty).symbol
    let base = base_type(env, ty)
    let predicate = predicate_node(env, owner)
    let stage = staging(predicate_scope(env, ty)?, predicate)?
    let value = refinement_expression(stage, ty)?
    if must_scope(stage, base)? || task_value(env, base) ||
    marker_type(env, owner, stage.signature.requirements, base, resource_concept(env, "NoSuspend"), new[Int]())? {
        return Result.Err(failure(env, owner, predicate, "refinements cannot contain scoped resources or one-shot Tasks"))
    }
    // This is analysis, not CTFE or runtime emission. Retain actual abstract
    // helper bodies; unresolved concept summaries remain Deferred and impure.
    let program = prepared_in(stage, !concrete(env, ty))?
    discard list_constraint_expression(env, program.functions, owner, value)?
    var writes = 0
    if !inline_constraint_base(env, base, 0) {
        let list = get(env.types, base).kind == TypeKind.List
        let reads = invariant_observation(env, program, value, length(stage.locals), list)
        if !get(reads.valid, 0) {
            return Result.Err(failure(env, owner, predicate, "type constraints may observe immutable fields, not shared mutable contents"))
        }
        if list && !get(reads.element_reads, 0) {
            writes = if std.loom.proof.preserves_list_append(program, value, get(env.inputs, 0).build.proof_backend) {
                2
            } else {
                1
            }
        }
    }
    match std.loom.eval.validate(program, value) {
        Result.Ok(_) => {
        }
        Result.Err(failed) => {
            return Result.Err(failure(env, owner, predicate, concat("type constraint: ", failed.message)))
        }
    }
    Result.Ok(writes)
}

fn initialize_refinement(env Environment, ty Int) Result[Bool, Failure] {
    let shape = get(env.types, ty)
    let predicate = refinement(env, ty)?
    set(env.types, ty, Type {
            kind = shape.kind
            symbol = shape.symbol
            arguments = shape.arguments
            fields = shape.fields
            variants = shape.variants
            constraint = expressions(predicate)
        })
    let writes = validate_refinement(env, ty)?
    let state = get(env.type_states, ty)
    set(env.type_states, ty, TypeState {
            phase = state.phase
            task_width = state.task_width
            list_writes = writes
        })
    Result.Ok(true)
}

fn refinements(env Environment) Result[Bool, Failure] {
    // Make every proof-eligible template available before typing predicates
    // with constructors/calls, then validate closures only after all templates.
    // This makes inferred construction types independent of declaration order.
    var pass = 0
    while pass < 2 {
        var index = 0
        while index < length(env.types) {
            let ty = get(env.types, index)
            if ty.kind == TypeKind.Refined && predicate_form(predicate_node(env, ty.symbol), false) == (pass == 0) {
                let predicate = refinement(env, index)?
                set(env.types, index, Type {
                        kind = ty.kind
                        symbol = ty.symbol
                        arguments = ty.arguments
                        fields = ty.fields
                        variants = ty.variants
                        constraint = expressions(predicate)
                    })
            }
            index = index + 1
        }
        pass = pass + 1
    }
    var index = 0
    while index < length(env.types) {
        let ty = get(env.types, index)
        if ty.kind == TypeKind.Refined {
            let writes = validate_refinement(env, index)?
            let state = get(env.type_states, index)
            set(env.type_states, index, TypeState {
                    phase = state.phase
                    task_width = state.task_width
                    list_writes = writes
                })
        }
        index = index + 1
    }
    Result.Ok(true)
}

// Optional folding and explicit comptime execution share checked arithmetic.
// Unknown values retain their normal runtime construction boundary.
fn folded(value Expr, self_value Value) Value {
    match scalar(value, self_value) {
        Result.Ok(value) => value
        Result.Err(_) => unknown()
    }
}

fn folded_predicate(env Environment, ty Int, known Value) Result[Value, Failure] {
    let owner = get(env.types, ty).symbol
    let predicate = predicate_node(env, owner)
    let stage = staging(predicate_scope(env, ty)?, predicate)?
    let value = refinement_expression(stage, ty)?
    let literal = if known.ty == 3 {
        expression(ExprKind.Text, 3, predicate, known.text, -1, new[Expr](), true)
    } else {
        if known.ty == 5 {
            expression(ExprKind.Float, 5, predicate, std.float.to_text(known.floating), -1, new[Expr](), true)
        } else {
            expression(ExprKind.Integer, 1, predicate, std.int.to_text(known.number), -1, new[Expr](), true)
        }
    }
    let bind = expression(ExprKind.Let, 0, predicate, "", 0, expressions(literal), true)
    let initialized = expression(ExprKind.Block, 2, predicate, "", -1, pair(bind, value), true)
    match evaluate_in(stage, prepared(stage)?, initialized, length(stage.locals)) {
        Result.Ok(value) => Result.Ok(value)
        Result.Err(_) => Result.Ok(unknown())
    }
}

// A closed record expression may contain Float leaves. Evaluate the checked
// construction and predicate together so their IEEE behavior is identical to
// ordinary compile-time execution. Failure to evaluate is not proof.
fn folded_record_predicate(env Environment, ty Int, value Expr) Result[Value, Failure] {
    let owner = get(env.types, ty).symbol
    let predicate = predicate_node(env, owner)
    let stage = staging(predicate_scope(env, ty)?, predicate)?
    let condition = refinement_expression(stage, ty)?
    let bind = expression(ExprKind.Let, 0, predicate, "", 0, expressions(value), value.falls)
    let initialized = expression(ExprKind.Block, 2, predicate, "", -1, pair(bind, condition), value.falls)
    match evaluate_in(stage, prepared(stage)?, initialized, length(stage.locals)) {
        Result.Ok(evaluated) => Result.Ok(evaluated)
        Result.Err(_) => Result.Ok(unknown())
    }
}

fn predicate_at(value Expr, node Node) Expr {
    let children = new[Expr]()
    var index = 0
    while index < length(value.children) {
        push(children, predicate_at(get(value.children, index), node))
        index = index + 1
    }
    let arms = new[Arm]()
    index = 0
    while index < length(value.arms) {
        let arm = get(value.arms, index)
        let body = new[Expr]()
        var item = 0
        while item < length(arm.body) {
            push(body, predicate_at(get(arm.body, item), node))
            item = item + 1
        }
        push(arms, Arm {
                variant = arm.variant
                bindings = arm.bindings
                whole = arm.whole
                body = body
            })
        index = index + 1
    }
    Expr {
        kind = value.kind
        ty = value.ty
        span = node.span
        text = value.text
        index = value.index
        children = children
        arms = arms
        falls = value.falls
    }
}

fn constraint_error(context Context, node Node) Result[Int, Failure] {
    let cached = get(context.env.inputs, 0).constraint_errors
    if length(cached) != 0 {
        return Result.Ok(get(cached, 0))
    }
    var declaration = -1
    var index = 0
    while index < length(context.env.source.symbols) {
        let item = symbol(context.env, index)
        let file = get(context.env.source.files, item.file)
        if item.name == "ConstraintError" && item.public && !item.test_only && file.trusted_std &&
        package_label(context.env.source.modules, context.env.source.packages, file.package) == "std.result" {
            declaration = index
        }
        index = index + 1
    }
    if declaration < 0 {
        return Result.Err(error(context, node, "checked construction requires std.result.ConstraintError"))
    }
    let ty = data_type(context.env, declaration, new[Int](), 0)?
    let shape = get(context.env.types, ty)
    if shape.kind != TypeKind.Enum || length(shape.variants) != 1 {
        return Result.Err(error(context, node, "ConstraintError must contain Rejected only"))
    }
    let variant = get(shape.variants, 0)
    if variant.name != "Rejected" || length(variant.fields) != 0 {
        return Result.Err(error(context, node, "ConstraintError must contain an empty Rejected variant"))
    }
    push(cached, ty)
    Result.Ok(ty)
}

// Closed immutable literals need no caller assumptions. The bounded prover or
// CTFE can establish their predicate; unresolved inputs keep the Result boundary.
fn closed_inline_value(value Expr, depth Int) Bool {
    if depth >= 64 || length(value.arms) != 0 {
        return false
    }
    if value.kind == ExprKind.Integer || value.kind == ExprKind.Bool || value.kind == ExprKind.Float || value.kind == ExprKind.Text {
        return true
    }
    let unary = value.kind == ExprKind.Unary || value.kind == ExprKind.Coerce || value.kind == ExprKind.Field
    let binary = value.kind == ExprKind.Binary
    let aggregate = value.kind == ExprKind.Record
    if !unary && !binary && !aggregate && value.kind != ExprKind.Variant {
        return false
    }
    if unary && length(value.children) != 1 {
        return false
    }
    if binary && length(value.children) != 2 {
        return false
    }
    var index = 0
    while index < length(value.children) {
        let child = get(value.children, index)
        if aggregate && (child.kind != ExprKind.Field || child.index < 0) {
            return false
        }
        if !closed_inline_value(child, depth + 1) {
            return false
        }
        index = index + 1
    }
    true
}

fn proven_record(context Context, node Node, base Int, value Expr, predicate Expr) Bool {
    if get(context.env.types, base).kind != TypeKind.Record || !closed_inline_value(value, 0) {
        return false
    }
    let locals = new[Local]()
    push(locals, Local {
            name = "self"
            ty = base
            mutable = false
            is_scoped = false
        })
    let proof = Function {
        is_async = false
        symbol = -1
        arguments = new[Int]()
        params = new[Int]()
        result = base
        locals = locals
        preconditions = new[Expr]()
        postconditions = expressions(predicate)
        result_local = 0
        body = value
        runtime_name = ""
        span = node.span
    }
    match verify_with_types(context.env.types, proof, get(context.env.inputs, 0).build.proof_backend) {
        Result.Ok(_) => true
        Result.Err(_) => false
    }
}

fn constrained(context Context, node Node, declaration Int, types List[Node], inputs CallInputs, expected Int) Result[Expr, Failure] {
    if length(inputs.nodes) != 1 {
        return Result.Err(error(context, node, "a constrained constructor takes one value"))
    }
    let count = length(group(symbol(context.env, declaration).node, NodeKind.TypeParameters))
    let arguments = data_arguments(context, node, declaration, types, expected, count)?
    let pattern = base_type(context.env, template(context, declaration, count)?)
    let hint = if get(inputs.nodes, 0).kind == NodeKind.List {
        hint(context, pattern, arguments, node)?
    } else {
        -1
    }
    let input = input_value(context, inputs, 0, hint, false)?
    if !complete(arguments) {
        discard infer(context.env, pattern, input.ty, arguments)
    }
    if !complete(arguments) {
        return Result.Err(error(context, node, "cannot infer constrained type arguments"))
    }
    let target = constructed_type(context, declaration, arguments, node)?
    if get(context.env.type_states, target).phase == 3 {
        return Result.Err(error(context, node, "recursive type constraint construction; check for a dependency cycle"))
    }
    let base = base_type(context.env, target)
    if input.ty == target {
        return Result.Ok(input)
    }
    let value = typed(context, node, input, base)?
    let source = get(context.env.types, input.ty)
    let destination = get(context.env.types, target)
    let boundary = if constrained_list(context.env, target) {
        "checked list"
    } else {
        ""
    }
    if boundary != "" && closed_list_value(value) {
        let checked = folded_record_predicate(context.env, target, value)?
        if checked.ty == 2 {
            if checked.number == 0 {
                return Result.Err(error(context, node, "this constant does not satisfy the type constraint"))
            }
            return Result.Ok(expression(ExprKind.Coerce, target, node, boundary, -1, expressions(value), value.falls))
        }
    }
    if (base == 1 || base == 3 || base == 5) && source.kind == TypeKind.Refined && base_type(context.env, input.ty) == base &&
    length(source.constraint) == 1 && length(destination.constraint) == 1 &&
    implies(get(source.constraint, 0), get(destination.constraint, 0), get(context.env.inputs, 0).build.proof_backend) {
        return Result.Ok(expression(ExprKind.Coerce, target, node, boundary, -1, expressions(value), value.falls))
    }
    if length(destination.constraint) == 1 && facts_imply(context, value, get(destination.constraint, 0)) {
        return Result.Ok(expression(ExprKind.Coerce, target, node, boundary, -1, expressions(value), value.falls))
    }
    if length(destination.constraint) == 1 && proven_record(context, node, base, value, get(destination.constraint, 0)) {
        return Result.Ok(expression(ExprKind.Coerce, target, node, boundary, -1, expressions(value), value.falls))
    }
    if length(destination.constraint) == 1 && proved_construction(context, node, get(inputs.nodes, 0), value, target)? {
        return Result.Ok(expression(ExprKind.Coerce, target, node, boundary, -1, expressions(value), value.falls))
    }
    if get(context.env.types, base).kind == TypeKind.Record && closed_inline_value(value, 0) {
        let checked = folded_record_predicate(context.env, target, value)?
        if checked.ty == 2 {
            if checked.number == 0 {
                return Result.Err(error(context, node, "this constant does not satisfy the type constraint"))
            }
            return Result.Ok(expression(ExprKind.Coerce, target, node, boundary, -1, expressions(value), value.falls))
        }
    }
    let known = folded(value, unknown())
    if known.ty == base {
        let checked = folded_predicate(context.env, target, known)?
        if checked.ty == 2 {
            if checked.number == 0 {
                return Result.Err(error(context, node, "this constant does not satisfy the type constraint"))
            }
            return Result.Ok(expression(ExprKind.Coerce, target, node, boundary, -1, expressions(value), value.falls))
        }
    }
    if (base == 1 || base == 3 || base == 5) && source.kind == TypeKind.Refined && length(source.constraint) == 1 && length(destination.constraint) == 1 &&
    (predicate_calls(get(source.constraint, 0), 0) || predicate_calls(get(destination.constraint, 0), 0)) &&
    helpers_imply(context, node, input.ty, target) {
        return Result.Ok(expression(ExprKind.Coerce, target, node, boundary, -1, expressions(value), value.falls))
    }
    let shape = result_shape(context, node)?
    let error_type = constraint_error(context, node)?
    let output = result_type(context, node, shape, target, error_type)?
    let local = length(context.locals)
    push(context.locals, Local {
            name = "self"
            ty = base
            mutable = false
            is_scoped = false
        })
    let saved = expression(ExprKind.Let, 0, node, "", local, expressions(value), value.falls)
    let reference = atom(ExprKind.Local, base, node, local)
    let refined = expression(ExprKind.Coerce, target, node, "", -1, expressions(reference), true)
    let accepted = expression(ExprKind.Variant, output, node, "", shape.ok, expressions(refined), true)
    let reason = expression(ExprKind.Variant, error_type, node, "", 0, new[Expr](), true)
    let rejected = expression(ExprKind.Variant, output, node, "", shape.err, expressions(reason), true)
    if context.env.stage_depth >= 32 {
        return Result.Err(error(context, node, "type constraint expansion depth exceeded; check for a dependency cycle"))
    }
    // Guard expansion shares this function queue, unlike compile-time staging.
    let env = Environment {
        inputs = context.env.inputs
        static_aliases = context.env.static_aliases
        packs = context.env.packs
        closures = context.env.closures
        source = context.env.source
        types = context.env.types
        type_states = context.env.type_states
        expand_data = true
        has_refinements = context.env.has_refinements
        expanding_helpers = context.env.expanding_helpers
        signatures = context.env.signatures
        pending = context.env.pending
        stage_depth = context.env.stage_depth + 1
        computations = context.env.computations
        validations = context.env.validations
        concepts = context.env.concepts
        implementations = context.env.implementations
        interfaces = context.env.interfaces
        associations = context.env.associations
        association_depth = context.env.association_depth
        family_applications = context.env.family_applications
        promise_path = context.env.promise_path
        promise_depth = context.env.promise_depth
        dynamic_interfaces = context.env.dynamic_interfaces
        witnesses = context.env.witnesses
        uses = context.env.uses
    }
    let predicate = refinement_expression(predicate_context(env, target, context.locals, local, context.emit)?, target)?
    let branches = expressions(predicate_at(predicate, node))
    push(branches, expression(ExprKind.Block, output, node, "", -1, expressions(accepted), true))
    push(branches, expression(ExprKind.Block, output, node, "", -1, expressions(rejected), true))
    let condition = expression(ExprKind.If, output, node, "", -1, branches, true)
    Result.Ok(expression(ExprKind.Block, output, node, boundary, -1, pair(saved, condition), value.falls))
}
