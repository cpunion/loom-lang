fn associated_pack_definitions() Text {
    """
    concept Source {
        type Item
        type Wrap[T]
    }
    impl Source for Int {
        type Item = Text
        type Wrap[T] = (Int, T)
    }
    impl Source for Bool {
        type Item = Int
        type Wrap[T] = List[T]
    }
    fn items[Ts... Source](values Ts.Item...) (Ts.Source.Item...) {
        values
    }

    """
}

test fn associated_packs_expand_receivers_family_arguments_and_qualified_members() {
    discard accepted(concat(associated_pack_definitions(), """
        record Values[Tag, Ts... Source] {
            tag Tag
            sources (Ts...)
            items (Ts.Item...)
            wrapped (Ts.Source.Wrap[Ts]...)
        }
        enum Output[Ts... Source] {
            Items(Ts.Item...)
            Empty
        }
        fn choose[Ts... Source](sources (Ts...), values (Ts.Item...)) (Ts.Item...) {
            discard sources
            values
        }
        fn main() {
            let values = Values {
                tag = "data",
                items = ("one", 2),
                sources = (1, true),
                wrapped = ((1, 3), [true])
            }
            assert values.items.0 == "one" && values.items.1 == 2
            assert values.wrapped.0.1 == 3 && values.wrapped.1[0]
            assert choose(values.sources, values.items).1 == 2
            let callback = items[Int, Bool]
            assert callback("first", 42).1 == 42
            assert comptime { items[Int]("constant").0 } == "constant"
            let output Output[Int, Bool] = Output.Items("one", 2)
            assert match output {
                Output.Items(text, number) => text == "one" && number == 2
                Output.Empty => false
            }
            let empty = items()
            discard Values { tag = 0, sources = empty, items = empty, wrapped = empty }
        }
        """))
}

test fn associated_packs_require_bounds_and_do_not_invert_associated_results() {
    let definitions = associated_pack_definitions()
    rejects(concat(definitions, """
        fn main() {
            discard items("unknown receiver", 1)
        }
        """))
    rejects(concat(definitions, """
        fn main() {
            discard items[Int](false)
        }
        """))
    rejects(concat(definitions, """
        fn missing[Ts...](values Ts.Item...) (Ts.Item...) {
            values
        }
        fn main() {
            discard missing[Int]("undeclared")
        }
        """))
    rejects(concat(definitions, """
        record Missing[Ts...] {
            items (Ts.Source.Item...)
        }
        fn main() {
            discard Missing[Int] { items = ("undeclared",) }
        }
        """))
    rejects(concat(definitions, """
        concept Other {
            type Item
        }
        impl Other for Int {
            type Item = Text
        }
        record Ambiguous[Ts... Source + Other] {
            items (Ts.Item...)
        }
        fn main() {
            discard Ambiguous[Int] { items = ("ambiguous",) }
        }
        """))
    rejects(concat(definitions, """
        record Unexpanded[Ts... Source] {
            item Ts.Item
        }
        fn main() {
            discard Unexpanded[Int] { item = "missing expansion" }
        }
        """))
}

test fn associated_data_packs_revalidate_family_domains_and_cached_types() {
    rejects("""
        concept Required {}
        impl Required for Int {}
        concept Family {
            type Item[T Required] = T
        }
        impl Family for Int {}
        record Missing[Ts... Family] {
            items (Ts.Item[Ts]...)
        }
        fn main() {
            discard Missing[Int] { items = (1,) }
        }
        """)
    let source = concat(associated_pack_definitions(), """
        record Values[Ts... Source] {
            items (Ts.Item...)
        }
        pub fn answer() Int {
            let values = Values[Bool] { items = (42,) }
            values.items.0
        }
        """)
    let initial = definition_cache()
    assert match cached_source(initial, source) {
        Result.Ok(_) => true
        Result.Err(_) => false
    }
    let cache = restored_definition_cache(initial)
    assert match cached_source(cache, concat("fn unrelated() {}\n", source)) {
        Result.Ok(_) => true
        Result.Err(_) => false
    }
    assert bodies_reused(cache) >= 1
    discard restored_definition_cache(cache)
}
