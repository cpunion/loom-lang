import std.loom.project.InputRequest
import std.loom.project.InputFile
import std.loom.project.BuildInput
import std.loom.project.same_request
import std.loom.project.same_input
import std.loom.project.input_snapshot
import std.loom.project.BuildOption
import std.loom.project.build_option_snapshot
import std.loom.project.valid_build_option
import std.loom.project.valid_target_property
import std.loom.source.Span
import std.bytes.decode_utf8

// One context per check. The caller can supply snapshots and/or an explicit
// reader; discovered dependencies append to files. Treat them as read-only.
pub record BuildInputs {
    options List[BuildOption]
    targets List[BuildOption]
    target_context Text
    read_target fn(Text) Result[List[BuildOption], Text]
    files List[BuildInput]
    // Includes failed reads, so editors can observe a missing input's creation.
    requests List[InputRequest]
    read fn(InputRequest) Result[InputFile, Text]
}

pub fn build_inputs(reader fn(InputRequest) Result[InputFile, Text]) BuildInputs {
    build_inputs(reader, new[BuildOption]())
}

pub fn build_inputs(reader fn(InputRequest) Result[InputFile, Text], options List[BuildOption]) BuildInputs {
    build_inputs(reader, options, no_target_reader, "")
}

pub fn build_inputs(reader fn(InputRequest) Result[InputFile, Text], options List[BuildOption], target_reader fn(Text) Result[List[BuildOption], Text], target_context Text) BuildInputs {
    BuildInputs {
        options = options
        targets = new[BuildOption]()
        target_context = target_context
        read_target = target_reader
        files = new[BuildInput]()
        requests = new[InputRequest]()
        read = reader
    }
}

pub fn no_target_reader(context Text) Result[List[BuildOption], Text] {
    Result.Err("target properties require an explicit snapshot or reader")
}

// Read one coherent target snapshot only when requested. The explicit reader
// context keeps the compiler on the named-function bootstrap subset.
pub fn target_value(inputs BuildInputs, name Text) Result[Text, Text] {
    if !valid_target_property(name) {
        return Result.Err("unknown target property; expected os, arch, pointer_width or endian")
    }
    if length(inputs.targets) == 0 {
        let values = build_option_snapshot(inputs.read_target(inputs.target_context)?)?
        var index = 0
        while index < length(values) {
            if !valid_target_property(get(values, index).name) {
                return Result.Err("unknown target property in build snapshot")
            }
            index = index + 1
        }
        index = 0
        while index < length(values) {
            push(inputs.targets, get(values, index))
            index = index + 1
        }
    }
    var index = 0
    while index < length(inputs.targets) {
        let property = get(inputs.targets, index)
        if property.name == name {
            return Result.Ok(property.value)
        }
        index = index + 1
    }
    Result.Err(concat("target snapshot does not supply property ", name))
}

fn input_options(inputs BuildInputs) Result[List[BuildOption], Text] {
    let targets = build_option_snapshot(inputs.targets)?
    var index = 0
    while index < length(targets) {
        if !valid_target_property(get(targets, index).name) {
            return Result.Err("unknown target property in build snapshot")
        }
        index = index + 1
    }
    build_option_snapshot(inputs.options)
}

pub fn no_input_reader(request InputRequest) Result[InputFile, Text] {
    Result.Err(concat("build input requires an explicit snapshot or reader: ", request.path))
}

fn build_intrinsic(env Environment, owner Int) Bool {
    let item = symbol(env, owner)
    if (item.name != "input_file" && item.name != "input_bytes" && item.name != "option_present" && item.name != "option_text" && item.name != "target") ||
    !has(item.node, NodeKind.Intrinsic) {
        return false
    }
    let file = get(env.source.files, item.file)
    file.trusted_std &&
    package_label(env.source.modules, env.source.packages, file.package) == "std.build"
}

fn build_call(context Context, node Node, owner Int, value StaticValue) Result[Expr, Failure] {
    let name = symbol(context.env, owner).name
    if name == "input_file" || name == "input_bytes" {
        return input_call(context, node, value, name == "input_bytes")
    }
    let ty = if name == "option_present" {
        2
    } else {
        3
    }
    if !value.known {
        return Result.Ok(expression(ExprKind.Deferred, ty, node, "", -1, new[Expr](), true))
    }
    if name == "target" {
        let selected = match target_value(get(context.env.inputs, 0), value.text) {
            Result.Ok(value) => value
            Result.Err(message) => {
                return Result.Err(error(context, node, message))
            }
        }
        return Result.Ok(expression(ExprKind.Text, 3, node, selected, -1, new[Expr](), true))
    }
    if !valid_build_option(value.text) {
        return Result.Err(error(context, node, "invalid build option name"))
    }
    let options = get(context.env.inputs, 0).options
    var index = 0
    while index < length(options) && get(options, index).name != value.text {
        index = index + 1
    }
    let present = index < length(options)
    if ty == 2 {
        return Result.Ok(expression(ExprKind.Bool, 2, node, if present {
                    "true"
                } else {
                    "false"
                }, -1, new[Expr](), true))
    }
    if !present {
        return Result.Err(error(context, node, "build option has no supplied value"))
    }
    Result.Ok(expression(ExprKind.Text, 3, node, get(options, index).value, -1, new[Expr](), true))
}

fn input_expression(context Context, node Node, file InputFile, binary Bool) Result[Expr, Failure] {
    if binary {
        return Result.Ok(expression(ExprKind.Bytes, 4, node, std.encoding.hex.encode(file.bytes), -1, new[Expr](), true))
    }
    let text = match std.bytes.decode_utf8(file.bytes) {
        Result.Ok(value) => value
        Result.Err(_) => {
            return Result.Err(error(context, node, "build input is not valid UTF-8; use input_bytes for binary data"))
        }
    }
    Result.Ok(expression(ExprKind.Text, 3, node, text, -1, new[Expr](), true))
}

fn input_call(context Context, node Node, value StaticValue, binary Bool) Result[Expr, Failure] {
    if !value.known {
        return Result.Ok(expression(ExprKind.Deferred, if binary { 4 } else { 3 }, node, "", -1, new[Expr](), true))
    }
    let source = get(context.env.source.files, symbol(context.env, context.signature.symbol).file)
    let package = get(context.env.source.packages, source.package)
    let request = InputRequest {
        root = get(context.env.source.modules, package.instance).source
        source = source.path
        path = value.text
    }
    let inputs = get(context.env.inputs, 0)
    var index = 0
    while index < length(inputs.files) {
        let saved = get(inputs.files, index)
        if same_request(saved.request, request) {
            return input_expression(context, node, saved.file, binary)
        }
        index = index + 1
    }
    push(inputs.requests, request)
    let file = match inputs.read(request) {
        Result.Ok(file) => input_snapshot(file)
        Result.Err(message) => {
            return Result.Err(error(context, node, message))
        }
    }
    index = 0
    while index < length(inputs.files) {
        let saved = get(inputs.files, index).file
        if saved.path == file.path && !same_input(saved, file) {
            return Result.Err(error(context, node, "build input changed during checking"))
        }
        index = index + 1
    }
    push(inputs.files, BuildInput {
            request = request
            file = file
        })
    input_expression(context, node, file, binary)
}
