test fn nested_forwarding_reuses_words_and_checked_finite_type_identities() {
    discard accepted("""
        fn framed[Ts...](values (Int, Ts..., Bool)) Int
        ensures result >= 2 {
            var count = 0
            comptime for item in values {
                discard item
                count = count + 1
            }
            count
        }
        fn framed(value Bool) Int {
            -1
        }
        fn framed[Ts...](values (Text, Ts..., Bool)) Int
        ensures result == -1 {
            -1
        }
        fn nested[Us...](values (Us...)) Int
        ensures result >= 2 {
            framed((1, values..., true))
        }
        fn double[Us..., Vs...](left (Us...), right (Vs...)) Int
        ensures result >= 2 {
            framed((1, (left..., true), right..., false))
        }
        record Box[T] {
            value T
        }
        fn boxed[T, Ts...](values (Box[T], Ts..., Bool)) Int
        ensures result == 42 {
            42
        }
        fn inferred[Us...](values (Us...)) Int
        ensures result == 42 {
            boxed((Box { value = ("text", 1) }, values..., true))
        }
        fn explicit[Us...](values (Us...)) Int
        ensures result == 42 {
            boxed[(Text, Int), Us...]((Box { value = ("text", 1) }, values..., true))
        }
        fn keep[Ts...](values (Int, Ts..., Bool), value Int) Int
        ensures result == value {
            value
        }
        fn snapshot[Us...](value Int, values (Us...)) Int
        ensures result == value + 1 {
            var current = value
            keep(({
                current = current + 1
                0
            }, values..., true), current)
        }
        """)
}

test fn nested_forwarding_retains_effects_and_rejects_opaque_value_escape() {
    let effects = """
        import std.list.push
        import std.list.length
        fn framed[Ts...](values (Int, Ts..., Bool)) Int
        ensures result == 42 {
            42
        }
        fn forward[Us...](log List[Int], values (Us...)) Int
        ensures length(log) == old(length(log)) + 2 {
            framed(({
                push(log, 1)
                0
            }, values..., {
                push(log, 2)
                true
            }))
        }
        """
    list_length_contract(effects, true)
    list_length_contract(std.text.join(std.text.split(effects, "+ 2"), "+ 1"), false)
    rejects("""
        fn framed[Ts...](values (Int, Ts..., Bool)) Int
        ensures result >= 0 {
            0
        }
        fn wrong[Us...](values (Us...)) Int
        ensures result >= 0 {
            framed(({
                return -1
                0
            }, values..., true))
        }
        """)
    rejects("""
        fn split[As..., Bs...](values (Int, As..., Bs..., Bool)) Int
        ensures result >= 0 {
            0
        }
        fn wrong[Us...](values (Us...)) Int
        ensures result >= 0 {
            split((1, values..., true))
        }
        """)
    rejects("""
        fn keep[T, Ts...](value T, context Ts...) Int
        ensures result == 42 {
            42
        }
        fn wrong[Us...](values (Us...)) Int
        ensures result == 42 {
            keep((1, values..., true), false)
        }
        """)
    rejects("""
        type Positive = Int where self > 0
        fn framed[Ts...](values (Int, Ts..., Bool)) Int
        ensures result >= 0 {
            0
        }
        fn framed[Ts...](values (Positive, Ts..., Bool)) Int
        ensures result == -1 {
            -1
        }
        fn wrong[Us...](value Positive, values (Us...)) Int
        ensures result >= 0 {
            framed((value, values..., true))
        }
        """)
    resource_reject_reason(concat(resource_header(), """
        fn framed[Ts...](values (Int, Ts..., Bool)) Int
        ensures result == 42 {
            42
        }
        fn wrong[Us...](log List[Int], values (Us...)) Int
        ensures result == 42 {
            framed((1, make(log), values..., true))
        }
        """), "MustScope values require scoped, not an ordinary binding or discard")
}
