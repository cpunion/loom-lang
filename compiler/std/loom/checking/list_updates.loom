import std.loom.proof.verify_preservation
import std.loom.proof.sequence_operation
import std.loom.proof.preserves_update_expression
import std.loom.proof.preserves_update_identity

fn update_literal(value Expr) Bool {
    value.kind == ExprKind.Integer || value.kind == ExprKind.Bool ||
    value.kind == ExprKind.Text || value.kind == ExprKind.Float
}

fn proved_update_expression(env Environment, functions List[Function], locals List[Local], value Expr) Bool {
    if env.expanding_helpers || env.stage_depth >= 32 {
        return false
    }
    let receiver = get(value.children, 0)
    if !constraint_weakened(env, receiver) {
        return false
    }
    if get(receiver.children, 0).kind == ExprKind.Local {
        var dependent = false
        var argument = 1
        while argument < length(value.children) {
            dependent = dependent || !update_literal(get(value.children, argument))
            argument = argument + 1
        }
        // The preceding probe already kept these exact literals. Rebuilding
        // the same receiver-only obligation supplies no argument relationships.
        if !dependent {
            return false
        }
    }
    // Shared builds must prove the same expression with interference between
    // argument reads and the atomic store; sequential evidence cannot waive it.
    var shared = false
    var index = 0
    while index < length(functions) && !shared {
        shared = worker_expression(get(functions, index).body)
        index = index + 1
    }
    match update_expression_proof(env, functions, locals, value, shared) {
        Result.Ok(proved) => proved
        Result.Err(_) => false
    }
}

fn update_expression_proof(env Environment, functions List[Function], locals List[Local], value Expr, shared Bool) Result[Bool, Failure] {
    let receiver = get(value.children, 0)
    let ty = get(receiver.children, 0).ty
    let node = predicate_node(env, get(env.types, ty).symbol)
    let stage = staging(predicate_scope(env, ty)?, node)?
    let predicate = refinement_expression(stage, ty)?
    let isolated = prepared_in(stage, true)?
    // Optional expanded type facts may be partial. A preservation obligation
    // must instead expand the entire predicate successfully, including every
    // conjunct and its safety conditions; opaque parts cannot be omitted.
    let predicates = match std.loom.proof.invariant_predicates(isolated, receiver.ty, predicate) {
        Result.Ok(predicates) => predicates
        Result.Err(_) => new[Expr]()
    }
    let inputs = [receiver.ty]
    let probe = Function {
        is_async = false
        symbol = -1
        arguments = []
        params = inputs
        result = 0
        locals = []
        preconditions = []
        postconditions = []
        result_cleanup = []
        result_local = -1
        body = value
        runtime_name = ""
        span = value.span
    }
    let types = expanded_invariant_types(env, probe)?
    let program = std.loom.typed.Program {
        types = types
        functions = functions
        entry = -1
        tests = []
        test_names = []
        exports = []
        interfaces = env.interfaces
        witnesses = env.witnesses
    }
    let backend = get(env.inputs, 0).build.proof_backend
    if length(predicates) > 0 {
        match std.loom.proof.preserves_update_expression(program, locals, value, predicates, backend, shared) {
            Result.Ok(proved) => {
                if proved {
                    return Result.Ok(true)
                }
            }
            Result.Err(_) => {
            }
        }
    }
    Result.Ok(match std.loom.proof.preserves_update_identity(program, locals, value, backend, shared) {
            Result.Ok(proved) => proved
            Result.Err(_) => false
        })
}

fn sequence_store(env Environment, receiver Int, writes Int) Text {
    if base_type(env, receiver) == 4 {
        if writes == 1 {
            "bytes_set"
        } else {
            "bytes_push"
        }
    } else {
        if writes == 1 {
            "list_set"
        } else {
            "list_push"
        }
    }
}

// Preserve the nominal information erased by an ordinary representation borrow.
// Other expressions are abstract inputs: never replay caller effects in a proof.
fn update_input(env Environment, value Expr) Expr {
    var selected = value
    var depth = 0
    while depth < 64 {
        if selected.kind == ExprKind.Coerce && length(selected.children) == 1 {
            let input = get(selected.children, 0)
            if get(env.types, input.ty).kind == TypeKind.Refined && base_type(env, input.ty) == selected.ty {
                return input
            }
        }
        if selected.kind != ExprKind.Block || length(selected.children) == 0 {
            return selected
        }
        let tail = get(selected.children, length(selected.children) - 1)
        if tail.ty != selected.ty || !tail.falls {
            return selected
        }
        // Earlier effects are checked in evaluation order by the caller. Only
        // the normal-result value supplies a type/literal to the private probe.
        selected = tail
        depth = depth + 1
    }
    value
}

fn proved_list_update(env Environment, value Expr, writes Int) Bool {
    let receiver = get(value.children, 0)
    if !constraint_weakened(env, receiver) {
        return false
    }
    let ty = get(receiver.children, 0).ty
    let node = predicate_node(env, get(env.types, ty).symbol)
    let scope = match predicate_scope(env, ty) {
        Result.Ok(context) => context
        Result.Err(_) => {
            return false
        }
    }
    let stage = match staging(scope, node) {
        Result.Ok(context) => context
        Result.Err(_) => {
            return false
        }
    }
    let predicate = match refinement_expression(stage, ty) {
        Result.Ok(expression) => expression
        Result.Err(_) => {
            return false
        }
    }
    let program = match prepared_in(stage, true) {
        Result.Ok(checked) => checked
        Result.Err(_) => {
            return false
        }
    }
    let params = if writes == 1 {
        [receiver.ty, 1, update_input(env, get(value.children, 2)).ty]
    } else {
        [receiver.ty, update_input(env, get(value.children, 1)).ty]
    }
    let locals = new[Local]()
    let arguments = new[Expr]()
    var index = 0
    while index < length(params) {
        let input = get(value.children, index)
        let source = expression(ExprKind.Local, get(params, index), node,
            "", index, new[Expr](), true)
        push(locals, Local {
                name = ""
                ty = source.ty
                mutable = false
                is_scoped = false
            })
        push(arguments, if index != 0 && update_literal(input) {
                input
            } else if input.ty != source.ty {
                expression(ExprKind.Coerce, input.ty, node, "", -1, [source], true)
            } else {
                source
            })
        index = index + 1
    }
    // Construction established the complete predicate immediately before this
    // atomic operation. Normal continuation models one store and any bounds
    // check; a bounds fault happens before any mutation. No transient broken
    // state or callee normal-return promise can justify this admission.
    let probe = Function {
        is_async = false
        symbol = get(env.types, ty).symbol
        arguments = new[Int]()
        params = params
        result = 0
        locals = locals
        preconditions = [predicate]
        postconditions = [predicate]
        result_cleanup = new[Expr]()
        result_local = -1
        body = expression(ExprKind.Intrinsic, 0, node,
            sequence_store(env, receiver.ty, writes), -1, arguments, true)
        runtime_name = ""
        span = value.span
    }
    // Try bounded local reasoning before preparing helper facts or invoking
    // SMT. A solver query missing an established input predicate is wasted.
    match std.loom.proof.verify_with_helpers(program, probe, std.loom.proof.no_proof_backend()) {
        Result.Ok(_) => true
        Result.Err(_) => match expanded_invariant_types(stage, probe) {
            Result.Ok(types) => match std.loom.proof.verify_with_helpers(proof_types(program, types),
                probe, get(env.inputs, 0).build.proof_backend) {
                Result.Ok(_) => true
                Result.Err(_) => false
            }
            Result.Err(_) => false
        }
    }
}

fn proved_list_mutation(env Environment, value Expr, shared Bool, writes Int) Bool {
    match list_mutation_proof(env, value, shared, writes) {
        Result.Ok(proved) => proved
        Result.Err(_) => false
    }
}

record ListMutationInputs {
    context Context
    node Node
    shared Bool
    writes Int
    params List[Int]
    locals List[Local]
    predicates List[Expr]
    protected List[std.loom.proof.InputGuarantee]
    aliases List[(Int, Int)]
    allocations List[Int]
    entries List[Int]
}

fn list_mutation_alias_input(value Expr, depth Int) Bool {
    if value.kind == ExprKind.Coerce && (value.text == "draft input" || value.text == "draft entry") && value.index >= 0 {
        return true
    }
    if value.kind == ExprKind.Record && depth < 64 {
        var index = 0
        while index < length(value.children) {
            if list_mutation_alias_input(get(get(value.children, index).children, 0), depth + 1) {
                return true
            }
            index = index + 1
        }
    }
    false
}

fn list_mutation_root(env Environment, value Expr, depth Int) Int {
    if constraint_weakened(env, value) {
        return get(value.children, 0).ty
    }
    if value.kind == ExprKind.Record && depth < 64 {
        var index = 0
        while index < length(value.children) {
            let root = list_mutation_root(env, get(get(value.children, index).children, 0), depth + 1)
            if root >= 0 {
                return root
            }
            index = index + 1
        }
    }
    -1
}

// Split only the private aggregate probe, never executable operands. Each leaf
// is an abstract already-evaluated input; sibling effects or heap observations
// cannot become scalar proof facts by replaying their source expressions.
fn list_mutation_input(probe ListMutationInputs, argument Expr, depth Int) Result[Expr, Failure] {
    if depth >= 64 {
        return Result.Err(error(probe.context, probe.node, "aggregate mutation proof depth exhausted"))
    }
    if argument.kind == ExprKind.Record && (list_mutation_root(probe.context.env, argument, 0) >= 0 ||
        list_mutation_alias_input(argument, 0)) {
        let fields = new[Expr]()
        var index = 0
        while index < length(argument.children) {
            let field = get(argument.children, index)
            let input = list_mutation_input(probe, get(field.children, 0), depth + 1)?
            push(fields, expression(ExprKind.Field, field.ty, probe.node, "", field.index, expressions(input), true))
            index = index + 1
        }
        return Result.Ok(expression(ExprKind.Record, argument.ty, probe.node, "", -1, fields, true))
    }
    let borrowed = constraint_weakened(probe.context.env, argument)
    let ty = if borrowed {
        get(argument.children, 0).ty
    } else {
        update_input(probe.context.env, argument).ty
    }
    var index = length(probe.params)
    let identified = argument.kind == ExprKind.Coerce &&
    (argument.text == "draft input" || argument.text == "draft entry") && argument.index >= 0
    if identified {
        var group = 0
        while group < length(probe.aliases) && get(probe.aliases, group).0 != argument.index {
            group = group + 1
        }
        if group < length(probe.aliases) {
            index = get(probe.aliases, group).1
            if get(probe.params, index) != ty {
                return Result.Err(error(probe.context, probe.node, "incompatible draft input aliases"))
            }
        } else {
            push(probe.aliases, (argument.index, index))
            if argument.text == "draft entry" {
                push(probe.entries, index)
            } else {
                push(probe.allocations, index)
            }
        }
    }
    if index < length(probe.params) {
        let input = expression(ExprKind.Local, ty, probe.node, "", index, new[Expr](), true)
        return Result.Ok(if argument.ty != ty {
                expression(ExprKind.Coerce, argument.ty, probe.node, "", -1, expressions(input), true)
            } else {
                input
            })
    }
    push(probe.params, ty)
    push(probe.locals, Local {
            name = ""
            ty = ty
            mutable = false
            is_scoped = false
        })
    let input = expression(ExprKind.Local, ty, probe.node, "", index, new[Expr](), true)
    if borrowed {
        push(probe.predicates, refinement_expression(
                predicate_context(probe.context.env, ty, probe.locals, index, true)?, ty)?)
        push(probe.protected, std.loom.proof.InputGuarantee {
                ty = ty
                // Shared preserving helpers may append through another alias.
                writes = if probe.shared {
                    2
                } else {
                    probe.writes
                }
            })
    }
    Result.Ok(if update_literal(argument) {
            argument
        } else if argument.ty != ty {
            expression(ExprKind.Coerce, argument.ty, probe.node, "", -1, expressions(input), true)
        } else {
            input
        })
}

fn list_mutation_proof(env Environment, value Expr, shared Bool, writes Int) Result[Bool, Failure] {
    if value.kind != ExprKind.Call || value.index < 0 || env.expanding_helpers || env.stage_depth >= 32 {
        return Result.Ok(false)
    }
    var root = -1
    var index = 0
    while index < length(value.children) {
        let selected = list_mutation_root(env, get(value.children, index), 0)
        if selected >= 0 {
            root = selected
        }
        index = index + 1
    }
    if root < 0 {
        return Result.Ok(false)
    }
    let node = predicate_node(env, get(env.types, root).symbol)
    let stage = staging(predicate_scope(env, root)?, node)?
    let helpers = helper_environment(stage.env)
    let instance = get(env.pending, value.index)
    let target = if instance.signature < 0 {
        schedule_closure(helpers, -1 - instance.signature)
    } else {
        schedule(helpers, instance.signature, instance.arguments, instance.constants, node)?
    }
    let params = new[Int]()
    let locals = new[Local]()
    let inputs = new[Expr]()
    let predicates = new[Expr]()
    let protected = new[std.loom.proof.InputGuarantee]()
    let allocations = new[Int]()
    let entries = new[Int]()
    let probe_inputs = ListMutationInputs {
        context = predicate_context(helpers, root, locals, 0, true)?
        node = node
        shared = shared
        writes = writes
        params = params
        locals = locals
        predicates = predicates
        protected = protected
        aliases = new[(Int, Int)]()
        allocations = allocations
        entries = entries
    }
    index = 0
    while index < length(value.children) {
        push(inputs, list_mutation_input(probe_inputs, get(value.children, index), 0)?)
        index = index + 1
    }
    let scope = predicate_context(helpers, root, locals, 0, true)?
    let program = prepared_in(scope, true)?
    let probe = Function {
        is_async = false
        symbol = -1
        arguments = new[Int]()
        params = params
        result = value.ty
        locals = locals
        preconditions = predicates
        postconditions = predicates
        result_cleanup = new[Expr]()
        result_local = -1
        body = expression(ExprKind.Call, value.ty, node, "", target, inputs, true)
        runtime_name = ""
        span = value.span
    }
    match std.loom.proof.verify_preservation(program, probe, std.loom.proof.no_proof_backend(), shared, protected, allocations, entries) {
        Result.Ok(proved) => Result.Ok(proved)
        Result.Err(_) => {
            // Pure helper predicates belong to the value's established type,
            // just as in ordinary contracts. Expand only in the private proof
            // closure; runtime calls and shared type metadata stay unchanged.
            let types = expanded_invariant_types(scope, probe)?
            match std.loom.proof.verify_preservation(proof_types(program, types), probe,
                get(env.inputs, 0).build.proof_backend, shared, protected, allocations, entries) {
                Result.Ok(proved) => Result.Ok(proved)
                Result.Err(message) => Result.Err(error(scope, node, message))
            }
        }
    }
}

// Capture evidence at the original typing point, where stable caller facts and
// binding identities are available. The private probe imports no heap reads or
// mutable bindings, and never re-evaluates argument effects in executable code.
fn flow_list_update(context Context, node Node, value Expr) Expr {
    if !context.emit || !context.env.has_refinements || context.env.expanding_helpers ||
    context.env.stage_depth >= 32 || context.fact_head < 0 || value.ty != 0 ||
    (length(value.children) != 2 && length(value.children) != 3) {
        return value
    }
    if value.kind != ExprKind.Call {
        if value.kind != ExprKind.Intrinsic {
            return value
        }
        let operation = std.loom.proof.sequence_operation(value.text)
        if operation != "list_set" && operation != "list_push" {
            return value
        }
    }
    let receiver = get(value.children, 0)
    if !constraint_weakened(context.env, receiver) {
        return value
    }
    let ty = get(receiver.children, 0).ty
    if get(context.env.type_states, ty).list_writes != 0 {
        return value
    }
    match flow_list_update_proof(context, node, value, ty) {
        Result.Ok(true) => expression(ExprKind.Block, 0, node, "proved sequence update", -1,
            expressions(value), value.falls)
        _ => value
    }
}

fn flow_list_update_proof(context Context, node Node, value Expr, ty Int) Result[Bool, Failure] {
    let stage = staging(context, node)?
    let env = helper_environment(stage.env)
    var selected = value
    if value.kind == ExprKind.Call {
        if value.index < 0 {
            return Result.Ok(false)
        }
        let instance = get(context.env.pending, value.index)
        selected = expression(value.kind, value.ty, node, value.text,
            if instance.signature < 0 {
                schedule_closure(env, -1 - instance.signature)
            } else {
                schedule(env, instance.signature, instance.arguments, instance.constants, node)?
            }, value.children, value.falls)
    }
    let params = [get(value.children, 0).ty]
    let locals = [Local {
            name = "self"
            ty = get(params, 0)
            mutable = false
            is_scoped = false
        }]
    let bindings = [-1]
    let inputs = [expression(ExprKind.Local, get(params, 0), node, "", 0, new[Expr](), true)]
    var index = 1
    while index < length(value.children) {
        let argument = get(value.children, index)
        let input = construction_input(context, update_input(context.env, argument), bindings, params, locals, 0)
        push(inputs, if input.ty == argument.ty {
                input
            } else {
                expression(ExprKind.Coerce, argument.ty, node, "", -1, expressions(input), true)
            })
        index = index + 1
    }
    let premises = construction_premises(context, stage, node, bindings, params, locals)
    let scope = predicate_context(env, ty, locals, 0, true)?
    let predicate = refinement_expression(scope, ty)?
    let program = prepared_in(scope, true)?
    let writes = std.loom.proof.single_list_write(program.functions, selected)
    if writes == 0 {
        return Result.Ok(false)
    }
    let established = established_construction_premises(program, locals, premises)
    push(established, predicate)
    let probe = Function {
        is_async = false
        symbol = -1
        arguments = new[Int]()
        params = params
        result = 0
        locals = locals
        preconditions = established
        postconditions = expressions(predicate)
        result_cleanup = new[Expr]()
        result_local = -1
        body = expression(ExprKind.Intrinsic, 0, node,
            sequence_store(env, get(value.children, 0).ty, writes), -1, inputs, true)
        runtime_name = ""
        span = node.span
    }
    Result.Ok(match std.loom.proof.verify_with_helpers(program, probe, get(env.inputs, 0).build.proof_backend) {
            Result.Ok(_) => true
            Result.Err(_) => false
        })
}
