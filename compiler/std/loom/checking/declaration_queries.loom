// Optional source bindings, captured before specialization and CTFE erase uses.
// Declaration IDs refer to the original source, not appended checked instances.
// A lexical parameter additionally keeps its source binder, not a nominal ID.
pub record DeclarationReference {
    file Int
    node Node
    segment Int
    symbol Int
    label Text
    parameter Option[Node]
}

fn method_reference_source(env Environment, owner Int) Int {
    var index = 0
    while index < length(env.packs) {
        let pack = get(env.packs, index)
        if pack.signature >= 0 && get(env.signatures, pack.signature).symbol == owner {
            return pack.source
        }
        index = index + 1
    }
    owner
}

// A Function reference is a checked implementation-to-concept declaration
// edge, not an expression use. It does not claim complete source coverage.
fn record_method_conformance(env Environment, header Implementation, owner Int, declaration Int) {
    if header.source != header.symbol && length(header.widths) == 0 {
        // An erased proof header is not an observed implementation instance.
        return
    }
    let source = impl_member_source(env, method_reference_source(env, owner))
    let target = method_reference_source(env, declaration)
    if source >= 0 {
        record_declaration_reference(env, source, symbol(env, source).node, target, 0, "")
    }
}

fn referenced_concept(env Environment, owner Int, node Node, path Text, skip Int) Result[Int, Failure] {
    let selected = concept_named(env, owner, node, path)?
    if selected < 0 || !get(env.inputs, 0).declaration_queries {
        return Result.Ok(selected)
    }
    let segment = skip + reference_path_segment(path)
    record_declaration_reference(env, owner, node, selected, segment, "")
    Result.Ok(selected)
}

fn record_declaration_reference(env Environment, owner Int, node Node, selected Int, segment Int, label Text) {
    record_declaration_reference(env, owner, node, selected, segment, label, Option.None)
}

fn record_declaration_reference(env Environment, owner Int, node Node, selected Int, segment Int,
    label Text, parameter Option[Node]) {
    let inputs = get(env.inputs, 0)
    if selected < 0 || !inputs.declaration_queries {
        return
    }
    let file = symbol(env, owner).file
    // Deduplication is file-local, not a quadratic scan of the import closure.
    while length(inputs.reference_indices) <= file {
        push(inputs.reference_indices, new[Int]())
    }
    let indices = get(inputs.reference_indices, file)
    var index = 0
    while index < length(indices) {
        let previous = get(inputs.declaration_references, get(indices, index))
        if previous.node.span.start == node.span.start && previous.node.span.end == node.span.end &&
        previous.segment == segment && previous.symbol == selected && previous.label == label {
            return
        }
        index = index + 1
    }
    push(indices, length(inputs.declaration_references))
    push(inputs.declaration_references, DeclarationReference {
            file = file
            node = node
            segment = segment
            symbol = selected
            label = label
            parameter = parameter
        })
}

// Resolution selected this parameter, not a same-spelled nominal type. Pack
// expansion preserves the original binder's span even when it renames slots.
// Do not turn proof-erased headers into observed source body coverage.
fn record_type_parameter_reference(env Environment, owner Int, node Node, parameter Node) {
    let signature = source_signature_id(env, owner)
    let instance = if signature >= 0 {
        pack_instance(env, signature)
    } else {
        -1
    }
    if instance >= 0 && erased_pack(get(env.packs, instance)) {
        return
    }
    let source = impl_member_source(env, method_reference_source(env, owner))
    if source < 0 || source >= get(env.inputs, 0).source_symbols ||
    symbol(env, source).file != symbol(env, owner).file {
        return
    }
    let parameters = type_parameters(env, source)
    var index = 0
    while index < length(parameters) {
        let declared = get(parameters, index)
        if declared.span.start == parameter.span.start && declared.span.end == parameter.span.end {
            record_declaration_reference(env, owner, node, source, 0,
                if declared.kind == NodeKind.TypePack {
                    concat(declared.value, "...")
                } else {
                    declared.value
                },
                Option.Some(declared))
            return
        }
        index = index + 1
    }
}

// Query-only evidence for source patterns survives decision-tree lowering.
// The symbol is the checked nominal owner; the source node identifies its
// field/variant member without adding provenance to executable expressions.
fn record_pattern_reference(context Context, node Node, ty Int, segment Int, label Int) {
    let env = context.env
    if !get(env.inputs, 0).declaration_queries {
        return
    }
    record_declaration_reference(env, context.signature.symbol, node,
        get(env.types, ty).symbol, segment,
        type_name(env.source, env.types, env.interfaces, label))
}

fn reference_path_segment(path Text) Int {
    var segment = 0
    var index = 0
    while index < length(path) {
        if std.text.byte(path, index) == 46 {
            segment = segment + 1
        }
        index = index + 1
    }
    segment
}

// Callers test the switch before entering this allocating function/root frame.
// Binding evidence needs no locals, effects, cleanup or other Context state.
fn record_function_reference(env Environment, owner Int, node Node, selected Int, arguments List[Int]) Result[Bool, Failure] {
    discard require_query_reference(env, selected, arguments)?
    let source = if node.kind == NodeKind.Apply {
        child(node, 0)
    } else {
        node
    }
    if source.kind != NodeKind.Name && source.kind != NodeKind.Call && source.kind != NodeKind.MethodCall {
        return Result.Ok(true)
    }
    var target = selected
    var types = arguments
    if prototype(env, get(env.signatures, selected).symbol) && length(arguments) != 0 &&
    concrete(env, get(arguments, 0)) &&
    (get(env.types, get(arguments, 0)).kind != TypeKind.Dyn ||
        (!method_receiver(env, get(env.signatures, selected).symbol) &&
            conformance(env, get(arguments, 0), symbol(env, get(env.signatures, selected).symbol).owner).implementation >= 0)) {
        // A concrete method call names its selected implementation. Retain
        // that binding before logical-only call indices lose their queue.
        // Erased receiver dispatch keeps the concept path; a receiver-free
        // function on a known dyn wrapper selects its explicit implementation.
        let resolved = method_target(env, selected, arguments, unknown_constants(get(env.signatures, selected)))?
        target = resolved.signature
        types = resolved.arguments
        discard require_query_reference(env, target, types)?
    } else if source.kind == NodeKind.MethodCall {
        return Result.Ok(true)
    }
    var declaration = get(env.signatures, target).symbol
    var index = 0
    while index < length(env.packs) {
        let pack = get(env.packs, index)
        // Private proof headers and their rewritten bodies are not source
        // specializations. Neither their calls nor their IDs are query evidence.
        if erased_pack(pack) && (pack.signature == target ||
            get(env.signatures, pack.signature).symbol == owner) {
            return Result.Ok(true)
        }
        if pack.signature == target {
            declaration = pack.declaration
        }
        index = index + 1
    }
    if name(source.value) != symbol(env, declaration).name {
        return Result.Ok(true)
    }
    let segment = reference_path_segment(source.value)
    let current = signature(env, target, types, node)?
    let parameters = copy_indices(current.params)
    push(parameters, current.result)
    let label = type_name(env.source, env.types, env.interfaces,
        intern(env, TypeKind.Function, -1, parameters))
    record_declaration_reference(env, owner, source, declaration, segment,
        if async_signature(env, current) {
            concat("async ", label)
        } else {
            label
        })
    Result.Ok(true)
}

// Fresh checking observes abstract templates as well as concrete instances.
// Cached executable bodies cannot supply erased source-binding evidence.
pub fn declaration_references(source std.loom.binding.Program, inputs BuildInputs) Result[List[DeclarationReference], Failure] {
    discard expanded_source(source)?
    let detached = query_source(source)?
    let env = prepare_with_inputs(detached, inputs, true)?
    discard checked_program(env, new[Bool](), new[Bool](), ints(0))?
    Result.Ok(get(env.inputs, 0).declaration_references)
}
