import std.loom.ast.Node
import std.loom.ast.NodeKind
import std.loom.binding.candidates
import std.list.new
import std.list.get
import std.list.push
import std.list.length
import std.result.Result

record Concept { symbol Int methods List[Int] associated List[Int] }
record Implementation { symbol Int capability Int ty Int methods List[Int] associated List[Int] state Int }

fn type_parameters(env Environment, owner Int) List[Node] {
    let item = symbol(env, owner)
    let declaration = if item.owner >= 0 && symbol(env, item.owner).node.kind == NodeKind.Impl { item.owner } else { owner }
    group(symbol(env, declaration).node, NodeKind.TypeParameters)
}

fn prototype(env Environment, owner Int) Bool {
    let parent = symbol(env, owner).owner
    parent >= 0 && symbol(env, parent).node.kind == NodeKind.Concept
}
fn concept_named(env Environment, owner Int, node Node, path Text) Result[Int, Failure] {
    let here = symbol(env, owner)
    let options = candidates(env.source, here.file, here.test_only, path)
    var selected = -1
    var index = 0
    while index < length(options) {
        let candidate = get(options, index)
        if symbol(env, candidate).node.kind == NodeKind.Concept {
            if selected >= 0 { return Result.Err(failure(env, owner, node, "ambiguous concept; qualify its name")) }
            selected = candidate
        }
        index = index + 1
    }
    Result.Ok(selected)
}
fn required_concept(env Environment, owner Int, node Node) Result[Int, Failure] {
    if length(node.children) != 0 {
        return Result.Err(failure(env, owner, node, "concepts do not yet take type arguments"))
    }
    let selected = concept_named(env, owner, node, node.value)?
    if selected < 0 { return Result.Err(failure(env, owner, node, "expected an accessible concept")) }
    Result.Ok(selected)
}
fn requirements(env Environment, owner Int, arguments List[Int]) Result[List[Requirement], Failure] {
    let obligations = new[Requirement]()
    if prototype(env, owner) {
        push(obligations, Requirement { ty = get(arguments, 0) capability = symbol(env, owner).owner })
        return Result.Ok(obligations)
    }
    let parameters = type_parameters(env, owner)
    var index = 0
    while index < length(parameters) {
        let parameter = get(parameters, index)
        var bound = 0
        while bound < length(parameter.children) {
            let node = child(parameter, bound)
            let capability = required_concept(env, owner, node)?
            var previous = 0
            while previous < length(obligations) {
                let existing = get(obligations, previous)
                if existing.ty == get(arguments, index) && existing.capability == capability {
                    return Result.Err(failure(env, owner, node, "duplicate concept requirement"))
                }
                previous = previous + 1
            }
            push(obligations, Requirement { ty = get(arguments, index) capability = capability })
            bound = bound + 1
        }
        index = index + 1
    }
    let item = symbol(env, owner)
    if (item.node.kind == NodeKind.Function || item.node.kind == NodeKind.AssociatedType) &&
        item.owner >= 0 && symbol(env, item.owner).node.kind == NodeKind.Impl {
        let header = get(env.implementations, implementation_owner(env, item.owner))
        push(obligations, Requirement { ty = self_type(env, owner, arguments, 0)? capability = header.capability })
    }
    Result.Ok(obligations)
}
fn owned_signatures(env Environment, owner Int) List[Int] {
    let methods = new[Int]()
    var index = 0
    while index < length(env.signatures) {
        if symbol(env, get(env.signatures, index).symbol).owner == owner { push(methods, index) }
        index = index + 1
    }
    methods
}
fn concept_index(env Environment, capability Int) Int {
    var index = 0
    while index < length(env.concepts) {
        if get(env.concepts, index).symbol == capability { return index }
        index = index + 1
    }
    -1
}
fn conformances(env Environment) Result[Bool, Failure] {
    var owner = 0
    while owner < length(env.source.symbols) {
        let item = symbol(env, owner)
        if item.node.kind == NodeKind.Concept {
            let methods = owned_signatures(env, owner)
            var index = 0
            while index < length(methods) {
                let method = get(env.signatures, get(methods, index))
                if length(method.params) == 0 || get(method.params, 0) != get(abstract_arguments(env, 1), 0) {
                    return Result.Err(failure(env, method.symbol, symbol(env, method.symbol).node, "a concept method's first parameter must have type Self"))
                }
                index = index + 1
            }
            let position = concept_index(env, owner)
            set(env.concepts, position, Concept { symbol = owner methods = methods associated = get(env.concepts, position).associated })
        }
        owner = owner + 1
    }
    owner = 0
    while owner < length(env.source.symbols) {
        let item = symbol(env, owner)
        if item.node.kind == NodeKind.Impl {
            let position = implementation_owner(env, owner)
            let header = get(env.implementations, position)
            let capability = header.capability
            let ty = header.ty
            let expected = get(env.concepts, concept_index(env, capability)).methods
            let actual = owned_signatures(env, owner)
            let methods = new[Int]()
            var supplied = 0
            var index = 0
            while index < length(expected) {
                let requirement = signature_in(env, get(expected, index), ints(ty), item.node, owner)?
                var previous = 0
                while previous < index {
                    let other = signature_in(env, get(expected, previous), ints(ty), item.node, owner)?
                    if symbol(env, requirement.symbol).name == symbol(env, other.symbol).name && same(requirement.params, other.params) {
                        return Result.Err(failure(env, owner, item.node, "concept method signatures overlap for this implementation"))
                    }
                    previous = previous + 1
                }
                var found = -1
                var candidate = 0
                while candidate < length(actual) {
                    let method = get(env.signatures, get(actual, candidate))
                    if symbol(env, method.symbol).name == symbol(env, requirement.symbol).name &&
                        same(method.params, requirement.params) && method.result == requirement.result {
                        found = get(actual, candidate)
                    }
                    candidate = candidate + 1
                }
                if found >= 0 {
                    supplied = supplied + 1
                } else {
                    if !has(symbol(env, requirement.symbol).node, NodeKind.Block) {
                        return Result.Err(failure(env, owner, item.node, "implementation is missing a required concept method"))
                    }
                    found = get(expected, index)
                }
                push(methods, found)
                index = index + 1
            }
            if supplied != length(actual) {
                return Result.Err(failure(env, owner, item.node, "implementation method signature does not match its concept"))
            }
            set(env.implementations, position, Implementation { symbol = owner capability = capability ty = ty methods = methods associated = header.associated state = 2 })
        }
        owner = owner + 1
    }
    Result.Ok(true)
}
fn evidence(context Context, ty Int, capability Int) Bool {
    var index = 0
    while index < length(context.signature.requirements) {
        let requirement = get(context.signature.requirements, index)
        if requirement.ty == ty && requirement.capability == capability { return true }
        index = index + 1
    }
    false
}
fn with_evidence(context Context, ty Int, capability Int) Context {
    let current = context.signature
    let obligations = new[Requirement]()
    var index = 0
    while index < length(current.requirements) { push(obligations, get(current.requirements, index))
        index = index + 1 }
    if !evidence(context, ty, capability) { push(obligations, Requirement { ty = ty capability = capability }) }
    let updated = Signature { symbol = current.symbol parameters = current.parameters params = current.params compile_time = current.compile_time result = current.result requirements = obligations }
    Context { env = context.env signature = updated arguments = context.arguments locals = context.locals
        constants = context.constants bindings = context.bindings head = context.head
        cleanups = context.cleanups cleanup_head = context.cleanup_head emit = context.emit }
}
fn implementation(context Context, ty Int, capability Int) Result[Int, Failure] {
    if !satisfies(context, ty, capability)? { return Result.Ok(-1) }
    Result.Ok(conformance(context.env, ty, capability).implementation)
}
fn satisfies(context Context, ty Int, capability Int) Result[Bool, Failure] {
    admitted(context.env, context.signature.symbol, context.signature.requirements, ty, capability)
}
fn satisfies_arguments(context Context, current Signature, arguments List[Int], node Node) Result[Bool, Failure] {
    let parent = symbol(context.env, current.symbol).owner
    if parent >= 0 && symbol(context.env, parent).node.kind == NodeKind.Impl {
        let header = get(context.env.implementations, implementation_owner(context.env, parent))
        let receiver = substitute(context.env, current.symbol, header.ty, arguments, node)?
        if evidence(context, receiver, header.capability) { return Result.Ok(true) }
    }
    var index = 0
    while index < length(current.requirements) {
        let requirement = get(current.requirements, index)
        let ty = substitute(context.env, current.symbol, requirement.ty, arguments, node)?
        if !satisfies(context, ty, requirement.capability)? { return Result.Ok(false) }
        index = index + 1
    }
    Result.Ok(true)
}
