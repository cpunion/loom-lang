import std.loom.ast.Node
import std.loom.ast.NodeKind
import std.loom.binding.candidates
import std.list.new
import std.list.get
import std.list.push
import std.list.length
import std.result.Result

record Concept { symbol Int methods List[Int] associated List[Int] bounds List[List[Int]] }
record Implementation { symbol Int capability Int ty Int methods List[Int] associated List[Int] state Int }

fn type_parameters(env Environment, owner Int) List[Node] {
    let lexical = lexical_owner(env, owner)
    if lexical != owner { return type_parameters(env, lexical) }
    let item = symbol(env, owner)
    let declaration = if item.owner >= 0 && symbol(env, item.owner).node.kind == NodeKind.Impl { item.owner } else { owner }
    let parameters = group(symbol(env, declaration).node, NodeKind.TypeParameters)
    if declaration == owner || (item.node.kind != NodeKind.AssociatedType && item.node.kind != NodeKind.Function) { return parameters }
    let joined = new[Node]()
    var index = 0
    while index < length(parameters) { push(joined, get(parameters, index))
        index = index + 1 }
    let local = group(item.node, NodeKind.TypeParameters)
    index = 0
    while index < length(local) { push(joined, get(local, index))
        index = index + 1 }
    joined
}

fn prototype(env Environment, owner Int) Bool {
    let parent = symbol(env, owner).owner
    parent >= 0 && symbol(env, parent).node.kind == NodeKind.Concept
}
fn concept_named(env Environment, owner Int, node Node, path Text) Result[Int, Failure] {
    let here = symbol(env, owner)
    let options = candidates(env.source, here.file, here.test_only, path)
    var selected = -1
    var index = 0
    while index < length(options) {
        let candidate = get(options, index)
        if symbol(env, candidate).node.kind == NodeKind.Concept {
            if selected >= 0 { return Result.Err(failure(env, owner, node, "ambiguous concept; qualify its name")) }
            selected = candidate
        }
        index = index + 1
    }
    Result.Ok(selected)
}
fn required_concept(env Environment, owner Int, node Node) Result[Int, Failure] {
    if length(node.children) != 0 {
        return Result.Err(failure(env, owner, node, "concepts do not yet take type arguments"))
    }
    let selected = concept_named(env, owner, node, node.value)?
    if selected < 0 { return Result.Err(failure(env, owner, node, "expected an accessible concept")) }
    Result.Ok(selected)
}
fn requirements(env Environment, owner Int, arguments List[Int]) Result[List[Requirement], Failure] {
    let obligations = new[Requirement]()
    if prototype(env, owner) {
        push(obligations, Requirement { ty = get(arguments, 0) capability = symbol(env, owner).owner })
    }
    let parameters = type_parameters(env, owner)
    var index = 0
    while index < length(parameters) {
        let parameter = get(parameters, index)
        let ty = get(arguments, index + parameter_offset(env, owner))
        var bound = 0
        while bound < length(parameter.children) {
            let node = child(parameter, bound)
            let capability = required_concept(env, owner, node)?
            var previous = 0
            // Duplicate declarations are errors; distinct parameters may
            // legitimately become the same type during specialization.
            while previous < bound {
                if required_concept(env, owner, child(parameter, previous))? == capability {
                    return Result.Err(failure(env, owner, node, "duplicate concept requirement"))
                }
                previous = previous + 1
            }
            if !required(obligations, ty, capability) { push(obligations, Requirement { ty = ty capability = capability }) }
            bound = bound + 1
        }
        index = index + 1
    }
    let item = symbol(env, owner)
    if (item.node.kind == NodeKind.Function || item.node.kind == NodeKind.AssociatedType) &&
        item.owner >= 0 && symbol(env, item.owner).node.kind == NodeKind.Impl {
        let header = get(env.implementations, implementation_owner(env, item.owner))
        let receiver = self_type(env, owner, arguments, 0)?
        if !required(obligations, receiver, header.capability) { push(obligations, Requirement { ty = receiver capability = header.capability }) }
        if item.node.kind == NodeKind.AssociatedType {
            let declaration = associated_declaration(env, owner)
            let offset = length(type_parameters(env, item.owner))
            discard inherit_member_requirements(env, declaration, argument_tail(arguments, offset), obligations)?
        }
        if item.node.kind == NodeKind.Function {
            let declaration = method_declaration(env, owner)
            if declaration >= 0 {
                discard inherit_member_requirements(env, declaration, argument_tail(arguments, method_parameter_prefix(env, owner)), obligations)?
            }
        }
    }
    function_requirements(env, owner, obligations)
}
fn function_requirements(env Environment, owner Int, obligations List[Requirement]) Result[List[Requirement], Failure] {
    if symbol(env, owner).node.kind != NodeKind.Function { return Result.Ok(obligations) }
    // Preserve direct member promises through specialization (S.Item -> Int),
    // but never supply them when establishing an impl or an associated binding.
    // Only the original requirements expand; recursive concepts stay finite.
    let count = length(obligations)
    var index = 0
    while index < count {
        let obligation = get(obligations, index)
        let capability = get(env.concepts, concept_index(env, obligation.capability))
        var member = 0
        while member < length(capability.associated) {
            let bounds = get(capability.bounds, member)
            if length(bounds) != 0 && length(member_parameters(env, get(capability.associated, member))) == 0 {
                let ty = associated_type(env, owner, get(capability.associated, member), obligation.ty, new[Int](), symbol(env, owner).node, 0)?
                var bound = 0
                while bound < length(bounds) {
                    let target = get(bounds, bound)
                    if !required(obligations, ty, target) { push(obligations, Requirement { ty = ty capability = target }) }
                    bound = bound + 1
                }
            }
            member = member + 1
        }
        index = index + 1
    }
    Result.Ok(obligations)
}
fn owned_signatures(env Environment, owner Int) List[Int] {
    let methods = new[Int]()
    var index = 0
    while index < length(env.signatures) {
        if symbol(env, get(env.signatures, index).symbol).owner == owner { push(methods, index) }
        index = index + 1
    }
    methods
}
fn concept_index(env Environment, capability Int) Int {
    var index = 0
    while index < length(env.concepts) {
        if get(env.concepts, index).symbol == capability { return index }
        index = index + 1
    }
    -1
}
fn conformances(env Environment) Result[Bool, Failure] {
    var owner = 0
    while owner < length(env.source.symbols) {
        let item = symbol(env, owner)
        if item.node.kind == NodeKind.Concept {
            let methods = owned_signatures(env, owner)
            var index = 0
            while index < length(methods) {
                let method = get(env.signatures, get(methods, index))
                if length(method.params) == 0 || get(method.params, 0) != get(abstract_arguments(env, 1), 0) {
                    return Result.Err(failure(env, method.symbol, symbol(env, method.symbol).node, "a concept method's first parameter must have type Self"))
                }
                index = index + 1
            }
            let position = concept_index(env, owner)
            let previous = get(env.concepts, position)
            set(env.concepts, position, Concept { symbol = owner methods = methods associated = previous.associated bounds = previous.bounds })
        }
        owner = owner + 1
    }
    owner = 0
    while owner < length(env.source.symbols) {
        let item = symbol(env, owner)
        if item.node.kind == NodeKind.Impl {
            let position = implementation_owner(env, owner)
            let header = get(env.implementations, position)
            let capability = header.capability
            let ty = header.ty
            let expected = get(env.concepts, concept_index(env, capability)).methods
            let methods = new[Int]()
            var index = 0
            while index < length(expected) {
                let declaration = get(env.signatures, get(expected, index)).symbol
                let arguments = method_instance_arguments(env, declaration, ty, length(type_parameters(env, owner)))
                let requirement = signature_in(env, get(expected, index), arguments, item.node, owner)?
                var previous = 0
                while previous < index {
                    let other_declaration = get(env.signatures, get(expected, previous)).symbol
                    if symbol(env, requirement.symbol).name == symbol(env, other_declaration).name &&
                        method_parameter_count(env, declaration) == method_parameter_count(env, other_declaration) {
                        let other = signature_in(env, get(expected, previous), arguments, item.node, owner)?
                        if same(requirement.params, other.params) {
                            return Result.Err(failure(env, owner, item.node, "concept method signatures overlap for this implementation"))
                        }
                    }
                    previous = previous + 1
                }
                push(methods, -1)
                index = index + 1
            }
            var candidate = 0
            while candidate < length(env.source.symbols) {
                let method = symbol(env, candidate)
                if method.owner == owner && method.node.kind == NodeKind.Function {
                    let matched = implementation_method(env, header, candidate, expected)?
                    if get(methods, matched.slot) >= 0 {
                        return Result.Err(failure(env, candidate, method.node, "duplicate implementation method for this concept overload"))
                    }
                    set(methods, matched.slot, register_signature(env, matched.signature)?)
                }
                candidate = candidate + 1
            }
            index = 0
            while index < length(methods) {
                if get(methods, index) < 0 {
                    let declaration = get(expected, index)
                    if !has(symbol(env, get(env.signatures, declaration).symbol).node, NodeKind.Block) {
                        return Result.Err(failure(env, owner, item.node, "implementation is missing a required concept method"))
                    }
                    set(methods, index, declaration)
                }
                index = index + 1
            }
            set(env.implementations, position, Implementation { symbol = owner capability = capability ty = ty methods = methods associated = header.associated state = 2 })
        }
        owner = owner + 1
    }
    Result.Ok(true)
}
fn evidence(context Context, ty Int, capability Int) Result[Bool, Failure] {
    if entailed(context.env, context.signature.requirements, ty, capability) { return Result.Ok(true) }
    promised(context.env, context.signature.symbol, context.signature.requirements, ty, capability)
}
fn with_evidence(context Context, ty Int, capability Int) Context {
    let current = context.signature
    let obligations = new[Requirement]()
    var index = 0
    while index < length(current.requirements) { push(obligations, get(current.requirements, index))
        index = index + 1 }
    if !entailed(context.env, context.signature.requirements, ty, capability) { push(obligations, Requirement { ty = ty capability = capability }) }
    let updated = Signature { symbol = current.symbol parameters = current.parameters params = current.params compile_time = current.compile_time result = current.result requirements = obligations }
    Context { lexical = context.lexical env = context.env signature = updated arguments = context.arguments locals = context.locals
        constants = context.constants bindings = context.bindings head = context.head
        cleanups = context.cleanups cleanup_head = context.cleanup_head loop_boundary = context.loop_boundary
        facts = context.facts fact_head = context.fact_head emit = context.emit }
}
fn implementation(context Context, ty Int, capability Int) Result[Int, Failure] {
    if !satisfies(context, ty, capability)? { return Result.Ok(-1) }
    Result.Ok(conformance(context.env, ty, capability).implementation)
}
fn satisfies(context Context, ty Int, capability Int) Result[Bool, Failure] {
    admitted(context.env, context.signature.symbol, context.signature.requirements, ty, capability)
}
fn satisfies_arguments(context Context, current Signature, arguments List[Int], node Node) Result[Bool, Failure] {
    let parent = symbol(context.env, current.symbol).owner
    if parent >= 0 && symbol(context.env, parent).node.kind == NodeKind.Impl {
        let header = get(context.env.implementations, implementation_owner(context.env, parent))
        let receiver = substitute(context.env, current.symbol, header.ty, arguments, node)?
        if entailed(context.env, context.signature.requirements, receiver, header.capability) {
            // Receiver evidence carries the impl header's prerequisites, not
            // the independent requirements of this method's local arguments.
            let declaration = method_declaration(context.env, current.symbol)
            if declaration < 0 { return Result.Ok(false) }
            let bounds = new[Requirement]()
            discard inherit_member_requirements(context.env, declaration, argument_tail(arguments, method_parameter_prefix(context.env, current.symbol)), bounds)?
            var index = 0
            while index < length(bounds) {
                let bound = get(bounds, index)
                if !satisfies(context, bound.ty, bound.capability)? { return Result.Ok(false) }
                index = index + 1
            }
            return Result.Ok(true)
        }
    }
    var index = 0
    while index < length(current.requirements) {
        let requirement = get(current.requirements, index)
        let ty = substitute(context.env, current.symbol, requirement.ty, arguments, node)?
        if !satisfies(context, ty, requirement.capability)? { return Result.Ok(false) }
        index = index + 1
    }
    Result.Ok(true)
}
