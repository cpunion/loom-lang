// Publishing a local draft transfers no runtime value and installs no monitor.
// Its outer header must be fresh and unpublished. Later raw aliases may observe
// it, but cannot mutate or publish it. Existing origin and call-footprint
// analysis accounts for aliases, captures, branches and loops.
fn draft_construction(env Environment, value Expr) Bool {
    (value.kind == ExprKind.Block && value.text == "checked list") ||
    (value.kind == ExprKind.Coerce && constrained_list(env, value.ty) &&
        !constraint_restored(env, value))
}

fn draft_input(value Expr) Expr {
    if value.kind == ExprKind.Block {
        get(get(value.children, 0).children, 0)
    } else {
        get(value.children, 0)
    }
}

fn draft_raw_use(value Expr, frame InvariantFrame, depth Int) Bool {
    if depth >= 256 {
        return true
    }
    if value.kind == ExprKind.Local && origin_shared(get(frame.locals, value.index)) {
        return true
    }
    var index = 0
    while index < length(value.children) {
        if draft_raw_use(get(value.children, index), frame, depth + 1) {
            return true
        }
        index = index + 1
    }
    index = 0
    while index < length(value.arms) {
        let body = get(value.arms, index).body
        var item = 0
        while item < length(body) {
            if draft_raw_use(get(body, item), frame, depth + 1) {
                return true
            }
            item = item + 1
        }
        index = index + 1
    }
    false
}

fn draft_place(value Expr, depth Int) Bool {
    depth < 64 && (value.kind == ExprKind.Local ||
        (value.kind == ExprKind.Field && length(value.children) == 1 &&
            draft_place(get(value.children, 0), depth + 1)))
}

fn same_draft_place(left Expr, right Expr, depth Int) Bool {
    if depth >= 64 || left.kind != right.kind || left.index != right.index {
        return false
    }
    if left.kind == ExprKind.Local {
        return true
    }
    left.kind == ExprKind.Field && length(left.children) == 1 && length(right.children) == 1 &&
    same_draft_place(get(left.children, 0), get(right.children, 0), depth + 1)
}

fn same_draft_construction(left Expr, right Expr) Bool {
    left.kind == right.kind && left.ty == right.ty && left.text == right.text &&
    left.span.start == right.span.start && left.span.end == right.span.end &&
    same_draft_place(draft_input(left), draft_input(right), 0)
}

// A matching source range alone is not an occurrence identity: generated code
// may reuse ranges. Ambiguous occurrences never inherit publication evidence.
fn draft_occurrences(env Environment, value Expr, candidate Expr, depth Int) Int {
    if depth >= 256 {
        return 2
    }
    var count = if draft_construction(env, value) && same_draft_construction(value, candidate) {
        1
    } else {
        0
    }
    if value.kind == ExprKind.Block && value.text == "checked list" {
        return count + draft_occurrences(env, draft_input(value), candidate, depth + 1)
    }
    var index = 0
    while index < length(value.children) && count < 2 {
        count = count + draft_occurrences(env, get(value.children, index), candidate, depth + 1)
        index = index + 1
    }
    index = 0
    while index < length(value.arms) && count < 2 {
        let body = get(value.arms, index).body
        var item = 0
        while item < length(body) && count < 2 {
            count = count + draft_occurrences(env, get(body, item), candidate, depth + 1)
            item = item + 1
        }
        index = index + 1
    }
    count
}

fn draft_candidates(env Environment, value Expr, candidates List[Expr], depth Int) {
    if depth >= 256 {
        return
    }
    if draft_construction(env, value) && draft_place(draft_input(value), 0) {
        push(candidates, value)
    }
    if value.kind == ExprKind.Block && value.text == "checked list" {
        draft_candidates(env, draft_input(value), candidates, depth + 1)
        return
    }
    var index = 0
    while index < length(value.children) {
        draft_candidates(env, get(value.children, index), candidates, depth + 1)
        index = index + 1
    }
    index = 0
    while index < length(value.arms) {
        let body = get(value.arms, index).body
        var item = 0
        while item < length(body) {
            draft_candidates(env, get(body, item), candidates, depth + 1)
            item = item + 1
        }
        index = index + 1
    }
}

fn unpublished_drafts(env Environment, functions List[Function], current Function) List[Expr] {
    let drafts = new[Expr]()
    let candidates = new[Expr]()
    draft_candidates(env, current.body, candidates, 0)
    var index = 0
    while index < length(candidates) {
        let candidate = get(candidates, index)
        if draft_occurrences(env, current.body, candidate, 0) == 1 &&
        unpublished_draft(env, functions, current, candidate) {
            push(drafts, candidate)
        }
        index = index + 1
    }
    drafts
}

fn established_draft(value Expr, drafts List[Expr]) Bool {
    var index = 0
    while index < length(drafts) {
        if same_draft_construction(value, get(drafts, index)) {
            return true
        }
        index = index + 1
    }
    false
}
