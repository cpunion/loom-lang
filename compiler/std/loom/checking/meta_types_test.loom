test fn type_values_flow_through_pure_functions_and_select_concrete_types() {
    discard accepted("""
        fn select(flag Bool, a type, b type) type {
            var chosen = a
            if !flag {
                chosen = b
            }
            chosen
        }
        fn identity[T](value T) T {
            value
        }
        fn main() {
            let T = comptime { select(true, Int, Bool) }
            let value T = 42
            assert identity[T](value) == 42
        }
        """)
}

test fn meta_type_identity_uses_the_ordinary_generic_path() {
    discard accepted("""
        fn identity[T](value T) T {
            value
        }
        fn main() {
            assert comptime {
                let types List[type] = [identity[type](Int), type]
                types[0] == Int && types[1] == type
            }
        }
        """)
    rejects("""
        fn main() {
            let values = [1, 2]
            discard values[type]
        }
        """)
    rejects("""
        pub fn exposed() type {
            type
        }
        fn main() {
            discard exposed()
        }
        """)
}

test fn selected_types_do_not_grant_private_construction_access() {
    let files = source_files("""
        import hidden.secret
        fn main() {
            let Selected = comptime { secret() }
            let value = Selected { value = 7 }
            discard value
        }
        """)
    push(files, source_file("hidden", """
        record Secret {
            value Int
        }
        pub fn secret() type {
            Secret
        }
        pub fn sample() Secret {
            Secret {
                value = 7
            }
        }
        """, false))
    assert match checked(files) {
        Result.Err(failed) => failed.diagnostic.message == "cannot construct a private type from another package"
        Result.Ok(_) => false
    }
    set(files, 0, source_file("app", """
        import hidden.secret
        import hidden.sample
        fn main() {
            let Selected = comptime { secret() }
            let Selected { value = item } = sample()
            discard item
        }
        """, false))
    assert match checked(files) {
        Result.Err(failed) => failed.diagnostic.message == "cannot inspect a private record from another package"
        Result.Ok(_) => false
    }
}

test fn type_values_never_supply_runtime_tags_or_skip_required_proofs() {
    rejects("""
        fn guarded()
        requires Int == Int
        {
        }
        fn main() {
            guarded()
        }
        """)
    rejects("""
        fn pick(value Bool) type {
            if value { Int } else { Text }
        }
        fn main() {
            discard pick(true)
        }
        """)
    rejects("""
        record Wrapped {
            ty type
        }
        fn main() {
            let value = Wrapped { ty = Int }
            discard value
        }
        """)
    rejects("""
        fn hidden() Int
        ensures result == 2
        {
            let T = comptime { Int }
            let value T = 1
            value
        }
        """)
    rejects("""
        fn hidden(flag Bool) {
            let T = comptime { if flag { Int } else { Text } }
            discard T
        }
        """)
}

test fn selected_patterns_keep_exact_type_arguments_and_abstract_requirements() {
    rejects("""
        record Box[T] {
            value T
        }
        fn main() {
            let Selected = comptime { Box[Int] }
            let value = Box { value = "not an Int" }
            match value {
                Selected { value = value } => {
                    discard value
                }
            }
        }
        """)
    rejects("""
        enum Choice[T] {
            Some(T)
            None
        }
        fn main() {
            let Selected = comptime { Choice[Int] }
            let value = Choice.Some("not an Int")
            match value {
                Selected.Some(value) => {
                    discard value
                }
                Selected.None => {}
            }
        }
        """)
    rejects("""
        fn missing_requirement[T]() T {
            T { value = 1 }
        }
        """)
}

test fn selected_type_values_support_structural_iteration_without_sample_values() {
    discard accepted("""
        record Fields[T] {
            ready Bool
            value T
        }
        fn of[T]() type {
            T
        }
        fn main() {
            let Selected = comptime { of[Fields[Int]]() }
            let actions = comptime map name, Field in Selected {
                assert name == "ready" || name == "value"
                fn(value Field) Field {
                    value
                }
            }
            assert actions.0(true) && actions.1(42) == 42
            let Tuple = comptime { of[(Text, Bool)]() }
            var count = 0
            comptime for index, Field in Tuple {
                assert comptime { of[Field]() == Field }
                assert index == count
                count = count + 1
            }
            assert count == 2
            {
                let Tuple = (3, 4)
                var total = 0
                comptime for value in Tuple {
                    total = total + value
                }
                assert total == 7
            }
        }
        """)
}

test fn selected_type_iteration_preserves_visibility_and_rejects_non_shapes() {
    let files = source_files("""
        import hidden.secret
        fn main() {
            let Selected = comptime { secret() }
            comptime for Field in Selected {
                discard Field
            }
        }
        """)
    push(files, source_file("hidden", """
        record Secret {
            value Int
        }
        pub fn secret() type {
            Secret
        }
        """, false))
    assert match checked(files) {
        Result.Err(failed) => failed.diagnostic.message == "cannot inspect a private type from another package"
        Result.Ok(_) => false
    }
    rejects("""
        fn main() {
            let Selected = comptime { Int }
            comptime for Field in Selected {
                discard Field
            }
        }
        """)
    rejects("""
        fn main() {
            let Selected = comptime { List[Int] }
            discard comptime map Field in Selected {
                Field
            }
        }
        """)
    rejects("""
        fn missing[T]() {
            let Selected = comptime { T }
            comptime for Field in Selected {
                discard Field
            }
        }
        """)
}

test fn selected_type_iteration_keeps_current_field_types_after_cache_restoration() {
    let source = """
        record Fields {
            value Int
            ready Bool
        }
        pub fn answer() Int {
            let Selected = comptime { Fields }
            let actions = comptime map Field in Selected {
                fn(value Field) Field {
                    value
                }
            }
            assert actions.1(true)
            actions.0(42)
        }
        """
    let initial = definition_cache()
    assert match cached_source(initial, source) {
        Result.Ok(_) => true
        Result.Err(failed) => {
            discard write_error(failed.diagnostic.message)
            false
        }
    }
    let cache = restored_definition_cache(initial)
    let moved = concat("fn unrelated(value List[Bool]) List[Bool] { value }\n", source)
    assert match cached_source(cache, moved) {
        Result.Ok(_) => true
        Result.Err(failed) => {
            discard write_error(failed.diagnostic.message)
            false
        }
    }
    discard restored_definition_cache(cache)
    let changed = std.text.join(std.text.split(moved, "value Int"), "value Bool")
    assert match cached_source(cache, changed) {
        Result.Err(_) => true
        Result.Ok(_) => false
    }
}
