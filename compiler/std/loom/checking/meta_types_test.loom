test fn type_values_flow_through_pure_functions_and_select_concrete_types() {
    discard accepted("""
        fn select(flag Bool, a type, b type) type {
            var chosen = a
            if !flag {
                chosen = b
            }
            chosen
        }
        fn identity[T](value T) T {
            value
        }
        fn main() {
            let T = comptime { select(true, Int, Bool) }
            let value T = 42
            assert identity[T](value) == 42
        }
        """)
}

test fn meta_type_identity_uses_the_ordinary_generic_path() {
    discard accepted("""
        fn identity[T](value T) T {
            value
        }
        fn main() {
            assert comptime {
                let types List[type] = [identity[type](Int), type]
                types[0] == Int && types[1] == type
            }
        }
        """)
    rejects("""
        fn main() {
            let values = [1, 2]
            discard values[type]
        }
        """)
    rejects("""
        pub fn exposed() type {
            type
        }
        fn main() {
            discard exposed()
        }
        """)
}

test fn selected_types_do_not_grant_private_construction_access() {
    let files = source_files("""
        import hidden.secret
        fn main() {
            let Selected = comptime { secret() }
            let value = Selected { value = 7 }
            discard value
        }
        """)
    push(files, source_file("hidden", """
        record Secret {
            value Int
        }
        pub fn secret() type {
            Secret
        }
        pub fn sample() Secret {
            Secret {
                value = 7
            }
        }
        """, false))
    assert match checked(files) {
        Result.Err(failed) => failed.diagnostic.message == "cannot construct a private type from another package"
        Result.Ok(_) => false
    }
    set(files, 0, source_file("app", """
        import hidden.secret
        import hidden.sample
        fn main() {
            let Selected = comptime { secret() }
            let Selected { value = item } = sample()
            discard item
        }
        """, false))
    assert match checked(files) {
        Result.Err(failed) => failed.diagnostic.message == "cannot inspect a private record from another package"
        Result.Ok(_) => false
    }
}

test fn type_values_never_supply_runtime_tags_or_skip_required_proofs() {
    rejects("""
        fn guarded()
        requires Int == Int
        {
        }
        fn main() {
            guarded()
        }
        """)
    rejects("""
        fn pick(value Bool) type {
            if value { Int } else { Text }
        }
        fn main() {
            discard pick(true)
        }
        """)
    rejects("""
        record Wrapped {
            ty type
        }
        fn main() {
            let value = Wrapped { ty = Int }
            discard value
        }
        """)
    rejects("""
        fn hidden() Int
        ensures result == 2
        {
            let T = comptime { Int }
            let value T = 1
            value
        }
        """)
    rejects("""
        fn hidden(flag Bool) {
            let T = comptime { if flag { Int } else { Text } }
            discard T
        }
        """)
}

test fn selected_patterns_keep_exact_type_arguments_and_abstract_requirements() {
    rejects("""
        record Box[T] {
            value T
        }
        fn main() {
            let Selected = comptime { Box[Int] }
            let value = Box { value = "not an Int" }
            match value {
                Selected { value = value } => {
                    discard value
                }
            }
        }
        """)
    rejects("""
        enum Choice[T] {
            Some(T)
            None
        }
        fn main() {
            let Selected = comptime { Choice[Int] }
            let value = Choice.Some("not an Int")
            match value {
                Selected.Some(value) => {
                    discard value
                }
                Selected.None => {}
            }
        }
        """)
    rejects("""
        fn missing_requirement[T]() T {
            T { value = 1 }
        }
        """)
}
