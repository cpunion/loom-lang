import std.loom.project.SourceFile
import std.loom.project.Project
import std.loom.project.ModuleInstance
import std.loom.project.Package
import std.loom.project.PackageImport
import std.loom.ast.Node
import std.loom.binding.Failure
import std.loom.binding.bind
import std.loom.parser.parse
import std.loom.checking.check
import std.loom.typed.Program
import std.loom.typed.ExprKind
import std.list.new
import std.list.push
import std.list.get
import std.list.length
import std.result.Result
import std.io.write_error

record TestFile { package Text path Text text Text tree Node test_only Bool trusted_std Bool }

fn source_file(package Text, text Text, trusted Bool) TestFile {
    let tree = match std.loom.parser.parse(text) {
        Result.Ok(tree) => tree
        Result.Err(failed) => { discard write_error(failed.message)
            discard write_error(text)
            assert false
            source_file(package, "", trusted).tree }
    }
    TestFile { package = package path = package text = text tree = tree test_only = false trusted_std = trusted }
}
fn source_files(text Text) List[TestFile] {
    let files = new[TestFile]()
    push(files, source_file("app", text, false))
    files
}
fn fixture_project(inputs List[TestFile]) Project {
    let modules = new[ModuleInstance]()
    push(modules, ModuleInstance { name = "app" source = "memory:app" })
    let packages = new[Package]()
    push(packages, Package { instance = 0 relative = "" imports = new[PackageImport]() })
    let names = new[Text]()
    push(names, "app")
    let files = new[SourceFile]()
    var index = 0
    while index < length(inputs) {
        let input = get(inputs, index)
        var package = 0
        while package < length(names) && get(names, package) != input.package { package = package + 1 }
        if package == length(names) {
            let split = first_dot(input.package)
            let name = slice(input.package, 0, split)
            let relative = if split < std.text.length(input.package) { slice(input.package, split + 1, std.text.length(input.package)) } else { "" }
            var instance = 0
            while instance < length(modules) && get(modules, instance).name != name { instance = instance + 1 }
            if instance == length(modules) { push(modules, ModuleInstance { name = name source = concat("memory:", name) }) }
            push(packages, Package { instance = instance relative = relative imports = new[PackageImport]() })
            push(names, input.package)
        }
        push(files, SourceFile { package = package path = input.path text = input.text tree = input.tree
            test_only = input.test_only trusted_std = input.trusted_std })
        index = index + 1
    }
    index = 0
    while index < length(files) {
        let file = get(files, index)
        let imports = get(packages, file.package).imports
        var item = 0
        while item < length(file.tree.children) {
            let node = get(file.tree.children, item)
            if node.kind == NodeKind.Import {
                let spelling = std.loom.project.package(node.value)
                var target = 0
                while target < length(names) && get(names, target) != spelling { target = target + 1 }
                var edge = 0
                while edge < length(imports) && get(imports, edge).spelling != spelling { edge = edge + 1 }
                if target < length(names) && edge == length(imports) { push(imports, PackageImport { spelling = spelling target = target }) }
            }
            item = item + 1
        }
        index = index + 1
    }
    Project { files = files modules = modules packages = packages root = 0 }
}
fn checked(files List[TestFile]) Result[std.loom.typed.Program, Failure] { check(bind(fixture_project(files), false)?) }
fn accepted(text Text) std.loom.typed.Program {
    match checked(source_files(text)) {
        Result.Ok(program) => program
        Result.Err(failed) => { show_failure(fixture_project(source_files(text)), failed)
            assert false
            accepted("") }
    }
}
fn rejects(text Text) {
    match checked(source_files(text)) {
        Result.Err(_) => {}
        Result.Ok(_) => { discard write_error(text)
            assert false }
    }
}

test fn generic_specializations_are_shared_and_overloads_remain_distinct() {
    let program = accepted("fn identity[T](x T) T { x }\nfn pick(x Int) Int { x }\nfn pick(x Bool) Bool { x }\nfn main() {\nassert identity(2) == identity[Int](2)\nassert identity(true)\nassert pick(2) == 2\nassert pick(true)\n}")
    assert length(program.functions) == 5
    assert program.entry == 0
    assert length(get(program.functions, 0).arguments) == 0
    assert get(program.functions, 1).symbol == get(program.functions, 2).symbol
    assert get(get(program.functions, 1).arguments, 0) != get(get(program.functions, 2).arguments, 0)
    assert get(program.functions, 3).symbol != get(program.functions, 4).symbol
    rejects("pub fn hidden[T](x T) T { x + 1 }")
    rejects("fn same(x Int) Int { x }\nfn same(x Int) Bool { true }")
    rejects("fn recurse[T](x T) { recurse(ListBox { value = x }) }\nrecord ListBox[T] { value T }\nfn main() { recurse(1) }")
}

test fn intrinsic_abi_is_checked_before_generic_substitution() {
    let files = source_files("import std.text.length\nfn main() { discard length(\"abc\") }")
    push(files, source_file("std.text", "intrinsic fn text_len(value Text) Int\npub fn length(value Text) Int { text_len(value) }", true))
    match checked(files) {
        Result.Ok(program) => {
            assert length(program.functions) == 3
            let primitive = get(program.functions, 2)
            assert primitive.runtime_name == "text_len"
            assert get(primitive.body.children, 0).kind == ExprKind.Intrinsic
        }
        Result.Err(_) => { assert false }
    }
    let invalid = new[TestFile]()
    push(invalid, source_file("std.list", "intrinsic fn list_get[T](values List[T], index Int) Int\n", true))
    match checked(invalid) {
        Result.Err(failure) => { assert failure.diagnostic.message == "intrinsic declaration does not match its runtime signature" }
        Result.Ok(_) => { assert false }
    }
    let unknown = new[TestFile]()
    push(unknown, source_file("std.list", "intrinsic fn unknown() Int\n", true))
    match checked(unknown) {
        Result.Err(failure) => { assert failure.diagnostic.message == "unknown private runtime intrinsic" }
        Result.Ok(_) => { assert false }
    }
}

test fn required_postconditions_have_no_runtime_fallback() {
    let program = accepted("pub fn identity(x Int) Int ensures result == x { x }\npub fn next(x Int) Int ensures result > x { x + 1 }\npub fn abs(x Int) Int ensures result >= 0 { if x >= 0 { x } else { -x } }")
    assert length(program.functions) == 3
    let identity = get(program.functions, 0)
    assert identity.result_local >= 0
    assert get(identity.locals, identity.result_local).name == "result"
    assert length(identity.postconditions) == 1
    rejects("fn wrong(x Int) Int ensures result > x { x }")
    rejects("fn unknown(x Int) Int ensures result >= 0 { x * x }")
    discard accepted("fn hidden(x Int) Int { x }\nfn forwarded(x Int) Int ensures result == x { hidden(x) }")
    discard accepted("fn allowed() Bool { true }\nfn valid() requires allowed() {}")
    rejects("fn f(result Int) Int { result }")
}
