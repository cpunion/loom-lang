// Concrete bodies have their own private, detached basis. They are never read
// back from the mutable Program returned by the public checking API.
record BodyTarget {
    symbol Int
    arity Int
    implementation_arity Int
    prototype Int
    arguments List[Int]
    constants List[BodyConstant]
}

record BodyConstant {
    value StaticValue
    stored List[Value]
}

record BodyBasis {
    definitions DefinitionBasis
    types List[Type]
    targets List[BodyTarget]
    functions List[Function]
    interfaces List[BodyInterface]
}

record BodyReuse {
    prior List[BodyBasis]
    current List[DefinitionEntry]
    allowed List[Bool]
    symbols List[Int]
    types List[Int]
    eligibility List[Int]
    targets List[Int]
    functions Map[Int, List[Int]]
    changed Map[Text, Bool]
    hits List[Int]
}

fn no_body_reuse() BodyReuse {
    BodyReuse {
        prior = new[BodyBasis]()
        current = new[DefinitionEntry]()
        allowed = new[Bool]()
        symbols = new[Int]()
        types = new[Int]()
        eligibility = new[Int]()
        targets = new[Int]()
        functions = std.map.new[Int, List[Int]]()
        changed = std.map.new[Text, Bool]()
        hits = ints(0)
    }
}

fn copy_indices(values List[Int]) List[Int] {
    let copied = new[Int](length(values))
    var index = 0
    while index < length(values) {
        push(copied, get(values, index))
        index = index + 1
    }
    copied
}

fn body_reuse(cache DefinitionCache, basis DefinitionBasis, allowed List[Bool]) BodyReuse {
    if length(definition_state(cache).bodies) == 0 || length(allowed) == 0 {
        return no_body_reuse()
    }
    let prior = get(definition_state(cache).bodies, 0)
    let changed = std.map.new[Text, Bool]()
    let matches = definition_matches(prior.definitions, basis, changed)
    let symbols = new[Int]()
    var index = 0
    while index < length(prior.definitions.entries) {
        push(symbols, -1)
        index = index + 1
    }
    index = 0
    while index < length(matches) {
        if get(matches, index) >= 0 {
            set(symbols, get(matches, index), index)
        }
        index = index + 1
    }
    // Nominal declarations are unique by package/name. The shared definition
    // context already requires their complete syntax and import environment.
    let nominals = std.map.new[Text, Int]()
    index = 0
    while index < length(basis.entries) {
        let entry = get(basis.entries, index)
        if nominal_data(entry.node.kind) || entry.node.kind == NodeKind.Concept {
            discard std.map.insert(nominals, definition_bucket(entry), index)
        }
        index = index + 1
    }
    index = 0
    while index < length(prior.definitions.entries) {
        let entry = get(prior.definitions.entries, index)
        if nominal_data(entry.node.kind) || entry.node.kind == NodeKind.Concept {
            match std.map.get(nominals, definition_bucket(entry)) {
                Option.Some(value) => {
                    set(symbols, index, value)
                }
                Option.None => {
                }
            }
        }
        index = index + 1
    }
    let types = new[Int]()
    index = 0
    while index < length(prior.types) {
        push(types, -1)
        index = index + 1
    }
    let functions = std.map.new[Int, List[Int]]()
    let eligibility = new[Int]()
    let targets = new[Int]()
    index = 0
    while index < length(prior.functions) {
        push(eligibility, 0)
        push(targets, -1)
        let owner = get(prior.targets, index).symbol
        if owner >= 0 && owner < length(symbols) && get(symbols, owner) >= 0 {
            let mapped = get(symbols, owner)
            match std.map.get(functions, mapped) {
                Option.Some(instances) => {
                    push(instances, index)
                }
                Option.None => {
                    discard std.map.insert(functions, mapped, ints(index))
                }
            }
        }
        index = index + 1
    }
    BodyReuse {
        prior = definition_state(cache).bodies
        current = basis.entries
        allowed = allowed
        symbols = symbols
        types = types
        eligibility = eligibility
        targets = targets
        functions = functions
        changed = changed
        hits = definition_state(cache).body_hits
    }
}

fn body_symbol(reuse BodyReuse, previous Int) Int {
    if previous < 0 || previous >= length(reuse.symbols) {
        -1
    } else {
        get(reuse.symbols, previous)
    }
}

fn body_type_supported(reuse BodyReuse, ty Int, seen List[Int]) Bool {
    body_type_shape_supported(reuse, ty, seen, false)
}

fn body_type_shape_supported(reuse BodyReuse, ty Int, seen List[Int], stored Bool) Bool {
    if resource_seen(seen, ty) {
        return true
    }
    push(seen, ty)
    let shape = get(get(reuse.prior, 0).types, ty)
    let kind = shape.kind
    if kind == TypeKind.Parameter || kind == TypeKind.Associated || (kind == TypeKind.Meta && !stored) ||
    kind == TypeKind.Frame {
        return false
    }
    if (kind == TypeKind.Record || kind == TypeKind.Enum || kind == TypeKind.Refined) && body_symbol(reuse, shape.symbol) < 0 {
        return false
    }
    if kind == TypeKind.Dyn && body_symbol(reuse, get(get(reuse.prior, 0).interfaces, shape.symbol).symbol) < 0 {
        return false
    }
    var index = 0
    while index < length(shape.arguments) {
        if !body_type_shape_supported(reuse, get(shape.arguments, index), seen, stored) {
            return false
        }
        index = index + 1
    }
    index = 0
    while index < length(shape.fields) {
        if !body_type_shape_supported(reuse, get(shape.fields, index).ty, seen, stored) {
            return false
        }
        index = index + 1
    }
    index = 0
    while index < length(shape.variants) {
        let fields = get(shape.variants, index).fields
        var field = 0
        while field < length(fields) {
            if !body_type_shape_supported(reuse, get(fields, field), seen, stored) {
                return false
            }
            field = field + 1
        }
        index = index + 1
    }
    true
}

fn body_source_supported(reuse BodyReuse, previous Int) Bool {
    let owner = body_symbol(reuse, previous)
    if owner < 0 {
        return false
    }
    // Include elaboration-introduced edges (indexing, implicit constructors,
    // function references), not only names visible in the original AST.
    if owner >= length(reuse.allowed) || !get(reuse.allowed, owner) {
        return false
    }
    match std.map.get(reuse.changed, get(reuse.current, owner).node.value) {
        Option.Some(_) => {
            return false
        }
        Option.None => {
        }
    }
    true
}

fn body_target_supported(reuse BodyReuse, target Int, seen List[Int]) Bool {
    let targets = get(reuse.prior, 0).targets
    if target < 0 || target >= length(targets) {
        return false
    }
    let instance = get(targets, target)
    body_instance_supported(reuse, instance, seen)
}

fn body_instance_supported(reuse BodyReuse, instance BodyTarget, seen List[Int]) Bool {
    if !body_source_supported(reuse, instance.symbol) {
        return false
    }
    var index = 0
    while index < length(instance.arguments) {
        if !body_type_supported(reuse, get(instance.arguments, index), seen) {
            return false
        }
        index = index + 1
    }
    body_constants_supported(reuse, instance.constants, seen)
}

fn body_expression_supported(reuse BodyReuse, value Expr, span Span, seen List[Int]) Bool {
    let kind = value.kind
    if kind == ExprKind.Deferred ||
    kind == ExprKind.FrameNew || kind == ExprKind.FrameStore ||
    kind == ExprKind.TypeValue {
        return false
    }
    if !body_type_supported(reuse, value.ty, seen) || value.span.start < span.start || value.span.end > span.end {
        return false
    }
    if (kind == ExprKind.Call || kind == ExprKind.TaskCall || kind == ExprKind.FunctionRef) && !body_target_supported(reuse, value.index, seen) {
        return false
    }
    if kind == ExprKind.DynCall && !body_instance_supported(reuse, body_dynamic_slot(reuse, value), seen) {
        return false
    }
    var index = 0
    while index < length(value.children) {
        if !body_expression_supported(reuse, get(value.children, index), span, seen) {
            return false
        }
        index = index + 1
    }
    index = 0
    while index < length(value.arms) {
        let arm = get(value.arms, index)
        var member = 0
        while member < length(arm.body) {
            if !body_expression_supported(reuse, get(arm.body, member), span, seen) {
                return false
            }
            member = member + 1
        }
        index = index + 1
    }
    true
}

fn body_supported(reuse BodyReuse, target BodyTarget, value Function) Bool {
    if target.prototype >= 0 && body_symbol(reuse, target.prototype) < 0 {
        return false
    }
    let seen = new[Int]()
    if !body_type_supported(reuse, value.result, seen) {
        return false
    }
    var index = 0
    while index < length(value.arguments) {
        if !body_type_supported(reuse, get(value.arguments, index), seen) {
            return false
        }
        index = index + 1
    }
    index = 0
    while index < length(value.locals) {
        if !body_type_supported(reuse, get(value.locals, index).ty, seen) {
            return false
        }
        index = index + 1
    }
    index = 0
    while index < length(value.preconditions) {
        let owner = body_contract_source(reuse, target, NodeKind.Requires, index)
        if !body_expression_supported(reuse, get(value.preconditions, index), get(get(reuse.prior, 0).definitions.entries, owner).span, seen) {
            return false
        }
        index = index + 1
    }
    index = 0
    while index < length(value.postconditions) {
        let owner = body_contract_source(reuse, target, NodeKind.Ensures, index)
        if !body_expression_supported(reuse, get(value.postconditions, index), get(get(reuse.prior, 0).definitions.entries, owner).span, seen) {
            return false
        }
        index = index + 1
    }
    body_expression_supported(reuse, value.body, value.span, seen)
}

// Eligibility depends only on this check's fixed source correspondence, not on
// which specialization is looking for a match. Inspect each saved body once.
fn body_eligible(reuse BodyReuse, candidate Int) Bool {
    let known = get(reuse.eligibility, candidate)
    if known != 0 {
        return known > 0
    }
    let prior = get(reuse.prior, 0)
    let target = get(prior.targets, candidate)
    let supported = body_supported(reuse, target, get(prior.functions, candidate)) &&
    body_constants_supported(reuse, target.constants, new[Int]())
    set(reuse.eligibility, candidate, if supported {
            1
        } else {
            -1
        })
    supported
}

fn body_type(env Environment, reuse BodyReuse, ty Int) Result[Int, Failure] {
    if get(reuse.types, ty) >= 0 {
        return Result.Ok(get(reuse.types, ty))
    }
    let shape = get(get(reuse.prior, 0).types, ty)
    let arguments = new[Int]()
    var index = 0
    while index < length(shape.arguments) {
        push(arguments, body_type(env, reuse, get(shape.arguments, index))?)
        index = index + 1
    }
    let mapped = if shape.kind == TypeKind.Record || shape.kind == TypeKind.Enum || shape.kind == TypeKind.Refined {
        data_type(env, body_symbol(reuse, shape.symbol), arguments, 0)?
    } else if shape.kind == TypeKind.Dyn {
        let capability = body_symbol(reuse, get(get(reuse.prior, 0).interfaces, shape.symbol).symbol)
        let dynamic = dynamic_instance(env, capability, capability, arguments, symbol(env, capability).node)?
        discard fill_interface(env, dynamic)?
        dynamic
    } else {
        intern(env, shape.kind, -1, arguments)
    }
    set(reuse.types, ty, mapped)
    Result.Ok(mapped)
}

fn body_types(env Environment, reuse BodyReuse, types List[Int]) Result[List[Int], Failure] {
    let mapped = new[Int](length(types))
    var index = 0
    while index < length(types) {
        push(mapped, body_type(env, reuse, get(types, index))?)
        index = index + 1
    }
    Result.Ok(mapped)
}

fn body_target(env Environment, reuse BodyReuse, target Int) Result[Int, Failure] {
    let mapped = get(reuse.targets, target)
    if mapped >= 0 {
        return Result.Ok(mapped)
    }
    let current = body_schedule_target(env, reuse, target)?
    set(reuse.targets, target, current)
    Result.Ok(current)
}

// A saved concrete callee is scheduled/validated once in the current environment;
// all replayed call sites then use that environment's stable function ID.
fn body_schedule_target(env Environment, reuse BodyReuse, target Int) Result[Int, Failure] {
    let prior = get(get(reuse.prior, 0).targets, target)
    let owner = impl_member_instance(env, body_symbol(reuse, prior.symbol), prior.implementation_arity)?
    if prior.arity >= 0 {
        let selected = selected_pack_signature(env, owner, prior.arity)?
        discard check_pack_arity(env, selected)?
        return schedule(env, selected, body_types(env, reuse, prior.arguments)?, body_constants(env, reuse, prior.constants, owner)?, symbol(env, owner).node)
    }
    var index = 0
    while index < length(env.signatures) {
        if get(env.signatures, index).symbol == owner {
            return schedule(env, index, body_types(env, reuse, prior.arguments)?, body_constants(env, reuse, prior.constants, owner)?, symbol(env, owner).node)
        }
        index = index + 1
    }
    Result.Err(failure(env, owner, symbol(env, owner).node, "cached call has no current signature"))
}

fn body_expression(env Environment, reuse BodyReuse, value Expr, owner Int, offset Int) Result[Expr, Failure] {
    let children = body_expressions(env, reuse, value.children, owner, offset)?
    let arms = new[Arm](length(value.arms))
    var index = 0
    while index < length(value.arms) {
        let arm = get(value.arms, index)
        push(arms, Arm {
                variant = arm.variant
                bindings = copy_indices(arm.bindings)
                whole = arm.whole
                body = body_expressions(env, reuse, arm.body, owner, offset)?
            })
        index = index + 1
    }
    let declaration = symbol(env, owner).node
    // Generated nodes all point to their generating block. Its extent can
    // change while this one expanded definition remains structurally identical.
    let span = if std.loom.ast.has(declaration, NodeKind.ExpansionId) {
        declaration.span
    } else {
        Span {
            start = value.span.start + offset
            end = value.span.end + offset
        }
    }
    let file = get(env.source.files, symbol(env, owner).file)
    if value.kind == ExprKind.DynBox || value.kind == ExprKind.DynCall {
        return body_dynamic_expression(env, reuse, value, owner, span, children)
    }
    Result.Ok(Expr {
            kind = value.kind
            ty = body_type(env, reuse, value.ty)?
            span = span
            text = if (value.kind == ExprKind.Assert || value.kind == ExprKind.TaskCall ||
                value.kind == ExprKind.IndirectCall) && value.text != "" {
                render(file.path, file.text, Diagnostic {
                        span = span
                        message = if value.kind == ExprKind.Assert {
                            "assertion failed"
                        } else {
                            "task created here"
                        }
                    })
            } else {
                value.text
            }
            index = if value.kind == ExprKind.Call || value.kind == ExprKind.TaskCall || value.kind == ExprKind.FunctionRef {
                body_target(env, reuse, value.index)?
            } else {
                value.index
            }
            children = children
            arms = arms
            falls = value.falls
        })
}

fn body_expressions(env Environment, reuse BodyReuse, values List[Expr], owner Int, offset Int) Result[List[Expr], Failure] {
    let mapped = new[Expr](length(values))
    var index = 0
    while index < length(values) {
        push(mapped, body_expression(env, reuse, get(values, index), owner, offset)?)
        index = index + 1
    }
    Result.Ok(mapped)
}

fn reuse_body(env Environment, reuse BodyReuse, instance Instance) Result[Option[Function], Failure] {
    if length(reuse.prior) == 0 || instance.signature < 0 {
        return Result.Ok(Option.None)
    }
    let concrete_owner = get(env.signatures, instance.signature).symbol
    let pack = pack_instance(env, instance.signature)
    let source = if pack >= 0 {
        get(env.packs, pack).source
    } else {
        concrete_owner
    }
    let owner = impl_member_source(env, source)
    let arity = if pack >= 0 {
        get(env.packs, pack).arity
    } else {
        -1
    }
    let implementation_arity = impl_member_arity(env, source)
    if owner >= length(reuse.allowed) || !get(reuse.allowed, owner) {
        return Result.Ok(Option.None)
    }
    let prior = get(reuse.prior, 0)
    let current = get(reuse.current, owner)
    let candidates = match std.map.get(reuse.functions, owner) {
        Option.Some(values) => values
        Option.None => {
            return Result.Ok(Option.None)
        }
    }
    var index = 0
    while index < length(candidates) {
        let candidate = get(candidates, index)
        let value = get(prior.functions, candidate)
        let target = get(prior.targets, candidate)
        if target.arity == arity && target.implementation_arity == implementation_arity && body_symbol(reuse, target.symbol) == owner &&
        (std.loom.ast.has(current.node, NodeKind.ExpansionId) ||
            (current.text != "" && current.text == get(prior.definitions.entries, target.symbol).text)) && body_eligible(reuse, candidate) &&
        same(body_types(env, reuse, value.arguments)?, instance.arguments) &&
        same_constants(body_constants(env, reuse, target.constants, owner)?, instance.constants) {
            if arity >= 0 {
                discard check_pack_arity(env, instance.signature)?
            }
            let offset = current.span.start - value.span.start
            let locals = new[Local](length(value.locals))
            var local = 0
            while local < length(value.locals) {
                let item = get(value.locals, local)
                push(locals, Local {
                        name = item.name
                        ty = body_type(env, reuse, item.ty)?
                        mutable = item.mutable
                        is_scoped = item.is_scoped
                    })
                local = local + 1
            }
            let mapped = Function {
                is_async = value.is_async
                symbol = concrete_owner
                arguments = copy_indices(instance.arguments)
                params = body_types(env, reuse, value.params)?
                result = body_type(env, reuse, value.result)?
                locals = locals
                preconditions = body_contracts(env, reuse, target, value.preconditions, NodeKind.Requires)?
                postconditions = body_contracts(env, reuse, target, value.postconditions, NodeKind.Ensures)?
                result_local = value.result_local
                body = body_expression(env, reuse, value.body, concrete_owner, offset)?
                runtime_name = value.runtime_name
                span = current.span
            }
            set(reuse.hits, 0, get(reuse.hits, 0) + 1)
            return Result.Ok(Option.Some(mapped))
        }
        index = index + 1
    }
    Result.Ok(Option.None)
}
