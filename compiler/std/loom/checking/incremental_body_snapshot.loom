// Resident caches detach mutable lists before returning a checked program.
// One-shot hosts serialize and retire borrowed bodies before returning instead.
// Nominal type definitions will be rebuilt in the next environment; snapshots
// retain only the shape needed to validate and rekey a cached concrete body.
fn body_copy_expressions(values List[Expr]) List[Expr] {
    let copied = new[Expr](length(values))
    var index = 0
    while index < length(values) {
        push(copied, body_copy_expression(get(values, index)))
        index = index + 1
    }
    copied
}

fn body_copy_expression(value Expr) Expr {
    let arms = new[Arm](length(value.arms))
    var index = 0
    while index < length(value.arms) {
        let arm = get(value.arms, index)
        push(arms, Arm {
                variant = arm.variant
                bindings = copy_indices(arm.bindings)
                whole = arm.whole
                body = body_copy_expressions(arm.body)
            })
        index = index + 1
    }
    Expr {
        kind = value.kind
        ty = value.ty
        span = value.span
        text = value.text
        index = value.index
        children = body_copy_expressions(value.children)
        arms = arms
        falls = value.falls
    }
}

fn body_copy_function(value Function) Function {
    let locals = new[Local](length(value.locals))
    var index = 0
    while index < length(value.locals) {
        push(locals, get(value.locals, index))
        index = index + 1
    }
    Function {
        is_async = value.is_async
        symbol = value.symbol
        arguments = copy_indices(value.arguments)
        params = copy_indices(value.params)
        result = value.result
        locals = locals
        preconditions = body_copy_expressions(value.preconditions)
        postconditions = body_copy_expressions(value.postconditions)
        result_local = value.result_local
        body = body_copy_expression(value.body)
        runtime_name = value.runtime_name
        span = value.span
    }
}

fn save_bodies(cache DefinitionCache, basis DefinitionBasis, env Environment, program std.loom.typed.Program, detach Bool) {
    let types = new[Type](length(program.types))
    var index = 0
    while index < length(program.types) {
        let ty = get(program.types, index)
        let fields = new[Field](length(ty.fields))
        var field = 0
        while field < length(ty.fields) {
            push(fields, get(ty.fields, field))
            field = field + 1
        }
        let variants = new[Variant](length(ty.variants))
        var variant = 0
        while variant < length(ty.variants) {
            let member = get(ty.variants, variant)
            push(variants, Variant {
                    name = member.name
                    fields = copy_indices(member.fields)
                })
            variant = variant + 1
        }
        push(types, Type {
                kind = ty.kind
                symbol = ty.symbol
                arguments = copy_indices(ty.arguments)
                pack_widths = copy_indices(ty.pack_widths)
                fields = fields
                variants = variants
                constraint = new[Expr]()
            })
        index = index + 1
    }
    let functions = new[Function](length(program.functions))
    let targets = new[BodyTarget](length(program.functions))
    // Checking and rekeying succeeded before entering this private snapshot
    // builder. Retire the previous concrete IR before cloning its replacement;
    // no caller can observe or mutate these lists while the snapshot is built.
    let saved = BodyBasis {
        definitions = basis
        types = types
        targets = targets
        functions = functions
        interfaces = body_copy_interfaces(env)
    }
    if length(definition_state(cache).bodies) == 0 {
        push(definition_state(cache).bodies, saved)
    } else {
        set(definition_state(cache).bodies, 0, saved)
    }
    index = 0
    while index < length(program.functions) {
        let value = get(program.functions, index)
        let instance = get(env.pending, index)
        let pack = if instance.signature >= 0 {
            pack_instance(env, instance.signature)
        } else {
            -1
        }
        let prototype = if pack >= 0 {
            get(env.packs, pack).declaration
        } else {
            if instance.signature >= 0 {
                method_declaration(env, value.symbol)
            } else {
                -1
            }
        }
        let source = if pack >= 0 {
            get(env.packs, pack).source
        } else {
            value.symbol
        }
        push(functions, if detach {
                body_copy_function(value)
            } else {
                value
            })
        push(targets, BodyTarget {
                symbol = if pack >= 0 {
                    impl_member_source(env, source)
                } else if instance.signature < 0 {
                    -1
                } else {
                    impl_member_source(env, source)
                }
                widths = if pack >= 0 {
                    copy_indices(get(env.packs, pack).widths)
                } else {
                    new[Int]()
                }
                implementation_arity = if instance.signature < 0 {
                    -1
                } else {
                    impl_member_arity(env, source)
                }
                prototype = if prototype == value.symbol || (pack >= 0 && prototype == get(env.packs, pack).source) {
                    -1
                } else {
                    prototype
                }
                arguments = copy_indices(instance.arguments)
                constants = body_copy_constants(env, instance.constants)
            })
        index = index + 1
    }
}
