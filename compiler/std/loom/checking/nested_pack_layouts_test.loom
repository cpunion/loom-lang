fn nested_layout_header() Text {
    concat(composed_bounds_header(), """
        record Pair[A, B] {
            first A
            second B
        }
        impl[A, B] Value for Pair[A, B] {
            fn value(self Pair[A, B]) Int {
                1
            }
        }
        """)
}

test fn nested_pack_layouts_support_universal_constructor_bounds_and_forwarding() {
    // No concrete caller supplies a width or layout to these family proofs.
    discard accepted(concat(nested_layout_header(), """
        fn direct[As..., Bs...](values (Pair[As, (Bs...)]...)) Int
        ensures result >= 0 {
            var total = 0
            comptime for item in values {
                total = total + item.value()
            }
            total
        }
        fn forwarded[As..., Bs...](values (Pair[As, (Bs...)]...)) Int
        ensures result >= 0 {
            bounded(values...)
        }
        fn transitive[As..., Bs...](values (Pair[As, (Bs...)]...)) Int
        ensures result >= 0 {
            direct(values) + forwarded(values)
        }
        fn callbacks[As..., Bs...](values (Pair[As, fn(Bs...) Int]...)) Int
        ensures result >= 0 {
            bounded(values...)
        }
        fn fixed[As..., Bs...](values (Pair[Bool, (Bs...)], Pair[As, Bool]...)) Int
        ensures result >= 0 {
            var total = 0
            comptime for item in values {
                total = total + item.value()
            }
            total
        }
        """))
}

test fn nested_pack_layouts_do_not_inherit_element_bounds_or_concrete_results() {
    rejects(concat(nested_layout_header(), """
        fn wrong[As..., Bs... Value](values (Pair[As, (Bs...)]...)) Bool
        ensures result {
            var same = true
            comptime for item in values {
                same = same && item.value() == item.value()
            }
            same
        }
        """))
    rejects(concat(composed_bounds_header(), """
        record Bounded[T] {
            value T
        }
        impl[T Value] Value for Bounded[T] {
            fn value(self Bounded[T]) Int {
                1
            }
        }
        fn wrong[As... Value](values (Bounded[(As...)], As...)) Int
        ensures result >= 0 {
            bounded(values...)
        }
        """))
}

test fn nested_pack_layouts_preserve_unknown_shared_effects() {
    let source = concat(composed_bounds_header(), """
        import std.list.push
        import std.list.length
        record Pair[A, B] {
            first A
            second B
            log List[Int]
        }
        impl[A, B] Value for Pair[A, B] {
            fn value(self Pair[A, B]) Int {
                push(self.log, 1)
                0
            }
        }
        fn wrong[As..., Bs...](log List[Int], values (Pair[As, (Bs...)]...)) Int
        ensures length(log) == old(length(log)) {
            bounded(values...)
        }
        """)
    list_length_contract(std.text.join(std.text.split(source,
                "ensures length(log) == old(length(log))"), "ensures result >= 0"), true)
    list_length_contract(source, false)
}

fn structural_layout_header() Text {
    concat(composed_bounds_header(), """
        record Pair[A, B] {
            first A
            second B
        }
        impl[A, B Value] Value for Pair[A, B] {
            fn value(self Self) Int {
                self.second.value()
            }
        }
        impl[Ts... Value] Value for (Ts...) {
            fn value(self Self) Int {
                var total = 0
                comptime for item in self {
                    total = total + item.value()
                }
                total
            }
        }
        """)
}

test fn nested_pack_layouts_prove_structural_implementation_prerequisites() {
    discard accepted(concat(structural_layout_header(), """
        concept Other {}
        impl Value for dyn Other {
            fn value(self Self) Int { 0 }
        }
        fn direct[As..., Bs... Value](values (Pair[As, (Bs...)]...)) Int
        ensures result >= 0 {
            var total = 0
            comptime for item in values {
                total = total + item.value()
            }
            total
        }
        fn forwarded[As..., Bs... Value](values (Pair[As, (Bs...)]...)) Int
        ensures result >= 0 {
            bounded(values...)
        }
        fn transitive[As..., Bs... Value](values (Pair[As, (Bs...)]...)) Int
        ensures result >= 0 {
            direct(values) + forwarded(values)
        }
        """))
}

test fn nested_pack_layouts_reject_missing_independent_or_cyclic_bounds() {
    rejects(concat(structural_layout_header(), """
        fn missing[As... Value, Bs...](values (Pair[As, (Bs...)]...)) Int
        ensures result >= 0 {
            bounded(values...)
        }
        """))
    rejects(concat(structural_layout_header(), """
        fn raw[As..., Bs... Value](values (Pair[As, (Bs...)], As...)) Int
        ensures result >= 0 {
            bounded(values...)
        }
        """))
    rejects(concat(composed_bounds_header(), """
        concept Left {}
        concept Right {}
        impl[T Right] Left for T {}
        impl[T Left] Right for T {}
        record Box[T Left] {
            value T
        }
        impl[T Left] Value for Box[T] {
            fn value(self Self) Int { 0 }
        }
        fn cyclic[As..., Bs...](values (Box[(Bs...)], As...)) Int
        ensures result >= 0 {
            bounded(values...)
        }
        """))
}

test fn nested_pack_layouts_match_functions_nominal_groups_and_repeated_words() {
    discard accepted(concat(structural_layout_header(), """
        impl[Ts...] Value for fn(Ts...) Int {
            fn value(self Self) Int { 1 }
        }
        record Groups[As..., Bs...] {
            left (As...)
            right (Bs...)
        }
        impl[Xs... Value, Ys... Value] Value for Groups[(Xs...)..., Ys...] {
            fn value(self Self) Int { 1 }
        }
        fn callback[As..., Bs...](values (Pair[As, fn(Bs...) Int]...)) Int
        ensures result >= 0 {
            bounded(values...)
        }
        fn grouped[As..., Bs... Value, Cs... Value](values (Pair[As, (Groups[(Bs...)..., Cs...],)]...)) Int
        ensures result >= 0 {
            bounded(values...)
        }
        """))
    let repeated = concat(composed_bounds_header(), """
        concept Aligned {}
        impl[Ts...] Aligned for ((Ts...), (Ts...)) {}
        record Box[T Aligned] {
            value T
        }
        impl[T Aligned] Value for Box[T] {
            fn value(self Self) Int { 1 }
        }
        fn repeated[Bs...](values (Box[((Bs...), (Bs...))],)) Int
        ensures result >= 0 {
            bounded(values...)
        }
        """)
    discard accepted(repeated)
    rejects(std.text.join(std.text.split(std.text.join(std.text.split(repeated,
                        "repeated[Bs...]"), "repeated[As..., Bs...]"),
                "values (Box[((Bs...), (Bs...))],)"), "values (Box[((As...), (Bs...))],)"))
}

test fn structural_layout_conformance_is_not_receiver_equality_or_a_pure_effect() {
    rejects(concat(structural_layout_header(), """
        fn wrong[As..., Bs... Value](values (Pair[As, (Bs...)]...)) Bool
        ensures result {
            var same = true
            comptime for item in values {
                same = same && item.value() == item.value()
            }
            same
        }
        """))
    list_length_contract(concat(structural_layout_header(), """
        import std.list.length
        fn wrong[As..., Bs... Value](log List[Int], values (Pair[As, (Bs...)]...)) Int
        ensures length(log) == old(length(log)) {
            bounded(values...)
        }
        """), false)
}
