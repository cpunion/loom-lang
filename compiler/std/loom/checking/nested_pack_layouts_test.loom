fn nested_layout_header() Text {
    concat(composed_bounds_header(), """
        record Pair[A, B] {
            first A
            second B
        }
        impl[A, B] Value for Pair[A, B] {
            fn value(self Pair[A, B]) Int {
                1
            }
        }
        """)
}

test fn nested_pack_layouts_support_universal_constructor_bounds_and_forwarding() {
    // No concrete caller supplies a width or layout to these family proofs.
    discard accepted(concat(nested_layout_header(), """
        fn direct[As..., Bs...](values (Pair[As, (Bs...)]...)) Int
        ensures result >= 0 {
            var total = 0
            comptime for item in values {
                total = total + item.value()
            }
            total
        }
        fn forwarded[As..., Bs...](values (Pair[As, (Bs...)]...)) Int
        ensures result >= 0 {
            bounded(values...)
        }
        fn transitive[As..., Bs...](values (Pair[As, (Bs...)]...)) Int
        ensures result >= 0 {
            direct(values) + forwarded(values)
        }
        fn callbacks[As..., Bs...](values (Pair[As, fn(Bs...) Int]...)) Int
        ensures result >= 0 {
            bounded(values...)
        }
        fn fixed[As..., Bs...](values (Pair[Bool, (Bs...)], Pair[As, Bool]...)) Int
        ensures result >= 0 {
            var total = 0
            comptime for item in values {
                total = total + item.value()
            }
            total
        }
        """))
}

test fn nested_pack_layouts_do_not_inherit_element_bounds_or_concrete_results() {
    rejects(concat(nested_layout_header(), """
        fn wrong[As..., Bs... Value](values (Pair[As, (Bs...)]...)) Bool
        ensures result {
            var same = true
            comptime for item in values {
                same = same && item.value() == item.value()
            }
            same
        }
        """))
    rejects(concat(composed_bounds_header(), """
        record Bounded[T] {
            value T
        }
        impl[T Value] Value for Bounded[T] {
            fn value(self Bounded[T]) Int {
                1
            }
        }
        fn wrong[As... Value](values (Bounded[(As...)], As...)) Int
        ensures result >= 0 {
            bounded(values...)
        }
        """))
}

test fn nested_pack_layouts_preserve_unknown_shared_effects() {
    let source = concat(composed_bounds_header(), """
        import std.list.push
        import std.list.length
        record Pair[A, B] {
            first A
            second B
            log List[Int]
        }
        impl[A, B] Value for Pair[A, B] {
            fn value(self Pair[A, B]) Int {
                push(self.log, 1)
                0
            }
        }
        fn wrong[As..., Bs...](log List[Int], values (Pair[As, (Bs...)]...)) Int
        ensures length(log) == old(length(log)) {
            bounded(values...)
        }
        """)
    list_length_contract(std.text.join(std.text.split(source,
                "ensures length(log) == old(length(log))"), "ensures result >= 0"), true)
    list_length_contract(source, false)
}

fn structural_layout_header() Text {
    concat(composed_bounds_header(), """
        record Pair[A, B] {
            first A
            second B
        }
        impl[A, B Value] Value for Pair[A, B] {
            fn value(self Self) Int {
                self.second.value()
            }
        }
        impl[Ts... Value] Value for (Ts...) {
            fn value(self Self) Int {
                var total = 0
                comptime for item in self {
                    total = total + item.value()
                }
                total
            }
        }
        """)
}

test fn nested_pack_layouts_prove_structural_implementation_prerequisites() {
    discard accepted(concat(structural_layout_header(), """
        concept Other {}
        impl Value for dyn Other {
            fn value(self Self) Int { 0 }
        }
        fn direct[As..., Bs... Value](values (Pair[As, (Bs...)]...)) Int
        ensures result >= 0 {
            var total = 0
            comptime for item in values {
                total = total + item.value()
            }
            total
        }
        fn forwarded[As..., Bs... Value](values (Pair[As, (Bs...)]...)) Int
        ensures result >= 0 {
            bounded(values...)
        }
        fn transitive[As..., Bs... Value](values (Pair[As, (Bs...)]...)) Int
        ensures result >= 0 {
            direct(values) + forwarded(values)
        }
        """))
}

test fn nested_pack_layouts_reject_missing_independent_or_cyclic_bounds() {
    rejects(concat(structural_layout_header(), """
        fn missing[As... Value, Bs...](values (Pair[As, (Bs...)]...)) Int
        ensures result >= 0 {
            bounded(values...)
        }
        """))
    rejects(concat(structural_layout_header(), """
        fn raw[As..., Bs... Value](values (Pair[As, (Bs...)], As...)) Int
        ensures result >= 0 {
            bounded(values...)
        }
        """))
    rejects(concat(composed_bounds_header(), """
        concept Left {}
        concept Right {}
        impl[T Right] Left for T {}
        impl[T Left] Right for T {}
        record Box[T Left] {
            value T
        }
        impl[T Left] Value for Box[T] {
            fn value(self Self) Int { 0 }
        }
        fn cyclic[As..., Bs...](values (Box[(Bs...)], As...)) Int
        ensures result >= 0 {
            bounded(values...)
        }
        """))
}

test fn nested_pack_layouts_match_functions_nominal_groups_and_repeated_words() {
    discard accepted(concat(structural_layout_header(), """
        impl[Ts...] Value for fn(Ts...) Int {
            fn value(self Self) Int { 1 }
        }
        record Groups[As..., Bs...] {
            left (As...)
            right (Bs...)
        }
        impl[Xs... Value, Ys... Value] Value for Groups[(Xs...)..., Ys...] {
            fn value(self Self) Int { 1 }
        }
        fn callback[As..., Bs...](values (Pair[As, fn(Bs...) Int]...)) Int
        ensures result >= 0 {
            bounded(values...)
        }
        fn grouped[As..., Bs... Value, Cs... Value](values (Pair[As, (Groups[(Bs...)..., Cs...],)]...)) Int
        ensures result >= 0 {
            bounded(values...)
        }
        """))
    let repeated = concat(composed_bounds_header(), """
        concept Aligned {}
        impl[Ts...] Aligned for ((Ts...), (Ts...)) {}
        record Box[T Aligned] {
            value T
        }
        impl[T Aligned] Value for Box[T] {
            fn value(self Self) Int { 1 }
        }
        fn repeated[Bs...](values (Box[((Bs...), (Bs...))],)) Int
        ensures result >= 0 {
            bounded(values...)
        }
        """)
    discard accepted(repeated)
    rejects(std.text.join(std.text.split(std.text.join(std.text.split(repeated,
                        "repeated[Bs...]"), "repeated[As..., Bs...]"),
                "values (Box[((Bs...), (Bs...))],)"), "values (Box[((As...), (Bs...))],)"))
}

test fn structural_layout_conformance_is_not_receiver_equality_or_a_pure_effect() {
    rejects(concat(structural_layout_header(), """
        fn wrong[As..., Bs... Value](values (Pair[As, (Bs...)]...)) Bool
        ensures result {
            var same = true
            comptime for item in values {
                same = same && item.value() == item.value()
            }
            same
        }
        """))
    list_length_contract(concat(structural_layout_header(), """
        import std.list.length
        fn wrong[As..., Bs... Value](log List[Int], values (Pair[As, (Bs...)]...)) Int
        ensures length(log) == old(length(log)) {
            bounded(values...)
        }
        """), false)
}

test fn dependent_pack_layouts_derive_only_whole_pattern_capabilities() {
    discard accepted(concat(structural_layout_header(), """
        fn observe[T Value](value T) Int
        ensures result >= 0 { value.value() }
        fn direct[As... Value, Bs... Value](values (Pair[As, (As, Bs...)]...)) Int
        ensures result >= 0 {
            var total = 0
            comptime for item in values { total = total + item.value() }
            total
        }
        fn forwarded[As... Value, Bs... Value](values (Pair[As, (As, Bs...)]...)) Int
        ensures result >= 0 { bounded(values...) }
        fn helpers[As... Value, Bs... Value](values (Pair[As, (As, Bs...)]...)) Int
        ensures result >= 0 {
            var total = 0
            comptime for item in values { total = total + observe(item) }
            total
        }
        fn transitive[As... Value, Bs... Value](values (Pair[As, (As, Bs...)]...)) Int
        ensures result >= 0 { direct(values) + forwarded(values) + helpers(values) }
        """))
    rejects(concat(structural_layout_header(), """
        fn missing[As..., Bs... Value](values (Pair[As, (As, Bs...)]...)) Int
        ensures result >= 0 { bounded(values...) }
        """))
}

test fn dependent_pack_layouts_do_not_hide_ambiguity_or_invalid_nested_data() {
    rejects(concat(structural_layout_header(), """
        concept Alternative { fn value(self Self) Int ensures result >= 0 }
        impl[A, B] Alternative for Pair[A, B] { fn value(self Self) Int { 1 } }
        fn ambiguous[As... Value, Bs... Value](values (Pair[As, (As, Bs...)]...)) Int
        ensures result >= 0 {
            var total = 0
            comptime for item in values { total = total + item.value() }
            total
        }
        """))
    let invalid = concat(structural_layout_header(), """
        record Bounded[Bounded Value] { value Bounded }
        concept Marked { fn marker(self Self) Int ensures result >= 0 }
        impl[T] Marked for T { fn marker(self T) Int { 0 } }
        fn check[As..., Bs...](values ((Bounded[As], Bs...)...)) Int
        ensures result >= 0 {
            var total = 0
            comptime for item in values { total = total + item.marker() }
            total
        }
        """)
    rejects(invalid)
    discard accepted(std.text.join(std.text.split(invalid, "check[As..., Bs...]"), "check[As... Value, Bs...]"))
    rejects(concat(structural_layout_header(), """
        fn same[T Value](first T, second T) Int
        ensures result >= 0 { first.value() + second.value() }
        fn wrong[As... Value, Bs... Value](values (Pair[As, (As, Bs...)]...)) Int
        ensures result >= 0 {
            var total = 0
            comptime for first in values {
                comptime for second in values { total = total + same(first, second) }
            }
            total
        }
        """))
}

test fn symbolic_words_cannot_supply_one_fixed_type_parameter() {
    let cases = [
        ("(Ts...)", "(T,)", "((Bs...),)"),
        ("fn(Ts...) Int", "fn(T) Int", "(fn(Bs...) Int,)"),
    ]
    var index = 0
    while index < length(cases) {
        let sample = get(cases, index)
        let template = concat(composed_bounds_header(), """
            impl[Ts...] Value for Layout {
                fn value(self Self) Int {
                    1
                }
            }
            fn symbolic[Bs...](values Input) Int
            ensures result >= 0 {
                bounded(values...)
            }
            """)
        let source = std.text.join(std.text.split(std.text.join(std.text.split(template,
                        "Layout"), sample.0), "Input"), sample.2)
        let cache = definition_cache()
        assert match cached_source(cache, source) {
            Result.Ok(_) => true
            Result.Err(_) => false
        }
        let restored = restored_definition_cache(cache)
        let fixed = std.text.join(std.text.split(std.text.join(std.text.split(source,
                        "impl[Ts...]"), "impl[T]"), sample.0), sample.1)
        rejects(fixed)
        assert match cached_source(restored, fixed) {
            Result.Err(_) => true
            Result.Ok(_) => false
        }
        index = index + 1
    }
}
