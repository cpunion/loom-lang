test fn resource_list_arguments_borrow_but_cannot_transfer_or_mutate() {
    resource_accept(concat(resource_header(), """
        fn inspect(values List[Handle]) Int {
            values[0].use()
        }
        fn run() {
            scoped values = [make([0]), make([1])]
            let callback = inspect
            assert callback(values) == 7
        }
        """))
    resource_reject(concat(resource_header(), """
        fn escape(values List[Handle]) Handle {
            values[0]
        }
        """))
    resource_reject(concat(resource_header(), """
        fn run() {
            scoped values = [make([0])]
            scoped stolen = values[0]
        }
        """))
    resource_reject(concat(resource_header(), """
        fn run() {
            scoped values = [make([0])]
            values[0] = make([1])
        }
        """))
    resource_reject(concat(resource_header(), """
        fn run() {
            scoped values = [make([0])]
            push(values, make([1]))
        }
        """))
    resource_reject(concat(resource_header(), """
        fn run() {
            scoped values = [make([0])]
            values[0].dispose()
        }
        """))
    resource_accept(concat(resource_header(), """
        async fn inspect(values List[Handle]) Int {
            values[0].use()
        }
        async fn run() {
            scoped values = [make([0])]
            assert inspect(values).await == 7
        }
        """))
}

test fn fresh_resources_must_be_scoped_before_direct_or_indirect_borrowing() {
    resource_reject(concat(resource_header(), """
        fn inspect(value Handle) {
        }
        fn run() {
            inspect(make([0]))
        }
        """))
    resource_reject(concat(resource_header(), """
        fn inspect(value Handle) {
        }
        fn run() {
            let callback = inspect
            callback(make([0]))
        }
        """))
    resource_reject(concat(resource_header(), """
        fn inspect(value Handle) {
            let escaped = fn() Int {
                value.use()
            }
            assert escaped() == 7
        }
        """))
}
