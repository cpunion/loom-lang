fn outcome_checked(body Text, valid Bool) {
    let files = source_files("import std.task.run\nasync fn main() { run().await }")
    let header = """
        record Fault {
            message Text
        }
        enum Outcome[T] {
            Completed(T)
            Faulted(Fault)
            Cancelled
        }
        async intrinsic fn task_outcome[T](task Task[T]) Outcome[T]
        intrinsic fn task_cancel[T](task Task[T]) Outcome[T]
        intrinsic fn task_ready_result[T](task Task[T]) T
        intrinsic fn task_ready_outcome[T](task Task[T]) Outcome[T]
        intrinsic fn task_ready_case[T](task Task[T]) (Int, Task[T])
        intrinsic fn task_ready_payload[T, P](task Task[T], variant Int) P
        async fn item() Int {
            7
        }
        async fn empty() {
        }
        async fn nested() Task[Int] {
            item()
        }
        async fn classified() Outcome[Int] {
            Outcome.Completed(7)
        }
        async fn nested_case() Outcome[Task[Int]] {
            Outcome.Completed(item())
        }
        pub async fn run() {
        """
    push(files, source_file("std.task", concat(concat(header, body), "\n}"), true))
    match checked(files) {
        Result.Ok(_) => {
            assert valid
        }
        Result.Err(failed) => {
            if valid {
                discard write_error(failed.diagnostic.message)
            }
            assert !valid
        }
    }
}

test fn enum_case_inspection_preserves_one_shot_and_typed_payload_obligations() {
    outcome_checked("""
        let variant, retained = task_ready_case(classified())
        assert variant == 0
        assert task_ready_payload[Outcome[Int], Int](retained, variant) == 7
        """, true)
    outcome_checked("""
        let original = classified()
        let variant, retained = task_ready_case(original)
        discard variant
        discard task_ready_payload[Outcome[Int], Int](retained, 0)
        discard original.await
        """, false)
    outcome_checked("discard task_ready_case(classified())", false)
    outcome_checked("discard task_ready_case(item())", false)
    outcome_checked("discard task_ready_payload[Outcome[Int], Text](classified(), 0)", false)
    outcome_checked("""
        let child = task_ready_payload[Outcome[Task[Int]], Task[Int]](nested_case(), 0)
        assert child.await == 7
        """, true)
    outcome_checked("discard task_ready_payload[Outcome[Task[Int]], Task[Int]](nested_case(), 0)", false)
}

test fn task_outcomes_consume_handles_without_erasing_nested_obligations() {
    outcome_checked("discard task_outcome(item()).await\ndiscard task_cancel(empty())", true)
    outcome_checked("match task_outcome(empty()).await { Outcome.Completed(_) => {} _ => {} }", true)
    outcome_checked("match task_outcome(nested()).await { Outcome.Completed(task) => { discard task.await } _ => {} }", true)
    outcome_checked("let task = item()\ndiscard task_cancel(task)\ndiscard task.await", false)
    outcome_checked("discard task_outcome(nested()).await", false)
    outcome_checked("discard task_cancel(nested())", false)
    outcome_checked("defer { discard task_cancel(item()) }", false)
    outcome_checked("discard task_outcome[Int]", false)
    outcome_checked("discard task_ready_result(item())\ndiscard task_ready_outcome(empty())", true)
    outcome_checked("let child = task_ready_result(nested())\ndiscard child.await", true)
    outcome_checked("let task = item()\ndiscard task_ready_result(task)\ndiscard task.await", false)
    outcome_checked("discard task_ready_result(nested())", false)
    outcome_checked("discard task_ready_outcome(nested())", false)
    outcome_checked("let take = task_ready_result[Int]\ndiscard take(item())", true)
}

test fn task_outcome_intrinsics_validate_their_complete_typed_schema() {
    let files = source_files("fn main() {}")
    push(files, source_file("std.task", "enum Wrong[T] { Completed(T) Faulted(Int) Cancelled }\nasync intrinsic fn task_outcome[T](task Task[T]) Wrong[T]", true))
    match checked(files) {
        Result.Err(failed) => {
            assert failed.diagnostic.message == "task outcome requires completed(T), faulted(Text record), and cancelled variants"
        }
        _ => {
            assert false
        }
    }
}
