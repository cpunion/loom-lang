import std.loom.project.ModuleInstance
import std.loom.project.Package
import std.loom.project.PackageImport
import std.loom.project.select_source

pub record SnapshotCheck {
    checked CachedCheck
    snapshot Option[Text]
}

// A one-shot host check serializes before exposing its mutable result. Only
// persistent in-memory consumers need detached source and body IR copies.
// Retire the temporary aliases before returning, even if export is unavailable.
pub fn check_project_snapshot(project Project, tests Bool, inputs BuildInputs, cache DefinitionCache) Result[SnapshotCheck, Failure] {
    let checked = check_project_reusing(project, tests, inputs, cache, false)?
    let snapshot = match export_definition_cache(cache) {
        Result.Ok(value) => Option.Some(value)
        Result.Err(_) => Option.None
    }
    let state = definition_state(cache)
    set(cache.state, 0, DefinitionCacheState {
            basis = new[DefinitionBasis]()
            hits = state.hits
            bodies = new[BodyBasis]()
            body_hits = state.body_hits
        })
    Result.Ok(SnapshotCheck {
            checked = checked
            snapshot = snapshot
        })
}

fn raw_definition_source(basis DefinitionBasis) Project {
    if length(basis.original) != 0 {
        get(basis.original, 0)
    } else {
        basis.source
    }
}

// Syntax provenance, not semantic reuse. Both trees are private snapshots;
// equal text alone is insufficient because public callers can edit the AST.
fn reuse_source_selection(basis DefinitionBasis, cache DefinitionCache) {
    let previous = definition_state(cache).basis
    if length(previous) == 0 {
        return
    }
    let prior = get(previous, 0)
    let before = raw_definition_source(prior)
    let after = raw_definition_source(basis)
    var index = 0
    while index < length(after.files) && index < length(before.files) {
        let selection = get(prior.source_selection, index)
        if selection >= 0 {
            let old_file = get(before.files, index)
            let file = get(after.files, index)
            if old_file.text == file.text && std.loom.ast.same(old_file.tree, file.tree) {
                set(basis.source_selection, index, selection)
            }
        }
        index = index + 1
    }
}

fn cache_project(output Bytes, project Project, selection List[Int]) Result[Bool, Text] {
    cache_int(output, project.root)
    cache_int(output, length(project.modules))
    var index = 0
    while index < length(project.modules) {
        let module = get(project.modules, index)
        cache_text(output, module.name)
        cache_text(output, module.source)
        index = index + 1
    }
    cache_int(output, length(project.packages))
    index = 0
    while index < length(project.packages) {
        let package = get(project.packages, index)
        cache_int(output, package.instance)
        cache_text(output, package.relative)
        cache_int(output, length(package.imports))
        var edge = 0
        while edge < length(package.imports) {
            let imported = get(package.imports, edge)
            cache_text(output, imported.spelling)
            cache_int(output, imported.target)
            edge = edge + 1
        }
        index = index + 1
    }
    cache_int(output, length(project.files))
    index = 0
    while index < length(project.files) {
        let file = get(project.files, index)
        // Public callers can supply ASTs unlike their source text. Such checks
        // still work in memory, but cannot mint a text-backed disk snapshot.
        var mode = get(selection, index)
        if mode < 0 {
            let parsed = match std.loom.parser.parse(file.text) {
                Result.Ok(value) => value
                Result.Err(_) => {
                    return Result.Err("cache requires source-backed syntax")
                }
            }
            let complete = std.loom.ast.same(parsed, file.tree)
            if !complete && !std.loom.ast.same(std.loom.project.select_source(parsed, false), file.tree) {
                return Result.Err("cache requires source-backed syntax")
            }
            mode = if complete {
                1
            } else {
                0
            }
            set(selection, index, mode)
        }
        cache_int(output, file.package)
        cache_text(output, file.path)
        cache_text(output, file.text)
        cache_bool(output, mode == 1)
        cache_bool(output, file.test_only)
        cache_bool(output, file.trusted_std)
        index = index + 1
    }
    Result.Ok(true)
}

fn cache_read_project(reader CacheReader, selection List[Int]) Result[Project, Text] {
    let root = cache_read_int(reader)?
    let module_count = cache_read_count(reader)?
    let modules = new[ModuleInstance]()
    var index = 0
    while index < module_count {
        push(modules, ModuleInstance {
                name = cache_read_text(reader)?
                source = cache_read_text(reader)?
            })
        index = index + 1
    }
    let package_count = cache_read_count(reader)?
    let packages = new[Package]()
    index = 0
    while index < package_count {
        let instance = cache_read_int(reader)?
        if instance < 0 || instance >= module_count {
            return Result.Err("invalid cached module")
        }
        let relative = cache_read_text(reader)?
        let import_count = cache_read_count(reader)?
        let imports = new[PackageImport]()
        var edge = 0
        while edge < import_count {
            let spelling = cache_read_text(reader)?
            let target = cache_read_int(reader)?
            if target < 0 || target >= package_count {
                return Result.Err("invalid cached import")
            }
            push(imports, PackageImport {
                    spelling = spelling
                    target = target
                })
            edge = edge + 1
        }
        push(packages, Package {
                instance = instance
                relative = relative
                imports = imports
            })
        index = index + 1
    }
    if root < 0 || root >= package_count {
        return Result.Err("invalid cached root")
    }
    let file_count = cache_read_count(reader)?
    let files = new[SourceFile]()
    index = 0
    while index < file_count {
        let package = cache_read_int(reader)?
        if package < 0 || package >= package_count {
            return Result.Err("invalid cached package")
        }
        let path = cache_read_text(reader)?
        let text = cache_read_text(reader)?
        let tree = match std.loom.parser.parse(text) {
            Result.Ok(value) => value
            Result.Err(_) => {
                return Result.Err("invalid cached source")
            }
        }
        let complete = cache_read_bool(reader)?
        let selected = std.loom.project.select_source(tree, complete)
        push(selection, if complete {
                1
            } else {
                0
            })
        push(files, SourceFile {
                package = package
                path = path
                text = text
                tree = selected
                test_only = cache_read_bool(reader)?
                trusted_std = cache_read_bool(reader)?
            })
        index = index + 1
    }
    Result.Ok(Project {
            files = files
            modules = modules
            packages = packages
            root = root
        })
}

// Same-compiler host snapshots only. The private state cannot be replaced by a
// mutable returned AST/Program. Exporting it does not export a portable proof.
pub fn export_definition_cache(cache DefinitionCache) Result[Text, Text] {
    if length(definition_state(cache).bodies) != 1 {
        return Result.Err("no successful definition cache")
    }
    let saved = get(definition_state(cache).bodies, 0)
    let output = std.bytes.new()
    cache_text(output, "loom-definition-snapshot 9")
    cache_bool(output, saved.definitions.tests)
    discard cache_definition_source(output, saved.definitions)?
    cache_int(output, length(saved.definitions.reusable))
    var index = 0
    while index < length(saved.definitions.reusable) {
        cache_bool(output, get(saved.definitions.reusable, index))
        index = index + 1
    }
    cache_int(output, length(saved.types))
    index = 0
    while index < length(saved.types) {
        cache_type(output, get(saved.types, index))
        index = index + 1
    }
    cache_int(output, length(saved.functions))
    index = 0
    while index < length(saved.functions) {
        let target = get(saved.targets, index)
        cache_int(output, target.symbol)
        cache_int(output, target.arity)
        cache_int(output, target.implementation_arity)
        cache_int(output, target.prototype)
        cache_ints(output, target.arguments)
        discard cache_constants(output, target.constants)?
        discard cache_function(output, get(saved.functions, index))?
        index = index + 1
    }
    discard cache_interfaces(output, saved.interfaces)?
    Result.Ok(std.bytes.to_text(output))
}

// An explicit trust boundary for compiler hosts, NOT a proof checker. The host
// must bind the complete snapshot to this compiler's bytes and an intact local
// cache bundle. Never import untrusted/downloaded input through this API.
// Source changes after import still use the ordinary dependency invalidation.
pub fn import_trusted_definition_cache(text Text) Result[DefinitionCache, Text] {
    // Decoded IR is private and read-only. Empty lists can share storage;
    // replay and resident snapshots detach every mutable public list.
    let reader = cache_reader(text)
    if cache_read_text(reader)? != "loom-definition-snapshot 9" {
        return Result.Err("invalid definition snapshot")
    }
    let tests = cache_read_bool(reader)?
    let generated = cache_read_bool(reader)?
    let selection = new[Int]()
    let original = cache_read_project(reader, selection)?
    let project = if generated {
        cache_read_expanded(reader, original)?
    } else {
        original
    }
    let source = match bind(project, tests) {
        Result.Ok(value) => value
        Result.Err(_) => {
            return Result.Err("invalid cached bindings")
        }
    }
    let basis = definition_basis_from(source, project)
    if generated {
        push(basis.original, original)
    }
    let count = cache_read_count(reader)?
    if count != length(basis.reusable) {
        return Result.Err("invalid cached definition count")
    }
    var index = 0
    while index < length(selection) {
        set(basis.source_selection, index, get(selection, index))
        index = index + 1
    }
    index = 0
    while index < count {
        set(basis.reusable, index, cache_read_bool(reader)?)
        index = index + 1
    }
    let type_count = cache_read_count(reader)?
    let types = new[Type]()
    index = 0
    while index < type_count {
        push(types, cache_read_type(reader)?)
        index = index + 1
    }
    let function_count = cache_read_count(reader)?
    let functions = new[Function]()
    let targets = new[BodyTarget]()
    index = 0
    while index < function_count {
        push(targets, BodyTarget {
                symbol = cache_read_int(reader)?
                arity = cache_read_int(reader)?
                implementation_arity = cache_read_int(reader)?
                prototype = cache_read_int(reader)?
                arguments = cache_read_ints(reader)?
                constants = cache_read_constants(reader)?
            })
        push(functions, cache_read_function(reader)?)
        index = index + 1
    }
    let interfaces = cache_read_interfaces(reader)?
    if get(reader.cursor, 0) != std.text.length(text) {
        return Result.Err("trailing definition snapshot data")
    }
    let cache = definition_cache()
    push(definition_state(cache).basis, basis)
    push(definition_state(cache).bodies, BodyBasis {
            definitions = basis
            types = types
            targets = targets
            functions = functions
            interfaces = interfaces
        })
    Result.Ok(cache)
}
