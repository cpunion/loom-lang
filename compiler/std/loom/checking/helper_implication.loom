import std.loom.typed.Expr
import std.loom.typed.ExprKind
import std.loom.proof.implies_with_helpers
import std.list.get
import std.list.length
import std.result.Result

// Calls and lowering-introduced bindings share guarded expression expansion.
fn predicate_expansion(value Expr, depth Int) Bool {
    if depth >= 64 {
        return false
    }
    if value.kind == ExprKind.Call || value.kind == ExprKind.Block {
        return true
    }
    var index = 0
    while index < length(value.children) {
        if predicate_expansion(get(value.children, index), depth + 1) {
            return true
        }
        index = index + 1
    }
    false
}

// Optional helper preparation must not recursively depend on its own query.
// Ordinary typing and mandatory contracts still check in this private queue.
fn helper_environment(env Environment) Environment {
    Environment {
        expand_data = true
        expanding_helpers = true
        ..env
    }
}

fn prepared_implication(context Context, node Node, source Int, target Int) Result[Bool, Failure] {
    let stage = staging(predicate_scope(context.env, source)?, node)?
    let env = helper_environment(stage.env)
    let left_scope = predicate_context(env, source, stage.locals, 0, true)?
    let left = refinement_expression(left_scope, source)?
    let right = refinement_expression(predicate_context(env, target, stage.locals, 0, true)?, target)?
    Result.Ok(implies_with_helpers(prepared(left_scope)?, stage.locals, left, right, get(env.inputs, 0).build.proof_backend))
}

fn helpers_imply(context Context, node Node, source Int, target Int) Bool {
    if context.env.expanding_helpers {
        return false
    }
    match prepared_implication(context, node, source, target) {
        Result.Ok(proved) => proved
        Result.Err(_) => false
    }
}
