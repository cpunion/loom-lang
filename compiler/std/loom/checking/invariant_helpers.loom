import std.loom.typed.Type
import std.loom.typed.TypeKind
import std.loom.typed.Expr
import std.loom.typed.ExprKind
import std.loom.typed.Function
import std.loom.proof.established_predicates
import std.list.new
import std.list.get
import std.list.push
import std.list.set
import std.list.length
import std.result.Result
import std.loom.proof.verify_with_helpers
import std.loom.proof.verify_expression_with_helpers

// Constructor and propagation certificates use the same proof strategy.
// Expand input guarantees only after failure, and only when such facts exist;
// ordinary unknown scalar construction must not pay for a second solver query.
fn proves_with_input_invariants(stage Context, program std.loom.typed.Program, function Function) Bool {
    proves_with_input_invariants(stage, program, function, false)
}

fn proves_with_input_invariants(stage Context, program std.loom.typed.Program, function Function, continuation Bool) Bool {
    let backend = get(stage.env.inputs, 0).build.proof_backend
    let checked = if continuation {
        verify_expression_with_helpers(program, function, backend)
    } else {
        verify_with_helpers(program, function, backend)
    }
    match checked {
        Result.Ok(_) => {
            return true
        }
        Result.Err(_) => {
        }
    }
    let selected = new[Int]()
    let seen = new[Int]()
    var index = 0
    while index < length(function.params) {
        value_invariant_types(stage.env, get(function.params, index), seen, selected, 0)
        index = index + 1
    }
    if length(selected) == 0 {
        return false
    }
    match expanded_invariant_types(stage, function) {
        Result.Ok(types) => match if continuation {
            verify_expression_with_helpers(proof_types(program, types), function, backend)
        } else {
            verify_with_helpers(proof_types(program, types), function, backend)
        } {
            Result.Ok(_) => true
            Result.Err(_) => false
        }
        Result.Err(_) => false
    }
}

record InvariantPredicate {
    value Expr
    locals List[Local]
}

fn value_invariant_types(env Environment, ty Int, seen List[Int], selected List[Int], depth Int) {
    if ty < 6 || ty >= length(env.types) || depth >= 16 {
        return
    }
    var index = 0
    while index < length(seen) {
        if get(seen, index) == ty {
            return
        }
        index = index + 1
    }
    push(seen, ty)
    let shape = get(env.types, ty)
    if shape.kind == TypeKind.Refined {
        index = 0
        while index < length(shape.constraint) {
            if predicate_expansion(get(shape.constraint, index), 0) {
                push(selected, ty)
                index = length(shape.constraint)
            } else {
                index = index + 1
            }
        }
    } else {
        if shape.kind == TypeKind.Enum {
            var variant = 0
            while variant < length(shape.variants) {
                let fields = get(shape.variants, variant).fields
                index = 0
                while index < length(fields) {
                    value_invariant_types(env, get(fields, index), seen, selected, depth + 1)
                    index = index + 1
                }
                variant = variant + 1
            }
            return
        }
        if shape.kind == TypeKind.List {
            index = 0
            while index < length(shape.arguments) {
                value_invariant_types(env, get(shape.arguments, index), seen, selected, depth + 1)
                index = index + 1
            }
        }
        if shape.kind != TypeKind.Record && shape.kind != TypeKind.Tuple && shape.kind != TypeKind.Frame {
            return
        }
    }
    index = 0
    while index < length(shape.fields) {
        value_invariant_types(env, get(shape.fields, index).ty, seen, selected, depth + 1)
        index = index + 1
    }
}

fn expression_invariant_types(env Environment, value Expr, seen List[Int], selected List[Int], depth Int) {
    if depth >= 256 {
        return
    }
    value_invariant_types(env, value.ty, seen, selected, 0)
    var index = 0
    while index < length(value.children) {
        expression_invariant_types(env, get(value.children, index), seen, selected, depth + 1)
        index = index + 1
    }
    index = 0
    while index < length(value.arms) {
        let arm = get(value.arms, index)
        var item = 0
        while item < length(arm.body) {
            expression_invariant_types(env, get(arm.body, item), seen, selected, depth + 1)
            item = item + 1
        }
        index = index + 1
    }
}

fn expanded_invariant_parts(program std.loom.typed.Program, locals List[Local], predicate Expr, output List[Expr], depth Int) {
    if depth >= 32 || length(output) >= 256 {
        return
    }
    match established_predicates(program, locals, predicate) {
        Result.Ok(predicates) => {
            var index = 0
            while index < length(predicates) && length(output) < 256 {
                push(output, get(predicates, index))
                index = index + 1
            }
        }
        Result.Err(_) => {
            // Successful construction establishes both conjuncts. An opaque
            // Text/shared-free helper on one side must not hide proved scalar
            // facts on the other. Disjunctions cannot be split this way.
            if predicate.kind == ExprKind.Binary && predicate.text == "&&" {
                expanded_invariant_parts(program, locals, get(predicate.children, 0), output, depth + 1)
                expanded_invariant_parts(program, locals, get(predicate.children, 1), output, depth + 1)
            }
        }
    }
}

// Only a failed required proof pays for this private helper closure. Never put
// its call indices in shared type metadata or the runtime reachability queue.
fn expanded_invariant_types(context Context, function Function) Result[List[Type], Failure] {
    expanded_invariant_types(context.env, function)
}

fn expanded_invariant_types(env Environment, function Function) Result[List[Type], Failure] {
    expanded_invariant_types(env, [function])
}

fn expanded_invariant_types(env Environment, functions List[Function]) Result[List[Type], Failure] {
    let selected = new[Int]()
    let seen = new[Int]()
    var member = 0
    while member < length(functions) {
        let function = get(functions, member)
        var index = 0
        while index < length(function.params) {
            value_invariant_types(env, get(function.params, index), seen, selected, 0)
            index = index + 1
        }
        value_invariant_types(env, function.result, seen, selected, 0)
        index = 0
        while index < length(function.locals) {
            value_invariant_types(env, get(function.locals, index).ty, seen, selected, 0)
            index = index + 1
        }
        expression_invariant_types(env, function.body, seen, selected, 0)
        index = 0
        while index < length(function.postconditions) {
            expression_invariant_types(env, get(function.postconditions, index), seen, selected, 0)
            index = index + 1
        }
        member = member + 1
    }
    if length(selected) == 0 {
        return Result.Ok(env.types)
    }
    let first = get(selected, 0)
    let stage = staging(predicate_scope(env, first)?, predicate_node(env, get(env.types, first).symbol))?
    let predicates = new[InvariantPredicate]()
    var index = 0
    while index < length(selected) {
        let ty = get(selected, index)
        let locals = predicate_scope(stage.env, ty)?.locals
        let scope = predicate_context(stage.env, ty, locals, 0, true)?
        let predicate = refinement_expression(scope, ty)?
        push(predicates, InvariantPredicate {
                value = predicate
                locals = scope.locals
            })
        index = index + 1
    }
    let program = prepared_in(stage, true)?
    let types = new[Type]()
    index = 0
    while index < length(program.types) {
        push(types, get(program.types, index))
        index = index + 1
    }
    index = 0
    while index < length(selected) {
        let ty = get(selected, index)
        let shape = get(types, ty)
        let expanded = std.list.clone(shape.constraint)
        let predicate = get(predicates, index)
        expanded_invariant_parts(program, predicate.locals, predicate.value, expanded, 0)
        set(types, ty, Type {
                kind = shape.kind
                symbol = shape.symbol
                arguments = shape.arguments
                pack_widths = shape.pack_widths
                fields = shape.fields
                variants = shape.variants
                constraint = expanded
            })
        index = index + 1
    }
    Result.Ok(types)
}

fn proof_types(program std.loom.typed.Program, types List[Type]) std.loom.typed.Program {
    std.loom.typed.Program {
        types = types
        functions = program.functions
        entry = program.entry
        tests = program.tests
        test_names = program.test_names
        exports = program.exports
        interfaces = program.interfaces
        witnesses = program.witnesses
    }
}
