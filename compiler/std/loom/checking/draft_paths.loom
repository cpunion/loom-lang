record DraftCleanup {
    id Int
    body Expr
    active Bool
}

record DraftAllocation {
    local Int
    origin InputOrigin
}

record DraftRoot {
    local Int
    origin InputOrigin
    allocations List[DraftAllocation]
}

record DraftPublication {
    reads InvariantReads
    observations InvariantReads
    frame InvariantFrame
    candidate Expr
    // 1: private builder; 2: published.
    phase List[Int]
    cleanups List[DraftCleanup]
    permissions List[InvariantPermission]
}

fn draft_definitions(value Expr, local Int, definitions List[Expr], depth Int) Bool {
    if depth >= 256 || length(definitions) >= 256 {
        return false
    }
    if value.kind == ExprKind.Let && value.index == local {
        push(definitions, value)
    }
    if value.kind == ExprKind.Block && value.text == "checked list" {
        return draft_definitions(draft_input(value), local, definitions, depth + 1)
    }
    var index = 0
    while index < length(value.children) {
        if !draft_definitions(get(value.children, index), local, definitions, depth + 1) {
            return false
        }
        index = index + 1
    }
    index = 0
    while index < length(value.arms) {
        let body = get(value.arms, index).body
        var item = 0
        while item < length(body) {
            if !draft_definitions(get(body, item), local, definitions, depth + 1) {
                return false
            }
            item = item + 1
        }
        index = index + 1
    }
    true
}

// Registrations can be nested in compiler-emitted scoped initialization blocks.
// A conditional cleanup cannot retire an outer registration on another path.
fn draft_registrations(scope DraftPublication, value Expr, definite Bool, depth Int) {
    if depth >= 256 {
        set(scope.reads.valid, 0, false)
        return
    }
    if value.kind == ExprKind.Defer && length(value.children) == 1 {
        var index = 0
        while index < length(scope.cleanups) {
            let previous = get(scope.cleanups, index)
            if previous.id == value.index {
                set(scope.cleanups, index, DraftCleanup {
                        id = value.index
                        body = get(value.children, 0)
                        active = true
                    })
                return
            }
            index = index + 1
        }
        push(scope.cleanups, DraftCleanup {
                id = value.index
                body = get(value.children, 0)
                active = true
            })
        return
    }
    if definite && value.kind == ExprKind.Cleanup {
        var index = 0
        while index < length(scope.cleanups) {
            let cleanup = get(scope.cleanups, index)
            if cleanup.id == value.index {
                set(scope.cleanups, index, DraftCleanup {
                        id = cleanup.id
                        body = cleanup.body
                        active = false
                    })
            }
            index = index + 1
        }
    }
    var index = 0
    while index < length(value.children) {
        let conditional = value.kind == ExprKind.While ||
        ((value.kind == ExprKind.If || (value.kind == ExprKind.Binary &&
                    (value.text == "&&" || value.text == "||"))) && index != 0)
        draft_registrations(scope, get(value.children, index), definite && !conditional, depth + 1)
        index = index + 1
    }
    index = 0
    while index < length(value.arms) {
        let body = get(value.arms, index).body
        var item = 0
        while item < length(body) {
            draft_registrations(scope, get(body, item), false, depth + 1)
            item = item + 1
        }
        index = index + 1
    }
}

fn draft_prefix(scope DraftPublication, value Expr, depth Int) InputOrigin {
    if depth >= 256 {
        set(scope.reads.valid, 0, false)
        return origin_input()
    }
    let phase = get(scope.phase, 0)
    if phase == 2 {
        if !draft_raw_use(value, scope.frame, depth) {
            return origin_empty()
        }
        // The default is read-only. A proved operation may preserve the complete
        // predicate without publishing the header or changing its representation.
        let origin = invariant_origin(scope.observations, scope.frame, value, depth + 1, scope.permissions)
        // A statement's shared result may be the enclosing function/block's
        // implicit return. Local bindings retain origins without returning one;
        // scalar consumers can read an alias, but raw results cannot escape.
        if origin_shared(origin) {
            set(scope.reads.valid, 0, false)
        }
        return origin
    }
    draft_registrations(scope, value, true, depth + 1)
    if value.kind == ExprKind.Defer {
        return origin_empty()
    }
    // An unpublished fresh header is unreachable from an operation that neither
    // receives it nor a known alias/capture. In particular, an unrelated await
    // does not publish the builder or turn its graph into external state.
    if !draft_raw_use(value, scope.frame, depth) {
        return origin_empty()
    }
    invariant_origin(scope.reads, scope.frame, value, depth + 1)
}

fn draft_sequence(scope DraftPublication, values List[Expr], depth Int) Bool {
    var index = 0
    while index < length(values) && get(scope.reads.valid, 0) {
        let value = get(values, index)
        if draft_occurrences(scope.reads.env, value, scope.candidate, depth) != 0 {
            if !draft_path(scope, value, depth + 1) {
                return false
            }
        } else {
            discard draft_prefix(scope, value, depth + 1)
            if !value.falls {
                return false
            }
        }
        index = index + 1
    }
    true
}

// Follow the unique checked occurrence, retaining only its executable prefix
// and continuations. Sibling branches are alternatives, not later executions.
// Existing origin transfer still handles all branches/loops within the prefix.
fn draft_path(scope DraftPublication, value Expr, depth Int) Bool {
    if depth >= 256 || !get(scope.reads.valid, 0) {
        set(scope.reads.valid, 0, false)
        return false
    }
    if draft_construction(scope.reads.env, value) && same_draft_construction(value, scope.candidate) {
        if get(scope.phase, 0) != 1 {
            set(scope.reads.valid, 0, false)
            return false
        }
        var index = 0
        while index < length(scope.cleanups) {
            let cleanup = get(scope.cleanups, index)
            if cleanup.active && draft_raw_use(cleanup.body, scope.frame, depth + 1) {
                discard invariant_origin(scope.observations, scope.frame, cleanup.body, depth + 1, scope.permissions)
            }
            index = index + 1
        }
        set(scope.phase, 0, 2)
        return value.falls
    }
    if value.kind == ExprKind.While || value.kind == ExprKind.Defer || value.kind == ExprKind.Cleanup ||
    value.kind == ExprKind.ResourceDrain {
        // A repeated allocation epoch or cleanup-only invocation requires its
        // own publication state; never confuse it with this activation's root.
        set(scope.reads.valid, 0, false)
        return false
    }
    if value.kind == ExprKind.Block {
        if value.text == "checked list" {
            return draft_path(scope, draft_input(value), depth + 1)
        } else {
            return draft_sequence(scope, value.children, depth + 1)
        }
    }
    if value.kind == ExprKind.If && length(value.children) >= 2 {
        let condition = get(value.children, 0)
        if draft_occurrences(scope.reads.env, condition, scope.candidate, depth + 1) != 0 {
            if !draft_path(scope, condition, depth + 1) {
                return false
            }
            var branch = 1
            while branch < length(value.children) {
                discard draft_prefix(scope, get(value.children, branch), depth + 1)
                branch = branch + 1
            }
        } else {
            discard draft_prefix(scope, condition, depth + 1)
            var branch = 1
            while branch < length(value.children) {
                let body = get(value.children, branch)
                if draft_occurrences(scope.reads.env, body, scope.candidate, depth + 1) != 0 {
                    return draft_path(scope, body, depth + 1)
                }
                branch = branch + 1
            }
        }
        return value.falls
    }
    if value.kind == ExprKind.Match && length(value.children) == 1 {
        let input = get(value.children, 0)
        if draft_occurrences(scope.reads.env, input, scope.candidate, depth + 1) != 0 {
            if !draft_path(scope, input, depth + 1) {
                return false
            }
            var arm = 0
            while arm < length(value.arms) {
                let body = get(value.arms, arm).body
                var item = 0
                while item < length(body) {
                    discard draft_prefix(scope, get(body, item), depth + 1)
                    item = item + 1
                }
                arm = arm + 1
            }
        } else {
            let origin = draft_prefix(scope, input, depth + 1)
            var arm = 0
            while arm < length(value.arms) {
                let selected = get(value.arms, arm)
                var contains = false
                var item = 0
                while item < length(selected.body) {
                    contains = contains || draft_occurrences(scope.reads.env, get(selected.body, item), scope.candidate, depth + 1) != 0
                    item = item + 1
                }
                if contains {
                    invariant_bind(scope.frame, selected.whole, origin)
                    item = 0
                    while item < length(selected.bindings) {
                        invariant_bind(scope.frame, get(selected.bindings, item), origin_project(origin, item))
                        item = item + 1
                    }
                    return draft_sequence(scope, selected.body, depth + 1)
                }
                arm = arm + 1
            }
        }
        return value.falls
    }
    var held = origin_empty()
    var index = 0
    while index < length(value.children) && get(scope.reads.valid, 0) {
        let child = get(value.children, index)
        let input = if value.kind == ExprKind.Record || value.kind == ExprKind.FrameNew {
            get(child.children, 0)
        } else {
            child
        }
        if draft_occurrences(scope.reads.env, input, scope.candidate, depth + 1) != 0 {
            if !draft_path(scope, input, depth + 1) {
                return false
            }
        } else {
            held = origin_union(held, draft_prefix(scope, input, depth + 1))
        }
        index = index + 1
    }
    // Eager operands survive until their parent operation. A raw argument or
    // initializer evaluated before construction must not escape afterwards.
    if origin_shared(held) || length(value.arms) != 0 {
        set(scope.reads.valid, 0, false)
    }
    value.falls
}

fn unpublished_draft(env Environment, functions List[Function], current Function, candidate Expr, operations List[Expr]) Bool {
    let root = draft_root(env, functions, current, draft_input(candidate))
    if root.local < 0 {
        return false
    }
    let bodies = [current.body]
    if !draft_epochs(env, current.body, candidate, root.local, bodies, 0) {
        return false
    }
    let body = get(bodies, length(bodies) - 1)
    if length(bodies) > 1 && !draft_epoch_allocations(body, root) {
        return false
    }
    let reads = invariant_reads(env, functions, current.body, true, 2, -1)
    let updates = DraftUpdates {
        env = env
        functions = functions
        current = [current]
        root = root
        ty = draft_type(candidate)
        operations = [new[Expr]()]
    }
    let permissions = [InvariantPermission {
            allow = fn(value Expr, inputs List[InputOrigin]) Bool {
                draft_update(updates, value, inputs)
            }
            effects = reads
        }]
    let scope = DraftPublication {
        reads = reads
        observations = InvariantReads {
            env = env
            functions = functions
            references = reads.references
            contents = true
            writes = 0
            root_list = -1
            element_reads = reads.element_reads
            calls = new[InvariantCall]()
            valid = reads.valid
        }
        frame = invariant_frame(length(current.locals), new[InputOrigin]())
        candidate = candidate
        phase = ints(1)
        cleanups = new[DraftCleanup]()
        permissions = permissions
    }
    // Distinct immutable allocation bindings cannot be read before definition.
    // Seed every possible header so branch-local exports are checked before a
    // joined value is bound. Origin transfer retains these seeds through Let.
    var allocation = 0
    while allocation < length(root.allocations) {
        let anchor = get(root.allocations, allocation)
        invariant_bind(scope.frame, anchor.local, anchor.origin)
        allocation = allocation + 1
    }
    var more = true
    var rounds = 0
    while more && get(scope.reads.valid, 0) && rounds < 256 {
        set(scope.frame.changed, 0, false)
        set(scope.phase, 0, 1)
        set(updates.operations, 0, new[Expr]())
        let active = length(scope.cleanups)
        var cleanup = 0
        while cleanup < active {
            let prior = get(scope.cleanups, cleanup)
            set(scope.cleanups, cleanup, DraftCleanup {
                    id = prior.id
                    body = prior.body
                    active = false
                })
            cleanup = cleanup + 1
        }
        discard draft_path(scope, body, 0)
        more = get(scope.frame.changed, 0)
        rounds = rounds + 1
    }
    let valid = !more && get(scope.reads.valid, 0) && get(scope.phase, 0) == 2 &&
    !origin_shared(get(scope.frame.returned, 0)) &&
    (length(bodies) == 1 || confined_draft_epoch(body, scope.frame))
    if valid {
        let accepted = get(updates.operations, 0)
        var index = 0
        while index < length(accepted) {
            push(operations, get(accepted, index))
            index = index + 1
        }
    }
    valid
}
