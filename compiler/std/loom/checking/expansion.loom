import std.option.Option
import std.loom.typed.Local

// Ordinary calls retain their source list and allocate no preparation table.
// Only expanded tuples need saved expressions, at their original operand slot.
record CallInputs {
    nodes List[Node]
    ready Option[List[Option[Expr]]]
    effects Option[List[InputEffect]]
}

record InputEffect {
    position Int
    value Expr
}

fn source_nodes(node Node) List[Node] {
    let values = new[Node]()
    push(values, node)
    values
}

fn plain_inputs(nodes List[Node]) CallInputs {
    CallInputs {
        nodes = nodes
        ready = Option.None
        effects = Option.None
    }
}

fn saved_input(inputs CallInputs, index Int) Option[Expr] {
    match inputs.ready {
        Option.Some(values) => get(values, index),
        Option.None => Option.None
    }
}

fn input_value(context Context, inputs CallInputs, index Int, expected Int, probe Bool) Result[Expr, Failure] {
    let node = get(inputs.nodes, index)
    if probe {
        return static_probe(context, node, expected)
    }
    let value = match saved_input(inputs, index) {
        Option.Some(value) => typed(context, node, value, expected)
        Option.None => expr(context, node, expected)
    }?
    Result.Ok(input_effects(context, inputs, index, node, value))
}

// Empty expansion contributes evaluation, but no parameter. Keep that work at
// its source gap; ordinary inputs have no effect table or extra typed nodes.
fn effect_at(inputs CallInputs, position Int, index Int) Bool {
    position == index || (index == length(inputs.nodes) - 1 && position == length(inputs.nodes))
}

fn has_input_effects(inputs CallInputs, index Int) Bool {
    match inputs.effects {
        Option.None => false
        Option.Some(effects) => {
            var current = 0
            while current < length(effects) {
                if effect_at(inputs, get(effects, current).position, index) { return true }
                current = current + 1
            }
            false
        }
    }
}

fn input_effects(context Context, inputs CallInputs, index Int, node Node, value Expr) Expr {
    if !has_input_effects(inputs, index) { return value }
    let body = new[Expr]()
    var saved = -1
    match inputs.effects {
        Option.None => {}
        Option.Some(effects) => {
            var current = 0
            while current < length(effects) {
                let effect = get(effects, current)
                if effect_at(inputs, effect.position, index) {
                    if effect.position > index && saved < 0 {
                        saved = length(context.locals)
                        push(context.locals, Local { name = "" ty = value.ty mutable = false is_scoped = false })
                        push(body, expression(ExprKind.Let, 0, node, "", saved, expressions(value), value.falls))
                    }
                    push(body, expression(ExprKind.Discard, 0, node, "", -1, expressions(effect.value), effect.value.falls))
                }
                current = current + 1
            }
        }
    }
    push(body, if saved < 0 { value } else { atom(ExprKind.Local, value.ty, node, saved) })
    expression(ExprKind.Block, value.ty, node, "", -1, body, all_fall(body))
}

fn empty_inputs(context Context, inputs CallInputs, node Node, value Expr) Expr {
    if length(inputs.nodes) == 0 { input_effects(context, inputs, 0, node, value) } else { value }
}

fn shifted_effects(inputs CallInputs, offset Int) Option[List[InputEffect]] {
    match inputs.effects {
        Option.None => Option.None
        Option.Some(effects) => {
            let shifted = new[InputEffect]()
            var index = 0
            while index < length(effects) {
                let effect = get(effects, index)
                if offset > 0 || (length(inputs.nodes) > 1 && effect.position > 0) {
                    push(shifted, InputEffect { position = effect.position + offset value = effect.value })
                }
                index = index + 1
            }
            if length(shifted) == 0 { Option.None } else { Option.Some(shifted) }
        }
    }
}

fn input_tail(inputs CallInputs) CallInputs {
    let nodes = new[Node]()
    var index = 1
    while index < length(inputs.nodes) {
        push(nodes, get(inputs.nodes, index))
        index = index + 1
    }
    let ready Option[List[Option[Expr]]] = match inputs.ready {
        Option.None => Option.None
        Option.Some(values) => {
            let tail = new[Option[Expr]]()
            index = 1
            while index < length(values) {
                push(tail, get(values, index))
                index = index + 1
            }
            Option.Some(tail)
        }
    }
    CallInputs {
        nodes = nodes
        ready = ready
        effects = shifted_effects(inputs, -1)
    }
}

fn input_receiver(inputs CallInputs, source Node) CallInputs {
    let nodes = source_nodes(source)
    var index = 0
    while index < length(inputs.nodes) {
        push(nodes, get(inputs.nodes, index))
        index = index + 1
    }
    let ready Option[List[Option[Expr]]] = match inputs.ready {
        Option.None => Option.None
        Option.Some(values) => {
            let prefixed = new[Option[Expr]]()
            push(prefixed, Option.None)
            index = 0
            while index < length(values) {
                push(prefixed, get(values, index))
                index = index + 1
            }
            Option.Some(prefixed)
        }
    }
    CallInputs {
        nodes = nodes
        ready = ready
        effects = shifted_effects(inputs, 1)
    }
}

fn expand_input(context Context, source Node, nodes List[Node], ready List[Option[Expr]], effects List[InputEffect], depth Int) Result[Bool, Failure] {
    if source.kind != NodeKind.Spread {
        push(nodes, source)
        push(ready, Option.None)
        return Result.Ok(true)
    }
    if depth >= 64 {
        return Result.Err(error(context, source, "tuple expansion nesting limit exceeded"))
    }
    let operand = child(source, 0)
    if operand.kind == NodeKind.Tuple {
        // A literal already supplies ordered operands. Flatten it before hints
        // and static-argument selection, without manufacturing an aggregate.
        var index = 0
        while index < length(operand.children) {
            discard expand_input(context, child(operand, index), nodes, ready, effects, depth + 1)?
            index = index + 1
        }
        return Result.Ok(true)
    }
    let value = expr(context, operand, -1)?
    let shape = get(context.env.types, value.ty)
    if shape.kind != TypeKind.Tuple {
        return Result.Err(error(context, source, "expansion requires a statically known tuple, not a runtime-sized List"))
    }
    if length(shape.arguments) == 0 {
        if value.kind != ExprKind.Local && !(value.kind == ExprKind.Record && length(value.children) == 0) {
            push(effects, InputEffect { position = length(nodes) value = value })
        }
        return Result.Ok(true)
    }
    let local = length(context.locals)
    push(context.locals, Local {
            name = ""
            ty = value.ty
            mutable = false
            is_scoped = false
        })
    var index = 0
    while index < length(shape.arguments) {
        let node = Node {
            kind = NodeKind.Select
            value = std.int.to_text(index)
            span = source.span
            children = source_nodes(operand)
        }
        let projection = expression(ExprKind.Field, get(shape.arguments, index), node, "", index,
            expressions(atom(ExprKind.Local, value.ty, source, local)), true)
        let field = if index == 0 {
            let body = expressions(expression(ExprKind.Let, 0, source, "", local, expressions(value), value.falls))
            push(body, projection)
            expression(ExprKind.Block, projection.ty, source, "", -1, body, value.falls)
        } else {
            projection
        }
        push(nodes, node)
        push(ready, Option.Some(field))
        index = index + 1
    }
    Result.Ok(true)
}

fn call_inputs(context Context, sources List[Node]) Result[CallInputs, Failure] {
    var spread = false
    var index = 0
    while index < length(sources) {
        spread = spread || get(sources, index).kind == NodeKind.Spread
        index = index + 1
    }
    if !spread {
        return Result.Ok(plain_inputs(sources))
    }
    let nodes = new[Node]()
    let ready = new[Option[Expr]]()
    let effects = new[InputEffect]()
    index = 0
    while index < length(sources) {
        discard expand_input(context, get(sources, index), nodes, ready, effects, 0)?
        index = index + 1
    }
    Result.Ok(CallInputs {
            nodes = nodes
            ready = Option.Some(ready)
            effects = if length(effects) == 0 { Option.None } else { Option.Some(effects) }
        })
}
