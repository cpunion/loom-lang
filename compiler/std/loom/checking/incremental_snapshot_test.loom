import std.text.join
import std.text.split

test fn staged_instances_rekey_constants_and_keep_specializations_distinct() {
    let source = """
        record Plan {
            enabled Bool
            step Int
            label Text
            pair (Float, type)
        }
        fn increment(item Int) Int {
            item + 1
        }
        fn choose(comptime plan Plan, comptime callback fn(Int) Int, item Int) Int {
            comptime if plan.enabled {
                callback(item) + comptime {
                    plan.step
                }
            } else {
                item
            }
        }
        fn label(comptime text Text) Text {
            text
        }
        fn zero(comptime value Float) Float {
            value
        }
        pub fn answer() Int {
            let a = choose(Plan {
                    enabled = true
                    step = 2
                    label = "first"
                    pair = (0.0, Int)
                }, increment, 4)
            let b = choose(Plan {
                    enabled = false
                    step = 9
                    label = "second"
                    pair = (-0.0, Text)
                }, increment, 10)
            assert label("a") != label("b")
            assert zero(0.0) == zero(-0.0)
            a + b
        }
        """
    let initial = definition_cache()
    assert match cached_source(initial, source) {
        Result.Ok(_) => true
        Result.Err(failed) => {
            discard write_error(failed.diagnostic.message)
            false
        }
    }
    let cache = restored_definition_cache(initial)
    assert match cached_source(cache, concat("fn unused(value List[Bool]) List[Bool] { value }\n", source)) {
        Result.Ok(_) => true
        Result.Err(failed) => {
            discard write_error(failed.diagnostic.message)
            false
        }
    }
    assert bodies_reused(cache) >= 8
    discard restored_definition_cache(cache)
}

test fn changed_erased_comptime_helpers_revoke_required_proofs() {
    let source = """
        fn value() Int {
            7
        }
        pub fn answer() Int
        ensures result == 7
        {
            comptime {
                value()
            }
        }
        """
    let initial = definition_cache()
    assert match cached_source(initial, source) {
        Result.Ok(_) => true
        Result.Err(_) => false
    }
    let cache = restored_definition_cache(initial)
    assert match cached_source(cache, concat("fn unrelated() Bool { true }\n", source)) {
        Result.Ok(_) => true
        Result.Err(_) => false
    }
    assert bodies_reused(cache) >= 1
    assert match cached_source(cache, join(split(source, "\n    7\n"), "\n    8\n")) {
        Result.Err(_) => true
        Result.Ok(_) => false
    }
}

fn restored_definition_cache(cache DefinitionCache) DefinitionCache {
    let text = match export_definition_cache(cache) {
        Result.Ok(value) => value
        Result.Err(_) => {
            assert false
            return definition_cache()
        }
    }
    match import_trusted_definition_cache(text) {
        Result.Ok(value) => {
            assert match export_definition_cache(value) {
                Result.Ok(roundtrip) => roundtrip == text
                Result.Err(_) => false
            }
            value
        }
        Result.Err(_) => {
            assert false
            definition_cache()
        }
    }
}

test fn definition_snapshots_restore_bodies_and_invalidate_changed_proofs() {
    let source = """
        record Box[T] {
            value T
        }
        pub fn leaf(value Int) Int {
            value + 1
        }
        pub fn identity[T](value T) T {
            value
        }
        pub fn answer() Int
        ensures result == 7
        {
            leaf(6)
        }
        pub fn boxed() Box[Int] {
            identity(Box { value = 7 })
        }
        """
    let initial = definition_cache()
    assert match cached_source(initial, source) {
        Result.Ok(_) => true
        Result.Err(_) => false
    }
    let cache = restored_definition_cache(initial)
    assert definitions_reused(cache) == 0 && bodies_reused(cache) == 0
    let added = """
        fn unused(value List[Bool]) List[Bool] {
            value
        }

        """
    assert match cached_source(cache, concat(added, source)) {
        Result.Ok(_) => true
        Result.Err(_) => false
    }
    assert definitions_reused(cache) == 4 && bodies_reused(cache) == 4
    let restored = restored_definition_cache(cache)
    assert match cached_source(restored, std.text.join(std.text.split(source, "value + 1"), "value + 2")) {
        Result.Err(_) => true
        Result.Ok(_) => false
    }
    assert match cached_source(restored, source) {
        Result.Ok(_) => true
        Result.Err(_) => false
    }
}

test fn definition_snapshots_require_source_backed_syntax_and_complete_encoding() {
    let cache = definition_cache()
    let source = fixture_project(source_files("fn value() Int { 1 }"))
    let file = get(source.files, 0)
    set(source.files, 0, SourceFile {
            package = file.package
            path = file.path
            text = "fn value() Int { 2 }"
            tree = file.tree
            test_only = file.test_only
            trusted_std = file.trusted_std
        })
    assert match check_project_cached(source, false, build_inputs(no_input_reader), cache) {
        Result.Ok(_) => true
        Result.Err(_) => false
    }
    assert match export_definition_cache(cache) {
        Result.Err(_) => true
        Result.Ok(_) => false
    }
    assert match cached_source(cache, "fn value() Int { 3 }") {
        Result.Ok(_) => true
        Result.Err(_) => false
    }
    let text = match export_definition_cache(cache) {
        Result.Ok(value) => value
        Result.Err(_) => {
            assert false
            return
        }
    }
    assert match import_trusted_definition_cache(std.text.slice(text, 0, std.text.length(text) - 1)) {
        Result.Err(_) => true
        Result.Ok(_) => false
    }
    assert match import_trusted_definition_cache(concat(text, "extra")) {
        Result.Err(_) => true
        Result.Ok(_) => false
    }
}

test fn generated_snapshots_own_raw_and_expanded_source_separately() {
    let text = """"
        comptime {
            """
            pub fn generated() Int {
                7
            }
            """
        }
        """"
    let initial = definition_cache()
    let checked = match cached_source(initial, text) {
        Result.Ok(value) => value
        Result.Err(_) => {
            assert false
            return
        }
    }
    let file = get(checked.source.files, 0)
    set(checked.source.files, 0, SourceFile {
            package = file.package
            path = file.path
            text = "not source"
            tree = file.tree
            test_only = file.test_only
            trusted_std = file.trusted_std
        })
    let restored = restored_definition_cache(initial)
    assert match cached_source(restored, concat(text, "\nfn extra() Int { 1 }")) {
        Result.Ok(_) => true
        Result.Err(_) => false
    }
    assert bodies_reused(restored) == 1
    let extended = std.text.join(std.text.split(text, "7"), "7\n            // a longer generation source interval")
    let refreshed = match cached_source(restored, extended) {
        Result.Ok(value) => value
        Result.Err(_) => {
            assert false
            return
        }
    }
    assert bodies_reused(restored) == 2
    let generated = get(refreshed.program.functions, 0)
    let current = get(refreshed.bindings.symbols, generated.symbol).node.span
    assert generated.span.end == current.end && generated.body.span.end == current.end
    // A caller-supplied tree still cannot claim different raw source bytes.
    let forged = definition_cache()
    assert match check_project_cached(checked.source, false, build_inputs(no_input_reader), forged) {
        Result.Ok(_) => true
        Result.Err(_) => false
    }
    assert match export_definition_cache(forged) {
        Result.Err(_) => true
        Result.Ok(_) => false
    }
}
