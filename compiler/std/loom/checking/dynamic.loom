import std.loom.ast.Node
import std.loom.typed.TypeKind
import std.loom.typed.ExprKind
import std.loom.typed.Interface
import std.loom.typed.Method
import std.loom.typed.Witness
import std.list.new
import std.list.get
import std.list.push
import std.list.set
import std.list.length
import std.result.Result

record SlotUse { interface Int slot Int }

fn dynamic_member_type(env Environment, ty Int, capability Int) Bool {
    let shape = get(env.types, ty)
    if shape.kind == TypeKind.Parameter { return shape.symbol != 0 }
    if shape.kind == TypeKind.Associated {
        let receiver = get(env.types, get(shape.arguments, 0))
        if receiver.kind == TypeKind.Parameter && receiver.symbol == 0 {
            if symbol(env, shape.symbol).owner != capability { return false }
            var argument = 1
            while argument < length(shape.arguments) {
                if !dynamic_member_type(env, get(shape.arguments, argument), capability) { return false }
                argument = argument + 1
            }
            return true
        }
    }
    var index = 0
    while index < length(shape.arguments) {
        if !dynamic_member_type(env, get(shape.arguments, index), capability) { return false }
        index = index + 1
    }
    true
}
fn fill_interface(env Environment, receiver Int) Result[Bool, Failure] {
    let index = get(env.types, receiver).symbol
    let declaration = get(env.interfaces, index)
    let capability = get(env.concepts, concept_index(env, declaration.symbol))
    let state = get(env.dynamic_interfaces, index)
    if state.initialized || state.filling { return Result.Ok(true) }
    // Signatures can mention dyn before conformance collection has attached
    // their concept's methods. The later fill_interfaces pass initializes it.
    if length(capability.methods) == 0 && has(symbol(env, capability.symbol).node, NodeKind.Function) {
        return Result.Ok(true)
    }
    let methods = new[Method]()
    let slots = new[DynamicSlot]()
    set(env.dynamic_interfaces, index, DynamicInterface { initialized = false filling = true slots = state.slots })
    match fill_interface_methods(env, receiver, capability, methods, slots) {
        Result.Ok(_) => {
            set(env.interfaces, index, Interface { symbol = declaration.symbol methods = methods })
            set(env.dynamic_interfaces, index, DynamicInterface { initialized = true filling = false slots = slots })
            Result.Ok(true)
        }
        Result.Err(failure) => {
            // Optional/header resolution may retry after missing evidence.
            // Never publish a validated prefix or suppress the next check.
            set(env.dynamic_interfaces, index, state)
            Result.Err(failure)
        }
    }
}
fn fill_interface_methods(env Environment, receiver Int, capability Concept, methods List[Method], slots List[DynamicSlot]) Result[Bool, Failure] {
    var method = 0
    while method < length(capability.methods) {
        let current = get(env.signatures, get(capability.methods, method))
        let node = symbol(env, current.symbol).node
        var parameter = 1
        while parameter < length(current.params) {
            let ty = get(current.params, parameter)
            if !dynamic_member_type(env, ty, capability.symbol) {
                return Result.Err(failure(env, current.symbol, symbol(env, current.symbol).node, "dyn concept methods may use Self only as the receiver"))
            }
            parameter = parameter + 1
        }
        if !dynamic_member_type(env, current.result, capability.symbol) {
            return Result.Err(failure(env, current.symbol, symbol(env, current.symbol).node, "dyn concept methods cannot return Self or a type containing Self"))
        }
        // A generic declaration is checked now but has no unspecialized ABI
        // slot. Concrete calls append only the instances this build needs.
        if current.parameters == 1 {
            let specialized = signature(env, get(capability.methods, method), ints(receiver), node)?
            let params = argument_tail(specialized.params, 1)
            var previous = 0
            while previous < length(methods) {
                let other = get(methods, previous)
                if other.name == symbol(env, current.symbol).name && same(other.params, params) {
                    return Result.Err(failure(env, current.symbol, node, "dynamic bindings produce overlapping method signatures"))
                }
                previous = previous + 1
            }
            push(methods, Method { name = symbol(env, current.symbol).name params = params result = specialized.result })
            push(slots, DynamicSlot { signature = get(capability.methods, method) arguments = new[Int]() })
        }
        method = method + 1
    }
    Result.Ok(true)
}
fn fill_interfaces(env Environment) Result[Bool, Failure] {
    // A method may return another dyn instance. Do not recursively instantiate
    // that instance's entire interface until the instance is itself used.
    let count = length(env.types)
    var index = 0
    while index < count {
        if get(env.types, index).kind == TypeKind.Dyn { discard fill_interface(env, index)? }
        index = index + 1 }
    Result.Ok(true)
}
fn dynamic_instance(env Environment, owner Int, capability Int, bindings List[Int], node Node) Result[Int, Failure] {
    var index = 0
    while index < length(env.types) {
        let ty = get(env.types, index)
        if ty.kind == TypeKind.Dyn && get(env.interfaces, ty.symbol).symbol == capability && same(ty.arguments, bindings) {
            return Result.Ok(index)
        }
        index = index + 1
    }
    index = 0
    while index < length(bindings) {
        if type_depth(env, get(bindings, index)) >= 64 {
            return Result.Err(failure(env, owner, node, "dynamic binding specialization depth exceeded"))
        }
        index = index + 1
    }
    let interface = length(env.interfaces)
    push(env.interfaces, Interface { symbol = capability methods = new[Method]() })
    push(env.dynamic_interfaces, DynamicInterface { initialized = false filling = false slots = new[DynamicSlot]() })
    Result.Ok(intern(env, TypeKind.Dyn, interface, bindings))
}
fn emitted_type(env Environment, owner Int, ty Int, node Node, seen List[Int]) Result[Bool, Failure] {
    var index = 0
    while index < length(seen) {
        if get(seen, index) == ty { return Result.Ok(true) }
        index = index + 1
    }
    push(seen, ty)
    let shape = get(env.types, ty)
    if shape.kind == TypeKind.Parameter || shape.kind == TypeKind.Associated {
        return Result.Err(failure(env, owner, node, "emitted function types must be concrete"))
    }
    if shape.kind == TypeKind.Dyn { discard fill_interface(env, ty)? }
    index = 0
    while index < length(shape.arguments) {
        discard emitted_type(env, owner, get(shape.arguments, index), node, seen)?
        index = index + 1
    }
    index = 0
    while index < length(shape.fields) {
        discard emitted_type(env, owner, get(shape.fields, index).ty, node, seen)?
        index = index + 1
    }
    index = 0
    while index < length(shape.variants) {
        let fields = get(shape.variants, index).fields
        var field = 0
        while field < length(fields) { discard emitted_type(env, owner, get(fields, field), node, seen)?
            field = field + 1 }
        index = index + 1
    }
    Result.Ok(true)
}
fn dynamic_type(env Environment, owner Int, node Node, arguments List[Int], obligations List[Requirement], depth Int) Result[Int, Failure] {
    let capability = concept_named(env, owner, node, node.value)?
    if capability < 0 { return Result.Err(failure(env, owner, node, "expected an accessible concept")) }
    let members = get(env.concepts, concept_index(env, capability)).associated
    let bindings = new[Int]()
    var index = 0
    while index < length(members) {
        if length(member_parameters(env, get(members, index))) != 0 {
            return Result.Err(failure(env, owner, node, "dyn does not yet support generic associated type families"))
        }
        push(bindings, -1)
        index = index + 1 }
    index = 0
    while index < length(node.children) {
        let binding = child(node, index)
        var member = 0
        while member < length(members) && symbol(env, get(members, member)).name != binding.value { member = member + 1 }
        if member == length(members) { return Result.Err(failure(env, owner, binding, "unknown dynamic associated type binding")) }
        if get(bindings, member) >= 0 { return Result.Err(failure(env, owner, binding, "duplicate dynamic associated type binding")) }
        set(bindings, member, resolve_bound(env, owner, child(binding, 0), arguments, obligations, depth)?)
        index = index + 1
    }
    if !complete(bindings) { return Result.Err(failure(env, owner, node, "dyn requires an explicit binding for every associated type")) }
    discard associated_bounds(env, owner, capability, bindings, obligations, node)?
    let ty = dynamic_instance(env, owner, capability, bindings, node)?
    discard fill_interface(env, ty)?
    Result.Ok(ty)
}
fn can_widen(context Context, source Int, target Int) Result[Bool, Failure] {
    if target < 0 { return Result.Ok(false) }
    let original = get(context.env.types, source)
    let desired = get(context.env.types, target)
    if original.kind == TypeKind.Refined && target == base_type(context.env, source) { return Result.Ok(true) }
    if desired.kind != TypeKind.Dyn || original.kind == TypeKind.Dyn { return Result.Ok(false) }
    let capability = get(context.env.interfaces, desired.symbol).symbol
    if !satisfies(context, source, capability)? { return Result.Ok(false) }
    let members = get(context.env.concepts, concept_index(context.env, capability)).associated
    var index = 0
    while index < length(members) {
        let actual = associated_type(context.env, context.signature.symbol, get(members, index), source, new[Int](),
            symbol(context.env, context.signature.symbol).node, 0)?
        if actual != get(desired.arguments, index) { return Result.Ok(false) }
        index = index + 1
    }
    Result.Ok(true)
}
fn boxed(context Context, node Node, value Expr, target Int) Result[Expr, Failure] {
    if must_scope(context, value.ty)? { return Result.Err(error(context, node, "dyn cannot erase a MustScope obligation")) }
    if !can_widen(context, value.ty, target)? {
        return Result.Err(error(context, node, "dyn conversion needs an explicit conformance; conversions between different dyn concepts are not supported"))
    }
    var witness = -1
    discard fill_interface(context.env, target)?
    if context.emit {
        if !concrete(context.env, target) { return Result.Err(error(context, node, "dynamic construction requires concrete associated bindings")) }
        let interface = get(context.env.types, target).symbol
        let capability = get(context.env.interfaces, interface)
        if implementation(context, value.ty, capability.symbol)? < 0 {
            return Result.Err(error(context, node, "dynamic construction has no concrete implementation"))
        }
        witness = 0
        while witness < length(context.env.witnesses) &&
            (get(context.env.witnesses, witness).interface != interface || get(context.env.witnesses, witness).concrete != value.ty) {
            witness = witness + 1
        }
        if witness == length(context.env.witnesses) {
            let methods = new[Int]()
            var slot = 0
            while slot < length(capability.methods) { push(methods, -1)
                slot = slot + 1 }
            push(context.env.witnesses, Witness { interface = interface concrete = value.ty methods = methods })
        }
    }
    Result.Ok(expression(ExprKind.DynBox, target, node, "", witness, expressions(value), value.falls))
}
fn dynamic_call(context Context, node Node, signature Int, arguments List[Int], output Int, values List[Expr]) Result[Expr, Failure] {
    let receiver = get(values, 0)
    discard fill_interface(context.env, receiver.ty)?
    let interface = get(context.env.types, receiver.ty).symbol
    let capability = get(context.env.interfaces, interface).symbol
    let methods = get(context.env.concepts, concept_index(context.env, capability)).methods
    var member = 0
    while member < length(methods) && get(methods, member) != signature { member = member + 1 }
    if member == length(methods) { return Result.Err(error(context, node, "dynamic method does not belong to the receiver's concept")) }
    var slot = -1
    if context.emit {
        if !concrete(context.env, receiver.ty) { return Result.Err(error(context, node, "dynamic calls require concrete associated bindings")) }
        slot = dynamic_slot(context, node, receiver.ty, signature, arguments)?
        var index = 0
        while index < length(context.env.uses) &&
            (get(context.env.uses, index).interface != interface || get(context.env.uses, index).slot != slot) { index = index + 1 }
        if index == length(context.env.uses) { push(context.env.uses, SlotUse { interface = interface slot = slot }) }
    }
    Result.Ok(expression(ExprKind.DynCall, output, node, "", slot, values, all_fall(values)))
}
fn slot_used(env Environment, interface Int, slot Int) Bool {
    var index = 0
    while index < length(env.uses) {
        let use = get(env.uses, index)
        if use.interface == interface && use.slot == slot { return true }
        index = index + 1
    }
    false
}
fn activate_witnesses(env Environment, retain Bool) Result[Bool, Failure] {
    var changed = false
    var index = 0
    while index < length(env.witnesses) {
        let witness = get(env.witnesses, index)
        let capability = get(env.interfaces, witness.interface).symbol
        // Witness creation already admitted this exact conformance in its scope.
        let provided = conformance(env, witness.concrete, capability)
        let implementation = get(env.implementations, provided.implementation)
        let declarations = get(env.concepts, concept_index(env, capability)).methods
        let slots = get(env.dynamic_interfaces, witness.interface).slots
        // Staging shares interface identities but owns its witness queue.
        // Bring a table up to date if another queue discovered a slot.
        while length(witness.methods) < length(slots) { push(witness.methods, -1) }
        var slot = 0
        while slot < length(witness.methods) {
            if get(witness.methods, slot) < 0 && (retain || slot_used(env, witness.interface, slot)) {
                let instance = get(slots, slot)
                var member = 0
                while get(declarations, member) != instance.signature { member = member + 1 }
                let method = get(implementation.methods, member)
                let current = get(env.signatures, method)
                let declaration = symbol(env, current.symbol)
                let arguments = member_arguments(if prototype(env, current.symbol) { ints(witness.concrete) } else { provided.arguments }, instance.arguments)
                set(witness.methods, slot, schedule(env, method, arguments, new[StaticValue](), declaration.node)?)
                changed = true
            }
            slot = slot + 1
        }
        index = index + 1
    }
    Result.Ok(changed)
}
fn emit_functions(env Environment, retain Bool) Result[List[Function], Failure] {
    let functions = new[Function]()
    var index = 0
    var more = true
    while more {
        while index < length(env.pending) {
            let instance = get(env.pending, index)
            push(functions, function(env, instance.signature, instance.arguments, instance.constants, true)?)
            index = index + 1
        }
        more = activate_witnesses(env, retain)?
    }
    discard resource_functions(env, functions)?
    Result.Ok(functions)
}
