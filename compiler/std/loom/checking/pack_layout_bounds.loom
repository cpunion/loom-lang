record PackLayoutRequirement {
    schema Node
    capability Int
}

fn pack_layout_owner(context Context) Int {
    let caller = pack_proof_caller(context)
    if caller >= 0 {
        caller
    } else {
        context.signature.symbol
    }
}

fn pack_layout_bindings(context Context, caller Node, owner Int, target Node, schema Node,
    budget List[Int]) Option[PackForwardMatch] {
    let pattern = match type_pattern_schema(context.env, owner, target, false, 0, true) {
        Result.Ok(value) => value
        Result.Err(_) => {
            return Option.None
        }
    }
    pack_schema_bindings(caller, group(symbol(context.env, owner).node, NodeKind.TypeParameters), pattern, schema, budget)
}

fn pack_schema_bindings(caller Node, parameters List[Node], pattern Node, schema Node,
    budget List[Int]) Option[PackForwardMatch] {
    let bindings = PackForwardMatch {
        values = new[List[Node]](),
        known = new[Bool]()
    }
    var index = 0
    while index < length(parameters) {
        push(bindings.values, new[Node]())
        push(bindings.known, false)
        index = index + 1
    }
    let work = [PackForwardShape {
            pattern = pattern,
            actual = schema,
            element = false
        }]
    let solutions = new[PackForwardMatch]()
    pack_forward_search(parameters, group(caller, NodeKind.TypeParameters), work, bindings, solutions, budget, 0)
    if get(budget, 0) > 0 && length(solutions) == 1 {
        Option.Some(get(solutions, 0))
    } else {
        Option.None
    }
}

// A symbolic capability cannot hide an ill-formed nested data argument. Match
// nominal slots with the same word rules and discharge their declared bounds.
fn pack_layout_well_formed(context Context, caller Node, schema Node, budget List[Int], depth Int) Result[Bool, Failure] {
    pack_layout_well_formed(context, caller, schema, budget, depth, Option.None)
}

fn pack_layout_well_formed(context Context, caller Node, schema Node, budget List[Int], depth Int,
    assumptions Option[List[PackLayoutRequirement]]) Result[Bool, Failure] {
    if depth >= 64 || get(budget, 0) == 0 {
        return Result.Ok(false)
    }
    set(budget, 0, get(budget, 0) - 1)
    if schema.kind == NodeKind.DynType && has_type_expansion(schema) {
        return pack_dynamic_word_header(context, caller, schema, budget, depth + 1, assumptions)
    }
    if schema.kind == NodeKind.AssociatedType && length(group(schema, NodeKind.TypeParameters)) > 0 {
        // A family body is checked under its own parameters by pack_dynamic_type.
        return Result.Ok(true)
    }
    var index = 0
    while index < length(schema.children) {
        if !pack_layout_well_formed(context, caller, child(schema, index), budget, depth + 1, assumptions)? {
            return Result.Ok(false)
        }
        index = index + 1
    }
    if schema.kind == NodeKind.Select || schema.kind == NodeKind.DynType {
        return Result.Ok(pack_symbolic_type(context, caller, schema, pack_projection_scope(context),
                budget, depth + 1, assumptions)? >= 0)
    }
    if schema.kind != NodeKind.Type || !std.text.starts_with(schema.value, "nominal#") {
        return Result.Ok(true)
    }
    let owner = match std.int.parse(slice(schema.value, 8, length(schema.value))) {
        Result.Ok(value) => value
        Result.Err(_) => {
            return Result.Ok(false)
        }
    }
    let declaration = symbol(context.env, owner)
    let parameters = group(declaration.node, NodeKind.TypeParameters)
    let arguments = new[Node]()
    index = 0
    while index < length(parameters) {
        let parameter = get(parameters, index)
        let ty = pack_node(parameter, NodeKind.Type, concat("$parameter#", std.int.to_text(index)), new[Node]())
        push(arguments, if parameter.kind == NodeKind.TypePack {
                let spread = pack_node(parameter, NodeKind.Spread, "", source_nodes(ty))
                if type_pack_count(declaration.node) > 1 {
                    pack_node(parameter, NodeKind.TupleType, "tuple", source_nodes(spread))
                } else {
                    spread
                }
            } else {
                ty
            })
        index = index + 1
    }
    let target = pack_node(declaration.node, NodeKind.Type, concat("nominal#", std.int.to_text(owner)), arguments)
    match pack_schema_bindings(caller, parameters, target, schema, budget) {
        Option.Some(bindings) => pack_layout_prerequisites(context, caller, owner, parameters,
            bindings, new[PackLayoutRequirement](), budget, 0, assumptions)
        Option.None => Result.Ok(false)
    }
}

// Establish capabilities of a whole symbolic type word by matching source impl
// headers. This is entailment, not overlap testing or arity specialization.
fn pack_layout_admitted(context Context, caller Node, schema Node, capability Int,
    path List[PackLayoutRequirement], budget List[Int], depth Int) Result[Bool, Failure] {
    pack_layout_admitted(context, caller, schema, capability, path, budget, depth, Option.None)
}

// Explicit assumptions describe logical variables in this caller's complete
// schema frame. They never reinterpret concrete instance arguments as a word.
fn pack_layout_admitted(context Context, caller Node, schema Node, capability Int,
    path List[PackLayoutRequirement], budget List[Int], depth Int,
    assumptions Option[List[PackLayoutRequirement]]) Result[Bool, Failure] {
    if depth >= 64 || get(budget, 0) == 0 {
        return Result.Ok(false)
    }
    set(budget, 0, get(budget, 0) - 1)
    if schema.kind == NodeKind.DynType && has_type_expansion(schema) &&
    pack_dynamic_capability(context, schema)? == capability {
        return pack_dynamic_word_header(context, caller, schema, budget, depth + 1, assumptions)
    }
    if schema.kind == NodeKind.Select || schema.kind == NodeKind.DynType {
        let obligations = pack_projection_scope(context)
        let ty = pack_symbolic_type(context, caller, schema, obligations, budget, depth + 1, assumptions)?
        if ty < 0 {
            return Result.Ok(false)
        }
        return admitted(context.env, pack_layout_owner(context), obligations, ty, capability)
    }
    let source = group(caller, NodeKind.TypeParameters)
    let parameter = pack_schema_parameter(schema)
    if parameter >= 0 {
        match assumptions {
            Option.Some(known) => {
                var index = 0
                while index < length(known) {
                    let requirement = get(known, index)
                    if requirement.capability == capability && pack_schema_equal(requirement.schema, schema) {
                        return Result.Ok(true)
                    }
                    index = index + 1
                }
                return Result.Ok(false)
            }
            Option.None => {
            }
        }
        let bounds = get(source, parameter).children
        var index = 0
        while index < length(bounds) {
            if required_concept(context.env, pack_layout_owner(context), get(bounds, index))? == capability {
                return Result.Ok(true)
            }
            index = index + 1
        }
        return Result.Ok(false)
    }
    // Already checked identities (including scoped families) keep ordinary
    // evidence only when their complete encoded structure matches.
    let identity = pack_schema_identity(context.env, schema)
    if identity >= 0 {
        return satisfies(context, identity, capability)
    }
    var index = 0
    while index < depth {
        let earlier = get(path, index)
        if earlier.capability == capability && pack_schema_equal(earlier.schema, schema) {
            return Result.Ok(false)
        }
        index = index + 1
    }
    let here = PackLayoutRequirement {
        schema = schema,
        capability = capability
    }
    if depth == length(path) {
        push(path, here)
    } else {
        set(path, depth, here)
    }
    let protocol = get(context.env.concepts, concept_index(context.env, capability))
    let candidates = std.list.clone(protocol.implementations)
    index = 0
    while index < length(protocol.families) {
        push(candidates, get(protocol.families, index))
        index = index + 1
    }
    index = 0
    while index < length(candidates) && get(budget, 0) > 0 {
        let header = get(context.env.implementations, get(candidates, index))
        let owner = header.source
        let declaration = symbol(context.env, owner)
        // Materialized widths are not a proof of the original family. Test-only
        // implementations likewise cannot supply production evidence.
        if length(header.widths) == 0 &&
        (!declaration.test_only || symbol(context.env, pack_layout_owner(context)).test_only) {
            let parameters = group(declaration.node, NodeKind.TypeParameters)
            match pack_layout_bindings(context, caller, owner, child(declaration.node, 1), schema, budget) {
                Option.Some(bindings) => {
                    if pack_layout_prerequisites(context, caller, owner, parameters, bindings, path, budget, depth + 1, assumptions)? {
                        return Result.Ok(true)
                    }
                }
                Option.None => {
                }
            }
        }
        index = index + 1
    }
    Result.Ok(false)
}

fn pack_layout_prerequisites(context Context, caller Node, owner Int, parameters List[Node],
    bindings PackForwardMatch, path List[PackLayoutRequirement], budget List[Int], depth Int) Result[Bool, Failure] {
    pack_layout_prerequisites(context, caller, owner, parameters, bindings, path, budget, depth, Option.None)
}

fn pack_layout_prerequisites(context Context, caller Node, owner Int, parameters List[Node],
    bindings PackForwardMatch, path List[PackLayoutRequirement], budget List[Int], depth Int,
    assumptions Option[List[PackLayoutRequirement]]) Result[Bool, Failure] {
    var index = 0
    while index < length(parameters) {
        if !get(bindings.known, index) {
            return Result.Ok(false)
        }
        let parameter = get(parameters, index)
        let sequence = get(bindings.values, index)
        var bound = 0
        while bound < length(parameter.children) {
            let capability = required_concept(context.env, owner, child(parameter, bound))?
            var member = 0
            while member < length(sequence) {
                let item = get(sequence, member)
                let actual = if item.kind == NodeKind.Spread {
                    child(item, 0)
                } else {
                    item
                }
                if !pack_layout_admitted(context, caller, actual, capability, path, budget, depth, assumptions)? {
                    return Result.Ok(false)
                }
                member = member + 1
            }
            bound = bound + 1
        }
        index = index + 1
    }
    Result.Ok(true)
}

// Evidence is local to shape checking. It neither qualifies a raw pack element
// nor changes a family signature, exported summary or runtime witness.
fn pack_layout_evidence(context Context, caller Node) Result[Context, Failure] {
    let layouts = pack_proof_layouts(caller)
    var scope = context
    var index = 0
    while index < length(layouts) {
        let layout = get(layouts, index)
        let schema = pack_forward_source_schema(context, caller, layout)?
        if !pack_layout_well_formed(context, caller, schema, ints(512), 0)? {
            return Result.Err(error(context, layout, "variadic nested layout needs well-formed data arguments for every member"))
        }
        let ty = resolve_bound(context.env, context.signature.symbol,
            pack_node(layout, NodeKind.Type, pack_proof_layout_type(index), new[Node]()),
            context.arguments, context.signature.requirements, 0)?
        var capability_index = 0
        while capability_index < length(context.env.concepts) {
            let capability = get(context.env.concepts, capability_index).symbol
            if pack_layout_admitted(context, caller, schema, capability, new[PackLayoutRequirement](), ints(512), 0)? {
                scope = with_evidence(scope, ty, capability)
            }
            capability_index = capability_index + 1
        }
        index = index + 1
    }
    Result.Ok(scope)
}
