// A predicate's checked closure is closed over named function references.
// Analyze every matching target, not just one chosen by a sample execution.
// A callback coming from self, or one carrying captures, is still opaque here.
fn invariant_references(value Expr, references List[Expr]) {
    if value.kind == ExprKind.FunctionRef {
        var index = 0
        var found = false
        while index < length(references) {
            let prior = get(references, index)
            if prior.index == value.index && prior.ty == value.ty && length(prior.children) == length(value.children) {
                found = true
            }
            index = index + 1
        }
        if !found {
            push(references, value)
        }
    }
    var index = 0
    while index < length(value.children) {
        invariant_references(get(value.children, index), references)
        index = index + 1
    }
    index = 0
    while index < length(value.arms) {
        let arm = get(value.arms, index)
        var item = 0
        while item < length(arm.body) {
            invariant_references(get(arm.body, item), references)
            item = item + 1
        }
        index = index + 1
    }
}

fn invariant_indirect(reads InvariantReads, call Expr, inputs List[InputOrigin], depth Int) InputOrigin {
    if origin_shared(get(inputs, 0)) {
        set(reads.valid, 0, false)
        return origin_input()
    }
    let arguments = new[InputOrigin]()
    var index = 1
    while index < length(inputs) {
        push(arguments, get(inputs, index))
        index = index + 1
    }
    let shape = get(call.children, 0).ty
    var found = false
    var output = origin_empty()
    index = 0
    while index < length(reads.references) && get(reads.valid, 0) {
        let reference = get(reads.references, index)
        if reference.ty == shape {
            if length(reference.children) != 0 || reference.index < 0 ||
            reference.index >= length(reads.functions) ||
            length(get(reads.functions, reference.index).params) != length(arguments) {
                set(reads.valid, 0, false)
                return origin_input()
            }
            found = true
            output = origin_union(output, invariant_call(reads, reference.index, arguments, depth + 1))
        }
        index = index + 1
    }
    if !found {
        set(reads.valid, 0, false)
        return origin_input()
    }
    output
}
