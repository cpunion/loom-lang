import std.loom.ast.Node
import std.loom.ast.NodeKind
import std.loom.typed.Expr
import std.loom.typed.ExprKind
import std.loom.typed.Local
import std.loom.typed.Function
import std.loom.typed.Program
import std.loom.typed.TypeKind
import std.loom.eval.Value
import std.loom.eval.evaluate
import std.list.new
import std.list.get
import std.list.push
import std.list.length
import std.int.to_text
import std.result.Result

fn abstract_context(context Context) Bool {
    var index = 0
    while index < length(context.arguments) {
        if !concrete(context.env, get(context.arguments, index)) { return true }
        index = index + 1
    }
    !known_constants(context.constants)
}
fn parameter_name(context Context, name Text) Bool {
    if name == "Self" && enclosing(context.env, context.signature.symbol) >= 0 { return true }
    let parameters = type_parameters(context.env, context.signature.symbol)
    var index = 0
    while index < length(parameters) {
        if name == get(parameters, index).value { return true }
        index = index + 1
    }
    false
}
fn depends_on_type(context Context, node Node) Bool {
    if node.kind == NodeKind.Type && parameter_name(context, slice(node.value, 0, first_dot(node.value))) { return true }
    if node.kind == NodeKind.Implements && type_parameter_operand(context, child(node, 0)) { return true }
    if node.kind == NodeKind.Binary && (node.value == "==" || node.value == "!=") &&
        type_operand(context, child(node, 0)) && type_operand(context, child(node, 1)) &&
        (type_parameter_operand(context, child(node, 0)) || type_parameter_operand(context, child(node, 1))) { return true }
    var index = 0
    while index < length(node.children) {
        if depends_on_type(context, child(node, index)) { return true }
        index = index + 1
    }
    false
}

// This is an unknown check-only obligation, never an invented constant or an
// unreachable branch. The prover rejects it when a required proof needs it.
fn deferred(context Context, node Node, expected Int) Result[Expr, Failure] {
    if context.emit { return Result.Err(error(context, node, "compile-time selection must be determined for this instance")) }
    if expected < 0 { return Result.Err(error(context, node, "type-dependent comptime expression needs an explicit result type")) }
    Result.Ok(expression(ExprKind.Deferred, expected, node, "", -1, new[Expr](), true))
}
fn staging(context Context, node Node) Result[Context, Failure] {
    if context.env.stage_depth >= 32 {
        return Result.Err(error(context, node, "compile-time staging depth exceeded; check for a dependency cycle"))
    }
    // Compile-time call targets never enter the runtime reachability queue.
    let env = Environment { source = context.env.source types = context.env.types type_states = context.env.type_states expand_data = true signatures = context.env.signatures
        pending = new[Instance]() stage_depth = context.env.stage_depth + 1 computations = context.env.computations
        validations = context.env.validations
        concepts = context.env.concepts implementations = context.env.implementations interfaces = context.env.interfaces
        associations = context.env.associations association_depth = context.env.association_depth
        witnesses = new[Witness]() uses = new[SlotUse]() }
    let locals = new[Local]()
    var index = 0
    while index < length(context.locals) { push(locals, get(context.locals, index))
        index = index + 1 }
    let bindings = new[Binding]()
    index = 0
    while index < length(context.bindings) { push(bindings, get(context.bindings, index))
        index = index + 1 }
    Result.Ok(Context { env = env signature = context.signature arguments = context.arguments
        constants = context.constants locals = locals bindings = bindings head = context.head
        cleanups = new[Cleanup]() cleanup_head = -1 emit = true })
}
fn isolated(context Context, node Node, value Expr, boundary Int) Result[Bool, Failure] {
    if value.kind == ExprKind.Local && value.index < boundary {
        return Result.Err(error(context, node, "comptime cannot capture a runtime binding"))
    }
    if value.kind == ExprKind.Assign && value.index < boundary {
        return Result.Err(error(context, node, "comptime cannot assign a runtime binding"))
    }
    if value.kind == ExprKind.Return {
        return Result.Err(error(context, node, "return cannot cross a comptime block boundary; use its tail value"))
    }
    var index = 0
    while index < length(value.children) {
        discard isolated(context, node, get(value.children, index), boundary)?
        index = index + 1
    }
    index = 0
    while index < length(value.arms) {
        let arm = get(value.arms, index)
        var item = 0
        while item < length(arm.body) {
            discard isolated(context, node, get(arm.body, item), boundary)?
            item = item + 1
        }
        index = index + 1
    }
    Result.Ok(true)
}
fn prepared(stage Context) Result[std.loom.typed.Program, Failure] {
    let functions = emit_functions(stage.env, false)?
    Result.Ok(std.loom.typed.Program { types = stage.env.types functions = functions entry = -1 tests = new[Int]() exports = new[Int]()
        interfaces = stage.env.interfaces witnesses = stage.env.witnesses })
}
fn computed(context Context, node Node, input Node, expected Int) Result[Value, Failure] {
    let stage = staging(context, node)?
    let value = expr(stage, input, expected)?
    discard isolated(context, node, value, length(context.locals))?
    // Type/capture validation always runs before reuse, including shadowed names.
    let saved = computation(context, input, expected, value.ty)
    if saved >= 0 { return Result.Ok(get(context.env.computations, saved).value) }
    let program = prepared(stage)?
    match std.loom.eval.evaluate(program, value, length(stage.locals)) {
        Result.Ok(value) => {
            push(context.env.computations, Computation { owner = context.signature.symbol arguments = context.arguments
                constants = context.constants node = input expected = expected ty = value.ty value = value })
            Result.Ok(value)
        }
        Result.Err(failed) => Result.Err(error(context, node, failed.message))
    }
}

fn type_operand(context Context, node Node) Bool {
    if node.kind == NodeKind.AssociatedType { return type_operand(context, child(node, 0)) }
    if node.kind == NodeKind.FunctionType {
        var group = 0
        while group < length(node.children) {
            let types = child(node, group).children
            var index = 0
            while index < length(types) {
                if !type_operand(context, get(types, index)) { return false }
                index = index + 1
            }
            group = group + 1
        }
        return true
    }
    if (node.kind != NodeKind.Name && node.kind != NodeKind.Type && node.kind != NodeKind.Tuple && node.kind != NodeKind.TupleType && node.kind != NodeKind.DynType) ||
        lookup(context, slice(node.value, 0, first_dot(node.value))) >= 0 { return false }
    var index = 0
    while index < length(node.children) {
        if !type_operand(context, child(node, index)) { return false }
        index = index + 1
    }
    true
}
fn type_parameter_operand(context Context, node Node) Bool {
    if node.kind == NodeKind.AssociatedType { return type_parameter_operand(context, child(node, 0)) }
    if parameter_name(context, slice(node.value, 0, first_dot(node.value))) { return true }
    var index = 0
    while index < length(node.children) {
        if type_parameter_operand(context, child(node, index)) { return true }
        index = index + 1
    }
    false
}
fn selected(context Context, node Node, source Node, expected Int, enforce Bool) Result[Expr, Failure] {
    let condition = child(source, 0)
    var yes = false
    var chosen = context
    if condition.kind == NodeKind.Implements {
        if !type_operand(context, child(condition, 0)) {
            return Result.Err(error(context, condition, "implements requires an unshadowed type operand"))
        }
        let ty = context_type(context, child(condition, 0))?
        let capability = required_concept(context.env, context.signature.symbol, child(condition, 1))?
        yes = satisfies(context, ty, capability)?
        if !yes && !concrete(context.env, ty) { return deferred(context, node, expected) }
        if yes { chosen = with_evidence(context, ty, capability) }
    } else { if condition.kind == NodeKind.Binary && (condition.value == "==" || condition.value == "!=") &&
        (type_operand(context, child(condition, 0)) || type_operand(context, child(condition, 1)) ||
            child(condition, 0).kind == NodeKind.Type || child(condition, 1).kind == NodeKind.Type ||
            child(condition, 0).kind == NodeKind.TupleType || child(condition, 1).kind == NodeKind.TupleType) {
        if !type_operand(context, child(condition, 0)) || !type_operand(context, child(condition, 1)) {
            return Result.Err(error(context, condition, "comptime type comparison requires two unshadowed types"))
        }
        let left = context_type(context, child(condition, 0))?
        let right = context_type(context, child(condition, 1))?
        if left != right && (!concrete(context.env, left) || !concrete(context.env, right)) {
            return deferred(context, node, expected)
        }
        yes = if condition.value == "==" { left == right } else { left != right }
    } else {
        let type_dependent = abstract_context(context) && depends_on_type(context, condition)
        if type_dependent || unknown_static(context, condition) {
            let stage = staging(context, node)?
            let validation = Context { env = stage.env signature = stage.signature arguments = stage.arguments
                constants = stage.constants locals = stage.locals bindings = stage.bindings head = stage.head
                cleanups = stage.cleanups cleanup_head = stage.cleanup_head emit = false }
            let value = expr(validation, condition, 2)?
            discard isolated(context, node, value, length(context.locals))?
            if type_dependent || contains_deferred(value) { return deferred(context, node, expected) }
        }
        yes = computed(context, node, condition, 2)?.number != 0
    } }
    if yes { return block(chosen, child(source, 1), expected, enforce) }
    if length(source.children) == 3 { return block(context, child(source, 2), expected, enforce) }
    typed(context, node, expression(ExprKind.Block, 0, node, "", -1, new[Expr](), true), expected)
}
fn compile_time(context Context, node Node, expected Int, enforce Bool) Result[Expr, Failure] {
    let source = child(node, 0)
    if source.kind == NodeKind.If { return selected(context, node, source, expected, enforce) }
    let type_dependent = abstract_context(context) && depends_on_type(context, source)
    if type_dependent || unknown_static(context, source) {
        let stage = staging(context, node)?
        let validation = Context { env = stage.env signature = stage.signature arguments = stage.arguments
            constants = stage.constants locals = stage.locals bindings = stage.bindings head = stage.head
            cleanups = stage.cleanups cleanup_head = stage.cleanup_head emit = false }
        let value = block(validation, source, expected, enforce)?
        discard isolated(context, node, value, length(context.locals))?
        // Syntax may mention a shadowed static name. Only checked IR can show
        // that this computation still depends on its unknown value.
        if type_dependent || contains_deferred(value) { return deferred(context, node, value.ty) }
    }
    materialize(context, node, computed(context, node, source, expected)?)
}
