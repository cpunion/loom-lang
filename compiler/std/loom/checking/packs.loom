import std.loom.binding.Symbol
import std.loom.typed.TypeKind

// Arity selects a normal generic declaration, not concrete element types.
// These entries share the signature table across private CTFE/proof queues.
// An arity of -1 registers a source declaration, without a signature or proof.
record PackInstance {
    source Int
    arity Int
    signature Int
    state Int
}

fn pack_parameter(node Node) Int {
    let parameters = group(node, NodeKind.TypeParameters)
    var index = 0
    while index < length(parameters) {
        if get(parameters, index).kind == NodeKind.TypePack {
            return index
        }
        index = index + 1
    }
    -1
}

fn mentions_pack(node Node, name Text) Bool {
    if (node.kind == NodeKind.Type || node.kind == NodeKind.Name) && node.value == name {
        return true
    }
    var index = 0
    while index < length(node.children) {
        if mentions_pack(child(node, index), name) {
            return true
        }
        index = index + 1
    }
    false
}

// A structural pack takes one tuple at runtime, with one expanded type pattern.
// Direct packs still take one runtime argument per element.
fn tuple_pack_parameter(parameter Node) Bool {
    let ty = child(parameter, 0)
    return ty.kind == NodeKind.TupleType && length(ty.children) == 1 &&
        child(ty, 0).kind == NodeKind.Spread
}

fn validate_pack(env Environment, owner Int) Result[Bool, Failure] {
    let item = symbol(env, owner)
    let selected = pack_parameter(item.node)
    let parameters = group(item.node, NodeKind.Parameters)
    if selected < 0 {
        var index = 0
        while index < length(parameters) {
            let parameter = get(parameters, index)
            if parameter.kind == NodeKind.Parameter && child(parameter, 0).kind == NodeKind.Spread {
                return Result.Err(failure(env, owner, parameter, "a variadic parameter needs a declared type pack"))
            }
            index = index + 1
        }
        return Result.Ok(false)
    }
    if item.node.kind != NodeKind.Function || item.owner >= 0 || has(item.node, NodeKind.Intrinsic) {
        return Result.Err(failure(env, owner, item.node, "type packs currently belong to ordinary top-level functions"))
    }
    if has(item.node, NodeKind.Ensures) {
        return Result.Err(failure(env, owner, item.node, "variadic postconditions require a proof over every arity; that proof is not supported yet"))
    }
    let types = group(item.node, NodeKind.TypeParameters)
    if selected + 1 != length(types) {
        return Result.Err(failure(env, owner, get(types, selected), "declare one type pack, last in the type parameter list"))
    }
    if length(parameters) == 0 {
        return Result.Err(failure(env, owner, item.node, "a type pack needs a final value parameter that expands it"))
    }
    var clause = 0
    while clause < length(item.node.children) {
        let condition = child(item.node, clause)
        if condition.kind == NodeKind.Requires && pack_contract(condition, get(parameters, length(parameters) - 1).value) {
            return Result.Err(failure(env, owner, condition, "variadic preconditions currently use fixed scalar parameters, not the tuple pack"))
        }
        clause = clause + 1
    }
    let pack = get(types, selected)
    var bound = 0
    while bound < length(pack.children) {
        discard required_concept(env, owner, child(pack, bound))?
        var previous = 0
        while previous < bound {
            if required_concept(env, owner, child(pack, previous))? == required_concept(env, owner, child(pack, bound))? {
                return Result.Err(failure(env, owner, child(pack, bound), "duplicate concept requirement"))
            }
            previous = previous + 1
        }
        bound = bound + 1
    }
    var index = 0
    while index < length(parameters) {
        let parameter = get(parameters, index)
        let spread = child(parameter, 0).kind == NodeKind.Spread
        let tuple = tuple_pack_parameter(parameter)
        let final = index + 1 == length(parameters)
        if final && !spread && !tuple && child(parameter, 0).kind == NodeKind.TupleType &&
            mentions_pack(child(parameter, 0), pack.value) {
            return Result.Err(failure(env, owner, parameter, "a structural tuple pack currently contains only one expanded type pattern"))
        }
        if (spread || tuple) != final || ((spread || tuple) && has(parameter, NodeKind.Comptime)) {
            return Result.Err(failure(env, owner, parameter, "the final runtime parameter alone expands the type pack"))
        }
        if spread && !mentions_pack(child(parameter, 0), pack.value) {
            return Result.Err(failure(env, owner, parameter, "the variadic parameter type must use the declared pack"))
        }
        if tuple {
            if !mentions_pack(child(child(parameter, 0), 0), pack.value) {
                return Result.Err(failure(env, owner, parameter, "the tuple expansion type must use the declared pack"))
            }
        }
        index = index + 1
    }
    if has(item.node, NodeKind.Test) || (item.name == "main" && get(env.source.files, item.file).package == env.source.root && !item.test_only) {
        return Result.Err(failure(env, owner, item.node, "main and tests take no parameters and omit the return type"))
    }
    Result.Ok(true)
}

fn pack_node(node Node, kind NodeKind, value Text, children List[Node]) Node {
    Node {
        kind = kind
        value = value
        span = node.span
        children = children
    }
}

fn pack_name(pack Text, index Int) Text {
    concat(concat("$", pack), std.int.to_text(index))
}

// Only type positions substitute a pack name. Runtime identifiers and source
// spans remain intact; this is typed-declaration elaboration, not text macros.
fn expand_pack_type(env Environment, owner Int, node Node, pack Text, arity Int, element Int, types Bool, depth Int) Result[Node, Failure] {
    if depth >= 64 {
        return Result.Err(failure(env, owner, node, "type pack expansion nesting limit exceeded"))
    }
    let type_context = types || node.kind == NodeKind.Type || node.kind == NodeKind.TupleType || node.kind == NodeKind.FunctionType || node.kind == NodeKind.TypeArguments
    if type_context && (node.kind == NodeKind.Type || node.kind == NodeKind.Name) && node.value == pack {
        if element < 0 {
            return Result.Err(failure(env, owner, node, "expand a type pack with ...; it is not one type"))
        }
        return Result.Ok(pack_node(node, node.kind, pack_name(pack, element), node.children))
    }
    let children = new[Node]()
    var index = 0
    while index < length(node.children) {
        let child = child(node, index)
        let child_types = type_context || (node.kind == NodeKind.Parameter && index == 0)
        if child_types && child.kind == NodeKind.Spread {
            let pattern = get(child.children, 0)
            if !mentions_pack(pattern, pack) {
                return Result.Err(failure(env, owner, child, "type expansion must use this declaration's pack"))
            }
            var selected = 0
            while selected < arity {
                push(children, expand_pack_type(env, owner, pattern, pack, arity, selected, true, depth + 1)?)
                selected = selected + 1
            }
        } else {
            push(children, expand_pack_type(env, owner, child, pack, arity, element, child_types, depth + 1)?)
        }
        index = index + 1
    }
    Result.Ok(pack_node(node, node.kind, node.value, children))
}

fn pack_contract(node Node, name Text) Bool {
    if (node.kind == NodeKind.Name || node.kind == NodeKind.Call) && slice(node.value, 0, first_dot(node.value)) == name {
        return true
    }
    var index = 0
    while index < length(node.children) {
        if pack_contract(child(node, index), name) {
            return true
        }
        index = index + 1
    }
    false
}

fn pack_pattern_binds(node Node, name Text) Bool {
    if node.kind == NodeKind.Name && node.value == name { return true }
    var index = 0
    while index < length(node.children) {
        if pack_pattern_binds(child(node, index), name) { return true }
        index = index + 1
    }
    false
}

fn pack_local_binds(node Node, name Text) Bool {
    if node.kind == NodeKind.Let || node.kind == NodeKind.Var || node.kind == NodeKind.Scoped {
        return node.value == name
    }
    if node.kind == NodeKind.Destructure {
        return pack_pattern_binds(child(node, 0), name)
    }
    false
}

fn has_pack_iteration(node Node) Bool {
    if node.kind == NodeKind.ComptimeFor || node.kind == NodeKind.ComptimeMap { return true }
    var index = 0
    while index < length(node.children) {
        if has_pack_iteration(child(node, index)) { return true }
        index = index + 1
    }
    false
}

// Repeated bodies are ordinary lexical blocks after the selected arity is
// known. Tuple projections retain the existing move, effect and cleanup rules.
fn expand_pack_iteration(env Environment, owner Int, node Node, values Text, arity Int, shadowed Bool, repeated Bool, pack_mode Bool, depth Int, count List[Int]) Result[Node, Failure] {
    if depth >= 64 || get(count, 0) >= 65536 {
        // A dead comptime branch must not fail before the selected body is
        // checked. Keep the budget diagnostic in that branch as source AST.
        return Result.Ok(pack_node(node, NodeKind.PackError, "static pack iteration expansion budget exceeded", new[Node]()))
    }
    let identity = get(count, 0) + 1
    set(count, 0, identity)
    if node.kind == NodeKind.ComptimeFor || node.kind == NodeKind.ComptimeMap {
        let mapping = node.kind == NodeKind.ComptimeMap
        let source = child(node, 0)
        if mapping && !pack_mode { return Result.Ok(node) }
        if mapping && (source.kind != NodeKind.Name || source.value != values) {
            return Result.Ok(pack_node(source, NodeKind.PackError, "comptime map must use this function's final value pack", new[Node]()))
        }
        if mapping && shadowed {
            return Result.Ok(pack_node(source, NodeKind.PackError, "comptime map value pack is shadowed at this site", new[Node]()))
        }
        if source.kind == NodeKind.Name && source.value == values && !shadowed {
            let iterations = new[Node]()
            var index = 0
            while index < arity {
                let pack = pack_node(source, NodeKind.Name, values, new[Node]())
                let element = pack_node(source, NodeKind.Select, std.int.to_text(index), source_nodes(pack))
                let binding = pack_node(node, NodeKind.Let, node.value, source_nodes(element))
                let body = expand_pack_iteration(env, owner, child(node, 1), values, arity, node.value == values, true, pack_mode, depth + 1, count)?
                let statements = source_nodes(binding)
                push(statements, body)
                push(iterations, pack_node(node, NodeKind.Block, "", statements))
                index = index + 1
            }
            if mapping { return Result.Ok(pack_node(node, NodeKind.Tuple, "", iterations)) }
            // A static loop is a Unit statement even when it ends its parent block.
            push(iterations, pack_node(node, NodeKind.Block, "", new[Node]()))
            return Result.Ok(pack_node(node, NodeKind.Block, "", iterations))
        }
        // A foreign or shadowed tuple loop remains for the body checker, but
        // its body still needs this outer expansion's closure identity.
    }
    let children = new[Node]()
    var index = 0
    var current_shadow = shadowed
    if node.kind == NodeKind.Function && node.value == "" {
        let parameters = group(node, NodeKind.Parameters)
        while index < length(parameters) {
            current_shadow = current_shadow || get(parameters, index).value == values
            index = index + 1
        }
    }
    index = 0
    while index < length(node.children) {
        let member = child(node, index)
        if !(repeated && node.kind == NodeKind.Function && node.value == "" && member.kind == NodeKind.ExpansionId) {
            let member_shadow = if node.kind == NodeKind.Arm && index == 1 {
                current_shadow || pack_pattern_binds(child(node, 0), values)
            } else if node.kind == NodeKind.ComptimeFor && index == 1 {
                current_shadow || node.value == values
            } else { current_shadow }
            push(children, expand_pack_iteration(env, owner, member, values, arity, member_shadow, repeated, pack_mode, depth + 1, count)?)
            if node.kind == NodeKind.Block && pack_local_binds(member, values) {
                current_shadow = true
            }
        }
        index = index + 1
    }
    if repeated && node.kind == NodeKind.Function && node.value == "" {
        let previous = part(node, NodeKind.ExpansionId)
        let suffix = std.int.to_text(identity)
        let marker = if previous < 0 { suffix } else { concat(child(node, previous).value, concat(".", suffix)) }
        push(children, pack_node(node, NodeKind.ExpansionId, marker, new[Node]()))
    }
    Result.Ok(pack_node(node, node.kind, node.value, children))
}

fn pack_declaration(env Environment, owner Int, arity Int) Result[Node, Failure] {
    let declaration = symbol(env, owner).node
    let types = group(declaration, NodeKind.TypeParameters)
    let pack = get(types, length(types) - 1)
    let parameters = group(declaration, NodeKind.Parameters)
    let values = get(parameters, length(parameters) - 1)
    let structural = tuple_pack_parameter(values)
    let expanded_types = new[Node]()
    var index = 0
    while index + 1 < length(types) {
        push(expanded_types, get(types, index))
        index = index + 1
    }
    index = 0
    while index < arity {
        push(expanded_types, pack_node(pack, NodeKind.Name, pack_name(pack.value, index), pack.children))
        index = index + 1
    }
    let expanded_params = new[Node]()
    index = 0
    while index + 1 < length(parameters) {
        push(expanded_params, expand_pack_type(env, owner, get(parameters, index), pack.value, arity, -1, false, 0)?)
        index = index + 1
    }
    let elements = new[Node]()
    if structural {
        push(expanded_params, expand_pack_type(env, owner, values, pack.value, arity, -1, false, 0)?)
    } else {
        index = 0
        while index < arity {
            let name = pack_name(values.value, index)
            let ty = expand_pack_type(env, owner, child(child(values, 0), 0), pack.value, arity, index, true, 0)?
            push(expanded_params, pack_node(values, NodeKind.Parameter, name, source_nodes(ty)))
            push(elements, pack_node(values, NodeKind.Name, name, new[Node]()))
            index = index + 1
        }
    }
    let tuple = pack_node(values, NodeKind.Tuple, "", elements)
    let children = new[Node]()
    index = 0
    while index < length(declaration.children) {
        let member = child(declaration, index)
        if member.kind == NodeKind.TypeParameters {
            push(children, pack_node(member, member.kind, "", expanded_types))
        } else {
            if member.kind == NodeKind.Parameters {
                push(children, pack_node(member, member.kind, "", expanded_params))
            } else {
                let typed = expand_pack_type(env, owner, member, pack.value, arity, -1, false, 0)?
                let expanded = if has_pack_iteration(typed) {
                    let count = new[Int]()
                    push(count, 0)
                    expand_pack_iteration(env, owner, typed, values.value, arity, false, false, true, 0, count)?
                } else { typed }
                if member.kind == NodeKind.Block {
                    let body = if structural { new[Node]() } else {
                        source_nodes(pack_node(values, NodeKind.Let, values.value, source_nodes(tuple)))
                    }
                    // The source body retains its own scope, including shadowing
                    // the immutable parameter name and lexical cleanup boundaries.
                    push(body, expanded)
                    push(children, pack_node(member, NodeKind.Block, "", body))
                } else {
                    push(children, expanded)
                }
            }
        }
        index = index + 1
    }
    Result.Ok(pack_node(declaration, NodeKind.Function, declaration.value, children))
}

fn pack_instance(env Environment, signature Int) Int {
    var index = 0
    while index < length(env.packs) {
        if get(env.packs, index).signature == signature {
            return index
        }
        index = index + 1
    }
    -1
}

fn pack_signature(env Environment, owner Int, arity Int) Result[Int, Failure] {
    var count = 0
    var index = 0
    while index < length(env.packs) {
        let existing = get(env.packs, index)
        if existing.source == owner {
            if existing.arity == arity {
                return Result.Ok(existing.signature)
            }
            if existing.arity >= 0 {
                count = count + 1
            }
        }
        index = index + 1
    }
    let item = symbol(env, owner)
    if count >= 1024 || arity > 1024 {
        return Result.Err(failure(env, owner, item.node, "type pack specialization budget exceeded; expansion must be finite"))
    }
    let expanded = pack_declaration(env, owner, arity)?
    let source = length(env.source.symbols)
    push(env.source.symbols, Symbol {
            file = item.file
            node = expanded
            name = item.name
            public = false
            test_only = item.test_only
            owner = owner
        })
    let arguments = abstract_arguments(env, function_parameter_count(env, source))
    let current = source_signature(env, source, arguments, requirements(env, source, arguments)?)?
    let selected = length(env.signatures)
    push(env.signatures, current)
    push(env.packs, PackInstance {
            source = owner
            arity = arity
            signature = selected
            state = 0
        })
    Result.Ok(selected)
}

fn check_pack_arity(env Environment, signature Int) Result[Bool, Failure] {
    let index = pack_instance(env, signature)
    if index < 0 {
        return Result.Ok(false)
    }
    let pack = get(env.packs, index)
    if pack.state != 0 {
        return Result.Ok(true)
    }
    var active = 0
    var visiting = 0
    while visiting < length(env.packs) {
        if get(env.packs, visiting).state == 1 {
            active = active + 1
        }
        visiting = visiting + 1
    }
    if active >= 64 {
        return Result.Err(failure(env, pack.source, symbol(env, pack.source).node, "type pack specialization depth exceeded; expansion must be finite"))
    }
    set(env.packs, index, PackInstance {
            source = pack.source
            arity = pack.arity
            signature = signature
            state = 1
        })
    let current = get(env.signatures, signature)
    match function(env, signature, abstract_arguments(env, current.parameters), unknown_constants(current), false) {
        Result.Ok(_) => {
            set(env.packs, index, PackInstance {
                    source = pack.source
                    arity = pack.arity
                    signature = signature
                    state = 2
                })
        }
        Result.Err(failed) => {
            // Optional compile-time folding can recover from a failure. It
            // must not leave a recursive visiting entry marked as checked.
            set(env.packs, index, PackInstance {
                    source = pack.source
                    arity = pack.arity
                    signature = signature
                    state = 0
                })
            return Result.Err(failed)
        }
    }
    Result.Ok(true)
}

fn pack_references(context Context, options List[Int], types List[Node], desired Int) Result[List[Int], Failure] {
    if length(context.env.packs) == 0 {
        return Result.Ok(options)
    }
    var has_pack = false
    var index = 0
    while index < length(options) {
        has_pack = has_pack || get(options, index) < 0
        index = index + 1
    }
    if !has_pack {
        return Result.Ok(options)
    }
    let choices = new[Int]()
    index = 0
    while index < length(options) {
        let id = get(options, index)
        if id >= 0 {
            push(choices, id)
        } else {
            let owner = -1 - id
            let declaration = symbol(context.env, owner).node
            let parameters = group(declaration, NodeKind.Parameters)
            let structural = tuple_pack_parameter(get(parameters, length(parameters) - 1))
            let arity = if desired >= 0 {
                let shape = get(context.env.types, desired).arguments
                if structural {
                    let position = length(parameters) - 1
                    if length(shape) == length(parameters) + 1 &&
                        get(context.env.types, get(shape, position)).kind == TypeKind.Tuple {
                        length(get(context.env.types, get(shape, position)).arguments)
                    } else { -1 }
                } else { length(shape) - length(parameters) }
            } else {
                if length(types) != 0 {
                    length(types) - pack_parameter(declaration)
                } else {
                    -1
                }
            }
            if arity >= 0 {
                push(choices, pack_signature(context.env, owner, arity)?)
            }
        }
        index = index + 1
    }
    Result.Ok(choices)
}
