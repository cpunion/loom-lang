import std.loom.binding.Symbol
import std.loom.typed.TypeKind

// Arity selects a normal generic declaration, not concrete element types.
// These entries share the signature table across private CTFE/proof queues.
// An arity of -1 registers a source declaration, without a signature or proof.
record PackInstance {
    source Int
    // A method's concept declaration; erased proofs use the erased header.
    // Ordinary packs use their own source. This is not a runtime slot.
    declaration Int
    // -1 = source family; -2 = erased proof, never a callable specialization.
    arity Int
    signature Int
    // -2 = method header expansion; 0 = unvisited, 1 = checking,
    // 2 = proved, 3 = queued, 4 =
    // checked in the current batch but not yet proved with its callees.
    state Int
    depth Int
}

fn pack_parameter(node Node) Int {
    let parameters = group(node, NodeKind.TypeParameters)
    var index = 0
    while index < length(parameters) {
        if get(parameters, index).kind == NodeKind.TypePack {
            return index
        }
        index = index + 1
    }
    -1
}

fn one_type_pack(node Node) Bool {
    let parameters = group(node, NodeKind.TypeParameters)
    var count = 0
    var index = 0
    while index < length(parameters) {
        if get(parameters, index).kind == NodeKind.TypePack {
            count = count + 1
        }
        index = index + 1
    }
    count == 1
}

fn fixed_pack_parameters(node Node) Int {
    length(group(node, NodeKind.TypeParameters)) - 1
}

// Fixed parameters retain declaration order on both sides of one sequence.
// Its width is total arguments minus fixed parameters, not its source index.
fn expand_pack_parameters(parameters List[Node], arity Int) List[Node] {
    let expanded = new[Node]()
    var index = 0
    while index < length(parameters) {
        let parameter = get(parameters, index)
        if parameter.kind == NodeKind.TypePack {
            var element = 0
            while element < arity {
                push(expanded, pack_node(parameter, NodeKind.Name,
                        pack_name(parameter.value, element), parameter.children))
                element = element + 1
            }
        } else {
            push(expanded, parameter)
        }
        index = index + 1
    }
    expanded
}

fn pack_root(node Node, name Text) Bool {
    (node.kind == NodeKind.Type || node.kind == NodeKind.Name) &&
    (node.value == name || (first_dot(node.value) == length(name) && std.text.starts_with(node.value, name)))
}

fn mentions_pack(node Node, name Text) Bool {
    if pack_root(node, name) {
        return true
    }
    var index = 0
    while index < length(node.children) {
        if mentions_pack(child(node, index), name) {
            return true
        }
        index = index + 1
    }
    false
}

// Every occurrence uses the declaration's same pack. Its arity is inferred
// from shape equations; ordinary inference checks all expanded element types.
fn tuple_pack_expansion(parameter Node) Int {
    let ty = child(parameter, 0)
    if ty.kind != NodeKind.TupleType {
        return -1
    }
    var index = 0
    while index < length(ty.children) {
        if child(ty, index).kind == NodeKind.Spread {
            return index
        }
        index = index + 1
    }
    -1
}

fn tuple_pack_parameter(parameter Node) Bool {
    tuple_pack_expansion(parameter) >= 0
}

fn has_type_expansion(node Node) Bool {
    if node.kind == NodeKind.Spread {
        return true
    }
    var index = 0
    while index < length(node.children) {
        if has_type_expansion(child(node, index)) {
            return true
        }
        index = index + 1
    }
    false
}

fn value_pack_position(parameters List[Node]) Int {
    var index = 0
    while index < length(parameters) {
        if child(get(parameters, index), 0).kind == NodeKind.Spread {
            return index
        }
        index = index + 1
    }
    -1
}

fn variadic_parameters(parameters List[Node]) Bool {
    value_pack_position(parameters) >= 0
}

fn structural_pack_position(parameters List[Node]) Int {
    var index = 0
    while index < length(parameters) {
        if has_type_expansion(child(get(parameters, index), 0)) {
            return index
        }
        index = index + 1
    }
    -1
}

fn validate_pack(env Environment, owner Int) Result[Bool, Failure] {
    let item = symbol(env, owner)
    let selected = pack_parameter(item.node)
    if item.node.kind == NodeKind.Impl {
        return Result.Ok(false)
    }
    let parameters = group(item.node, NodeKind.Parameters)
    if selected < 0 {
        var index = 0
        while index < length(parameters) {
            let parameter = get(parameters, index)
            if parameter.kind == NodeKind.Parameter && child(parameter, 0).kind == NodeKind.Spread {
                return Result.Err(failure(env, owner, parameter, "a variadic parameter needs a declared type pack"))
            }
            index = index + 1
        }
        return Result.Ok(false)
    }
    let member = item.owner >= 0 && (symbol(env, item.owner).node.kind == NodeKind.Concept || symbol(env, item.owner).node.kind == NodeKind.Impl)
    if (item.node.kind != NodeKind.Function && !data_pack(item.node)) || (item.owner >= 0 && !member) || has(item.node, NodeKind.Intrinsic) {
        return Result.Err(failure(env, owner, item.node, "type packs belong to functions, concept methods, records or enums"))
    }
    if has(item.node, NodeKind.Ensures) {
        discard validate_pack_contract(env, owner)?
    }
    let types = group(item.node, NodeKind.TypeParameters)
    if !one_type_pack(item.node) {
        return Result.Err(failure(env, owner, get(types, selected), "declare only one type pack in a type parameter list"))
    }
    var clause = 0
    while clause < length(item.node.children) {
        let condition = child(item.node, clause)
        if condition.kind == NodeKind.Requires {
            var index = 0
            while index < length(parameters) {
                let parameter = get(parameters, index)
                if has_type_expansion(child(parameter, 0)) && pack_contract(condition, parameter.value) {
                    return Result.Err(failure(env, owner, condition, "variadic preconditions currently use fixed scalar parameters, not pack-bearing values"))
                }
                index = index + 1
            }
        }
        clause = clause + 1
    }
    let pack = get(types, selected)
    var bound = 0
    while bound < length(pack.children) {
        discard required_concept(env, owner, child(pack, bound))?
        var previous = 0
        while previous < bound {
            if required_concept(env, owner, child(pack, previous))? == required_concept(env, owner, child(pack, bound))? {
                return Result.Err(failure(env, owner, child(pack, bound), "duplicate concept requirement"))
            }
            previous = previous + 1
        }
        bound = bound + 1
    }
    if data_pack(item.node) {
        return Result.Ok(false)
    }
    var index = 0
    var packed = false
    while index < length(parameters) {
        let parameter = get(parameters, index)
        let spread = child(parameter, 0).kind == NodeKind.Spread
        if spread {
            if packed {
                return Result.Err(failure(env, owner, parameter, "declare only one variadic value parameter"))
            }
            packed = true
        }
        if spread && !mentions_pack(child(parameter, 0), pack.value) {
            return Result.Err(failure(env, owner, parameter, "the variadic parameter type must use the declared pack"))
        }
        if tuple_pack_parameter(parameter) {
            let shape = child(parameter, 0)
            var field = 0
            while field < length(shape.children) {
                let pattern = child(shape, field)
                if pattern.kind == NodeKind.Spread && !mentions_pack(pattern, pack.value) {
                    return Result.Err(failure(env, owner, pattern, "the tuple expansion type must use the declared pack"))
                }
                field = field + 1
            }
        }
        index = index + 1
    }
    if has(item.node, NodeKind.Test) || (item.owner < 0 && item.name == "main" && get(env.source.files, item.file).package == env.source.root && !item.test_only) {
        return Result.Err(failure(env, owner, item.node, "main and tests take no parameters and omit the return type"))
    }
    Result.Ok(true)
}

fn pack_node(node Node, kind NodeKind, value Text, children List[Node]) Node {
    Node {
        kind = kind
        value = value
        span = node.span
        children = children
    }
}

fn pack_name(pack Text, index Int) Text {
    concat(concat("$", pack), std.int.to_text(index))
}

// Only type positions substitute a pack name. Runtime identifiers and source
// spans remain intact; this is typed-declaration elaboration, not text macros.
fn expand_pack_type(env Environment, owner Int, node Node, pack Text, arity Int, element Int, types Bool, depth Int) Result[Node, Failure] {
    expand_pack_type_in(env, owner, node, pack, arity, element, types, depth, false)
}

fn expand_pack_type_in(env Environment, owner Int, node Node, pack Text, arity Int, element Int, types Bool, depth Int, preserve_other_packs Bool) Result[Node, Failure] {
    if depth >= 64 {
        return Result.Err(failure(env, owner, node, "type pack expansion nesting limit exceeded"))
    }
    let type_context = types || node.kind == NodeKind.Type || node.kind == NodeKind.TupleType || node.kind == NodeKind.FunctionType || node.kind == NodeKind.TypeArguments
    var value = node.value
    if type_context && pack_root(node, pack) {
        if element < 0 {
            return Result.Err(failure(env, owner, node, "expand a type pack with ...; it is not one type"))
        }
        // Preserve a projection's concept qualifier and expand its family
        // arguments below, e.g. Ts.C.Family[Ts] becomes $Ts0.C.Family[$Ts0].
        value = concat(pack_name(pack, element), slice(node.value, length(pack), length(node.value)))
    }
    let children = new[Node]()
    var index = 0
    while index < length(node.children) {
        let child = child(node, index)
        let child_types = type_context || (node.kind == NodeKind.Parameter && index == 0)
        if child_types && child.kind == NodeKind.Spread && (!preserve_other_packs || mentions_pack(get(child.children, 0), pack)) {
            let pattern = get(child.children, 0)
            if !mentions_pack(pattern, pack) {
                return Result.Err(failure(env, owner, child, "type expansion must use this declaration's pack"))
            }
            var selected = 0
            while selected < arity {
                push(children, expand_pack_type_in(env, owner, pattern, pack, arity, selected, true, depth + 1, preserve_other_packs)?)
                selected = selected + 1
            }
        } else {
            push(children, expand_pack_type_in(env, owner, child, pack, arity, element, child_types, depth + 1, preserve_other_packs)?)
        }
        index = index + 1
    }
    Result.Ok(pack_node(node, node.kind, value, children))
}

fn pack_contract(node Node, name Text) Bool {
    if (node.kind == NodeKind.Name || node.kind == NodeKind.Call) && slice(node.value, 0, first_dot(node.value)) == name {
        return true
    }
    var index = 0
    while index < length(node.children) {
        if pack_contract(child(node, index), name) {
            return true
        }
        index = index + 1
    }
    false
}

// Dependency erasure, not an arity sample: every clause, the return type and
// the body must be independent of the sequence and all pack-bearing inputs.
// Their ordinary proof is then unchanged by adding any number of opaque
// inputs. Selected arities still check bounds, resource use and native types.
fn validate_pack_contract(env Environment, owner Int) Result[Bool, Failure] {
    let node = symbol(env, owner).node
    let pack = get(group(node, NodeKind.TypeParameters), pack_parameter(node))
    let parameters = group(node, NodeKind.Parameters)
    var index = 0
    while index < length(node.children) {
        let member = child(node, index)
        if member.kind != NodeKind.TypeParameters && member.kind != NodeKind.Parameters {
            var dependent = mentions_pack(member, pack.value)
            var parameter = 0
            while parameter < length(parameters) {
                let input = get(parameters, parameter)
                if has_type_expansion(child(input, 0)) {
                    dependent = dependent || pack_contract(member, input.value)
                }
                parameter = parameter + 1
            }
            if dependent {
                return Result.Err(failure(env, owner, member,
                        "variadic postcondition proof depends on a type or value pack; universal induction is not supported yet"))
            }
        }
        index = index + 1
    }
    Result.Ok(true)
}

fn pack_has_postcondition(env Environment, pack PackInstance) Bool {
    has(symbol(env, pack.source).node, NodeKind.Ensures) ||
    (pack.declaration >= 0 && has(symbol(env, pack.declaration).node, NodeKind.Ensures))
}

// Check required family proofs even if no caller selects an arity. Erased
// headers never enter overload matching, concept slots or runtime scheduling.
fn check_pack_contracts(env Environment) Result[Bool, Failure] {
    var index = 0
    while index < length(env.packs) {
        let pack = get(env.packs, index)
        if pack.arity == -1 && pack_has_postcondition(env, pack) {
            discard check_pack_arity(env, erased_pack_signature(env, pack.source)?)?
        }
        index = index + 1
    }
    Result.Ok(true)
}

fn erased_pack_signature(env Environment, owner Int) Result[Int, Failure] {
    var index = 0
    while index < length(env.packs) {
        let previous = get(env.packs, index)
        if previous.source == owner && previous.arity == -2 {
            return Result.Ok(previous.signature)
        }
        index = index + 1
    }
    discard validate_pack_contract(env, owner)?
    let item = symbol(env, owner)
    let declaration = method_pack_source(env, owner)
    let inherited = if declaration >= 0 && declaration != owner {
        get(env.signatures, erased_pack_signature(env, declaration)?).symbol
    } else {
        -1
    }
    let children = new[Node]()
    index = 0
    while index < length(item.node.children) {
        let member = child(item.node, index)
        if member.kind == NodeKind.TypeParameters || member.kind == NodeKind.Parameters {
            let members = new[Node]()
            var selected = 0
            while selected < length(member.children) {
                let input = child(member, selected)
                if input.kind != NodeKind.TypePack &&
                !(input.kind == NodeKind.Parameter && has_type_expansion(child(input, 0))) {
                    push(members, input)
                }
                selected = selected + 1
            }
            push(children, pack_node(member, member.kind, member.value, members))
        } else {
            push(children, member)
        }
        index = index + 1
    }
    let source = length(env.source.symbols)
    push(env.source.symbols, Symbol {
            file = item.file
            node = pack_node(item.node, NodeKind.Function, item.node.value, children)
            name = item.name
            public = false
            test_only = item.test_only
            owner = if item.owner >= 0 {
                item.owner
            } else {
                owner
            }
        })
    let arguments = abstract_arguments(env, function_parameter_count(env, source))
    let obligations = requirements(env, source, arguments)?
    if inherited >= 0 {
        discard inherit_member_requirements(env, inherited,
            argument_tail(arguments, method_parameter_prefix(env, source)), obligations)?
    }
    // No overload registration or concept slot: this header is proof-only.
    let signature = append_signature(env, source_signature(env, source, arguments,
            function_requirements(env, source, obligations)?)?)
    push(env.packs, PackInstance {
            source = owner
            declaration = inherited
            arity = -2
            signature = signature
            state = 0
            depth = 0
        })
    Result.Ok(signature)
}

fn pack_pattern_binds(node Node, name Text) Bool {
    if node.kind == NodeKind.Name && node.value == name {
        return true
    }
    var index = 0
    while index < length(node.children) {
        if pack_pattern_binds(child(node, index), name) {
            return true
        }
        index = index + 1
    }
    false
}

fn pack_local_binds(node Node, name Text) Bool {
    if node.kind == NodeKind.Let || node.kind == NodeKind.Var || node.kind == NodeKind.Scoped {
        return node.value == name
    }
    if node.kind == NodeKind.Destructure {
        return pack_pattern_binds(child(node, 0), name)
    }
    false
}

fn has_pack_iteration(node Node) Bool {
    if node.kind == NodeKind.ComptimeFor || node.kind == NodeKind.ComptimeMap {
        return true
    }
    var index = 0
    while index < length(node.children) {
        if has_pack_iteration(child(node, index)) {
            return true
        }
        index = index + 1
    }
    false
}

// Repeated bodies are ordinary lexical blocks after the selected arity is
// known. Projections retain the existing move, effect and cleanup rules.
fn iteration_binds(node Node, name Text) Bool {
    let key = part(node, NodeKind.IterationKey)
    node.value == name || (key >= 0 && child(node, key).value == name)
}

fn iteration_key(node Node, statements List[Node], value Text, named Bool) {
    let key = part(node, NodeKind.IterationKey)
    if key >= 0 {
        let binding = child(node, key)
        let kind = if named {
            NodeKind.Text
        } else {
            NodeKind.Integer
        }
        push(statements, pack_binding(binding, binding.value, pack_node(binding, kind, value, new[Node]()), true))
    }
}

fn expand_pack_iteration(env Environment, owner Int, node Node, values Text, members List[Text], named Bool, static_values Bool, shadowed Bool, repeated Bool, depth Int, count List[Int]) Result[Node, Failure] {
    if depth >= 64 || get(count, 0) >= 65536 {
        // A dead comptime branch must not fail before the selected body is
        // checked. Keep the budget diagnostic in that branch as source AST.
        return Result.Ok(pack_node(node, NodeKind.PackError, "static pack iteration expansion budget exceeded", new[Node]()))
    }
    let identity = get(count, 0) + 1
    set(count, 0, identity)
    if node.kind == NodeKind.ComptimeFor || node.kind == NodeKind.ComptimeMap {
        let mapping = node.kind == NodeKind.ComptimeMap
        let source = child(node, 0)
        // Pack elaboration handles its own final value pack. Other maps wait
        // until checking resolves their source to a lexical aggregate binding.
        if source.kind == NodeKind.Name && source.value == values && !shadowed {
            let iterations = new[Node]()
            var index = 0
            while index < length(members) {
                let pack = pack_node(source, NodeKind.Name, values, new[Node]())
                let element = pack_node(source, NodeKind.Select, get(members, index), source_nodes(pack))
                let binding = pack_binding(node, node.value, element, static_values)
                let body = expand_pack_iteration(env, owner, child(node, 1), values, members, named, static_values, iteration_binds(node, values), true, depth + 1, count)?
                let statements = source_nodes(binding)
                iteration_key(node, statements, get(members, index), named)
                push(statements, body)
                push(iterations, pack_node(node, NodeKind.Block, "", statements))
                index = index + 1
            }
            if mapping {
                return Result.Ok(pack_node(node, NodeKind.Tuple, "", iterations))
            }
            // A static loop is a Unit statement even when it ends its parent block.
            push(iterations, pack_node(node, NodeKind.Block, "", new[Node]()))
            return Result.Ok(pack_node(node, NodeKind.Block, "", iterations))
        }
        // A foreign or shadowed aggregate loop remains for the body checker, but
        // its body still needs this outer expansion's closure identity.
    }
    let children = new[Node]()
    var index = 0
    var current_shadow = shadowed
    if node.kind == NodeKind.Function && node.value == "" {
        let parameters = group(node, NodeKind.Parameters)
        while index < length(parameters) {
            current_shadow = current_shadow || get(parameters, index).value == values
            index = index + 1
        }
    }
    index = 0
    while index < length(node.children) {
        let member = child(node, index)
        if !(repeated && node.kind == NodeKind.Function && node.value == "" && member.kind == NodeKind.ExpansionId) {
            let member_shadow = if node.kind == NodeKind.Arm && index > 0 {
                current_shadow || pack_pattern_binds(child(node, 0), values)
            } else if (node.kind == NodeKind.ComptimeFor || node.kind == NodeKind.ComptimeMap) && index == 1 {
                current_shadow || iteration_binds(node, values)
            } else {
                current_shadow
            }
            push(children, expand_pack_iteration(env, owner, member, values, members, named, static_values, member_shadow, repeated, depth + 1, count)?)
            if node.kind == NodeKind.Block && pack_local_binds(member, values) {
                current_shadow = true
            }
        }
        index = index + 1
    }
    if repeated && node.kind == NodeKind.Function && node.value == "" {
        let previous = part(node, NodeKind.ExpansionId)
        let suffix = std.int.to_text(identity)
        let marker = if previous < 0 {
            suffix
        } else {
            concat(child(node, previous).value, concat(".", suffix))
        }
        push(children, pack_node(node, NodeKind.ExpansionId, marker, new[Node]()))
    }
    Result.Ok(pack_node(node, node.kind, node.value, children))
}

// A selected type-pack iteration binds one already elaborated type parameter
// per copy. Value bindings shadow its expression spelling, while type syntax
// continues to refer to the type binding.
fn bind_iteration_pattern(node Node, binding Text, selected Text, depth Int) Node {
    if depth >= 64 {
        return pack_node(node, NodeKind.PackError, "static type pattern expansion budget exceeded", new[Node]())
    }
    let refers = node.value == binding || (first_dot(node.value) == length(binding) && std.text.starts_with(node.value, binding))
    let typed = node.kind == NodeKind.RecordPattern || (node.kind == NodeKind.Pattern && package(node.value) != "")
    let children = new[Node]()
    var index = 0
    while index < length(node.children) {
        push(children, bind_iteration_pattern(child(node, index), binding, selected, depth + 1))
        index = index + 1
    }
    pack_node(node, node.kind, if typed && refers {
            concat(selected, slice(node.value, length(binding), length(node.value)))
        } else {
            node.value
        }, children)
}

fn bind_type_iteration(node Node, binding Text, selected Text, shadowed Bool, type_shadowed Bool, depth Int) Node {
    if depth >= 64 {
        return pack_node(node, NodeKind.PackError, "static type iteration expansion budget exceeded", new[Node]())
    }
    let refers = node.value == binding || (first_dot(node.value) == length(binding) && std.text.starts_with(node.value, binding))
    var value = node.value
    if refers && !type_shadowed && (((node.kind == NodeKind.Name || node.kind == NodeKind.Call) && !shadowed) ||
        node.kind == NodeKind.Type || node.kind == NodeKind.Construct || node.kind == NodeKind.RecordPattern) {
        value = concat(selected, slice(node.value, length(binding), length(node.value)))
    }
    let children = new[Node]()
    var index = 0
    var current_shadow = shadowed
    if node.kind == NodeKind.Function && node.value == "" {
        let parameters = group(node, NodeKind.Parameters)
        while index < length(parameters) {
            current_shadow = current_shadow || get(parameters, index).value == binding
            index = index + 1
        }
    }
    index = 0
    while index < length(node.children) {
        let member = child(node, index)
        // Pattern names declare new values; their guards/bodies use the outer
        // type binding, and an identically named value shadows Name uses.
        if (node.kind == NodeKind.Arm || node.kind == NodeKind.Destructure) && index == 0 {
            push(children, if type_shadowed {
                    member
                } else {
                    bind_iteration_pattern(member, binding, selected, depth + 1)
                })
        } else {
            let member_shadow = if node.kind == NodeKind.Arm && index > 0 {
                current_shadow || pack_pattern_binds(child(node, 0), binding)
            } else if (node.kind == NodeKind.ComptimeFor || node.kind == NodeKind.ComptimeMap) && index == 1 {
                current_shadow || iteration_binds(node, binding)
            } else {
                current_shadow
            }
            let member_type_shadow = type_shadowed ||
            ((node.kind == NodeKind.ComptimeFor || node.kind == NodeKind.ComptimeMap) &&
                index == 1 && node.value == binding && child(node, 0).kind == NodeKind.Name)
            push(children, bind_type_iteration(member, binding, selected, member_shadow, member_type_shadow, depth + 1))
            if node.kind == NodeKind.Block && pack_local_binds(member, binding) {
                current_shadow = true
            }
        }
        index = index + 1
    }
    if node.kind == NodeKind.Function && node.value == "" && std.text.starts_with(selected, "$type#") {
        // A generated closure body embeds type references. Do not reuse its
        // source symbol for another type at the same source span/ordinal.
        let marker = part(node, NodeKind.ExpansionId)
        let identity = concat(if marker < 0 {
                ""
            } else {
                child(node, marker).value
            }, selected)
        let value = pack_node(node, NodeKind.ExpansionId, identity, new[Node]())
        if marker < 0 {
            push(children, value)
        } else {
            set(children, marker, value)
        }
    }
    pack_node(node, node.kind, value, children)
}

// The type pack is compile-time structure, never a runtime type-list object.
// Value-pack iteration ran first, so an identically named value pack keeps its
// existing meaning. Other lexical tuple bindings shadow the pack source.
fn expand_type_iteration(env Environment, owner Int, node Node, pack Text, arity Int, shadowed Bool, repeated Bool, depth Int, count List[Int]) Result[Node, Failure] {
    if depth >= 64 || get(count, 0) >= 65536 {
        return Result.Ok(pack_node(node, NodeKind.PackError, "static type iteration expansion budget exceeded", new[Node]()))
    }
    let identity = get(count, 0) + 1
    set(count, 0, identity)
    if node.kind == NodeKind.ComptimeFor || node.kind == NodeKind.ComptimeMap {
        let source = child(node, 0)
        if source.kind == NodeKind.Name && source.value == pack && !shadowed {
            let iterations = new[Node]()
            var index = 0
            while index < arity {
                let substituted = bind_type_iteration(child(node, 1), node.value, pack_name(pack, index), false, false, 0)
                let statements = new[Node]()
                iteration_key(node, statements, std.int.to_text(index), false)
                push(statements, expand_type_iteration(env, owner, substituted, pack, arity, iteration_binds(node, pack), true, depth + 1, count)?)
                push(iterations, pack_node(node, NodeKind.Block, "", statements))
                index = index + 1
            }
            if node.kind == NodeKind.ComptimeMap {
                return Result.Ok(pack_node(node, NodeKind.Tuple, "", iterations))
            }
            push(iterations, pack_node(node, NodeKind.Block, "", new[Node]()))
            return Result.Ok(pack_node(node, NodeKind.Block, "", iterations))
        }
    }
    let children = new[Node]()
    var index = 0
    var current_shadow = shadowed
    if node.kind == NodeKind.Function {
        let parameters = group(node, NodeKind.Parameters)
        while index < length(parameters) {
            current_shadow = current_shadow || get(parameters, index).value == pack
            index = index + 1
        }
    }
    index = 0
    while index < length(node.children) {
        let member = child(node, index)
        if !(repeated && node.kind == NodeKind.Function && node.value == "" && member.kind == NodeKind.ExpansionId) {
            let member_shadow = if node.kind == NodeKind.Arm && index > 0 {
                current_shadow || pack_pattern_binds(child(node, 0), pack)
            } else if (node.kind == NodeKind.ComptimeFor || node.kind == NodeKind.ComptimeMap) && index == 1 {
                current_shadow || iteration_binds(node, pack)
            } else {
                current_shadow
            }
            push(children, expand_type_iteration(env, owner, member, pack, arity, member_shadow, repeated, depth + 1, count)?)
            if node.kind == NodeKind.Block && pack_local_binds(member, pack) {
                current_shadow = true
            }
        }
        index = index + 1
    }
    if repeated && node.kind == NodeKind.Function && node.value == "" {
        let previous = part(node, NodeKind.ExpansionId)
        let suffix = std.int.to_text(identity)
        let marker = if previous < 0 {
            suffix
        } else {
            concat(child(node, previous).value, concat(".", suffix))
        }
        push(children, pack_node(node, NodeKind.ExpansionId, marker, new[Node]()))
    }
    Result.Ok(pack_node(node, node.kind, node.value, children))
}

fn pack_declaration(env Environment, owner Int, arity Int) Result[Node, Failure] {
    let declaration = symbol(env, owner).node
    let types = group(declaration, NodeKind.TypeParameters)
    let pack = get(types, pack_parameter(declaration))
    let parameters = group(declaration, NodeKind.Parameters)
    let position = value_pack_position(parameters)
    let values = if position < 0 {
        declaration
    } else {
        get(parameters, position)
    }
    let variadic = position >= 0
    let static_values = variadic && has(values, NodeKind.Comptime)
    let expanded_types = expand_pack_parameters(types, arity)
    let expanded_params = new[Node]()
    let elements = new[Node]()
    var index = 0
    var type_shadowed = false
    while index < length(parameters) {
        let parameter = get(parameters, index)
        type_shadowed = type_shadowed || parameter.value == pack.value
        if index == position {
            var element = 0
            while element < arity {
                let name = pack_name(values.value, element)
                let ty = expand_pack_type(env, owner, child(child(values, 0), 0), pack.value, arity, element, true, 0)?
                let parts = source_nodes(ty)
                if static_values {
                    push(parts, pack_node(values, NodeKind.Comptime, "", new[Node]()))
                }
                push(expanded_params, pack_node(values, NodeKind.Parameter, name, parts))
                push(elements, pack_node(values, NodeKind.Name, name, new[Node]()))
                element = element + 1
            }
        } else {
            push(expanded_params, expand_pack_type(env, owner, parameter, pack.value, arity, -1, false, 0)?)
        }
        index = index + 1
    }
    let tuple = pack_node(values, NodeKind.Tuple, "", elements)
    let children = new[Node]()
    index = 0
    while index < length(declaration.children) {
        let member = child(declaration, index)
        if member.kind == NodeKind.TypeParameters {
            push(children, pack_node(member, member.kind, "", expanded_types))
        } else {
            if member.kind == NodeKind.Parameters {
                push(children, pack_node(member, member.kind, "", expanded_params))
            } else {
                let typed = expand_pack_type(env, owner, member, pack.value, arity, -1, false, 0)?
                let expanded = if variadic && has_pack_iteration(typed) {
                    let count = new[Int]()
                    push(count, 0)
                    expand_pack_iteration(env, owner, typed, values.value, tuple_iteration_members(arity), false, static_values, false, false, 0, count)?
                } else {
                    typed
                }
                let type_expanded = if has_pack_iteration(expanded) && !type_shadowed {
                    let count = new[Int]()
                    push(count, 0)
                    expand_type_iteration(env, owner, expanded, pack.value, arity, false, false, 0, count)?
                } else {
                    expanded
                }
                if member.kind == NodeKind.Block {
                    let body = if variadic {
                        source_nodes(pack_binding(values, values.value, tuple, static_values))
                    } else {
                        new[Node]()
                    }
                    // The source body retains its own scope, including shadowing
                    // the immutable parameter name and lexical cleanup boundaries.
                    push(body, type_expanded)
                    push(children, pack_node(member, NodeKind.Block, "", body))
                } else {
                    push(children, type_expanded)
                }
            }
        }
        index = index + 1
    }
    Result.Ok(pack_node(declaration, NodeKind.Function, declaration.value, children))
}

fn pack_instance(env Environment, signature Int) Int {
    var index = 0
    while index < length(env.packs) {
        if get(env.packs, index).signature == signature {
            return index
        }
        index = index + 1
    }
    -1
}

fn pack_signature(env Environment, owner Int, arity Int) Result[Int, Failure] {
    var count = 0
    var index = 0
    while index < length(env.packs) {
        let existing = get(env.packs, index)
        if existing.source == owner {
            if existing.arity == arity {
                return Result.Ok(existing.signature)
            }
            if existing.arity >= 0 {
                count = count + 1
            }
        }
        index = index + 1
    }
    let item = symbol(env, owner)
    if count >= 1024 || arity > 1024 {
        return Result.Err(failure(env, owner, item.node, "type pack specialization budget exceeded; expansion must be finite"))
    }
    let expanded = pack_declaration(env, owner, arity)?
    let source = length(env.source.symbols)
    push(env.source.symbols, Symbol {
            file = item.file
            node = expanded
            name = item.name
            public = false
            test_only = item.test_only
            owner = if item.owner >= 0 {
                item.owner
            } else {
                owner
            }
        })
    let arguments = abstract_arguments(env, function_parameter_count(env, source))
    let obligations = requirements(env, source, arguments)?
    let declaration = method_pack_source(env, owner)
    if declaration >= 0 && declaration != owner {
        let declared = pack_signature(env, declaration, arity)?
        discard inherit_member_requirements(env, get(env.signatures, declared).symbol,
            argument_tail(arguments, method_parameter_prefix(env, source)), obligations)?
    }
    let current = source_signature(env, source, arguments, function_requirements(env, source, obligations)?)?
    let selected = if item.owner >= 0 {
        register_signature(env, current)?
    } else {
        append_signature(env, current)
    }
    push(env.packs, PackInstance {
            source = owner
            declaration = if declaration < 0 {
                owner
            } else {
                declaration
            }
            arity = arity
            signature = selected
            state = 0
            depth = 0
        })
    Result.Ok(selected)
}

fn pack_state(env Environment, index Int, state Int, depth Int) {
    let pack = get(env.packs, index)
    set(env.packs, index, PackInstance {
            source = pack.source
            declaration = pack.declaration
            arity = pack.arity
            signature = pack.signature
            state = state
            depth = depth
        })
}

fn active_pack(env Environment) Int {
    var index = 0
    while index < length(env.packs) {
        if get(env.packs, index).state == 1 {
            return index
        }
        index = index + 1
    }
    -1
}

fn queued_pack(env Environment) Int {
    var index = 0
    while index < length(env.packs) {
        if get(env.packs, index).state == 3 {
            return index
        }
        index = index + 1
    }
    -1
}

fn finish_pack_batch(env Environment, proved Bool) {
    var index = 0
    while index < length(env.packs) {
        let state = get(env.packs, index).state
        if state == 1 || state == 3 || state == 4 {
            pack_state(env, index, if proved {
                    2
                } else {
                    0
                }, 0)
        }
        index = index + 1
    }
}

// Optional CTFE/proof checks may recover from a failed function traversal.
// Drop only pack work enqueued by that traversal, retaining earlier siblings.
fn pending_pack_snapshot(env Environment) List[Int] {
    let pending = new[Int]()
    var index = 0
    while index < length(env.packs) {
        if get(env.packs, index).state == 3 {
            push(pending, index)
        }
        index = index + 1
    }
    pending
}

fn rollback_new_pending_packs(env Environment, before List[Int]) {
    if active_pack(env) < 0 {
        return
    }
    var index = 0
    while index < length(env.packs) {
        if get(env.packs, index).state == 3 {
            var retained = false
            var previous = 0
            while previous < length(before) {
                if get(before, previous) == index {
                    retained = true
                }
                previous = previous + 1
            }
            if !retained {
                pack_state(env, index, 0, 0)
            }
        }
        index = index + 1
    }
}

fn check_pack_arity(env Environment, signature Int) Result[Bool, Failure] {
    let index = pack_instance(env, signature)
    if index < 0 {
        return Result.Ok(false)
    }
    let pack = get(env.packs, index)
    if pack.state < 0 {
        return Result.Err(failure(env, pack.source, symbol(env, pack.source).node, "variadic method header is not established"))
    }
    if pack.state == 0 && pack_has_postcondition(env, pack) {
        // An implementation inherits its declaration's clauses even when it
        // does not repeat ensures. Its own body must meet the erasure rule.
        discard validate_pack_contract(env, pack.source)?
        if pack.arity >= 0 {
            discard check_pack_arity(env, erased_pack_signature(env, pack.source)?)?
        }
    }
    if pack.state != 0 {
        return Result.Ok(true)
    }
    let active = active_pack(env)
    let depth = if active < 0 {
        1
    } else {
        get(env.packs, active).depth + 1
    }
    if depth > 64 {
        return Result.Err(failure(env, pack.source, symbol(env, pack.source).node, "type pack specialization depth exceeded; expansion must be finite"))
    }
    pack_state(env, index, 3, depth)
    if active >= 0 {
        return Result.Ok(true)
    }
    // Check a breadth-first worklist. A pack body can discover more arities,
    // but no native checker frames remain live across those bodies.
    var queued = queued_pack(env)
    while queued >= 0 {
        let next = get(env.packs, queued)
        pack_state(env, queued, 1, next.depth)
        let current = get(env.signatures, next.signature)
        if prototype(env, current.symbol) && !has(symbol(env, current.symbol).node, NodeKind.Block) {
            pack_state(env, queued, 4, next.depth)
        } else {
            match function(env, next.signature, abstract_arguments(env, current.parameters), unknown_constants(current), false) {
                Result.Ok(_) => {
                    pack_state(env, queued, 4, next.depth)
                }
                Result.Err(failed) => {
                    finish_pack_batch(env, false)
                    return Result.Err(failed)
                }
            }
        }
        queued = queued_pack(env)
    }
    finish_pack_batch(env, true)
    Result.Ok(true)
}

fn pack_references(context Context, options List[Int], types List[Node], desired Int) Result[List[Int], Failure] {
    if length(context.env.packs) == 0 {
        return Result.Ok(options)
    }
    var has_pack = false
    var index = 0
    while index < length(options) {
        has_pack = has_pack || get(options, index) < 0
        index = index + 1
    }
    if !has_pack {
        return Result.Ok(options)
    }
    let choices = new[Int]()
    index = 0
    while index < length(options) {
        let id = get(options, index)
        if id >= 0 {
            push(choices, id)
        } else {
            let owner = -1 - id
            let declaration = symbol(context.env, owner).node
            let parameters = group(declaration, NodeKind.Parameters)
            let variadic = variadic_parameters(parameters)
            let arity = if length(types) != 0 {
                length(types) - fixed_pack_parameters(declaration)
            } else if desired >= 0 {
                let shape = get(context.env.types, desired).arguments
                if !variadic {
                    let inferred = structural_reference_arity(context.env, parameters, shape)
                    if inferred >= 0 {
                        inferred
                    } else if length(shape) == length(parameters) + 1 {
                        pack_result_arity(context.env, declaration, get(shape, length(shape) - 1))
                    } else {
                        -1
                    }
                } else {
                    length(shape) - length(parameters)
                }
            } else {
                -1
            }
            if arity >= 0 {
                push(choices, selected_pack_signature(context.env, owner, arity)?)
            }
        }
        index = index + 1
    }
    Result.Ok(choices)
}
