import std.loom.binding.candidates
import std.loom.project.name
import std.loom.project.package
import std.loom.ast.Node
import std.loom.ast.NodeKind
import std.loom.typed.Expr
import std.loom.typed.ExprKind
import std.loom.typed.TypeKind
import std.list.new
import std.list.get
import std.list.push
import std.list.set
import std.list.length
import std.result.Result

fn supplied(context Context, node Node, values List[Node], count Int) Result[List[Int], Failure] {
    if length(values) != 0 && length(values) != count { return Result.Err(error(context, node, "wrong number of type arguments")) }
    let output = new[Int]()
    var index = 0
    while index < count {
        push(output, if length(values) == 0 { -1 } else { context_type(context, get(values, index))? })
        index = index + 1
    }
    Result.Ok(output)
}
// Method calls infer Self from the receiver; explicit arguments describe only
// the method's own parameters, independent of the selected implementation.
fn supplied_call(context Context, node Node, values List[Node], current Signature) Result[List[Int], Failure] {
    if !prototype(context.env, current.symbol) { return supplied(context, node, values, current.parameters) }
    Result.Ok(member_arguments(ints(-1), supplied(context, node, values, current.parameters - 1)?))
}
fn complete(arguments List[Int]) Bool {
    var index = 0
    while index < length(arguments) {
        if get(arguments, index) < 0 { return false }
        index = index + 1
    }
    true
}
fn hint(context Context, pattern Int, arguments List[Int], node Node) Result[Int, Failure] {
    if complete(arguments) { return substitute(context.env, context.signature.symbol, pattern, arguments, node) }
    if concrete(context.env, pattern) { Result.Ok(pattern) } else { Result.Ok(-1) }
}
fn data_arguments(context Context, node Node, declaration Int, types List[Node], expected Int) Result[List[Int], Failure] {
    let count = length(group(symbol(context.env, declaration).node, NodeKind.TypeParameters))
    let arguments = supplied(context, node, types, count)?
    if length(types) == 0 && expected >= 0 {
        let ty = get(context.env.types, expected)
        if ty.symbol == declaration && (ty.kind == TypeKind.Record || ty.kind == TypeKind.Enum || ty.kind == TypeKind.Refined) {
            var index = 0
            while index < count { set(arguments, index, get(ty.arguments, index))
                index = index + 1
            }
        }
    }
    Result.Ok(arguments)
}
fn template(context Context, declaration Int) Result[Int, Failure] {
    let count = length(group(symbol(context.env, declaration).node, NodeKind.TypeParameters))
    data_type(context.env, declaration, abstract_arguments(context.env, count), 0)
}
fn construct(context Context, node Node, expected Int) Result[Expr, Failure] {
    let declaration = find_data(context.env, context.signature.symbol, node, node.value)?
    if declaration < 0 { return Result.Err(error(context, node, "unknown record type")) }
    let shape = get(context.env.types, template(context, declaration)?)
    if shape.kind != TypeKind.Record { return Result.Err(error(context, node, "construction requires a record type")) }
    let arguments = data_arguments(context, node, declaration, child(node, 0).children, expected)?
    let seen = new[Bool]()
    var index = 0
    while index < length(shape.fields) { push(seen, false)
        index = index + 1
    }
    let fields = new[Expr]()
    index = 1
    while index < length(node.children) {
        let member = child(node, index)
        var field = -1
        var search = 0
        while search < length(shape.fields) {
            if get(shape.fields, search).name == member.value { field = search }
            search = search + 1
        }
        if field < 0 { return Result.Err(error(context, member, "unknown record field")) }
        if get(seen, field) { return Result.Err(error(context, member, "duplicate record initializer")) }
        set(seen, field, true)
        let pattern = get(shape.fields, field).ty
        let value = expr(context, child(member, 0), hint(context, pattern, arguments, member)?)?
        discard infer(context.env, pattern, value.ty, arguments)
        push(fields, expression(ExprKind.Field, value.ty, member, "", field, expressions(value), value.falls))
        index = index + 1
    }
    if length(fields) != length(shape.fields) { return Result.Err(error(context, node, "initialize every record field")) }
    if !complete(arguments) { return Result.Err(error(context, node, "cannot infer record type arguments")) }
    index = 0
    while index < length(fields) {
        let field = get(fields, index)
        let member = child(node, index + 1)
        let target = substitute(context.env, declaration, get(shape.fields, field.index).ty, arguments, node)?
        let value = typed(context, member, get(field.children, 0), target)?
        set(fields, index, expression(ExprKind.Field, target, member, "", field.index, expressions(value), value.falls))
        index = index + 1
    }
    Result.Ok(expression(ExprKind.Record, constructed_type(context, declaration, arguments, node)?, node, "", -1, fields, all_fall(fields)))
}
fn variant(context Context, node Node, types List[Node], inputs List[Node], expected Int) Result[Expr, Failure] {
    let declaration = find_data(context.env, context.signature.symbol, node, package(node.value))?
    if declaration < 0 { return Result.Err(error(context, node, "unknown enum type")) }
    let shape = get(context.env.types, template(context, declaration)?)
    if shape.kind != TypeKind.Enum { return Result.Err(error(context, node, "variant construction requires an enum")) }
    var selected = -1
    var index = 0
    while index < length(shape.variants) {
        if get(shape.variants, index).name == name(node.value) { selected = index }
        index = index + 1
    }
    if selected < 0 { return Result.Err(error(context, node, "unknown enum variant")) }
    let patterns = get(shape.variants, selected).fields
    if length(patterns) != length(inputs) { return Result.Err(error(context, node, "enum payload count does not match")) }
    let arguments = data_arguments(context, node, declaration, types, expected)?
    let values = new[Expr]()
    index = 0
    while index < length(inputs) {
        let pattern = get(patterns, index)
        let input = get(inputs, index)
        let value = expr(context, input, hint(context, pattern, arguments, input)?)?
        discard infer(context.env, pattern, value.ty, arguments)
        push(values, value)
        index = index + 1
    }
    if !complete(arguments) { return Result.Err(error(context, node, "cannot infer enum type arguments")) }
    index = 0
    while index < length(values) {
        let target = substitute(context.env, declaration, get(patterns, index), arguments, node)?
        set(values, index, typed(context, get(inputs, index), get(values, index), target)?)
        index = index + 1
    }
    Result.Ok(expression(ExprKind.Variant, constructed_type(context, declaration, arguments, node)?, node, "", selected, values, all_fall(values)))
}
fn call(context Context, node Node, expected Int) Result[Expr, Failure] {
    let types = child(node, 0).children
    let inputs = child(node, 1).children
    let first = slice(node.value, 0, first_dot(node.value))
    if lookup(context, first) >= 0 {
        if package(node.value) == "" {
            let callee = Node { kind = NodeKind.Name value = node.value span = node.span children = new[Node]() }
            let value = expr(context, callee, -1)?
            if length(types) != 0 && (get(context.env.types, value.ty).kind == TypeKind.List || value.ty == 4) {
                return call_value(context, node, index_read(context, node, value, types)?, new[Node](), inputs)
            }
            if get(context.env.types, value.ty).kind != TypeKind.Function { return Result.Err(error(context, node, "a local value is not callable")) }
            return call_value(context, node, value, types, inputs)
        }
        let receiver = Node { kind = NodeKind.Name value = package(node.value) span = node.span children = new[Node]() }
        return method_call(context, node, receiver, name(node.value), types, inputs, -1, expected)
    }
    if length(context.env.concepts) != 0 && package(node.value) != "" {
        let capability = concept_named(context.env, context.signature.symbol, node, package(node.value))?
        if capability >= 0 {
            if length(inputs) == 0 { return Result.Err(error(context, node, "a concept method call needs a receiver")) }
            let arguments = new[Node]()
            var index = 1
            while index < length(inputs) { push(arguments, get(inputs, index))
                index = index + 1 }
            return method_call(context, node, get(inputs, 0), name(node.value), types, arguments, capability, expected)
        }
    }
    let current = symbol(context.env, context.signature.symbol)
    let available = candidates(context.env.source, current.file, current.test_only, node.value)
    let declaration = find_data(context.env, context.signature.symbol, node, node.value)?
    if declaration >= 0 && symbol(context.env, declaration).node.kind == NodeKind.Refined {
        var index = 0
        while index < length(available) {
            if symbol(context.env, get(available, index)).node.kind == NodeKind.Function {
                return Result.Err(error(context, node, "a constrained constructor and function share this name; resolve the collision"))
            }
            index = index + 1
        }
        return constrained(context, node, declaration, types, inputs)
    }
    if package(node.value) != "" && find_data(context.env, context.signature.symbol, node, package(node.value))? >= 0 {
        return variant(context, node, types, inputs, expected)
    }
    let options = new[Int]()
    var index = 0
    while index < length(context.env.signatures) {
        let signature = get(context.env.signatures, index)
        var candidate = 0
        while candidate < length(available) {
            if get(available, candidate) == signature.symbol && length(signature.params) == length(inputs) && (length(types) == 0 || length(types) == signature.parameters) { push(options, index) }
            candidate = candidate + 1
        }
        index = index + 1
    }
    invoke(context, node, options, types, inputs, new[Expr](), expected)
}
fn invoke(context Context, node Node, options List[Int], types List[Node], inputs List[Node], prefix List[Expr], expected Int) Result[Expr, Failure] {
    let values = new[Expr]()
    let probes = new[Bool]()
    let probing = static_options(context, options)
    var index = 0
    while index < length(prefix) { push(values, get(prefix, index))
        if probing { push(probes, false) }
        index = index + 1 }
    let inferred = if length(options) == 1 { supplied_call(context, node, types, get(context.env.signatures, get(options, 0)))? } else { new[Int]() }
    if length(options) == 1 {
        var previous = 0
        while previous < length(prefix) {
            discard infer(context.env, get(get(context.env.signatures, get(options, 0)).params, previous), get(prefix, previous).ty, inferred)
            previous = previous + 1
        }
    }
    while index < length(inputs) {
        var expected_argument = -1
        if length(options) == 1 {
            expected_argument = hint(context, get(get(context.env.signatures, get(options, 0)).params, index), inferred, node)?
        }
        let probe = probing && static_position(context, options, index)
        let value = if probe { static_probe(context, get(inputs, index), expected_argument)? } else {
            expr(context, get(inputs, index), expected_argument)?
        }
        if probing { push(probes, probe) }
        push(values, value)
        if length(options) == 1 {
            discard infer(context.env, get(get(context.env.signatures, get(options, 0)).params, index), value.ty, inferred)
        }
        index = index + 1
    }
    let matches = matching_overloads(context, node, options, types, values, expected)?
    invoke_selected(context, node, choose_overload(context, node, matches)?, inputs, values, probes)
}
record OverloadSet { candidates List[Instance] widening List[Bool] exact Bool missing_requirement Bool }
fn matching_overloads(context Context, node Node, options List[Int], types List[Node], values List[Expr], expected Int) Result[OverloadSet, Failure] {
    let matches = new[Instance]()
    let widening = new[Bool]()
    var exact = false
    var missing_requirement = false
    var index = 0
    while index < length(options) {
        let id = get(options, index)
        let candidate_signature = get(context.env.signatures, id)
        let args = supplied_call(context, node, types, candidate_signature)?
        var matched = true
        var widened = false
        var argument = 0
        while argument < length(values) {
            discard infer(context.env, get(candidate_signature.params, argument), get(values, argument).ty, args)
            argument = argument + 1
        }
        if matched && !complete(args) && expected >= 0 {
            let result_hint = if async_signature(context.env, candidate_signature) {
                if get(context.env.types, expected).kind == TypeKind.Task { get(get(context.env.types, expected).arguments, 0) } else { -1 }
            } else { expected }
            if result_hint >= 0 { discard infer(context.env, candidate_signature.result, result_hint, args) }
        }
        if matched && complete(args) {
            if satisfies_arguments(context, candidate_signature, args, node)? {
                argument = 0
                while argument < length(values) {
                    let target = substitute(context.env, candidate_signature.symbol, get(candidate_signature.params, argument), args, node)?
                    let value = get(values, argument)
                    if value.ty != target {
                        if can_widen(context, value.ty, target)? { widened = true } else { matched = false }
                    }
                    argument = argument + 1
                }
                if matched {
                    push(matches, Instance { signature = id arguments = args constants = new[StaticValue]() })
                    push(widening, widened)
                    exact = exact || !widened
                }
            } else { missing_requirement = true }
        }
        index = index + 1
    }
    Result.Ok(OverloadSet { candidates = matches widening = widening exact = exact missing_requirement = missing_requirement })
}
fn choose_overload(context Context, node Node, matches OverloadSet) Result[Instance, Failure] {
    var selected = -1
    var index = 0
    while index < length(matches.candidates) {
        if !matches.exact || !get(matches.widening, index) {
            if selected >= 0 { return Result.Err(error(context, node, "ambiguous overload; qualify the call or supply type arguments")) }
            selected = index
        }
        index = index + 1
    }
    if selected < 0 {
        return Result.Err(error(context, node, if matches.missing_requirement {
            "type argument needs an explicit implementation of the required concept"
        } else { "no accessible overload matches these arguments" }))
    }
    Result.Ok(get(matches.candidates, selected))
}
fn invoke_selected(context Context, node Node, instance Instance, inputs List[Node], values List[Expr], probes List[Bool]) Result[Expr, Failure] {
    let signature = get(context.env.signatures, instance.signature)
    let constants = new[StaticValue]()
    let filtered = has_static(signature)
    let runtime_values = if filtered { new[Expr]() } else { values }
    var index = 0
    while index < length(values) {
        let target = substitute(context.env, context.signature.symbol, get(signature.params, index), instance.arguments, node)?
        let input = get(inputs, index)
        if is_static(signature, index) {
            let value = static_argument(context, input, get(values, index), target)?
            push(constants, value)
            if value.capture >= 0 { push(runtime_values, static_environment_argument(context, input, value)?) }
        } else {
            let value = if length(probes) != 0 && get(probes, index) { expr(context, input, target)? } else {
                typed(context, input, get(values, index), target)?
            }
            if filtered { push(runtime_values, value) } else { set(runtime_values, index, value) }
        }
        index = index + 1
    }
    if prototype(context.env, signature.symbol) {
        if length(constants) != 0 && known_constants(constants) {
            let receiver = get(instance.arguments, 0)
            let kind = get(context.env.types, receiver).kind
            // A nominal receiver can select an implementation even while its
            // arguments remain abstract. Do not guess for evidence-only types,
            // or validate a default body that an implementation overrides.
            if kind != TypeKind.Parameter && kind != TypeKind.Associated && kind != TypeKind.Dyn &&
                conformance(context.env, receiver, symbol(context.env, signature.symbol).owner).implementation >= 0 {
                let target = method_target(context.env, instance.signature, instance.arguments, constants)?
                discard validate_static(context.env, target.signature, constants, symbol(context.env, get(context.env.signatures, target.signature).symbol).node)?
            }
        }
    } else { discard validate_static(context.env, instance.signature, constants, node)? }
    var resource_argument = 0
    while resource_argument < length(runtime_values) {
        if resource_argument == 0 && method_declaration(context.env, signature.symbol) >= 0 {
            discard resource_receiver(context, node, get(runtime_values, resource_argument))?
        }
        if !(resource_argument == 0 && method_declaration(context.env, signature.symbol) >= 0) && must_scope(context, get(runtime_values, resource_argument).ty)? {
            return Result.Err(error(context, node, "MustScope values cannot be passed as ordinary arguments"))
        }
        resource_argument = resource_argument + 1
    }
    let logical_output = substitute(context.env, context.signature.symbol, signature.result, instance.arguments, node)?
    let asynchronous = async_signature(context.env, signature)
    let output = call_result(context.env, signature, logical_output)
    let dynamic = prototype(context.env, signature.symbol) && length(runtime_values) != 0 && get(context.env.types, get(runtime_values, 0).ty).kind == TypeKind.Dyn
    discard task_call_context(context, node, runtime_values, output, asynchronous)?
    if !context.emit && !known_constants(constants) {
        return Result.Ok(expression(ExprKind.Deferred, output, node, "", -1, runtime_values, all_fall(runtime_values)))
    }
    if dynamic {
        return dynamic_call(context, node, instance.signature, instance.arguments, constants, output, runtime_values)
    }
    if asynchronous && has(symbol(context.env, signature.symbol).node, NodeKind.Intrinsic) {
        // A private suspension primitive is not a separately scheduled Task.
        // Await unwraps this temporary Task type; task flow rejects any escape.
        return Result.Ok(expression(ExprKind.Suspend, output, node, validate_intrinsic(context.env, instance.signature)?, -1,
            runtime_values, all_fall(runtime_values)))
    }
    let target = if context.emit { schedule(context.env, instance.signature, instance.arguments, constants, node)? } else { -1 }
    let returns = !(has(symbol(context.env, signature.symbol).node, NodeKind.Intrinsic) &&
        symbol(context.env, signature.symbol).name == "fault_text")
    Result.Ok(expression(if asynchronous { ExprKind.TaskCall } else { ExprKind.Call }, output, node,
        if asynchronous { task_creation_message(context, node) } else { "" }, target, runtime_values, returns && all_fall(runtime_values)))
}
