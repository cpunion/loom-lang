import std.loom.binding.Failure
import std.loom.ast.has
import std.loom.project.package
import std.loom.ast.Node
import std.loom.ast.NodeKind
import std.loom.typed.TypeKind
import std.loom.typed.Local
import std.loom.typed.Expr
import std.loom.typed.ExprKind
import std.loom.typed.Function
import std.loom.typed.list_take_result
import std.list.new
import std.list.get
import std.list.push
import std.list.length
import std.result.Result

record RuntimeSignature { parameters Int params List[Int] result Int }
record CheckedBody { context Context function Function }

fn signature(env Environment, id Int, arguments List[Int], node Node) Result[Signature, Failure] {
    signature_in(env, id, arguments, node, get(env.signatures, id).symbol)
}
fn signature_in(env Environment, id Int, arguments List[Int], node Node, owner Int) Result[Signature, Failure] {
    let original = get(env.signatures, id)
    if length(arguments) != original.parameters {
        return Result.Err(failure(env, original.symbol, node, "wrong number of function type arguments"))
    }
    let params = new[Int]()
    var index = 0
    while index < length(original.params) {
        push(params, substitute(env, owner, get(original.params, index), arguments, node)?)
        index = index + 1
    }
    let obligations = new[Requirement]()
    index = 0
    while index < length(original.requirements) {
        let obligation = get(original.requirements, index)
        push(obligations, Requirement { ty = substitute(env, owner, obligation.ty, arguments, node)? capability = obligation.capability })
        index = index + 1
    }
    Result.Ok(Signature { symbol = original.symbol parameters = original.parameters params = params
        compile_time = original.compile_time result = substitute(env, owner, original.result, arguments, node)? requirements = obligations })
}
fn method_target(env Environment, id Int, arguments List[Int], constants List[StaticValue]) Result[Instance, Failure] {
    let current = get(env.signatures, id)
    let declaration = symbol(env, current.symbol).node
    let capability = symbol(env, current.symbol).owner
    let selected = conformance(env, get(arguments, 0), capability)
    if selected.implementation < 0 {
        return Result.Err(failure(env, current.symbol, declaration, "concept evidence has no concrete implementation"))
    }
    let methods = get(env.concepts, concept_index(env, capability)).methods
    var slot = 0
    while get(methods, slot) != id { slot = slot + 1 }
    let target = get(get(env.implementations, selected.implementation).methods, slot)
    if target == id && !has(declaration, NodeKind.Block) {
        return Result.Err(failure(env, current.symbol, declaration, "concept evidence has no concrete implementation"))
    }
    Result.Ok(Instance { signature = target
        arguments = if target == id { arguments } else { member_arguments(selected.arguments, argument_tail(arguments, 1)) }
        constants = constants })
}
fn schedule(env Environment, id Int, arguments List[Int], constants List[StaticValue], node Node) Result[Int, Failure] {
    let current = get(env.signatures, id)
    // Scheduling has the callee identity, not the caller's source identity.
    // A failure anchored to the declaration must also use that declaration's span.
    let declaration = symbol(env, current.symbol).node
    if prototype(env, current.symbol) {
        let selected = method_target(env, id, arguments, constants)?
        if selected.signature != id { return schedule(env, selected.signature, selected.arguments, constants, node) }
    }
    if !known_constants(constants) { return Result.Err(failure(env, current.symbol, declaration, "comptime arguments must be determined for this instance")) }
    // Dispatch must validate the selected implementation/default, not only the
    // concept declaration. Witness activation and CTFE schedule here as well.
    discard validate_static(env, id, constants, declaration)?
    var index = 0
    var instances = 0
    while index < length(env.pending) {
        let previous = get(env.pending, index)
        if previous.signature == id {
            instances = instances + 1
            if same(previous.arguments, arguments) && same_constants(previous.constants, constants) { return Result.Ok(index) }
        }
        index = index + 1
    }
    // Independent declarations do not consume one global expansion budget.
    if instances >= 1024 {
        return Result.Err(failure(env, current.symbol, declaration, "function specialization budget exceeded; expansion must be finite"))
    }
    index = 0
    while index < length(arguments) {
        if type_depth(env, get(arguments, index)) >= 64 {
            return Result.Err(failure(env, current.symbol, declaration, "function specialization depth exceeded; expansion must be finite"))
        }
        index = index + 1
    }
    let scheduled = length(env.pending)
    push(env.pending, Instance { signature = id arguments = arguments constants = constants })
    Result.Ok(scheduled)
}
fn runtime(parameters Int, params List[Int], returns Int) RuntimeSignature {
    RuntimeSignature { parameters = parameters params = params result = returns }
}
fn two_types(a Int, b Int) List[Int] { let values = ints(a)
    push(values, b)
    values
}
fn three_types(a Int, b Int, c Int) List[Int] { let values = two_types(a, b)
    push(values, c)
    values
}
fn runtime_signature(env Environment, name Text) RuntimeSignature {
    if name == "clock_monotonic_ns" { return runtime(0, new[Int](), 1) }
    if name == "timer_until_ns" { return runtime(0, ints(1), 0) }
    if name == "task_next" { return runtime(0, new[Int](), 1) }
    if name == "async_read" || name == "async_write_bytes" { return runtime(0, three_types(1, 4, 1), 1) }
    if name == "async_write" { return runtime(0, three_types(1, 3, 1), 1) }
    if name == "async_open" { return runtime(0, two_types(3, 2), 1) }
    if name == "async_close" || name == "file_abort" { return runtime(0, ints(1), 1) }
    if name == "float_from_int" { return runtime(0, ints(1), 5) }
    if name == "float_to_int" { return runtime(0, ints(5), 1) }
    if name == "float_parse" { return runtime(0, ints(3), 5) }
    if name == "float_format" { return runtime(0, ints(5), 3) }
    if name == "text_len" || name == "open" || name == "create" || name == "path_kind" { return runtime(0, ints(3), 1) }
    if name == "text_byte" { return runtime(0, two_types(3, 1), 1) }
    if name == "text_concat" { return runtime(0, two_types(3, 3), 3) }
    if name == "text_equal" { return runtime(0, two_types(3, 3), 2) }
    if name == "text_slice" { return runtime(0, three_types(3, 1, 1), 3) }
    if name == "unicode_alphabetic" || name == "unicode_alphanumeric" || name == "unicode_whitespace" { return runtime(0, ints(1), 2) }
    if name == "arg_count" { return runtime(0, new[Int](), 1) }
    if name == "arg_text" { return runtime(0, ints(1), 3) }
    if name == "process_run" { return runtime(0, ints(intern(env, TypeKind.List, -1, ints(3))), 1) }
    if name == "process_run_input" { return runtime(0, two_types(intern(env, TypeKind.List, -1, ints(3)), 3), 1) }
    if name == "process_capture_configured" || name == "process_capture_input_configured" {
        let list = intern(env, TypeKind.List, -1, ints(3))
        let params = ints(list)
        if name == "process_capture_input_configured" { push(params, 4) }
        push(params, 3)
        push(params, 1)
        push(params, list)
        push(params, 4)
        push(params, 4)
        return runtime(0, params, 1)
    }
    if name == "env_get" { return runtime(0, two_types(3, 4), 1) }
    if name == "exit" { return runtime(0, ints(1), 0) }
    if name == "bytes_new" { return runtime(0, new[Int](), 4) }
    if name == "bytes_len" { return runtime(0, ints(4), 1) }
    if name == "bytes_get" { return runtime(0, two_types(4, 1), 1) }
    if name == "bytes_set" { return runtime(0, three_types(4, 1, 1), 0) }
    if name == "bytes_push" { return runtime(0, two_types(4, 1), 0) }
    if name == "bytes_utf8" { return runtime(0, ints(4), 2) }
    if name == "bytes_text_copy" { return runtime(0, ints(4), 3) }
    if name == "read" { return runtime(0, three_types(1, 4, 1), 1) }
    if name == "write" { return runtime(0, three_types(1, 3, 1), 1) }
    if name == "write_bytes" { return runtime(0, three_types(1, 4, 1), 1) }
    if name == "close" { return runtime(0, ints(1), 1) }
    if name == "directory_read" { return runtime(0, two_types(3, intern(env, TypeKind.List, -1, ints(3))), 1) }
    if name == "path_canonical" { return runtime(0, two_types(3, 4), 1) }
    if name == "directory_create" || name == "file_remove" || name == "directory_remove" || name == "path_entry_kind" { return runtime(0, ints(3), 1) }
    if name == "path_rename" { return runtime(0, two_types(3, 3), 1) }
    let parameter = get(abstract_arguments(env, 1), 0)
    if name == "task_observe" {
        let task = intern(env, TypeKind.Task, -1, ints(parameter))
        return runtime(1, two_types(task, 1), task)
    }
    let list = intern(env, TypeKind.List, -1, ints(parameter))
    if name == "list_new" { return runtime(1, new[Int](), list) }
    if name == "list_len" { return runtime(1, ints(list), 1) }
    if name == "list_get" { return runtime(1, two_types(list, 1), parameter) }
    if name == "list_push" { return runtime(1, two_types(list, parameter), 0) }
    if name == "list_append" { return runtime(1, two_types(list, parameter), list) }
    if name == "list_set" { return runtime(1, three_types(list, 1, parameter), 0) }
    runtime(-1, new[Int](), -1)
}
fn validate_intrinsic(env Environment, id Int) Result[Text, Failure] {
    let current = get(env.signatures, id)
    let item = symbol(env, current.symbol)
    let expected = if item.name == "list_take" {
        let parameter = get(abstract_arguments(env, 1), 0)
        let list = intern(env, TypeKind.List, -1, ints(parameter))
        if get(env.type_states, current.result).phase == 0 {
            discard expand_type(env, current.result, 0)?
        }
        if !std.loom.typed.list_take_result(env.types, current.result, parameter, list) {
            return Result.Err(failure(env, current.symbol, item.node, "list_take requires an optional (element, remaining List) result"))
        }
        runtime(1, ints(list), current.result)
    } else { runtime_signature(env, item.name) }
    if expected.parameters < 0 { return Result.Err(failure(env, current.symbol, item.node, "unknown private runtime intrinsic")) }
    if has(item.node, NodeKind.Async) != (item.name == "timer_until_ns" || item.name == "task_next" || item.name == "async_read" || item.name == "async_write" || item.name == "async_write_bytes" || item.name == "async_open" || item.name == "async_close") {
        return Result.Err(failure(env, current.symbol, item.node, "intrinsic declaration has an incorrect async modifier"))
    }
    if current.parameters != expected.parameters || !same(current.params, expected.params) || current.result != expected.result {
        return Result.Err(failure(env, current.symbol, item.node, "intrinsic declaration does not match its runtime signature"))
    }
    if has(item.node, NodeKind.Block) || has(item.node, NodeKind.Requires) || has(item.node, NodeKind.Ensures) {
        return Result.Err(failure(env, current.symbol, item.node, "intrinsic declarations have no source body or contracts"))
    }
    Result.Ok(item.name)
}
fn scalar_contract(context Context, node Node) Result[Bool, Failure] {
    if node.kind == NodeKind.Integer || node.kind == NodeKind.Float || node.kind == NodeKind.Bool { return Result.Ok(true) }
    if node.kind == NodeKind.Name && package(node.value) == "" { return Result.Ok(true) }
    if node.kind == NodeKind.Call {
        let arguments = child(node, 1).children
        var index = 0
        while index < length(arguments) {
            discard scalar_contract(context, get(arguments, index))?
            index = index + 1
        }
        return Result.Ok(true)
    }
    if node.kind == NodeKind.Unary || node.kind == NodeKind.Binary {
        var index = 0
        while index < length(node.children) {
            discard scalar_contract(context, child(node, index))?
            index = index + 1
        }
        return Result.Ok(true)
    }
    Result.Err(error(context, node, "contracts require scalar predicates and pure helper calls"))
}
fn contracts(context Context, node Node, kind NodeKind) Result[List[Expr], Failure] {
    let clauses = new[Expr]()
    var index = 0
    while index < length(node.children) {
        let member = child(node, index)
        if member.kind == kind {
            let predicate = child(member, 0)
            discard scalar_contract(context, predicate)?
            push(clauses, expr(context, predicate, 2)?)
        }
        index = index + 1
    }
    Result.Ok(clauses)
}

// Construction and mandatory verification share one binder/body checker. A
// private proof closure can construct its caller without verifying it recursively.
fn function_body(env Environment, id Int, arguments List[Int], constants List[StaticValue], emit Bool) Result[CheckedBody, Failure] {
    let original = get(env.signatures, id)
    let item = symbol(env, original.symbol)
    let runtime_name = if has(item.node, NodeKind.Intrinsic) { validate_intrinsic(env, id)? } else { "" }
    let current = signature(env, id, arguments, item.node)?
    discard task_signature(env, current, item.node)?
    if emit && length(env.interfaces) != 0 {
        let seen = new[Int]()
        var index = 0
        while index < length(current.params) { discard emitted_type(env, current.symbol, get(current.params, index), item.node, seen)?
            index = index + 1 }
        discard emitted_type(env, current.symbol, current.result, item.node, seen)?
    }
    var context = Context { env = env signature = current arguments = arguments
        constants = constants locals = new[Local]() bindings = new[Binding]() head = -1
        cleanups = new[Cleanup]() cleanup_head = -1 loop_boundary = -2 facts = new[Fact]() fact_head = -1 emit = emit }
    discard resource_parameters(context)?
    let parameters = group(item.node, NodeKind.Parameters)
    let filtered = has_static(current)
    let runtime_params = if filtered { new[Int]() } else { current.params }
    var index = 0
    var constant = 0
    while index < length(parameters) {
        let parameter = get(parameters, index)
        if is_static(current, index) {
            context = bind_name(context, parameter, parameter.value, -1, constant, -1)?
            constant = constant + 1
        } else {
            context = bind_local(context, parameter, parameter.value, get(current.params, index), false, -1)?
            if filtered { push(runtime_params, get(current.params, index)) }
        }
        index = index + 1
    }
    let preconditions = contracts(context, item.node, NodeKind.Requires)?
    index = 0
    while index < length(preconditions) {
        context = assuming(context, get(preconditions, index), true, 0)
        index = index + 1
    }
    let body = if runtime_name == "" {
        block(context, child(item.node, part(item.node, NodeKind.Block)), current.result, true)?
    } else {
        let values = new[Expr]()
        index = 0
        while index < length(current.params) {
            push(values, atom(ExprKind.Local, get(current.params, index), item.node, index))
            index = index + 1
        }
        let call = expression(if has(item.node, NodeKind.Async) { ExprKind.Suspend } else { ExprKind.Intrinsic },
            current.result, item.node, runtime_name, -1, values, true)
        expression(ExprKind.Block, current.result, item.node, "", -1, expressions(call), true)
    }
    var result_local = -1
    if has(item.node, NodeKind.Ensures) {
        result_local = length(context.locals)
        push(context.locals, Local { name = "result" ty = current.result mutable = false is_scoped = false })
        let binding = length(context.bindings)
        push(context.bindings, Binding { name = "result" local = result_local constant = -1 previous = context.head })
        context = context_at(context, binding)
    }
    let checked_function = Function { is_async = has(item.node, NodeKind.Async) symbol = current.symbol arguments = arguments params = runtime_params result = current.result
        locals = context.locals preconditions = preconditions postconditions = new[Expr]() result_local = result_local
        body = body runtime_name = runtime_name span = item.node.span }
    discard task_flow(context, checked_function)?
    Result.Ok(CheckedBody { context = context function = checked_function })
}
fn function(env Environment, id Int, arguments List[Int], constants List[StaticValue], emit Bool) Result[Function, Failure] {
    let checked = function_body(env, id, arguments, constants, emit)?
    checked_contracts(checked.context, id, checked.function)
}
