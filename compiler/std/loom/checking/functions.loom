import std.loom.binding.Failure
import std.loom.ast.has
import std.loom.project.package
import std.loom.ast.Node
import std.loom.ast.NodeKind
import std.loom.typed.TypeKind
import std.loom.typed.Local
import std.loom.typed.Expr
import std.loom.typed.ExprKind
import std.loom.typed.Function
import std.loom.typed.list_take_result
import std.loom.typed.list_replace_result
import std.loom.typed.task_outcome_result
import std.loom.typed.task_terminal_result
import std.list.new
import std.list.get
import std.list.push
import std.list.length
import std.text.slice
import std.result.Result

record RuntimeSignature {
    parameters Int
    params List[Int]
    result Int
}

record CheckedBody {
    context Context
    function Function
}

fn signature(env Environment, id Int, arguments List[Int], node Node) Result[Signature, Failure] {
    signature_in(env, id, arguments, node, get(env.signatures, id).symbol)
}

fn signature_in(env Environment, id Int, arguments List[Int], node Node, owner Int) Result[Signature, Failure] {
    let original = get(env.signatures, id)
    if length(arguments) != original.parameters {
        return Result.Err(failure(env, original.symbol, node, "wrong number of function type arguments"))
    }
    let params = new[Int]()
    var index = 0
    while index < length(original.params) {
        let ty = substitute(env, owner, get(original.params, index), arguments, node)?
        if is_static(original, index) && !static_parameter_type(env, ty) {
            return Result.Err(failure(env, owner, node, "comptime parameters require immutable stored values or a function type after specialization"))
        }
        push(params, ty)
        index = index + 1
    }
    let obligations = new[Requirement]()
    index = 0
    while index < length(original.requirements) {
        let obligation = get(original.requirements, index)
        push(obligations, Requirement { ty = substitute(env, owner, obligation.ty, arguments, node)? capability = obligation.capability })
        index = index + 1
    }
    Result.Ok(Signature { symbol = original.symbol parameters = original.parameters params = params
        compile_time = original.compile_time result = substitute(env, owner, original.result, arguments, node)? requirements = obligations })
}

fn method_target(env Environment, id Int, arguments List[Int], constants List[StaticValue]) Result[Instance, Failure] {
    let current = get(env.signatures, id)
    let declaration = symbol(env, current.symbol).node
    let capability = symbol(env, current.symbol).owner
    if length(get(env.concepts, concept_index(env, capability)).families) != 0 {
        discard demand_implementations(env, get(arguments, 0), capability)?
    }
    let selected = conformance(env, get(arguments, 0), capability)
    if selected.implementation < 0 {
        return Result.Err(failure(env, current.symbol, declaration, "concept evidence has no concrete implementation"))
    }
    let methods = get(env.concepts, concept_index(env, capability)).methods
    var slot = 0
    while get(methods, slot) != id { slot = slot + 1 }
    let target = get(get(env.implementations, selected.implementation).methods, slot)
    if target == id && !has(declaration, NodeKind.Block) {
        return Result.Err(failure(env, current.symbol, declaration, "concept evidence has no concrete implementation"))
    }
    Result.Ok(Instance { signature = target
        arguments = if target == id { arguments } else { member_arguments(selected.arguments, argument_tail(arguments, 1)) }
        constants = constants })
}

fn abstract_method_instance(env Environment, id Int, arguments List[Int]) Bool {
    if id < 0 || !prototype(env, get(env.signatures, id).symbol) || length(arguments) == 0 {
        return false
    }
    !concrete(env, get(arguments, 0))
}

fn schedule(env Environment, id Int, arguments List[Int], constants List[StaticValue], node Node) Result[Int, Failure] {
    let current = get(env.signatures, id)
    // Scheduling has the callee identity, not the caller's source identity.
    // A failure anchored to the declaration must also use that declaration's span.
    let declaration = symbol(env, current.symbol).node
    if prototype(env, current.symbol) && !abstract_method_instance(env, id, arguments) {
        let selected = method_target(env, id, arguments, constants)?
        if selected.signature != id { return schedule(env, selected.signature, selected.arguments, constants, node) }
    }
    if !known_constants(constants) { return Result.Err(failure(env, current.symbol, declaration, "comptime arguments must be determined for this instance")) }
    // Dispatch must validate the selected implementation/default, not only the
    // concept declaration. Witness activation and CTFE schedule here as well.
    discard validate_static(env, id, constants, declaration)?
    var index = 0
    var instances = 0
    while index < length(env.pending) {
        let previous = get(env.pending, index)
        if previous.signature == id {
            instances = instances + 1
            if same(previous.arguments, arguments) && same_constants(previous.constants, constants) { return Result.Ok(index) }
        }
        index = index + 1
    }
    // Independent declarations do not consume one global expansion budget.
    if instances >= 1024 {
        return Result.Err(failure(env, current.symbol, declaration, "function specialization budget exceeded; expansion must be finite"))
    }
    index = 0
    while index < length(arguments) {
        if type_depth(env, get(arguments, index)) >= 64 {
            return Result.Err(failure(env, current.symbol, declaration, "function specialization depth exceeded; expansion must be finite"))
        }
        index = index + 1
    }
    let scheduled = length(env.pending)
    push(env.pending, Instance { signature = id arguments = arguments constants = constants })
    Result.Ok(scheduled)
}

fn runtime(parameters Int, params List[Int], returns Int) RuntimeSignature {
    RuntimeSignature { parameters = parameters params = params result = returns }
}

fn two_types(a Int, b Int) List[Int] { let values = ints(a)
    push(values, b)
    values
}

fn three_types(a Int, b Int, c Int) List[Int] { let values = two_types(a, b)
    push(values, c)
    values
}

fn runtime_signature(env Environment, name Text) RuntimeSignature {
    if name == "fault_text" {
        return runtime(0, ints(3), 0)
    }
    if name == "clock_monotonic_ns" {
        return runtime(0, new[Int](), 1)
    }
    if name == "timer_until_ns" {
        return runtime(0, ints(1), 0)
    }
    if name == "socket_wait" || name == "tls_wait" {
        return runtime(0, two_types(1, 1), 0)
    }
    if name == "socket_listen" || name == "socket_connect" || name == "socket_bind_datagram" {
        return runtime(0, ints(3), 1)
    }
    if name == "socket_accept" || name == "socket_connect_status" || name == "socket_close" || name == "socket_local_port" || name == "socket_shutdown_write" || name == "socket_abort" {
        return runtime(0, ints(1), 1)
    }
    if name == "socket_address" {
        return runtime(0, two_types(1, 1), 3)
    }
    if name == "socket_set_nodelay" {
        return runtime(0, two_types(1, 1), 1)
    }
    if name == "socket_set_keepalive" {
        let arguments = three_types(1, 1, 1)
        push(arguments, 1)
        push(arguments, 1)
        return runtime(0, arguments, 1)
    }
    if name == "tls_client" {
        let arguments = three_types(3, 4, 1)
        push(arguments, 4)
        push(arguments, 4)
        push(arguments, intern(env, TypeKind.List, -1, ints(3)))
        return runtime(0, arguments, 1)
    }
    if name == "tls_server" {
        let arguments = three_types(4, 4, 4)
        push(arguments, 1)
        push(arguments, intern(env, TypeKind.List, -1, ints(3)))
        return runtime(0, arguments, 1)
    }
    if name == "tls_status" || name == "tls_shutdown" || name == "tls_release" || name == "tls_generation" || name == "tls_notify" {
        return runtime(0, ints(1), 1)
    }
    if name == "tls_protocol" {
        return runtime(0, ints(1), 3)
    }
    if name == "tls_output" || name == "tls_peer_certificate" {
        return runtime(0, two_types(1, 4), 1)
    }
    if name == "socket_read" || name == "tls_read" || name == "tls_receive" {
        return runtime(0, three_types(1, 4, 1), 1)
    }
    if name == "socket_write_bytes" || name == "tls_write" {
        let arguments = three_types(1, 4, 1)
        push(arguments, 1)
        return runtime(0, arguments, 1)
    }
    if name == "socket_receive_from" || name == "socket_send_to" {
        let arguments = three_types(1, 4, 1)
        push(arguments, if name == "socket_receive_from" { 4 } else { 3 })
        return runtime(0, arguments, 1)
    }
    if name == "task_next" {
        return runtime(0, new[Int](), 1)
    }
    if name == "async_read" || name == "async_write_bytes" {
        return runtime(0, three_types(1, 4, 1), 1)
    }
    if name == "async_write" {
        return runtime(0, three_types(1, 3, 1), 1)
    }
    if name == "async_resolve" {
        return runtime(0, three_types(3, 4, 1), 1)
    }
    if name == "async_open" {
        return runtime(0, two_types(3, 2), 1)
    }
    if name == "async_close" || name == "file_abort" {
        return runtime(0, ints(1), 1)
    }
    if name == "float_from_int" {
        return runtime(0, ints(1), 5)
    }
    if name == "float_to_int" {
        return runtime(0, ints(5), 1)
    }
    if name == "float_parse" {
        return runtime(0, ints(3), 5)
    }
    if name == "float_format" {
        return runtime(0, ints(5), 3)
    }
    if name == "text_len" || name == "open" || name == "create" || name == "path_kind" {
        return runtime(0, ints(3), 1)
    }
    if name == "text_byte" {
        return runtime(0, two_types(3, 1), 1)
    }
    if name == "text_concat" {
        return runtime(0, two_types(3, 3), 3)
    }
    if name == "text_equal" {
        return runtime(0, two_types(3, 3), 2)
    }
    if name == "text_slice" {
        return runtime(0, three_types(3, 1, 1), 3)
    }
    if name == "unicode_alphabetic" || name == "unicode_alphanumeric" || name == "unicode_whitespace" {
        return runtime(0, ints(1), 2)
    }
    if name == "arg_count" {
        return runtime(0, new[Int](), 1)
    }
    if name == "arg_text" {
        return runtime(0, ints(1), 3)
    }
    if name == "process_run" {
        return runtime(0, ints(intern(env, TypeKind.List, -1, ints(3))), 1)
    }
    if name == "process_run_input" {
        return runtime(0, two_types(intern(env, TypeKind.List, -1, ints(3)), 3), 1)
    }
    if name == "process_capture_configured" || name == "process_capture_input_configured" || name == "async_process_capture" {
        let list = intern(env, TypeKind.List, -1, ints(3))
        let params = ints(list)
        if name == "process_capture_input_configured" || name == "async_process_capture" {
            push(params, 4)
        }
        push(params, 3)
        push(params, 1)
        push(params, list)
        push(params, 4)
        push(params, 4)
        return runtime(0, params, 1)
    }
    if name == "env_get" {
        return runtime(0, two_types(3, 4), 1)
    }
    if name == "mutex_lock" {
        return runtime(0, ints(intern(env, TypeKind.List, -1, ints(1))), 1)
    }
    if name == "mutex_unlock" {
        return runtime(0, ints(1), 2)
    }
    if name == "exit" {
        return runtime(0, ints(1), 0)
    }
    if name == "bytes_new" {
        return runtime(0, new[Int](), 4)
    }
    if name == "bytes_len" {
        return runtime(0, ints(4), 1)
    }
    if name == "bytes_get" {
        return runtime(0, two_types(4, 1), 1)
    }
    if name == "bytes_set" {
        return runtime(0, three_types(4, 1, 1), 0)
    }
    if name == "bytes_push" {
        return runtime(0, two_types(4, 1), 0)
    }
    if name == "bytes_utf8" {
        return runtime(0, ints(4), 2)
    }
    if name == "bytes_text_copy" {
        return runtime(0, ints(4), 3)
    }
    if name == "read" {
        return runtime(0, three_types(1, 4, 1), 1)
    }
    if name == "write" {
        return runtime(0, three_types(1, 3, 1), 1)
    }
    if name == "write_bytes" {
        return runtime(0, three_types(1, 4, 1), 1)
    }
    if name == "close" {
        return runtime(0, ints(1), 1)
    }
    if name == "directory_read" {
        return runtime(0, two_types(3, intern(env, TypeKind.List, -1, ints(3))), 1)
    }
    if name == "path_canonical" {
        return runtime(0, two_types(3, 4), 1)
    }
    if name == "directory_create" || name == "file_remove" || name == "directory_remove" || name == "path_entry_kind" {
        return runtime(0, ints(3), 1)
    }
    if name == "path_rename" {
        return runtime(0, two_types(3, 3), 1)
    }
    let parameter = get(abstract_arguments(env, 1), 0)
    if name == "async_worker" {
        return runtime(1, ints(intern(env, TypeKind.Function, -1, ints(parameter))), parameter)
    }
    if name == "resource_generate" {
        let callback = intern(env, TypeKind.Function, -1, two_types(1, parameter))
        return runtime(1, two_types(1, callback), intern(env, TypeKind.List, -1, ints(parameter)))
    }
    if name == "task_drain" {
        return runtime(1, two_types(intern(env, TypeKind.Task, -1, ints(parameter)), 2), 0)
    }
    if name == "task_observe" {
        let task = intern(env, TypeKind.Task, -1, ints(parameter))
        return runtime(1, two_types(task, 1), task)
    }
    let list = intern(env, TypeKind.List, -1, ints(parameter))
    if name == "list_new" {
        return runtime(1, new[Int](), list)
    }
    if name == "list_len" {
        return runtime(1, ints(list), 1)
    }
    if name == "list_get" {
        return runtime(1, two_types(list, 1), parameter)
    }
    if name == "list_push" {
        return runtime(1, two_types(list, parameter), 0)
    }
    if name == "list_append" {
        return runtime(1, two_types(list, parameter), list)
    }
    if name == "list_set" {
        return runtime(1, three_types(list, 1, parameter), 0)
    }
    if name == "list_retain_range" {
        let params = two_types(list, intern(env, TypeKind.List, -1, ints(list)))
        push(params, 1)
        push(params, 1)
        return runtime(1, params, 0)
    }
    runtime(-1, new[Int](), -1)
}

fn validate_intrinsic(env Environment, id Int) Result[Text, Failure] {
    let current = get(env.signatures, id)
    let item = symbol(env, current.symbol)
    let expected = if meta_intrinsic(env, current.symbol) {
        meta_signature(env, current, item.node)?
    } else if build_intrinsic(env, current.symbol) {
        if !same(current.compile_time, ints(0)) {
            return Result.Err(failure(env, current.symbol, item.node, "build inputs require one comptime Text parameter"))
        }
        runtime(0, ints(3), if item.name == "option_present" { 2 } else { if item.name == "input_bytes" { 4 } else { 3 } })
    } else if reflection_intrinsic(env, current.symbol) {
        if predicate_intrinsic(env, current.symbol) {
            discard predicate_model(env, current.symbol, current.result, item.node)?
            runtime(1, new[Int](), current.result)
        } else if item.name == "from_fields" {
            if length(current.compile_time) != 0 {
                return Result.Err(failure(env, current.symbol, item.node, "from_fields requires one runtime tuple argument"))
            }
            let parameters = abstract_arguments(env, 2)
            runtime(2, ints(get(parameters, 1)), get(parameters, 0))
        } else {
            discard reflection_model(env, current.symbol, current.result, item.node)?
            runtime(1, new[Int](), current.result)
        }
    } else if item.name == "task_next_terminal" {
        if get(env.type_states, current.result).phase == 0 {
            discard expand_type(env, current.result, 0)?
        }
        if !std.loom.typed.task_terminal_result(env.types, current.result) {
            return Result.Err(failure(env, current.symbol, item.node, "task terminal requires completed, faulted(Text record), and cancelled variants"))
        }
        runtime(0, new[Int](), current.result)
    } else if item.name == "task_outcome" || item.name == "task_cancel" {
        let parameter = get(abstract_arguments(env, 1), 0)
        if get(env.type_states, current.result).phase == 0 {
            discard expand_type(env, current.result, 0)?
        }
        if !std.loom.typed.task_outcome_result(env.types, current.result, parameter) {
            return Result.Err(failure(env, current.symbol, item.node, "task outcome requires completed(T), faulted(Text record), and cancelled variants"))
        }
        runtime(1, ints(intern(env, TypeKind.Task, -1, ints(parameter))), current.result)
    } else {
        if item.name == "list_take" || item.name == "list_replace" {
            let parameter = get(abstract_arguments(env, 1), 0)
            let list = intern(env, TypeKind.List, -1, ints(parameter))
            if get(env.type_states, current.result).phase == 0 {
                discard expand_type(env, current.result, 0)?
            }
            if item.name == "list_take" && !std.loom.typed.list_take_result(env.types, current.result, parameter, list) {
                return Result.Err(failure(env, current.symbol, item.node, "list_take requires an optional (element, remaining List) result"))
            }
            if item.name == "list_replace" && !std.loom.typed.list_replace_result(env.types, current.result, parameter, list) {
                return Result.Err(failure(env, current.symbol, item.node, "list_replace requires an (element, remaining List) result"))
            }
            runtime(1, if item.name == "list_take" { ints(list) } else { three_types(list, 1, parameter) }, current.result)
        } else {
            runtime_signature(env, item.name)
        }
    }
    if expected.parameters < 0 { return Result.Err(failure(env, current.symbol, item.node, "unknown private runtime intrinsic")) }
    if has(item.node, NodeKind.Async) != (item.name == "async_worker" || item.name == "timer_until_ns" || item.name == "socket_wait" || item.name == "tls_wait" || item.name == "task_next" || item.name == "task_next_terminal" || item.name == "task_outcome" || item.name == "async_read" || item.name == "async_write" || item.name == "async_write_bytes" || item.name == "async_open" || item.name == "async_close" || item.name == "async_resolve" || item.name == "async_process_capture") {
        return Result.Err(failure(env, current.symbol, item.node, "intrinsic declaration has an incorrect async modifier"))
    }
    if current.parameters != expected.parameters || !same(current.params, expected.params) || current.result != expected.result {
        return Result.Err(failure(env, current.symbol, item.node, "intrinsic declaration does not match its runtime signature"))
    }
    if has(item.node, NodeKind.Block) || has(item.node, NodeKind.Requires) || has(item.node, NodeKind.Ensures) {
        return Result.Err(failure(env, current.symbol, item.node, "intrinsic declarations have no source body or contracts"))
    }
    Result.Ok(item.name)
}

fn scalar_contract(context Context, node Node) Result[Bool, Failure] {
    if node.kind == NodeKind.Integer || node.kind == NodeKind.Float || node.kind == NodeKind.Bool || node.kind == NodeKind.Text { return Result.Ok(true) }
    if node.kind == NodeKind.Name {
        if package(node.value) == "" || lookup(context, slice(node.value, 0, first_dot(node.value))) >= 0 {
            return Result.Ok(true)
        }
    }
    if node.kind == NodeKind.Index || node.kind == NodeKind.Apply {
        discard scalar_contract(context, child(node, 0))?
        let indices = child(node, 1).children
        var index = 0
        while index < length(indices) {
            discard scalar_contract(context, get(indices, index))?
            index = index + 1
        }
        return Result.Ok(true)
    }
    if node.kind == NodeKind.Call {
        let arguments = child(node, 1).children
        var index = 0
        while index < length(arguments) {
            discard scalar_contract(context, get(arguments, index))?
            index = index + 1
        }
        return Result.Ok(true)
    }
    if node.kind == NodeKind.Construct {
        var index = 1
        while index < length(node.children) {
            discard scalar_contract(context, child(child(node, index), 0))?
            index = index + 1
        }
        return Result.Ok(true)
    }
    if node.kind == NodeKind.Old || node.kind == NodeKind.Unary || node.kind == NodeKind.Binary || node.kind == NodeKind.Select || node.kind == NodeKind.Tuple {
        var index = 0
        while index < length(node.children) {
            discard scalar_contract(context, child(node, index))?
            index = index + 1
        }
        return Result.Ok(true)
    }
    Result.Err(error(context, node, "contracts require scalar predicates and pure helper calls"))
}
// Parameters cannot be rebound. Immutable entry expressions denote the same
// value at normal return; their helpers and definedness still need the ordinary
// mandatory proof. Shared observations take the separate entry-snapshot path.
fn old_parameter(context Context, node Node) Bool {
    let parameters = group(symbol(context.env, context.signature.symbol).node, NodeKind.Parameters)
    let root = slice(node.value, 0, first_dot(node.value))
    var index = 0
    while index < length(parameters) {
        if get(parameters, index).value == root { return true }
        index = index + 1
    }
    false
}

fn old_place(context Context, node Node) Bool {
    if node.kind == NodeKind.Name { return old_parameter(context, node) }
    if node.kind == NodeKind.Select { return old_place(context, child(node, 0)) }
    false
}

fn old_inline_path(context Context, value Expr) Bool {
    if value.kind == ExprKind.Coerce {
        return old_inline_path(context, get(value.children, 0))
    }
    if value.kind == ExprKind.Local {
        return value.index >= 0 && value.index < length(context.locals) &&
            !get(context.locals, value.index).mutable
    }
    if value.kind == ExprKind.Field {
        let receiver = get(value.children, 0)
        let kind = get(context.env.types, receiver.ty).kind
        return (kind == TypeKind.Record || kind == TypeKind.Tuple) && old_inline_path(context, receiver)
    }
    false
}

fn old_entry_expression(context Context, node Node, shared Bool, depth Int) Result[Bool, Failure] {
    if depth >= 64 {
        return Result.Err(error(context, node, "old entry expression nesting limit exceeded"))
    }
    if old_place(context, node) {
        let value = expr(context, node, -1)?
        return Result.Ok(old_inline_path(context, value) &&
            (inline_constraint_base(context.env, value.ty, 0) ||
                (shared && get(context.env.types, base_type(context.env, value.ty)).kind == TypeKind.List)))
    }
    if node.kind == NodeKind.Integer || node.kind == NodeKind.Float ||
    node.kind == NodeKind.Bool || node.kind == NodeKind.Text {
        return Result.Ok(true)
    }
    if shared && (node.kind == NodeKind.Index || node.kind == NodeKind.Apply) {
        if !old_entry_expression(context, child(node, 0), true, depth + 1)? {
            return Result.Ok(false)
        }
        let indices = child(node, 1).children
        var index = 0
        while index < length(indices) {
            if !old_entry_expression(context, get(indices, index), true, depth + 1)? {
                return Result.Ok(false)
            }
            index = index + 1
        }
        return Result.Ok(inline_constraint_base(context.env, expr(context, node, -1)?.ty, 0))
    }
    let call = node.kind == NodeKind.Call
    if call && lookup(context, slice(node.value, 0, first_dot(node.value))) >= 0 {
        return Result.Ok(false)
    }
    if !call && node.kind != NodeKind.Unary && node.kind != NodeKind.Binary &&
    node.kind != NodeKind.Tuple && node.kind != NodeKind.Select && node.kind != NodeKind.Construct {
        return Result.Ok(false)
    }
    let operands = if call { child(node, 1).children } else { node.children }
    var index = if node.kind == NodeKind.Construct { 1 } else { 0 }
    while index < length(operands) {
        let operand = get(operands, index)
        let input = if node.kind == NodeKind.Construct { child(operand, 0) } else { operand }
        if !old_entry_expression(context, input, shared, depth + 1)? {
            return Result.Ok(false)
        }
        index = index + 1
    }
    let value = expr(context, node, -1)?
    Result.Ok(inline_constraint_base(context.env, value.ty, 0) ||
        (shared && old_list_type(context.env, value.ty)))
}

fn has_old(node Node) Bool {
    if node.kind == NodeKind.Old { return true }
    var index = 0
    while index < length(node.children) {
        if has_old(child(node, index)) { return true }
        index = index + 1
    }
    false
}

fn old_contract(context Context, node Node, kind NodeKind) Result[Node, Failure] {
    if node.kind == NodeKind.Old {
        if kind != NodeKind.Ensures { return Result.Err(error(context, node, "old is only valid in ensures")) }
        let argument = child(node, 0)
        if old_entry_expression(context, argument, false, 0)? {
            return Result.Ok(argument)
        }
        discard old_observation(context, node)?
        return Result.Ok(node)
    }
    let children = new[Node]()
    var index = 0
    while index < length(node.children) {
        push(children, old_contract(context, child(node, index), kind)?)
        index = index + 1
    }
    Result.Ok(Node { kind = node.kind value = node.value span = node.span children = children })
}

fn contracts(context Context, node Node, kind NodeKind) Result[List[Expr], Failure] {
    let clauses = new[Expr]()
    var index = 0
    while index < length(node.children) {
        let member = child(node, index)
        if member.kind == kind {
            let source = child(member, 0)
            let predicate = if has_old(source) { old_contract(context, source, kind)? } else { source }
            discard scalar_contract(context, predicate)?
            push(clauses, expr(context, predicate, 2)?)
        }
        index = index + 1
    }
    Result.Ok(clauses)
}

record FunctionScope {
    context Context
    preconditions List[Expr]
    params List[Int]
}

fn function_scope(env Environment, declared Signature, arguments List[Int], constants List[StaticValue], emit Bool) Result[FunctionScope, Failure] {
    let current = scoped_type_domains(env, declared, arguments)?
    let item = symbol(env, current.symbol)
    var context = Context { lexical = new_lexical() env = env signature = current arguments = arguments
        constants = constants locals = new[Local]() bindings = new[Binding]() head = -1
        cleanups = new[Cleanup]() cleanup_head = -1 loop_boundary = -2 facts = new[Fact]() fact_head = -1 emit = emit }
    let parameters = group(item.node, NodeKind.Parameters)
    let filtered = has_static(current)
    let runtime_params = if filtered { new[Int]() } else { current.params }
    let resources = resource_concept(env, "MustScope") >= 0
    var index = 0
    var constant = 0
    while index < length(parameters) {
        let parameter = get(parameters, index)
        if is_static(current, index) {
            if resources && must_scope(context, get(current.params, index))? {
                return Result.Err(error(context, parameter, "comptime parameters cannot contain MustScope resources"))
            }
            let storage = static_environment_type(env, get(constants, constant))
            let local = if storage >= 0 { length(context.locals) } else { -1 }
            context = bind_name(context, parameter, parameter.value, local, constant, -1)?
            if storage >= 0 {
                push(context.locals, Local { name = parameter.value ty = storage mutable = false is_scoped = false })
                push(runtime_params, storage)
            }
            constant = constant + 1
        } else {
            context = bind_local(context, parameter, parameter.value, get(current.params, index), false, -1)?
            if resources && must_scope(context, get(current.params, index))? {
                resource_borrow_local(context, length(context.locals) - 1)
            }
            if filtered { push(runtime_params, get(current.params, index)) }
        }
        index = index + 1
    }
    let preconditions = add_contracts(contracts(context, item.node, NodeKind.Requires)?,
        inherited_contracts(context, NodeKind.Requires)?)
    index = 0
    while index < length(preconditions) {
        context = assuming(context, get(preconditions, index), true, 0)
        index = index + 1
    }
    Result.Ok(FunctionScope { context = context preconditions = preconditions params = runtime_params })
}

// Construction and mandatory verification share one binder/body checker. A
// private proof closure can construct its caller without verifying it recursively.
fn function_body(env Environment, id Int, arguments List[Int], constants List[StaticValue], emit Bool) Result[CheckedBody, Failure] {
    if id < 0 { return closure_body(env, -1 - id, new[Context](), emit) }
    let original = get(env.signatures, id)
    let item = symbol(env, original.symbol)
    let runtime_name = if has(item.node, NodeKind.Intrinsic) { validate_intrinsic(env, id)? } else { "" }
    let current = signature(env, id, arguments, item.node)?
    discard task_signature(env, current, item.node)?
    let scope = function_scope(env, current, arguments, constants, emit)?
    var context = scope.context
    let body = if runtime_name == "" {
        block(context, child(item.node, part(item.node, NodeKind.Block)), current.result, true)?
    } else if runtime_name == "resource_generate" {
        generated_resources(context, item.node, current.result)?
    } else if build_intrinsic(env, current.symbol) || reflection_intrinsic(env, current.symbol) {
        expression(ExprKind.Deferred, current.result, item.node, "", -1, new[Expr](), true)
    } else {
        let values = new[Expr]()
        var index = 0
        while index < length(current.params) {
            push(values, atom(ExprKind.Local, get(current.params, index), item.node, index))
            index = index + 1
        }
        let call = expression(if has(item.node, NodeKind.Async) { ExprKind.Suspend } else { ExprKind.Intrinsic },
            current.result, item.node, runtime_name, -1, values, runtime_name != "fault_text")
        expression(ExprKind.Block, current.result, item.node, "", -1, expressions(call), call.falls)
    }
    var result_local = -1
    if has(item.node, NodeKind.Ensures) || inherited_method_contract(env, current.symbol, NodeKind.Ensures) {
        result_local = length(context.locals)
        push(context.locals, Local { name = "result" ty = current.result mutable = false is_scoped = false })
        let binding = length(context.bindings)
        push(context.bindings, Binding { name = "result" local = result_local constant = -1 previous = context.head })
        context = context_at(context, binding)
    }
    let checked_function = Function { is_async = has(item.node, NodeKind.Async) symbol = current.symbol arguments = arguments params = scope.params result = current.result
        locals = context.locals preconditions = scope.preconditions postconditions = new[Expr]() result_local = result_local
        body = body runtime_name = if runtime_name == "resource_generate" { "" } else { runtime_name } span = item.node.span }
    discard task_flow(context, checked_function)?
    Result.Ok(CheckedBody { context = context function = checked_function })
}

fn checked_function(env Environment, id Int, arguments List[Int], constants List[StaticValue], emit Bool) Result[Function, Failure] {
    let checked = function_body(env, id, arguments, constants, emit)?
    let verified = checked_contracts(checked.context, id, checked.function)?
    Result.Ok(close_function(checked.context, verified))
}

fn function(env Environment, id Int, arguments List[Int], constants List[StaticValue], emit Bool) Result[Function, Failure] {
    if active_pack(env) < 0 { return checked_function(env, id, arguments, constants, emit) }
    let pending = pending_pack_snapshot(env)
    match checked_function(env, id, arguments, constants, emit) {
        Result.Ok(checked) => Result.Ok(checked)
        Result.Err(failed) => {
            rollback_new_pending_packs(env, pending)
            Result.Err(failed)
        }
    }
}
