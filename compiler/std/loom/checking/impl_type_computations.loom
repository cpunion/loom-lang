// A private type-checking scope. Executable values never carry these schemas.
record ImplTypeComputation {
    scope ImplMethodScope
    frame List[Node]
    values List[Node]
    bindings List[Int]
    computation ImplComputation
    element Bool
}

// Static aliases have session-wide identity; closure-local binding slots do
// not. Capturing a type input preserves this identity without a runtime field.
fn impl_computation_binding(context Context, name Text) Int {
    let selected = lookup(context, name)
    if selected < 0 {
        return -1
    }
    let binding = get(context.bindings, selected)
    if binding.constant < -1 {
        return -2 - binding.constant
    }
    -1
}

fn bind_computation_word(context Context, node Node, boundary Int) Result[Context, Failure] {
    let alias = length(context.env.static_aliases)
    push(context.env.static_aliases, StaticAlias {
            node = pack_node(node, NodeKind.Type, "$word-input", new[Node]())
            ty = meta_type(context.env)
        })
    bind_name(context, node, node.value, -1, -2 - alias, boundary)
}

fn impl_computation_scope(scope ImplMethodScope, computation ImplComputation) ImplMethodScope {
    let types = new[Int]()
    var index = 0
    while index < computation.first {
        push(types, get(scope.types, index))
        index = index + 1
    }
    index = 0
    while index < length(computation.layouts) {
        push(types, get(computation.layouts, index).ty)
        index = index + 1
    }
    ImplMethodScope {
        types = types
        evidence = computation.evidence
        ..scope
    }
}

// Only the original checked binding can supply a word. Local/family binders
// mask it; staging and branches remain the ordinary evaluator's responsibility.
fn impl_computation_origins(context Context, source Node, input ImplTypeComputation) Result[Bool, Failure] {
    let origins = impl_method_word_origins(context.env, context.signature.symbol, source,
        input.frame, input.values)?
    var origin = 0
    while origin < length(origins) {
        pack_word_origin_add(input.computation.origins, get(origins, origin))
        origin = origin + 1
    }
    if length(input.computation.origins) > 1 {
        return Result.Err(error(context, source, "elementwise expansion needs proved equal source widths"))
    }
    Result.Ok(true)
}

fn impl_computation_reference(context Context, source Node) Result[Bool, Failure] {
    let input = get(get(context.env.inputs, 0).type_computations, context.type_computation)
    if !input.element {
        return Result.Ok(false)
    }
    var index = 0
    while index < length(input.frame) {
        let parameter = get(input.frame, index)
        if parameter.kind == NodeKind.TypePack && pack_root(source, parameter.value) &&
        get(input.bindings, index) >= 0 && impl_computation_binding(context, parameter.value) == get(input.bindings, index) {
            return impl_computation_origins(context, source, input)
        }
        index = index + 1
    }
    Result.Ok(false)
}

fn impl_computation_source(context Context, source Node, input ImplTypeComputation,
    names List[Text], spread Bool, changed List[Bool]) Result[Node, Failure] {
    if source.kind == NodeKind.Comptime || source.kind == NodeKind.Function || source.kind == NodeKind.TypeParameters {
        return Result.Ok(source)
    }
    var value = source.value
    var index = 0
    while index < length(input.frame) {
        let parameter = get(input.frame, index)
        let name = get(names, index)
        if parameter.kind == NodeKind.TypePack && name != "" && pack_root(source, name) &&
        get(input.bindings, index) >= 0 && impl_computation_binding(context, name) == get(input.bindings, index) {
            if spread {
                value = concat(concat("$layout-input#", to_text(index)), slice(value, length(name), length(value)))
                set(changed, 0, true)
            } else if input.element {
                discard impl_computation_origins(context, source, input)?
            }
        }
        index = index + 1
    }
    let children = new[Node]()
    var visible = family_pack_names(source, names)
    index = 0
    while index < length(source.children) {
        let member = child(source, index)
        push(children, impl_computation_source(context, member, input,
                lexical_pack_names(source, index, visible, false), spread || source.kind == NodeKind.Spread, changed)?)
        if source.kind == NodeKind.Block {
            visible = lexical_pack_names(member, 0, visible, true)
        }
        index = index + 1
    }
    Result.Ok(pack_node(source, source.kind, value, children))
}

// A local type value already has checked identity. Restore its scoped schema,
// including nested captured types, before comparing or admitting a whole input.
fn impl_computation_identities(context Context, scope ImplMethodScope, source Node,
    computation ImplComputation, frame List[Node], values List[Node], depth Int) Result[Node, Failure] {
    if depth >= 64 {
        return Result.Err(error(context, source, "implementation method type expansion must be finite"))
    }
    if (source.kind == NodeKind.Type || source.kind == NodeKind.Name) && std.text.starts_with(source.value, "$type#") {
        let ty = resolve_bound(context.env, context.signature.symbol, source, context.arguments,
            context.signature.requirements, 0)?
        let inputs = new[Int]()
        var index = 0
        while index < length(computation.layouts) {
            push(inputs, get(computation.layouts, index).ty)
            index = index + 1
        }
        if !computed_family_closed(context.env, ty, computation.prior,
            new[FamilyAliases](), -1, new[(Int, Int)](), 0, inputs) {
            return Result.Err(error(context, source, "dynamic associated family needs a uniform symbolic type template"))
        }
        let schema = impl_method_family_canonical(context.env, scope,
            impl_method_resolved_schema(context.env, scope, ty, source, depth + 1)?, depth + 1)?
        let parameter = pack_node(source, NodeKind.Name, concat("$layout-local#", to_text(length(frame))), new[Node]())
        push(frame, parameter)
        push(values, schema)
        return Result.Ok(pack_node(source, NodeKind.Type, parameter.value, new[Node]()))
    }
    let children = new[Node]()
    var index = 0
    while index < length(source.children) {
        push(children, impl_computation_identities(context, scope, child(source, index), computation, frame, values, depth + 1)?)
        index = index + 1
    }
    Result.Ok(pack_node(source, source.kind, source.value, children))
}

fn impl_computation_type(context Context, source Node) Result[Option[Int], Failure] {
    let input = get(get(context.env.inputs, 0).type_computations, context.type_computation)
    if !input.element && !has_type_expansion(source) {
        return Result.Ok(Option.None)
    }
    let names = new[Text]()
    let frame = new[Node]()
    var index = 0
    while index < length(input.frame) {
        let parameter = get(input.frame, index)
        push(names, parameter.value)
        push(frame, pack_node(parameter, parameter.kind, concat("$layout-input#", to_text(index)), parameter.children))
        index = index + 1
    }
    let changed = [false]
    let prepared = impl_computation_source(context, source, input, names, false, changed)?
    if !get(changed, 0) {
        return Result.Ok(Option.None)
    }
    let env = context.env
    let owner = context.signature.symbol
    let scope = impl_computation_scope(input.scope, input.computation)
    let values = std.list.clone(input.values)
    let normalized = impl_computation_identities(context, scope, meta_type_node(context, prepared)?,
        input.computation, frame, values, 0)?
    let schema = impl_method_substitute(env, scope, owner,
        type_pattern_schema(env, owner, normalized, input.element, 0, true, true, frame)?, frame, values, 0)?
    Result.Ok(Option.Some(impl_computation_input(context, scope, source, schema, input.computation)?))
}
