test fn pack_header_scopes_reject_unexpanded_words_before_contract_erasure() {
    let invalid = """
        fn symbolic[As..., Bs...](values (As, (Bs...))) Int
        ensures result == 0 {
            0
        }
        """
    rejects(invalid)
    let valid = std.text.join(std.text.split(invalid, "(As, (Bs...))"), "(As..., (Bs...))")
    discard accepted(valid)
    let cache = definition_cache()
    assert match cached_source(cache, valid) {
        Result.Ok(_) => true
        Result.Err(_) => false
    }
    assert match cached_source(restored_definition_cache(cache), invalid) {
        Result.Err(_) => true
        Result.Ok(_) => false
    }
    rejects("fn unused[As...](value As) {}")
    rejects("fn unused[As..., Bs...](value (fn(As...) Bs,)) {}")
    discard accepted("fn unused[As..., Bs...](value (fn(As...) (Bs...),)) {}")
    discard accepted("fn unused[As...](values fn(As) As...) {}")
}

test fn pack_header_scopes_validate_unused_record_and_enum_fields() {
    rejects("record Invalid[As...] { value As }")
    rejects("enum Invalid[As...] { Value(As) }")
    discard accepted("record Valid[As...] { value (As...) }")
    discard accepted("enum Valid[As...] { Value(As...) }")
}

test fn implementation_members_inherit_their_headers_pack_scope() {
    let valid = """
        concept Collection {
            type Items
            fn items(self Self) Self.Items
        }
        impl[As...] Collection for (As...) {
            type Items = (As...)
            fn items(self Self) Self.Items {
                self
            }
        }
        """
    discard accepted(valid)
    rejects(std.text.join(std.text.split(valid, "type Items = (As...)"), "type Items = As"))
    rejects(std.text.join(std.text.split(valid, "fn items(self Self) Self.Items {"), "fn items(self Self) As {"))
}

test fn pack_widths_visit_arguments_of_an_already_seen_projection_receiver() {
    let source = """
        concept Family {
            type Item[T]
        }
        impl Family for Bool {
            type Item[T] = T
        }
        record Pairs[As... Family, Bs...] {
            sources (As...)
            items ((As, As.Item[Bs])...)
        }
        fn main() {
            let pairs Pairs[(Bool, Bool)..., (Int, Text)...] = Pairs {
                sources = (true, false)
                items = ((true, 7), (false, "value"))
            }
            assert pairs.items.0.1 == 7
            assert pairs.items.1.1 == "value"
        }
        """
    discard accepted(source)
    rejects(std.text.replace(source, "(Int, Text)...", "(Int, Text, Bool)..."))
}
