// Each source function declaration owns one signature. Concrete instances and
// pack expansions retain their separate, existing instance/symbol identities.
fn append_signature(env Environment, current Signature) Int {
    let ids = get(env.inputs, 0).signature_ids
    while length(ids) <= current.symbol {
        push(ids, -1)
    }
    let id = length(env.signatures)
    push(env.signatures, current)
    set(ids, current.symbol, id)
    id
}

fn source_signature_id(env Environment, owner Int) Int {
    let ids = get(env.inputs, 0).signature_ids
    if owner >= length(ids) {
        return -1
    }
    get(ids, owner)
}

// Header CTFE can demand a later declaration. The existing index records -1
// for absent and -2 only while its header is being resolved; no partial
// signature is visible to overload selection or saved after failure.
fn demand_source_signature(env Environment, owner Int) Result[Int, Failure] {
    let known = source_signature_id(env, owner)
    if known >= 0 {
        return Result.Ok(known)
    }
    let node = symbol(env, owner).node
    if known == -2 {
        return Result.Err(failure(env, owner, node, "cyclic compile-time dependency in function signature"))
    }
    let ids = get(env.inputs, 0).signature_ids
    while length(ids) <= owner {
        push(ids, -1)
    }
    set(ids, owner, -2)
    let arguments = abstract_arguments(env, function_parameter_count(env, owner))
    let built = match requirements(env, owner, arguments) {
        Result.Ok(evidence) => match source_signature(env, owner, arguments, evidence) {
            Result.Ok(current) => register_signature(env, current)
            Result.Err(failed) => Result.Err(failed)
        }
        Result.Err(failed) => Result.Err(failed)
    }
    match built {
        Result.Ok(id) => Result.Ok(id)
        Result.Err(failed) => {
            set(ids, owner, -1)
            Result.Err(failed)
        }
    }
}

fn demand_call_signatures(env Environment, available List[Int]) Result[Bool, Failure] {
    var index = 0
    while index < length(available) {
        let owner = get(available, index)
        let item = symbol(env, owner)
        if item.node.kind == NodeKind.Function && pack_parameter(item.node) < 0 &&
        (item.owner < 0 || prototype(env, owner)) {
            discard demand_source_signature(env, owner)?
        }
        index = index + 1
    }
    Result.Ok(true)
}

fn call_signature_options(env Environment, available List[Int], arguments Int, parameters Int) List[Int] {
    let options = new[Int]()
    var index = 0
    while index < length(available) {
        let id = source_signature_id(env, get(available, index))
        if id >= 0 {
            let signature = get(env.signatures, id)
            if length(signature.params) == arguments && (parameters < 0 || parameters == explicit_call_parameters(env, signature)) {
                // Retain signature-table order and duplicate candidates.
                var position = length(options)
                push(options, id)
                while position > 0 && get(options, position - 1) > id {
                    set(options, position, get(options, position - 1))
                    position = position - 1
                }
                set(options, position, id)
            }
        }
        index = index + 1
    }
    options
}
