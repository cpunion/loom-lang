import std.loom.proof.fresh_list_factory
import std.loom.proof.single_list_write

// A constrained List has no pre-existing writable outer aliases. Content
// predicates may observe immutable fields, not nested shared mutable storage.
// Copies retain the constrained type and ordinary sharing.
// Plain List borrows must not escape. Stores require a proved preserving
// operation; no runtime monitor is needed.
fn constrained_list(env Environment, ty Int) Bool {
    let shape = get(env.types, ty)
    shape.kind == TypeKind.Refined && length(shape.fields) == 1 &&
    get(env.types, get(shape.fields, 0).ty).kind == TypeKind.List
}

fn closed_list_value(value Expr) Bool {
    if value.kind != ExprKind.List {
        return false
    }
    var index = 0
    while index < length(value.children) {
        let child = get(value.children, index)
        if !closed_inline_value(child, 0) {
            return false
        }
        index = index + 1
    }
    true
}

fn list_constraint_required(env Environment, value Expr) Bool {
    if !env.has_refinements {
        return false
    }
    if value.text == "checked list" || constrained_list(env, value.ty) {
        return true
    }
    var index = 0
    while index < length(value.children) {
        if list_constraint_required(env, get(value.children, index)) {
            return true
        }
        index = index + 1
    }
    index = 0
    while index < length(value.arms) {
        let arm = get(value.arms, index)
        var item = 0
        while item < length(arm.body) {
            if list_constraint_required(env, get(arm.body, item)) {
                return true
            }
            item = item + 1
        }
        index = index + 1
    }
    false
}

fn list_constraint_error(env Environment, owner Int, value Expr, message Text) Failure {
    Failure {
        source = symbol(env, owner).file
        diagnostic = Diagnostic {
            span = value.span
            message = message
        }
    }
}

fn constraint_weakened(env Environment, value Expr) Bool {
    value.kind == ExprKind.Coerce && length(value.children) == 1 &&
    constrained_list(env, get(value.children, 0).ty) &&
    value.ty == base_type(env, get(value.children, 0).ty)
}

fn constraint_restored(env Environment, value Expr) Bool {
    // Only reification emits this semantic marker, after computation's ordinary
    // construction/escape checks. The base graph is freshly allocated and fully
    // initialized before its already validated nominal value is published.
    value.kind == ExprKind.Coerce && value.text == "comptime value" &&
    length(value.children) == 1 && get(env.types, value.ty).kind == TypeKind.Refined &&
    get(value.children, 0).ty == base_type(env, value.ty)
}

fn constraint_fresh(env Environment, functions List[Function], value Expr) Bool {
    if value.kind == ExprKind.List {
        return true
    }
    if value.kind != ExprKind.Call || value.index < 0 || value.index >= length(functions) {
        return false
    }
    // A pure, non-publishing factory may read its arguments, but cannot retain
    // an alias to its result outside this call. No library-name shortcut.
    let program = std.loom.typed.Program {
        types = env.types
        functions = functions
        entry = -1
        tests = new[Int]()
        test_names = new[Text]()
        exports = new[Int]()
        interfaces = env.interfaces
        witnesses = env.witnesses
    }
    // Argument expressions run before the factory creates its result. Validate
    // the callee's purity, not unrelated I/O/awaits used to obtain those inputs.
    let parameters = new[Expr]()
    var parameter = 0
    while parameter < length(value.children) {
        let argument = get(value.children, parameter)
        push(parameters, Expr {
                kind = ExprKind.Local
                ty = argument.ty
                span = argument.span
                text = ""
                index = parameter
                children = new[Expr]()
                arms = new[Arm]()
                falls = true
            })
        parameter = parameter + 1
    }
    let probe = Expr {
        kind = value.kind
        ty = value.ty
        span = value.span
        text = value.text
        index = value.index
        children = parameters
        arms = new[Arm]()
        falls = true
    }
    if match std.loom.eval.validate(program, probe) {
        Result.Ok(_) => false,
        Result.Err(_) => true
    } {
        return false
    }
    std.loom.proof.fresh_list_factory(program, value.index)
}

fn constraint_operation(env Environment, functions List[Function], value Expr) Bool {
    constraint_operation(env, functions, value, false)
}

fn constraint_operation(env Environment, functions List[Function], value Expr, established Bool) Bool {
    let inputs = new[InputOrigin]()
    var writes = 2
    var index = 0
    while index < length(value.children) {
        let argument = get(value.children, index)
        let protected = constraint_weakened(env, argument)
        if protected {
            let allowed = get(env.type_states, get(argument.children, 0).ty).list_writes
            if allowed < writes {
                writes = allowed
            }
        }
        push(inputs, if protected {
                origin_input()
            } else {
                origin_empty()
            })
        index = index + 1
    }
    if writes == 0 {
        let store = std.loom.proof.single_list_write(functions, value)
        if store > 0 && invariant_intrinsic_allowed(true, store,
            if store == 1 {
                "list_set"
            } else {
                "list_push"
            }, inputs) &&
        (established || proved_list_update(env, value, store)) {
            return true
        }
    }
    if value.kind == ExprKind.Intrinsic {
        return invariant_intrinsic_allowed(true, writes, value.text, inputs) &&
        (value.ty == 0 || inline_constraint_base(env, value.ty, 0) || constraint_output_independent(env, value))
    }
    if value.kind != ExprKind.Call {
        return false
    }
    let reads = invariant_reads(env, functions, value, true, writes, -1)
    let output = invariant_call(reads, value.index, inputs, 0)
    if get(reads.valid, 0) && (!origin_shared(output) || constraint_output_independent(env, value)) {
        return true
    }
    if writes != 0 || env.expanding_helpers {
        return false
    }
    // First prove that the helper cannot publish the protected header. Then
    // discharge the complete invariant at every store, never only at return.
    let mutable = invariant_reads(env, functions, value, true, 2, -1)
    let returned = invariant_call(mutable, value.index, inputs, 0)
    get(mutable.valid, 0) && (!origin_shared(returned) || constraint_output_independent(env, value)) &&
    proved_list_mutation(env, value, false, constraint_mutation_writes(env, functions, value, inputs))
}

// A checked footprint distinguishes replacement from resizing. It supplies
// storage permissions, not evidence that either operation preserves a predicate.
fn constraint_mutation_writes(env Environment, functions List[Function], value Expr, inputs List[InputOrigin]) Int {
    let replacements = invariant_reads(env, functions, value, true, 1, -1)
    discard invariant_call(replacements, value.index, inputs, 0)
    if get(replacements.valid, 0) {
        1
    } else {
        2
    }
}

fn list_constraint_expression(env Environment, functions List[Function], owner Int, value Expr) Result[Bool, Failure] {
    list_constraint_expression(env, functions, owner, value, new[Expr]())
}

fn list_constraint_expression(env Environment, functions List[Function], owner Int, value Expr, drafts List[Expr]) Result[Bool, Failure] {
    // Only original typing can emit this certificate. Cached bodies retain its
    // definition dependencies; recheck the non-publishing operation structure.
    if value.kind == ExprKind.Block && value.text == "proved list update" && length(value.children) == 1 {
        let operation = get(value.children, 0)
        if !constraint_operation(env, functions, operation, true) {
            return Result.Err(list_constraint_error(env, owner, operation,
                    "this operation may invalidate or expose constrained List storage; use a proved preserving operation or an explicit copy"))
        }
        var index = 0
        while index < length(operation.children) {
            let child = get(operation.children, index)
            discard list_constraint_expression(env, functions, owner, if constraint_weakened(env, child) {
                    get(child.children, 0)
                } else {
                    child
                }, drafts)?
            index = index + 1
        }
        return Result.Ok(true)
    }
    // Compiler-emitted checked construction: the private raw temporary is used
    // only by the validated predicate and the successful refined result.
    if value.kind == ExprKind.Block && value.text == "checked list" {
        let input = get(get(value.children, 0).children, 0)
        if !constraint_fresh(env, functions, input) && !established_draft(value, drafts) {
            return Result.Err(list_constraint_error(env, owner, input,
                    "a List constraint requires fresh unpublished storage; use a fresh literal, a proved factory, an unpublished local draft or an explicit copy"))
        }
        discard list_constraint_expression(env, functions, owner, input, drafts)?
        discard list_constraint_expression(env, functions, owner, get(get(value.children, 1).children, 0), drafts)?
        return Result.Ok(true)
    }
    if value.kind == ExprKind.Coerce && constrained_list(env, value.ty) &&
    !constraint_restored(env, value) && !constraint_fresh(env, functions, get(value.children, 0)) &&
    !established_draft(value, drafts) {
        return Result.Err(list_constraint_error(env, owner, value,
                "a List constraint requires fresh unpublished storage; use a fresh literal, a proved factory, an unpublished local draft or an explicit copy"))
    }
    var borrowed = false
    var index = 0
    while index < length(value.children) {
        if constraint_weakened(env, get(value.children, index)) {
            borrowed = true
        }
        index = index + 1
    }
    if borrowed && !constraint_operation(env, functions, value) {
        return Result.Err(list_constraint_error(env, owner, value,
                "this operation may invalidate or expose constrained List storage; use a proved preserving operation or an explicit copy"))
    }
    if constraint_weakened(env, value) {
        return Result.Err(list_constraint_error(env, owner, value,
                "constrained List storage cannot escape as an unrestricted List"))
    }
    index = 0
    while index < length(value.children) {
        let child = get(value.children, index)
        discard list_constraint_expression(env, functions, owner,
            if constraint_weakened(env, child) {
                get(child.children, 0)
            } else {
                child
            }, drafts)?
        index = index + 1
    }
    index = 0
    while index < length(value.arms) {
        let arm = get(value.arms, index)
        var item = 0
        while item < length(arm.body) {
            discard list_constraint_expression(env, functions, owner, get(arm.body, item), drafts)?
            item = item + 1
        }
        index = index + 1
    }
    Result.Ok(true)
}

fn list_constraint_function(env Environment, functions List[Function], current Function) Result[Bool, Failure] {
    if !env.has_refinements {
        return Result.Ok(true)
    }
    let drafts = unpublished_drafts(env, functions, current)
    discard list_constraint_expression(env, functions, current.symbol, current.body, drafts)?
    var index = 0
    while index < length(current.preconditions) {
        discard list_constraint_expression(env, functions, current.symbol, get(current.preconditions, index))?
        index = index + 1
    }
    Result.Ok(true)
}

fn list_constraint_functions(env Environment, functions List[Function]) Result[Bool, Failure] {
    if !env.has_refinements {
        return Result.Ok(true)
    }
    var index = 0
    while index < length(functions) {
        discard list_constraint_function(env, functions, get(functions, index))?
        index = index + 1
    }
    Result.Ok(true)
}
