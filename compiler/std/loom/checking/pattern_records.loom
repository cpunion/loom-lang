record RecordPatternField {
    source Node
    index Int
}

// Match arms and ordinary bindings share nominal identity, visibility and field
// completeness. Explicit fields stay in source order; omitted fields follow.
fn record_pattern_fields(context Context, node Node, ty Int) Result[List[RecordPatternField], Failure] {
    let shape = get(context.env.types, ty)
    if shape.kind != TypeKind.Record {
        return Result.Err(error(context, node, "record pattern requires a record value"))
    }
    let target = find_data(context.env, context.signature.symbol, node, node.value)?
    if target < 0 || target != shape.symbol {
        return Result.Err(error(context, node, "pattern belongs to a different nominal record"))
    }
    let declaration = symbol(context.env, shape.symbol)
    let here = symbol(context.env, context.signature.symbol)
    if !declaration.public && get(context.env.source.files, declaration.file).package != get(context.env.source.files, here.file).package {
        return Result.Err(error(context, node, "cannot inspect a private record from another package"))
    }
    let fields = new[RecordPatternField]()
    let seen = new[Bool]()
    var index = 0
    while index < length(shape.fields) {
        push(seen, false)
        index = index + 1
    }
    var omitted = node
    var rest = false
    index = 0
    while index < length(node.children) {
        let member = child(node, index)
        if member.kind == NodeKind.RestPattern {
            omitted = member
            rest = true
        } else {
            var field = -1
            var search = 0
            while search < length(shape.fields) {
                if get(shape.fields, search).name == member.value {
                    field = search
                }
                search = search + 1
            }
            if field < 0 {
                return Result.Err(error(context, member, "unknown record field in pattern"))
            }
            if get(seen, field) {
                return Result.Err(error(context, member, "duplicate record field in pattern"))
            }
            set(seen, field, true)
            push(fields, RecordPatternField {
                    source = child(member, 0)
                    index = field
                })
        }
        index = index + 1
    }
    index = 0
    while index < length(shape.fields) {
        if !get(seen, index) {
            if !rest {
                return Result.Err(error(context, node, "match every record field or explicitly omit fields with '..'"))
            }
            let wildcard = Node {
                kind = NodeKind.Wildcard
                value = ""
                span = omitted.span
                children = new[Node]()
            }
            push(fields, RecordPatternField {
                    source = wildcard
                    index = index
                })
        }
        index = index + 1
    }
    Result.Ok(fields)
}

fn record_pattern_scope(context Context, node Node, ty Int, body Node, boundary Int, depth Int) Result[PatternScope, Failure] {
    let fields = record_pattern_fields(context, node, ty)?
    let shape = get(context.env.types, ty)
    let positions = new[Int]()
    let checked = new[CheckedPattern]()
    var current = context
    var index = 0
    while index < length(fields) {
        push(positions, -1)
        index = index + 1
    }
    index = 0
    while index < length(fields) {
        let field = get(fields, index)
        let nested = pattern_scope(current, field.source, get(shape.fields, field.index).ty, body, boundary, depth + 1)?
        current = nested.context
        set(positions, field.index, length(checked))
        push(checked, nested.pattern)
        index = index + 1
    }
    let children = new[CheckedPattern]()
    index = 0
    while index < length(positions) {
        push(children, get(checked, get(positions, index)))
        index = index + 1
    }
    Result.Ok(PatternScope {
            context = current
            pattern = CheckedPattern {
                source = node
                ty = ty
                variant = -2
                local = -1
                children = children
            }
        })
}

fn pattern_product_types(shape Type) List[Int] {
    if shape.kind == TypeKind.Tuple {
        return shape.arguments
    }
    let types = new[Int]()
    var index = 0
    while index < length(shape.fields) {
        push(types, get(shape.fields, index).ty)
        index = index + 1
    }
    types
}
