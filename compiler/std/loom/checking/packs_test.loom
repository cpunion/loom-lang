test fn variadic_calls_infer_arbitrary_arity_and_contextual_function_values() {
    discard accepted("fn pack[Ts...](values Ts...) (Ts...) { values }\nfn forward[R, Ts...](callback fn(Ts...) R, values Ts...) R { callback(values...) }\nfn combine(a Int, b Text) Text { b }\nfn main() { let pair = pack(1, \"two\")\nassert pair.0 == 1 && pair.1 == \"two\"\nlet empty = pack()\ndiscard pack(empty...)\nlet many = pack(1, true, \"three\", 4, 5, 6, 7)\nassert many.6 == 7\nassert forward(combine, 1, \"ok\") == \"ok\"\nlet callback fn(Int, Text) (Int, Text) = pack\nassert callback(2, \"yes\").0 == 2\nlet singleton = pack[Int]\nassert singleton(3).0 == 3\nassert comptime { pack(4, true).0 } == 4 }")
}

test fn variadic_arity_checks_keep_declared_bounds_and_required_proofs() {
    discard accepted("concept Display { fn show(self Self) Text }\nimpl Display for Int { fn show(self Int) Text { \"int\" } }\nfn first[Ts... Display](values Ts...) Text { values.0.show() }\nfn main() { assert first(1) == \"int\" }")
    rejects("concept Display { fn show(self Self) Text }\nimpl Display for Int { fn show(self Int) Text { \"int\" } }\nfn first[Ts...](values Ts...) Text { values.0.show() }\nfn main() { discard first(1) }")
    rejects("fn add[Ts...](values Ts...) Int { values.0 + 1 }\nfn main() { discard add(1) }")
    rejects("fn broken[Ts...](values Ts...) Int ensures result > 0 { discard values\n0 }\nfn main() { discard broken(1) }")
    rejects("fn uncalled[Ts...](values Ts...) Int ensures result > 0 { discard values\n0 }")
    rejects("fn growing[Ts...](values Ts...) { growing(values..., 1) }\nfn main() { growing() }")
    rejects("fn f[Ts...](values Ts...) Ts { values }\nfn main() { discard f(1) }")
    rejects("fn f[Ts...](values Ts...) (Ts...) { values }\nfn main() { f(1) }")
    rejects("fn f[Ts..., U](values Ts...) {}")
    rejects("record Bad[Ts...] { values (Ts...) }")
    rejects("fn f(values Int...) {}")
    rejects("fn f[Ts... Missing](values Ts...) {}\nfn main() { f() }")
    rejects("fn values() Bool { true }\nfn f[Ts...](values Ts...) (Ts...) requires values() { values }\nfn main() { discard f(1) }")
}

test fn variadic_packs_transfer_tasks_through_ordinary_typed_parameters() {
    discard accepted("fn pack[Ts...](values Ts...) (Ts...) { values }\nasync fn item[T](value T) T { value }\nasync fn forward[Ts...](values Task[Ts]...) (Task[Ts]...) { values }\nasync fn main() { let tasks = forward(item(1), item(\"two\")).await\nassert tasks.0.await == 1\nassert tasks.1.await == \"two\"\nlet gathered = pack(item(3), item(true))\nassert gathered.0.await == 3\nassert gathered.1.await }")
    rejects("fn pack[Ts...](values Ts...) (Ts...) { values }\nasync fn item() Int { 1 }\nasync fn main() { let task = item()\nlet pair = pack(task, task)\ndiscard pair.0.await\ndiscard pair.1.await }")
    discard accepted("fn pack[Ts...](values Ts...) (Ts...) { values }\nfn f() {}\nfn main() { f(pack()...) }")
    rejects("fn pack[Ts...](values Ts...) (Ts...) { values }\nfn f(comptime value Int) Int { value }\nfn main() { discard f(pack()..., 1) }")
}
