import std.result.Result
import std.text.slice

test fn variadic_calls_infer_arbitrary_arity_and_contextual_function_values() {
    discard accepted("fn pack[Ts...](values Ts...) (Ts...) { values }\nfn forward[R, Ts...](callback fn(Ts...) R, values Ts...) R { callback(values...) }\nfn combine(a Int, b Text) Text { b }\nfn main() { let pair = pack(1, \"two\")\nassert pair.0 == 1 && pair.1 == \"two\"\nlet empty = pack()\ndiscard pack(empty...)\nlet many = pack(1, true, \"three\", 4, 5, 6, 7)\nassert many.6 == 7\nassert forward(combine, 1, \"ok\") == \"ok\"\nlet callback fn(Int, Text) (Int, Text) = pack\nassert callback(2, \"yes\").0 == 2\nlet singleton = pack[Int]\nassert singleton(3).0 == 3\nassert comptime { pack(4, true).0 } == 4 }")
}

test fn static_iteration_errors_point_to_an_unbound_tuple_name() {
    let source = "fn bad[Ts...](values Ts...) { comptime for value in missing { discard value } }\nfn main() { bad(1, 2) }"
    match checked(source_files(source)) {
        Result.Err(failed) => {
            assert failed.diagnostic.message == "comptime for requires an immutable tuple binding"
            assert slice(source, failed.diagnostic.span.start, failed.diagnostic.span.end) == "missing"
        }
        Result.Ok(_) => {
            assert false
        }
    }
}

test fn variadic_arity_checks_keep_declared_bounds_and_required_proofs() {
    discard accepted("concept Display { fn show(self Self) Text }\nimpl Display for Int { fn show(self Int) Text { \"int\" } }\nfn first[Ts... Display](values Ts...) Text { values.0.show() }\nfn main() { assert first(1) == \"int\" }")
    rejects("concept Display { fn show(self Self) Text }\nimpl Display for Int { fn show(self Int) Text { \"int\" } }\nfn first[Ts...](values Ts...) Text { values.0.show() }\nfn main() { discard first(1) }")
    rejects("fn add[Ts...](values Ts...) Int { values.0 + 1 }\nfn main() { discard add(1) }")
    rejects("fn broken[Ts...](values Ts...) Int ensures result > 0 { discard values\n0 }\nfn main() { discard broken(1) }")
    rejects("fn uncalled[Ts...](values Ts...) Int ensures result > 0 { discard values\n0 }")
    rejects("fn growing[Ts...](values Ts...) { growing(values..., 1) }\nfn main() { growing() }")
    rejects("fn f[Ts...](values Ts...) Ts { values }\nfn main() { discard f(1) }")
    rejects("fn f[Ts...](values Ts...) (Ts...) { values }\nfn main() { f(1) }")
    rejects("fn f[Ts..., U](values Ts...) {}")
    rejects("record Bad[Ts...] { values (Ts...) }")
    rejects("fn f(values Int...) {}")
    rejects("fn f[Ts... Missing](values Ts...) {}\nfn main() { f() }")
    rejects("fn values() Bool { true }\nfn f[Ts...](values Ts...) (Ts...) requires values() { values }\nfn main() { discard f(1) }")
}

test fn variadic_packs_transfer_tasks_through_ordinary_typed_parameters() {
    discard accepted("fn pack[Ts...](values Ts...) (Ts...) { values }\nasync fn item[T](value T) T { value }\nasync fn forward[Ts...](values Task[Ts]...) (Task[Ts]...) { values }\nasync fn main() { let tasks = forward(item(1), item(\"two\")).await\nassert tasks.0.await == 1\nassert tasks.1.await == \"two\"\nlet gathered = pack(item(3), item(true))\nassert gathered.0.await == 3\nassert gathered.1.await }")
    rejects("fn pack[Ts...](values Ts...) (Ts...) { values }\nasync fn item() Int { 1 }\nasync fn main() { let task = item()\nlet pair = pack(task, task)\ndiscard pair.0.await\ndiscard pair.1.await }")
    discard accepted("fn pack[Ts...](values Ts...) (Ts...) { values }\nfn f() {}\nfn main() { f(pack()...) }")
    rejects("fn pack[Ts...](values Ts...) (Ts...) { values }\nfn f(comptime value Int) Int { value }\nfn main() { discard f(pack()..., 1) }")
}

test fn static_pack_iteration_checks_each_selected_element_and_lexical_scope() {
    discard accepted("concept Tag { fn tag(self Self) Int }\nimpl Tag for Int { fn tag(self Int) Int { self } }\nimpl Tag for Bool { fn tag(self Bool) Int { if self { 1 } else { 0 } } }\nfn total[Ts... Tag](values Ts...) Int { var sum = 0\ncomptime for value in values { sum = sum + value.tag()\nlet value = 99\ndiscard value }\nsum }\nfn main() { assert total() == 0\nassert total(40, true, 1) == 42 }")
    rejects("fn bad[Ts...](values Ts...) { comptime for value in other { discard value } }\nfn main() { bad(1) }")
    discard accepted("fn shadow[Ts...](values Ts...) Int { let values = (40, 2)\nvar sum = 0\ncomptime for value in values { sum = sum + value }\nsum }\nfn main() { assert shadow(true) == 42 }")
    discard accepted("fn sum(values (Int, Int)) Int { var total = 0\ncomptime for value in values { total = total + value }\ntotal }\nfn main() { assert sum((40, 2)) == 42 }")
    discard accepted("fn stop[Ts...](values Ts...) Int { var count = 0\nwhile true { comptime for value in values { discard value\ncount = count + 1\nbreak }\ncount = count + 100\nbreak }\ncount }\nfn main() { assert stop(1, 2) == 1\nassert stop() == 100 }")
    discard accepted("fn skipped[Ts...](values Ts...) Int { var count = 0\nvar reached = 0\nwhile count < 2 { comptime for value in values { discard value\ncount = count + 1\ncontinue }\nreached = reached + 1\ncount = 2 }\nreached }\nfn main() { assert skipped(1) == 0\nassert skipped() == 1 }")
    rejects("fn bad[Ts...](values Ts...) { comptime for value in values { continue } }\nfn main() { bad(1) }")
    discard accepted("fn ok[Ts...](values Ts...) { comptime for value in values { var count = 0\nwhile count < 1 { count = count + 1\ncontinue }\ndiscard value } }\nfn main() { ok(1, true) }")
    discard accepted("fn selected[Ts...](values Ts...) { comptime if Int == Bool { comptime for value in other { break } } else { comptime for value in values { discard value } } }\nfn main() { selected(1, true) }")
    discard accepted("fn selected[Ts...](values Ts...) { comptime if Int == Bool { let values = (99, 100)\ncomptime for value in values { discard value } } else { comptime for value in values { discard value } } }\nfn main() { selected(1, true) }")
    rejects("fn selected[Ts...](values Ts...) { comptime if Int == Int { comptime for value in other { discard value } } else { comptime for value in values { discard value } } }\nfn main() { selected(1) }")
}

test fn static_iteration_accepts_immutable_tuple_bindings_and_checks_each_field() {
    discard accepted("fn label(value Int) Int { 1 }\nfn label(value Bool) Int { 2 }\nfn pack[Ts...](values Ts...) (Ts...) { values }\nfn labels(pair (Int, Bool)) Int { var output = 0\ncomptime for value in pair { output = output * 10 + label(value) }\nlet local = (true, 1)\ncomptime for value in local { output = output * 10 + label(value) }\nlet empty = pack()\ncomptime for value in empty { output = 99 }\noutput }\nfn main() { assert labels((7, true)) == 1221 }")
    rejects("fn bad() { var pair = (1, true)\ncomptime for value in pair { discard value } }")
    rejects("fn bad() { let items = [1, 2]\ncomptime for value in items { discard value } }")
    rejects("fn bad() { comptime for value in missing { discard value } }")
    discard accepted("fn mapped(pair (Int, Bool)) (Int, Bool) { comptime map value in pair { value } }\nfn main() { let pair = mapped((1, true))\nassert pair.0 == 1 && pair.1 }")
}

test fn static_tuple_iteration_retains_lexical_closure_and_task_rules() {
    discard accepted("fn captures() { let pair = (1, 2)\ncomptime for value in pair { let read = fn() Int { value }\nassert read() == value } }\nasync fn item[T](value T) T { value }\nasync fn main() { captures()\nlet pair = (item(1), item(true))\ncomptime for task in pair { discard task.await } }")
    rejects("async fn item() Int { 1 }\nasync fn bad() { let pair = (item(),)\ncomptime for task in pair { discard task.await\ndiscard task.await } }")
    rejects("async fn item() Int { 1 }\nasync fn bad() { let pair = (item(),)\ncomptime for task in pair { discard task } }")
}

test fn tuple_iteration_inside_pack_keeps_nested_pack_map() {
    discard accepted("fn nested[Ts...](values (Ts...)) Int { let rounds = (1, 2)\nvar total = 0\ncomptime for round in rounds { let mapped = comptime map item in values { discard item\nround }\ntotal = total + mapped.0 }\ntotal }\nfn main() { assert nested((true,)) == 3 }")
    discard accepted("fn nested_local[Ts...](values (Ts...)) { let local = ((1,),)\ncomptime for values in local { discard comptime map item in values { item } } }\nfn main() { nested_local((true,)) }")
}

test fn static_pack_iteration_preserves_task_consumption() {
    discard accepted("async fn item[T](value T) T { value }\nasync fn drain[Ts...](values Task[Ts]...) { comptime for value in values { discard value.await } }\nasync fn main() { drain(item(1), item(true)).await\ndrain().await }")
    rejects("async fn item() Int { 1 }\nasync fn bad[Ts...](values Task[Ts]...) { comptime for value in values { discard value.await\ndiscard value.await } }\nasync fn main() { bad(item()).await }")
    rejects("async fn item() Int { 1 }\nasync fn bad[Ts...](values Task[Ts]...) { comptime for value in values { discard value } }\nasync fn main() { bad(item()).await }")
}

test fn structural_tuple_pack_maps_lexical_results_from_one_argument() {
    discard accepted("fn gather[Ts...](values (Ts...)) (Ts...) { comptime map item in values { let copy = item\ncopy } }\nfn source() (Int, Bool, Text) { (7, true, \"three\") }\nfn empty[Ts...](values Ts...) (Ts...) { values }\nfn main() { let named = (1, false, \"named\")\nlet a = gather(named)\nassert a.0 == 1 && !a.1 && a.2 == \"named\"\nlet b = gather(source())\nassert b.0 == 7 && b.1 && b.2 == \"three\"\nlet c = gather((9,))\nassert c.0 == 9\nlet d = gather(empty())\ndiscard d\nlet f fn((Int, Bool)) (Int, Bool) = gather\nassert f((3, true)).0 == 3 }")
    rejects("fn bad[Ts...](values (Ts...)) (Ts...) { comptime map item in other { item } }\nfn main() { discard bad((1,)) }")
    rejects("fn bad[Ts...](values (Ts...)) (Ts...) { comptime map item in values { discard item } }\nfn main() { discard bad((1,)) }")
    rejects("fn bad[Ts...](values (Int, Ts...)) (Ts...) { values }\nfn main() { discard bad((1, true)) }")
    discard accepted("fn fixed(values (Int,)) (Int,) { comptime map item in values { item } }\nfn main() { assert fixed((1,)).0 == 1 }")
}

test fn static_map_clones_closure_bodies_per_element() {
    discard accepted("concept Show { fn show(self Self) Text }\nimpl Show for Int { fn show(self Int) Text { \"int\" } }\nimpl Show for Bool { fn show(self Bool) Text { \"bool\" } }\nfn callbacks[Ts... Show](values (Ts...)) (fn() Text, fn() Text) { comptime map item in values { fn() Text { item.show() } } }\nfn main() { let pair = callbacks((4, true))\nassert pair.0() == \"int\" && pair.1() == \"bool\" }")
}

test fn static_map_accepts_tuple_parameters_locals_and_nested_maps() {
    discard accepted("fn identity[T](pair (T, Bool)) (T, Bool) { comptime map item in pair { item } }\nfn main() { let pair = identity((4, true))\nassert pair.0 == 4 && pair.1\nlet local = (true, 9)\nlet mapped = comptime map item in local { item }\nassert mapped.0 && mapped.1 == 9\nlet one_source = (1,)\nlet one = comptime map item in one_source { item }\nassert one.0 == 1 }")
    discard accepted("fn empty[Ts...](values Ts...) (Ts...) { values }\nfn main() { let local = empty()\nlet mapped = comptime map item in local { item }\ndiscard mapped\nlet rows = ((1, 2), (3, 4))\nlet nested = comptime map row in rows { comptime map item in row { item } }\nassert nested.0.0 == 1 && nested.1.1 == 4 }")
    discard accepted("fn shadow[Ts...](values Ts...) (Bool, Int) { let values = (true, 7)\ncomptime map item in values { item } }\nfn main() { let mapped = shadow(1, 2)\nassert mapped.0 && mapped.1 == 7 }")
    discard accepted("fn selected[Ts...](values Ts...) { comptime if Int == Bool { discard comptime map item in missing { item } } else { let local = (1,)\ndiscard comptime map item in local { item } } }\nfn main() { selected(true) }")
}

test fn static_map_keeps_lexical_closures_and_task_transfers() {
    discard accepted("fn readers() (fn() Int, fn() Int) { let pair = (1, 2)\ncomptime map item in pair { fn() Int { item } } }\nfn main() { let pair = readers()\nassert pair.0() == 1 && pair.1() == 2 }")
    discard accepted("async fn item[T](value T) T { value }\nasync fn main() { let tasks = (item(1), item(true))\nlet mapped = comptime map task in tasks { task.await }\nassert mapped.0 == 1 && mapped.1 }")
    rejects("async fn item() Int { 1 }\nasync fn main() { let tasks = (item(),)\nlet mapped = comptime map task in tasks { discard task.await\ntask.await }\ndiscard mapped }")
    rejects("async fn item() Int { 1 }\nasync fn main() { let tasks = (item(),)\nlet mapped = comptime map task in tasks { task }\ndiscard mapped }")
}

test fn static_map_rejects_sources_without_an_immutable_tuple_shape() {
    rejects("fn bad() { let items = [1, 2]\ndiscard comptime map item in items { item } }")
    rejects("fn bad() { discard comptime map item in missing { item } }")
    rejects("fn bad() { let pair = (1,)\ndiscard comptime map item in pair { discard item } }")
    rejects("fn bad() (Bool,) { let pair = (1,)\ncomptime map item in pair { item } }")
}

test fn static_map_errors_point_to_the_mutable_tuple_source() {
    let source = "fn bad() { var pair = (1, true)\ndiscard comptime map item in pair { item } }"
    match checked(source_files(source)) {
        Result.Err(failed) => {
            assert failed.diagnostic.message == "comptime map requires an immutable tuple binding"
            assert slice(source, failed.diagnostic.span.start, failed.diagnostic.span.end) == "pair"
        }
        Result.Ok(_) => { assert false }
    }
}
