fn resource_reconstruction_header() Text {
    concat(resource_enum_header(), """
        import std.option.Option
        record Rebuilt {
            tag Int
            first Handle
            second Handle
        }
        impl Dispose for Rebuilt {
            fn dispose(self Rebuilt) {
            }
        }
        fn tag() Int {
            7
        }
        """)
}

fn resource_pattern_result_header() Text {
    concat(resource_header(), """
        import std.result.Result
        enum Issue {
            Failed(Int)
        }
        fn attempt(log List[Int]) Result[Handle, Issue] {
            Result.Ok(make(log))
        }
        """)
}

test fn decision_tree_pattern_names_forward_fresh_resource_obligations() {
    resource_accept(concat(resource_pattern_result_header(), """
        fn select(log List[Int]) Handle {
            match attempt(log) {
                Result.Ok(value) => value
                Result.Err(Issue.Failed(_)) => make(log)
            }
        }
        fn wrap[T Dispose + MustScope](create fn(List[Int]) Result[T, Issue], log List[Int]) Result[(T,), Issue] {
            match create(log) {
                Result.Err(Issue.Failed(0)) => Result.Err(Issue.Failed(1))
                Result.Err(Issue.Failed(code)) => Result.Err(Issue.Failed(code))
                Result.Ok(value) => Result.Ok((value,))
            }
        }
        fn run(log List[Int]) {
            scoped direct = match attempt(log) {
                Result.Ok(value) => value
                Result.Err(Issue.Failed(_)) => make(log)
            }
            scoped returned = select(log)
            match wrap(attempt, log) {
                Result.Ok(value) => {
                    scoped tuple = value
                }
                Result.Err(Issue.Failed(_)) => {
                }
            }
        }
        """))
}

test fn decision_tree_pattern_names_cannot_duplicate_delay_or_capture_resources() {
    resource_reject_reason(concat(resource_pattern_result_header(), """
        fn delayed(log List[Int]) {
            match attempt(log) {
                Result.Ok(value) => {
                    discard 1
                    scoped held = value
                }
                Result.Err(Issue.Failed(_)) => {
                }
            }
        }
        """), "a resource payload must immediately enter scoped or transfer before any other operation")
    resource_reject_reason(concat(resource_pattern_result_header(), """
        fn delayed_wrapper(log List[Int]) Result[(Handle,), Issue] {
            match attempt(log) {
                Result.Ok(value) => Result.Ok({
                    discard 1
                    (value,)
                })
                Result.Err(Issue.Failed(code)) => Result.Err(Issue.Failed(code))
            }
        }
        """), "a resource payload must immediately enter scoped or transfer before any other operation")
    resource_reject(concat(resource_pattern_result_header(), """
        fn duplicate(log List[Int]) Result[(Handle, Handle), Issue] {
            match attempt(log) {
                Result.Ok(value) => Result.Ok((value, value))
                Result.Err(Issue.Failed(code)) => Result.Err(Issue.Failed(code))
            }
        }
        """))
    resource_reject(concat(resource_pattern_result_header(), """
        fn captured(log List[Int]) fn() Int {
            match attempt(log) {
                Result.Ok(value) => fn() Int {
                    value.use()
                }
                Result.Err(Issue.Failed(_)) => fn() Int {
                    0
                }
            }
        }
        """))
}

test fn fresh_match_payloads_reconstruct_through_existing_aggregate_guards() {
    resource_accept(concat(resource_reconstruction_header(), """
        fn reorder(log List[Int]) Bundle {
            match bundle(log) {
                Bundle.Pair(first, second, value) => {
                    return Bundle.Pair(second, first, value)
                }
                Bundle.Empty => Bundle.Empty
            }
        }
        fn record_pair(log List[Int]) Rebuilt {
            match bundle(log) {
                Bundle.Pair(first, second, value) => Rebuilt {
                    tag = tag()
                    second = second
                    first = first
                }
                Bundle.Empty => Rebuilt {
                    tag = 0
                    first = make(log)
                    second = make(log)
                }
            }
        }
        fn tuple_pair(log List[Int]) (Int, Handle, Handle) {
            match bundle(log) {
                Bundle.Pair(first, second, value) => (tag(), second, first)
                Bundle.Empty => (0, make(log), make(log))
            }
        }
        fn list_pair(log List[Int]) List[Handle] {
            match bundle(log) {
                Bundle.Pair(first, second, value) => [second, first]
                Bundle.Empty => []
            }
        }
        fn direct(log List[Int]) Handle {
            match Option.Some(make(log)) {
                Option.Some(value) => {
                    return value
                }
                Option.None => make(log)
            }
        }
        fn run(log List[Int]) {
            scoped first = reorder(log)
            scoped second = record_pair(log)
            scoped third = tuple_pair(log)
            scoped fourth = list_pair(log)
            scoped fifth = direct(log)
        }
        """))
}

test fn reconstructed_payloads_cannot_copy_borrows_duplicate_or_abandon_owners() {
    resource_reject(concat(resource_reconstruction_header(), """
        fn copied(value Handle, log List[Int]) Bundle {
            Bundle.Pair(value, make(log), 1)
        }
        """))
    resource_reject(concat(resource_reconstruction_header(), """
        fn copied(log List[Int]) Bundle {
            match bundle(log) {
                Bundle.Pair(first, second, value) => Bundle.Pair(first, first, value)
                Bundle.Empty => Bundle.Empty
            }
        }
        """))
    resource_reject(concat(resource_reconstruction_header(), """
        fn abandoned(log List[Int]) List[Handle] {
            match bundle(log) {
                Bundle.Pair(first, second, value) => [first]
                Bundle.Empty => []
            }
        }
        """))
    resource_reject(concat(resource_reconstruction_header(), """
        fn delayed(log List[Int]) Bundle {
            match bundle(log) {
                Bundle.Pair(first, second, value) => {
                    assert true
                    Bundle.Pair(first, second, value)
                }
                Bundle.Empty => Bundle.Empty
            }
        }
        """))
}

test fn preexisting_no_suspend_payloads_cannot_cross_earlier_awaited_fields() {
    resource_reject_reason(concat(resource_reconstruction_header(), """
        import std.resource.NoSuspend
        impl NoSuspend for Handle {
        }
        async fn number() Int {
            1
        }
        async fn rebuilt(log List[Int]) {
            match bundle(log) {
                Bundle.Pair(first, second, value) => {
                    scoped result = Rebuilt {
                        tag = number().await
                        first = first
                        second = second
                    }
                }
                Bundle.Empty => {
                }
            }
        }
        """), "a NoSuspend value is still in scope; leave its block before awaiting")
}
