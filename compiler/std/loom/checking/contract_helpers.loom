import std.loom.ast.Node
import std.loom.ast.NodeKind
import std.loom.ast.has
import std.loom.typed.Expr
import std.loom.typed.ExprKind
import std.loom.typed.Function
import std.loom.proof.verify_with_types
import std.loom.proof.verify_with_helpers
import std.list.get
import std.list.length
import std.result.Result

fn contract_call(node Node) Bool {
    if node.kind == NodeKind.Call { return true }
    var index = 0
    while index < length(node.children) {
        if contract_call(child(node, index)) { return true }
        index = index + 1
    }
    false
}
fn contract_helpers(node Node) Bool {
    var index = 0
    while index < length(node.children) {
        let member = child(node, index)
        if (member.kind == NodeKind.Requires || member.kind == NodeKind.Ensures) && contract_call(member) { return true }
        index = index + 1
    }
    false
}
fn with_contracts(function Function, preconditions List[Expr], postconditions List[Expr]) Function {
    Function { is_async = function.is_async symbol = function.symbol arguments = function.arguments params = function.params result = function.result
        locals = function.locals preconditions = preconditions postconditions = postconditions result_local = function.result_local
        body = function.body runtime_name = function.runtime_name span = function.span }
}
fn proof_body_calls(value Expr) Bool {
    if value.kind == ExprKind.Defer { return false }
    if value.kind == ExprKind.Call { return true }
    var index = 0
    while index < length(value.children) {
        if proof_body_calls(get(value.children, index)) { return true }
        index = index + 1
    }
    false
}
fn checked_contracts(context Context, id Int, function Function) Result[Function, Failure] {
    let node = symbol(context.env, context.signature.symbol).node
    let has_ensures = has(node, NodeKind.Ensures) || inherited_method_contract(context.env, context.signature.symbol, NodeKind.Ensures)
    let body_calls = has_ensures && proof_body_calls(function.body)
    if !contract_helpers(node) && !inherited_method_helpers(context.env, context.signature.symbol) && !body_calls {
        if !has_ensures { return Result.Ok(function) }
        let conditions = add_contracts(contracts(context, node, NodeKind.Ensures)?, inherited_contracts(context, NodeKind.Ensures)?)
        let checked = with_contracts(function, function.preconditions, conditions)
        match verify_with_types(context.env.types, checked) {
            Result.Ok(_) => Result.Ok(checked)
            Result.Err(message) => Result.Err(error(context, node, message))
        }
    } else {
        let stage = staging(context, node)?
        let proof = if body_calls {
            // Call-free declaration checking needs no queue. For a body proof,
            // rebuild once from a fresh entry scope, retaining its actual type
            // arguments, not one later concrete caller. Every direct Call now
            // addresses this private queue. Callees still verify normally.
            let built = function_body(stage.env, id, context.arguments, context.constants, true)?
            with_contracts(built.function, built.function.preconditions,
                add_contracts(contracts(built.context, node, NodeKind.Ensures)?, inherited_contracts(built.context, NodeKind.Ensures)?))
        } else {
            with_contracts(function, add_contracts(contracts(stage, node, NodeKind.Requires)?, inherited_contracts(stage, NodeKind.Requires)?),
                add_contracts(contracts(stage, node, NodeKind.Ensures)?, inherited_contracts(stage, NodeKind.Ensures)?))
        }
        match verify_with_helpers(prepared(stage)?, proof) {
            Result.Ok(conditions) => {
                // Ensures are already proved; retain call-free checked clauses
                // for reflection/CTFE, not private helper indices or runtime roots.
                Result.Ok(with_contracts(function, function.preconditions, conditions))
            }
            Result.Err(message) => Result.Err(error(context, node, message))
        }
    }
}
