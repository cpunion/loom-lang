import std.loom.ast.Node
import std.loom.ast.NodeKind
import std.loom.ast.has
import std.loom.typed.Expr
import std.loom.typed.ExprKind
import std.loom.typed.Function
import std.loom.typed.Arm
import std.loom.proof.verify_with_types
import std.loom.proof.verify_with_helpers
import std.loom.proof.normalized_postconditions
import std.list.new
import std.list.get
import std.list.push
import std.list.set
import std.list.length
import std.result.Result

fn contract_call(node Node) Bool {
    // old(indexed_value) needs entry-observation expansion even with no calls.
    if node.kind == NodeKind.Call || node.kind == NodeKind.MacroCall || node.kind == NodeKind.Old {
        return true
    }
    var index = 0
    while index < length(node.children) {
        if contract_call(child(node, index)) {
            return true
        }
        index = index + 1
    }
    false
}

fn postcondition_helpers(node Node) Bool {
    var index = 0
    while index < length(node.children) {
        let member = child(node, index)
        if member.kind == NodeKind.Ensures && contract_call(member) {
            return true
        }
        index = index + 1
    }
    false
}

// Source syntax alone cannot detect temporaries introduced by typed lowering.
// Let the ordinary guarded helper expander substitute such bindings as well.
fn contract_block(value Expr) Bool {
    if value.kind == ExprKind.Block {
        return true
    }
    var index = 0
    while index < length(value.children) {
        if contract_block(get(value.children, index)) {
            return true
        }
        index = index + 1
    }
    false
}

fn contract_blocks(conditions List[Expr]) Bool {
    var index = 0
    while index < length(conditions) {
        if contract_block(get(conditions, index)) {
            return true
        }
        index = index + 1
    }
    false
}

fn with_contracts(function Function, preconditions List[Expr], postconditions List[Expr]) Function {
    with_contracts(function, function.locals, preconditions, postconditions)
}

fn with_contracts(function Function, locals List[Local], preconditions List[Expr], postconditions List[Expr]) Function {
    Function {
        is_async = function.is_async
        symbol = function.symbol
        arguments = function.arguments
        params = function.params
        result = function.result
        locals = locals
        preconditions = preconditions
        postconditions = postconditions
        result_cleanup = function.result_cleanup
        result_local = function.result_local
        body = function.body
        runtime_name = function.runtime_name
        span = function.span
    }
}

fn proof_body_calls(value Expr) Bool {
    if value.kind == ExprKind.Defer {
        return false
    }
    if value.kind == ExprKind.Call || value.kind == ExprKind.TaskCall ||
    value.kind == ExprKind.DynCall || value.kind == ExprKind.FunctionRef || value.kind == ExprKind.IndirectCall {
        return true
    }
    var index = 0
    while index < length(value.children) {
        if proof_body_calls(get(value.children, index)) {
            return true
        }
        index = index + 1
    }
    index = 0
    while index < length(value.arms) {
        let body = get(value.arms, index).body
        var item = 0
        while item < length(body) {
            if proof_body_calls(get(body, item)) {
                return true
            }
            item = item + 1
        }
        index = index + 1
    }
    false
}

fn contract_calls(conditions List[Expr]) Bool {
    var index = 0
    while index < length(conditions) {
        if proof_body_calls(get(conditions, index)) || contains_deferred(get(conditions, index)) {
            return true
        }
        index = index + 1
    }
    false
}

fn collect_dynamic_contracts(context Context, value Expr, summaries List[Function]) Result[Bool, Failure] {
    if value.kind == ExprKind.Defer {
        return Result.Ok(true)
    }
    if value.kind == ExprKind.DynCall {
        push(summaries, dynamic_contract_summary(context, value)?)
    }
    var index = 0
    while index < length(value.children) {
        discard collect_dynamic_contracts(context, get(value.children, index), summaries)?
        index = index + 1
    }
    index = 0
    while index < length(value.arms) {
        let body = get(value.arms, index).body
        var item = 0
        while item < length(body) {
            discard collect_dynamic_contracts(context, get(body, item), summaries)?
            item = item + 1
        }
        index = index + 1
    }
    Result.Ok(true)
}

fn proof_dynamic_calls(value Expr, first Int, position List[Int], summaries List[Function]) Expr {
    if value.kind == ExprKind.Defer {
        return value
    }
    var target = value.index
    var kind = value.kind
    if value.kind == ExprKind.DynCall {
        target = first + get(position, 0)
        kind = if get(summaries, get(position, 0)).is_async {
            ExprKind.TaskCall
        } else {
            ExprKind.Call
        }
        set(position, 0, get(position, 0) + 1)
    }
    let children = new[Expr]()
    var index = 0
    while index < length(value.children) {
        push(children, proof_dynamic_calls(get(value.children, index), first, position, summaries))
        index = index + 1
    }
    let arms = new[Arm]()
    index = 0
    while index < length(value.arms) {
        let arm = get(value.arms, index)
        let body = new[Expr]()
        var item = 0
        while item < length(arm.body) {
            push(body, proof_dynamic_calls(get(arm.body, item), first, position, summaries))
            item = item + 1
        }
        push(arms, Arm {
                variant = arm.variant
                bindings = arm.bindings
                whole = arm.whole
                body = body
            })
        index = index + 1
    }
    Expr {
        kind = kind
        ty = value.ty
        span = value.span
        text = value.text
        index = target
        children = children
        arms = arms
        falls = value.falls
    }
}

fn with_body(function Function, body Expr) Function {
    Function {
        is_async = function.is_async
        symbol = function.symbol
        arguments = function.arguments
        params = function.params
        result = function.result
        locals = function.locals
        preconditions = function.preconditions
        postconditions = function.postconditions
        result_cleanup = function.result_cleanup
        result_local = function.result_local
        body = body
        runtime_name = function.runtime_name
        span = function.span
    }
}

fn checked_contracts(context Context, id Int, source Function) Result[Function, Failure] {
    let backend = get(context.env.inputs, 0).build.proof_backend
    let node = symbol(context.env, context.signature.symbol).node
    let has_ensures = has(node, NodeKind.Ensures) || inherited_method_contract(context.env, context.signature.symbol, NodeKind.Ensures)
    let function = if has_ensures {
        capture_storage(context, source)
    } else {
        source
    }
    if has_ensures {
        let completed = completed_contract(context, id, function)
        if length(completed) != 0 {
            return Result.Ok(with_contracts(function, function.preconditions, completed))
        }
    }
    let family_proved = has_ensures && completed_pack_contract(context.env, id)
    let body_calls = has_ensures && !family_proved && proof_body_calls(function.body)
    // A completed type-only query is already a Bool, not a helper call. Pending
    // computations and actual calls still validate their private proof closure;
    // native instances recheck their requirements with concrete arguments.
    let call_free = !contract_calls(function.preconditions) && (!has_ensures ||
        (!postcondition_helpers(node) && !inherited_postcondition_helpers(context.env, context.signature.symbol) && !body_calls))
    let conditions = if call_free && has_ensures {
        add_contracts(contracts(context, node, NodeKind.Ensures)?, inherited_contracts(context, NodeKind.Ensures)?)
    } else {
        function.postconditions
    }
    if call_free && !contract_blocks(function.preconditions) && !contract_blocks(conditions) {
        if !has_ensures {
            return Result.Ok(function)
        }
        let checked = with_source_contracts(context, function, function.preconditions, conditions)
        if family_proved {
            return certified_contract(context, id, checked)
        }
        match verify_with_types(context.env.types, checked, backend) {
            Result.Ok(_) => certified_contract(context, id, checked)
            Result.Err(message) => {
                match expanded_invariant_types(context, checked) {
                    Result.Ok(types) => match verify_with_types(types, checked, backend, continuing_sequence_guarantees(context.env)) {
                        Result.Ok(_) => {
                            return certified_contract(context, id, checked)
                        }
                        Result.Err(_) => {
                        }
                    }
                    Result.Err(_) => {
                    }
                }
                Result.Err(error(context, node, message))
            }
        }
    } else {
        let stage = staging(context, node)?
        var proof = if body_calls {
            // Call-free declaration checking needs no queue. For a body proof,
            // rebuild once from a fresh entry scope, retaining its actual type
            // arguments, not one later concrete caller. Every direct Call now
            // addresses this private queue. Callee bodies verify as one group.
            let built = function_body(stage.env, id, context.arguments, context.constants, true)?
            with_source_contracts(built.context, capture_storage(built.context, built.function), built.function.preconditions,
                add_contracts(contracts(built.context, node, NodeKind.Ensures)?, inherited_contracts(built.context, NodeKind.Ensures)?))
        } else {
            with_source_contracts(stage, function,
                add_contracts(contracts(stage, node, NodeKind.Requires)?, inherited_contracts(stage, NodeKind.Requires)?),
                add_contracts(contracts(stage, node, NodeKind.Ensures)?, inherited_contracts(stage, NodeKind.Ensures)?))
        }
        let summaries = new[Function]()
        if body_calls {
            discard collect_dynamic_contracts(stage, proof.body, summaries)?
        }
        let program = prepared_contract_group(stage, proof, body_calls)?
        let first = length(program.functions)
        var index = 0
        while index < length(summaries) {
            push(program.functions, get(summaries, index))
            index = index + 1
        }
        if body_calls {
            let position = new[Int]()
            push(position, 0)
            proof = with_body(proof, proof_dynamic_calls(proof.body, first, position, summaries))
        }
        let checked = if family_proved {
            // Rebind/normalize the selected clauses; never copy erased locals
            // or replay the already proved family body. Helper, resource and
            // Task checks above remain authoritative for this specialization.
            normalized_postconditions(program, proof)
        } else {
            verify_with_helpers(program, proof, backend)
        }
        match checked {
            Result.Ok(conditions) => {
                // Ensures are already proved; retain call-free checked clauses
                // for reflection/CTFE, not private helper indices or runtime roots.
                certified_contract(context, id, with_contracts(function, function.preconditions, conditions))
            }
            Result.Err(message) => {
                match expanded_invariant_types(stage, proof) {
                    Result.Ok(types) => match verify_with_helpers(proof_types(program, types), proof, backend, continuing_sequence_guarantees(stage.env)) {
                        Result.Ok(conditions) => {
                            return certified_contract(context, id, with_contracts(function, function.preconditions, conditions))
                        }
                        Result.Err(remaining) => {
                            return Result.Err(error(context, node, remaining))
                        }
                    }
                    Result.Err(_) => {
                    }
                }
                Result.Err(error(context, node, message))
            }
        }
    }
}
