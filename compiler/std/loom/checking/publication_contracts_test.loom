test fn unknown_scalar_callbacks_frame_unpublished_storage_not_their_results() {
    let source = """
        import std.list.length
        import std.list.get
        import std.list.push
        fn retained(next fn(Int) Int) Int
        ensures result == 7 {
            let values = [7]
            discard next(0)
            get(values, 0)
        }
        fn generated(count Int, next fn(Int) Int) List[Int]
        requires count >= 0 && count <= 100
        ensures length(result) == count {
            let values List[Int] = []
            var index = 0
            while index < count {
                push(values, next(index))
                index = index + 1
            }
            values
        }
        """
    task_metadata_contract(source, true, "")
    task_metadata_contract(concat(source, """
        fn guessed(next fn(Int) Int) Int
        ensures result == 7 {
            next(0)
        }
        """), false, "postcondition")
}

test fn mutable_arguments_publish_reachable_headers_not_unrelated_allocations() {
    let source = """
        import std.list.get
        record Input {
            values List[Int]
        }
        fn retained(next fn(Input), shared List[Int]) Int
        ensures result == 7 {
            let values = [7]
            next(Input { values = shared })
            get(values, 0)
        }
        """
    task_metadata_contract(source, true, "")
    task_metadata_contract(std.text.join(std.text.split(source, "values = shared"),
            "values = values"), false, "postcondition")
}

test fn publication_walks_nested_cells_without_assuming_a_complete_heap_snapshot() {
    let source = """
        import std.list.get
        fn retained(next fn(List[List[Int]])) Int
        ensures result == 8 {
            let child = [7]
            let parent = [child]
            let separate = [8]
            next(parent)
            get(separate, 0)
        }
        """
    task_metadata_contract(source, true, "")
    task_metadata_contract(std.text.join(std.text.split(
                std.text.join(std.text.split(source, "result == 8"), "result == 7"),
                "get(separate, 0)"), "get(child, 0)"), false, "postcondition")
    task_metadata_contract("""
        import std.list.get
        fn opaque(next fn(List[List[Int]]), parent List[List[Int]]) Int
        ensures result == 7 {
            let child = [7]
            next(parent)
            get(child, 0)
        }
        """, true, "")
}

test fn enum_payloads_and_function_captures_participate_in_publication() {
    task_metadata_contract("""
        import std.list.get
        enum Input {
            Values(List[Int])
            Other(List[List[Int]])
        }
        fn retained(next fn(Input)) Int
        ensures result == 8 {
            let values = [7]
            let separate = [8]
            next(Input.Values(values))
            get(separate, 0)
        }
        """, true, "")
    task_metadata_contract("""
        import std.list.get
        enum Input {
            Values(List[Int])
            Empty
        }
        fn stale(next fn(Input)) Int
        ensures result == 7 {
            let values = [7]
            next(Input.Values(values))
            get(values, 0)
        }
        """, false, "postcondition")
    let source = """
        import std.list.get
        fn stale(next fn(fn() Int)) Int
        ensures result == 7 {
            let values = [7]
            let callback = fn() Int {
                get(values, 0)
            }
            next(callback)
            get(values, 0)
        }
        """
    task_metadata_contract(source, false, "postcondition")
    task_metadata_contract(std.text.join(std.text.split(source,
                "next(callback)"), "next(fn() Int { 0 })"), true, "")
}

test fn a_scalar_callback_does_not_restore_previously_published_storage() {
    task_metadata_contract("""
        import std.list.get
        import std.list.set
        import std.list.length
        fn stale(holder List[List[Int]], next fn(Int)) Int
        requires length(holder) > 0
        ensures result == 7 {
            let values = [7]
            set(holder, 0, values)
            next(0)
            get(values, 0)
        }
        """, false, "postcondition")
}

test fn known_async_inputs_frame_only_unreachable_caller_storage() {
    let source = """
        import std.list.length
        import std.list.get
        async fn consume(values List[Int]) {
            discard length(values)
        }
        async fn retained(shared List[Int]) Int
        ensures result == 7 {
            let values = [7]
            consume(shared).await
            get(values, 0)
        }
        """
    task_metadata_contract(source, true, "")
    task_metadata_contract(std.text.join(std.text.split(source, "consume(shared).await"),
            "consume(values).await"), false, "postcondition")
}

test fn opaque_inputs_frame_later_allocations_without_value_assumptions() {
    let source = """
        import std.list.length
        record Input[T] {
            state T
        }
        fn independent[T](input Input[T], effect fn(Input[T])) Int
        ensures result == 1 {
            let fresh = [7]
            effect(input)
            length(fresh)
        }
        """
    task_metadata_contract(source, true, "")
    task_metadata_contract(concat(source, """
        fn guessed[T](state T, next fn(T) Int) Int
        ensures result == 7 {
            next(state)
        }
        """), false, "postcondition")
}

test fn opaque_loop_results_need_inductive_unreachability_not_entry_privacy() {
    let source = """
        import std.list.length
        import std.list.push
        fn generated[S, T](count Int, state S, next fn(S) (S, T)) List[T]
        requires count >= 0 && count <= 100
        ensures length(result) == count {
            let output List[T] = []
            var current = state
            var index = 0
            while index < count {
                let changed, value = next(current)
                current = changed
                push(output, value)
                index = index + 1
            }
            output
        }
        """
    task_metadata_contract(source, true, "")
    task_metadata_contract(std.text.join(std.text.split(source,
                "index = index + 1"), "index = index + 2"), false, "postcondition")
}

test fn opaque_inputs_never_recover_storage_published_directly_or_through_aliases() {
    task_metadata_contract("""
        import std.list.length
        fn stale[T](state T, effect fn(T, List[Int])) Int
        ensures result == 1 {
            let fresh = [7]
            effect(state, fresh)
            length(fresh)
        }
        """, false, "postcondition")
    task_metadata_contract("""
        import std.list.get
        import std.list.set
        import std.list.length
        fn stale[T](holder List[List[Int]], state T, effect fn(T)) Int
        requires length(holder) > 0
        ensures result == 7 {
            let fresh = [7]
            set(holder, 0, fresh)
            effect(state)
            get(fresh, 0)
        }
        """, false, "postcondition")
}

test fn changed_callback_captures_withdraw_loop_frames_and_early_returns() {
    task_metadata_contract("""
        import std.list.get
        fn stale(original fn() Int, effect fn(fn() Int)) Int
        ensures result == 7 {
            let values = [7]
            var current = original
            var index = 0
            while index < 2 {
                effect(current)
                if index == 1 {
                    return get(values, 0)
                }
                current = fn() Int { get(values, 0) }
                index = index + 1
            }
            get(values, 0)
        }
        """, false, "postcondition")
    task_metadata_contract("""
        import std.list.get
        fn stale(original fn() Int) Int
        ensures result == 7 {
            let values = [7]
            var current = original
            var index = 0
            while index < 2 {
                discard current()
                current = fn() Int { get(values, 0) }
                index = index + 1
            }
            get(values, 0)
        }
        """, false, "postcondition")
    task_metadata_contract("""
        import std.list.length
        fn stale(original List[Int], effect fn(List[Int])) Int
        ensures result == 1 {
            let output = [7]
            var current = original
            var index = 0
            while index < 2 {
                effect(current)
                if index == 1 {
                    return length(output)
                }
                current = output
                index = index + 1
            }
            length(output)
        }
        """, false, "postcondition")
}

test fn publishing_one_loop_header_never_turns_another_frame_into_false_evidence() {
    let source = """
        import std.list.length
        fn independent(original List[Int], effect fn(List[Int])) Int
        ensures result == 1 {
            let exposed = [7]
            let separate = [8]
            var current = original
            var index = 0
            while index < 2 {
                effect(current)
                current = exposed
                index = index + 1
            }
            length(separate)
        }
        """
    task_metadata_contract(source, true, "")
    task_metadata_contract(std.text.join(std.text.split(source,
                "result == 1"), "result == 2"), false, "postcondition")
}

test fn private_edge_stores_widen_ancestor_graphs_even_after_cell_eviction() {
    task_metadata_contract("""
        import std.list.length
        import std.list.push
        fn stale(effect fn(List[List[List[Int]]])) Int
        ensures result == 1 {
            let children List[List[Int]] = []
            let parent = [children]
            let fresh = [7]
            var index = 0
            while index < 65 {
                push(children, if index == 0 { fresh } else { [8] })
                index = index + 1
            }
            effect(parent)
            length(fresh)
        }
        """, false, "postcondition")
    task_metadata_contract("""
        import std.list.length
        import std.list.push
        fn stale(effect fn(List[List[Int]])) Int
        ensures result == 1 {
            let parent List[List[Int]] = []
            let fresh = [7]
            var index = 0
            while index < 2 {
                effect(parent)
                push(parent, fresh)
                index = index + 1
            }
            length(fresh)
        }
        """, false, "postcondition")
}
