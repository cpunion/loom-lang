fn text_length_contract(text Text, valid Bool) {
    let files = source_files(text)
    push(files, source_file("std.text", """
        intrinsic fn text_len(value Text) Int
        pub fn length(value Text) Int {
            text_len(value)
        }
        intrinsic fn text_concat(left Text, right Text) Text
        pub fn concat(left Text, right Text) Text {
            text_concat(left, right)
        }
        """, true))
    push(files, source_file("std.result", """
        pub enum Result[T, E] {
            Ok(T)
            Err(E)
        }
        pub enum ConstraintError {
            Rejected
        }
        """, true))
    match checked(files) {
        Result.Ok(_) => {
            assert valid
        }
        Result.Err(failed) => {
            if valid {
                show_failure(fixture_project(files), failed)
            }
            assert !valid
        }
    }
}

test fn immutable_text_lengths_compose_bounds_equalities_and_entry_values() {
    text_length_contract("""
        import std.text.length
        fn count(value Text) Int
        ensures result == length(value) && result >= 0
        {
            length(value)
        }
        fn entry(value Text) Int {
            length(value)
        }
        fn retained(value Text) Int
        ensures result == old(entry(value))
        {
            var local = value
            let size = count(local)
            local = "different"
            discard local
            size
        }
        fn equal(left Text, right Text) Int
        requires left == right
        ensures result == length(left)
        {
            length(right)
        }
        fn literal() Int
        ensures result == 6
        {
            length("é😀")
        }
        """, true)
    text_length_contract("""
        import std.text.length
        fn not_characters() Int
        ensures result == 2
        {
            length("é😀")
        }
        """, false)
    text_length_contract("""
        import std.text.length
        fn unequal(left Text, right Text) Bool
        requires left != right
        ensures result
        {
            length(left) != length(right)
        }
        """, false)
    text_length_contract("""
        import std.text.length
        fn changed(value Text) Int
        ensures result == old(length(value))
        {
            var local = value
            local = "x"
            length(local)
        }
        """, false)
}

test fn text_length_invariants_compose_without_inventing_content() {
    text_length_contract("""
        import std.text.length
        type Name = Text where length(self) > 0
        record Envelope {
            label Name
            items List[Int]
        }
        fn count(value Name) Int
        ensures result > 0
        {
            length(value)
        }
        fn field(value Envelope) Int
        ensures result > 0
        {
            length(value.label)
        }
        """, true)
    text_length_contract("""
        import std.text.length
        fn content(value Text) Text
        requires length(value) == 6
        ensures result == "é😀"
        {
            value
        }
        """, false)
}

test fn proved_text_length_weakening_omits_only_the_second_boundary() {
    text_length_contract("""
        import std.text.length
        type Short = Text where length(self) > 0 && length(self) <= 8
        type Wide = Text where length(self) > 0 && length(self) <= 16
        fn widened(value Short) Wide {
            Wide(value)
        }
        fn count(value Wide) Int
        ensures result > 0 && result <= 16
        {
            length(value)
        }
        fn main() {
            assert count(widened(Short("é😀"))) == 6
        }
        """, true)
    text_length_contract("""
        import std.text.length
        type Short = Text where length(self) > 0 && length(self) <= 8
        type Wide = Text where length(self) > 0 && length(self) <= 16
        fn strengthened(value Wide) Short {
            Short(value)
        }
        """, false)
}
