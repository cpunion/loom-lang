import std.list.new
import std.list.push
import std.list.get
import std.list.set
import std.list.length
import std.result.Result
import std.text.concat

record Requirement { ty Int capability Int }
// Function constants use a source symbol plus concrete type arguments, never
// an index into a transient emission/evaluation queue.
record StaticValue { ty Int known Bool number Int text Text arguments List[Int] }
// compile_time contains ordered source parameter positions, empty for ordinary functions.
record Signature { symbol Int parameters Int params List[Int] compile_time List[Int] result Int requirements List[Requirement] }
record Instance { signature Int arguments List[Int] constants List[StaticValue] }
record Validation { signature Int constants List[StaticValue] }
record Association { receiver Int member Int arguments List[Int] }
record Environment {
    source std.loom.binding.Program
    types List[Type]
    type_states List[Int]
    expand_data Bool
    has_refinements Bool
    expanding_helpers Bool
    signatures List[Signature]
    pending List[Instance]
    stage_depth Int
    computations List[Computation]
    validations List[Validation]
    concepts List[Concept]
    implementations List[Implementation]
    associations List[Association]
    association_depth Int
    family_applications List[FamilyApplication]
    promise_path List[Requirement]
    promise_depth Int
    interfaces List[Interface]
    dynamic_interfaces List[DynamicInterface]
    witnesses List[Witness]
    uses List[SlotUse]
}
record Binding { name Text local Int constant Int previous Int }
record Cleanup { body Expr previous Int }
record Fact { local Int predicate Expr previous Int }
record Context {
    env Environment
    signature Signature
    arguments List[Int]
    constants List[StaticValue]
    locals List[Local]
    bindings List[Binding]
    head Int
    cleanups List[Cleanup]
    cleanup_head Int
    // -2 outside a loop; otherwise the cleanup head just outside its body.
    loop_boundary Int
    facts List[Fact]
    fact_head Int
    emit Bool
}
record Step { context Context expression Expr }

fn child(node Node, index Int) Node { get(node.children, index) }
fn part(node Node, kind NodeKind) Int {
    var index = 0
    while index < length(node.children) {
        if child(node, index).kind == kind { return index }
        index = index + 1
    }
    -1
}
fn group(node Node, kind NodeKind) List[Node] {
    let index = part(node, kind)
    if index < 0 { new[Node]() } else { child(node, index).children }
}
fn type_part(node Node) Int {
    var index = 0
    while index < length(node.children) {
        let kind = child(node, index).kind
        if kind == NodeKind.Type || kind == NodeKind.TupleType || kind == NodeKind.DynType || kind == NodeKind.FunctionType { return index }
        index = index + 1
    }
    -1
}
fn symbol(env Environment, index Int) Symbol { get(env.source.symbols, index) }
fn failure(env Environment, source Int, node Node, message Text) Failure {
    Failure { source = symbol(env, source).file diagnostic = Diagnostic { span = node.span message = message } }
}
fn error(context Context, node Node, message Text) Failure {
    failure(context.env, context.signature.symbol, node, message)
}
fn same(a List[Int], b List[Int]) Bool {
    if length(a) != length(b) { return false }
    var index = 0
    while index < length(a) {
        if get(a, index) != get(b, index) { return false }
        index = index + 1
    }
    true
}
fn ints(value Int) List[Int] { let values = new[Int]()
    push(values, value)
    values
}
fn expressions(value Expr) List[Expr] { let values = new[Expr]()
    push(values, value)
    values
}
fn pair(a Expr, b Expr) List[Expr] { let values = expressions(a)
    push(values, b)
    values
}
fn expression(kind ExprKind, ty Int, node Node, text Text, index Int, children List[Expr], falls Bool) Expr {
    Expr { kind = kind ty = ty span = node.span text = text index = index children = children arms = new[Arm]() falls = falls }
}
fn atom(kind ExprKind, ty Int, node Node, index Int) Expr {
    expression(kind, ty, node, node.value, index, new[Expr](), true)
}
fn all_fall(values List[Expr]) Bool {
    var index = 0
    while index < length(values) {
        if !get(values, index).falls { return false }
        index = index + 1
    }
    true
}
fn typed(context Context, node Node, value Expr, expected Int) Result[Expr, Failure] {
    if expected >= 0 && value.ty != expected && value.falls && get(context.env.types, expected).kind == TypeKind.Dyn {
        return boxed(context, node, value, expected)
    }
    if get(context.env.types, value.ty).kind == TypeKind.Refined && expected == base_type(context.env, value.ty) {
        return Result.Ok(expression(ExprKind.Coerce, expected, node, "", -1, expressions(value), value.falls))
    }
    if expected >= 0 && value.ty != expected && value.falls {
        let found = type_name(context.env.source, context.env.types, context.env.interfaces, value.ty)
        let message = if expected == 0 {
            concat("unused value of type ", concat(found, "; use discard to ignore it"))
        } else {
            let needed = type_name(context.env.source, context.env.types, context.env.interfaces, expected)
            concat("expected ", concat(needed, concat(", found ", found)))
        }
        return Result.Err(error(context, node, message))
    }
    Result.Ok(value)
}
fn context_at(context Context, head Int) Context {
    Context { env = context.env signature = context.signature arguments = context.arguments
        constants = context.constants locals = context.locals bindings = context.bindings head = head
        cleanups = context.cleanups cleanup_head = context.cleanup_head loop_boundary = context.loop_boundary
        facts = context.facts fact_head = context.fact_head emit = context.emit }
}
fn loop_context(context Context, boundary Int) Context {
    Context { env = context.env signature = context.signature arguments = context.arguments
        constants = context.constants locals = context.locals bindings = context.bindings head = context.head
        cleanups = context.cleanups cleanup_head = context.cleanup_head loop_boundary = boundary
        facts = context.facts fact_head = context.fact_head emit = context.emit }
}
fn lookup(context Context, value Text) Int {
    var head = context.head
    while head >= 0 {
        let binding = get(context.bindings, head)
        if binding.name == value { return head }
        head = binding.previous
    }
    -1
}
fn bind_local(context Context, node Node, value Text, ty Int, mutable Bool, boundary Int) Result[Context, Failure] {
    if value == "result" || ty == 0 { return Result.Err(error(context, node, "invalid local binding")) }
    let local = length(context.locals)
    let next = bind_name(context, node, value, local, -1, boundary)?
    push(context.locals, Local { name = value ty = ty mutable = mutable })
    Result.Ok(next)
}
fn bind_name(context Context, node Node, value Text, local Int, constant Int, boundary Int) Result[Context, Failure] {
    if value == "result" { return Result.Err(error(context, node, "invalid local binding")) }
    var head = context.head
    while head != boundary && head >= 0 {
        let binding = get(context.bindings, head)
        if binding.name == value {
            return Result.Err(error(context, node, "duplicate local binding"))
        }
        head = binding.previous
    }
    let next = length(context.bindings)
    push(context.bindings, Binding { name = value local = local constant = constant previous = context.head })
    Result.Ok(context_at(context, next))
}

pub fn check(source std.loom.binding.Program) Result[std.loom.typed.Program, Failure] {
    let env = Environment { source = source types = new[Type]() type_states = new[Int]() expand_data = true
        has_refinements = refinement_declarations(source) expanding_helpers = false signatures = new[Signature]() pending = new[Instance]()
        stage_depth = 0 computations = new[Computation]() validations = new[Validation]() concepts = new[Concept]() implementations = new[Implementation]()
        associations = new[Association]() association_depth = 0
        family_applications = new[FamilyApplication]() promise_path = new[Requirement]() promise_depth = 0
        interfaces = new[Interface]() dynamic_interfaces = new[DynamicInterface]() witnesses = new[Witness]() uses = new[SlotUse]() }
    initialize_types(env)
    discard conformance_headers(env)?
    var index = 0
    while index < length(source.symbols) {
        let item = symbol(env, index)
        if nominal_data(item.node.kind) {
            discard data_type(env, index, abstract_arguments(env, length(group(item.node, NodeKind.TypeParameters))), 0)?
        }
        index = index + 1
    }
    index = 0
    while index < length(source.symbols) {
        let item = symbol(env, index)
        // Impl headers are matched against complete concept signatures before
        // inheriting that exact overload's method parameter requirements.
        if item.node.kind == NodeKind.Function && (item.owner < 0 || prototype(env, index)) {
            let arguments = abstract_arguments(env, function_parameter_count(env, index))
            discard register_signature(env, source_signature(env, index, arguments, requirements(env, index, arguments)?)?)?
        }
        index = index + 1
    }
    discard conformances(env)?
    discard declaration_types(env)?
    discard fill_interfaces(env)?
    discard refinements(env)?
    discard layouts(env)?
    index = 0
    while index < length(env.signatures) {
        let signature = get(env.signatures, index)
        if !prototype(env, signature.symbol) || has(symbol(env, signature.symbol).node, NodeKind.Block) {
            discard function(env, index, abstract_arguments(env, signature.parameters), unknown_constants(signature), false)?
        }
        index = index + 1
    }
    var entry = -1
    let tests = new[Int]()
    let exports = new[Int]()
    index = 0
    while index < length(env.signatures) {
        let signature = get(env.signatures, index)
        let item = symbol(env, signature.symbol)
        let root = get(source.files, item.file).package == source.root
        if signature.parameters == 0 && !has_static(signature) && root && item.owner < 0 {
            if item.name == "main" && !item.test_only { entry = schedule(env, index, new[Int](), new[StaticValue](), item.node)? }
            if item.public && !item.test_only { push(exports, schedule(env, index, new[Int](), new[StaticValue](), item.node)?) }
            if has(item.node, NodeKind.Test) { push(tests, schedule(env, index, new[Int](), new[StaticValue](), item.node)?) }
        }
        index = index + 1
    }
    let functions = emit_functions(env, entry < 0 || length(exports) != 0)?
    discard layouts(env)?
    Result.Ok(std.loom.typed.Program { types = env.types functions = functions entry = entry tests = tests exports = exports
        interfaces = env.interfaces witnesses = env.witnesses })
}
