import std.loom.ast.Node
import std.loom.ast.NodeKind
import std.loom.typed.Expr
import std.loom.typed.ExprKind
import std.loom.typed.Local
import std.loom.typed.TypeKind
import std.list.new
import std.list.get
import std.list.set
import std.list.push
import std.list.length

// Pure selectors and wrappers can transport a known callback without gaining
// access to its live captures. Resolve staging aliases through the same source
// nodes as ordinary static arguments; unrelated runtime bindings stay isolated.
fn static_identity_input(context Context, node Node) Bool {
    match static_alias_source(context, node) {
        Option.Some(source) => {
            return static_identity_input(context, source)
        }
        Option.None => {
        }
    }
    if node.kind == NodeKind.Name || node.kind == NodeKind.Call {
        let index = lookup(context, slice(node.value, 0, first_dot(node.value)))
        if index >= 0 {
            let binding = get(context.bindings, index)
            if binding.constant >= 0 {
                let value = get(context.constants, binding.constant)
                if value.storage >= 0 && get(context.env.types, value.ty).kind == TypeKind.Function {
                    return true
                }
            }
        }
    }
    var index = 0
    while index < length(node.children) {
        if static_identity_input(context, get(node.children, index)) {
            return true
        }
        index = index + 1
    }
    false
}

// Identity-only staging may carry a known function through ordinary pure
// computations. Its live environment is opaque, never a frozen substitute for
// mutable runtime state. The evaluator rejects inspecting or reifying it.
fn static_identity_prefix(stage Context, node Node) List[Expr] {
    let prefix = new[Expr]()
    var index = 0
    while index < length(stage.bindings) {
        let binding = get(stage.bindings, index)
        if binding.constant >= 0 {
            let value = get(stage.constants, binding.constant)
            if value.storage >= 0 && get(stage.env.types, value.ty).kind == TypeKind.Function {
                let ty = static_environment_type(stage.env, value)
                let local = length(stage.locals)
                push(stage.locals, Local {
                        name = ""
                        ty = ty
                        mutable = false
                        is_scoped = false
                    })
                set(stage.bindings, index, Binding {
                        name = binding.name
                        local = local
                        constant = binding.constant
                        previous = binding.previous
                        resource_payload = binding.resource_payload
                    })
                let opaque = expression(ExprKind.FrameNew, ty, node,
                    "opaque environment", -1, new[Expr](), true)
                push(prefix, expression(ExprKind.Let, 0, node, "", local, expressions(opaque), true))
            }
        }
        index = index + 1
    }
    prefix
}
