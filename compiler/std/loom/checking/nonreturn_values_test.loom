test fn outward_exits_use_the_expected_value_type() {
    discard accepted("""
        record Pair {
            first Int
            second Int
        }
        fn binding_exit() Int {
            let value Int = {
                return 1
            }
            value
        }
        fn list_exit() Int {
            let values List[Int] = [{
                    return 3
                }]
            0
        }
        fn tuple_exit() Int {
            let value (Int, Bool) = (4, {
                    return 5
                })
            value.0
        }
        fn record_exit() Int {
            let value = Pair {
                first = 6
                second = {
                    return 7
                }
            }
            value.first
        }
        fn main() {
            assert binding_exit() == 1 && list_exit() == 3
            assert tuple_exit() == 5 && record_exit() == 7
            assert comptime {
                binding_exit() + list_exit() + tuple_exit() + record_exit()
            } == 16
        }
        """)
    resource_accept(concat(resource_header(), """
        fn plain_exit() Int {
            let absent Handle = {
                return 7
            }
            0
        }
        fn scoped_exit() Int {
            scoped absent Handle = {
                return 8
            }
            0
        }
        fn main() {
            assert plain_exit() == 7 && scoped_exit() == 8
        }
        """))
    resource_reject_reason(concat(resource_header(), """
        fn main() {
            scoped held = make([0])
            scoped absent Handle = {
                held.dispose()
                return
            }
        }
        """), "a scoped value is disposed automatically; manual Dispose calls are forbidden")
    rejects("""
        fn empty() {}
        fn main() {
            let value Int = empty()
        }
        """)
    rejects("""
        fn check(flag Bool) {
            let value Int = {
                if flag {
                    return
                }
            }
        }
        """)
    rejects("""
        fn main() {
            let value Int = {
                return
                true
            }
        }
        """)
    rejects("""
        fn main() {
            let value Int = {
                return
            }
            missing()
        }
        """)
}

test fn outward_exits_stop_resource_operand_evaluation() {
    resource_accept(concat(resource_header(), """
        fn inspect(value Handle, extra Int) Int {
            extra
        }
        fn direct_exit() Int {
            inspect({
                    return 7
                }, make([0]).use())
        }
        fn indirect_exit(callback fn(Handle, Int) Int) Int {
            callback({
                    return 8
                }, make([0]).use())
        }
        async fn inspect_async(value Handle, extra Int) Int {
            extra
        }
        async fn async_exit() Int {
            inspect_async({
                    return 9
                }, make([0]).use()).await
        }
        fn condition_exit() {
            scoped value = make([0])
            if {
                return
            } {
                value.dispose()
            } else {
                value.dispose()
            }
        }
        fn loop_exit() {
            scoped value = make([0])
            while {
                return
            } {
                value.dispose()
            }
        }
        fn match_exit() {
            scoped value = make([0])
            match {
                return
            } {
                _ => value.dispose()
            }
        }
        fn list_exit() {
            scoped value = make([0])
            let values List[Int] = [{
                    return
                }, make([0]).use()]
        }
        fn main() {
            assert direct_exit() == 7 && indirect_exit(inspect) == 8
            condition_exit()
            loop_exit()
            match_exit()
            list_exit()
        }
        """))
    resource_reject_reason(concat(resource_header(), """
        fn inspect(value Handle) {}
        fn main() {
            scoped held = make([0])
            inspect({
                    held.dispose()
                    return
                })
        }
        """), "a scoped value is disposed automatically; manual Dispose calls are forbidden")
    resource_reject_reason(concat(resource_header(), """
        fn inspect(value Handle, extra Int) {}
        fn main() {
            inspect(make([0]), {
                    return
                })
        }
        """), "a resource must enter scoped before a method call")
}
