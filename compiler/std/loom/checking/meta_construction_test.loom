import std.build.input_file

fn constructed(text Text) Result[std.loom.typed.Program, Failure] {
    let files = source_files(concat("""
        import std.meta.tuple
        import std.meta.function
        import std.option.Option
        import std.list.new
        import std.list.push

        """, text))
    push(files, source_file("std.meta", input_file("../../meta/construction.loom"), true))
    push(files, source_file("std.option", input_file("../../option/option.loom"), true))
    push(files, source_file("std.list", input_file("../../list/list.loom"), true))
    checked(files)
}

test fn symbolic_construction_preserves_generic_requirements() {
    assert match constructed("""
        fn pair_type(item type) type {
            let items = new[type]()
            var index = 0
            while index < 2 {
                push(items, if index == 0 { item } else { Text })
                index = index + 1
            }
            tuple(items)
        }
        pub fn wrap[T](value T) (T, Text) {
            let Pair = comptime { pair_type(T) }
            let pair Pair = (value, "wrapped")
            pair
        }
        fn main() {
            assert wrap(7).0 == 7
            assert wrap(true).0
            assert wrap("text").0 == "text"
        }
        """) {
        Result.Ok(_) => true
        Result.Err(_) => false
    }
    let invalid = ["""
        concept Display {
            fn display(self Self) Text
        }
        pub fn render[T](value T) Text {
            let Pair = comptime { tuple([T, Text]) }
            let pair Pair = (value, "wrapped")
            pair.0.display()
        }
        """, """
        fn selected(item type) type {
            if item == Int { Int } else { Bool }
        }
        pub fn wrap[T](value T) T {
            let Selected = comptime { selected(T) }
            let selected Selected = value
            selected
        }
        """, """
        pub fn unproved[T](value T) Int
        ensures result > 0
        {
            let Pair = comptime { tuple([T, Int]) }
            let pair Pair = (value, 0)
            pair.1
        }
        """, """
        pub fn capture[T](value T) {
            let Pair = comptime { tuple([if value == value { T } else { Text }]) }
            discard Pair
        }
        """]
    var index = 0
    while index < length(invalid) {
        assert match constructed(get(invalid, index)) {
            Result.Err(_) => true
            Result.Ok(_) => false
        }
        index = index + 1
    }
}

test fn computed_structural_types_keep_ordinary_typing_and_constraints() {
    assert match constructed("""
        type Positive = Int where self > 0
        fn identity[T](value T) T {
            value
        }
        fn main() {
            let Pair = comptime { tuple([Positive, Text]) }
            let pair Pair = (Positive(7), "seven")
            assert identity[Pair](pair).0 == 7
            let Callback = comptime { function([Int], Option.Some(Bool)) }
            let callback Callback = fn(value Int) Bool {
                value > 0
            }
            assert callback(7)
        }
        """) {
        Result.Ok(_) => true
        Result.Err(_) => false
    }
    let invalid = ["""
        fn main() {
            let Pair = tuple([Int, Text])
            discard Pair
        }
        """, """
        fn select(flag Bool) {
            let Pair = comptime { tuple([if flag { Int } else { Text }]) }
            discard Pair
        }
        """, """
        fn main() {
            let Pair = comptime { tuple([Int, Text]) }
            let wrong Pair = (true, "text")
            discard wrong
        }
        """, """
        type Positive = Int where self > 0
        fn main() {
            let Pair = comptime { tuple([Positive, Text]) }
            let invalid Pair = (0, "zero")
            discard invalid
        }
        """, """
        fn main() {
            let Callback = comptime { function([Int], Option.Some(Text)) }
            let wrong Callback = fn(value Int) Bool {
                value > 0
            }
            discard wrong
        }
        """, """
        pub fn unproved() Int
        ensures result > 0
        {
            let Pair = comptime { tuple([Int, Text]) }
            let pair Pair = (0, "zero")
            pair.0
        }
        """, """
        fn main() {
            let Pair = comptime { tuple([type]) }
            let escaped Pair = (Int,)
            discard escaped
        }
        """]
    var index = 0
    while index < length(invalid) {
        assert match constructed(get(invalid, index)) {
            Result.Err(_) => true
            Result.Ok(_) => false
        }
        index = index + 1
    }
}
