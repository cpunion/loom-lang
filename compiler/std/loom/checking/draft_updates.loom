record DraftUpdates {
    env Environment
    functions List[Function]
    current List[Function]
    root DraftRoot
    ty Int
    operations List[List[Expr]]
}

fn draft_type(candidate Expr) Int {
    if candidate.kind == ExprKind.Coerce {
        candidate.ty
    } else {
        // checked list: saved input; if predicate { Ok(refined input) } else ...
        let condition = get(candidate.children, 1)
        let accepted = get(get(condition.children, 1).children, 0)
        get(accepted.children, 0).ty
    }
}

fn draft_borrow(updates DraftUpdates, value Expr) Expr {
    let node = predicate_node(updates.env, get(updates.env.types, updates.ty).symbol)
    let refined = expression(ExprKind.Coerce, updates.ty, node, "", -1, expressions(value), value.falls)
    expression(ExprKind.Coerce, value.ty, node, "", -1, expressions(refined), value.falls)
}

// A may-origin only says an argument can reach the protected allocation. It
// cannot justify assuming its predicate: another branch might return fresh,
// invalid storage. Follow immutable definitions to prove actual identity.
fn draft_update_argument(updates DraftUpdates, argument Expr, origin InputOrigin,
    borrowed List[DraftRoot], depth Int) Result[Expr, Text] {
    if !origin_shared(origin) {
        return Result.Ok(argument)
    }
    if depth >= 64 || origin.indirect {
        return Result.Err("unknown protected storage path")
    }
    if argument.ty == base_type(updates.env, updates.ty) && origin_entire(origin) {
        let root = draft_root(updates.env, updates.functions, get(updates.current, 0), argument)
        if root.local < 0 || !draft_protected_root(root, updates.root) {
            return Result.Err("unproved protected header identity")
        }
        // Never import predicates from distinct alternatives into one operation,
        // or equate independent joins with the same possible allocations.
        if length(borrowed) == 0 {
            push(borrowed, root)
        } else if !same_draft_root(get(borrowed, 0), root) {
            return Result.Err("independent protected header choices")
        }
        return Result.Ok(draft_borrow(updates, argument))
    }
    let shape = get(updates.env.types, argument.ty)
    if origin_entire(origin) || (shape.kind != TypeKind.Record && shape.kind != TypeKind.Tuple) {
        return Result.Err("unknown protected aggregate")
    }
    var path = 0
    while path < length(origin.paths) {
        let field = get(get(origin.paths, path), 0)
        if field < 0 || field >= length(shape.fields) {
            return Result.Err("unknown protected field path")
        }
        path = path + 1
    }
    let node = predicate_node(updates.env, get(updates.env.types, updates.ty).symbol)
    let fields = new[Expr]()
    var index = 0
    while index < length(shape.fields) {
        let ty = get(shape.fields, index).ty
        let projected = expression(ExprKind.Field, ty, node, "", index, expressions(argument), true)
        let value = draft_update_argument(updates, projected, origin_project(origin, index), borrowed, depth + 1)?
        push(fields, expression(ExprKind.Field, ty, node, "", index, expressions(value), true))
        index = index + 1
    }
    Result.Ok(expression(ExprKind.Record, argument.ty, node, "", -1, fields, true))
}

fn draft_update(updates DraftUpdates, value Expr, inputs List[InputOrigin]) Bool {
    let arguments = new[Expr]()
    let borrowed = new[DraftRoot]()
    var index = 0
    while index < length(value.children) {
        match draft_update_argument(updates, get(value.children, index), get(inputs, index), borrowed, 0) {
            Result.Ok(argument) => push(arguments, argument)
            Result.Err(_) => {
                return false
            }
        }
        index = index + 1
    }
    var operation = Expr {
        kind = value.kind
        ty = value.ty
        span = value.span
        text = value.text
        index = value.index
        children = arguments
        arms = value.arms
        falls = value.falls
    }
    if !constraint_operation(updates.env, updates.functions, operation) {
        if operation.kind != ExprKind.Call {
            return false
        }
        operation = match draft_alias_operation(updates, operation) {
            Result.Ok(exact) => exact
            Result.Err(_) => {
                return false
            }
        }
        if !constraint_operation(updates.env, updates.functions, operation) {
            return false
        }
    }
    // Proof-only borrows never enter executable IR or persistent certificates.
    // Shared builds independently revalidate these operations and write sets.
    push(get(updates.operations, 0), operation)
    true
}
