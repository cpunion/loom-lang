fn cached_source(cache DefinitionCache, text Text) Result[CachedCheck, Failure] {
    check_project_cached(fixture_project(source_files(text)), false, build_inputs(no_input_reader), cache)
}

test fn generated_definitions_reuse_only_after_current_expansion_is_checked() {
    let source = """"
        fn api() Text {
            """
            pub fn generated(value Int) Int {
                value + 1
            }
            """
        }
        comptime {
            api()
        }
        pub fn answer() Int
        ensures result == 8
        {
            generated(7)
        }
        """"
    let initial = definition_cache()
    assert match cached_source(initial, source) {
        Result.Ok(_) => true
        Result.Err(_) => false
    }
    let cache = restored_definition_cache(initial)
    assert match cached_source(cache, concat(source, "\nfn unrelated() Int { 3 }\n")) {
        Result.Ok(_) => true
        Result.Err(_) => false
    }
    assert definitions_reused(cache) >= 2 && bodies_reused(cache) >= 2
    let changed = std.text.join(std.text.split(source, "value + 1"), "value + 2")
    assert match cached_source(cache, changed) {
        Result.Err(_) => true
        Result.Ok(_) => false
    }
    assert match cached_source(cache, source) {
        Result.Ok(_) => true
        Result.Err(_) => false
    }
}

test fn generated_definition_reuse_observes_current_build_options() {
    let files = source_files("""
        import std.build.value
        comptime {
            value("declaration")
        }
        pub fn answer() Int
        ensures result == 8
        {
            generated(7)
        }
        """)
    push(files, source_file("std.build", """
        intrinsic fn option_text(comptime name Text) Text
        pub fn value(comptime name Text) Text {
            option_text(name)
        }
        """, true))
    let project = fixture_project(files)
    let options = [BuildOption {
            name = "declaration"
            value = "pub fn generated(item Int) Int { item + 1 }"
        }]
    let initial = definition_cache()
    assert match check_project_cached(project, false, build_inputs(no_input_reader, options), initial) {
        Result.Ok(_) => true
        Result.Err(_) => false
    }
    let cache = restored_definition_cache(initial)
    assert match check_project_cached(project, false, build_inputs(no_input_reader, options), cache) {
        Result.Ok(_) => true
        Result.Err(_) => false
    }
    assert bodies_reused(cache) >= 2
    set(options, 0, BuildOption {
            name = "declaration"
            value = "pub fn generated(item Int) Int { item + 2 }"
        })
    assert match check_project_cached(project, false, build_inputs(no_input_reader, options), cache) {
        Result.Err(_) => true
        Result.Ok(_) => false
    }
}

test fn definition_reuse_tracks_transitive_calls_and_never_caches_failures() {
    let cache = definition_cache()
    let first = """
    fn leaf(value Int) Int {
        value + 1
    }
    fn middle(value Int) Int {
        leaf(value)
    }
    fn unrelated(value Int) Int {
        value * 2
    }
    """
    let second = """
    fn leaf(value Int) Int {
        value + 2
    }
    fn middle(value Int) Int {
        leaf(value)
    }
    fn unrelated(value Int) Int {
        value * 2
    }
    """
    assert match cached_source(cache, first) {
        Result.Ok(_) => true
        _ => false
    }
    assert definitions_reused(cache) == 0
    assert match cached_source(cache, second) {
        Result.Ok(_) => true
        _ => false
    }
    assert definitions_reused(cache) == 1
    assert match cached_source(cache, """
        fn leaf(value Int) Int {
            true
        }
        fn middle(value Int) Int {
            leaf(value)
        }
        fn unrelated(value Int) Int {
            value * 2
        }
        """) {
        Result.Err(_) => true
        _ => false
    }
    let before = definitions_reused(cache)
    assert match cached_source(cache, second) {
        Result.Ok(_) => true
        _ => false
    }
    assert definitions_reused(cache) - before == 3
}

test fn changed_invariant_helpers_revoke_all_dependent_proof_evidence() {
    let cache = definition_cache()
    assert match cached_source(cache, """
        fn valid(value Int) Bool {
            value > 0
        }
        type Positive = Int where valid(self)
        fn read(value Positive) Int
        ensures result > 0
        {
            value
        }
        """) {
        Result.Ok(_) => true
        _ => false
    }
    assert match cached_source(cache, """
        fn valid(value Int) Bool {
            value >= 0
        }
        type Positive = Int where valid(self)
        fn read(value Positive) Int
        ensures result > 0
        {
            value
        }
        """) {
        Result.Err(_) => true
        _ => false
    }
    assert definitions_reused(cache) == 0
}

test fn definition_cache_owns_evidence_and_uses_ast_not_only_source_text() {
    let cache = definition_cache()
    let project = fixture_project(source_files("""
        fn value() Int {
            1
        }
        """))
    let checked = match check_project_cached(project, false, build_inputs(no_input_reader), cache) {
        Result.Ok(value) => value
        Result.Err(_) => {
            assert false
            return
        }
    }
    let changed = fixture_project(source_files("""
        fn value() Int {
            true
        }
        """))
    let original = get(checked.bindings.files, 0)
    set(checked.bindings.files, 0, std.loom.project.SourceFile {
            package = original.package
            path = original.path
            text = original.text
            tree = get(changed.files, 0).tree
            test_only = original.test_only
            trusted_std = original.trusted_std
        })
    let edited = Project {
        files = checked.bindings.files
        modules = checked.bindings.modules
        packages = checked.bindings.packages
        root = checked.bindings.root
    }
    assert match check_project_cached(edited, false, build_inputs(no_input_reader), cache) {
        Result.Err(_) => true
        _ => false
    }
    assert definitions_reused(cache) == 0
    assert match check_project_cached(project, false, build_inputs(no_input_reader), cache) {
        Result.Ok(_) => true
        _ => false
    }
    assert definitions_reused(cache) == 1
}

test fn definition_reuse_survives_reordering_moves_and_unrelated_additions() {
    let cache = definition_cache()
    let leaf = """
        fn leaf() Int {
            1
        }
        """
    let callers = """
        fn caller() Int {
            leaf()
        }
        fn independent() Int {
            7
        }
        """
    assert match cached_source(cache, concat(leaf, callers)) {
        Result.Ok(_) => true
        _ => false
    }
    let files = source_files(callers)
    let moved = source_file("app", leaf, false)
    push(files, TestFile {
            path = "moved.loom"
            ..moved
        })
    assert match check_project_cached(fixture_project(files), false, build_inputs(no_input_reader), cache) {
        Result.Ok(_) => true
        _ => false
    }
    assert definitions_reused(cache) == 3
    let added = concat("""
        fn added() Bool {
            true
        }
        """, concat(callers, leaf))
    assert match cached_source(cache, added) {
        Result.Ok(_) => true
        _ => false
    }
    assert definitions_reused(cache) == 6
    assert match cached_source(cache, callers) {
        Result.Err(_) => true
        _ => false
    }
}

test fn newly_added_overloads_invalidate_existing_caller_proofs() {
    let cache = definition_cache()
    let source = """
        type Positive = Int where self > 0
        fn pick(value Int) Int {
            1
        }
        fn caller() Int
        ensures result == 1
        {
            pick(Positive(1))
        }
        """
    assert match cached_source(cache, source) {
        Result.Ok(_) => true
        _ => false
    }
    assert match cached_source(cache, concat(source, """
        fn pick(value Positive) Int {
            2
        }
        """)) {
        Result.Err(failed) => failed.diagnostic.message == "required postcondition is not proved by the bounded scalar prover"
        _ => false
    }
}

test fn matching_method_bodies_cannot_move_evidence_between_impl_owners() {
    let cache = definition_cache()
    let header = """
        concept Score {
            fn score(self Self) Int
        }
        fn caller(value Int) Int
        ensures result == 1
        {
            value.score()
        }
        """
    assert match cached_source(cache, concat(header, """
        impl Score for Int {
            fn score(self Self) Int {
                1
            }
        }
        impl Score for Bool {
            fn score(self Self) Int {
                2
            }
        }
        """)) {
        Result.Ok(_) => true
        _ => false
    }
    assert match cached_source(cache, concat(header, """
        impl Score for Int {
            fn score(self Self) Int {
                2
            }
        }
        impl Score for Bool {
            fn score(self Self) Int {
                1
            }
        }
        """)) {
        Result.Err(failed) => failed.diagnostic.message == "required postcondition is not proved by the bounded scalar prover"
        _ => false
    }
}
