// Static iteration emits normal lexical blocks and field projections. A
// record's declaration order is its traversal order, not initializer order.
fn tuple_iteration_members(arity Int) List[Text] {
    let members = new[Text]()
    var index = 0
    while index < arity {
        push(members, std.int.to_text(index))
        index = index + 1
    }
    members
}

fn value_iteration(context Context, node Node) Result[Node, Failure] {
    let source = child(node, 0)
    let label = if node.kind == NodeKind.ComptimeMap {
        "comptime map"
    } else {
        "comptime for"
    }
    let failed = error(context, source, concat(label, " requires an immutable tuple or record binding"))
    let binding = if source.kind == NodeKind.Name {
        lookup(context, source.value)
    } else {
        -1
    }
    if binding < 0 {
        if parameter_name(context, source.value) || find_data(context.env, context.signature.symbol, source, source.value)? >= 0 {
            return shape_iteration(context, node, context_type(context, source)?)
        }
        return Result.Err(failed)
    }
    let selected = get(context.bindings, binding)
    let known_type = meta_binding(context, source.value)
    if known_type >= 0 {
        return shape_iteration(context, node, known_type)
    }
    let ty = iteration_type(context, selected)
    if ty < 0 {
        return Result.Err(failed)
    }
    let shape = get(context.env.types, base_type(context.env, ty))
    if shape.kind != TypeKind.Tuple && shape.kind != TypeKind.Record {
        return Result.Err(failed)
    }
    let arity = if shape.kind == TypeKind.Tuple {
        length(shape.arguments)
    } else {
        length(shape.fields)
    }
    if arity > 1024 || length(context.locals) > 65536 - arity {
        return Result.Err(error(context, source, "static aggregate iteration budget exceeded"))
    }
    let members = if shape.kind == TypeKind.Tuple {
        tuple_iteration_members(arity)
    } else {
        let declaration = symbol(context.env, shape.symbol)
        let here = symbol(context.env, context.signature.symbol)
        if !declaration.public && get(context.env.source.files, declaration.file).package != get(context.env.source.files, here.file).package {
            return Result.Err(error(context, source, "cannot inspect a private type from another package"))
        }
        let names = new[Text]()
        var index = 0
        while index < length(shape.fields) {
            push(names, get(shape.fields, index).name)
            index = index + 1
        }
        names
    }
    let count = new[Int]()
    push(count, 0)
    let named = shape.kind == TypeKind.Record
    if selected.constant >= 0 {
        // Freeze the original constant under an unspellable name before field
        // aliases are introduced. A loop variable may shadow its source name.
        let name = concat("$aggregate", std.int.to_text(length(context.bindings)))
        let children = source_nodes(pack_node(source, NodeKind.Name, name, new[Node]()))
        push(children, child(node, 1))
        if has(node, NodeKind.IterationKey) {
            push(children, child(node, part(node, NodeKind.IterationKey)))
        }
        let renamed = pack_node(node, node.kind, node.value, children)
        let body = source_nodes(pack_binding(source, name, source, true))
        push(body, expand_pack_iteration(context.env, context.signature.symbol, renamed,
                name, members, named, true, false, false, 0, count)?)
        return Result.Ok(pack_node(node, NodeKind.Block, "", body))
    }
    expand_pack_iteration(context.env, context.signature.symbol, node, source.value,
        members, named, selected.constant < -1, false, false, 0, count)
}

// Iterate types without constructing sample values or exposing runtime type
// handles. Value bindings take precedence at the source lookup above.
fn shape_iteration(context Context, node Node, ty Int) Result[Node, Failure] {
    let shape = get(context.env.types, base_type(context.env, ty))
    if shape.kind != TypeKind.Record && shape.kind != TypeKind.Tuple {
        return Result.Err(error(context, child(node, 0), "static type iteration requires a known tuple or record shape"))
    }
    if shape.kind == TypeKind.Record {
        let declaration = symbol(context.env, shape.symbol)
        let here = symbol(context.env, context.signature.symbol)
        if !declaration.public && get(context.env.source.files, declaration.file).package != get(context.env.source.files, here.file).package {
            return Result.Err(error(context, node, "cannot inspect a private type from another package"))
        }
    }
    if length(shape.fields) > 1024 {
        return Result.Err(error(context, node, "static aggregate iteration budget exceeded"))
    }
    let iterations = new[Node]()
    let count = ints(0)
    var index = 0
    while index < length(shape.fields) {
        let field = get(shape.fields, index)
        let selected = concat("$type#", std.int.to_text(field.ty))
        let substituted = bind_type_iteration(child(node, 1), node.value, selected, false, false, 0)
        let body = expand_pack_iteration(context.env, context.signature.symbol, substituted,
            "", new[Text](), false, false, true, true, 0, count)?
        let statements = new[Node]()
        iteration_key(node, statements, field.name, shape.kind == TypeKind.Record)
        push(statements, body)
        push(iterations, pack_node(node, NodeKind.Block, "", statements))
        index = index + 1
    }
    if node.kind == NodeKind.ComptimeMap {
        return Result.Ok(pack_node(node, NodeKind.Tuple, "", iterations))
    }
    push(iterations, pack_node(node, NodeKind.Block, "", new[Node]()))
    Result.Ok(pack_node(node, NodeKind.Block, "", iterations))
}
