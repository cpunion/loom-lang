import std.loom.ast.Node
import std.loom.ast.NodeKind
import std.loom.project.qualify
import std.loom.typed.TypeKind
import std.list.new
import std.list.get
import std.list.set
import std.list.push
import std.list.length
import std.text.slice
import std.text.length
import std.result.Result

fn owned_associations(env Environment, owner Int) List[Int] {
    let members = new[Int]()
    var index = 0
    while index < length(env.source.symbols) {
        let item = symbol(env, index)
        if item.owner == owner && item.node.kind == NodeKind.AssociatedType { push(members, index) }
        index = index + 1
    }
    members
}
fn implementation_owner(env Environment, owner Int) Int {
    var index = 0
    while index < length(env.implementations) {
        if get(env.implementations, index).symbol == owner { return index }
        index = index + 1
    }
    -1
}
fn enclosing(env Environment, owner Int) Int {
    let item = symbol(env, owner)
    if item.node.kind == NodeKind.Concept || item.node.kind == NodeKind.Impl { owner } else { item.owner }
}
fn header_environment(env Environment) Environment {
    Environment { source = env.source types = env.types type_states = env.type_states expand_data = false has_refinements = env.has_refinements expanding_helpers = env.expanding_helpers
        signatures = env.signatures pending = env.pending stage_depth = env.stage_depth computations = env.computations validations = env.validations
        concepts = env.concepts implementations = env.implementations interfaces = env.interfaces witnesses = env.witnesses uses = env.uses
        associations = env.associations association_depth = env.association_depth
        family_applications = env.family_applications promise_path = env.promise_path promise_depth = env.promise_depth
        dynamic_interfaces = env.dynamic_interfaces }
}
fn association_environment(env Environment, member Int, receiver Int, arguments List[Int]) Result[Environment, Failure] {
    let node = symbol(env, member).node
    if env.association_depth >= 64 { return Result.Err(failure(env, member, node, "associated type expansion must be finite")) }
    var index = 0
    while index < env.association_depth {
        let earlier = get(env.associations, index)
        if earlier.member == member && earlier.receiver == receiver && same(earlier.arguments, arguments) {
            return Result.Err(failure(env, member, node, "cyclic associated type binding or default"))
        }
        index = index + 1
    }
    let current = Association { member = member receiver = receiver arguments = arguments }
    if index == length(env.associations) { push(env.associations, current) } else { set(env.associations, index, current) }
    Result.Ok(Environment { source = env.source types = env.types type_states = env.type_states expand_data = env.expand_data has_refinements = env.has_refinements expanding_helpers = env.expanding_helpers
        signatures = env.signatures pending = env.pending stage_depth = env.stage_depth computations = env.computations validations = env.validations
        concepts = env.concepts implementations = env.implementations interfaces = env.interfaces witnesses = env.witnesses uses = env.uses
        associations = env.associations association_depth = env.association_depth + 1
        family_applications = env.family_applications promise_path = env.promise_path promise_depth = env.promise_depth
        dynamic_interfaces = env.dynamic_interfaces })
}
fn implementation_type(env Environment, index Int, depth Int) Result[Int, Failure] {
    let header = get(env.implementations, index)
    if header.state == 2 { return Result.Ok(header.ty) }
    let item = symbol(env, header.symbol)
    if header.state == 1 || depth > 64 { return Result.Err(failure(env, header.symbol, item.node, "cyclic implementation target")) }
    set(env.implementations, index, Implementation { symbol = header.symbol capability = header.capability ty = -1
        methods = header.methods associated = header.associated state = 1 })
    let parameters = abstract_arguments(env, length(type_parameters(env, header.symbol)))
    let ty = resolve(header_environment(env), header.symbol, child(item.node, 1), parameters, depth + 1)?
    let seen = new[Bool]()
    var parameter = 0
    while parameter < length(parameters) { push(seen, false)
        parameter = parameter + 1 }
    if get(env.types, ty).kind == TypeKind.Dyn || !target_parameters(env, ty, seen) {
        return Result.Err(failure(env, header.symbol, item.node, "implementation targets cannot be dynamic or contain associated projections"))
    }
    parameter = 0
    while parameter < length(seen) {
        if !get(seen, parameter) { return Result.Err(failure(env, header.symbol, item.node, "every implementation parameter must occur in its target type")) }
        parameter = parameter + 1
    }
    set(env.implementations, index, Implementation { symbol = header.symbol capability = header.capability ty = ty
        methods = header.methods associated = header.associated state = 2 })
    Result.Ok(ty)
}
fn conformance_headers(env Environment) Result[Bool, Failure] {
    var owner = 0
    while owner < length(env.source.symbols) {
        if symbol(env, owner).node.kind == NodeKind.Concept {
            let members = owned_associations(env, owner)
            let bounds = new[List[Int]]()
            var member = 0
            while member < length(members) {
                let declaration = get(members, member)
                discard member_parameter_headers(env, declaration, declaration)?
                let nodes = group(symbol(env, declaration).node, NodeKind.Bounds)
                let required = new[Int]()
                var bound = 0
                while bound < length(nodes) {
                    let capability = required_concept(env, declaration, get(nodes, bound))?
                    var previous = 0
                    while previous < length(required) {
                        if get(required, previous) == capability {
                            return Result.Err(failure(env, declaration, get(nodes, bound), "duplicate associated type requirement"))
                        }
                        previous = previous + 1
                    }
                    push(required, capability)
                    bound = bound + 1
                }
                push(bounds, required)
                member = member + 1
            }
            push(env.concepts, Concept { symbol = owner methods = new[Int]() associated = members bounds = bounds })
        }
        owner = owner + 1
    }
    owner = 0
    while owner < length(env.source.symbols) {
        let item = symbol(env, owner)
        if item.node.kind == NodeKind.Impl {
            let capability = required_concept(env, owner, child(item.node, 0))?
            let expected = get(env.concepts, concept_index(env, capability)).associated
            let actual = owned_associations(env, owner)
            let bindings = new[Int]()
            var supplied = 0
            var index = 0
            while index < length(expected) {
                var found = -1
                var candidate = 0
                while candidate < length(actual) {
                    if symbol(env, get(actual, candidate)).name == symbol(env, get(expected, index)).name { found = get(actual, candidate) }
                    candidate = candidate + 1
                }
                if found >= 0 { supplied = supplied + 1 } else {
                    let fallback = get(expected, index)
                    if type_part(symbol(env, fallback).node) < 0 {
                        return Result.Err(failure(env, owner, item.node, "missing associated type binding without a default"))
                    }
                    found = fallback
                }
                discard member_parameter_headers(env, get(expected, index), found)?
                push(bindings, found)
                index = index + 1
            }
            if supplied != length(actual) { return Result.Err(failure(env, owner, item.node, "unknown associated type binding")) }
            push(env.implementations, Implementation { symbol = owner capability = capability ty = -1
                methods = new[Int]() associated = bindings state = 0 })
        }
        owner = owner + 1
    }
    var index = 0
    while index < length(env.implementations) {
        discard implementation_type(env, index, 0)?
        let header = get(env.implementations, index)
        var previous = 0
        while previous < index {
            let other = get(env.implementations, previous)
            if other.capability == header.capability && overlapping(env, other, header)? {
                return Result.Err(failure(env, header.symbol, symbol(env, header.symbol).node, "overlapping implementations for this concept"))
            }
            previous = previous + 1
        }
        index = index + 1
    }
    Result.Ok(true)
}
fn self_type(env Environment, owner Int, arguments List[Int], depth Int) Result[Int, Failure] {
    let parent = enclosing(env, owner)
    if parent < 0 { return Result.Ok(-1) }
    if symbol(env, parent).node.kind == NodeKind.Concept { return Result.Ok(get(arguments, 0)) }
    if symbol(env, parent).node.kind == NodeKind.Impl {
        let target = implementation_type(env, implementation_owner(env, parent), depth + 1)?
        return substitute(header_environment(env), owner, target, arguments, symbol(env, owner).node)
    }
    Result.Ok(-1)
}
fn required(obligations List[Requirement], ty Int, capability Int) Bool {
    var index = 0
    while index < length(obligations) {
        let requirement = get(obligations, index)
        if requirement.ty == ty && requirement.capability == capability { return true }
        index = index + 1
    }
    false
}
fn member_bounds(env Environment, member Int) List[Int] {
    let declaration = get(env.concepts, concept_index(env, symbol(env, member).owner))
    var index = 0
    while get(declaration.associated, index) != member { index = index + 1 }
    get(declaration.bounds, index)
}
// Derive promises only from opaque projections. Flattening them onto an impl's
// normalized parameter would let that impl use its own promise as its proof.
fn entailed(env Environment, obligations List[Requirement], ty Int, capability Int) Bool {
    if required(obligations, ty, capability) { return true }
    let shape = get(env.types, ty)
    if shape.kind != TypeKind.Associated { return false }
    let bounds = member_bounds(env, shape.symbol)
    var index = 0
    while index < length(bounds) {
        if get(bounds, index) == capability {
            return entailed(env, obligations, get(shape.arguments, 0), symbol(env, shape.symbol).owner)
        }
        index = index + 1
    }
    false
}
fn associated_type(env Environment, owner Int, member Int, receiver Int, arguments List[Int], node Node, depth Int) Result[Int, Failure] {
    if depth > 64 { return Result.Err(failure(env, owner, node, "associated type expansion must be finite")) }
    if length(arguments) != length(member_parameters(env, member)) {
        return Result.Err(failure(env, owner, node, "wrong number of associated type arguments"))
    }
    let shape = get(env.types, receiver)
    let capability = symbol(env, member).owner
    if shape.kind == TypeKind.Dyn {
        if length(arguments) != 0 {
            return Result.Err(failure(env, owner, node, "dyn does not yet support generic associated type families"))
        }
        if get(env.interfaces, shape.symbol).symbol != capability {
            return Result.Err(failure(env, owner, node, "dynamic receiver does not expose this associated type"))
        }
        let members = get(env.concepts, concept_index(env, capability)).associated
        var index = 0
        while get(members, index) != member { index = index + 1 }
        return Result.Ok(get(shape.arguments, index))
    }
    let selected = conformance(env, receiver, capability)
    let parent = enclosing(env, owner)
    var own = selected.implementation >= 0 && parent >= 0 && symbol(env, parent).node.kind == NodeKind.Impl &&
        get(env.implementations, selected.implementation).symbol == parent
    if env.association_depth > 0 {
        let active = get(env.associations, env.association_depth - 1)
        if active.receiver == receiver && symbol(env, active.member).owner == capability { own = true }
    }
    if (shape.kind == TypeKind.Parameter || shape.kind == TypeKind.Associated) && !own {
        return Result.Ok(intern(env, TypeKind.Associated, member, member_arguments(ints(receiver), arguments)))
    }
    if selected.implementation < 0 { return Result.Err(failure(env, owner, node, "associated type requires an explicit conformance")) }
    let header = get(env.implementations, selected.implementation)
    let members = get(env.concepts, concept_index(env, capability)).associated
    var index = 0
    while get(members, index) != member { index = index + 1 }
    let binding = get(header.associated, index)
    let definition = symbol(env, binding).node
    let resolution_env = association_environment(env, member, receiver, arguments)?
    // Defaults retain their defining package/import scope, but Self projections
    // use this implementation's effective map, including explicit overrides.
    let resolved = resolve(resolution_env, binding, child(definition, type_part(definition)),
        member_arguments(if prototype(env, binding) { ints(receiver) } else { selected.arguments }, arguments), depth + 1)?
    if length(arguments) != 0 { register_family_application(env, member, receiver, arguments, resolved) }
    Result.Ok(resolved)
}
fn projection(env Environment, owner Int, node Node, arguments List[Int], obligations List[Requirement], depth Int) Result[Int, Failure] {
    let split = first_dot(node.value)
    if split == length(node.value) { return Result.Ok(-1) }
    let first = slice(node.value, 0, split)
    var receiver = -1
    if first == "Self" { receiver = self_type(env, owner, arguments, depth)? }
    let parameters = type_parameters(env, owner)
    var index = 0
    while index < length(parameters) {
        if get(parameters, index).value == first { receiver = get(arguments, index + parameter_offset(env, owner)) }
        index = index + 1
    }
    if receiver < 0 { return Result.Ok(-1) }
    let rest = slice(node.value, split + 1, length(node.value))
    let qualifier = package(rest)
    let selected = if qualifier == "" { -1 } else { concept_named(env, owner, node, qualifier)? }
    if qualifier != "" && selected < 0 { return Result.Err(failure(env, owner, node, "unknown associated type concept qualifier")) }
    let parent = enclosing(env, owner)
    var own = -1
    if first == "Self" && parent >= 0 {
        own = if symbol(env, parent).node.kind == NodeKind.Concept { parent } else {
            get(env.implementations, implementation_owner(env, parent)).capability }
    }
    var found = -1
    var bound_only = false
    index = 0
    while index < length(env.concepts) {
        let capability = get(env.concepts, index)
        if entailed(env, obligations, receiver, capability.symbol) || own == capability.symbol {
            var member = 0
            while member < length(capability.associated) {
                if symbol(env, get(capability.associated, member)).name == name(rest) { bound_only = true }
                member = member + 1
            }
        }
        index = index + 1
    }
    index = 0
    while index < length(env.concepts) {
        let capability = get(env.concepts, index)
        let declaration = symbol(env, capability.symbol)
        let bound = entailed(env, obligations, receiver, capability.symbol) || own == capability.symbol
        let visible = bound || concept_named(env, owner, node,
            qualify(package_label(env.source.modules, env.source.packages, get(env.source.files, declaration.file).package), declaration.name))? == capability.symbol
        if ((selected < 0 && (!bound_only || bound)) || selected == capability.symbol) && visible &&
            (bound || admitted(env, owner, obligations, receiver, capability.symbol)?) {
            var member = 0
            while member < length(capability.associated) {
                let id = get(capability.associated, member)
                if symbol(env, id).name == name(rest) {
                    if found >= 0 { return Result.Err(failure(env, owner, node, "ambiguous associated type; qualify its concept")) }
                    found = id
                }
                member = member + 1
            }
        }
        index = index + 1
    }
    if found < 0 { return Result.Err(failure(env, owner, node, "associated type needs an explicit, accessible concept requirement")) }
    let supplied = new[Int]()
    index = 0
    while index < length(node.children) {
        let argument = resolve_bound(env, owner, child(node, index), arguments, obligations, depth + 1)?
        discard well_formed(env, owner, argument, obligations, child(node, index), 0)?
        push(supplied, argument)
        index = index + 1
    }
    discard member_domain(env, owner, found, supplied, obligations, node)?
    associated_type(env, owner, found, receiver, supplied, node, depth + 1)
}
