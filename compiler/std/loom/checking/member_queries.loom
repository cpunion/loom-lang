import std.text.starts_with

// Completion hints, not a checked Program or proof of the surrounding body.
pub record MemberCandidate {
    name Text
    ty Text
    method Int
}

pub enum MemberQuery {
    Members(List[MemberCandidate])
    Qualified
}

record MemberScope {
    context Context
    // Locals below this boundary belong to an enclosing runtime/staging scope.
    boundary Int
}

fn query_inside(node Node, offset Int) Bool {
    node.span.start <= offset && offset < node.span.end
}

// Follow only the lexical path to the query. Completed preceding statements use
// the ordinary checker; an incomplete current expression is not fabricated into
// a successful body. No query flag or callback enters ordinary expression checks.
fn member_expression(scope MemberScope, node Node, expected Int) Result[Expr, Failure] {
    let value = expr(scope.context, node, expected)?
    if scope.boundary >= 0 {
        discard isolated(scope.context, node, value, scope.boundary)?
    }
    Result.Ok(value)
}

fn member_context(scope MemberScope, node Node, offset Int) Result[MemberScope, Failure] {
    let context = scope.context
    if node.kind == NodeKind.Block {
        var current = context
        var index = 0
        while index < length(node.children) {
            let source = child(node, index)
            if query_inside(source, offset) {
                return member_context(MemberScope {
                        context = current
                        boundary = scope.boundary
                    }, source, offset)
            }
            if source.span.end <= offset {
                if statement_kind(source.kind) {
                    let checked = statement(current, source, context.head)?
                    if scope.boundary >= 0 {
                        discard isolated(current, source, checked.expression, scope.boundary)?
                    }
                    current = checked.context
                    if !checked.expression.falls {
                        return Result.Err(error(context, source, "completion follows an unconditional exit"))
                    }
                } else {
                    let checked = member_expression(MemberScope {
                            context = current
                            boundary = scope.boundary
                        }, source, 0)?
                    if !checked.falls {
                        return Result.Err(error(context, source, "completion follows an unconditional exit"))
                    }
                }
            }
            index = index + 1
        }
        return Result.Ok(MemberScope {
                context = current
                boundary = scope.boundary
            })
    }
    if node.kind == NodeKind.If || node.kind == NodeKind.While {
        var branch = 1
        while branch < length(node.children) {
            if query_inside(child(node, branch), offset) {
                let condition = member_expression(scope, child(node, 0), 2)?
                let selected = assuming(context, condition, branch == 1, 0)
                return member_context(MemberScope {
                        context = if node.kind == NodeKind.While {
                            loop_context(selected, context.cleanup_head)
                        } else {
                            selected
                        }
                        boundary = scope.boundary
                    }, child(node, branch), offset)
            }
            branch = branch + 1
        }
    }
    if node.kind == NodeKind.Match && !query_inside(child(node, 0), offset) {
        let value = member_expression(scope, child(node, 0), -1)?
        var index = 1
        while index < length(node.children) {
            let arm = child(node, index)
            if query_inside(arm, offset) && !query_inside(child(arm, 0), offset) {
                if nested_pattern(child(arm, 0)) || match_guarded(arm) {
                    let pattern = pattern_scope(context, child(arm, 0), value.ty, match_body(arm), context.head, 0,
                        resource_borrowed(context, value)?)?
                    var selected = pattern.context
                    if match_guarded(arm) {
                        let guard = child(arm, 1)
                        if query_inside(guard, offset) {
                            return member_context(MemberScope {
                                    context = selected
                                    boundary = scope.boundary
                                }, guard, offset)
                        }
                        selected = assuming(selected,
                            member_expression(MemberScope {
                                    context = selected
                                    boundary = scope.boundary
                                }, guard, 2)?, true, 0)
                    }
                    return member_context(MemberScope {
                            context = selected
                            boundary = scope.boundary
                        }, match_body(arm), offset)
                }
                let selected = match_scope(context, value, arm)?
                return member_context(MemberScope {
                        context = selected.context
                        boundary = scope.boundary
                    }, match_body(arm), offset)
            }
            index = index + 1
        }
    }
    if node.kind == NodeKind.Defer {
        return member_context(MemberScope {
                context = loop_context(context, -2)
                boundary = scope.boundary
            }, child(node, 0), offset)
    }
    if node.kind == NodeKind.Comptime {
        let source = child(node, 0)
        if source.kind != NodeKind.If {
            let stage = staging(context, node)?
            let validation = Context {
                lexical = stage.lexical
                env = stage.env
                signature = stage.signature
                arguments = stage.arguments
                constants = stage.constants
                locals = stage.locals
                bindings = stage.bindings
                head = stage.head
                cleanups = stage.cleanups
                cleanup_head = stage.cleanup_head
                loop_boundary = stage.loop_boundary
                facts = stage.facts
                fact_head = stage.fact_head
                emit = false
            }
            return member_context(MemberScope {
                    context = validation
                    boundary = length(context.locals)
                }, source, offset)
        }
        return match guard_condition(context, node, child(source, 0), 0)? {
            GuardDecision.Pending => Result.Err(error(context, node, "completion needs a determined compile-time branch"))
            GuardDecision.Known(yes, chosen) => {
                let index = if yes {
                    1
                } else {
                    2
                }
                if index >= length(source.children) || !query_inside(child(source, index), offset) {
                    Result.Err(error(context, node, "completion is outside the selected compile-time branch"))
                } else {
                    member_context(MemberScope {
                            context = chosen
                            boundary = scope.boundary
                        }, child(source, index), offset)
                }
            }
        }
    }
    var index = 0
    while index < length(node.children) {
        let child = child(node, index)
        if query_inside(child, offset) {
            return member_context(scope, child, offset)
        }
        index = index + 1
    }
    Result.Ok(scope)
}

fn member_hints(context Context, value Expr, prefix Text) Result[List[MemberCandidate], Failure] {
    let env = context.env
    let labels = new[Text]()
    if prototype(env, context.signature.symbol) {
        push(labels, "Self")
    }
    let parameters = type_parameters(env, context.signature.symbol)
    var parameter = 0
    while parameter < length(parameters) {
        push(labels, get(parameters, parameter).value)
        parameter = parameter + 1
    }
    let original = get(env.types, value.ty)
    let shape = if original.kind == TypeKind.Refined && get(env.types, base_type(env, value.ty)).kind == TypeKind.Record {
        get(env.types, base_type(env, value.ty))
    } else {
        original
    }
    let hints = new[MemberCandidate]()
    if shape.kind == TypeKind.Record {
        let declaration = symbol(env, shape.symbol)
        let here = symbol(env, context.signature.symbol)
        if declaration.public || get(env.source.files, declaration.file).package == get(env.source.files, here.file).package {
            var index = 0
            while index < length(shape.fields) {
                let field = get(shape.fields, index)
                if starts_with(field.name, prefix) {
                    push(hints, MemberCandidate {
                            name = field.name
                            ty = type_name(env.source, env.types, env.interfaces, field.ty, labels)
                            method = -1
                        })
                }
                index = index + 1
            }
        }
    }
    if shape.kind == TypeKind.Tuple {
        var index = 0
        while index < length(shape.arguments) {
            let name = to_text(index)
            if starts_with(name, prefix) {
                push(hints, MemberCandidate {
                        name = name
                        ty = type_name(env.source, env.types, env.interfaces, get(shape.arguments, index), labels)
                        method = -1
                    })
            }
            index = index + 1
        }
    }
    if shape.kind == TypeKind.Task && has(symbol(env, context.signature.symbol).node, NodeKind.Async) && starts_with("await", prefix) {
        push(hints, MemberCandidate {
                name = "await"
                ty = type_name(env.source, env.types, env.interfaces, get(shape.arguments, 0), labels)
                method = -2
            })
    }
    var index = 0
    while index < length(env.concepts) {
        let capability = get(env.concepts, index)
        let visible = if shape.kind == TypeKind.Dyn {
            let declared = symbol(env, capability.symbol)
            let here = symbol(env, context.signature.symbol)
            get(env.interfaces, shape.symbol).symbol == capability.symbol &&
            (declared.public || get(env.source.files, declared.file).package == get(env.source.files, here.file).package)
        } else {
            visible_concept(context, capability.symbol)
        }
        if visible && satisfies(context, value.ty, capability.symbol)? {
            var method = 0
            while method < length(capability.methods) {
                let id = get(capability.methods, method)
                let signature = get(env.signatures, id)
                let item = symbol(env, signature.symbol)
                if method_receiver(env, signature.symbol) && pack_instance(env, id) < 0 && starts_with(item.name, prefix) {
                    push(hints, MemberCandidate {
                            name = item.name
                            ty = ""
                            method = signature.symbol
                        })
                }
                method = method + 1
            }
            // Suggest a source family once, independent of which arities the
            // preceding body selected. Generated symbols are not editor IDs.
            method = 0
            while method < length(env.packs) {
                let pack = get(env.packs, method)
                let item = symbol(env, pack.source)
                if pack_family(pack) && item.owner == capability.symbol && method_receiver(env, pack.source) && starts_with(item.name, prefix) {
                    push(hints, MemberCandidate {
                            name = item.name
                            ty = ""
                            method = pack.source
                        })
                }
                method = method + 1
            }
        }
        index = index + 1
    }
    Result.Ok(hints)
}

// Signature/body-prefix inference shares ordinary checking, but neither the
// incomplete body nor its callees are claimed verified. Only candidate strings
// leave the query. Unknown receiver types and earlier typing errors reject.
pub fn member_candidates(source std.loom.binding.Program, file Int, offset Int, receiver Node, prefix Text) Result[MemberQuery, Failure] {
    member_candidates(source, file, offset, receiver, prefix, build_inputs(no_input_reader))
}

pub fn member_candidates(source std.loom.binding.Program, file Int, offset Int, receiver Node, prefix Text, inputs BuildInputs) Result[MemberQuery, Failure] {
    let env = prepare_with_inputs(query_source(source)?, inputs)?
    var index = 0
    while index < length(env.signatures) {
        let current = get(env.signatures, index)
        let item = symbol(env, current.symbol)
        if item.file == file && query_inside(item.node, offset) && has(item.node, NodeKind.Block) {
            let arguments = abstract_arguments(env, current.parameters)
            let scope = function_scope(env, signature(env, index, arguments, item.node)?, arguments, unknown_constants(current), false)?
            let body = child(item.node, part(item.node, NodeKind.Block))
            if !query_inside(body, offset) {
                return Result.Ok(MemberQuery.Members(new[MemberCandidate]()))
            }
            let selected = member_context(MemberScope {
                    context = scope.context
                    boundary = -1
                }, body, offset)?
            let context = selected.context
            let value = match member_expression(selected, receiver, -1) {
                Result.Ok(value) => value
                Result.Err(failed) => {
                    // A failed local receiver never falls back to a namespace.
                    // Global function/enum values keep their member path too.
                    if receiver.kind == NodeKind.Name && lookup(context, slice(receiver.value, 0, first_dot(receiver.value))) < 0 {
                        return Result.Ok(MemberQuery.Qualified)
                    }
                    return Result.Err(failed)
                }
            }
            return Result.Ok(MemberQuery.Members(member_hints(context, value, prefix)?))
        }
        index = index + 1
    }
    Result.Ok(MemberQuery.Members(new[MemberCandidate]()))
}
