// Bridge symbolic words to the ordinary associated-member resolver. A rigid
// identity is an arbitrary type, not a selected width or a representative
// element. Only capabilities proved for the complete schema enter its scope.
fn pack_symbolic_type(context Context, caller Node, schema Node, obligations List[Requirement],
    budget List[Int], depth Int) Result[Int, Failure] {
    pack_symbolic_type(context, caller, schema, obligations, budget, depth, Option.None)
}

fn pack_symbolic_type(context Context, caller Node, schema Node, obligations List[Requirement],
    budget List[Int], depth Int, assumptions Option[List[PackLayoutRequirement]]) Result[Int, Failure] {
    if depth >= 64 || get(budget, 0) == 0 {
        return Result.Ok(-1)
    }
    set(budget, 0, get(budget, 0) - 1)
    if schema.kind == NodeKind.Select {
        return pack_projection_type(context, caller, schema, obligations, budget, depth + 1, assumptions)
    }
    if schema.kind == NodeKind.DynType {
        return pack_dynamic_type(context, caller, schema, obligations, budget, depth + 1, assumptions)
    }
    if schema.kind == NodeKind.Type {
        match std.int.parse(schema.value) {
            Result.Ok(ty) => {
                if ty >= 0 && ty < length(context.env.types) &&
                pack_schema_equal(impl_type_schema(context.env, ty, schema, true), schema) {
                    return Result.Ok(ty)
                }
            }
            Result.Err(_) => {
            }
        }
    }
    let ty = intern(context.env, TypeKind.Rigid, length(context.env.types), new[Int]())
    let parameter = pack_schema_parameter(schema)
    if parameter >= 0 {
        match assumptions {
            Option.Some(known) => {
                var index = 0
                while index < length(known) {
                    let requirement = get(known, index)
                    if pack_schema_equal(requirement.schema, schema) {
                        push(obligations, Requirement {
                                ty = ty
                                capability = requirement.capability
                            })
                    }
                    index = index + 1
                }
                return Result.Ok(ty)
            }
            Option.None => {
            }
        }
        let source = get(group(caller, NodeKind.TypeParameters), parameter)
        var bound = 0
        while bound < length(source.children) {
            push(obligations, Requirement {
                    ty = ty
                    capability = required_concept(context.env, pack_layout_owner(context), child(source, bound))?
                })
            bound = bound + 1
        }
        return Result.Ok(ty)
    }
    var index = 0
    while index < length(context.env.concepts) {
        let capability = get(context.env.concepts, index).symbol
        let declaration = symbol(context.env, capability)
        let spelling = qualify(package_label(context.env.source.modules, context.env.source.packages,
                get(context.env.source.files, declaration.file).package), declaration.name)
        // Derived implementation evidence must not make a hidden concept
        // visible merely by attaching it to a fresh logical receiver.
        if concept_named(context.env, pack_layout_owner(context), schema, spelling)? == capability &&
        pack_layout_admitted(context, caller, schema, capability,
            new[PackLayoutRequirement](), budget, 0, assumptions)? {
            push(obligations, Requirement {
                    ty = ty
                    capability = capability
                })
        }
        index = index + 1
    }
    Result.Ok(ty)
}

fn pack_projection_type(context Context, caller Node, schema Node, obligations List[Requirement],
    budget List[Int], depth Int) Result[Int, Failure] {
    pack_projection_type(context, caller, schema, obligations, budget, depth, Option.None)
}

fn pack_projection_type(context Context, caller Node, schema Node, obligations List[Requirement],
    budget List[Int], depth Int, assumptions Option[List[PackLayoutRequirement]]) Result[Int, Failure] {
    if depth >= 64 || get(budget, 0) == 0 || length(schema.children) == 0 {
        return Result.Ok(-1)
    }
    let receiver = pack_symbolic_type(context, caller, child(schema, 0), obligations, budget, depth + 1, assumptions)?
    if receiver < 0 {
        return Result.Ok(-1)
    }
    let arguments = new[Node]()
    var index = 1
    while index < length(schema.children) {
        let argument = child(schema, index)
        if argument.kind == NodeKind.Spread {
            // An unknown number of arguments cannot satisfy a fixed member
            // domain; don't materialize a width just to try the member.
            return Result.Ok(-1)
        }
        let ty = pack_symbolic_type(context, caller, argument, obligations, budget, depth + 1, assumptions)?
        if ty < 0 {
            return Result.Ok(-1)
        }
        push(arguments, meta_reference(argument, ty))
        index = index + 1
    }
    var suffix = schema.value
    var capability = -1
    if std.text.starts_with(suffix, "member#") {
        let member = match std.int.parse(slice(suffix, length("member#"), length(suffix))) {
            Result.Ok(value) => value
            Result.Err(_) => {
                return Result.Err(error(context, schema, "invalid symbolic associated member"))
            }
        }
        if member < 0 || member >= length(context.env.source.symbols) ||
        symbol(context.env, member).node.kind != NodeKind.AssociatedType {
            return Result.Err(error(context, schema, "invalid symbolic associated member"))
        }
        capability = symbol(context.env, member).owner
        suffix = concat(".", symbol(context.env, member).name)
    }
    let node = pack_node(schema, NodeKind.Type,
        concat(concat("$type#", to_text(receiver)), suffix), arguments)
    projection(context.env, pack_layout_owner(context), node, new[Int](), obligations, 0, capability)
}

fn pack_projection_scope(context Context) List[Requirement] {
    std.list.clone(context.signature.requirements)
}

fn pack_dynamic_type(context Context, caller Node, schema Node, obligations List[Requirement],
    budget List[Int], depth Int) Result[Int, Failure] {
    pack_dynamic_type(context, caller, schema, obligations, budget, depth, Option.None)
}

fn pack_dynamic_type(context Context, caller Node, schema Node, obligations List[Requirement],
    budget List[Int], depth Int, assumptions Option[List[PackLayoutRequirement]]) Result[Int, Failure] {
    if depth >= 64 || get(budget, 0) == 0 {
        return Result.Ok(-1)
    }
    let capability = match std.int.parse(slice(schema.value, length("concept#"), length(schema.value))) {
        Result.Ok(value) => value
        Result.Err(_) => {
            return Result.Err(error(context, schema, "invalid symbolic dynamic type"))
        }
    }
    let bindings = new[Node]()
    var index = 0
    while index < length(schema.children) {
        let binding = child(schema, index)
        if length(group(binding, NodeKind.TypeParameters)) > 0 {
            let scope = pack_family_scope(context, caller, obligations, budget, depth + 1, assumptions)?
            let prepared = computed_dynamic_node(scope,
                pack_node(schema, NodeKind.DynType, schema.value, source_nodes(binding)), capability)?
            push(bindings, child(prepared, 0))
        } else {
            let ty = pack_symbolic_type(context, caller, child(binding, 0), obligations, budget, depth + 1, assumptions)?
            if ty < 0 {
                return Result.Ok(-1)
            }
            let parts = source_nodes(meta_reference(child(binding, 0), ty))
            if get(context.env.types, ty).kind == TypeKind.Family {
                let members = get(context.env.concepts, concept_index(context.env, capability)).associated
                var member = 0
                while member < length(members) && symbol(context.env, get(members, member)).name != binding.value {
                    member = member + 1
                }
                if member < length(members) {
                    // A checked family identity still enters ordinary dyn
                    // validation under its declared domain. Do not resolve
                    // declaration-bound concept names in the consumer's scope.
                    let parameters = new[Node]()
                    let declared = member_parameters(context.env, get(members, member))
                    var parameter = 0
                    while parameter < length(declared) {
                        let source = get(declared, parameter)
                        push(parameters, pack_node(source, source.kind, source.value, new[Node]()))
                        parameter = parameter + 1
                    }
                    push(parts, pack_node(binding, NodeKind.TypeParameters, "", parameters))
                }
            }
            push(bindings, pack_node(binding, NodeKind.AssociatedType, binding.value, parts))
        }
        index = index + 1
    }
    dynamic_type(context.env, pack_layout_owner(context),
        pack_node(schema, NodeKind.DynType, schema.value, bindings), new[Int](), obligations, 0, capability)
}

fn pack_family_scope(context Context, caller Node, obligations List[Requirement],
    budget List[Int], depth Int) Result[Context, Failure] {
    pack_family_scope(context, caller, obligations, budget, depth, Option.None)
}

fn pack_family_scope(context Context, caller Node, obligations List[Requirement],
    budget List[Int], depth Int, assumptions Option[List[PackLayoutRequirement]]) Result[Context, Failure] {
    let base = family_header_context(context.env, pack_layout_owner(context), new[Int](), obligations)?
    var scope = Context {
        emit = false
        ..base
    }
    let parameters = group(caller, NodeKind.TypeParameters)
    let boundary = scope.head
    var index = 0
    while index < length(parameters) {
        let parameter = get(parameters, index)
        let schema = pack_node(parameter, NodeKind.Type, concat("$parameter#", to_text(index)), new[Node]())
        let ty = pack_symbolic_type(context, caller, schema, obligations, budget, depth + 1, assumptions)?
        if ty < 0 {
            return Result.Err(error(context, parameter, "symbolic family capture budget exhausted"))
        }
        scope = bind_meta(scope, parameter, meta_literal(scope, parameter, ty)?, boundary)?.context
        index = index + 1
    }
    Result.Ok(scope)
}
