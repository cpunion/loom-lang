fn flow_program(text Text) std.loom.typed.Program {
    match with_result(text) {
        Result.Ok(program) => program
        Result.Err(failed) => {
            discard write_error(failed.diagnostic.message)
            discard write_error(text)
            assert false
            flow_program("")
        }
    }
}

test fn immutable_requires_assertions_and_branch_facts_remove_construction_checks() {
    let definitions = "type Positive = Int where self > 0\ntype Bounded = Int where self >= 0 && self <= 100\n"
    let program = accepted(concat(definitions,
            "pub fn required(other Int, value Int) Positive requires other < 0 && value > 0 { discard other\nPositive(value) }\npub fn branch(value Int) Positive { if value > 0 { Positive(value) } else { Positive(1) } }\npub fn local(value Int) Bounded { let current = value\nassert current >= 0\nassert current <= 100\nBounded(current) }\npub fn negative_branch(value Int) Positive { if value <= 0 { Positive(1) } else { Positive(value) } }\npub fn outside(value Int) Bounded { if value < 0 || value > 100 { Bounded(0) } else { Bounded(value) } }"))
    assert get(get(program.functions, 0).body.children, 1).kind == ExprKind.Coerce
    assert dynamic_count(get(program.functions, 1).body, ExprKind.If) == 1
    assert get(get(program.functions, 2).body.children, 3).kind == ExprKind.Coerce
    assert dynamic_count(get(program.functions, 3).body, ExprKind.If) == 1
    assert dynamic_count(get(program.functions, 4).body, ExprKind.If) == 1
    let extra = accepted("type Positive = Int where self > 0\npub fn checked(value Int) Positive { assert value > 10\nassert value % 2 == 0\nPositive(value) }")
    assert get(get(extra.functions, 0).body.children, 2).kind == ExprKind.Coerce
}

test fn immutable_scalar_copies_preserve_established_facts() {
    let definitions = "type Positive = Int where self > 0\ntype Bounded = Int where self >= 0 && self <= 100\ntype NotPositive = Float where !(self > 0.0)\n"
    let program = accepted(concat(definitions,
            "pub fn chained(value Int) Positive requires value > 0 { let copy = value\nlet next = copy\nPositive(next) }\npub fn bounded(value Int) Bounded { assert value >= 0\nassert value <= 100\nlet copy Int = value\nBounded(copy) }\npub fn branch(value Int) Positive { if value > 0 { let value = value\nPositive(value) } else { Positive(1) } }\npub fn exact(value Float) NotPositive { assert !(value > 0.0)\nlet copy = value\nNotPositive(copy) }"))
    assert get(get(program.functions, 0).body.children, 2).kind == ExprKind.Coerce
    assert get(get(program.functions, 1).body.children, 3).kind == ExprKind.Coerce
    assert dynamic_count(get(program.functions, 2).body, ExprKind.If) == 1
    assert get(get(program.functions, 3).body.children, 2).kind == ExprKind.Coerce
}

test fn scalar_copy_facts_preserve_identity_without_guessing_mutability_or_aliases() {
    let definitions = """
        import std.result.Result
        import std.result.ConstraintError
        type Positive = Int where self > 0
        type NonPositive = Float where self <= 0.0
        record Box { value Int }

        """
    let program = flow_program(concat(definitions,
            """
        pub fn mutable_source(value Int) Result[Positive, ConstraintError] { var current = value
        assert current > 0
        let copy = current
        Positive(copy) }
        pub fn mutable_copy(value Int) Result[Positive, ConstraintError] { assert value > 0
        var copy = value
        copy = 0
        Positive(copy) }
        pub fn shared(box Box) Result[Positive, ConstraintError] { assert box.value > 0
        let copy = box.value
        Positive(copy) }
        pub fn later(value Int) Positive { let copy = value
        assert value > 0
        Positive(copy) }
        pub fn complement(value Float) Result[NonPositive, ConstraintError] { assert !(value > 0.0)
        let copy = value
        NonPositive(copy) }
        """))
    var index = 0
    while index < length(program.functions) {
        let body = get(program.functions, index).body
        assert get(body.children, length(body.children) - 1).kind == (if index == 3 {
                ExprKind.Coerce
            } else {
                ExprKind.Block
            })
        index = index + 1
    }
}

test fn exiting_if_branches_establish_only_the_surviving_guard() {
    let definitions = "type Positive = Int where self > 0\ntype Bounded = Int where self >= 0 && self <= 100\ntype NotPositive = Float where !(self > 0.0)\n"
    let program = accepted(concat(definitions,
            "pub fn early(value Int) Positive { if value <= 0 { return Positive(1) }\nlet copy = value\nPositive(copy) }\npub fn alternate(value Int) Positive { if value > 0 {} else { return Positive(1) }\nPositive(value) }\npub fn bounded(value Int) Bounded { if value < 0 { return Bounded(0) }\nif value > 100 { return Bounded(100) }\nBounded(value) }\npub fn exact(value Float) NotPositive { if value > 0.0 { return NotPositive(0.0) }\nNotPositive(value) }\npub fn breaking(value Int) Positive { while true { if value <= 0 { break }\nreturn Positive(value) }\nPositive(1) }\npub fn continuing(value Int) { var count = 0\nwhile count < 1 { count = count + 1\nif value <= 0 { continue }\ndiscard Positive(value) } }"))
    var index = 0
    while index < length(program.functions) {
        assert dynamic_count(get(program.functions, index).body, ExprKind.If) == (if index == 2 {
                2
            } else {
                1
            })
        index = index + 1
    }
}

test fn exit_guards_do_not_invent_join_alias_or_nan_evidence() {
    let definitions = "import std.result.Result\nimport std.result.ConstraintError\ntype Positive = Int where self > 0\ntype NonPositive = Float where self <= 0.0\nrecord Box { value Int }\n"
    let program = flow_program(concat(definitions,
            "pub fn joined(value Int) Result[Positive, ConstraintError] { if value <= 0 {}\nPositive(value) }\npub fn mutable(value Int) Result[Positive, ConstraintError] { var current = value\nif current <= 0 { return Result.Ok(Positive(1)) }\ncurrent = 0\nPositive(current) }\npub fn shared(box Box) Result[Positive, ConstraintError] { if box.value <= 0 { return Result.Ok(Positive(1)) }\nPositive(box.value) }\npub fn either(value Int, other Int) Result[Positive, ConstraintError] { if value <= 0 && other <= 0 { return Result.Ok(Positive(1)) }\nPositive(value) }\npub fn complement(value Float) Result[NonPositive, ConstraintError] { if value > 0.0 { return Result.Ok(NonPositive(0.0)) }\nNonPositive(value) }\npub fn cleanup(value Int) Result[Positive, ConstraintError] { defer { assert value > 0 }\nif value <= 0 {} else { return Result.Ok(Positive(1)) }\nPositive(value) }"))
    var index = 0
    while index < length(program.functions) {
        assert dynamic_count(get(program.functions, index).body, ExprKind.If) == 2
        index = index + 1
    }
}

test fn mutable_shared_and_unrelated_bindings_do_not_supply_flow_facts() {
    let definitions = """
        import std.result.Result
        import std.result.ConstraintError
        type Positive = Int where self > 0
        record Box { value Int }

        """
    let program = flow_program(concat(definitions,
            """
        pub fn mutable(value Int) Result[Positive, ConstraintError] { var current = value
        assert current > 0
        current = 0
        Positive(current) }
        pub fn joined(value Int) Result[Positive, ConstraintError] { if value > 0 { discard Positive(value) }
        Positive(value) }
        pub fn multiple(value Int, other Int) Positive { assert value > other && other >= 0
        Positive(value) }
        pub fn fields(box Box) Result[Positive, ConstraintError] { assert box.value > 0
        Positive(box.value) }
        pub fn shadowed(value Int, other Int, flag Bool) Result[Positive, ConstraintError] { assert value > 0
        if flag { let value = other
        Positive(value) } else { Positive(other) } }
        pub fn sibling(value Int, flag Bool) Result[Positive, ConstraintError] { if flag { assert value > 0
        Result.Ok(Positive(value)) } else { Positive(value) } }
        pub fn disjunction(value Int, other Int) Result[Positive, ConstraintError] { if value > 0 || other > 0 { Positive(value) } else { Positive(other) } }
        """))
    var index = 0
    while index < 4 {
        let body = get(program.functions, index).body
        assert get(body.children, length(body.children) - 1).kind == (if index == 2 {
                ExprKind.Coerce
            } else {
                ExprKind.Block
            })
        index = index + 1
    }
    assert dynamic_count(get(program.functions, 4).body, ExprKind.If) == 3
    assert dynamic_count(get(program.functions, 5).body, ExprKind.If) == 2
    assert dynamic_count(get(program.functions, 6).body, ExprKind.If) == 3
}

test fn float_facts_reuse_exact_predicates_without_complement_arithmetic() {
    let definitions = "import std.result.Result\nimport std.result.ConstraintError\ntype NotPositive = Float where !(self > 0.0)\ntype NonPositive = Float where self <= 0.0\ntype NotANumber = Float where self != self\n"
    let program = flow_program(concat(definitions,
            "pub fn exact(value Float) NotPositive { if value > 0.0 { NotPositive(0.0) } else { NotPositive(value) } }\npub fn nan(value Float) NotANumber { assert value != value\nNotANumber(value) }\npub fn complement(value Float) Result[NonPositive, ConstraintError] { assert !(value > 0.0)\nNonPositive(value) }"))
    assert dynamic_count(get(program.functions, 0).body, ExprKind.If) == 1
    assert get(get(program.functions, 1).body.children, 1).kind == ExprKind.Coerce
    assert get(get(program.functions, 2).body.children, 1).kind == ExprKind.Block
    let compound = accepted("type Middle = Float where !(self > 0.0 || self < -10.0)\npub fn exact(value Float) Middle { assert !(value > 0.0 || value < -10.0)\nMiddle(value) }")
    assert get(get(compound.functions, 0).body.children, 1).kind == ExprKind.Coerce
}

test fn flow_proofs_require_defined_goals_and_evaluated_short_circuit_terms() {
    let definitions = "import std.result.Result\nimport std.result.ConstraintError\ntype Increment = Int where self + 1 > self\ntype Quotient = Int where 10 / self > 0\n"
    let program = flow_program(concat(definitions,
            "pub fn safe(value Int) Increment requires value < 9223372036854775807 { Increment(value) }\npub fn overflow(value Int) Result[Increment, ConstraintError] { assert value >= 0\nIncrement(value) }\npub fn skipped(value Int) Result[Quotient, ConstraintError] { assert value == 0 || 10 / value > 0\nQuotient(value) }"))
    assert get(get(program.functions, 0).body.children, 0).kind == ExprKind.Coerce
    assert get(get(program.functions, 1).body.children, 1).kind == ExprKind.Block
    assert get(get(program.functions, 2).body.children, 1).kind == ExprKind.Block
}

test fn immutable_facts_remain_scoped_through_loops_defer_and_staging() {
    let definitions = "import std.result.Result\nimport std.result.ConstraintError\ntype Positive = Int where self > 0\n"
    let program = flow_program(concat(definitions,
            "pub fn cleanup(value Int) { assert value > 0\ndefer { discard Positive(value) } }\npub fn changed(value Int) { var current = value\nassert current > 0\ndefer { discard Positive(current) }\ncurrent = 0 }\npub fn loop_scope(value Int) Result[Positive, ConstraintError] { var count = 0\nwhile count < 1 { assert value > 0\ndiscard Positive(value)\ncount = count + 1 }\nPositive(value) }\npub fn loop_guard(value Int) Positive { while value > 0 { return Positive(value) }\nPositive(1) }\npub fn future_assertion(value Int) Result[Positive, ConstraintError] { defer { assert value > 0 }\nPositive(value) }"))
    assert dynamic_count(get(program.functions, 0).body, ExprKind.If) == 0
    // The same cleanup body is retained at registration and normal invocation.
    assert dynamic_count(get(program.functions, 1).body, ExprKind.If) == 2
    assert dynamic_count(get(program.functions, 2).body, ExprKind.If) == 1
    assert dynamic_count(get(program.functions, 3).body, ExprKind.If) == 0
    assert dynamic_count(get(program.functions, 4).body, ExprKind.If) == 1
    rejects_result(concat(definitions, "fn invalid(value Int) { assert value > 0\ndiscard comptime { Positive(value) } }"))
}
