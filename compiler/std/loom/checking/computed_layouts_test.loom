fn computed_layout_source() Text {
    """
        concept Family {
            type Item[U]
        }
        fn identity_type[T]() type {
            T
        }
        concept Pass {
            type Out
            fn pass(self Self, value Self.Out) Self.Out
        }
        impl[Ts...] Pass for (Ts...) {
            type Out = dyn Family[Item[U] = (comptime { identity_type[Self]() }, U)]
            fn pass(self Self, value dyn Family[Item[V] = ((Ts...), V)])
                dyn Family[Item[W] = ((Ts...), W)] {
                discard self
                value
            }
        }
        """
}

test fn computed_layouts_preserve_the_complete_input_type() {
    discard accepted(computed_layout_source())
    discard accepted(std.text.replace(computed_layout_source(), "identity_type[Self]()", "identity_type[(Ts...)]()"))
    rejects(std.text.replace(computed_layout_source(), "identity_type[Self]()", "identity_type[Ts]()"))
    rejects(std.text.replace(computed_layout_source(), "identity_type[Self]()", "identity_type[(Bool, Ts...)]()"))
    discard accepted(std.text.replace(std.text.replace(std.text.replace(computed_layout_source(),
                    "fn identity_type[T]()", "fn identity_type[T, Same]()"),
                "identity_type[Self]()", "identity_type[Self, (Ts...)]()"),
            "\n    T\n", "\n    if T == Same { T } else { Int }\n"))
}

test fn computed_layouts_compose_constructors_and_lexical_captures() {
    let source = std.text.replace(computed_layout_source(), "identity_type[Self]()", "identity_type[(Ts..., U)]()")
    discard accepted(std.text.replace(std.text.replace(source, "((Ts...), V)", "((Ts..., V), V)"),
            "((Ts...), W)", "((Ts..., W), W)"))
    let wrapped = concat("""
            record Box[T] {
                value T
            }
            """, std.text.replace(std.text.replace(std.text.replace(computed_layout_source(),
                    "\n    T\n", "\n    Box[List[T]]\n"),
                "((Ts...), V)", "(Box[List[(Ts...)]], V)"),
            "((Ts...), W)", "(Box[List[(Ts...)]], W)"))
    discard accepted(wrapped)
    let callable = std.text.replace(std.text.replace(std.text.replace(computed_layout_source(),
                "identity_type[Self]()", "identity_type[fn(Ts...) U]()"),
            "((Ts...), V)", "(fn(Ts...) V, V)"),
        "((Ts...), W)", "(fn(Ts...) W, W)")
    discard accepted(callable)
    let nested = std.text.replace(std.text.replace(std.text.replace(computed_layout_source(),
                "\n    T\n", "\n    dyn Family[Item[X] = (T, X)]\n"),
            "((Ts...), V)", "(dyn Family[Item[X] = ((Ts...), X)], V)"),
        "((Ts...), W)", "(dyn Family[Item[X] = ((Ts...), X)], W)")
    discard accepted(nested)
}

test fn computed_layouts_reuse_only_proved_whole_type_requirements() {
    let source = concat("""
            concept Tagged {}
            impl[Us... Tagged] Tagged for (Us...) {}
            """, std.text.replace(computed_layout_source(), "fn identity_type[T]()", "fn identity_type[T Tagged]()"))
    rejects(source)
    discard accepted(std.text.replace(source, "impl[Ts...] Pass", "impl[Ts... Tagged] Pass"))
    let hidden = concat("""
            concept Tagged {}
            impl[Us... Tagged] Tagged for (Us...) {}
            record Bounded[T Tagged] {
                value T
            }
            """, std.text.replace(std.text.replace(std.text.replace(std.text.replace(computed_layout_source(),
                        "identity_type[Self]()", "identity_type[Bounded[(Ts...)]]()"),
                    "\n    T\n", "\n    Int\n"),
                "((Ts...), V)", "(Int, V)"), "((Ts...), W)", "(Int, W)"))
    rejects(hidden)
}

test fn computed_layouts_separate_whole_captures_from_selected_element_widths() {
    let source = std.text.replace(std.text.replace(std.text.replace(computed_layout_source(),
                "(comptime { identity_type[Self]() }, U)", "(comptime { identity_type[((Ts...), Ts)]() }..., U)"),
            "((Ts...), V)", "(((Ts...), Ts)..., V)"),
        "((Ts...), W)", "(((Ts...), Ts)..., W)")
    discard accepted(source)
    discard accepted(std.text.replace(source, "((Ts...), Ts)", "(Ts..., Ts)"))
    let bounded = concat("""
            concept Tagged {}
            impl[Us... Tagged] Tagged for (Us...) {}
            """, std.text.replace(std.text.replace(source, "fn identity_type[T]()", "fn identity_type[T Tagged]()"),
            "impl[Ts...] Pass", "impl[Ts... Tagged] Pass"))
    discard accepted(bounded)
    let independent = concat("""
            record Pair[As..., Bs...] {
                first (As...)
                second (Bs...)
            }
            """, std.text.replace(std.text.replace(source,
                "impl[Ts...] Pass for (Ts...)", "impl[As..., Bs...] Pass for Pair[(As...)..., (Bs...)...]"),
            "((Ts...), Ts)", "((As...), Bs)"))
    discard accepted(independent)
    let erased = std.text.replace(std.text.replace(std.text.replace(independent,
                "\n    T\n", "\n    Int\n"),
            "(((As...), Bs)..., V)", "(comptime { identity_type[Bs]() }..., V)"),
        "(((As...), Bs)..., W)", "(comptime { identity_type[Bs]() }..., W)")
    discard accepted(erased)
    rejects(std.text.replace(erased, "identity_type[Bs]()", "identity_type[As]()"))
}

test fn computed_layouts_keep_independent_nominal_words_distinct() {
    let target = "Pair[(As...)..., (Bs...)...]"
    let source = concat("""
            record Pair[As..., Bs...] {
                first (As...)
                second (Bs...)
            }
            """, std.text.replace(std.text.replace(std.text.replace(computed_layout_source(),
                    "impl[Ts...] Pass for (Ts...)", concat("impl[As..., Bs...] Pass for ", target)),
                "((Ts...), V)", concat(concat("(", target), ", V)")),
            "((Ts...), W)", concat(concat("(", target), ", W)")))
    discard accepted(source)
    discard accepted(std.text.replace(source, "identity_type[Self]()", concat(concat("identity_type[", target), "]()")))
    rejects(std.text.replace(source, "identity_type[Self]()", "identity_type[Pair[(Bs...)..., (As...)...]]()"))
}

test fn computed_layouts_keep_unknown_decisions_unproved() {
    let source = computed_layout_source()
    discard accepted(std.text.replace(source, "\n    T\n", "\n    if T == T { T } else { Bool }\n"))
    rejects(std.text.replace(source, "\n    T\n", "\n    if T == Int { Bool } else { T }\n"))
    let reflected_source = std.text.replace(source, "\n    T\n",
        "\n    if describe[T]().types[0].kind == Kind.Opaque { T } else { Bool }\n")
    assert match reflected(reflected_source) {
        Result.Err(failed) => std.text.contains(failed.diagnostic.message, "uniform symbolic type template")
        Result.Ok(_) => false
    }
}

test fn computed_layouts_respect_lexical_type_value_shadowing() {
    discard accepted(std.text.replace(computed_layout_source(), "identity_type[Self]()",
            "let Whole = Self\nidentity_type[Whole]()"))
    let source = std.text.replace(computed_layout_source(), "identity_type[Self]()",
        "let Self = Int\nidentity_type[Self]()")
    rejects(source)
    discard accepted(std.text.replace(std.text.replace(source, "((Ts...), V)", "(Int, V)"),
            "((Ts...), W)", "(Int, W)"))
    rejects(std.text.replace(computed_layout_source(), "identity_type[Self]()",
            "let Self = Int\nidentity_type[(Self, Ts...)]()"))
}

test fn computed_layouts_compose_after_local_bindings_without_rebinding_them() {
    discard accepted(std.text.replace(computed_layout_source(), "identity_type[Self]()",
            "let Marker = Bool\nidentity_type[(Ts...)]()"))
    let local = std.text.replace(std.text.replace(std.text.replace(computed_layout_source(),
                "identity_type[Self]()", "let Suffix = List[U]\nidentity_type[((Ts...), Suffix)]()"),
            "((Ts...), V)", "(((Ts...), List[V]), V)"),
        "((Ts...), W)", "(((Ts...), List[W]), W)")
    discard accepted(local)
    rejects(std.text.replace(local, "let Suffix = List[U]", "let Suffix = Bool"))
    let shadowed = concat("""
            record Box[T] {
                value T
            }
            """, std.text.replace(std.text.replace(std.text.replace(computed_layout_source(),
                    "identity_type[Self]()", "let Box = 7\nidentity_type[Box[(Ts...)]]()"),
                "((Ts...), V)", "(Box[(Ts...)], V)"),
            "((Ts...), W)", "(Box[(Ts...)], W)"))
    discard accepted(shadowed)
    rejects(std.text.replace(shadowed, "let Box = 7", "let Box = Int"))
    let callback = concat("""
            fn choose() Bool {
                true
            }
            """, std.text.replace(computed_layout_source(), "identity_type[Self]()", """
            let Whole = Self
            let choose = fn() Bool {
                false
            }
            comptime if choose() {
                Bool
            } else {
                identity_type[Whole]()
            }
            """))
    // Inner staging cannot capture this callback. In particular, its spelling
    // must not silently select the same-named global and make Bool acceptable.
    assert match checked(source_files(callback)) {
        Result.Err(failed) => std.text.contains(failed.diagnostic.message, "runtime binding")
        Result.Ok(_) => false
    }
    let wrong_global = std.text.replace(std.text.replace(callback, "((Ts...), V)", "(Bool, V)"),
        "((Ts...), W)", "(Bool, W)")
    assert match checked(source_files(wrong_global)) {
        Result.Err(failed) => std.text.contains(failed.diagnostic.message, "runtime binding")
        Result.Ok(_) => false
    }
}

fn computed_local_word_source() Text {
    std.text.replace(std.text.replace(std.text.replace(computed_layout_source(),
                "identity_type[Self]()", "let Suffix = List[U]\nidentity_type[(Ts..., Suffix)]()"),
            "((Ts...), V)", "((Ts..., List[V]), V)"),
        "((Ts...), W)", "((Ts..., List[W]), W)")
}

test fn computed_layouts_assemble_words_with_checked_local_type_values() {
    let source = computed_local_word_source()
    discard accepted(source)
    rejects(std.text.replace(source, "let Suffix = List[U]", "let Suffix = Bool"))
    rejects(std.text.replace(source, "identity_type[(Ts..., Suffix)]()", "identity_type[Ts]()"))
    rejects(std.text.replace(source, "let Suffix =", "let Ts = Bool\nlet Suffix ="))
    let callable = std.text.replace(std.text.replace(std.text.replace(source,
                "identity_type[(Ts..., Suffix)]()", "identity_type[fn(Ts..., Suffix) U]()"),
            "((Ts..., List[V]), V)", "(fn(Ts..., List[V]) V, V)"),
        "((Ts..., List[W]), W)", "(fn(Ts..., List[W]) W, W)")
    discard accepted(callable)
    let nominal = concat("""
            record Batch[As...] {
                values (As...)
            }
            """, std.text.replace(std.text.replace(std.text.replace(source,
                    "identity_type[(Ts..., Suffix)]()", "identity_type[Batch[Ts..., Suffix]]()"),
                "((Ts..., List[V]), V)", "(Batch[Ts..., List[V]], V)"),
            "((Ts..., List[W]), W)", "(Batch[Ts..., List[W]], W)"))
    discard accepted(nominal)
    rejects(std.text.replace(source, "\n    T\n", "\n    if T == Int { Bool } else { T }\n"))
    let bounded = concat("""
            concept Tagged {}
            impl[Us... Tagged] Tagged for (Us...) {}
            impl[V] Tagged for List[V] {}
            """, std.text.replace(source, "fn identity_type[T]()", "fn identity_type[T Tagged]()"))
    rejects(bounded)
    discard accepted(std.text.replace(bounded, "impl[Ts...] Pass", "impl[Ts... Tagged] Pass"))
    assert match reflected(std.text.replace(source, "\n    T\n",
            "\n    if describe[T]().types[0].kind == Kind.Opaque { T } else { Bool }\n")) {
        Result.Err(failed) => std.text.contains(failed.diagnostic.message, "uniform symbolic type template")
        Result.Ok(_) => false
    }
}

test fn computed_layouts_preserve_lexical_inputs_across_local_pure_functions() {
    let source = std.text.replace(computed_local_word_source(), "identity_type[(Ts..., Suffix)]()", """
        let assemble = fn() type {
            let Captured = Suffix
            identity_type[(Ts..., Captured)]()
        }
        assemble()
        """)
    discard accepted(source)
    let direct = std.text.replace(std.text.replace(std.text.replace(std.text.replace(source,
                    "(comptime {", "comptime {"), "}, U)]", "}]"),
            "((Ts..., List[V]), V)", "(Ts..., List[V])"),
        "((Ts..., List[W]), W)", "(Ts..., List[W])")
    discard accepted(direct)
    discard accepted(concat(direct, """
        impl Family for Bool {
            type Item[U] = (Int, List[U])
        }
        impl Family for Int {
            type Item[U] = (Bool, List[U])
        }
        fn main() {
            discard (7,).pass(true)
            discard (false,).pass(1)
            discard (8,).pass(true)
        }
        """))
    discard accepted(std.text.replace(direct, "type Item[U]", """
        type Item[U]
        fn echo[U](self Self, value Self.Item[U]) Self.Item[U]
        """))
    let nested = std.text.replace(source, "let Captured = Suffix\n    identity_type[(Ts..., Captured)]()", """
        let Captured = Suffix
        let inner = fn() type {
            identity_type[(Ts..., Captured)]()
        }
        inner()
        """)
    assert nested != source
    discard accepted(nested)
    rejects(std.text.replace(source, "let Captured = Suffix", "let Ts = Bool\nlet Captured = Suffix"))
    rejects(std.text.replace(source, "identity_type[(Ts..., Captured)]()", "identity_type[Ts]()"))
    let named = concat("record Ts {}\n", source)
    discard accepted(named)
    assert match checked(source_files(std.text.replace(named,
                "identity_type[(Ts..., Captured)]()", "identity_type[Ts]()"))) {
        Result.Err(failed) => std.text.contains(failed.diagnostic.message, "expand a type pack")
        Result.Ok(_) => false
    }
    let independent = std.text.replace(computed_independent_local_source(),
        "identity_type[(As..., Suffix, Bs...)]()", """
        let assemble = fn() type {
            let Captured = Suffix
            let Second = identity_type[(Bs...)]()
            discard Second
            identity_type[(As..., Captured, Bs...)]()
        }
        assemble()
        """)
    discard accepted(independent)
    rejects(std.text.replace(independent, "(As..., Captured, Bs...)", "(Bs..., Captured, As...)"))
}

test fn computed_layouts_preserve_captured_element_origins_after_input_erasure() {
    let source = std.text.replace(std.text.replace(std.text.replace(std.text.replace(
                    computed_independent_local_source(),
                    "let Suffix = List[U]\nidentity_type[(As..., Suffix, Bs...)]()", """
                    let assemble = fn() type {
                        let Suffix = Bs
                        identity_type[(As..., Suffix)]()
                    }
                    assemble()
                    """), "}, U)]", "}..., U)]"),
            "((As..., List[V], Bs...), V)", "((As..., Bs)..., V)"),
        "((As..., List[W], Bs...), W)", "((As..., Bs)..., W)")
    discard accepted(source)
    rejects(std.text.replace(source, "(As..., Bs)...", "(Bs..., As)..."))
    let erased = std.text.replace(std.text.replace(source, "\n    T\n", "\n    Int\n"),
        "(As..., Bs)...", "comptime { identity_type[Bs]() }...")
    discard accepted(erased)
    rejects(std.text.replace(erased, "identity_type[Bs]()", "identity_type[As]()"))
}

fn computed_independent_local_source() Text {
    concat("""
            record Pair[As..., Bs...] {
                first (As...)
                second (Bs...)
            }
            """, std.text.replace(std.text.replace(std.text.replace(std.text.replace(computed_local_word_source(),
                        "impl[Ts...] Pass for (Ts...)", "impl[As..., Bs...] Pass for Pair[(As...)..., (Bs...)...]"),
                    "(Ts..., Suffix)", "(As..., Suffix, Bs...)"),
                "(Ts..., List[V])", "(As..., List[V], Bs...)"),
            "(Ts..., List[W])", "(As..., List[W], Bs...)"))
}

test fn computed_layouts_assemble_independent_words_and_nested_local_families() {
    let independent = computed_independent_local_source()
    discard accepted(independent)
    rejects(std.text.replace(independent, "(As..., Suffix, Bs...)", "(Bs..., Suffix, As...)"))
    let nested = std.text.replace(std.text.replace(std.text.replace(computed_local_word_source(),
                "let Suffix = List[U]", "let Suffix = dyn Family[Item[Ts] = (U, Ts)]"),
            "List[V]", "dyn Family[Item[X] = (V, X)]"),
        "List[W]", "dyn Family[Item[X] = (W, X)]")
    discard accepted(nested)
}

test fn computed_layouts_keep_selected_widths_through_local_type_values() {
    let source = std.text.replace(std.text.replace(std.text.replace(std.text.replace(
                    std.text.replace(computed_independent_local_source(), "}, U)]", "}..., U)]"),
                    "let Suffix = List[U]", "let Suffix = List[Bs]"),
                "(As..., Suffix, Bs...)", "(As..., Suffix)"),
            "((As..., List[V], Bs...), V)", "((As..., List[Bs])..., V)"),
        "((As..., List[W], Bs...), W)", "((As..., List[Bs])..., W)")
    discard accepted(source)
    rejects(std.text.replace(source, "(As..., List[Bs])...", "(Bs..., List[As])..."))
    let guarded = std.text.replace(source, "let Suffix = List[Bs]\nidentity_type[(As..., Suffix)]()", """
        let Gate = Bool
        comptime if Gate == Bool {
            let Suffix = List[Bs]
            identity_type[(As..., Suffix)]()
        } else {
            Missing
        }
        """)
    assert guarded != source
    discard accepted(guarded)
    discard accepted(std.text.replace(guarded, "List[Bs]", "Bs"))
    let captured = std.text.replace(std.text.replace(std.text.replace(computed_layout_source(),
                "(comptime { identity_type[Self]() }, U)", """
                (comptime {
                    let Gate = Bool
                    comptime if Gate == Bool {
                        let Suffix = Ts
                        identity_type[((Ts...), Suffix)]()
                    } else {
                        Missing
                    }
                }..., U)
                """),
            "((Ts...), V)", "(((Ts...), Ts)..., V)"),
        "((Ts...), W)", "(((Ts...), Ts)..., W)")
    discard accepted(captured)
    let erased = std.text.replace(std.text.replace(std.text.replace(guarded,
                "\n    T\n", "\n    Int\n"),
            "identity_type[(As..., Suffix)]()", "identity_type[Suffix]()"),
        "(As..., List[Bs])...", "comptime { identity_type[Bs]() }...")
    discard accepted(erased)
    rejects(std.text.replace(erased, "identity_type[Bs]()", "identity_type[As]()"))
}

test fn computed_layouts_resolve_only_the_selected_static_branch() {
    let source = std.text.replace(computed_layout_source(), "comptime { identity_type[Self]() }",
        "comptime if true { identity_type[Self]() } else { Missing[(Ts...)] }")
    discard accepted(source)
    discard accepted(std.text.replace(source, "if true", "if true || Missing[(Ts...)] == Int"))
    discard accepted(std.text.replace(std.text.replace(source,
                "if true", "if false && Missing[(Ts...)] == Int"),
            "{ identity_type[Self]() } else { Missing[(Ts...)] }", "{ Missing[(Ts...)] } else { identity_type[Self]() }"))
    discard accepted(std.text.replace(source,
            "if true { identity_type[Self]() } else { Missing[(Ts...)] }",
            "if false { Missing[(Ts...)] } else { identity_type[Self]() }"))
    rejects(std.text.replace(source, "if true", "if U == Int"))
    rejects(std.text.replace(source, "if true", "if Ts == Ts"))
    let bounded = concat("concept Source {}\n", std.text.replace(std.text.replace(source,
                "type Item[U]", "type Item[U Source]"), "if true", "if U implements Source"))
    discard accepted(bounded)
    let independent = concat("""
            record Pair[As..., Bs...] {
                first (As...)
                second (Bs...)
            }
            """, std.text.replace(std.text.replace(std.text.replace(std.text.replace(computed_layout_source(),
                        "impl[Ts...] Pass for (Ts...)", "impl[As..., Bs...] Pass for Pair[(As...)..., (Bs...)...]"),
                    "(comptime { identity_type[Self]() }, U)",
                    "(comptime if true { identity_type[As]() } else { identity_type[Bs]() }..., U)"),
                "((Ts...), V)", "(As..., V)"), "((Ts...), W)", "(As..., W)"))
    discard accepted(independent)
    rejects(std.text.replace(std.text.replace(independent, "(As..., V)", "(Bs..., V)"),
            "(As..., W)", "(Bs..., W)"))
}
