import std.loom.ast.Node
import std.loom.typed.Expr
import std.loom.typed.ExprKind
import std.loom.typed.TypeKind
import std.list.new
import std.list.get
import std.list.push
import std.list.length
import std.result.Result

fn list_literal(context Context, node Node, expected Int) Result[Expr, Failure] {
    var element = -1
    if expected >= 0 {
        let shape = get(context.env.types, expected)
        if shape.kind == TypeKind.List {
            element = get(shape.arguments, 0)
        }
    }
    let values = new[Expr]()
    var index = 0
    while index < length(node.children) {
        let source = child(node, index)
        let value = expr(context, source, element)?
        if value.ty == 0 {
            return Result.Err(error(context, source, "list elements must produce a value"))
        }
        if element < 0 {
            element = value.ty
        }
        push(values, value)
        index = index + 1
    }
    if element < 0 {
        return Result.Err(error(context, node, "an empty list needs a List[T] context"))
    }
    if type_depth(context.env, element) >= 64 {
        return Result.Err(error(context, node, "type specialization depth exceeded; expansion must be finite"))
    }
    let ty = intern(context.env, TypeKind.List, -1, ints(element))
    Result.Ok(expression(ExprKind.List, ty, node, "", -1, values, all_fall(values)))
}
