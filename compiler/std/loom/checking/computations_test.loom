import std.loom.ast.NodeKind
import std.list.get
import std.list.set
import std.result.Result

test fn computation_reuse_preserves_expected_types_and_shadowing_checks() {
    let files = source_files("enum Maybe[T] { None Some(T) }\nfn main() {\nlet ints Maybe[Int] = comptime { Maybe.None }\nlet bools Maybe[Bool] = comptime { Maybe.None }\ndiscard ints\ndiscard bools\n}")
    let statements = group(child(get(files, 0).tree, 1), NodeKind.Block)
    // Both computations now have exactly the same AST and spans. Only their
    // surrounding expected types differ; source-location keys cannot help.
    set(get(statements, 1).children, 1, child(get(statements, 0), 1))
    match checked(files) {
        Result.Ok(program) => {
            let locals = get(program.functions, program.entry).locals
            let ints = get(program.types, get(locals, 0).ty)
            let bools = get(program.types, get(locals, 1).ty)
            assert ints.symbol == bools.symbol
            assert get(locals, 0).ty != get(locals, 1).ty
            assert get(ints.arguments, 0) == 1 && get(bools.arguments, 0) == 2
        }
        Result.Err(_) => { assert false }
    }

    let shadowed = source_files("fn f() Int { 1 }\nfn main() {\nlet first Int = comptime { f() }\nlet f = 0\nlet second Int = comptime { f() }\ndiscard first\ndiscard f\ndiscard second\n}")
    let body = group(child(get(shadowed, 0).tree, 1), NodeKind.Block)
    set(get(body, 2).children, 1, child(get(body, 0), 1))
    match checked(shadowed) {
        Result.Err(failure) => {
            assert failure.source == 0
            assert failure.diagnostic.message == "a local value is not callable"
        }
        Result.Ok(_) => { assert false }
    }
}
