import std.loom.typed.Expr
import std.loom.typed.ExprKind
import std.loom.typed.Function
import std.loom.typed.TypeKind
import std.loom.source.Diagnostic
import std.loom.binding.Failure
import std.list.new
import std.list.get
import std.list.push
import std.list.set
import std.list.length
import std.result.Result

// Task handles are one-shot, without introducing source ownership syntax.
// Locals transfer on reads: 0 consumed, 1 live, 2 pending comptime selection,
// 3 a Task leaf borrowed through a MustScope parameter or match binding.
// State 2 is check-only uncertainty, never evidence of a valid transfer.
// Concrete instances contain no pending selections and still require exact joins.
record TaskFlow {
    context Context
    locals List[Int]
    // Flat Task leaves per local; no fixed tuple-size or machine-word limit.
    offsets List[Int]
    // Task obligations and NoSuspend operands awaiting their enclosing operation.
    pending List[Int]
    no_suspend Int
    loop_entry List[Int]
    loop_exits List[List[Int]]
    loop_pending Int
    cleanup Bool
}

fn task_error(flow TaskFlow, value Expr, message Text) Failure {
    Failure {
        source = symbol(flow.context.env, flow.context.signature.symbol).file
        diagnostic = Diagnostic {
            span = value.span
            message = message
        }
    }
}

fn task_states(values List[Int]) List[Int] {
    let copy = new[Int]()
    var index = 0
    while index < length(values) {
        push(copy, get(values, index))
        index = index + 1
    }
    copy
}

fn task_branch(flow TaskFlow) TaskFlow {
    task_branch(flow, flow.loop_exits)
}

fn task_branch(flow TaskFlow, exits List[List[Int]]) TaskFlow {
    TaskFlow {
        context = flow.context
        locals = task_states(flow.locals)
        offsets = flow.offsets
        pending = task_states(flow.pending)
        no_suspend = flow.no_suspend
        loop_entry = flow.loop_entry
        loop_exits = exits
        loop_pending = flow.loop_pending
        cleanup = flow.cleanup
    }
}

fn task_join(flow TaskFlow, branch TaskFlow) {
    var index = 0
    while index < length(flow.locals) {
        set(flow.locals, index, get(branch.locals, index))
        index = index + 1
    }
    set(flow.pending, 0, get(branch.pending, 0))
    set(flow.pending, 1, get(branch.pending, 1))
}

fn compatible_task_states(left List[Int], right List[Int]) Bool {
    var index = 0
    while index < length(left) {
        // Read-only bindings carry no owned obligation and can leave a scope.
        // They must never agree with an owned/live leaf, however.
        let left_state = get(left, index)
        let right_state = get(right, index)
        let a = if left_state == 3 { 0 } else { left_state }
        let b = if right_state == 3 { 0 } else { right_state }
        if a != b && a != 2 && b != 2 { return false }
        index = index + 1
    }
    true
}

fn merge_task_states(left List[Int], right List[Int]) {
    var index = 0
    while index < length(left) {
        if get(right, index) == 2 { set(left, index, 2) }
        index = index + 1
    }
}

fn compatible_task_state(left TaskFlow, right TaskFlow) Bool {
    compatible_task_states(left.locals, right.locals) && get(left.pending, 0) == get(right.pending, 0)
}

fn tasks_consumed(flow TaskFlow, value Expr) Result[Bool, Failure] {
    if get(flow.pending, 0) != 0 {
        return Result.Err(task_error(flow, value, "a task argument is still pending; finish its call before returning"))
    }
    var index = 0
    while index < length(flow.locals) {
        if get(flow.locals, index) == 1 {
            return Result.Err(task_error(flow, value, "a task is still live at function exit; await or transfer it before returning"))
        }
        index = index + 1
    }
    Result.Ok(true)
}

fn task_sequence(flow TaskFlow, values List[Expr], allowed Bool) Result[Bool, Failure] {
    task_sequence(flow, values, allowed, false)
}

fn task_sequence(flow TaskFlow, values List[Expr], allowed Bool, borrowing Bool) Result[Bool, Failure] {
    var index = 0
    var task = false
    while index < length(values) {
        let value = get(values, index)
        task = task_expression(flow, value, allowed && index + 1 == length(values), borrowing && index + 1 == length(values))?
        if !value.falls {
            return Result.Ok(false)
        }
        index = index + 1
    }
    Result.Ok(task)
}

// Earlier argument values remain our obligations until the actual call. An
// exit while evaluating a later argument must not silently abandon them.
fn task_arguments(flow TaskFlow, value Expr) Result[Bool, Failure] {
    let before = get(flow.pending, 0)
    let suspended = get(flow.pending, 1)
    var index = 0
    while index < length(value.children) {
        let argument = if value.kind == ExprKind.Record {
            get(get(value.children, index).children, 0)
        } else {
            get(value.children, index)
        }
        let takes = task_value(flow.context.env, argument.ty)
        let call = value.kind == ExprKind.Call || value.kind == ExprKind.TaskCall ||
            value.kind == ExprKind.IndirectCall || value.kind == ExprKind.DynCall
        let borrowing = takes && call && task_resource_borrow(flow.context, argument.ty)?
        let transferred = task_expression(flow, argument, takes, borrowing)?
        if !argument.falls {
            return Result.Ok(false)
        }
        if transferred {
            set(flow.pending, 0, get(flow.pending, 0) + 1)
        }
        if flow.no_suspend >= 0 && no_suspend(flow.context, argument.ty, flow.no_suspend)? {
            set(flow.pending, 1, get(flow.pending, 1) + 1)
        }
        index = index + 1
    }
    set(flow.pending, 0, before)
    set(flow.pending, 1, suspended)
    Result.Ok(task_value(flow.context.env, value.ty))
}

// Eager operands retain earlier values through later operands. Blocks and
// control flow use their own paths: completed statements are not retained.
fn task_operands(flow TaskFlow, values List[Expr]) Result[Bool, Failure] {
    let suspended = get(flow.pending, 1)
    var index = 0
    while index < length(values) {
        let value = get(values, index)
        discard task_expression(flow, value, false)?
        if !value.falls {
            return Result.Ok(false)
        }
        if flow.no_suspend >= 0 && no_suspend(flow.context, value.ty, flow.no_suspend)? {
            set(flow.pending, 1, get(flow.pending, 1) + 1)
        }
        index = index + 1
    }
    set(flow.pending, 1, suspended)
    Result.Ok(true)
}

fn task_resource_borrow(context Context, ty Int) Result[Bool, Failure] {
    if get(context.env.types, ty).kind == TypeKind.Task {
        return Result.Ok(false)
    }
    must_scope(context, ty)
}

fn task_borrowed_input(flow TaskFlow, value Expr) Result[Bool, Failure] {
    if !task_value(flow.context.env, value.ty) || !task_resource_borrow(flow.context, value.ty)? {
        return Result.Ok(false)
    }
    if flow.cleanup {
        return Result.Ok(true)
    }
    var root = value
    while root.kind == ExprKind.Field {
        root = get(root.children, 0)
    }
    if root.kind != ExprKind.Local {
        return Result.Ok(false)
    }
    var field = get(flow.offsets, root.index)
    while field < get(flow.offsets, root.index + 1) {
        if get(flow.locals, field) == 3 {
            return Result.Ok(true)
        }
        field = field + 1
    }
    Result.Ok(false)
}

fn task_expression(flow TaskFlow, value Expr, allowed Bool) Result[Bool, Failure] {
    task_expression(flow, value, allowed, false)
}

fn task_expression(flow TaskFlow, value Expr, allowed Bool, borrowing Bool) Result[Bool, Failure] {
    let shape = get(flow.context.env.types, value.ty)
    let task = task_value(flow.context.env, value.ty)
    if value.kind == ExprKind.Suspend && shape.kind == TypeKind.Task {
        return Result.Err(task_error(flow, value, "private async intrinsics must be awaited directly"))
    }
    if flow.cleanup &&((task && !borrowing) || value.kind == ExprKind.Await || value.kind == ExprKind.Suspend) {
        return Result.Err(task_error(flow, value, "task creation, reading or transfer in cleanup is not yet implemented"))
    }
    if task && !allowed {
        return Result.Err(task_error(flow, value, "a task must be awaited or transferred; it cannot be copied or discarded"))
    }
    if borrowing && task {
        if value.kind == ExprKind.Local {
            return Result.Ok(false)
        }
        if value.kind == ExprKind.Field {
            discard task_expression(flow, get(value.children, 0), true, true)?
            return Result.Ok(false)
        }
        if value.kind != ExprKind.Block && value.kind != ExprKind.If && value.kind != ExprKind.Match {
            return Result.Err(task_error(flow, value, "bind a Task-bearing resource before borrowing it"))
        }
    }
    if value.kind == ExprKind.Deferred && value.text == "comptime selection" {
        // Captures describe possible access, not eagerly evaluated operands.
        // deferred() rejects this node in every emitting/concrete check.
        var capture = 0
        while capture < length(value.children) {
            let local = get(value.children, capture).index
            var field = get(flow.offsets, local)
            while field < get(flow.offsets, local + 1) {
                set(flow.locals, field, 2)
                field = field + 1
            }
            capture = capture + 1
        }
        return Result.Ok(task)
    }
    if value.kind == ExprKind.Local && task {
        return task_take(flow, value, get(flow.offsets, value.index), task_width(flow.context.env, value.ty))
    }
    if value.kind == ExprKind.Field && task_value(flow.context.env, get(value.children, 0).ty) {
        return task_projection(flow, value)
    }
    if value.kind == ExprKind.Await {
        discard task_expression(flow, get(value.children, 0), true)?
        if get(flow.pending, 1) != 0 {
            return Result.Err(task_error(flow, value, "a NoSuspend operand is still pending; finish its operation before awaiting"))
        }
        return Result.Ok(task)
    }
    if value.kind == ExprKind.Suspend {
        if value.text == "task_outcome" {
            discard task_arguments(flow, value)?
        } else {
            discard task_operands(flow, value.children)?
        }
        if get(flow.pending, 1) != 0 {
            return Result.Err(task_error(flow, value, "a NoSuspend operand is still pending; finish its operation before awaiting"))
        }
        return Result.Ok(task)
    }
    // A deferred call retains its runtime arguments during abstract checking.
    // Pending selections are handled separately above; they do not call anything.
    if value.kind == ExprKind.Call || value.kind == ExprKind.TaskCall || value.kind == ExprKind.DynCall || value.kind == ExprKind.IndirectCall || value.kind == ExprKind.Deferred || value.kind == ExprKind.Record || value.kind == ExprKind.Variant || value.kind == ExprKind.List ||
        (value.kind == ExprKind.Intrinsic && (value.text == "list_append" || value.text == "list_take" || value.text == "list_replace" || value.text == "task_observe" || value.text == "task_cancel" || value.text == "task_drain" || value.text == "task_ready_result" || value.text == "task_ready_outcome" || value.text == "task_ready_case" || value.text == "task_ready_payload")) {
        return task_arguments(flow, value)
    }
    if value.kind == ExprKind.Let || value.kind == ExprKind.Assign {
        let destination = get(flow.context.locals, value.index).ty
        let takes_task = task_value(flow.context.env, destination)
        discard task_sequence(flow, value.children, takes_task)?
        if value.falls && takes_task {
            var index = get(flow.offsets, value.index)
            while index < get(flow.offsets, value.index + 1) {
                if get(flow.locals, index) == 1 {
                    return Result.Err(task_error(flow, value, "cannot overwrite a live task; await or transfer it first"))
                }
                set(flow.locals, index, 1)
                index = index + 1
            }
        }
        return Result.Ok(false)
    }
    if value.kind == ExprKind.Return {
        discard task_sequence(flow, value.children, task_value(flow.context.env, flow.context.signature.result))?
        if all_fall(value.children) { discard tasks_consumed(flow, value)? }
        return Result.Ok(false)
    }
    if value.kind == ExprKind.Block {
        return task_sequence(flow, value.children, allowed, borrowing)
    }
    if value.kind == ExprKind.Coerce && (value.text == "resource-pending-transfer" || value.text == "resource-pending-field-transfer") {
        return task_sequence(flow, value.children, allowed)
    }
    if value.kind == ExprKind.If {
        let condition = get(value.children, 0)
        discard task_expression(flow, condition, false)?
        if !condition.falls {
            return Result.Ok(false)
        }
        let yes = task_branch(flow)
        let no = task_branch(flow)
        let then = get(value.children, 1)
        discard task_expression(yes, then, allowed, borrowing)?
        var no_falls = true
        if length(value.children) == 3 {
            let otherwise = get(value.children, 2)
            discard task_expression(no, otherwise, allowed, borrowing)?
            no_falls = otherwise.falls
        }
        if then.falls && no_falls && !compatible_task_state(yes, no) {
            return Result.Err(task_error(flow, value, "task consumption must agree on all continuing branches"))
        }
        if then.falls && no_falls { merge_task_states(yes.locals, no.locals) }
        if then.falls {
            task_join(flow, yes)
        } else {
            if no_falls {
                task_join(flow, no)
            }
        }
        return Result.Ok(task && !borrowing)
    }
    if value.kind == ExprKind.Match {
        let input = get(value.children, 0)
        let borrowed = borrowing || task_borrowed_input(flow, input)?
        if !borrowed && task_value(flow.context.env, input.ty) && task_resource_borrow(flow.context, input.ty)? {
            // Prefer a read-only match. Its state and loop exits stay private
            // until accepted; a real transfer uses the ordinary owned path.
            let exits = new[List[Int]]()
            let branch = task_branch(flow, exits)
            match task_match(branch, value, allowed, borrowing, true) {
                Result.Ok(transferred) => {
                    task_join(flow, branch)
                    var index = 0
                    while index < length(exits) {
                        push(flow.loop_exits, get(exits, index))
                        index = index + 1
                    }
                    return Result.Ok(transferred)
                }
                Result.Err(_) => {
                }
            }
        }
        return task_match(flow, value, allowed, borrowing, borrowed)
    }
    if value.kind == ExprKind.Binary &&(value.text == "&&" || value.text == "||") {
        discard task_expression(flow, get(value.children, 0), false)?
        let branch = task_branch(flow)
        let right = get(value.children, 1)
        discard task_expression(branch, right, false)?
        if right.falls && !compatible_task_state(flow, branch) {
            return Result.Err(task_error(flow, value, "a short-circuit operand cannot conditionally consume a live task"))
        }
        if right.falls { merge_task_states(flow.locals, branch.locals) }
        return Result.Ok(false)
    }
    if value.kind == ExprKind.While {
        let before = task_states(flow.locals)
        let pending = get(flow.pending, 0)
        discard task_expression(flow, get(value.children, 0), false)?
        if !compatible_task_states(before, flow.locals) || pending != get(flow.pending, 0) {
            return Result.Err(task_error(flow, value, "loop conditions must preserve existing task consumption state"))
        }
        merge_task_states(before, flow.locals)
        let exits = new[List[Int]]()
        let branch = TaskFlow {
            context = flow.context
            locals = task_states(before)
            offsets = flow.offsets
            pending = task_states(flow.pending)
            no_suspend = flow.no_suspend
            loop_entry = before
            loop_exits = exits
            loop_pending = pending
            cleanup = flow.cleanup
        }
        let body = get(value.children, 1)
        discard task_expression(branch, body, false)?
        if body.falls &&(!compatible_task_states(before, branch.locals) || pending != get(branch.pending, 0)) {
            return Result.Err(task_error(flow, value, "loop bodies must consume their own tasks and preserve tasks from outside the loop"))
        }
        if body.falls { merge_task_states(flow.locals, branch.locals) }
        var selected = !unconditional_loop(get(value.children, 0))
        var exit = 0
        while exit < length(exits) {
            let state = get(exits, exit)
            if selected && !compatible_task_states(flow.locals, state) {
                return Result.Err(task_error(flow, value, "task consumption must agree on all continuing loop exits"))
            }
            if selected { merge_task_states(state, flow.locals) }
            var local = 0
            while local < length(state) {
                set(flow.locals, local, get(state, local))
                local = local + 1
            }
            selected = true
            exit = exit + 1
        }
        return Result.Ok(false)
    }
    if value.kind == ExprKind.Break || value.kind == ExprKind.Continue {
        if get(flow.pending, 0) != flow.loop_pending ||
            (value.kind == ExprKind.Continue && !compatible_task_states(flow.locals, flow.loop_entry)) {
            return Result.Err(task_error(flow, value, "loop exits must consume loop-local tasks and preserve outer tasks"))
        }
        if value.kind == ExprKind.Break {
            var index = 0
            while index < length(flow.locals) {
                if get(flow.locals, index) == 1 && get(flow.loop_entry, index) == 0 {
                    return Result.Err(task_error(flow, value, "loop exits must consume loop-local tasks and preserve outer tasks"))
                }
                index = index + 1
            }
            push(flow.loop_exits, task_states(flow.locals))
        }
        return Result.Ok(false)
    }
    if value.kind == ExprKind.Defer || value.kind == ExprKind.Cleanup {
        let branch = TaskFlow {
            context = flow.context
            locals = task_states(flow.locals)
            offsets = flow.offsets
            pending = task_states(flow.pending)
            no_suspend = flow.no_suspend
            loop_entry = flow.loop_entry
            loop_exits = new[List[Int]]()
            loop_pending = flow.loop_pending
            cleanup = true
        }
        discard task_sequence(branch, value.children, false)?
        if !compatible_task_state(branch, flow) {
            return Result.Err(task_error(flow, value, "task transfer from cleanup is not yet implemented"))
        }
        return Result.Ok(false)
    }
    discard task_operands(flow, value.children)?
    Result.Ok(task)
}

// One seen set covers the whole body, including otherwise empty generic
// aggregates. Ordinary calls do not repeatedly traverse the same type graph.
fn task_nodes(value Expr, env Environment, seen List[Int]) Bool {
    if value.kind == ExprKind.TaskCall || value.kind == ExprKind.Await || value.kind == ExprKind.Suspend || contains_task(env, value.ty, seen) {
        return true
    }
    var index = 0
    while index < length(value.children) {
        if task_nodes(get(value.children, index), env, seen) {
            return true
        }
        index = index + 1
    }
    index = 0
    while index < length(value.arms) {
        let body = get(value.arms, index).body
        var member = 0
        while member < length(body) {
            if task_nodes(get(body, member), env, seen) {
                return true
            }
            member = member + 1
        }
        index = index + 1
    }
    false
}

fn task_flow(context Context, function Function) Result[Bool, Failure] {
    var parameters = false
    var index = 0
    while index < length(function.params) {
        parameters = parameters || task_value(context.env, get(function.params, index))
        index = index + 1
    }
    if !parameters && !task_value(context.env, function.result) && !task_nodes(function.body, context.env, new[Int]()) {
        return Result.Ok(true)
    }
    let locals = new[Int]()
    let offsets = ints(0)
    index = 0
    while index < length(function.locals) {
        let ty = get(function.locals, index).ty
        let width = task_width(context.env, ty)
        let borrowed = index < length(function.params) && width > 0 && task_resource_borrow(context, ty)?
        var field = 0
        while field < width {
            push(locals, if index < length(function.params) {
                    if borrowed { 3 } else { 1 }
                } else {
                    0
                })
            field = field + 1
        }
        push(offsets, length(locals))
        index = index + 1
    }
    let pending = ints(0)
    push(pending, 0)
    let flow = TaskFlow {
        context = context
        locals = locals
        offsets = offsets
        pending = pending
        no_suspend = if function.is_async {
            resource_concept(context.env, "NoSuspend")
        } else {
            -1
        }
        loop_entry = new[Int]()
        loop_exits = new[List[Int]]()
        loop_pending = 0
        cleanup = false
    }
    discard task_expression(flow, function.body, task_value(context.env, function.result))?
    if function.body.falls {
        discard tasks_consumed(flow, function.body)?
    }
    Result.Ok(true)
}
