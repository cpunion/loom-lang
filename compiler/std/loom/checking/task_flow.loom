import std.loom.typed.Expr
import std.loom.typed.ExprKind
import std.loom.typed.Function
import std.loom.typed.TypeKind
import std.loom.source.Diagnostic
import std.loom.binding.Failure
import std.list.new
import std.list.get
import std.list.push
import std.list.set
import std.list.length
import std.result.Result

// Task handles are one-shot, without introducing source ownership syntax.
// Locals transfer on reads; joins retain only identical consumption states.
record TaskFlow {
    context Context
    locals List[Int]
    pending List[Int]
    loop_entry List[Int]
    loop_pending Int
    cleanup Bool
}

fn task_error(flow TaskFlow, value Expr, message Text) Failure {
    Failure {
        source = symbol(flow.context.env, flow.context.signature.symbol).file
        diagnostic = Diagnostic {
            span = value.span
            message = message
        }
    }
}

fn task_states(values List[Int]) List[Int] {
    let copy = new[Int]()
    var index = 0
    while index < length(values) {
        push(copy, get(values, index))
        index = index + 1
    }
    copy
}

fn task_branch(flow TaskFlow) TaskFlow {
    TaskFlow {
        context = flow.context
        locals = task_states(flow.locals)
        pending = ints(get(flow.pending, 0))
        loop_entry = flow.loop_entry
        loop_pending = flow.loop_pending
        cleanup = flow.cleanup
    }
}

fn task_join(flow TaskFlow, branch TaskFlow) {
    var index = 0
    while index < length(flow.locals) {
        set(flow.locals, index, get(branch.locals, index))
        index = index + 1
    }
    set(flow.pending, 0, get(branch.pending, 0))
}

fn same_task_state(left TaskFlow, right TaskFlow) Bool {
    same(left.locals, right.locals) && get(left.pending, 0) == get(right.pending, 0)
}

fn tasks_consumed(flow TaskFlow, value Expr) Result[Bool, Failure] {
    if get(flow.pending, 0) != 0 {
        return Result.Err(task_error(flow, value, "a task argument is still pending; finish its call before returning"))
    }
    var index = 0
    while index < length(flow.locals) {
        if get(flow.locals, index) != 0 {
            return Result.Err(task_error(flow, value, "a task is still live at function exit; await or transfer it before returning"))
        }
        index = index + 1
    }
    Result.Ok(true)
}

fn task_sequence(flow TaskFlow, values List[Expr], allowed Bool) Result[Bool, Failure] {
    var index = 0
    var task = false
    while index < length(values) {
        let value = get(values, index)
        task = task_expression(flow, value, allowed && index + 1 == length(values))?
        if !value.falls {
            return Result.Ok(false)
        }
        index = index + 1
    }
    Result.Ok(task)
}

// Earlier argument values remain our obligations until the actual call. An
// exit while evaluating a later argument must not silently abandon them.
fn task_arguments(flow TaskFlow, value Expr) Result[Bool, Failure] {
    let before = get(flow.pending, 0)
    var index = 0
    while index < length(value.children) {
        let argument = get(value.children, index)
        let transferred = task_expression(flow, argument, direct_task(flow.context.env, argument.ty))?
        if !argument.falls { return Result.Ok(false) }
        if transferred { set(flow.pending, 0, get(flow.pending, 0) + 1) }
        index = index + 1
    }
    set(flow.pending, 0, before)
    Result.Ok(direct_task(flow.context.env, value.ty))
}

fn task_expression(flow TaskFlow, value Expr, allowed Bool) Result[Bool, Failure] {
    let shape = get(flow.context.env.types, value.ty)
    let task = shape.kind == TypeKind.Task
    if !task && contains_task(flow.context.env, value.ty, new[Int]()) {
        return Result.Err(task_error(flow, value, "storing tasks in aggregates is not yet implemented"))
    }
    if flow.cleanup && (task || value.kind == ExprKind.Await || value.kind == ExprKind.Suspend) {
        return Result.Err(task_error(flow, value, "task creation, reading or transfer in cleanup is not yet implemented"))
    }
    if task && !allowed {
        return Result.Err(task_error(flow, value, "a task must be awaited or transferred; it cannot be copied or discarded"))
    }
    if value.kind == ExprKind.Local && task {
        if get(flow.locals, value.index) == 0 {
            return Result.Err(task_error(flow, value, "this task was already awaited or transferred"))
        }
        set(flow.locals, value.index, 0)
        return Result.Ok(true)
    }
    if value.kind == ExprKind.Await {
        discard task_expression(flow, get(value.children, 0), true)?
        return Result.Ok(task)
    }
    // A deferred call retains its runtime arguments during abstract checking.
    // Other Deferred expressions have no children and cannot hide transfers.
    if value.kind == ExprKind.Call || value.kind == ExprKind.TaskCall || value.kind == ExprKind.Deferred {
        return task_arguments(flow, value)
    }
    if value.kind == ExprKind.Let || value.kind == ExprKind.Assign {
        let destination = get(flow.context.locals, value.index).ty
        let takes_task = get(flow.context.env.types, destination).kind == TypeKind.Task
        discard task_sequence(flow, value.children, takes_task)?
        if value.falls && takes_task {
            if get(flow.locals, value.index) != 0 {
                return Result.Err(task_error(flow, value, "cannot overwrite a live task; await or transfer it first"))
            }
            set(flow.locals, value.index, 1)
        }
        return Result.Ok(false)
    }
    if value.kind == ExprKind.Return {
        discard task_sequence(flow, value.children, direct_task(flow.context.env, flow.context.signature.result))?
        discard tasks_consumed(flow, value)?
        return Result.Ok(false)
    }
    if value.kind == ExprKind.Block {
        return task_sequence(flow, value.children, allowed)
    }
    if value.kind == ExprKind.If {
        let condition = get(value.children, 0)
        discard task_expression(flow, condition, false)?
        if !condition.falls {
            return Result.Ok(false)
        }
        let yes = task_branch(flow)
        let no = task_branch(flow)
        let then = get(value.children, 1)
        discard task_expression(yes, then, allowed)?
        var no_falls = true
        if length(value.children) == 3 {
            let otherwise = get(value.children, 2)
            discard task_expression(no, otherwise, allowed)?
            no_falls = otherwise.falls
        }
        if then.falls && no_falls && !same_task_state(yes, no) {
            return Result.Err(task_error(flow, value, "task consumption must agree on all continuing branches"))
        }
        if then.falls {
            task_join(flow, yes)
        } else {
            if no_falls {
                task_join(flow, no)
            }
        }
        return Result.Ok(task)
    }
    if value.kind == ExprKind.Match {
        discard task_sequence(flow, value.children, false)?
        let merged = task_branch(flow)
        var found = false
        var index = 0
        while index < length(value.arms) {
            let branch = task_branch(flow)
            let body = get(value.arms, index).body
            discard task_sequence(branch, body, allowed)?
            if all_fall(body) {
                if found && !same_task_state(merged, branch) {
                    return Result.Err(task_error(flow, value, "task consumption must agree on all continuing match arms"))
                }
                task_join(merged, branch)
                found = true
            }
            index = index + 1
        }
        if found {
            task_join(flow, merged)
        }
        return Result.Ok(task)
    }
    if value.kind == ExprKind.Binary &&(value.text == "&&" || value.text == "||") {
        discard task_expression(flow, get(value.children, 0), false)?
        let branch = task_branch(flow)
        let right = get(value.children, 1)
        discard task_expression(branch, right, false)?
        if right.falls && !same_task_state(flow, branch) {
            return Result.Err(task_error(flow, value, "a short-circuit operand cannot conditionally consume a live task"))
        }
        return Result.Ok(false)
    }
    if value.kind == ExprKind.While {
        let before = task_states(flow.locals)
        let pending = get(flow.pending, 0)
        discard task_expression(flow, get(value.children, 0), false)?
        if !same(before, flow.locals) || pending != get(flow.pending, 0) {
            return Result.Err(task_error(flow, value, "loop conditions must preserve existing task consumption state"))
        }
        let branch = TaskFlow {
            context = flow.context
            locals = task_states(before)
            pending = ints(pending)
            loop_entry = before
            loop_pending = pending
            cleanup = flow.cleanup
        }
        let body = get(value.children, 1)
        discard task_expression(branch, body, false)?
        if body.falls && (!same(before, branch.locals) || pending != get(branch.pending, 0)) {
            return Result.Err(task_error(flow, value, "loop bodies must consume their own tasks and preserve tasks from outside the loop"))
        }
        return Result.Ok(false)
    }
    if value.kind == ExprKind.Break || value.kind == ExprKind.Continue {
        if !same(flow.locals, flow.loop_entry) || get(flow.pending, 0) != flow.loop_pending {
            return Result.Err(task_error(flow, value, "loop exits must consume loop-local tasks and preserve outer tasks"))
        }
        return Result.Ok(false)
    }
    if value.kind == ExprKind.Defer || value.kind == ExprKind.Cleanup {
        let branch = TaskFlow {
            context = flow.context
            locals = task_states(flow.locals)
            pending = ints(get(flow.pending, 0))
            loop_entry = flow.loop_entry
            loop_pending = flow.loop_pending
            cleanup = true
        }
        discard task_sequence(branch, value.children, false)?
        if !same_task_state(branch, flow) {
            return Result.Err(task_error(flow, value, "task transfer from cleanup is not yet implemented"))
        }
        return Result.Ok(false)
    }
    discard task_sequence(flow, value.children, false)?
    Result.Ok(task)
}

// One seen set covers the whole body, including otherwise empty generic
// aggregates. Ordinary calls do not repeatedly traverse the same type graph.
fn task_nodes(value Expr, env Environment, seen List[Int]) Bool {
    if value.kind == ExprKind.TaskCall || value.kind == ExprKind.Await || contains_task(env, value.ty, seen) {
        return true
    }
    var index = 0
    while index < length(value.children) {
        if task_nodes(get(value.children, index), env, seen) {
            return true
        }
        index = index + 1
    }
    index = 0
    while index < length(value.arms) {
        let body = get(value.arms, index).body
        var member = 0
        while member < length(body) {
            if task_nodes(get(body, member), env, seen) {
                return true
            }
            member = member + 1
        }
        index = index + 1
    }
    false
}

fn task_flow(context Context, function Function) Result[Bool, Failure] {
    var parameters = false
    var index = 0
    while index < length(function.params) {
        parameters = parameters || direct_task(context.env, get(function.params, index))
        index = index + 1
    }
    if !parameters && !direct_task(context.env, function.result) && !task_nodes(function.body, context.env, new[Int]()) {
        return Result.Ok(true)
    }
    let locals = new[Int]()
    index = 0
    while index < length(function.locals) {
        push(locals, if index < length(function.params) && direct_task(context.env, get(function.params, index)) { 1 } else { 0 })
        index = index + 1
    }
    let flow = TaskFlow {
        context = context
        locals = locals
        pending = ints(0)
        loop_entry = new[Int]()
        loop_pending = 0
        cleanup = false
    }
    discard task_expression(flow, function.body, direct_task(context.env, function.result))?
    if function.body.falls {
        discard tasks_consumed(flow, function.body)?
    }
    Result.Ok(true)
}
