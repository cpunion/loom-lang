import std.loom.binding.candidates
import std.loom.ast.Node
import std.loom.ast.NodeKind
import std.loom.typed.Type
import std.loom.typed.TypeKind
import std.loom.typed.Field
import std.loom.typed.Variant
import std.loom.typed.Expr
import std.list.new
import std.list.get
import std.list.push
import std.list.set
import std.list.length
import std.result.Result
import std.int.to_text

fn simple_type(kind TypeKind, symbol Int, arguments List[Int]) Type {
    Type { kind = kind symbol = symbol arguments = arguments fields = new[Field]() variants = new[Variant]() constraint = new[Expr]() }
}
fn base_type(env Environment, ty Int) Int {
    let shape = get(env.types, ty)
    if shape.kind == TypeKind.Refined { get(shape.fields, 0).ty } else { ty }
}
fn nominal_data(kind NodeKind) Bool {
    kind == NodeKind.Record || kind == NodeKind.Enum || kind == NodeKind.Refined
}
fn initialize_types(env Environment) {
    discard intern(env, TypeKind.Unit, -1, new[Int]())
    discard intern(env, TypeKind.Int, -1, new[Int]())
    discard intern(env, TypeKind.Bool, -1, new[Int]())
    discard intern(env, TypeKind.Text, -1, new[Int]())
    discard intern(env, TypeKind.Bytes, -1, new[Int]())
    discard intern(env, TypeKind.Float, -1, new[Int]())
}
fn intern(env Environment, kind TypeKind, symbol Int, arguments List[Int]) Int {
    var index = 0
    while index < length(env.types) {
        let existing = get(env.types, index)
        if existing.kind == kind && existing.symbol == symbol && same(existing.arguments, arguments) { return index }
        index = index + 1
    }
    let fields = new[Field]()
    if kind == TypeKind.Tuple {
        index = 0
        while index < length(arguments) {
            push(fields, Field { name = to_text(index) ty = get(arguments, index) })
            index = index + 1
        }
    }
    push(env.types, Type { kind = kind symbol = symbol arguments = arguments fields = fields variants = new[Variant]() constraint = new[Expr]() })
    push(env.type_states, 2)
    length(env.types) - 1
}
fn tuple_type(env Environment, owner Int, node Node, elements List[Int]) Result[Int, Failure] {
    if length(elements) == 0 { return Result.Err(failure(env, owner, node, "a tuple needs at least one value element")) }
    var index = 0
    while index < length(elements) {
        let element = get(elements, index)
        if element == 0 { return Result.Err(failure(env, owner, node, "tuple elements must produce a value")) }
        if type_depth(env, element) >= 64 {
            return Result.Err(failure(env, owner, node, "type specialization depth exceeded; expansion must be finite"))
        }
        index = index + 1
    }
    Result.Ok(intern(env, TypeKind.Tuple, -1, elements))
}
fn abstract_arguments(env Environment, count Int) List[Int] {
    let arguments = new[Int]()
    var index = 0
    while index < count {
        push(arguments, intern(env, TypeKind.Parameter, index, new[Int]()))
        index = index + 1
    }
    arguments
}
fn find_data(env Environment, owner Int, node Node, path Text) Result[Int, Failure] {
    let current = symbol(env, owner)
    let options = candidates(env.source, current.file, current.test_only, path)
    var found = -1
    var index = 0
    while index < length(options) {
        let candidate = get(options, index)
        if nominal_data(symbol(env, candidate).node.kind) {
            if found >= 0 { return Result.Err(failure(env, owner, node, "ambiguous type; qualify its name")) }
            found = candidate
        }
        index = index + 1
    }
    Result.Ok(found)
}
fn resolve(env Environment, owner Int, node Node, arguments List[Int], depth Int) Result[Int, Failure] {
    resolve_bound(env, owner, node, arguments, requirements(env, owner, arguments)?, depth)
}
fn resolve_bound(env Environment, owner Int, node Node, arguments List[Int], obligations List[Requirement], depth Int) Result[Int, Failure] {
    if depth > 64 { return Result.Err(failure(env, owner, node, "type specialization depth exceeded")) }
    if node.kind == NodeKind.Apply {
        let applied = Node { kind = NodeKind.Type value = child(node, 0).value children = child(node, 1).children span = node.span }
        return resolve_bound(env, owner, applied, arguments, obligations, depth)
    }
    if node.kind == NodeKind.DynType { return dynamic_type(env, owner, node, arguments, obligations, depth + 1) }
    if node.kind == NodeKind.FunctionType {
        let shape = new[Int]()
        let parameters = group(node, NodeKind.Parameters)
        var index = 0
        while index < length(parameters) {
            push(shape, resolve_bound(env, owner, get(parameters, index), arguments, obligations, depth + 1)?)
            index = index + 1
        }
        let output = group(node, NodeKind.ReturnType)
        push(shape, if length(output) == 0 { 0 } else { resolve_bound(env, owner, get(output, 0), arguments, obligations, depth + 1)? })
        return Result.Ok(intern(env, TypeKind.Function, -1, shape))
    }
    if node.kind == NodeKind.TupleType || node.kind == NodeKind.Tuple {
        let elements = new[Int]()
        var index = 0
        while index < length(node.children) {
            push(elements, resolve_bound(env, owner, child(node, index), arguments, obligations, depth + 1)?)
            index = index + 1
        }
        return tuple_type(env, owner, node, elements)
    }
    if node.kind != NodeKind.Type && node.kind != NodeKind.Name {
        return Result.Err(failure(env, owner, node, "expected a type argument, not a value expression"))
    }
    var builtin = -1
    if node.value == "Self" { builtin = self_type(env, owner, arguments, depth)? }
    if node.value == "Int" { builtin = 1 }
    if node.value == "Bool" { builtin = 2 }
    if node.value == "Text" { builtin = 3 }
    if node.value == "Bytes" { builtin = 4 }
    if node.value == "Float" { builtin = 5 }
    if node.value == "Unit" { return Result.Err(failure(env, owner, node, "omit Unit; it is not a source type")) }
    let parameters = type_parameters(env, owner)
    var index = 0
    while index < length(parameters) {
        if node.value == get(parameters, index).value { builtin = get(arguments, index + parameter_offset(env, owner)) }
        index = index + 1
    }
    if builtin >= 0 {
        if length(node.children) != 0 { return Result.Err(failure(env, owner, node, "this type takes no arguments")) }
        return Result.Ok(builtin)
    }
    let projected = projection(env, owner, node, arguments, obligations, depth)?
    if projected >= 0 { return Result.Ok(projected) }
    let args = new[Int]()
    index = 0
    while index < length(node.children) {
        push(args, resolve_bound(env, owner, child(node, index), arguments, obligations, depth + 1)?)
        index = index + 1
    }
    if node.value == "Task" {
        if length(args) != 1 { return Result.Err(failure(env, owner, node, "Task needs one result type argument")) }
        return Result.Ok(intern(env, TypeKind.Task, -1, args))
    }
    if node.value == "List" {
        if length(args) != 1 { return Result.Err(failure(env, owner, node, "List requires one element type")) }
        return Result.Ok(intern(env, TypeKind.List, -1, args))
    }
    let declaration = find_data(env, owner, node, node.value)?
    if declaration < 0 { return Result.Err(failure(env, owner, node, "unknown or inaccessible type")) }
    data_type(env, declaration, args, depth + 1)
}
fn data_type(env Environment, declaration Int, arguments List[Int], depth Int) Result[Int, Failure] {
    let item = symbol(env, declaration)
    if length(arguments) != length(group(item.node, NodeKind.TypeParameters)) {
        return Result.Err(failure(env, declaration, item.node, "wrong number of type arguments"))
    }
    var index = 0
    while index < length(arguments) {
        if type_depth(env, get(arguments, index)) >= 64 {
            return Result.Err(failure(env, declaration, item.node, "type specialization depth exceeded; expansion must be finite"))
        }
        index = index + 1
    }
    index = 0
    while index < length(env.types) {
        let existing = get(env.types, index)
        if existing.symbol == declaration && (existing.kind == TypeKind.Record || existing.kind == TypeKind.Enum || existing.kind == TypeKind.Refined) && same(existing.arguments, arguments) {
            if env.expand_data && get(env.type_states, index) == 0 { discard expand_type(env, index, depth)? }
            return Result.Ok(index)
        }
        index = index + 1
    }
    if depth > 64 || length(env.types) >= 4096 {
        return Result.Err(failure(env, declaration, item.node, "type specialization budget exceeded; expansion must be finite"))
    }
    let kind = if item.node.kind == NodeKind.Record { TypeKind.Record } else {
        if item.node.kind == NodeKind.Enum { TypeKind.Enum } else { TypeKind.Refined }
    }
    let id = length(env.types)
    let placeholder = simple_type(kind, declaration, arguments)
    push(env.types, placeholder)
    push(env.type_states, 0)
    if env.expand_data { discard expand_type(env, id, depth)? }
    Result.Ok(id)
}
fn expand_type(env Environment, id Int, depth Int) Result[Bool, Failure] {
    if depth > 64 { return Result.Err(failure(env, get(env.types, id).symbol, symbol(env, get(env.types, id).symbol).node, "type specialization depth exceeded")) }
    set(env.type_states, id, 1)
    let shape = get(env.types, id)
    let declaration = shape.symbol
    let kind = shape.kind
    let arguments = shape.arguments
    let item = symbol(env, declaration)
    let obligations = requirements(env, declaration, arguments)?
    let fields = new[Field]()
    let variants = new[Variant]()
    let constraints = new[Expr]()
    var index = 0
    while index < length(item.node.children) {
        let member = child(item.node, index)
        if member.kind == NodeKind.Field {
            push(fields, Field { name = member.value ty = resolve_bound(env, declaration, child(member, 0), arguments, obligations, depth + 1)? })
        }
        if member.kind == NodeKind.Variant {
            let payload = new[Int]()
            var field = 0
            while field < length(member.children) {
                push(payload, resolve_bound(env, declaration, child(member, field), arguments, obligations, depth + 1)?)
                field = field + 1
            }
            push(variants, Variant { name = member.value fields = payload })
        }
        index = index + 1
    }
    if kind == TypeKind.Refined {
        let base = resolve_bound(env, declaration, child(item.node, type_part(item.node)), arguments, obligations, depth + 1)?
        if length(arguments) != 0 || (base != 1 && base != 5) {
            return Result.Err(failure(env, declaration, item.node, "this checker constrains Int or Float directly"))
        }
        push(fields, Field { name = "self" ty = base })
        // Predicates are validated after every function signature is available.
    }
    set(env.types, id, Type { kind = kind symbol = declaration arguments = arguments fields = fields variants = variants constraint = constraints })
    set(env.type_states, id, 2)
    Result.Ok(true)
}
fn substitute(env Environment, owner Int, ty Int, arguments List[Int], node Node) Result[Int, Failure] {
    let source = get(env.types, ty)
    if source.kind == TypeKind.Parameter { return Result.Ok(get(arguments, source.symbol)) }
    if length(source.arguments) == 0 {
        // Header discovery may have interned nominal data without its fields.
        if env.expand_data && get(env.type_states, ty) == 0 { discard expand_type(env, ty, 0)? }
        return Result.Ok(ty)
    }
    let args = new[Int]()
    var index = 0
    while index < length(source.arguments) {
        push(args, substitute(env, owner, get(source.arguments, index), arguments, node)?)
        index = index + 1
    }
    if source.kind == TypeKind.List { return Result.Ok(intern(env, TypeKind.List, -1, args)) }
    if source.kind == TypeKind.Task { return Result.Ok(intern(env, TypeKind.Task, -1, args)) }
    if source.kind == TypeKind.Function { return Result.Ok(intern(env, TypeKind.Function, -1, args)) }
    if source.kind == TypeKind.Dyn { return dynamic_instance(env, owner, get(env.interfaces, source.symbol).symbol, args, node) }
    if source.kind == TypeKind.Associated { return associated_type(env, owner, source.symbol, get(args, 0), argument_tail(args, 1), node, 0) }
    if source.kind == TypeKind.Tuple { return tuple_type(env, owner, node, args) }
    if source.kind == TypeKind.Record || source.kind == TypeKind.Enum || source.kind == TypeKind.Refined {
        return data_type(env, source.symbol, args, 0)
    }
    Result.Ok(ty)
}
fn same_constructor(env Environment, first Type, second Type) Bool {
    if first.kind != second.kind || length(first.arguments) != length(second.arguments) { return false }
    if first.kind == TypeKind.Dyn {
        return get(env.interfaces, first.symbol).symbol == get(env.interfaces, second.symbol).symbol
    }
    first.symbol == second.symbol
}
fn infer(env Environment, pattern Int, actual Int, arguments List[Int]) Bool {
    let source = get(env.types, pattern)
    // An associated result does not identify its receiver type. Compare only
    // after independent parameter positions have supplied the type arguments.
    if source.kind == TypeKind.Associated { return true }
    if source.kind == TypeKind.Parameter {
        let previous = get(arguments, source.symbol)
        if previous >= 0 { return previous == actual }
        set(arguments, source.symbol, actual)
        return true
    }
    let value = get(env.types, actual)
    if !same_constructor(env, source, value) { return false }
    var index = 0
    var matched = true
    while index < length(source.arguments) {
        let matches = infer(env, get(source.arguments, index), get(value.arguments, index), arguments)
        matched = matched && matches
        index = index + 1
    }
    matched
}
fn concrete(env Environment, ty Int) Bool {
    let source = get(env.types, ty)
    if source.kind == TypeKind.Parameter || source.kind == TypeKind.Associated { return false }
    var index = 0
    while index < length(source.arguments) {
        if !concrete(env, get(source.arguments, index)) { return false }
        index = index + 1
    }
    true
}
fn type_depth(env Environment, ty Int) Int {
    let source = get(env.types, ty)
    if source.kind == TypeKind.Parameter || ty <= 5 { return 0 }
    var deepest = 0
    var index = 0
    while index < length(source.arguments) {
        let depth = type_depth(env, get(source.arguments, index))
        if depth > deepest { deepest = depth }
        index = index + 1
    }
    deepest + 1
}
fn layout(env Environment, id Int, states List[Int], owner Int) Result[Bool, Failure] {
    let ty = get(env.types, id)
    if ty.kind != TypeKind.Record && ty.kind != TypeKind.Enum && ty.kind != TypeKind.Tuple { return Result.Ok(true) }
    let declaration = if ty.symbol >= 0 { ty.symbol } else { owner }
    if get(states, id) == 2 { return Result.Ok(true) }
    if get(states, id) == 1 {
        return Result.Err(failure(env, declaration, symbol(env, declaration).node, "recursive by-value data layout needs a List boundary"))
    }
    set(states, id, 1)
    var index = 0
    while index < length(ty.fields) {
        discard layout(env, get(ty.fields, index).ty, states, declaration)?
        index = index + 1
    }
    index = 0
    while index < length(ty.variants) {
        let fields = get(ty.variants, index).fields
        var field = 0
        while field < length(fields) {
            discard layout(env, get(fields, field), states, declaration)?
            field = field + 1
        }
        index = index + 1
    }
    set(states, id, 2)
    Result.Ok(true)
}
fn layouts(env Environment) Result[Bool, Failure] {
    let states = new[Int]()
    var index = 0
    while index < length(env.types) { push(states, 0)
        index = index + 1
    }
    index = 0
    // Every inline cycle crosses a nominal declaration. Anonymous tuples have
    // no source symbol, so enter through a declaration and retain its location.
    while index < length(env.types) {
        let ty = get(env.types, index)
        if ty.kind == TypeKind.Record || ty.kind == TypeKind.Enum {
            discard layout(env, index, states, ty.symbol)?
        }
        index = index + 1
    }
    Result.Ok(true)
}
