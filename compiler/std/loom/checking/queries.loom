import std.loom.binding.Program
import std.loom.binding.Failure
import std.loom.ast.has
import std.loom.ast.NodeKind
import std.loom.typed.Type
import std.loom.typed.Interface
import std.loom.typed.Function
import std.list.new
import std.list.get
import std.list.length
import std.result.Result

// Query-local IDs belong to these bindings and checked function tables, not a
// compilable package. Call/FunctionRef indices retain closure function ordering.
// Signature headers contain no body or proof-success claim.
pub record SignatureHeader {
    symbol Int
    params List[Int]
    output Int
}

pub record CheckedQuery {
    bindings std.loom.binding.Program
    types List[Type]
    interfaces List[Interface]
    functions List[Function]
    headers List[SignatureHeader]
    declarations List[DeclarationReference]
}

// Signature eligibility uses the invocation's canonical nominal checks. These
// are supplied top-level source symbol IDs, not synthesized methods, runtime
// roots or proof that a generator can run.
pub fn macro_generator_candidates(source std.loom.binding.Program, inputs BuildInputs) Result[List[Int], Failure] {
    discard expanded_source(source)?
    let env = prepare_with_inputs(query_source(source)?, inputs, true)?
    let candidates = new[Int]()
    var index = 0
    while index < length(env.signatures) {
        let current = get(env.signatures, index)
        if current.symbol < length(source.symbols) && get(source.symbols, current.symbol).owner < 0 &&
        macro_signature(env, current) {
            push(candidates, current.symbol)
        }
        index = index + 1
    }
    Result.Ok(candidates)
}

// Full application query: concrete instances reached from build roots and
// source contracts. CTFE-only bodies do not become runtime instances.
pub fn check_query(source std.loom.binding.Program, inputs BuildInputs) Result[CheckedQuery, Failure] {
    discard expanded_source(source)?
    let env = prepare_with_inputs(query_source(source)?, inputs, true)?
    let program = checked_program_reusing(env, new[Bool](), new[Bool](), ints(0), no_body_reuse(), true)?
    source_contract_functions(env, program.functions)
    Result.Ok(CheckedQuery {
            bindings = env.source
            types = env.types
            interfaces = env.interfaces
            functions = program.functions
            headers = new[SignatureHeader]()
            declarations = get(env.inputs, 0).declaration_references
        })
}

fn query_signature_header(node Node, offset Int) Bool {
    var index = 0
    while index < length(node.children) {
        let group = get(node.children, index)
        if (group.kind == NodeKind.TypeParameters || group.kind == NodeKind.Parameters || group.kind == NodeKind.ReturnType) &&
        offset >= group.span.start && offset < group.span.end {
            return true
        }
        index = index + 1
    }
    false
}

fn query_function_owner(env Environment, declarations Int, file Int, offset Int) Int {
    var selected = -1
    var index = 0
    while index < declarations {
        let item = symbol(env, index)
        if item.file == file && item.node.kind == NodeKind.Function &&
        offset >= item.node.span.start && offset < item.node.span.end && has(item.node, NodeKind.Block) {
            selected = source_signature_id(env, index)
        }
        index = index + 1
    }
    selected
}

// Read the original declaration's signature, never a generated instance that
// happens to overlap its source span. Some declarations need no source body.
fn query_header_owner(env Environment, declarations Int, file Int, offset Int) Int {
    var index = 0
    while index < declarations {
        let item = symbol(env, index)
        if item.file == file && item.node.kind == NodeKind.Function && query_signature_header(item.node, offset) {
            let id = source_signature_id(env, index)
            if id >= 0 {
                return id
            }
        }
        index = index + 1
    }
    -1
}

fn query_templates(env Environment) Result[Bool, Failure] {
    var index = 0
    while index < length(env.signatures) {
        let current = get(env.signatures, index)
        if pack_instance(env, index) < 0 && (current.parameters != 0 || has_static(current)) &&
        (!prototype(env, current.symbol) || has(symbol(env, current.symbol).node, NodeKind.Block)) {
            discard function(env, index, abstract_arguments(env, current.parameters), unknown_constants(current), false)?
        }
        index = index + 1
    }
    Result.Ok(true)
}

// Signature queries need only their actual header/type dependencies, not
// unrelated bodies. Body queries validate their actual template dependency
// closure: a concrete instance must not substitute for its declaration's
// abstract legality, including helpers reached only by CTFE. Unrelated ordinary
// and template body failures do not block this query. Binding/global declaration
// failures remain fatal; this is not a whole-program build-success claim.
// Generic headers retain their original abstract types, not concrete instances.
// Generic/comptime body owners have no concrete query instance and return an
// empty function list; no arbitrary type or static arguments are invented.
pub fn check_query(source std.loom.binding.Program, file Int, offset Int) Result[CheckedQuery, Failure] {
    check_query(source, file, offset, build_inputs(no_input_reader))
}

pub fn check_query(source std.loom.binding.Program, file Int, offset Int, inputs BuildInputs) Result[CheckedQuery, Failure] {
    discard expanded_source(source)?
    let detached = query_source(source)?
    let declarations = length(detached.symbols)
    let env = prepare_with_inputs(detached, inputs, true)?
    let headers = new[SignatureHeader]()
    let selected = query_header_owner(env, declarations, file, offset)
    if selected >= 0 {
        let current = get(env.signatures, selected)
        push(headers, SignatureHeader {
                symbol = current.symbol
                params = current.params
                output = current.result
            })
    }
    var functions = new[Function]()
    if length(headers) == 0 {
        // Choose the original declaration, not a specialization produced while
        // checking a type/header that happens to share its source span.
        let owner = query_function_owner(env, declarations, file, offset)
        if owner >= 0 {
            let current = get(env.signatures, owner)
            if current.parameters != 0 || has_static(current) {
                require_query_template(env, owner)
            } else {
                discard schedule(env, owner, new[Int](), new[StaticValue](), symbol(env, current.symbol).node)?
                // A produced dyn value can be used outside this query. Check its
                // witness methods too, without unrelated application roots.
                functions = emit_functions_in(env, true, no_body_reuse(), false, true)?
            }
        }
        discard query_required_templates(env)?
    } else {
        discard layouts(env)?
    }
    source_contract_functions(env, functions)
    Result.Ok(CheckedQuery {
            bindings = env.source
            types = env.types
            interfaces = env.interfaces
            functions = functions
            headers = headers
            declarations = get(env.inputs, 0).declaration_references
        })
}
