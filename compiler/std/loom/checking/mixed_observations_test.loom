test fn mixed_observations_check_every_pattern_in_header_scope() {
    let source = concat(constructed_observation_header(), """
        fn mixed[Us... Value, Vs...](values (Bool, Us..., Wrapped[Vs]..., Us..., Bool)) Int
        ensures result >= 0 {
            let Wrapped = comptime { Bool }
            var total = 0
            comptime for index, item in values {
                total = total + item.value() + index
            }
            total
        }
        fn forwarded[As... Value, Bs...](values (Bool, As..., Wrapped[Bs]..., As..., Bool)) Int
        ensures result >= 0 {
            mixed[As..., Bs...](values)
        }
        concept Collection {
            fn total[Ts...](self Self, values (Bool, Wrapped[Ts]..., Bool)) Int
            ensures result >= 0 { 0 }
        }
        impl Collection for Int {
            fn total[Us...](self Int, values (Bool, Wrapped[Us]..., Bool)) Int {
                var sum = 0
                comptime for item in values {
                    sum = sum + item.value()
                }
                sum
            }
        }
        """)
    discard accepted(source)
    // Fixed members and every independent word need evidence, even when an
    // uncalled family might later select an empty expansion.
    rejects(std.text.join(std.text.split(source, "Bool, Us..."), "Text, Us..."))
    rejects(std.text.join(std.text.split(source, "Us... Value"), "Us..."))
    rejects(std.text.join(std.text.split(source, "impl[T] Value for Wrapped[T]"),
            "impl[T Value] Value for Wrapped[T]"))
    rejects(std.text.join(std.text.split(source, "total + item.value()"), "total - item.value()"))
}

test fn mixed_observations_keep_overload_choices_and_independent_results() {
    let header = concat(constructed_observation_header(), """
        concept Other {
            fn value(self Self) Int
            ensures result >= 0
        }
        impl Other for Bool {
            fn value(self Bool) Int { 1 }
        }
        """)
    // The common Value method cannot hide Bool's competing method.
    rejects(concat(header, """
        fn ambiguous[Us...](values (Bool, Wrapped[Us]...)) Int
        ensures result >= 0 {
            var total = 0
            comptime for item in values {
                total = total + item.value()
            }
            total
        }
        """))
    // A shared spelling/return guarantee is not a shared concept prototype.
    rejects("""
        concept Value {
            fn value(self Self, input Int) Int
            ensures result >= 0 { 1 }
        }
        concept Other {
            fn value(self Self, input Text) Int
            ensures result >= 0 { 1 }
        }
        impl Other for Bool {}
        record Wrapped[T] {
            value T
        }
        impl[T] Value for Wrapped[T] {}
        fn disjoint[Us...](values (Bool, Wrapped[Us]...)) Int
        ensures result >= 0 {
            var total = 0
            comptime for item in values {
                total = total + item.value(1)
            }
            total
        }
        """)
    // Different argument types are ordinary overloads, not an ambiguity or
    // a reason to require identical option sets for every member.
    discard accepted("""
        concept Pick {
            fn pick(self Self, input Int) Int
            ensures result >= 0 { 1 }
        }
        concept Other {
            fn pick(self Self, input Text) Int
            ensures result >= 0 { 1 }
        }
        impl Pick for Bool {}
        impl Other for Bool {}
        record Wrapped[T] {
            value T
        }
        impl[T] Pick for Wrapped[T] {}
        fn overloaded[Us...](values (Bool, Wrapped[Us]...)) Int
        ensures result >= 0 {
            var total = 0
            comptime for item in values {
                total = total + item.pick(1)
            }
            total
        }
        """)
    rejects(concat(constructed_observation_header(), """
        fn fresh[Us...](values (Bool, Wrapped[Us]...)) Bool
        ensures result {
            var same = true
            comptime for item in values {
                same = same && item.value() == item.value()
            }
            same
        }
        """))
}

test fn mixed_observations_preserve_nested_fields_and_shared_child_effects() {
    let source = concat(composed_bounds_header(), """
        import std.list.push
        import std.list.length
        record Wrapped[T] {
            value T
            log List[Int]
        }
        impl[T] Value for Wrapped[T] {
            fn value(self Wrapped[T]) Int {
                push(self.log, 1)
                0
            }
        }
        impl Value for (Int, Bool) {
            fn value(self (Int, Bool)) Int { 1 }
        }
        fn observed[Us...](log List[Int], values ((Int, Bool), Wrapped[Us]..., Bool)) Int
        ensures length(log) == old(length(log)) {
            var total = 0
            comptime for item in values {
                total = total + item.value()
            }
            total
        }
        """)
    list_length_contract(std.text.join(std.text.split(source,
                "ensures length(log) == old(length(log))"), "ensures result >= 0"), true)
    list_length_contract(source, false)
}
