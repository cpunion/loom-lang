import std.loom.proof.established_predicates
import std.loom.eval.number
import std.loom.eval.floating
import std.loom.eval.flag

// A bare, unconstrained scalar input admits these concrete values. One false
// predicate refutes universal construction; successful probes never prove it.
// Reuse CTFE, including helper bodies, rather than asking SMT to rediscover
// obvious counterexamples at an ordinary checked conversion boundary.
fn refuted_scalar_construction(context Context, value Expr, target Int) Bool {
    if context.fact_head >= 0 || value.kind != ExprKind.Local {
        return false
    }
    let inputs = if value.ty == 1 {
        [number(0), number(1)]
    } else if value.ty == 2 {
        [flag(false), flag(true)]
    } else if value.ty == 5 {
        [floating(0.0), floating(1.0), floating(0.0 / 0.0)]
    } else if value.ty == 3 {
        [Value {
                ty = 3,
                text = "",
                ..unknown()
            }, Value {
                ty = 3,
                text = "x",
                ..unknown()
            }]
    } else {
        new[Value]()
    }
    var index = 0
    while index < length(inputs) {
        match folded_predicate(context.env, target, get(inputs, index)) {
            Result.Ok(checked) => {
                if checked.ty == 2 && checked.number == 0 {
                    return true
                }
            }
            Result.Err(_) => {
            }
        }
        index = index + 1
    }
    false
}

// A constructor may reuse a checked call's normal-return guarantees. Prepare
// its selected invocation and predicate in a private queue; neither proof helpers
// nor a second evaluation enter executable code. Unsupported proofs retain the
// ordinary checked Result boundary, including the separate List isolation check.
fn construction_proof(context Context, node Node, source Node, expected Int, value Expr, target Int) Result[Bool, Failure] {
    let base = base_type(context.env, target)
    let stage = staging(context, node)?
    // Executable/fact calls retain their selected instance. Non-executable
    // templates intentionally have no queued target; instantiate those with
    // the original contextual hint, never a newly inferred result hint.
    let completion = value.kind == ExprKind.Await && length(value.children) == 1
    let selected = if completion {
        get(value.children, 0)
    } else {
        value
    }
    let input = if selected.index == -1 {
        expr_mode(stage, source, expected, false)?
    } else {
        value
    }
    let invoked = if completion {
        get(input.children, 0)
    } else {
        input
    }
    if input.ty != base || (invoked.kind != ExprKind.Call &&
        !(completion && invoked.kind == ExprKind.TaskCall)) {
        return Result.Ok(false)
    }
    let callee = if selected.index == -1 {
        invoked.index
    } else {
        let instance = fact_instance(context.env, selected.index)
        schedule(stage.env, instance.signature, instance.arguments, instance.constants, node)?
    }
    // Argument effects have already happened when the callee is entered.
    // Prove over arbitrary typed invocation snapshots, not by replaying those
    // effects or assuming repeated heap observations are equal.
    let bindings = new[Int]()
    let params = new[Int]()
    let locals = new[Local]()
    let control = ConstructionControl {
        context = context
        bindings = bindings
        params = params
        locals = locals
        bound = []
    }
    let arguments = new[Expr]()
    var index = 0
    while index < length(invoked.children) {
        let argument = get(invoked.children, index)
        let value = if construction_controlled(argument, 0) {
            match construction_control_input(control, argument, 0, 0) {
                Result.Ok(value) => value
                Result.Err(_) => {
                    return Result.Ok(false)
                }
            }
        } else {
            construction_input(context, argument, bindings, params, locals, 0)
        }
        push(arguments, value)
        index = index + 1
    }
    let premises = construction_premises(context, stage, node, bindings, params, locals)
    let call = expression(invoked.kind, invoked.ty, node, invoked.text, callee, arguments, invoked.falls)
    let body = if completion {
        expression(input.kind, input.ty, node, input.text, input.index, expressions(call), input.falls)
    } else {
        call
    }
    construction_body_proof(stage, node,
        construction_control_finish(control, body),
        params, locals, premises, target)
}

fn construction_body_proof(stage Context, node Node, body Expr, params List[Int],
    locals List[Local], premises List[Expr], target Int) Result[Bool, Failure] {
    let base = base_type(stage.env, target)
    let result_local = length(locals)
    push(locals, Local {
            name = "self"
            ty = base
            mutable = false
            is_scoped = false
        })
    let predicate = refinement_expression(predicate_context(stage.env, target, locals, result_local, true)?, target)?
    let program = prepared_in(stage, true)?
    let established = established_construction_premises(program, locals, premises)
    let proof = Function {
        is_async = false
        symbol = -1
        arguments = new[Int]()
        params = params
        result = base
        locals = locals
        preconditions = established
        postconditions = expressions(predicate)
        result_cleanup = new[Expr]()
        result_local = result_local
        body = body
        runtime_name = ""
        span = node.span
    }
    Result.Ok(proves_with_input_invariants(stage, program, proof, true, unrestricted_sequence(stage.env, target)))
}

// Representational weakening retains the input's nominal entry facts. Mutable
// sequences still require the separately checked continuing-predicate/write
// policy; this supplies neither freshness nor alias isolation.
fn construction_view(env Environment, value Expr) Bool {
    if value.kind != ExprKind.Coerce || length(value.children) != 1 {
        return false
    }
    let input = get(value.children, 0)
    let kind = get(env.types, value.ty).kind
    (kind == TypeKind.Record || kind == TypeKind.Tuple || kind == TypeKind.Enum ||
        kind == TypeKind.List || kind == TypeKind.Bytes) &&
    get(env.types, input.ty).kind == TypeKind.Refined && base_type(env, input.ty) == value.ty
}

fn established_construction_premises(program std.loom.typed.Program, locals List[Local], premises List[Expr]) List[Expr] {
    let established = new[Expr]()
    var index = 0
    while index < length(premises) {
        let premise = get(premises, index)
        if predicate_expansion(premise, 0) {
            match established_predicates(program, locals, premise) {
                Result.Ok(expanded) => {
                    var item = 0
                    while item < length(expanded) {
                        push(established, get(expanded, item))
                        item = item + 1
                    }
                }
                Result.Err(_) => {
                    // An opaque candidate supplies no evidence, but must not
                    // hide an independent, already established scalar fact.
                }
            }
        } else {
            push(established, premise)
        }
        index = index + 1
    }
    established
}

// Compact actual binding IDs in one pass. Sequential substitutions could
// confuse an original binding with a newly assigned compact ID.
fn construction_fact(context Context, value Expr, bindings List[Int],
    params List[Int], locals List[Local]) Expr {
    if value.kind == ExprKind.Local {
        var slot = 0
        while slot < length(bindings) && get(bindings, slot) != value.index {
            slot = slot + 1
        }
        if slot == length(bindings) {
            let local = get(context.locals, value.index)
            push(bindings, value.index)
            push(params, local.ty)
            push(locals, local)
        }
        return Expr {
            kind = value.kind
            ty = value.ty
            span = value.span
            text = ""
            index = slot
            children = value.children
            arms = value.arms
            falls = value.falls
        }
    }
    let children = new[Expr]()
    var index = 0
    while index < length(value.children) {
        push(children, construction_fact(context, get(value.children, index), bindings, params, locals))
        index = index + 1
    }
    Expr {
        kind = value.kind
        ty = value.ty
        span = value.span
        text = value.text
        index = value.index
        children = children
        arms = value.arms
        falls = value.falls
    }
}

// Keep immutable scalar evidence and fresh aggregate shape. Everything else is an
// independent typed snapshot: proof preparation must not replay effects or
// identify separate observations of mutable storage.
fn construction_input(context Context, value Expr, bindings List[Int],
    params List[Int], locals List[Local], depth Int) Expr {
    if fact_size(context, value, 0) > 0 {
        return construction_fact(context, value, bindings, params, locals)
    }
    if depth < 64 && construction_view(context.env, value) {
        let input = construction_input(context, get(value.children, 0), bindings, params, locals, depth + 1)
        return Expr {
            kind = value.kind
            ty = value.ty
            span = value.span
            text = value.text
            index = value.index
            children = expressions(input)
            arms = value.arms
            falls = value.falls
        }
    }
    if depth < 64 && (value.kind == ExprKind.Record || value.kind == ExprKind.List || value.kind == ExprKind.Variant) {
        let fields = new[Expr]()
        var index = 0
        while index < length(value.children) {
            let field = get(value.children, index)
            if value.kind == ExprKind.List || value.kind == ExprKind.Variant {
                push(fields, construction_input(context, field, bindings, params, locals, depth + 1))
                index = index + 1
                continue
            }
            let input = construction_input(context, get(field.children, 0), bindings, params, locals, depth + 1)
            push(fields, Expr {
                    kind = field.kind
                    ty = field.ty
                    span = field.span
                    text = field.text
                    index = field.index
                    children = expressions(input)
                    arms = field.arms
                    falls = field.falls
                })
            index = index + 1
        }
        return Expr {
            kind = value.kind
            ty = value.ty
            span = value.span
            text = value.text
            index = value.index
            children = fields
            arms = value.arms
            falls = value.falls
        }
    }
    if depth < 64 && value.kind != ExprKind.Variant && closed_inline_value(value, 0) {
        let children = new[Expr]()
        var index = 0
        while index < length(value.children) {
            push(children, construction_input(context, get(value.children, index), bindings, params, locals, depth + 1))
            index = index + 1
        }
        return Expr {
            kind = value.kind
            ty = value.ty
            span = value.span
            text = value.text
            index = value.index
            children = children
            arms = value.arms
            falls = value.falls
        }
    }
    let snapshot = length(params)
    push(bindings, -1)
    push(params, value.ty)
    push(locals, Local {
            name = "input"
            ty = value.ty
            mutable = false
            is_scoped = false
        })
    Expr {
        kind = ExprKind.Local
        ty = value.ty
        span = value.span
        text = ""
        index = snapshot
        children = new[Expr]()
        arms = new[Arm]()
        falls = true
    }
}

// Call indices are queue-local. Re-schedule the actual selected instance,
// including type and static arguments, before compacting its scalar bindings.
fn construction_fact_calls(context Context, stage Context, node Node, value Expr) Result[Expr, Failure] {
    let children = new[Expr]()
    var index = 0
    while index < length(value.children) {
        push(children, construction_fact_calls(context, stage, node, get(value.children, index))?)
        index = index + 1
    }
    var target = value.index
    if value.kind == ExprKind.Call {
        let instance = fact_instance(context.env, value.index)
        target = schedule(stage.env, instance.signature, instance.arguments, instance.constants, node)?
    }
    Result.Ok(Expr {
            kind = value.kind
            ty = value.ty
            span = value.span
            text = value.text
            index = target
            children = children
            arms = value.arms
            falls = value.falls
        })
}

fn construction_premises(context Context, stage Context, node Node, bindings List[Int],
    params List[Int], locals List[Local]) List[Expr] {
    let premises = new[Expr]()
    var head = context.fact_head
    var steps = 0
    while head >= 0 && steps < 256 {
        let fact = get(context.facts, head)
        // Candidate calls have immutable scalar inputs, never heap reads.
        // Actual helper expansion decides whether their bodies are supported.
        match construction_fact_calls(context, stage, node, fact.predicate) {
            Result.Ok(predicate) => push(premises, construction_fact(context, predicate, bindings, params, locals))
            Result.Err(_) => {
            }
        }
        head = fact.previous
        steps = steps + 1
    }
    premises
}

fn flow_construction_proof(context Context, node Node, value Expr,
    target Int) Result[Bool, Failure] {
    let controlled = construction_controlled(value, 0)
    let kind = get(context.env.types, base_type(context.env, target)).kind
    if controlled && (kind == TypeKind.List || kind == TypeKind.Bytes) {
        return Result.Ok(false)
    }
    let stage = staging(context, node)?
    let env = helper_environment(stage.env)
    let bindings = new[Int]()
    let params = new[Int]()
    let locals = new[Local]()
    let control = ConstructionControl {
        context = context
        bindings = bindings
        params = params
        locals = locals
        bound = []
    }
    let input = if controlled {
        match construction_control_input(control, value, 0, 0) {
            Result.Ok(value) => value
            Result.Err(_) => {
                return Result.Ok(false)
            }
        }
    } else {
        construction_input(context, value, bindings, params, locals, 0)
    }
    let premises = construction_premises(context, stage, node, bindings, params, locals)
    let body = construction_control_finish(control, input)
    let scope = predicate_context(env, target, locals, 0, true)?
    construction_body_proof(scope, node, body, params, locals, premises, target)
}

fn proved_construction(context Context, node Node, source Node, expected Int, value Expr, target Int) Result[Bool, Failure] {
    if context.env.expanding_helpers || context.env.stage_depth >= 32 {
        return Result.Ok(false)
    }
    if value.kind == ExprKind.Record || value.kind == ExprKind.List || value.kind == ExprKind.Variant || construction_view(context.env, value) ||
    (value.kind != ExprKind.Call && value.kind != ExprKind.Await && construction_controlled(value, 0)) {
        return flow_construction_proof(context, node, value, target)
    }
    // Re-type only a known invocation, never consume an opaque saved Task a
    // second time merely to attempt an optional predicate proof.
    if value.kind == ExprKind.Await && (length(value.children) != 1 ||
        (get(value.children, 0).kind != ExprKind.Call && get(value.children, 0).kind != ExprKind.TaskCall)) {
        return Result.Ok(false)
    }
    if value.kind != ExprKind.Call && value.kind != ExprKind.Await {
        // Immutable scalar expressions retain caller facts. All other values
        // enter the same proof as independent typed snapshots: their declared
        // invariants remain valid, but no mutable observation or input effect
        // is replayed. This grants neither freshness nor alias isolation.
        if refuted_scalar_construction(context, value, target) {
            return Result.Ok(false)
        }
        return flow_construction_proof(context, node, value, target)
    }
    // Unknown predicate proofs keep the Result boundary, but a source callee's
    // mandatory checking failure must not be hidden as a constructor mismatch.
    construction_proof(context, node, source, expected, value, target)
}
