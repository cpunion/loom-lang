// Proof-only families use counted loops over symbolic nonnegative widths.
// Opaque elements can only be observed through declared method summaries:
// each call supplies a fresh result, never element identity or type equality.
// Native specializations still check every element, resource and effect.
record PackProofElement {
    name Text
    pack Int
}

fn pack_proof_width(index Int) Text {
    concat("$packwidth#", std.int.to_text(index))
}

fn pack_proof_element_type(index Int) Text {
    concat("$packelement#", std.int.to_text(index))
}

fn pack_proof_element_value(index Int) Text {
    concat("$packvalue#", std.int.to_text(index))
}

fn pack_proof_sources(node Node) List[Text] {
    let names = pack_names(declared_packs(node))
    let parameters = group(node, NodeKind.Parameters)
    var index = 0
    while index < length(parameters) {
        let parameter = get(parameters, index)
        if has_type_expansion(child(parameter, 0)) {
            push(names, parameter.value)
        }
        index = index + 1
    }
    names
}

fn pack_forwarded_parameter(declaration Node, argument Node) Int {
    let source = if argument.kind == NodeKind.Spread {
        child(argument, 0)
    } else {
        argument
    }
    if source.kind != NodeKind.Name {
        return -1
    }
    let parameters = group(declaration, NodeKind.Parameters)
    var index = 0
    while index < length(parameters) {
        let parameter = get(parameters, index)
        if parameter.value == source.value && has_type_expansion(child(parameter, 0)) {
            return index
        }
        index = index + 1
    }
    -1
}

fn pack_proof_loop_width(declaration Node, source Node) Int {
    if source.kind != NodeKind.Name {
        return -1
    }
    let packs = declared_packs(declaration)
    let parameters = group(declaration, NodeKind.Parameters)
    var index = 0
    while index < length(parameters) {
        let parameter = get(parameters, index)
        if parameter.value == source.value {
            let ty = child(parameter, 0)
            let pattern = if ty.kind == NodeKind.Spread {
                child(ty, 0)
            } else if ty.kind == NodeKind.TupleType && length(ty.children) == 1 && child(ty, 0).kind == NodeKind.Spread {
                child(child(ty, 0), 0)
            } else {
                return -1
            }
            let names = expansion_packs(pattern, pack_names(packs))
            if length(names) == 1 {
                return get(names, 0)
            }
            return -1
        }
        index = index + 1
    }
    index = 0
    while index < length(packs) {
        if get(packs, index).value == source.value {
            return index
        }
        index = index + 1
    }
    -1
}

// A structural tuple is one ordered sequence, not one loop per expansion.
// Its affine extent retains fixed fields, repeated packs and independent groups.
// Elementwise expansions use a shared width; ordinary shape checking establishes
// that their participating packs have equal widths in every specialization.
fn pack_proof_loop_extent(declaration Node, source Node) Option[Node] {
    let width = pack_proof_loop_width(declaration, source)
    if width >= 0 {
        return Option.Some(pack_node(source, NodeKind.Name, pack_proof_width(width), new[Node]()))
    }
    let parameters = group(declaration, NodeKind.Parameters)
    let names = pack_names(declared_packs(declaration))
    var index = 0
    while index < length(parameters) {
        let parameter = get(parameters, index)
        let ty = child(parameter, 0)
        if source.kind == NodeKind.Name && parameter.value == source.value &&
        ty.kind == NodeKind.TupleType && has_type_expansion(ty) {
            var extent = pack_node(source, NodeKind.Integer, "0", new[Node]())
            var field = 0
            while field < length(ty.children) {
                let pattern = child(ty, field)
                var count = pack_node(pattern, NodeKind.Integer, "1", new[Node]())
                if pattern.kind == NodeKind.Spread {
                    let selected = expansion_packs(child(pattern, 0), names)
                    if length(selected) == 0 {
                        return Option.None
                    }
                    count = pack_node(pattern, NodeKind.Name, pack_proof_width(get(selected, 0)), new[Node]())
                }
                extent = pack_node(pattern, NodeKind.Binary, "+", [extent, count])
                field = field + 1
            }
            return Option.Some(extent)
        }
        index = index + 1
    }
    Option.None
}

fn pack_proof_control(node Node) Bool {
    if node.kind == NodeKind.Break || node.kind == NodeKind.Continue {
        return true
    }
    var index = 0
    while index < length(node.children) {
        if pack_proof_control(child(node, index)) {
            return true
        }
        index = index + 1
    }
    false
}

// Type iteration and structural element patterns are not opaque value inputs.
fn pack_proof_value_pack(declaration Node, source Node, width Int) Int {
    let parameters = group(declaration, NodeKind.Parameters)
    var index = 0
    while index < length(parameters) {
        let parameter = get(parameters, index)
        if parameter.value == source.value {
            let ty = child(parameter, 0)
            let spread = if ty.kind == NodeKind.TupleType {
                child(ty, 0)
            } else {
                ty
            }
            let pattern = child(spread, 0)
            if pattern.kind == NodeKind.Type && pattern.value == get(declared_packs(declaration), width).value {
                return width
            }
            return -1
        }
        index = index + 1
    }
    -1
}

fn pack_proof_opaque_contract(node Node, name Text) Bool {
    if pack_root(node, name) ||
    ((node.kind == NodeKind.Call || node.kind == NodeKind.Construct || node.kind == NodeKind.RecordPattern) && slice(node.value, 0, first_dot(node.value)) == name) {
        return true
    }
    var index = 0
    while index < length(node.children) {
        if pack_proof_opaque_contract(child(node, index), name) {
            return true
        }
        index = index + 1
    }
    false
}

fn pack_proof_observation(env Environment, owner Int, pack Int, node Node) Result[Bool, Failure] {
    let inherited = method_pack_source(env, owner)
    let source = if inherited >= 0 {
        inherited
    } else {
        owner
    }
    let bounds = get(declared_packs(symbol(env, source).node), pack).children
    var found = false
    var index = 0
    while index < length(bounds) {
        let capability = required_concept(env, source, get(bounds, index))?
        let methods = symbol(env, capability).node.children
        var member = 0
        while member < length(methods) {
            let method = get(methods, member)
            let parameters = group(method, NodeKind.Parameters)
            if method.kind == NodeKind.Function && method.value == node.value &&
            (length(declared_packs(method)) != 0 || length(parameters) == length(child(node, 2).children) + 1) {
                let returns = group(method, NodeKind.ReturnType)
                // Ordinary signature/summary checking owns type inference,
                // pack widths, static arguments and supported result shapes. The family
                // guard only prevents the abstract receiver escaping into
                // type selection or value-dependent contracts.
                var supported = has(method, NodeKind.Ensures) && length(returns) <= 1
                if supported {
                    if length(returns) == 1 {
                        supported = !pack_proof_opaque_contract(get(returns, 0), "Self")
                    }
                    if has(method, NodeKind.TypeParameters) {
                        supported = supported && !pack_proof_opaque_contract(child(method, part(method, NodeKind.TypeParameters)), "Self")
                    }
                }
                var argument = 1
                while argument < length(parameters) {
                    supported = supported && !mentions_pack(child(get(parameters, argument), 0), "Self")
                    argument = argument + 1
                }
                var clause = 0
                while clause < length(method.children) {
                    let condition = child(method, clause)
                    if condition.kind == NodeKind.Requires || condition.kind == NodeKind.Ensures {
                        supported = supported && !pack_proof_opaque_contract(condition, "Self") &&
                        !pack_proof_opaque_contract(condition, get(parameters, 0).value)
                    }
                    clause = clause + 1
                }
                if !supported {
                    return Result.Err(failure(env, owner, node,
                            "variadic element observations require a concept method with a declared postcondition and no receiver-dependent types, contracts or arguments"))
                }
                found = true
            }
            member = member + 1
        }
        index = index + 1
    }
    if !found {
        return Result.Err(failure(env, owner, node, "variadic element observation needs a declared pack concept requirement"))
    }
    Result.Ok(true)
}

fn pack_proof_tree(env Environment, owner Int, declaration Node, node Node, erased List[Text], elements List[PackProofElement], count List[Int], depth Int) Result[Node, Failure] {
    if depth >= 64 {
        return Result.Err(failure(env, owner, node, "variadic contract proof depth exceeded"))
    }
    if node.kind == NodeKind.Call {
        let arguments = child(node, 1)
        var forwarded = false
        var index = 0
        while index < length(arguments.children) {
            forwarded = forwarded || pack_forwarded_parameter(declaration, child(arguments, index)) >= 0
            index = index + 1
        }
        if forwarded {
            let values = new[Node]()
            index = 0
            while index < length(arguments.children) {
                let argument = child(arguments, index)
                push(values, if pack_forwarded_parameter(declaration, argument) >= 0 {
                        argument
                    } else {
                        pack_proof_tree(env, owner, declaration, argument, erased, elements, count, depth + 1)?
                    })
                index = index + 1
            }
            // Keep symbolic type words until the forwarding matcher can bind
            // them jointly with the actual arguments. They are not values.
            let types = child(node, 0)
            return Result.Ok(pack_node(node, NodeKind.Call, concat("$packcall#", node.value),
                    [types, pack_node(arguments, NodeKind.Arguments, "", values)]))
        }
    }
    // The parser retains a dotted named call; computed receivers use MethodCall.
    if node.kind == NodeKind.Call && first_dot(node.value) < length(node.value) {
        let split = first_dot(node.value)
        let name = slice(node.value, 0, split)
        var element = 0
        while element < length(elements) {
            if get(elements, element).name == name && get(elements, element).pack >= 0 {
                let member = slice(node.value, split + 1, length(node.value))
                let receiver = pack_node(node, NodeKind.Name, name, new[Node]())
                let call = pack_node(node, NodeKind.MethodCall, member, [receiver, child(node, 0), child(node, 1)])
                return pack_proof_tree(env, owner, declaration, call, erased, elements, count, depth + 1)
            }
            element = element + 1
        }
    }
    if node.kind == NodeKind.Discard && child(node, 0).kind == NodeKind.Name {
        var index = 0
        while index < length(elements) {
            if child(node, 0).value == get(elements, index).name {
                return Result.Ok(pack_node(node, NodeKind.Block, "", new[Node]()))
            }
            index = index + 1
        }
    }
    if node.kind == NodeKind.MethodCall && child(node, 0).kind == NodeKind.Name {
        var element = 0
        while element < length(elements) {
            let selected = get(elements, element)
            if child(node, 0).value == selected.name && selected.pack >= 0 {
                discard pack_proof_observation(env, owner, selected.pack, node)?
                let receiver = pack_node(child(node, 0), NodeKind.Name, pack_proof_element_value(selected.pack), new[Node]())
                let types = pack_proof_tree(env, owner, declaration, child(node, 1), erased, elements, count, depth + 1)?
                let arguments = pack_proof_tree(env, owner, declaration, child(node, 2), erased, elements, count, depth + 1)?
                return Result.Ok(pack_node(node, node.kind, node.value, [receiver, types, arguments]))
            }
            element = element + 1
        }
    }
    var index = 0
    while index < length(erased) {
        let name = get(erased, index)
        if pack_root(node, name) ||
        ((node.kind == NodeKind.Call || node.kind == NodeKind.Construct || node.kind == NodeKind.RecordPattern) && slice(node.value, 0, first_dot(node.value)) == name) ||
        pack_local_binds(node, name) ||
        (node.kind == NodeKind.Parameter && node.value == name) ||
        (node.kind == NodeKind.Arm && pack_pattern_binds(child(node, 0), name)) ||
        ((node.kind == NodeKind.ComptimeFor || node.kind == NodeKind.ComptimeMap) && iteration_binds(node, name)) {
            return Result.Err(failure(env, owner, node,
                    "variadic contract proof permits pack elements only as declared method receivers or discarded values; type-dependent induction is not supported"))
        }
        index = index + 1
    }
    if node.kind == NodeKind.ComptimeFor {
        let source = child(node, 0)
        match pack_proof_loop_extent(declaration, source) {
            Option.Some(extent) => {
                if pack_proof_control(child(node, 1)) {
                    return Result.Err(failure(env, owner, node, "variadic contract induction cannot change the target of break or continue"))
                }
                let nested = new[Text]()
                index = 0
                while index < length(erased) {
                    push(nested, get(erased, index))
                    index = index + 1
                }
                push(nested, node.value)
                let ignored = new[PackProofElement]()
                index = 0
                while index < length(elements) {
                    push(ignored, get(elements, index))
                    index = index + 1
                }
                let width = pack_proof_loop_width(declaration, source)
                push(ignored, PackProofElement {
                        name = node.value
                        pack = if width >= 0 {
                            pack_proof_value_pack(declaration, source, width)
                        } else {
                            -1
                        }
                    })
                let identity = get(count, 0)
                set(count, 0, identity + 1)
                let cursor = concat("$packindex#", std.int.to_text(identity))
                let position = pack_node(node, NodeKind.Name, cursor, new[Node]())
                let statements = new[Node]()
                let key = part(node, NodeKind.IterationKey)
                if key >= 0 {
                    push(statements, pack_binding(child(node, key), child(node, key).value, position, false))
                }
                push(statements, pack_proof_tree(env, owner, declaration, child(node, 1), nested, ignored, count, depth + 1)?)
                let increment = pack_node(node, NodeKind.Binary, "+", [position, pack_node(node, NodeKind.Integer, "1", new[Node]())])
                push(statements, pack_node(node, NodeKind.Assign, cursor, source_nodes(increment)))
                let guard = pack_node(node, NodeKind.Binary, "<", [position, extent])
                let loop = pack_node(node, NodeKind.While, "", [guard, pack_node(node, NodeKind.Block, "", statements)])
                let start = pack_node(node, NodeKind.Var, cursor, source_nodes(pack_node(node, NodeKind.Integer, "0", new[Node]())))
                return Result.Ok(pack_node(node, NodeKind.Block, "", [start, loop, pack_node(node, NodeKind.Block, "", new[Node]())]))
            }
            Option.None => {
            }
        }
    }
    let children = new[Node]()
    index = 0
    while index < length(node.children) {
        push(children, pack_proof_tree(env, owner, declaration, child(node, index), erased, elements, count, depth + 1)?)
        index = index + 1
    }
    Result.Ok(pack_node(node, node.kind, node.value, children))
}

fn pack_contract_declaration(env Environment, owner Int) Result[Node, Failure] {
    let node = symbol(env, owner).node
    let packs = declared_packs(node)
    let erased = pack_proof_sources(node)
    let children = new[Node]()
    let count = ints(0)
    var index = 0
    while index < length(node.children) {
        let member = child(node, index)
        if member.kind == NodeKind.TypeParameters || member.kind == NodeKind.Parameters {
            let members = new[Node]()
            var selected = 0
            while selected < length(member.children) {
                let input = child(member, selected)
                if input.kind != NodeKind.TypePack && !(input.kind == NodeKind.Parameter && has_type_expansion(child(input, 0))) {
                    push(members, input)
                }
                selected = selected + 1
            }
            selected = 0
            while selected < length(packs) {
                if member.kind == NodeKind.TypeParameters {
                    let pack = get(packs, selected)
                    push(members, pack_node(pack, NodeKind.Name, pack_proof_element_type(selected), pack.children))
                } else {
                    push(members, pack_node(member, NodeKind.Parameter, pack_proof_element_value(selected), source_nodes(pack_node(member, NodeKind.Type, pack_proof_element_type(selected), new[Node]()))))
                    push(members, pack_node(member, NodeKind.Parameter, pack_proof_width(selected), source_nodes(pack_node(member, NodeKind.Type, "Int", new[Node]()))))
                }
                selected = selected + 1
            }
            push(children, pack_node(member, member.kind, member.value, members))
        } else {
            push(children, pack_proof_tree(env, owner, node, member, erased, new[PackProofElement](), count, 0)?)
        }
        index = index + 1
    }
    // Implementations inherit the declaration's symbolic-width domain; this
    // is not permission to strengthen a public method's preconditions.
    let parent = symbol(env, owner).owner
    if parent < 0 || symbol(env, parent).node.kind != NodeKind.Impl {
        index = 0
        while index < length(packs) {
            let width = pack_node(node, NodeKind.Name, pack_proof_width(index), new[Node]())
            let guard = pack_node(node, NodeKind.Binary, ">=", [width, pack_node(node, NodeKind.Integer, "0", new[Node]())])
            push(children, pack_node(node, NodeKind.Requires, "", source_nodes(guard)))
            index = index + 1
        }
    }
    Result.Ok(pack_node(node, NodeKind.Function, node.value, children))
}
