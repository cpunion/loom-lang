// An impl family is selected by target shape, then checked with abstract
// elements for those widths. Expanded owners are private; source spans and
// nominal data identities remain those of the original declarations.
fn impl_pack_member(env Environment, owner Int) Bool {
    let parent = symbol(env, owner).owner
    parent >= 0 && symbol(env, parent).node.kind == NodeKind.Impl &&
    pack_parameter(symbol(env, parent).node) >= 0
}

fn validate_impl_pack(env Environment, owner Int) Result[Bool, Failure] {
    let node = symbol(env, owner).node
    let parameters = group(node, NodeKind.TypeParameters)
    if !has_type_expansion(child(node, 1)) {
        return Result.Err(failure(env, owner, node, "an implementation pack needs a structural target expansion"))
    }
    var index = 0
    while index < length(parameters) {
        let parameter = get(parameters, index)
        if !mentions_pack(child(node, 1), parameter.value) {
            return Result.Err(failure(env, owner, parameter, "every implementation parameter must occur in its target type"))
        }
        var bound = 0
        while bound < length(parameter.children) {
            let capability = required_concept(env, owner, child(parameter, bound))?
            var previous = 0
            while previous < bound {
                if required_concept(env, owner, child(parameter, previous))? == capability {
                    return Result.Err(failure(env, owner, child(parameter, bound), "duplicate concept requirement"))
                }
                previous = previous + 1
            }
            bound = bound + 1
        }
        index = index + 1
    }
    discard impl_target_schema(env, owner, child(node, 1), false, 0)?
    let capability = required_concept(env, owner, child(node, 0))?
    index = 0
    while index < length(env.source.symbols) {
        let member = symbol(env, index)
        if member.owner == owner {
            if member.node.kind == NodeKind.Function {
                if has(member.node, NodeKind.Requires) {
                    return Result.Err(failure(env, index, member.node, "an implementation cannot add an undeclared precondition"))
                }
                var found = false
                var declaration = 0
                while declaration < length(env.source.symbols) {
                    let expected = symbol(env, declaration)
                    found = found || (expected.owner == capability && expected.node.kind == NodeKind.Function && expected.name == member.name)
                    declaration = declaration + 1
                }
                if !found {
                    return Result.Err(failure(env, index, member.node, "implementation method signature does not match its concept"))
                }
            }
            let local = group(member.node, NodeKind.TypeParameters)
            var parameter = 0
            while parameter < length(local) {
                var outer = 0
                while outer < length(parameters) {
                    if get(local, parameter).value == get(parameters, outer).value {
                        return Result.Err(failure(env, index, get(local, parameter), "a member type parameter cannot shadow an implementation parameter"))
                    }
                    outer = outer + 1
                }
                parameter = parameter + 1
            }
        }
        index = index + 1
    }
    index = 0
    while index < length(env.source.symbols) {
        let declaration = symbol(env, index)
        if declaration.owner == capability && declaration.node.kind == NodeKind.Function && !has(declaration.node, NodeKind.Block) {
            var found = false
            var member = 0
            while member < length(env.source.symbols) {
                let supplied = symbol(env, member)
                found = found || (supplied.owner == owner && supplied.node.kind == NodeKind.Function && supplied.name == declaration.name)
                member = member + 1
            }
            if !found {
                return Result.Err(failure(env, owner, node, "implementation is missing a required concept method"))
            }
        }
        index = index + 1
    }
    Result.Ok(true)
}

// Keep spreads in the overlap schema. Fixed constructors and the anchored
// prefix/suffix can prove disjointness; unknown sequence unification rejects
// conservatively rather than sampling arities or depending on declaration order.
fn impl_target_schema(env Environment, owner Int, node Node, element Bool, depth Int) Result[Node, Failure] {
    if depth >= 64 {
        return Result.Err(failure(env, owner, node, "implementation target nesting limit exceeded"))
    }
    if node.kind == NodeKind.Spread {
        let names = pack_names(declared_packs(symbol(env, owner).node))
        var selected = false
        var index = 0
        while index < length(names) {
            selected = selected || mentions_pack(child(node, 0), get(names, index))
            index = index + 1
        }
        if !selected {
            return Result.Err(failure(env, owner, node, "type expansion must use this declaration's pack"))
        }
        return Result.Ok(pack_node(node, NodeKind.Spread, "", source_nodes(impl_target_schema(env, owner, child(node, 0), true, depth + 1)?)))
    }
    let parameters = group(symbol(env, owner).node, NodeKind.TypeParameters)
    var index = 0
    while index < length(parameters) {
        let parameter = get(parameters, index)
        if pack_root(node, parameter.value) {
            if node.value != parameter.value || length(node.children) != 0 {
                return Result.Err(failure(env, owner, node, "implementation targets cannot contain associated projections"))
            }
            if parameter.kind == NodeKind.TypePack && !element {
                return Result.Err(failure(env, owner, node, "expand a type pack with ...; it is not one type"))
            }
            return Result.Ok(pack_node(node, NodeKind.Type, "$parameter", new[Node]()))
        }
        index = index + 1
    }
    let children = new[Node]()
    if node.kind == NodeKind.Type && node.value != "List" && node.value != "Task" {
        let nominal = find_data(env, owner, node, node.value)?
        if nominal >= 0 && type_pack_count(symbol(env, nominal).node) > 1 {
            let parameters = group(symbol(env, nominal).node, NodeKind.TypeParameters)
            if length(node.children) != length(parameters) {
                return Result.Err(failure(env, owner, node, "independent data packs need one explicit group per declared slot"))
            }
            index = 0
            while index < length(parameters) {
                let member = child(node, index)
                if get(parameters, index).kind == NodeKind.TypePack {
                    if member.kind != NodeKind.Spread {
                        return Result.Err(failure(env, owner, member, "expand each nominal pack group with ..."))
                    }
                    let tuple = type_group_pattern(member)
                    push(children, impl_target_schema(env, owner, tuple, element, depth + 1)?)
                } else {
                    push(children, impl_target_schema(env, owner, member, element, depth + 1)?)
                }
                index = index + 1
            }
            return Result.Ok(pack_node(node, NodeKind.Type, concat("nominal#", std.int.to_text(nominal)), children))
        }
    }
    if node.kind == NodeKind.FunctionType {
        let inputs = group(node, NodeKind.Parameters)
        index = 0
        while index < length(inputs) {
            push(children, impl_target_schema(env, owner, get(inputs, index), element, depth + 1)?)
            index = index + 1
        }
        // The result is an anchored last element, even when omitted.
        let returns = group(node, NodeKind.ReturnType)
        push(children, if length(returns) == 0 {
                pack_node(node, NodeKind.Type, "0", new[Node]())
            } else {
                impl_target_schema(env, owner, get(returns, 0), element, depth + 1)?
            })
        return Result.Ok(pack_node(node, NodeKind.FunctionType, "function", children))
    }
    index = 0
    while index < length(node.children) {
        push(children, impl_target_schema(env, owner, child(node, index), element, depth + 1)?)
        index = index + 1
    }
    if node.kind == NodeKind.TupleType {
        return Result.Ok(pack_node(node, node.kind, "tuple", children))
    }
    if node.kind != NodeKind.Type {
        return Result.Err(failure(env, owner, node, "expected an implementation target type pattern"))
    }
    let constructor = if node.value == "List" || node.value == "Task" {
        if length(children) != 1 || child(node, 0).kind == NodeKind.Spread {
            return Result.Err(failure(env, owner, node, "List and Task require one element type"))
        }
        node.value
    } else {
        let selected = find_data(env, owner, node, node.value)?
        if selected >= 0 {
            let declaration = symbol(env, selected).node
            let count = length(group(declaration, NodeKind.TypeParameters))
            if !has_type_expansion(node) && ((data_pack(declaration) && length(children) < count - 1) ||
                (!data_pack(declaration) && length(children) != count)) {
                return Result.Err(failure(env, owner, node, "wrong number of type arguments"))
            }
            concat("nominal#", std.int.to_text(selected))
        } else {
            let ty = resolve_bound(header_environment(env), owner, node, new[Int](), new[Requirement](), 0)?
            std.int.to_text(ty)
        }
    }
    Result.Ok(pack_node(node, NodeKind.Type, constructor, children))
}

fn impl_sequence_prefix(nodes List[Node]) Int {
    var index = 0
    while index < length(nodes) && get(nodes, index).kind != NodeKind.Spread {
        index = index + 1
    }
    index
}

fn impl_sequence_suffix(nodes List[Node]) Int {
    var index = length(nodes)
    while index > 0 && get(nodes, index - 1).kind != NodeKind.Spread {
        index = index - 1
    }
    length(nodes) - index
}

fn impl_schemas_overlap(first Node, second Node) Bool {
    if first.value == "$parameter" || second.value == "$parameter" {
        return true
    }
    if first.kind != second.kind || first.value != second.value {
        return false
    }
    let a = first.children
    let b = second.children
    let ap = impl_sequence_prefix(a)
    let bp = impl_sequence_prefix(b)
    let af = ap == length(a)
    let bf = bp == length(b)
    if af && bf && length(a) != length(b) {
        return false
    }
    let as = if af {
        0
    } else {
        impl_sequence_suffix(a)
    }
    let bs = if bf {
        0
    } else {
        impl_sequence_suffix(b)
    }
    if (af && length(a) < bp + bs) || (bf && length(b) < ap + as) {
        return false
    }
    var index = 0
    while index < ap && index < bp {
        if !impl_schemas_overlap(get(a, index), get(b, index)) {
            return false
        }
        index = index + 1
    }
    index = 0
    let tail_a = if af {
        length(a)
    } else {
        as
    }
    let tail_b = if bf {
        length(b)
    } else {
        bs
    }
    while index < tail_a && index < tail_b {
        if !impl_schemas_overlap(get(a, length(a) - index - 1), get(b, length(b) - index - 1)) {
            return false
        }
        index = index + 1
    }
    true
}

fn implementation_overlap(env Environment, first Implementation, second Implementation) Result[Bool, Failure] {
    if first.state >= 0 && second.state >= 0 {
        return overlapping(env, first, second)
    }
    let a = if first.state < 0 {
        impl_target_schema(env, first.symbol, child(symbol(env, first.symbol).node, 1), false, 0)?
    } else {
        impl_type_schema(env, first.ty, symbol(env, first.symbol).node)
    }
    let b = if second.state < 0 {
        impl_target_schema(env, second.symbol, child(symbol(env, second.symbol).node, 1), false, 0)?
    } else {
        impl_type_schema(env, second.ty, symbol(env, second.symbol).node)
    }
    Result.Ok(impl_schemas_overlap(a, b))
}

fn impl_type_schema(env Environment, ty Int, node Node) Node {
    let shape = get(env.types, ty)
    let children = new[Node]()
    if length(shape.pack_widths) > 1 {
        let parameters = group(symbol(env, shape.symbol).node, NodeKind.TypeParameters)
        var parameter = 0
        var offset = 0
        var pack = 0
        while parameter < length(parameters) {
            if get(parameters, parameter).kind == NodeKind.TypePack {
                let width = get(shape.pack_widths, pack)
                let elements = new[Node]()
                var element = 0
                while element < width {
                    push(elements, impl_type_schema(env, get(shape.arguments, offset + element), node))
                    element = element + 1
                }
                push(children, pack_node(node, NodeKind.TupleType, "tuple", elements))
                offset = offset + width
                pack = pack + 1
            } else {
                push(children, impl_type_schema(env, get(shape.arguments, offset), node))
                offset = offset + 1
            }
            parameter = parameter + 1
        }
        return pack_node(node, NodeKind.Type, concat("nominal#", std.int.to_text(shape.symbol)), children)
    }
    var index = 0
    while index < length(shape.arguments) {
        push(children, impl_type_schema(env, get(shape.arguments, index), node))
        index = index + 1
    }
    if shape.kind == TypeKind.Parameter {
        return pack_node(node, NodeKind.Type, "$parameter", children)
    }
    if shape.kind == TypeKind.Tuple {
        return pack_node(node, NodeKind.TupleType, "tuple", children)
    }
    if shape.kind == TypeKind.Function {
        return pack_node(node, NodeKind.FunctionType, "function", children)
    }
    let constructor = if shape.kind == TypeKind.List {
        "List"
    } else if shape.kind == TypeKind.Task {
        "Task"
    } else if
    shape.kind == TypeKind.Record || shape.kind == TypeKind.Enum || shape.kind == TypeKind.Refined {
        concat("nominal#", std.int.to_text(shape.symbol))
    } else if shape.kind == TypeKind.Dyn {
        concat("dyn#", std.int.to_text(get(env.interfaces, shape.symbol).symbol))
    } else {
        std.int.to_text(ty)
    }
    pack_node(node, NodeKind.Type, constructor, children)
}

fn impl_pack_shape(env Environment, owner Int, node Node, ty Int) Result[List[Int], Failure] {
    let schema = impl_target_schema(env, owner, node, false, 0)?
    if !impl_schemas_overlap(schema, impl_type_schema(env, ty, node)) {
        return Result.Ok(new[Int]())
    }
    let names = pack_names(declared_packs(symbol(env, owner).node))
    let rows = new[List[Int]]()
    var widths = new[Int]()
    var round = 0
    while round <= length(names) {
        shape_type_equations(env, node, ty, names, rows, widths, 0, true)
        let next = partial_pack_shape(rows, length(names))
        if length(next) == 0 {
            return Result.Ok(next)
        }
        if same(next, widths) {
            return Result.Ok(solved_pack_shape(rows, length(names)))
        }
        widths = next
        round = round + 1
    }
    Result.Ok(solved_pack_shape(rows, length(names)))
}

fn impl_arguments(env Environment, header Implementation, ty Int) List[Int] {
    let arguments = new[Int]()
    var index = 0
    while index < length(type_parameters(env, header.symbol)) {
        push(arguments, -1)
        index = index + 1
    }
    if !infer(env, header.ty, ty, arguments) {
        return ints(-1)
    }
    arguments
}

// Admission/dispatch demand only this concept's families. Ordinary lookup is
// a pure read over its resolved headers, with no expansion or error wrapper.
fn demand_implementations(env Environment, ty Int, capability Int) Result[Bool, Failure] {
    let protocol = get(env.concepts, concept_index(env, capability))
    var index = 0
    while index < length(protocol.families) {
        let source = get(protocol.families, index)
        let header = get(env.implementations, source)
        let widths = impl_pack_shape(env, header.symbol, child(symbol(env, header.symbol).node, 1), ty)?
        if length(widths) != 0 {
            let selected = materialize_impl_pack(env, source, widths)?
            if complete(impl_arguments(env, get(env.implementations, selected), ty)) && protocol.ready {
                discard check_impl_packs(env)?
            }
        }
        index = index + 1
    }
    Result.Ok(true)
}

fn materialize_impl_pack(env Environment, template Int, widths List[Int]) Result[Int, Failure] {
    let header = get(env.implementations, template)
    var index = 0
    var count = 0
    while index < length(env.implementations) {
        let previous = get(env.implementations, index)
        if previous.source == header.source && length(previous.widths) != 0 {
            if same(previous.widths, widths) {
                return Result.Ok(index)
            }
            count = count + 1
        }
        index = index + 1
    }
    let item = symbol(env, header.source)
    var depth = 1
    index = 0
    while index < length(env.implementations) {
        let active = get(env.implementations, index)
        if active.state == 4 {
            depth = active.depth + 1
        }
        index = index + 1
    }
    let pack_work = active_pack(env)
    if pack_work >= 0 && get(env.packs, pack_work).depth >= depth {
        depth = get(env.packs, pack_work).depth + 1
    }
    if depth > 64 {
        return Result.Err(failure(env, header.source, item.node, "implementation pack specialization depth exceeded; expansion must be finite"))
    }
    let names = pack_names(declared_packs(item.node))
    if length(widths) != length(names) {
        return Result.Err(failure(env, header.source, item.node, "type pack shape does not match its declaration"))
    }
    index = 0
    while index < length(widths) {
        if get(widths, index) < 0 || get(widths, index) > 1024 {
            return Result.Err(failure(env, header.source, item.node, "implementation pack specialization budget exceeded; expansion must be finite"))
        }
        index = index + 1
    }
    if count >= 1024 {
        return Result.Err(failure(env, header.source, item.node, "implementation pack specialization budget exceeded; expansion must be finite"))
    }
    let types = group(item.node, NodeKind.TypeParameters)
    let parameters = expand_family_parameters(types, widths)
    let elements = unknown_extents(length(names))
    let children = new[Node]()
    index = 0
    while index < length(item.node.children) {
        let node = child(item.node, index)
        if node.kind == NodeKind.TypeParameters {
            push(children, pack_node(node, node.kind, "", parameters))
        } else {
            var expanded = expand_family_type(env, header.source, node, names, widths, elements, false, 0, true)?
            var pack = 0
            while has_pack_iteration(expanded) && pack < length(names) {
                expanded = expand_type_iteration(env, header.source, expanded, get(names, pack), get(widths, pack), false, false, 0, ints(0))?
                pack = pack + 1
            }
            push(children, expanded)
        }
        index = index + 1
    }
    let owner = length(env.source.symbols)
    push(env.source.symbols, Symbol {
            file = item.file
            node = pack_node(item.node, NodeKind.Impl, item.node.value, children)
            name = item.name
            public = false
            test_only = item.test_only
            owner = -1
        })
    let associated = new[Int]()
    index = 0
    while index < length(children) {
        let member = get(children, index)
        if member.kind == NodeKind.Function || member.kind == NodeKind.AssociatedType {
            push(env.source.symbols, Symbol {
                    file = item.file
                    node = member
                    name = member.value
                    public = false
                    test_only = item.test_only
                    owner = owner
                })
        }
        index = index + 1
    }
    let member_end = length(env.source.symbols)
    index = 0
    while index < length(header.associated) {
        let original = get(header.associated, index)
        var binding = original
        var member = owner + 1
        while member < member_end {
            let selected = symbol(env, member)
            if selected.owner == owner && selected.node.kind == NodeKind.AssociatedType && selected.name == symbol(env, original).name {
                binding = member
            }
            member = member + 1
        }
        push(associated, binding)
        index = index + 1
    }
    let selected = length(env.implementations)
    push(get(env.concepts, concept_index(env, header.capability)).implementations, selected)
    push(env.implementations, Implementation {
            symbol = owner
            source = header.source
            widths = copy_indices(widths)
            depth = depth
            capability = header.capability
            ty = -1
            methods = new[Int]()
            associated = associated
            state = 0
        })
    discard implementation_type(env, selected, 0)?
    index = owner + 1
    while index < member_end {
        if validate_pack(env, index)? {
            push(env.packs, PackInstance {
                    source = index
                    declaration = -1
                    widths = new[Int]()
                    signature = -1
                    state = -1
                    depth = 0
                })
        }
        index = index + 1
    }
    if get(env.concepts, concept_index(env, header.capability)).ready {
        discard implementation_methods(env, selected)?
    }
    Result.Ok(selected)
}

fn impl_pack_state(env Environment, index Int, state Int) {
    let header = get(env.implementations, index)
    set(env.implementations, index, Implementation {
            symbol = header.symbol
            source = header.source
            widths = header.widths
            depth = header.depth
            capability = header.capability
            ty = header.ty
            methods = header.methods
            associated = header.associated
            state = state
        })
}

fn impl_member_widths(env Environment, owner Int) List[Int] {
    let parent = symbol(env, owner).owner
    if parent < 0 || symbol(env, parent).node.kind != NodeKind.Impl {
        return new[Int]()
    }
    get(env.implementations, implementation_owner(env, parent)).widths
}

fn impl_member_source(env Environment, owner Int) Int {
    if length(impl_member_widths(env, owner)) == 0 {
        return owner
    }
    let item = symbol(env, owner)
    let source = get(env.implementations, implementation_owner(env, item.owner)).source
    var index = 0
    while index < length(env.source.symbols) {
        let member = symbol(env, index)
        if member.owner == source && member.node.kind == item.node.kind && member.name == item.name &&
        member.node.span.start == item.node.span.start && member.node.span.end == item.node.span.end &&
        closure_expansion(member.node) == closure_expansion(item.node) {
            return index
        }
        index = index + 1
    }
    -1
}

fn impl_member_instance(env Environment, source Int, widths List[Int]) Result[Int, Failure] {
    if length(widths) == 0 {
        return Result.Ok(source)
    }
    let item = symbol(env, source)
    let selected = materialize_impl_pack(env, implementation_owner(env, item.owner), widths)?
    discard check_impl_packs(env)?
    let owner = get(env.implementations, selected).symbol
    var index = 0
    while index < length(env.source.symbols) {
        let member = symbol(env, index)
        if member.owner == owner && member.node.kind == item.node.kind && member.name == item.name &&
        member.node.span.start == item.node.span.start && member.node.span.end == item.node.span.end &&
        closure_expansion(member.node) == closure_expansion(item.node) {
            return Result.Ok(index)
        }
        index = index + 1
    }
    Result.Err(failure(env, source, item.node, "cached implementation member has no current declaration"))
}

// Like function packs, check a worklist with abstract elements. A recursive
// family may discover another shape without retaining native checker frames.
fn check_impl_packs(env Environment) Result[Bool, Failure] {
    var index = 0
    while index < length(env.implementations) {
        if length(get(env.implementations, index).widths) != 0 && get(env.implementations, index).state == 4 {
            return Result.Ok(true)
        }
        index = index + 1
    }
    index = 0
    while index < length(env.implementations) {
        let header = get(env.implementations, index)
        if length(header.widths) != 0 && header.state == 3 {
            impl_pack_state(env, index, 4)
            discard implementation_types(env, index)?
            var method = 0
            while method < length(header.methods) {
                let id = get(header.methods, method)
                let signature = get(env.signatures, id)
                if symbol(env, signature.symbol).owner == header.symbol && pack_instance(env, id) < 0 {
                    discard function(env, id, abstract_arguments(env, signature.parameters), unknown_constants(signature), false)?
                }
                method = method + 1
            }
            impl_pack_state(env, index, 5)
        }
        index = index + 1
    }
    Result.Ok(true)
}
