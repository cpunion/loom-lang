fn static_uses(text Text, name Text, parameter Int) List[Span] {
    let source = match bind(fixture_project(source_files(text)), false) {
        Result.Ok(value) => value
        Result.Err(_) => {
            assert false
            return new[Span]()
        }
    }
    var owner = 0
    while owner < length(source.symbols) {
        if get(source.symbols, owner).name == name {
            return match static_parameter_info(source, owner, parameter, build_inputs(no_input_reader)) {
                Result.Ok(value) => value.references
                Result.Err(failed) => {
                    discard write_error(failed.diagnostic.message)
                    assert false
                    new[Span]()
                }
            }
        }
        owner = owner + 1
    }
    assert false
    new[Span]()
}

test fn static_queries_observe_real_bindings_before_erasure() {
    let text = """
        fn added(comptime width Int, value Int) Int {
            let first = width + value
            {
                let width = 3
                discard width
            }
            first
        }
        fn computed(comptime count Int) Int {
            comptime { count + 1 }
        }
        fn applied(comptime action fn(Int) Int, value Int) Int {
            action(value)
        }
        fn selected(comptime flag Bool, comptime amount Int) Int {
            comptime if flag {
                amount
            } else {
                amount + 1
            }
        }
        fn increment(value Int) Int {
            value + 1
        }
        fn main() {
            assert added(1, 2) == 3
            assert computed(4) == 5
            assert applied(increment, 3) == 4
            assert selected(true, 5) == 5
            assert selected(false, 5) == 6
        }
        """
    let width = static_uses(text, "added", 0)
    assert length(width) == 1
    assert slice(text, get(width, 0).start, get(width, 0).end) == "width"
    assert length(static_uses(text, "computed", 0)) == 1
    assert length(static_uses(text, "applied", 0)) == 1
    assert length(static_uses(text, "selected", 0)) == 1
    assert length(static_uses(text, "selected", 1)) == 2
}

test fn semantic_queries_require_expanded_declaration_stages() {
    let source = match bind(fixture_project(source_files("""
        comptime {}
        fn selected(comptime value Int) Int {
            value
        }
        fn main() {
            assert selected(1) == 1
        }
        """)), false) {
        Result.Ok(value) => value
        Result.Err(_) => {
            assert false
            return
        }
    }
    var owner = 0
    while owner < length(source.symbols) {
        let item = get(source.symbols, owner)
        if item.name == "selected" {
            match static_parameter_info(source, owner, 0, build_inputs(no_input_reader)) {
                Result.Ok(_) => { assert false }
                Result.Err(failed) => {
                    assert failed.diagnostic.message == "expand_project must run before binding declaration stages"
                }
            }
        }
        if item.name == "main" {
            match check_query(source, 0, item.node.span.start) {
                Result.Ok(_) => { assert false }
                Result.Err(failed) => {
                    assert failed.diagnostic.message == "expand_project must run before binding declaration stages"
                }
            }
        }
        owner = owner + 1
    }
}
