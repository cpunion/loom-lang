import std.text.replace

test fn closure_contracts_keep_immutable_values_and_reject_unproved_mutations() {
    discard accepted("""
        record Capture {
            count Int
            values List[Int]
        }
        fn make(value Capture) fn() Int {
            fn() Int
            ensures result == value.count {
                value.count
            }
        }
        fn nested(value Int) fn() fn() Int {
            fn() fn() Int {
                fn() Int
                ensures result == value {
                    value
                }
            }
        }
        fn with_argument(limit Int) fn(Int) Int {
            fn(value Int) Int
            requires value == limit
            ensures result == value {
                limit
            }
        }
        fn equal(left Int, right Int) Bool {
            left == right
        }
        fn with_helper(limit Int) fn(Int) Int {
            fn(value Int) Int
            requires equal(value, limit)
            ensures result == value {
                limit
            }
        }
        fn main() {
            let values = [1]
            let read = make(Capture {
                    count = 7
                    values = values
                })
            values[0] = 9
            assert read() == 7 && nested(8)()() == 8
            assert with_argument(4)(4) == 4
            assert with_helper(5)(5) == 5
        }
        """)
    rejects("""
        fn make(value Int) fn() Int {
            fn() Int
            ensures result > value {
                value
            }
        }
        """)
    rejects("""
        fn main() {
            var value = 1
            let read = fn() Int
            ensures result == 1 {
                value
            }
            value = 2
            discard read()
        }
        """)
    rejects("""
        fn invoke(action fn())
        ensures true {
            action()
        }
        fn make() fn() Int {
            var value = 1
            let change = fn() {
                    value = 3
                }
            fn() Int
            ensures result == 2 {
                value = 2
                invoke(change)
                value
            }
        }
        fn main() {
            discard make()()
        }
        """)
}

test fn mutable_captures_use_real_storage_and_entry_observations() {
    discard accepted("""
        fn make() fn() Int {
            var value = 1
            fn() Int
            ensures result == 2 {
                value = 2
                value
            }
        }
        fn calculate() Int
        ensures result == 3 {
            var value = 1
            let update = fn() {
                    value = 3
                }
            let alias = update
            alias()
            value
        }
        fn counter() fn() Int {
            var value = 1
            fn() Int
            requires value < 9223372036854775807
            ensures result == old(value) + 1 {
                value = value + 1
                value
            }
        }
        fn main() {
            assert make()() == 2 && calculate() == 3
            let next = counter()
            assert next() == 2 && next() == 3
        }
        """)
    list_constraint_accept("""
        import std.list.length
        fn positive_head(values List[Int]) Bool {
            length(values) > 0 && values[0] > 0
        }
        type Head = List[Int] where positive_head(self)
        fn make(first Head, second Head) (fn() Int, fn()) {
            var value = first
            let read = fn() Int
            ensures result > 0 {
                value[0]
            }
            let change = fn() {
                    value = second
                }
            (read, change)
        }
        fn main() {
            let read, change = make(Head([1]), Head([2]))
            assert read() == 1
            change()
            assert read() == 2
        }
        """)
    list_constraint_reject("""
        import std.list.length
        fn positive_head(values List[Int]) Bool {
            length(values) > 0 && values[0] > 0
        }
        type Head = List[Int] where positive_head(self)
        fn make(first Head, other List[Int]) fn() Int {
            var value = first
            fn() Int
            ensures result > 0 {
                other[0] = -1
                value[0]
            }
        }
        """)
}

test fn captured_cells_use_loop_induction_without_freezing_aliases() {
    let source = """
        fn bounded(start Int) fn(Int) Int {
            var value = start
            fn(limit Int) Int
            requires value <= limit
            ensures result == limit {
                while value < limit {
                    value = value + 1
                }
                value
            }
        }
        fn main() {
            let next = bounded(0)
            assert next(3) == 3 && next(7) == 7
        }
        """
    discard accepted(source)
    rejects(std.text.replace(source, "value = value + 1", "value = value + 2"))
    rejects(std.text.replace(source, "value = value + 1", "break"))
}
