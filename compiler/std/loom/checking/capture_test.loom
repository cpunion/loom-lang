test fn process_capture_has_an_exact_signature_and_cannot_run_at_compile_time() {
    let declarations = "intrinsic fn process_capture(arguments List[Text], stdout Bytes, stderr Bytes) Int\nintrinsic fn list_new[T]() List[T]\nintrinsic fn bytes_new() Bytes\npub fn exercise() Int { process_capture(list_new[Text](), bytes_new(), bytes_new()) }"
    let files = source_files("import std.process.exercise\npub fn run() Int { exercise() }")
    push(files, source_file("std.process", declarations, true))
    match checked(files) {
        Result.Ok(program) => {
            var found = false
            var index = 0
            while index < length(program.functions) {
                if get(program.functions, index).runtime_name == "process_capture" { found = true }
                index = index + 1
            }
            assert found
        }
        Result.Err(_) => { assert false }
    }
    let staged = source_files("import std.process.exercise\nfn main() { discard comptime { if false { exercise() } else { 0 } } }")
    push(staged, source_file("std.process", declarations, true))
    match checked(staged) {
        Result.Err(failed) => { assert failed.diagnostic.message == "compile-time evaluation forbids intrinsic process_capture" }
        Result.Ok(_) => { assert false }
    }
    let invalid = new[Text]()
    push(invalid, "intrinsic fn process_capture(arguments List[Int], stdout Bytes, stderr Bytes) Int")
    push(invalid, "intrinsic fn process_capture(arguments List[Text], stdout Text, stderr Bytes) Int")
    push(invalid, "intrinsic fn process_capture(arguments List[Text], stdout Bytes, stderr Text) Int")
    push(invalid, "intrinsic fn process_capture(arguments List[Text], stdout Bytes, stderr Bytes) Bytes")
    var index = 0
    while index < length(invalid) {
        let fixture = source_files("")
        push(fixture, source_file("std.process", get(invalid, index), true))
        match checked(fixture) {
            Result.Err(failed) => { assert failed.diagnostic.message == "intrinsic declaration does not match its runtime signature" }
            Result.Ok(_) => { assert false }
        }
        index = index + 1
    }
}
