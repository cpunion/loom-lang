test fn constraints_observe_selected_inline_fields_without_freezing_shared_siblings() {
    discard accepted_result("""
        import std.result.Result
        import std.result.ConstraintError
        record Details {
            count Int
            values List[Int]
        }
        record Envelope {
            details Details
            bytes Bytes
        }
        fn positive(value Int) Bool {
            value > 0
        }
        fn valid(value Envelope) Bool {
            let copy = value
            positive(copy.details.count)
        }
        type Valid = Envelope where valid(self)
        pub fn checked(value Envelope) Result[Valid, ConstraintError] {
            Valid(value)
        }
        pub fn count(value Valid) Int
            ensures result > 0 {
            value.details.count
        }
        pub fn mutate_unobserved(value Valid) Int {
            value.details.values[0] = -1
            value.bytes[0] = 0
            count(value)
        }
        """)
}

test fn recursive_helpers_can_forward_shared_handles_without_observing_them() {
    discard accepted_result("""
        import std.result.Result
        import std.result.ConstraintError
        record Shared {
            count Int
            values List[Int]
        }
        fn valid(value Shared, depth Int) Bool {
            if depth > 0 {
                valid(value, depth - 1)
            } else {
                value.count > 0
            }
        }
        type Valid = Shared where valid(self, 2)
        pub fn checked(value Shared) Result[Valid, ConstraintError] {
            Valid(value)
        }
        """)
}

test fn constraints_cannot_hide_shared_reads_inside_pure_helpers() {
    let header = """
        record Shared {
            count Int
            values List[Int]
        }
        fn head(values List[Int]) Bool {
            values[0] > 0
        }
        fn hidden(value Shared) Bool {
            head(value.values)
        }
        """
    rejects(concat(header, "type Invalid = Shared where head(self.values)"))
    rejects(concat(header, "type Invalid = Shared where hidden(self)"))
    rejects(concat(header, """
        fn checked(value Shared) Bool
        requires value.values[0] > 0
        {
            true
        }
        type Invalid = Shared where checked(self)
        """))
    rejects(concat(header, """
        fn write(value Shared) Bool {
            value.values[0] = 42
            value.count > 0
        }
        type Invalid = Shared where write(self)
        """))
    resource_reject("""
        import std.resource.MustScope
        record Handle {
            id Int
        }
        impl MustScope for Handle {
        }
        type Invalid = Handle where self.id > 0
        """)
}

test fn partial_invariant_proofs_do_not_split_disjunctions() {
    match with_result("""
        record Input {
            count Int
            name Text
            values List[Int]
        }
        fn positive(value Int) Bool {
            value > 0
        }
        fn named(value Text) Bool {
            value == "ok"
        }
        type Selected = Input where positive(self.count) || named(self.name)
        pub fn invalid(value Selected) Int
            ensures result > 0 {
            value.count
        }
        """) {
        Result.Err(failed) => {
            assert failed.diagnostic.message == "required postcondition is not proved by the bounded scalar prover"
        }
        Result.Ok(_) => {
            assert false
        }
    }
}

test fn invariant_helpers_may_compute_with_fresh_shared_storage() {
    resource_accept("""
        import std.list.push
        record Input {
            count Int
            notes List[Text]
        }
        fn collect(input Input, values List[Int]) List[Int] {
            push(values, input.count)
            values
        }
        fn valid(input Input) Bool {
            let values = collect(input, [0])
            let alias = values
            alias[0] = values[1]
            var index = 0
            while index < 2 {
                alias[0] = alias[0] + 1
                index = index + 1
            }
            alias[0] > 2
        }
        type Valid = Input where valid(self)
        """)
}

test fn invariant_origins_follow_return_values_loops_and_hidden_storage() {
    let header = """
        import std.list.push
        record Input {
            count Int
            values List[Int]
        }
        """
    resource_reject_reason(concat(header, """
        fn select(input Input) List[Int] {
            return input.values
        }
        fn valid(input Input) Bool {
            select(input)[0] > 0
        }
        type Invalid = Input where valid(self)
        """), "type constraints may observe immutable fields, not shared mutable contents")
    resource_reject_reason(concat(header, """
        fn valid(input Input) Bool {
            var values = [1]
            var index = 0
            while index < 2 {
                if values[0] < 0 {
                    return false
                }
                values = input.values
                index = index + 1
            }
            true
        }
        type Invalid = Input where valid(self)
        """), "type constraints may observe immutable fields, not shared mutable contents")
    resource_reject_reason(concat(header, """
        fn store(input Input, values List[List[Int]]) {
            push(values, input.values)
        }
        fn valid(input Input) Bool {
            let values = [[1]]
            let alias = values
            store(input, alias)
            values[1][0] > 0
        }
        type Invalid = Input where valid(self)
        """), "type constraints may observe immutable fields, not shared mutable contents")
    resource_reject_reason(concat(header, """
        fn valid(input Input) Bool {
            let read = fn() Int {
                input.values[0]
            }
            read() > 0
        }
        type Invalid = Input where valid(self)
        """), "type constraints may observe immutable fields, not shared mutable contents")
}

test fn invariant_field_origins_merge_aliases_across_branches_and_record_updates() {
    let header = """
        record Input {
            count Int
            values List[Int]
        }
        record Mixed {
            input Input
            scratch List[Int]
        }
        fn read(value Mixed) Bool {
            value.scratch[0] > 0
        }
        """
    discard accepted(concat(header, """
        fn valid(input Input) Bool {
            read(Mixed {
                input = input
                scratch = [input.count]
            })
        }
        type Valid = Input where valid(self)
        """))
    resource_reject_reason(concat(header, """
        fn valid(input Input) Bool {
            let local = Mixed {
                input = input
                scratch = [1]
            }
            let changed = if input.count > 0 {
                local
            } else {
                Mixed {
                    scratch = input.values
                    ..local
                }
            }
            read(changed)
        }
        type Invalid = Input where valid(self)
        """), "type constraints may observe immutable fields, not shared mutable contents")
}
