record ImplComputationLayout {
    schema Node
    ty Int
}

record ImplComputation {
    layouts List[ImplComputationLayout]
    evidence List[Requirement]
    origins List[Node]
}

fn impl_computation_mentions(node Node, name Text) Bool {
    if pack_root(node, name) {
        return true
    }
    var visible = family_pack_names(node, [name])
    var index = 0
    while index < length(node.children) {
        if impl_computation_mentions(child(node, index), get(lexical_pack_names(node, index, visible, false), 0)) {
            return true
        }
        if node.kind == NodeKind.Block {
            visible = lexical_pack_names(child(node, index), 0, visible, true)
        }
        index = index + 1
    }
    false
}

fn impl_computation_local(node Node, bindings List[Node]) Bool {
    if node.kind == NodeKind.Name || node.kind == NodeKind.Type ||
    node.kind == NodeKind.Call || node.kind == NodeKind.Construct {
        let root = slice(node.value, 0, first_dot(node.value))
        var index = 0
        while index < length(bindings) {
            if pack_local_binds(get(bindings, index), root) {
                return true
            }
            index = index + 1
        }
    }
    var index = 0
    while index < length(node.children) {
        if impl_computation_local(child(node, index), bindings) {
            return true
        }
        index = index + 1
    }
    false
}

fn impl_computation_evidence(env Environment, source List[Requirement], target List[Requirement]) {
    var index = 0
    while index < length(source) {
        let known = get(source, index)
        if !entailed(env, target, known.ty, known.capability) {
            push(target, known)
        }
        index = index + 1
    }
}

// Give a complete word-bearing type one identity, never a representative
// element or tuple width. Only capabilities proved for that whole type enter
// the evaluator; reflection and unknown equality keep their ordinary rules.
fn impl_computation_layouts(env Environment, scope ImplMethodScope, owner Int, node Node,
    frame List[Node], values List[Node], computation ImplComputation,
    element Bool, bindings List[Node], depth Int) Result[Node, Failure] {
    if depth >= 64 {
        return Result.Err(failure(env, owner, node, "implementation method computation must be finite"))
    }
    if node.kind == NodeKind.TypeParameters ||
    node.kind == NodeKind.Function || node.kind == NodeKind.Arm ||
    node.kind == NodeKind.ComptimeFor || node.kind == NodeKind.ComptimeMap ||
    (node.kind == NodeKind.AssociatedType && length(group(node, NodeKind.TypeParameters)) > 0) {
        return Result.Ok(node)
    }
    if node.kind == NodeKind.Comptime && child(node, 0).kind == NodeKind.If {
        let source = child(node, 0)
        if impl_computation_local(child(source, 0), bindings) {
            return Result.Ok(node)
        }
        let context = impl_method_context(env, ImplMethodScope {
                evidence = computation.evidence
                ..scope
            }, owner)
        let selected = computed_family_selection(context, node,
            Option.Some(fn(checked Context, input Node) Result[(Context, Node), Failure] {
                    impl_computation_evidence(env, checked.signature.requirements, computation.evidence)
                    let prepared = impl_computation_layouts(env, scope, owner, input, frame, values,
                        computation, element, bindings, depth + 1)?
                    let context = impl_method_computation_context(env, ImplMethodScope {
                            evidence = computation.evidence
                            ..scope
                        }, owner, prepared, frame, values, element)?
                    Result.Ok((context, prepared))
                }))?
        impl_computation_evidence(env, selected.0.signature.requirements, computation.evidence)
        return Result.Ok(pack_node(node, node.kind, node.value,
                source_nodes(impl_computation_layouts(env, scope, owner, selected.1, frame, values,
                        computation, element, bindings, depth + 1)?)))
    }
    let structural = node.kind == NodeKind.Type || node.kind == NodeKind.Name ||
    node.kind == NodeKind.Tuple || node.kind == NodeKind.TupleType ||
    node.kind == NodeKind.FunctionType || node.kind == NodeKind.Apply
    var whole = structural && has_type_expansion(node)
    var index = 0
    while structural && index < length(frame) {
        whole = whole || (pack_root(node, get(frame, index).value) && has_type_expansion(get(values, index)))
        index = index + 1
    }
    let local = (whole || (element && (node.kind == NodeKind.Type || node.kind == NodeKind.Name))) &&
    length(bindings) > 0 && impl_computation_local(node, bindings)
    if element && !local && (whole || node.kind == NodeKind.Type || node.kind == NodeKind.Name) {
        let origins = impl_method_word_origins(env, owner, node, frame, values)?
        index = 0
        while index < length(origins) {
            pack_word_origin_add(computation.origins, get(origins, index))
            index = index + 1
        }
        if length(computation.origins) > 1 {
            return Result.Err(failure(env, owner, node, "elementwise expansion needs proved equal source widths"))
        }
    }
    if whole && !local {
        let schema = impl_method_substitute(env, scope, owner,
            type_pattern_schema(env, owner, node, element, 0, true, true, frame)?, frame, values, 0)?
        discard impl_method_well_formed(env, scope, owner, schema)?
        index = 0
        while index < length(computation.layouts) {
            let layout = get(computation.layouts, index)
            if pack_schema_equal(layout.schema, schema) {
                return Result.Ok(meta_reference(node, layout.ty))
            }
            index = index + 1
        }
        let ty = pack_symbolic_type(impl_method_context(env, scope, owner), scope.caller,
            schema, computation.evidence, ints(512), 0, Option.Some(scope.assumptions))?
        if ty < 0 {
            return Result.Err(failure(env, owner, node, "compile-time input needs an established type identity"))
        }
        push(computation.layouts, ImplComputationLayout {
                schema = schema
                ty = ty
            })
        return Result.Ok(meta_reference(node, ty))
    }
    let children = new[Node]()
    var locals = bindings
    var copied = false
    index = 0
    while index < length(node.children) {
        let member = child(node, index)
        // Only closed type islands may use the outer schema frame. Local
        // aliases and their enclosing constructors stay with ordinary CTFE.
        push(children, impl_computation_layouts(env, scope, owner, member, frame,
                values, computation, element && node.kind != NodeKind.Spread, locals, depth + 1)?)
        if node.kind == NodeKind.Block && (member.kind == NodeKind.Let || member.kind == NodeKind.Var ||
            member.kind == NodeKind.Scoped || member.kind == NodeKind.Destructure) {
            if !copied {
                locals = std.list.clone(bindings)
                copied = true
            }
            push(locals, member)
        }
        index = index + 1
    }
    Result.Ok(pack_node(node, node.kind, node.value, children))
}

// Canonical family binders have already been closed lexically. Substituting
// these temporary free identities cannot capture a nested family's variables.
fn impl_computation_restore(schema Node, first Int, layouts List[ImplComputationLayout]) Node {
    let parameter = pack_schema_parameter(schema)
    if parameter >= first && parameter < first + length(layouts) {
        return get(layouts, parameter - first).schema
    }
    let children = new[Node]()
    var index = 0
    while index < length(schema.children) {
        push(children, impl_computation_restore(child(schema, index), first, layouts))
        index = index + 1
    }
    pack_node(schema, schema.kind, schema.value, children)
}
