// Check closed obligations and symbolic nominal words without choosing pack
// widths. Reuse the ordinary resolver and universal family-shape matcher.
fn data_pack_header_type(env Environment, owner Int, node Node, packs List[Text],
    parameters List[Node], arguments List[Int], obligations List[Requirement],
    headers Option[List[TypeHeader]]) Result[Bool, Failure] {
    var dependent = false
    var index = 0
    while index < length(packs) {
        dependent = dependent || mentions_pack(node, get(packs, index))
        index = index + 1
    }
    if !dependent && (node.kind == NodeKind.Type || node.kind == NodeKind.TupleType ||
        node.kind == NodeKind.FunctionType || node.kind == NodeKind.DynType) {
        let bound = bind_data_parameters(node, parameters, arguments)
        let ty = resolve_bound(env, owner, bound, new[Int](), obligations, 0)?
        discard well_formed(env, owner, ty, obligations, node, 0)?
        match headers {
            Option.Some(selected) => {
                push(selected, TypeHeader {
                        symbol = owner
                        node = node
                        ty = ty
                    })
            }
            Option.None => {
            }
        }
        return Result.Ok(true)
    }
    if node.kind == NodeKind.DynType {
        discard accessible_concept(env, owner, node)?
    }
    if node.kind == NodeKind.Type && type_constant(env, owner, node)? < 0 {
        let root = slice(node.value, 0, first_dot(node.value))
        var lexical = false
        index = 0
        while index < length(packs) {
            lexical = lexical || get(packs, index) == root
            index = index + 1
        }
        index = 0
        while index < length(parameters) {
            lexical = lexical || get(parameters, index).value == root
            index = index + 1
        }
        // A lexical receiver may project an associated family. Its arguments
        // still need specialization; a global constructor must already bind.
        if !lexical {
            discard type_constructor(env, owner, node)?
            // Check symbolic nominal words through the same universal matcher
            // as variadic family proofs, never by choosing a representative arity.
            let schema = type_pattern_schema(env, owner, node, true, 0, true, true)?
            if !pack_layout_well_formed(empty_context(env, owner), symbol(env, owner).node,
                schema, ints(512), 0)? {
                return Result.Err(failure(env, owner, node,
                        "variadic data header needs well-formed type arguments for every member"))
            }
        }
    }
    index = 0
    while index < length(node.children) {
        discard data_pack_header_type(env, owner, child(node, index), packs, parameters, arguments, obligations, headers)?
        index = index + 1
    }
    Result.Ok(true)
}

fn data_pack_header(env Environment, owner Int, headers Option[List[TypeHeader]]) Result[Bool, Failure] {
    let node = symbol(env, owner).node
    let parameters = new[Node]()
    let declared = group(node, NodeKind.TypeParameters)
    var index = 0
    while index < length(declared) {
        if get(declared, index).kind != NodeKind.TypePack {
            push(parameters, get(declared, index))
        }
        index = index + 1
    }
    let arguments = abstract_arguments(env, length(parameters))
    let obligations = requirements_parameters(env, owner, arguments, parameters)?
    let packs = pack_names(declared_packs(node))
    index = 0
    while index < length(node.children) {
        let member = child(node, index)
        if member.kind == NodeKind.Field || member.kind == NodeKind.Variant {
            var field = 0
            while field < length(member.children) {
                discard data_pack_header_type(env, owner, child(member, field), packs, parameters, arguments, obligations, headers)?
                field = field + 1
            }
        }
        index = index + 1
    }
    Result.Ok(true)
}

fn data_pack_headers(env Environment) Result[Bool, Failure] {
    let declarations = length(env.source.symbols)
    var owner = 0
    while owner < declarations {
        if data_pack(symbol(env, owner).node) {
            discard data_pack_header(env, owner, Option.None)?
        }
        owner = owner + 1
    }
    Result.Ok(true)
}

fn data_header_parameters(owner Int, node Node, parameters List[Node], output List[ParameterHeader]) {
    if node.kind == NodeKind.Type || node.kind == NodeKind.Name || node.kind == NodeKind.TypePack {
        let index = data_parameter_index(parameters, node.value)
        if index >= 0 {
            push(output, ParameterHeader {
                    symbol = owner
                    node = node
                    parameter = get(parameters, index)
                })
        }
    }
    var child = 0
    while child < length(node.children) {
        data_header_parameters(owner, get(node.children, child), parameters, output)
        child = child + 1
    }
}
