import std.reflect.Schema
import std.reflect.Kind

// Private same-compiler tags follow payload-free declaration order. Compiler
// identity invalidates snapshots; these are not public or native ABI tags.
fn cache_enum_cases(types List[Schema], decode Bool) Text {
    assert length(types) == if decode {
        3
    } else {
        1
    }
    let schema = get(types, 0)
    let shape = get(schema.types, schema.root)
    assert shape.kind == Kind.Enum
    var code = if decode {
        "match $1 {\n"
    } else {
        "match $0 {\n"
    }
    var index = 0
    while index < length(shape.variants) {
        let variant = get(shape.variants, index)
        assert length(variant.fields) == 0
        let constructor = concat(shape.name, concat(".", variant.name))
        let tag = std.int.to_text(index)
        let line = if decode {
            concat(tag, concat(" => Result.Ok(", concat(constructor, ")\n")))
        } else {
            concat(constructor, concat(" => ", concat(tag, "\n")))
        }
        code = concat(code, line)
        index = index + 1
    }
    if decode {
        code = concat(code, "_ => Result.Err($2)\n")
    }
    concat(code, "}")
}

fn cache_enum_tag(types List[Schema]) Text {
    cache_enum_cases(types, false)
}

fn cache_enum_kind(types List[Schema]) Text {
    cache_enum_cases(types, true)
}

fn cache_type_tag(value TypeKind) Int {
    cache_enum_tag!(value)
}

fn cache_type_kind(value Int) Result[TypeKind, Text] {
    cache_enum_kind!(TypeKind.Unit, value, "unknown cached type kind")
}

fn cache_expression_tag(value ExprKind) Int {
    cache_enum_tag!(value)
}

fn cache_expression_kind(value Int) Result[ExprKind, Text] {
    cache_enum_kind!(ExprKind.Integer, value, "unknown cached expression kind")
}
