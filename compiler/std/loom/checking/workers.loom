import std.loom.proof.InputGuarantee

fn worker_expression(value Expr) Bool {
    if value.kind == ExprKind.Suspend && value.text == "async_worker" {
        return true
    }
    var index = 0
    while index < length(value.children) {
        if worker_expression(get(value.children, index)) {
            return true
        }
        index = index + 1
    }
    index = 0
    while index < length(value.arms) {
        let body = get(value.arms, index).body
        var item = 0
        while item < length(body) {
            if worker_expression(get(body, item)) {
                return true
            }
            item = item + 1
        }
        index = index + 1
    }
    false
}

fn constraint_content_updates(env Environment, program std.loom.typed.Program, owner Int, value Expr, modified List[InputGuarantee]) Result[Bool, Failure] {
    let store = std.loom.proof.single_list_write(program.functions, value)
    if store > 0 &&
    constraint_weakened(env, get(value.children, 0)) {
        push(modified, InputGuarantee {
                ty = get(get(value.children, 0).children, 0).ty
                writes = store
            })
    }
    if value.kind == ExprKind.Call && store == 0 {
        let inputs = new[InputOrigin]()
        var borrowed = false
        var index = 0
        while index < length(value.children) {
            let protected = constraint_weakened(env, get(value.children, index))
            push(inputs, if protected {
                    origin_input()
                } else {
                    origin_empty()
                })
            borrowed = borrowed || (protected && get(env.type_states,
                    get(get(value.children, index).children, 0).ty).list_writes == 0)
            index = index + 1
        }
        if borrowed {
            let reads = invariant_reads(env, program.functions, value, true, 0, -1)
            discard invariant_call(reads, value.index, inputs, 0)
            if !get(reads.valid, 0) {
                let writes = constraint_mutation_writes(env, program.functions, value, inputs)
                let preserved = match list_mutation_proof(env, value, true, writes) {
                    Result.Ok(proved) => proved
                    Result.Err(failed) => {
                        return Result.Err(list_constraint_error(env, owner, value,
                                concat("constrained List mutation is not proved interference-safe: ",
                                    failed.diagnostic.message)))
                    }
                }
                if !preserved {
                    return Result.Err(list_constraint_error(env, owner, value,
                            "constrained List mutation is not proved interference-safe"))
                }
                index = 0
                while index < length(value.children) {
                    let argument = get(value.children, index)
                    if constraint_weakened(env, argument) {
                        push(modified, InputGuarantee {
                                ty = get(argument.children, 0).ty
                                writes = writes
                            })
                    }
                    index = index + 1
                }
            }
        }
    }
    var index = 0
    while index < length(value.children) {
        discard constraint_content_updates(env, program, owner, get(value.children, index), modified)?
        index = index + 1
    }
    index = 0
    while index < length(value.arms) {
        let body = get(value.arms, index).body
        var item = 0
        while item < length(body) {
            discard constraint_content_updates(env, program, owner, get(body, item), modified)?
            item = item + 1
        }
        index = index + 1
    }
    Result.Ok(true)
}

// Cached sequential certificates never authorize a shared build. Reuse the
// same algebra, forgetting mutable observations between independently guarded
// accesses. Unsupported interference obligations remain build errors.
fn worker_contracts(env Environment, program std.loom.typed.Program) Result[Bool, Failure] {
    var shared = false
    var index = 0
    while index < length(program.functions) {
        if worker_expression(get(program.functions, index).body) {
            shared = true
        }
        index = index + 1
    }
    if !shared {
        return Result.Ok(true)
    }
    // A store preserves the predicate, not old cells or an append's old extent.
    // Retain precise evidence only for types without the corresponding writes
    // in this checked build; never reuse sequential certificates across workers.
    let modified = new[InputGuarantee]()
    index = 0
    while index < length(program.functions) {
        let function = get(program.functions, index)
        discard constraint_content_updates(env, program, function.symbol, function.body, modified)?
        var clause = 0
        while clause < length(function.preconditions) {
            discard constraint_content_updates(env, program, function.symbol, get(function.preconditions, clause), modified)?
            clause = clause + 1
        }
        index = index + 1
    }
    let protected = new[InputGuarantee]()
    index = 6
    while env.has_refinements && index < length(env.types) {
        if constrained_list(env, index) {
            var writes = get(env.type_states, index).list_writes
            var changed = 0
            while changed < length(modified) {
                let update = get(modified, changed)
                if update.ty == index && update.writes > writes {
                    writes = update.writes
                }
                changed = changed + 1
            }
            push(protected, InputGuarantee {
                    ty = index
                    writes = writes
                })
        }
        index = index + 1
    }
    index = 0
    while index < length(program.functions) {
        let function = get(program.functions, index)
        if length(function.postconditions) != 0 {
            let types = match expanded_invariant_types(env, function) {
                Result.Ok(types) => types
                Result.Err(_) => env.types
            }
            match verify_shared(proof_types(program, types), function, get(env.inputs, 0).build.proof_backend, protected) {
                Result.Ok(_) => {
                }
                Result.Err(message) => {
                    return Result.Err(failure(env, function.symbol, symbol(env, function.symbol).node, message))
                }
            }
        }
        index = index + 1
    }
    Result.Ok(true)
}

import std.loom.proof.verify_shared
