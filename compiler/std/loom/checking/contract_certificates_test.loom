fn certificate_environment(text Text) Result[Environment, Failure] {
    prepare(bind(fixture_project(source_files(text)), false)?)
}

fn certificate_signature(env Environment, name Text) Int {
    var index = 0
    while index < length(env.signatures) {
        if symbol(env, get(env.signatures, index).symbol).name == name {
            return index
        }
        index = index + 1
    }
    assert false
    -1
}

test fn completed_groups_retain_helper_clauses_only_after_every_member_passes() {
    let env = match certificate_environment("""
        fn leaf(value Int) Int {
            value
        }
        fn helper(value Int) Int
        ensures result == value {
            leaf(value)
        }
        pub fn root(value Int) Int
        ensures result == value {
            helper(value)
        }
        """) {
        Result.Ok(value) => value
        _ => {
            assert false
            return
        }
    }
    let root = certificate_signature(env, "root")
    let helper = certificate_signature(env, "helper")
    assert match function(env, root, [], [], true) {
        Result.Ok(_) => true
        _ => false
    }
    let cache = get(env.inputs, 0).contracts
    assert length(get(cache, root)) == 1
    assert length(get(cache, helper)) == 1
    let clauses = get(get(cache, helper), 0).postconditions
    assert length(clauses) != 0
    assert !proof_body_calls(get(clauses, 0))
    assert match function(env, helper, [], [], true) {
        Result.Ok(_) => true
        _ => false
    }
    assert length(get(cache, helper)) == 1

    let failed = match certificate_environment("""
        fn valid(value Int) Int
        ensures result == value {
            value
        }
        fn invalid(value Int) Int
        ensures result == value {
            0
        }
        pub fn root(value Int) Int
        ensures result == value {
            discard valid(value)
            invalid(value)
        }
        """) {
        Result.Ok(value) => value
        _ => {
            assert false
            return
        }
    }
    assert match function(failed, certificate_signature(failed, "root"), [], [], true) {
        Result.Err(_) => true
        _ => false
    }
    assert length(get(failed.inputs, 0).contracts) == 0
}

test fn pack_certificates_require_a_published_family_and_rebind_selected_locals() {
    let env = match certificate_environment("""
        fn identity(value Int) Int {
            value
        }
        fn keep[Ts...](value Int, values Ts...) Int
        ensures result == identity(value) {
            value
        }
        """) {
        Result.Ok(value) => value
        _ => {
            assert false
            return
        }
    }
    let owner = get(env.packs, 0).source
    assert symbol(env, owner).name == "keep"
    let selected = match pack_signature(env, owner, [4]) {
        Result.Ok(value) => value
        _ => {
            assert false
            return
        }
    }
    let erased = match erased_pack_signature(env, owner) {
        Result.Ok(value) => value
        _ => {
            assert false
            return
        }
    }
    let erased_index = pack_instance(env, erased)
    let states = [0, 1, 3, 4]
    var index = 0
    while index < length(states) {
        pack_state(env, erased_index, get(states, index), 1)
        assert !completed_pack_contract(env, selected)
        index = index + 1
    }
    finish_pack_batch(env, false)
    assert !completed_pack_contract(env, selected)
    assert match check_pack_arity(env, erased) {
        Result.Ok(_) => true
        _ => false
    }
    assert completed_pack_contract(env, selected)
    assert !completed_pack_contract(env, erased)
    let signature = get(env.signatures, selected)
    let built = match function(env, selected, abstract_arguments(env, signature.parameters),
        unknown_constants(signature), false) {
        Result.Ok(value) => value
        _ => {
            assert false
            return
        }
    }
    assert get(built.locals, built.result_local).name == "result"
    assert built.result_local != length(get(env.signatures, erased).params)
    assert length(built.postconditions) != 0
    assert !proof_body_calls(get(built.postconditions, 0))
    assert match verify_with_types(env.types, built) {
        Result.Ok(_) => true
        _ => false
    }
}
