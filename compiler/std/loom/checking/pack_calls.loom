// Proof-only forwarding calls instantiate a universally checked family summary.
// No pack value or sampled native specialization enters this private closure.
fn pack_proof_caller(context Context) Int {
    let signature = source_signature_id(context.env, context.signature.symbol)
    let instance = pack_instance(context.env, signature)
    if instance < 0 || !erased_pack(get(context.env.packs, instance)) {
        return -1
    }
    get(context.env.packs, instance).source
}

fn pack_schema_equal(left Node, right Node) Bool {
    if left.kind != right.kind || left.value != right.value || length(left.children) != length(right.children) {
        return false
    }
    var index = 0
    while index < length(left.children) {
        if !pack_schema_equal(child(left, index), child(right, index)) {
            return false
        }
        index = index + 1
    }
    true
}

fn pack_forwarded_shape(parameter Node) Node {
    let ty = child(parameter, 0)
    if ty.kind == NodeKind.Spread {
        pack_node(ty, NodeKind.TupleType, "", source_nodes(ty))
    } else {
        ty
    }
}

// This is only a disjointness filter. Erase correlations and any type which
// could widen; failure to establish a shape keeps the contender, never drops it.
fn pack_call_overlap_schema(env Environment, schema Node, depth Int) Node {
    let unknown = pack_node(schema, NodeKind.Type, "$parameter", new[Node]())
    if depth >= 64 {
        return if schema.kind == NodeKind.Spread {
            pack_node(schema, NodeKind.Spread, "", source_nodes(unknown))
        } else {
            unknown
        }
    }
    if schema.kind == NodeKind.Arguments && length(schema.children) == 1 {
        return pack_call_overlap_schema(env, child(schema, 0), depth + 1)
    }
    if schema.value == "$parameter" || schema.value == "$unresolved" ||
    std.text.starts_with(schema.value, "$parameter#") || std.text.starts_with(schema.value, "dyn#") {
        return unknown
    }
    if std.text.starts_with(schema.value, "nominal#") {
        match std.int.parse(slice(schema.value, 8, length(schema.value))) {
            Result.Ok(owner) => {
                if symbol(env, owner).node.kind == NodeKind.Refined {
                    return unknown
                }
            }
            Result.Err(_) => {
                return unknown
            }
        }
    } else if schema.kind == NodeKind.Type {
        match std.int.parse(schema.value) {
            Result.Ok(ty) => {
                let kind = get(env.types, ty).kind
                if kind == TypeKind.Parameter || kind == TypeKind.Associated ||
                kind == TypeKind.Refined || kind == TypeKind.Dyn {
                    return unknown
                }
            }
            Result.Err(_) => {
            }
        }
    }
    let children = new[Node]()
    var index = 0
    while index < length(schema.children) {
        push(children, pack_call_overlap_schema(env, child(schema, index), depth + 1))
        index = index + 1
    }
    pack_node(schema, schema.kind, schema.value, children)
}

fn pack_call_inputs_schema(context Context, caller Node, inputs CallInputs, site Node) Node {
    let sources = group(caller, NodeKind.Parameters)
    let shapes = new[Node]()
    var index = 0
    while index < length(inputs.nodes) {
        let argument = get(inputs.nodes, index)
        let source = pack_forwarded_parameter(caller, argument)
        let unknown = pack_node(argument, NodeKind.Type, "$parameter", new[Node]())
        let schema = if source >= 0 {
            match pack_forward_source_schema(context, caller, pack_forwarded_shape(get(sources, source))) {
                Result.Ok(value) => pack_call_overlap_schema(context.env, value, 0)
                Result.Err(_) => unknown
            }
        } else if argument.kind == NodeKind.Tuple && pack_forwarded_input(caller, argument, 0) {
            match pack_nested_word(context, caller, argument, 0) {
                Result.Ok(value) => pack_call_overlap_schema(context.env, value, 0)
                Result.Err(_) => unknown
            }
        } else {
            let checked Result[Expr, Failure] = match saved_input(inputs, index) {
                Option.Some(value) => Result.Ok(value)
                Option.None => static_probe(context, if argument.kind == NodeKind.Spread {
                        child(argument, 0)
                    } else {
                        argument
                    }, -1)
            }
            match checked {
                Result.Ok(value) => pack_call_overlap_schema(context.env,
                    impl_type_schema(context.env, base_type(context.env, value.ty), argument, false), 0)
                Result.Err(_) => unknown
            }
        }
        if argument.kind == NodeKind.Spread {
            if schema.kind == NodeKind.TupleType {
                var field = 0
                while field < length(schema.children) {
                    push(shapes, child(schema, field))
                    field = field + 1
                }
            } else {
                push(shapes, pack_node(argument, NodeKind.Spread, "", source_nodes(unknown)))
            }
        } else {
            push(shapes, schema)
        }
        index = index + 1
    }
    pack_node(site, NodeKind.TupleType, "tuple", shapes)
}

fn pack_call_target(context Context, caller Node, options List[Int], inputs CallInputs, site Node) Result[Int, Failure] {
    if length(options) == 1 {
        return Result.Ok(get(options, 0))
    }
    let actual = pack_call_inputs_schema(context, caller, inputs, site)
    var selected = -1
    var index = 0
    while index < length(options) {
        let target = get(options, index)
        let declaration = symbol(context.env, target).node
        let parameters = group(declaration, NodeKind.Parameters)
        let patterns = new[Node]()
        var parameter = 0
        while parameter < length(parameters) {
            let source = child(get(parameters, parameter), 0)
            let schema = match type_pattern_schema(context.env, target, source, false, 0, false) {
                Result.Ok(value) => pack_call_overlap_schema(context.env, value, 0)
                Result.Err(_) => {
                    let unknown = pack_node(source, NodeKind.Type, "$parameter", new[Node]())
                    if source.kind == NodeKind.Spread {
                        pack_node(source, NodeKind.Spread, "", source_nodes(unknown))
                    } else {
                        unknown
                    }
                }
            }
            push(patterns, schema)
            parameter = parameter + 1
        }
        if impl_schemas_overlap(pack_node(declaration, NodeKind.TupleType, "tuple", patterns), actual) {
            if selected >= 0 {
                return Result.Err(error(context, site, "variadic forwarding proof needs one declared function, not unresolved overloads"))
            }
            selected = target
        }
        index = index + 1
    }
    if selected < 0 {
        return Result.Err(error(context, site, "no accessible overload matches these forwarded sequences"))
    }
    Result.Ok(selected)
}

// One ordered argument word uses the same bounded matcher as structural types.
// Wrappers retain fixed operand positions while their children carry type words.
fn pack_nested_word(context Context, caller Node, operand Node, depth Int) Result[Node, Failure] {
    let probe = static_probe_context(context, operand)?
    let inputs = pack_forward_inputs(probe, caller, operand.children)?
    pack_call_word(probe, caller, inputs, operand, depth + 1)
}

fn pack_call_word(context Context, caller Node, inputs CallInputs, site Node, depth Int) Result[Node, Failure] {
    if depth >= 64 {
        return Result.Err(error(context, site, "forwarded argument nesting limit exceeded"))
    }
    let sources = group(caller, NodeKind.Parameters)
    let word = new[Node]()
    var index = 0
    while index < length(inputs.nodes) {
        let argument = get(inputs.nodes, index)
        let source = pack_forwarded_parameter(caller, argument)
        if argument.kind == NodeKind.Tuple && pack_forwarded_input(caller, argument, 0) {
            let schema = pack_nested_word(context, caller, argument, depth)?
            push(word, pack_node(argument, NodeKind.Arguments, "$sequence", source_nodes(schema)))
        } else if source >= 0 {
            let schema = pack_forward_source_schema(context, caller, pack_forwarded_shape(get(sources, source)))?
            if argument.kind == NodeKind.Spread {
                if schema.kind != NodeKind.TupleType {
                    return Result.Err(error(context, argument, "forwarded expansion needs a tuple source sequence"))
                }
                var member = 0
                while member < length(schema.children) {
                    push(word, child(schema, member))
                    member = member + 1
                }
            } else {
                push(word, pack_node(argument, NodeKind.Arguments, "$sequence", source_nodes(schema)))
            }
        } else {
            if argument.kind == NodeKind.Spread {
                return Result.Err(error(context, argument, "forwarded expansion needs an established source word"))
            }
            let checked Result[Expr, Failure] = match saved_input(inputs, index) {
                Option.Some(value) => Result.Ok(value)
                Option.None => static_probe(context, argument, -1)
            }
            let schema = match checked {
                Result.Ok(value) => impl_type_schema(context.env, value.ty, argument, true)
                // A fixed value may need its ordinary contextual hint ([], a
                // callback, ...). It still has an operand identity for matching.
                Result.Err(_) => pack_node(argument, NodeKind.Type, "$unresolved", new[Node]())
            }
            push(word, pack_node(argument, NodeKind.Arguments, concat("$value#", std.int.to_text(index)), source_nodes(schema)))
        }
        index = index + 1
    }
    Result.Ok(pack_node(site, NodeKind.TupleType, "tuple", word))
}

fn pack_proof_call(context Context, node Node, expected Int) Result[Expr, Failure] {
    let owner = pack_proof_caller(context)
    if owner < 0 {
        return Result.Err(error(context, node, "variadic proof calls are private to checked family proofs"))
    }
    let path = slice(node.value, length("$packcall#"), length(node.value))
    let root = slice(path, 0, first_dot(path))
    let caller = symbol(context.env, owner)
    let erased = pack_proof_sources(caller.node)
    var shadowed = lookup(context, root) >= 0 || parameter_name(context, root)
    var name = 0
    while name < length(erased) {
        shadowed = shadowed || root == get(erased, name)
        name = name + 1
    }
    if shadowed {
        return Result.Err(error(context, node, "variadic forwarding proof needs an unshadowed declared function"))
    }
    let options = candidates(context.env.source, caller.file, caller.test_only, path)
    let inputs = pack_forward_inputs(context, caller.node, child(node, 1).children)?
    let target = pack_call_target(context, caller.node, options, inputs, node)?
    let callee = symbol(context.env, target)
    let declaration = callee.node
    if callee.owner >= 0 || declaration.kind != NodeKind.Function || pack_parameter(declaration) < 0 ||
    !has(declaration, NodeKind.Ensures) {
        return Result.Err(error(context, node, "variadic forwarding proof needs a family with declared postconditions"))
    }
    let parameters = group(declaration, NodeKind.Parameters)
    let offset = length(group(declaration, NodeKind.TypeParameters))
    let work = new[PackForwardShape]()
    let types = pack_forward_explicit(context, node, caller.node, target, work)?
    let patterns = new[Node]()
    var index = 0
    while index < length(parameters) {
        let parameter = get(parameters, index)
        if has_type_expansion(child(parameter, 0)) {
            if has(parameter, NodeKind.Comptime) {
                return Result.Err(error(context, parameter, "variadic forwarding proof needs runtime source sequences"))
            }
            push(patterns, type_pattern_schema(context.env, target, child(parameter, 0), false, 0, true)?)
        } else {
            push(patterns, pack_node(parameter, NodeKind.Type, concat("$parameter#", std.int.to_text(offset + index)), new[Node]()))
        }
        index = index + 1
    }
    push(work, PackForwardShape {
            pattern = pack_node(node, NodeKind.TupleType, "tuple", patterns)
            actual = pack_call_word(context, caller.node, inputs, node, 0)?
            element = false
        })
    let bindings = pack_forward_shapes(context, caller.node, declaration, work)?
    let values = new[Int]()
    index = 0
    while index < length(parameters) {
        if !has_type_expansion(child(get(parameters, index), 0)) {
            let value = get(get(bindings.values, offset + index), 0)
            match std.int.parse(slice(value.value, 7, length(value.value))) {
                Result.Ok(position) => push(values, position)
                Result.Err(_) => {
                    return Result.Err(error(context, value, "forwarded fixed argument needs an established operand"))
                }
            }
        }
        index = index + 1
    }
    let signature = erased_pack_signature(context.env, target)?
    let call = pack_node(node, node.kind, node.value, [types,
            pack_node(child(node, 1), NodeKind.Arguments, "", inputs.nodes)])
    pack_forward_invoke(context, call, caller.node, declaration, bindings, signature, inputs, values, expected)
}
