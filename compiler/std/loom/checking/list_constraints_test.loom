fn list_constraint_files(source Text) List[TestFile] {
    let files = source_files(source)
    push(files, source_file("std.result", """
        pub enum Result[T, E] {
            Ok(T)
            Err(E)
        }
        pub enum ConstraintError {
            Rejected
        }
        """, true))
    push(files, source_file("std.list", """
        intrinsic fn list_len[T](values List[T]) Int
        intrinsic fn list_push[T](values List[T], value T)
        intrinsic fn list_set[T](values List[T], index Int, value T)
        pub fn length[T](values List[T]) Int {
            list_len(values)
        }
        pub fn push[T](values List[T], value T) {
            list_push(values, value)
        }
        pub fn set[T](values List[T], index Int, value T) {
            list_set(values, index, value)
        }
        pub fn clone[T](values List[T]) List[T] {
            let output List[T] = []
            var index = 0
            while index < length(values) {
                push(output, values[index])
                index = index + 1
            }
            output
        }
        """, true))
    files
}

fn list_constraint_checked(source Text) Result[std.loom.typed.Program, Failure] {
    checked(list_constraint_files(source))
}

fn list_constraint_accept(source Text) {
    match list_constraint_checked(source) {
        Result.Ok(_) => {
        }
        Result.Err(failed) => {
            discard write_error(failed.diagnostic.message)
            assert false
        }
    }
}

fn list_constraint_reject(source Text) {
    assert match list_constraint_checked(source) {
        Result.Err(_) => true
        Result.Ok(_) => false
    }
}

fn list_constraint_source() Text {
    """
    import std.list.length
    import std.list.clone
    import std.list.push
    import std.result.Result
    import std.result.ConstraintError
    fn positive(values List[Int]) Bool {
        var index = 0
        while index < length(values) {
            if values[index] <= 0 {
                return false
            }
            index = index + 1
        }
        length(values) > 0
    }
    type Positive = List[Int] where positive(self)
    fn sum(values List[Int]) Int {
        var total = 0
        var index = 0
        while index < length(values) {
            total = total + values[index]
            index = index + 1
        }
        total
    }
    """
}

test fn single_element_updates_prove_the_complete_content_constraint() {
    let header = """
    import std.list.length
    import std.list.set
    type Positive = Int where self > 0
    fn positive_head(values List[Int]) Bool {
        length(values) > 0 && values[0] > 0
    }
    type PositiveHead = List[Int] where positive_head(self)

    """
    list_constraint_accept(concat(header, """
        fn replace(values PositiveHead, value Positive) {
            values[0] = value
        }
        fn forwarded(values List[Int], index Int, value Int) {
            set(values, index, value)
        }
        fn main() {
            let values = PositiveHead([1, 2])
            let alias = values
            replace(values, Positive(3))
            forwarded(alias, 0, Positive(4))
            assert values[0] == 4 && length(values) == 2
        }
        """))
    list_constraint_reject(concat(header, """
        pub fn unknown(values PositiveHead, value Int) {
            values[0] = value
        }
        """))
    list_constraint_reject(concat(header, """
        pub fn invalid(values PositiveHead) {
            set(values, 0, 0)
        }
        """))
    list_constraint_reject(concat(header, """
        fn temporary(values List[Int]) {
            values[0] = -1
            values[0] = 1
        }
        pub fn invalid(values PositiveHead) {
            temporary(values)
        }
        """))
}

test fn atomic_updates_reuse_only_stable_caller_conditions() {
    let header = """
    import std.list.length
    import std.list.set
    fn positive_head(values List[Int]) Bool {
        length(values) > 0 && values[0] > 0
    }
    type PositiveHead = List[Int] where positive_head(self)
    fn positive(value Int) Bool {
        value > 0
    }
    fn forwarded(values List[Int], index Int, value Int) {
        set(values, index, value)
    }

    """
    list_constraint_accept(concat(header, """
        pub fn required(values PositiveHead, value Int)
        requires value > 0
        {
            values[0] = value
        }
        pub fn guarded(values PositiveHead, value Int) {
            if positive(value) {
                let copied = value
                forwarded(values, 0, copied)
            }
        }
        pub fn asserted(values PositiveHead, value Int) {
            assert value > 0
            set(values, 0, value)
        }
        pub fn after_exit(values PositiveHead, value Int) {
            if value <= 0 {
                return
            }
            values[0] = value
        }
        pub fn callback(values PositiveHead, value Int)
        requires value > 0
        {
            (fn(items List[Int], index Int, replacement Int) {
                set(items, index, replacement)
            })(values, 0, value)
        }
        """))
    list_constraint_reject(concat(header, """
        pub fn mutable(values PositiveHead, input Int) {
            var value = input
            assert value > 0
            value = -1
            values[0] = value
        }
        """))
    list_constraint_reject(concat(header, """
        pub fn heap(values PositiveHead, source List[Int]) {
            assert source[0] > 0
            source[0] = -1
            set(values, 0, source[0])
        }
        """))
    list_constraint_reject(concat(header, """
        pub fn disjunction(values PositiveHead, value Int, flag Bool) {
            if flag || value > 0 {
                set(values, 0, value)
            }
        }
        """))
    list_constraint_reject(concat(header, """
        pub fn escaped(values PositiveHead, value Int) {
            if value > 0 {
                assert true
            }
            values[0] = value
        }
        """))
}

test fn direct_invariant_reads_use_the_existing_observation_rules() {
    list_constraint_accept("""
        import std.list.length
        type Positive = Int where self > 0
        type PositiveHead = List[Int] where length(self) > 0 && self[0] > 0
        fn same(values List[Int]) List[Int] {
            values
        }
        type ViaGetter = List[Int] where length(self) > 0 && same(self)[0] > 0
        fn replace(values PositiveHead, value Positive) {
            values[0] = value
        }
        fn main() {
            let values = PositiveHead([1, 2])
            replace(values, Positive(3))
            assert values[0] == 3
            let via = ViaGetter([4, 5])
            assert via[0] == 4
        }
        """)
    list_constraint_reject("""
        import std.list.length
        type PositiveHead = List[Int] where length(self) > 0 && self[0] > 0
        pub fn invalid(values PositiveHead) {
            values[0] = -1
        }
        """)
    list_constraint_reject("""
        import std.list.length
        type Nested = List[List[Int]] where length(self) > 0 && length(self[0]) > 0
        fn main() {
            discard Nested([[1]])
        }
        """)
}

test fn helper_mutations_preserve_the_invariant_at_each_write() {
    let header = """
    import std.list.length
    import std.list.set
    fn positive_head(values List[Int]) Bool {
        length(values) > 0 && values[0] > 0
    }
    type PositiveHead = List[Int] where positive_head(self)

    """
    list_constraint_accept(concat(header, """
        fn twice(values List[Int], value Int) {
            let alias = values
            set(alias, 0, value)
            alias[0] = value
        }
        fn guarded(values List[Int], value Int) Int {
            if value <= 0 {
                return 0
            }
            twice(values, value)
            return value
        }
        pub fn update(values PositiveHead, value Int) Int {
            guarded(values, value)
        }
        fn main() {
            let values = PositiveHead([1, 2])
            twice(values, 3)
            assert update(values, 4) == 4
            assert update(values, -1) == 0 && values[0] == 4
        }
        """))
    list_constraint_reject(concat(header, """
        fn temporary(values List[Int]) {
            values[0] = -1
            assert false
            values[0] = 1
        }
        pub fn invalid(values PositiveHead) {
            temporary(values)
        }
        """))
    list_constraint_reject(concat(header, """
        fn escaped(values List[Int], storage List[List[Int]]) {
            std.list.push(storage, values)
            values[0] = 1
        }
        pub fn invalid(values PositiveHead, storage List[List[Int]]) {
            escaped(values, storage)
        }
        """))
}

test fn appends_prove_the_complete_constraint_without_publishing_storage() {
    let header = """
    import std.list.length
    import std.list.push
    type PositiveHead = List[Int] where length(self) > 0 && self[0] > 0
    fn append_twice(values List[Int], value Int) {
        push(values, value)
        push(values, value)
    }

    """
    list_constraint_accept(concat(header, """
        pub fn append(values PositiveHead, value Int) {
            push(values, value)
            append_twice(values, value)
        }
        fn main() {
            let values = PositiveHead([1])
            let alias = values
            append(values, -1)
            assert length(alias) == 4 && alias[0] == 1 && alias[3] == -1
        }
        """))
    list_constraint_reject(concat(header, """
        type Pair = List[Int] where length(self) == 2 && self[0] > 0
        pub fn invalid(values Pair) {
            push(values, 1)
        }
        """))
    list_constraint_reject(concat(header, """
        fn temporary(values List[Int]) {
            push(values, 1)
            values[0] = -1
            assert false
        }
        pub fn invalid(values PositiveHead) {
            temporary(values)
        }
        """))
    list_constraint_reject(concat(header, """
        fn escaped(values List[Int], storage List[List[Int]]) {
            push(storage, values)
            push(values, 1)
        }
        pub fn invalid(values PositiveHead, storage List[List[Int]]) {
            escaped(values, storage)
        }
        """))
}

test fn generic_list_extent_constraints_ignore_shared_element_contents() {
    list_constraint_accept("""
        import std.list.length
        type Nonempty[T] = List[T] where length(self) > 0
        fn filled[T](value T) Nonempty[T] {
            Nonempty([value])
        }
        fn size[T](values Nonempty[T]) Int {
            length(values)
        }
        fn main() {
            assert size(filled(42)) == 1
            let inner = [1]
            let outer = filled(inner)
            inner[0] = -1
            assert size(outer) == 1
        }
        """)
    list_constraint_reject("""
        import std.list.length
        type Nonempty[T] = List[T] where length(self) > 0
        fn expose[T](values Nonempty[T]) List[T] {
            values
        }
        fn main() {
            discard expose(Nonempty([1]))
        }
        """)
    list_constraint_reject("""
        import std.list.length
        type Nonempty[T] = List[T] where length(self) > 0
        fn empty() Nonempty[Int] {
            Nonempty[Int]([])
        }
        """)
}

test fn generic_extent_constraints_keep_content_and_task_boundaries() {
    list_constraint_reject("""
        import std.list.length
        fn positive(values List[List[Int]]) Bool {
            length(values) > 0 && length(values[0]) > 0 && values[0][0] > 0
        }
        type Positive = List[List[Int]] where positive(self)
        pub fn use(value Positive) Int {
            length(value)
        }
        """)
    assert match list_constraint_checked("""
        import std.list.length
        type Nonempty[T] = List[T] where length(self) > 0
        pub fn invalid(value Nonempty[Task[Int]]) {
            discard value
        }
        """) {
        Result.Err(failed) => failed.diagnostic.message == "refinements cannot contain scoped resources or one-shot Tasks"
        Result.Ok(_) => false
    }
}

test fn list_constraints_accept_fresh_storage_and_non_escaping_reads() {
    list_constraint_accept(concat(list_constraint_source(), """
        fn copied(input List[Int]) Result[Positive, ConstraintError] {
            Positive(clone(input))
        }
        fn constructed(value Int) Result[Positive, ConstraintError] {
            Positive([value, 2])
        }
        fn literal() Positive {
            Positive([1, 2, 3])
        }
        fn read(value Positive) Int {
            sum(value) + value[0]
        }
        fn main() {
            let strict = literal()
            let alias = strict
            assert read(alias) == 7
            let loose = clone(strict)
            loose[0] = -1
            assert strict[0] == 1
        }
        """))
}

test fn extent_factories_share_elements_without_sharing_the_outer_header() {
    list_constraint_accept("""
        import std.list.length
        import std.list.clone
        import std.list.push
        import std.result.Result
        import std.result.ConstraintError
        type Nonempty[T] = List[T] where length(self) > 0
        fn copied[T](values List[T]) Result[Nonempty[T], ConstraintError] {
            Nonempty(clone(values))
        }
        fn first(values List[List[Int]]) Int {
            values[0][0]
        }
        fn main() {
            let inner = [1]
            let input = [inner]
            match copied(input) {
                Result.Ok(value) => {
                    push(input, inner)
                    inner[0] = 7
                    assert length(value) == 1
                    assert first(value) == 7
                }
                Result.Err(_) => {
                    assert false
                }
            }
        }
        """)
    list_constraint_reject("""
        import std.list.length
        import std.result.Result
        import std.result.ConstraintError
        type Nonempty = List[Int] where length(self) > 0
        fn nested(input List[List[Int]]) List[Int] {
            input[0]
        }
        pub fn invalid(input List[List[Int]]) Result[Nonempty, ConstraintError] {
            Nonempty(nested(input))
        }
        """)
}

test fn constrained_reads_return_elements_that_cannot_contain_the_outer_header() {
    list_constraint_accept("""
        import std.list.length
        import std.list.push
        type Nonempty[T] = List[T] where length(self) > 0
        record Row {
            items List[Int]
        }
        enum Item {
            Value(Row)
        }
        fn filled[T](value T) Nonempty[T] {
            Nonempty([value])
        }
        fn direct[T](values Nonempty[T]) T {
            values[0]
        }
        fn forwarded[T](values List[T]) T {
            values[0]
        }
        fn read[T](values Nonempty[T]) T {
            forwarded(values)
        }
        fn main() {
            let inner = [1]
            let rows = filled(Row { items = inner })
            direct(rows).items[0] = 7
            assert length(rows) == 1
            match read(filled(Item.Value(Row { items = inner }))) {
                Item.Value(row) => {
                    push(row.items, 9)
                }
            }
            let tuple = direct(filled((inner, true)))
            push(tuple.0, 5)
            assert inner[0] == 7 && length(inner) == 3
        }
        """)
}

test fn constrained_element_results_do_not_expose_recursive_or_opaque_backrefs() {
    list_constraint_reject("""
        import std.list.length
        record Node {
            children List[Node]
        }
        type Nonempty = List[Node] where length(self) > 0
        pub fn expose(values Nonempty) Node {
            values[0]
        }
        """)
    list_constraint_reject("""
        import std.list.length
        type Nonempty = List[fn() Int] where length(self) > 0
        pub fn expose(values Nonempty) fn() Int {
            values[0]
        }
        """)
}

fn account_constraint_source() Text {
    """
    import std.list.length
    import std.list.clone
    import std.list.push
    import std.result.Result
    import std.result.ConstraintError
    record Account[T] {
        amount Int
        notes T
    }
    fn amount[T](value Account[T]) Int {
        value.amount
    }
    fn positive[T](values List[Account[T]]) Bool {
        var index = 0
        while index < length(values) {
            if amount(values[index]) <= 0 {
                return false
            }
            index = index + 1
        }
        length(values) > 0
    }
    type PositiveAccounts[T] = List[Account[T]] where positive(self)

    """
}

test fn list_content_constraints_observe_immutable_fields_not_shared_siblings() {
    list_constraint_accept(concat(account_constraint_source(), """
        fn copied[T](values List[Account[T]]) Result[PositiveAccounts[T], ConstraintError] {
            PositiveAccounts(clone(values))
        }
        fn first(values PositiveAccounts[List[Int]]) Account[List[Int]] {
            values[0]
        }
        fn main() {
            let notes = [1]
            let input = [Account {
                amount = 10
                notes = notes
            }]
            match copied(input) {
                Result.Ok(values) => {
                    input[0] = Account {
                        amount = -1
                        notes = notes
                    }
                    first(values).notes[0] = -2
                    assert values[0].amount == 10 && notes[0] == -2
                }
                Result.Err(_) => {
                    assert false
                }
            }
        }
        """))
    list_constraint_reject(concat(account_constraint_source(), """
        pub fn invalid(values PositiveAccounts[List[Int]]) {
            values[0] = Account {
                amount = -1
                notes = []
            }
        }
        """))
}

test fn list_predicates_reject_indirect_storage_even_with_the_same_header_type() {
    list_constraint_reject("""
        import std.list.length
        record Node {
            children List[Node]
        }
        fn nested(values List[Node]) Bool {
            length(values) > 0 && length(values[0].children) > 0
        }
        type Nested = List[Node] where nested(self)
        pub fn use(values Nested) Int {
            length(values)
        }
        """)
    list_constraint_reject("""
        import std.list.length
        record Account {
            amount Int
            notes List[Int]
        }
        fn observed(value Account) Bool {
            length(value.notes) > 0 && value.notes[0] > 0
        }
        fn positive(values List[Account]) Bool {
            length(values) > 0 && observed(values[0])
        }
        type Positive = List[Account] where positive(self)
        pub fn use(values Positive) Int {
            length(values)
        }
        """)
}

test fn list_constraints_reject_old_aliases_mutation_and_unrestricted_escapes() {
    let header = list_constraint_source()
    list_constraint_reject(concat(header, """
        fn invalid(input List[Int]) Result[Positive, ConstraintError] {
            Positive(input)
        }
        """))
    list_constraint_reject(concat(header, """
        fn invalid(value Positive) {
            value[0] = -1
        }
        """))
    list_constraint_reject(concat(header, """
        fn write(values List[Int]) {
            push(values, -1)
        }
        fn invalid(value Positive) {
            write(value)
        }
        """))
    list_constraint_reject(concat(header, """
        fn identity[T](value T) T {
            value
        }
        fn invalid(value Positive) List[Int] {
            identity(value)
        }
        """))
    list_constraint_reject(concat(header, """
        record Box {
            values List[Int]
        }
        fn invalid(value Positive) Box {
            Box { values = value }
        }
        """))
    list_constraint_reject(concat(header, """
        fn alias(value List[Int]) List[Int] {
            value
        }
        fn invalid(value Positive) List[Int] {
            alias(value)
        }
        """))
}

test fn list_constraint_factories_must_not_publish_or_return_input_aliases() {
    let header = list_constraint_source()
    list_constraint_reject(concat(header, """
        fn fake_clone(value List[Int]) List[Int] {
            value
        }
        fn invalid(input List[Int]) Result[Positive, ConstraintError] {
            Positive(fake_clone(input))
        }
        """))
    list_constraint_reject(concat(header, """
        fn publish(output List[List[Int]]) List[Int] {
            let values = [1, 2]
            push(output, values)
            values
        }
        fn invalid(output List[List[Int]]) Result[Positive, ConstraintError] {
            Positive(publish(output))
        }
        """))
    list_constraint_reject(concat(header, """
        fn invalid() Positive {
            Positive([0])
        }
        """))
    list_constraint_reject(concat(header, """
        fn invalid() Positive {
            Positive([])
        }
        """))
}

test fn length_constraints_allow_shared_element_replacement_through_helpers() {
    list_constraint_accept(concat(list_constraint_source(), """
        fn sized(values List[Int]) Bool {
            length(values) == 2
        }
        type Pair = List[Int] where sized(self)
        fn replace[T](values List[T], item T) {
            let alias = values
            var index = 0
            while index < length(alias) {
                alias[index] = item
                index = index + 1
            }
        }
        fn main() {
            let values = Pair([1, 2])
            let alias = values
            values[0] = -1
            assert alias[0] == -1
            replace(values, 8)
            assert alias[0] == 8 && alias[1] == 8
        }
        """))
}

test fn preserving_writes_require_disjoint_effects_and_cannot_publish_aliases() {
    let header = concat(list_constraint_source(), "\ntype Pair = List[Int] where length(self) == 2\n")
    list_constraint_reject(concat(header, """
        fn invalid(value Pair) {
            push(value, 3)
        }
        """))
    list_constraint_reject(concat(header, """
        fn resize(values List[Int]) {
            push(values, 3)
        }
        fn invalid(value Pair) {
            resize(value)
        }
        """))
    list_constraint_reject(concat(header, """
        fn leak(values List[Int], target List[List[Int]]) {
            target[0] = values
        }
        fn invalid(value Pair, target List[List[Int]]) {
            leak(value, target)
        }
        """))
    list_constraint_reject(concat(header, """
        fn replace(values List[Int], item Int) {
            values[0] = item
        }
        fn invalid(value Positive) {
            replace(value, -1)
        }
        """))
    list_constraint_reject(concat(header, """
        fn observed(values List[Int]) Bool {
            let alias = values
            if length(alias) == 2 {
                return alias[0] > 0
            }
            false
        }
        type Observed = List[Int] where observed(self)
        fn invalid(value Observed) {
            value[0] = -1
        }
        """))
    list_constraint_reject(concat(header, """
        fn first_positive(values List[Int]) Bool {
            values[0] > 0
        }
        fn invoke(values List[Int], predicate fn(List[Int]) Bool) Bool {
            predicate(values)
        }
        type Observed = List[Int] where invoke(self, first_positive)
        fn invalid(value Observed) {
            value[0] = -1
        }
        """))
    list_constraint_reject(concat(header, """
        fn invalid(value Pair) List[Int] {
            value
        }
        """))
}

test fn cached_predicate_edits_revoke_element_write_permissions() {
    let source = concat(list_constraint_source(), """
        fn sized(values List[Int]) Bool {
            length(values) == 2
        }
        type Pair = List[Int] where sized(self)
        pub fn replace(value Pair) {
            value[0] = 8
        }
        """)
    let initial = definition_cache()
    assert match check_project_cached(fixture_project(list_constraint_files(source)),
        false, build_inputs(no_input_reader), initial) {
        Result.Ok(_) => true
        Result.Err(_) => false
    }
    let cache = restored_definition_cache(initial)
    let changed = std.text.join(std.text.split(source, "length(values) == 2"), "values[0] == 2")
    assert match check_project_cached(fixture_project(list_constraint_files(changed)),
        false, build_inputs(no_input_reader), cache) {
        Result.Err(_) => true
        Result.Ok(_) => false
    }
}

test fn list_append_requires_a_preservation_proof_not_just_length_only_reads() {
    let header = list_constraint_source()
    list_constraint_accept(concat(header, """
        fn enough(values List[Int]) Bool {
            let count = length(values)
            count >= 2
        }
        type Enough = List[Int] where enough(self)
        fn append_twice(values List[Int], value Int) {
            push(values, value)
            push(values, value)
        }
        fn main() {
            let values = Enough([1, 2])
            let alias = values
            append_twice(values, 3)
            assert length(alias) == 4
        }
        """))
    list_constraint_reject(concat(header, """
        type Bounded = List[Int] where length(self) > 0 && length(self) < 4
        fn invalid(values Bounded) {
            push(values, 1)
        }
        """))
    list_constraint_reject(concat(header, """
        fn valid(values List[Int]) Bool {
            length(values) + 1 > 0
        }
        type Overflow = List[Int] where valid(self)
        fn invalid(values Overflow) {
            push(values, 1)
        }
        """))
    list_constraint_reject(concat(header, """
        fn required(count Int) Bool
        requires count < 4
        {
            count > 0
        }
        type Limited = List[Int] where required(length(self))
        fn invalid(values Limited) {
            push(values, 1)
        }
        """))
}

test fn immutable_aggregate_literals_prove_constraints_without_result_wrapping() {
    let header = concat(list_constraint_source(), """
        record Label {
            name Text
            pair (Int, Bool)
        }
        enum Item {
            Labeled(Label)
            Empty
        }
        fn labeled(values List[Item]) Bool {
            length(values) == 1 && match values[0] {
                Item.Labeled(value) => value.name == "ok" && value.pair.0 > 0 && value.pair.1
                Item.Empty => false
            }
        }
        type Labeled = List[Item] where labeled(self)
        type Named = Label where self.name == "ok"

        """)
    list_constraint_accept(concat(header, """
        fn literal() Labeled {
            Labeled([Item.Labeled(Label {
                        name = "ok"
                        pair = (1, true)
                    })])
        }
        fn named() Named {
            Named(Label {
                    name = "ok"
                    pair = (1, true)
                })
        }
        """))
    let invalid = concat(header, """
        fn literal() Labeled {
            Labeled([Item.Empty])
        }
        """)
    assert match list_constraint_checked(invalid) {
        Result.Err(failed) => failed.diagnostic.message == "this constant does not satisfy the type constraint"
        Result.Ok(_) => false
    }
}
