import std.loom.binding.Failure
import std.loom.typed.TypeKind
import std.list.new
import std.list.get
import std.list.push
import std.list.length
import std.result.Result

// Supplied type arguments were admitted at the call site. Preserve only the
// domains written on their nominal declarations, not arbitrary conformances
// visible in the caller. This lets a nested checked type cross a test boundary
// without asking production code to rediscover its test-only prerequisite.
fn supplied_type_domains(env Environment, owner Int, ty Int, obligations List[Requirement], seen List[Int], depth Int) Result[Bool, Failure] {
    let shape = get(env.types, ty)
    if length(shape.arguments) == 0 {
        return Result.Ok(true)
    }
    if depth > 64 {
        return Result.Err(failure(env, owner, symbol(env, owner).node, "type requirement expansion must be finite"))
    }
    var index = 0
    while index < length(seen) {
        if get(seen, index) == ty {
            return Result.Ok(true)
        }
        index = index + 1
    }
    push(seen, ty)
    if shape.kind == TypeKind.Record || shape.kind == TypeKind.Enum || shape.kind == TypeKind.Refined {
        let bounds = data_requirements(env, shape)?
        index = 0
        while index < length(bounds) {
            let bound = get(bounds, index)
            if !required(obligations, bound.ty, bound.capability) {
                push(obligations, bound)
            }
            index = index + 1
        }
    }
    index = 0
    while index < length(shape.arguments) {
        discard supplied_type_domains(env, owner, get(shape.arguments, index), obligations, seen, depth + 1)?
        index = index + 1
    }
    Result.Ok(true)
}

// Concrete evidence selects one checked implementation. Its declared bounds
// are prerequisites of that evidence, even when the implementation came from
// the test scope. Do not select implementations for abstract promises or infer
// unrelated caller-visible conformances.
fn supplied_evidence_domains(env Environment, owner Int, evidence Requirement, obligations List[Requirement], depth Int) Result[Bool, Failure] {
    if !concrete(env, evidence.ty) {
        return Result.Ok(true)
    }
    if depth >= 64 {
        return Result.Err(failure(env, owner, symbol(env, owner).node, "conformance requirements must resolve finitely"))
    }
    let selected = conformance(env, evidence.ty, evidence.capability)
    if selected.implementation < 0 {
        return Result.Ok(true)
    }
    let header = get(env.implementations, selected.implementation)
    let bounds = requirements(env, header.symbol, selected.arguments)?
    var index = 0
    while index < length(bounds) {
        let bound = get(bounds, index)
        if !required(obligations, bound.ty, bound.capability) {
            push(obligations, bound)
            discard supplied_evidence_domains(env, owner, bound, obligations, depth + 1)?
        }
        index = index + 1
    }
    Result.Ok(true)
}

fn scoped_type_domains(env Environment, current Signature, arguments List[Int]) Result[Signature, Failure] {
    if length(arguments) == 0 || length(env.concepts) == 0 {
        return Result.Ok(current)
    }
    let obligations = new[Requirement]()
    var index = 0
    while index < length(current.requirements) {
        push(obligations, get(current.requirements, index))
        index = index + 1
    }
    let seen = new[Int]()
    index = 0
    while index < length(arguments) {
        discard supplied_type_domains(env, current.symbol, get(arguments, index), obligations, seen, 0)?
        index = index + 1
    }
    let count = length(obligations)
    index = 0
    while index < count {
        discard supplied_evidence_domains(env, current.symbol, get(obligations, index), obligations, 0)?
        index = index + 1
    }
    Result.Ok(Signature {
            symbol = current.symbol
            parameters = current.parameters
            params = current.params
            compile_time = current.compile_time
            result = current.result
            requirements = obligations
        })
}
