test fn async_calls_keep_logical_results_and_creation_locations() {
    let program = accepted("async fn identity[T](value T) T { value }\nasync fn empty() {}\nasync fn main() { let first Task[Int] = identity(7)\nlet second = first\nassert second.await == 7\nassert identity(\"text\").await == \"text\"\nempty().await }")
    let main = get(program.functions, program.entry)
    assert main.is_async && main.result == 0
    let creation = get(get(main.body.children, 0).children, 0)
    assert creation.kind == ExprKind.TaskCall
    let shape = get(program.types, creation.ty)
    assert shape.kind == TypeKind.Task && get(shape.arguments, 0) == 1
    assert creation.text == "app:3:41: task created here"
    assert get(program.functions, creation.index).is_async
    assert get(program.functions, creation.index).result == 1
    let awaited = get(get(get(main.body.children, 2).children, 0).children, 0)
    assert awaited.kind == ExprKind.Await && awaited.ty == 1
    let last = get(main.body.children, length(main.body.children) - 1)
    assert last.kind == ExprKind.Await && last.ty == 0
    discard accepted_result("import std.result.Result\nasync fn item() Result[Int, Text] { Result.Ok(7) }\nasync fn answer() Result[Int, Text] { let value = item().await?\nResult.Ok(value + 1) }\nasync fn main() { discard answer().await }")
    let project = fixture_project(source_files("async fn item() Int { 1 }\ntest async fn example() { assert item().await == 1 }"))
    match bind(project, true) {
        Result.Ok(bound) => {
            match check(bound) {
                Result.Ok(tested) => {
                    assert length(tested.tests) == 1
                    assert get(tested.functions, get(tested.tests, 0)).is_async
                }
                Result.Err(_) => {
                    assert false
                }
            }
        }
        Result.Err(_) => {
            assert false
        }
    }
}

test fn task_consumption_agrees_across_branches_and_loop_iterations() {
    discard accepted("async fn item() Int { 7 }\nasync fn work(flag Bool) { let task = item()\nif flag { discard task.await } else { discard task.await }\nvar n = 0\nwhile n < 2 { let next = item()\nlet moved = next\ndiscard moved.await\nn = n + 1\nif n == 1 { continue }\nbreak } }\nasync fn main() { work(true).await }")
    discard accepted("async fn item() Bool { true }\nasync fn work(flag Bool) { let task = item()\nif flag { discard task.await\nreturn }\ndiscard task.await\ndiscard flag && item().await }\nasync fn main() { work(false).await }")
    rejects("async fn item() Int { 1 }\nasync fn main() { let task = item()\nif true { discard task.await } }")
    rejects("async fn item() Int { 1 }\nasync fn main() { let task = item()\nwhile true { discard task.await\nbreak } }")
    rejects("async fn item() Int { 1 }\nasync fn main() { while true { let task = item()\nbreak } }")
    rejects("async fn item() Bool { true }\nasync fn main() { let task = item()\ndiscard true && task.await }")
}

test fn tasks_cannot_be_lost_duplicated_or_escaped() {
    rejects("async fn item() Int { 1 }\nasync fn unused() { let task = item() }")
    rejects("async fn item() Int { 1 }\nasync fn main() { discard item() }")
    rejects("async fn item() Int { 1 }\nasync fn main() { let task = item()\ndiscard task.await\ndiscard task.await }")
    rejects("async fn item() Int { 1 }\nasync fn main() { let task = item()\nlet moved = task\ndiscard task.await\ndiscard moved.await }")
    rejects("async fn item() Int { 1 }\nasync fn main() { var task = item()\ntask = item()\ndiscard task.await }")
    rejects("async fn item() Int { 1 }\nasync fn main() { let task = item()\nreturn }")
    rejects("async fn item() Int { 1 }\nfn pass(value Task[Int]) {}")
    rejects("async fn item() Int { 1 }\nasync fn main() { let values = [item()]\ndiscard values }")
    rejects("async fn item() Int { 1 }\nasync fn main() { let pair = (item(), 1)\ndiscard pair }")
    discard accepted("async fn item() Int { 1 }\nfn main() { let f = item\ndiscard f }")
    discard accepted("concept C { async fn item(self Self) Int }")
}

test fn suspension_requires_async_and_cannot_run_inside_cleanup() {
    rejects("async fn item() Int { 1 }\nfn main() { discard item().await }")
    rejects("async fn main() { discard 1.await }")
    discard accepted("async fn item() Int { 1 }\nasync fn main() { defer {}\ndiscard item().await }")
    rejects("async fn item() Int { 1 }\nasync fn main() { defer { discard item().await } }")
    discard accepted("async fn item() Int { 1 }\nasync fn main() { if true { defer {} }\ndiscard item().await }")
    rejects("async fn item() Int { 1 }\nasync fn main() { discard comptime { item().await } }")
    rejects("async fn item() Int { 1 }\nfn main() { discard comptime { item } }")
    rejects("async fn item() Int { 1 }\nfn main() { discard comptime { item() } }")
}

test fn async_contracts_keep_mandatory_logical_result_proofs() {
    discard accepted("async fn twice(value Int) Int requires value >= 0 ensures result == value + value { value + value }\nasync fn main() { assert twice(2).await == 4 }")
    rejects("async fn wrong(value Int) Int ensures result == value + 1 { value }")
    rejects("async fn item() Int { 1 }\nasync fn uncertain() Int ensures result == 1 { item().await }")
}

fn task_rejected(text Text, message Text) {
    match checked(source_files(text)) {
        Result.Err(failed) => {
            if failed.diagnostic.message != message { discard write_error(failed.diagnostic.message) }
            assert failed.diagnostic.message == message
        }
        Result.Ok(_) => { assert false }
    }
}

test fn direct_task_parameters_returns_and_nested_awaits_transfer_once() {
    discard accepted("async fn item[T](value T) T { value }\nfn make[T](value T) Task[T] { item(value) }\nfn pass[T](task Task[T]) Task[T] { task }\nfn identity[T](value T) T { value }\nasync fn wrap[T](task Task[T]) Task[T] { task }\nasync fn read[T](task Task[T]) T { task.await }\nasync fn main() { let outer Task[Task[Int]] = wrap(identity(pass(make(7))))\nlet inner = outer.await\nassert read(inner).await == 7\nassert wrap(make(\"text\")).await.await == \"text\" }")
    discard accepted("enum Choice { Yes No }\nasync fn item() Int { 7 }\nfn pick(task Task[Int], flag Bool) Task[Int] { if flag { return task }\ntask }\nfn branch(task Task[Int], flag Bool) Task[Int] { if flag { task } else { task } }\nfn matched(task Task[Int], flag Choice) Task[Int] { match flag { Choice.Yes => task, Choice.No => task } }\nasync fn main() { assert matched(branch(pick(item(), true), false), Choice.Yes()).await == 7 }")
    discard accepted("async fn item[T](value T) T { value }\nfn pass(task Task[Int], comptime selected Bool) Task[Int] { task }\nasync fn empty() {}\nfn forward[T](task Task[T]) Task[T] { return task }\nasync fn main() { assert pass(item(3), true).await == 3\nforward(empty()).await }")
    discard accepted("async fn item() Int { 7 }\nfn pick(task Task[Int], comptime flag Bool) Task[Int] { if flag { task } else { task } }\nasync fn main() { assert pick(item(), true).await == 7 }")
    task_rejected("fn pick(task Task[Int], comptime flag Bool) Task[Int] { comptime if flag { task } else { task } }", "a task is still live at function exit; await or transfer it before returning")
}

test fn task_call_arguments_preserve_pending_obligations_across_control_flow() {
    let prefix = "async fn item() Int { 7 }\nasync fn read(task Task[Int], extra Int) Int { task.await + extra }\n"
    let pending = "a task argument is still pending; finish its call before returning"
    task_rejected(concat(prefix, "async fn work(flag Bool) { let task = item()\ndiscard read(task, { if flag { return }\n0 }).await }"), pending)
    task_rejected(concat(prefix, "async fn work(flag Bool) { discard read(item(), { if flag { return }\n0 }).await }"), pending)
    let loops = "loop exits must consume loop-local tasks and preserve outer tasks"
    task_rejected(concat(prefix, "async fn main() { while true { discard read(item(), { if true { break }\n0 }).await } }"), loops)
    task_rejected(concat(prefix, "async fn main() { while true { discard read(item(), { if true { continue }\n0 }).await } }"), loops)
    discard accepted(concat(prefix, "async fn main() { assert read(item(), { var n = 0\nwhile n < 1 { n = n + 1\nbreak }\nn }).await == 8\nassert read(item(), item().await).await == 14 }"))
}

test fn task_transfers_reject_unused_parameters_duplicate_arguments_and_hidden_cleanup() {
    let prefix = "async fn item() Int { 7 }\nfn pass(task Task[Int]) Task[Int] { task }\nasync fn pair(a Task[Int], b Task[Int]) Int { a.await + b.await }\n"
    let live = "a task is still live at function exit; await or transfer it before returning"
    task_rejected("fn unused(task Task[Int]) {}", live)
    task_rejected(concat(prefix, "fn drop[T](value T) {}\nasync fn main() { drop(item()) }"), live)
    rejects(concat(prefix, "async fn main() { let task = item()\ndiscard pair(task, task).await }"))
    rejects(concat(prefix, "async fn outer() Task[Int] { item() }\nasync fn main() { discard outer().await }"))
    rejects(concat(prefix, "async fn outer() Task[Int] { item() }\nasync fn main() { let nested = outer()\nlet inner = nested.await }"))
    rejects(concat(prefix, "async fn wrong(flag Bool) Task[Int] { let a = item()\nlet b = item()\nif flag { a } else { b } }"))
    let cleanup = "task creation, reading or transfer in cleanup is not yet implemented"
    task_rejected(concat(prefix, "fn wrong(task Task[Int]) Task[Int] { var saved = task\ndefer { saved = pass(saved) }\nsaved }"), cleanup)
    task_rejected(concat(prefix, "fn sink(task Task[Int]) { sink(task) }\nfn wrong(task Task[Int]) Task[Int] { defer { sink(item()) }\ntask }"), cleanup)
    discard accepted(concat(prefix, "fn clean(task Task[Int]) Task[Int] { defer { assert true }\ntask }\nasync fn main() { assert clean(item()).await == 7 }"))
}

test fn task_owner_requirements_cannot_escape_through_function_or_compile_time_values() {
    let prefix = "async fn item() Int { 7 }\nfn factory() Task[Int] { item() }\nfn pass[T](value T) T { value }\n"
    let owner = "task creation or transfer requires an async function or a direct Task parameter or return type"
    task_rejected(concat(prefix, "fn main() { let task = factory() }"), owner)
    task_rejected(concat(prefix, "fn sink(task Task[Int]) { sink(task) }\nfn main() { sink(item()) }"), owner)
    discard accepted(concat(prefix, "fn main() { let callback = factory\ndiscard callback }"))
    task_rejected(concat(prefix, "fn main() { discard comptime { pass[Task[Int]] } }"), "compile-time evaluation cannot transfer tasks")
    rejects(concat(prefix, "fn ignored(value List[Task[Int]]) {}"))
    task_rejected("fn empty[T]() List[T] { [] }\nfn unused() { discard empty[Task[Int]]() }", "storing tasks in aggregates is not yet implemented")
    rejects(concat(prefix, "fn ignored(value Task[List[Task[Int]]]) Task[List[Task[Int]]] { value }"))
    rejects(concat(prefix, "record Held { task Task[Int] }\nfn ignored(value Task[Held]) Task[Held] { value }"))
    discard accepted(concat(prefix, "concept Factory { fn create(self Self) Task[Int] }\nimpl Factory for Int { fn create(self Int) Task[Int] { factory() } }\nasync fn main() { let provider dyn Factory = 1\ndiscard provider.create().await }"))
    rejects(concat(prefix, "async fn main() { discard comptime { factory() } }"))
    resource_reject(concat(resource_header(), "async fn acquire() Handle { make([0]) }"))
    resource_reject(concat(resource_header(), "fn forward(task Task[Handle]) Task[Handle] { task }"))
}
