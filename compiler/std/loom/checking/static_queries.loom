import std.loom.source.Span

record CheckInputs {
    build BuildInputs
    type_index TypeIndex
    signature_ids List[Int]
    static_queries List[StaticReferenceQuery]
    declaration_queries Bool
    declaration_references List[DeclarationReference]
    staged_queries List[StagedQuery]
    type_alias_queries List[List[ParameterHeader]]
    type_computations List[ImplTypeComputation]
    reference_indices List[List[Int]]
    template_queries List[Int]
    template_seen List[Bool]
    source_contracts List[SourceContract]
    // Verified non-emitting snapshots; normal builds leave this table empty.
    query_closures List[Option[Function]]
    // Trusted source shapes are fixed within this binding/type snapshot.
    result_shapes List[ResultShape]
    constraint_errors List[Int]
    contracts List[List[ContractCertificate]]
    // Check-only scalar call identities. Negative references never become
    // executable targets or add roots to the runtime reachability queue.
    fact_calls List[Instance]
}

record StaticReferenceQuery {
    owner Int
    parameter Span
    name Text
    references List[Span]
    types List[Text]
}

// Types are concrete checked parameter types across observed specializations,
// plus a concrete declaration type when available. No value is exposed.
pub record StaticParameterInfo {
    references List[Span]
    types List[Text]
}

fn static_query_type(env Environment, types List[Text], ty Int) {
    if !concrete(env, ty) {
        return
    }
    let label = type_name(env.source, env.types, env.interfaces, ty)
    var index = 0
    while index < length(types) {
        if get(types, index) == label {
            return
        }
        index = index + 1
    }
    push(types, label)
}

// Optional source evidence is recorded before specialization erases a static
// parameter. No executable expression or cached body carries query metadata.
fn static_reference(context Context, node Node, constant Int) {
    let queries = get(context.env.inputs, 0).static_queries
    let query = get(queries, 0)
    if constant >= length(context.signature.compile_time) ||
    (node.kind != NodeKind.Name && node.kind != NodeKind.Call && node.kind != NodeKind.Type) ||
    slice(node.value, 0, first_dot(node.value)) != query.name {
        return
    }
    if context.signature.symbol != query.owner {
        let signature = source_signature_id(context.env, context.signature.symbol)
        if signature < 0 {
            return
        }
        let instance = pack_instance(context.env, signature)
        if instance < 0 {
            return
        }
        let pack = get(context.env.packs, instance)
        if pack.source != query.owner || length(pack.widths) == 0 {
            return
        }
    }
    // Width expansion shifts constant indices, but keeps each fixed source
    // parameter's span. Use that checked origin, not one observed pack width.
    let parameters = group(symbol(context.env, context.signature.symbol).node, NodeKind.Parameters)
    let parameter = get(parameters, get(context.signature.compile_time, constant))
    if parameter.value != query.name || parameter.span.start != query.parameter.start ||
    parameter.span.end != query.parameter.end {
        return
    }
    static_query_type(context.env, query.types, static_type(context, constant))
    let span = Span {
        start = node.span.start
        end = node.span.start + std.text.length(query.name)
    }
    var index = 0
    while index < length(query.references) {
        let previous = get(query.references, index)
        if previous.start == span.start && previous.end == span.end {
            return
        }
        index = index + 1
    }
    push(query.references, span)
}

// Returns observed uses, not a claim that every source branch was instantiated.
// A rename must separately account for every occurrence. Failed checks publish
// nothing; queries use fresh tables and never replay cached executable bodies.
pub fn static_parameter_info(source std.loom.binding.Program, owner Int, parameter Int, inputs BuildInputs) Result[StaticParameterInfo, Failure] {
    discard expanded_source(source)?
    let detached = query_source(source)?
    if owner >= length(detached.symbols) {
        let requested = get(source.symbols, owner)
        return Result.Err(Failure {
                source = requested.file
                diagnostic = Diagnostic {
                    span = requested.node.span
                    message = "query requires an original source declaration"
                }
            })
    }
    let env = prepare_with_inputs(detached, inputs)?
    let item = symbol(env, owner)
    let parameters = group(item.node, NodeKind.Parameters)
    if item.node.kind != NodeKind.Function || item.node.value == "" || parameter < 0 ||
    parameter >= length(parameters) || !has(get(parameters, parameter), NodeKind.Comptime) ||
    child(get(parameters, parameter), 0).kind == NodeKind.Spread {
        return Result.Err(failure(env, owner, item.node, "query requires a fixed compile-time parameter"))
    }
    let references = new[Span]()
    let types = new[Text]()
    var index = 0
    while index < length(env.signatures) {
        let signature = get(env.signatures, index)
        if signature.symbol == owner {
            static_query_type(env, types, get(signature.params, parameter))
        }
        index = index + 1
    }
    push(get(env.inputs, 0).static_queries, StaticReferenceQuery {
            owner = owner
            parameter = get(parameters, parameter).span
            name = get(parameters, parameter).value
            references = references
            types = types
        })
    discard checked_program(env, new[Bool](), new[Bool](), ints(0))?
    Result.Ok(StaticParameterInfo {
            references = references
            types = types
        })
}
