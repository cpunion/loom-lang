import std.loom.project.Project
import std.loom.project.SourceFile
import std.loom.project.snapshot
import std.loom.binding.bind
import std.loom.ast.same
import std.loom.source.Span
import std.map.Map
import std.map.new
import std.map.insert
import std.map.get
import std.option.Option

// Only successful checks can populate this private state. Public mutable ASTs
// and typed programs are never themselves accepted as cached proof evidence.
pub record DefinitionCache {
    state DefinitionCacheState
}

record DefinitionCacheState {
    basis List[DefinitionBasis]
    hits List[Int]
    bodies List[BodyBasis]
    body_hits List[Int]
}

record DefinitionBasis {
    project Project
    source Project
    original List[Project]
    tests Bool
    entries List[DefinitionEntry]
    reusable List[Bool]
}

record DefinitionEntry {
    package Int
    owner Int
    test_only Bool
    trusted_std Bool
    node Node
    span Span
    text Text
}

record DefinitionReuse {
    checks List[Bool]
    bodies List[Bool]
}

pub record CachedCheck {
    source Project
    bindings std.loom.binding.Program
    program std.loom.typed.Program
}

pub fn definition_cache() DefinitionCache {
    DefinitionCache {
        state = DefinitionCacheState {
            basis = new[DefinitionBasis]()
            hits = ints(0)
            bodies = new[BodyBasis]()
            body_hits = ints(0)
        }
    }
}

pub fn definitions_reused(cache DefinitionCache) Int {
    get(cache.state.hits, 0)
}

pub fn bodies_reused(cache DefinitionCache) Int {
    get(cache.state.body_hits, 0)
}

// Ignore locations while comparing, not by allocating another normalized AST.
// Header comparisons omit method bodies but retain signatures and contracts.
fn definition_same(left Node, right Node, header Bool) Bool {
    if left.kind != right.kind || left.value != right.value {
        return false
    }
    let children_header = header && (left.kind == NodeKind.File ||
        left.kind == NodeKind.Concept || left.kind == NodeKind.Impl)
    var first = 0
    var second = 0
    while first < length(left.children) || second < length(right.children) {
        while first < length(left.children) && header && left.kind == NodeKind.Function &&
        get(left.children, first).kind == NodeKind.Block {
            first = first + 1
        }
        while second < length(right.children) && header && right.kind == NodeKind.Function &&
        get(right.children, second).kind == NodeKind.Block {
            second = second + 1
        }
        if first == length(left.children) || second == length(right.children) {
            return first == length(left.children) && second == length(right.children)
        }
        if !definition_same(get(left.children, first), get(right.children, second), children_header) {
            return false
        }
        first = first + 1
        second = second + 1
    }
    true
}

fn definition_basis(source std.loom.binding.Program) Result[DefinitionBasis, Failure] {
    let original = snapshot(Project {
            files = source.files
            modules = source.modules
            packages = source.packages
            root = source.root
        })
    // Bind the private snapshot once so entries can share its declaration trees.
    // Public returned bindings remain independently mutable.
    Result.Ok(definition_basis_from(bind(original, source.tests)?, original))
}

// The project is private cache storage. Live checks detach it above; the disk
// reader already owns fresh parsed trees, so restoring must not copy them again.
fn definition_basis_from(source std.loom.binding.Program, original Project) DefinitionBasis {
    let files = new[SourceFile]()
    var index = 0
    while index < length(original.files) {
        let file = get(original.files, index)
        let nodes = new[Node]()
        var declaration = 0
        while declaration < length(file.tree.children) {
            let node = child(file.tree, declaration)
            if node.kind != NodeKind.Function {
                push(nodes, node)
            }
            declaration = declaration + 1
        }
        // Function-only file membership is irrelevant to package-wide lookup.
        // Imports, nominal declarations and their trust/test origins still bind
        // the shared context; changes to those conservatively invalidate all.
        if length(nodes) != 0 {
            push(files, std.loom.project.SourceFile {
                    package = file.package
                    path = file.path
                    text = ""
                    tree = Node {
                        kind = NodeKind.File
                        value = file.tree.value
                        span = Span {
                            start = 0
                            end = 0
                        }
                        children = nodes
                    }
                    test_only = file.test_only
                    trusted_std = file.trusted_std
                })
        }
        index = index + 1
    }
    let entries = new[DefinitionEntry]()
    let reusable = new[Bool]()
    index = 0
    while index < length(source.symbols) {
        let item = get(source.symbols, index)
        let file = get(source.files, item.file)
        let node = item.node
        push(entries, DefinitionEntry {
                package = file.package
                owner = item.owner
                test_only = item.test_only
                trusted_std = file.trusted_std
                node = node
                span = item.node.span
                text = if item.node.span.start >= 0 && item.node.span.end <= std.text.length(file.text) &&
                    item.node.span.start < item.node.span.end {
                    std.text.slice(file.text, item.node.span.start, item.node.span.end)
                } else { "" }
            })
        push(reusable, false)
        index = index + 1
    }
    DefinitionBasis {
        source = original
        original = new[Project]()
        project = Project {
            files = files
            modules = original.modules
            packages = original.packages
            root = original.root
        }
        tests = source.tests
        entries = entries
        reusable = reusable
    }
}

fn definition_context(first DefinitionBasis, second DefinitionBasis) Bool {
    let left = first.project
    let right = second.project
    if first.tests != second.tests || left.root != right.root ||
    length(left.files) != length(right.files) ||
    length(left.modules) != length(right.modules) || length(left.packages) != length(right.packages) {
        return false
    }
    var index = 0
    while index < length(left.modules) {
        let a = get(left.modules, index)
        let b = get(right.modules, index)
        if a.name != b.name || a.source != b.source {
            return false
        }
        index = index + 1
    }
    index = 0
    while index < length(left.packages) {
        let a = get(left.packages, index)
        let b = get(right.packages, index)
        if a.instance != b.instance || a.relative != b.relative || length(a.imports) != length(b.imports) {
            return false
        }
        var edge = 0
        while edge < length(a.imports) {
            let x = get(a.imports, edge)
            let y = get(b.imports, edge)
            if x.spelling != y.spelling || x.target != y.target {
                return false
            }
            edge = edge + 1
        }
        index = index + 1
    }
    index = 0
    while index < length(left.files) {
        let a = get(left.files, index)
        let b = get(right.files, index)
        if a.package != b.package || a.path != b.path || a.test_only != b.test_only || a.trusted_std != b.trusted_std ||
        !definition_same(a.tree, b.tree, true) {
            return false
        }
        index = index + 1
    }
    true
}

// Syntax-producing macros and hidden capture operations need richer dependency
// summaries. Recheck them and their callers, rather than treating unknown edges
// as independence. Methods and expanded signatures are still rebuilt.
fn definition_opaque(node Node, root Bool) Bool {
    let kind = node.kind
    if kind == NodeKind.MacroCall || (kind == NodeKind.Function && !root) {
        return true
    }
    var index = 0
    while index < length(node.children) {
        if definition_opaque(get(node.children, index), false) {
            return true
        }
        index = index + 1
    }
    false
}

fn definition_depends(node Node, changed Map[Text, Bool], header Bool) Bool {
    let kind = node.kind
    if kind == NodeKind.Name || kind == NodeKind.Call || kind == NodeKind.MacroCall || kind == NodeKind.MethodCall ||
    kind == NodeKind.Construct || kind == NodeKind.Type || kind == NodeKind.Select {
        match std.map.get(changed, std.loom.project.name(node.value)) {
            Option.Some(_) => {
                return true
            }
            Option.None => {
            }
        }
    }
    var index = 0
    while index < length(node.children) {
        let child = get(node.children, index)
        if !(header && kind == NodeKind.Function && child.kind == NodeKind.Block) &&
        definition_depends(child, changed, header &&
            (kind == NodeKind.File || kind == NodeKind.Concept || kind == NodeKind.Impl)) {
            return true
        }
        index = index + 1
    }
    false
}

fn definition_bucket(entry DefinitionEntry) Text {
    concat(std.int.to_text(entry.package), concat("/", entry.node.value))
}

fn same_definition(left DefinitionBasis, first Int, right DefinitionBasis, second Int) Bool {
    let a = get(left.entries, first)
    let b = get(right.entries, second)
    if a.package != b.package || a.test_only != b.test_only || a.trusted_std != b.trusted_std ||
    (a.owner < 0) != (b.owner < 0) || !definition_same(a.node, b.node, false) {
        return false
    }
    a.owner < 0 || definition_same(get(left.entries, a.owner).node, get(right.entries, b.owner).node, true)
}

// Match exact definitions within package/name buckets, not mutable symbol IDs,
// declaration order or file positions. Unmatched old entries include removals;
// unmatched new entries include overloads that may change earlier resolution.
fn definition_matches(previous DefinitionBasis, basis DefinitionBasis, changed Map[Text, Bool]) List[Int] {
    let buckets = std.map.new[Text, List[Int]]()
    let used = new[Bool]()
    var index = 0
    while index < length(previous.entries) {
        let entry = get(previous.entries, index)
        push(used, false)
        if entry.node.kind == NodeKind.Function {
            let key = definition_bucket(entry)
            match std.map.get(buckets, key) {
                Option.Some(values) => {
                    push(values, index)
                }
                Option.None => {
                    discard std.map.insert(buckets, key, ints(index))
                }
            }
        }
        index = index + 1
    }
    let matches = new[Int]()
    index = 0
    while index < length(basis.entries) {
        let entry = get(basis.entries, index)
        var found = -1
        if entry.node.kind == NodeKind.Function {
            match std.map.get(buckets, definition_bucket(entry)) {
                Option.Some(values) => {
                    var candidate = 0
                    while found < 0 && candidate < length(values) {
                        let prior = get(values, candidate)
                        if !get(used, prior) && same_definition(previous, prior, basis, index) {
                            found = prior
                            set(used, prior, true)
                        }
                        candidate = candidate + 1
                    }
                }
                Option.None => {
                }
            }
            if found < 0 {
                discard std.map.insert(changed, entry.node.value, true)
            }
        }
        push(matches, found)
        index = index + 1
    }
    index = 0
    while index < length(previous.entries) {
        let entry = get(previous.entries, index)
        if entry.node.kind == NodeKind.Function && !get(used, index) {
            discard std.map.insert(changed, entry.node.value, true)
        }
        index = index + 1
    }
    matches
}

fn definition_reuse(source std.loom.binding.Program, basis DefinitionBasis, cache DefinitionCache) DefinitionReuse {
    let reuse = DefinitionReuse {
        checks = new[Bool]()
        bodies = new[Bool]()
    }
    var index = 0
    while index < length(basis.entries) {
        push(reuse.checks, false)
        push(reuse.bodies, false)
        index = index + 1
    }
    if length(cache.state.basis) == 0 {
        return reuse
    }
    let previous = get(cache.state.basis, 0)
    if !definition_context(previous, basis) {
        return reuse
    }
    let changed = std.map.new[Text, Bool]()
    let matches = definition_matches(previous, basis, changed)
    index = 0
    while index < length(basis.entries) {
        let node = get(basis.entries, index).node
        if node.kind == NodeKind.Refined && definition_opaque(node, true) {
            return reuse
        }
        index = index + 1
    }
    index = 0
    while index < length(basis.entries) {
        let item = get(source.symbols, index)
        let body = get(basis.entries, index).node
        let build = package_label(source.modules, source.packages, get(source.files, item.file).package) == "std.build"
        let matched = get(matches, index)
        let stable = matched >= 0 && !definition_opaque(body, true) && !build
        if item.node.kind == NodeKind.Function && !stable {
            discard std.map.insert(changed, item.name, true)
        }
        // A successful concrete instance is its own evidence. A declaration
        // with deferred/variadic validation need not have a reusable abstract
        // check; that validation still runs in the fresh environment.
        set(reuse.bodies, index, stable)
        set(reuse.checks, index, stable && item.owner < 0 && get(previous.reusable, matched))
        index = index + 1
    }
    var more = true
    while more {
        more = false
        index = 0
        while index < length(basis.entries) {
            let item = get(source.symbols, index)
            if item.node.kind == NodeKind.Function && definition_depends(get(basis.entries, index).node, changed, false) {
                set(reuse.checks, index, false)
                set(reuse.bodies, index, false)
                match std.map.get(changed, item.name) {
                    Option.Some(_) => {
                    }
                    Option.None => {
                        discard std.map.insert(changed, item.name, true)
                        more = true
                    }
                }
            }
            index = index + 1
        }
    }
    // Invariant and inherited-contract helpers can affect any definition.
    index = 0
    while index < length(basis.project.files) {
        let header = get(basis.project.files, index).tree
        if definition_depends(header, changed, true) {
            var item = 0
            while item < length(reuse.checks) {
                set(reuse.checks, item, false)
                set(reuse.bodies, item, false)
                item = item + 1
            }
            return reuse
        }
        index = index + 1
    }
    reuse
}

pub fn check_project_cached(project Project, tests Bool, inputs BuildInputs, cache DefinitionCache) Result[CachedCheck, Failure] {
    // Bind an owned snapshot ourselves; mutable public binding indexes are not
    // a reusable authority boundary. Failed checks never replace the last basis.
    let original = snapshot(project)
    let source = bind(expand_project(original, tests, inputs)?, tests)?
    let basis = definition_basis(source)?
    if has_declaration_stages(original, tests) {
        // CachedCheck.source is public mutable data. Keep an independent raw
        // source basis so generated snapshots cannot be minted from edited ASTs.
        push(basis.original, snapshot(original))
    }
    // Expansion always reruns with current tracked inputs before matching. The
    // resulting declarations, not a prior generator result, define reuse.
    let reuse = definition_reuse(source, basis, cache)
    let env = prepare_with_inputs(source, inputs)?
    let bodies = body_reuse(cache, basis, reuse.bodies)
    let program = checked_program_reusing(env, reuse.checks, basis.reusable, cache.state.hits, bodies)?
    save_bodies(cache, basis, env, program)
    if length(cache.state.basis) == 0 {
        push(cache.state.basis, basis)
    }
    else {
        set(cache.state.basis, 0, basis)
    }
    Result.Ok(CachedCheck {
            source = original
            bindings = source
            program = program
        })
}
