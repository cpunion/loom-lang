test fn variadic_contracts_use_parametric_erasure_and_ordinary_algebra() {
    discard accepted("""
        record Context[Ts...] {
            values (Ts...)
        }
        fn identity(value Int) Int
        ensures result == value {
            value
        }
        fn keep[Ts...](value Int, ignored Ts...) Int
        requires value >= 0
        ensures result == value && result >= 0 {
            identity(value)
        }
        fn structural[Ts...](ignored Context[Ts...], value Int) (Int, Bool)
        ensures result.0 == value && result.1 {
            (value, true)
        }
        fn callback[Ts...](ignored fn(Ts...) Int, value Int) Int
        ensures result == value {
            value
        }
        fn one(value Bool) Int {
            1
        }
        fn main() {
            assert keep(0) == 0 && keep(3, true, "text", [4]) == 3
            assert structural(Context { values = (1, true) }, 7).0 == 7
            assert callback(one, 9) == 9
            assert comptime { keep(11, false) } == 11
        }
        """)
}

test fn variadic_contracts_reject_false_uncalled_and_content_dependent_proofs() {
    let uncalled = """
        fn uncalled[Ts...](ignored Ts...) Int
        ensures result > 0 {
            0
        }
        """
    assert match checked(source_files(uncalled)) {
        Result.Err(failed) => failed.diagnostic.message == "required postcondition is not proved by the bounded scalar prover"
        Result.Ok(_) => false
    }
    rejects("""
        fn counted[Ts...](items Ts...) Int
        ensures result == 0 {
            var total = 0
            comptime for item in items {
                discard item
                total = total + 1
            }
            total
        }
        fn main() {
            assert counted() == 0
        }
        """)
    rejects("""
        fn wrong[Ts...](items (Ts...)) Int
        ensures result == items.0 {
            1
        }
        """)
    rejects("""
        fn wrong[Ts...](value Int, items Ts...) (Ts...)
        ensures value >= 0 {
            items
        }
        """)
    rejects("""
        fn keep[Ts...](value Int, ignored Ts...) Int
        ensures result == value {
            value
        }
        async fn item() Int {
            1
        }
        async fn main() {
            discard keep(1, item())
        }
        """)
}

test fn variadic_induction_proves_arbitrary_widths_with_shared_loop_rules() {
    list_length_contract("""
        import std.list.push
        import std.list.length
        fn count[Ts...](values Ts...) Int
        ensures result >= 0 {
            var total = 0
            comptime for item in values {
                discard item
                total = total + 1
            }
            total
        }
        fn indices[Ts...](values (Ts...)) Int
        ensures result >= 0 {
            var total = 0
            comptime for index, item in values {
                discard item
                total = total + index
            }
            total
        }
        fn types[Ts...](ignored (Ts...)) Int
        ensures result >= 0 {
            var total = 0
            comptime for T in Ts {
                total = total + 1
            }
            total
        }
        fn append[Ts...](log List[Int], values (Ts...)) Int
        ensures result >= 0 && length(log) >= old(length(log)) {
            var total = 0
            let alias = log
            comptime for index, item in values {
                discard item
                push(alias, index)
                total = total + 1
            }
            total
        }
        fn early[Ts...](values Ts...) Int
        ensures result >= 0 {
            comptime for index, item in values {
                discard item
                if index > 2 {
                    return index
                }
            }
            0
        }
        concept Counts {
            fn count[As..., Bs...](self Self, first (As...), second (Bs...)) (Int, Int)
            ensures result.0 >= 0 && result.1 >= 0

            fn default_count[Ts...](self Self, values Ts...) Int
            ensures result >= 0 {
                var total = 0
                comptime for item in values {
                    discard item
                    total = total + 1
                }
                total
            }
        }
        impl Counts for Bool {
            fn count[Us..., Vs...](self Bool, left (Us...), right (Vs...)) (Int, Int) {
                var outer = 0
                var inner = 0
                comptime for item in left {
                    discard item
                    outer = outer + 1
                    comptime for other in right {
                        discard other
                        inner = inner + 1
                    }
                }
                (outer, inner)
            }
        }
        fn main() {
            assert count() == 0 && count(true, "two") == 2
            let source dyn Counts = true
            assert source.count((true, 1), ("a",)).1 == 2
            assert source.default_count() == 0
        }
        """, true)
}

test fn variadic_induction_rejects_sampling_shadowing_and_changed_control() {
    rejects("""
        fn wrong[Ts...](values Ts...) Int
        ensures result > 0 {
            var total = 0
            comptime for item in values {
                discard item
                total = total + 1
            }
            total
        }
        fn main() {
            assert wrong(true) == 1
        }
        """)
    rejects("""
        fn wrong[Ts...](values Ts...) Int
        ensures result >= 0 {
            comptime for index, item in values {
                discard item
                if index >= 3 {
                    return -1
                }
            }
            0
        }
        fn main() {
            assert wrong() == 0 && wrong(true) == 0
        }
        """)
    rejects("""
        fn wrong[Ts...](values Ts...) Int
        ensures result == 0 {
            let values = (1,)
            var total = 0
            comptime for item in values {
                discard item
                total = total + 1
            }
            total
        }
        """)
    rejects("""
        fn wrong[Ts...](values Ts...) Int
        ensures result >= 0 {
            var total = 0
            while total == 0 {
                comptime for item in values {
                    discard item
                    total = -1
                    break
                }
                total = 0
                break
            }
            total
        }
        """)
    rejects("""
        record T {
            value Int
        }
        fn wrong[Ts...](values Ts...) Int
        ensures result >= 0 {
            comptime for T in Ts {
                discard T { value = 0 }
            }
            0
        }
        """)
}

fn pack_observation_contracts() Text {
    """
    concept Value {
        fn value(self Self) Int
        ensures result >= 0 {
            1
        }
        fn keep(self Self, input Int) Int
        requires input >= 0
        ensures result == old(input) {
            input
        }
        fn positive(self Self, input Int) Bool
        ensures result == (input > 0) {
            input > 0
        }
    }
    impl Value for Bool {}
    impl Value for Int {
        fn value(self Int) Int {
            if self < 0 { 0 } else { self }
        }
    }
    """
}

test fn variadic_element_observations_compose_declared_contracts_for_all_widths() {
    discard accepted(concat(pack_observation_contracts(), """
        fn total[Ts... Value](values Ts...) Int
        ensures result >= 0 {
            var sum = 0
            comptime for index, item in values {
                let amount = item.value()
                sum = sum + item.keep(amount) + index
            }
            sum
        }
        fn keep[Ts... Value](input Int, values (Ts...)) Int
        requires input >= 0
        ensures result == input {
            var current = input
            comptime for item in values {
                current = item.keep(current)
            }
            current
        }
        fn positive[Ts... Value](input Int, values Ts...) Bool
        ensures result {
            var valid = true
            comptime for item in values {
                valid = valid && (item.positive(input) == (input > 0))
            }
            valid
        }
        concept Totals {
            fn total[Ts... Value](self Self, values (Ts...)) Int
            ensures result >= 0
        }
        impl Totals for Bool {
            fn total[Us...](self Bool, items (Us...)) Int {
                var sum = 0
                comptime for item in items {
                    sum = sum + item.value()
                }
                sum
            }
        }
        fn main() {
            assert total() == 0 && total(true, 2) == 4
            assert keep(7, (true, 2)) == 7
            assert positive(0, true, 2)
            let receiver dyn Totals = true
            assert receiver.total((true, 2)) == 3
        }
        """))
}

test fn variadic_element_observations_do_not_guess_values_types_or_identity() {
    let definitions = pack_observation_contracts()
    rejects(concat(definitions, """
        fn wrong[Ts... Value](values Ts...) Int
        ensures result == 0 {
            var sum = 0
            comptime for item in values { sum = sum + item.value() }
            sum
        }
        fn main() {
            assert wrong() == 0
        }
        """))
    rejects(concat(definitions, """
        fn wrong[Ts... Value](values Ts...) Bool
        ensures result {
            var same = true
            comptime for item in values {
                same = same && (item.value() == item.value())
            }
            same
        }
        fn main() {
            assert wrong(true)
        }
        """))
    rejects(concat(definitions, """
        fn wrong[Ts... Value](values Ts...) Int
        ensures result >= 0 {
            comptime for index, item in values {
                discard item.value()
                if index >= 4 { return -1 }
            }
            0
        }
        fn main() {
            assert wrong(true, 2) == 0
        }
        """))
    rejects(concat(definitions, """
        fn helper[T Value](item T) Int {
            item.value()
        }
        fn unsupported[Ts... Value](values Ts...) Int
        ensures result >= 0 {
            var sum = 0
            comptime for item in values { sum = sum + helper(item) }
            sum
        }
        """))
    rejects("""
        concept C {
            fn value(self Self) Int
        }
        fn unsupported[Ts... C](values Ts...) Int
        ensures result >= 0 {
            var sum = 0
            comptime for item in values { sum = sum + item.value() }
            sum
        }
        """)
    rejects("""
        concept C {
            fn same(self Self, other Self) Bool
            ensures result
        }
        fn unsupported[Ts... C](values Ts...) Bool
        ensures result {
            comptime for item in values { assert item.same(item) }
            true
        }
        """)
    rejects("""
        concept C {
            fn value[T](self Self) Int
            ensures result >= 0
        }
        fn unsupported[Ts... C](values Ts...) Int
        ensures result >= 0 {
            var sum = 0
            comptime for item in values { sum = sum + item.value[Bool]() }
            sum
        }
        """)
    rejects("""
        concept C {
            fn value(self Self) Int
            ensures comptime if Self implements C { result >= 0 } else { result == 0 }
        }
        fn unsupported[Ts... C](values Ts...) Int
        ensures result >= 0 {
            var sum = 0
            comptime for item in values { sum = sum + item.value() }
            sum
        }
        """)
}

test fn variadic_element_observations_invalidate_opaque_shared_effects() {
    list_length_contract("""
        import std.list.length
        concept C {
            fn value(self Self) Int
            ensures result >= 0
        }
        fn wrong[Ts... C](shared List[Int], values Ts...) Int
        ensures result == old(length(shared)) {
            let before = length(shared)
            comptime for item in values { discard item.value() }
            length(shared)
        }
        """, false)
}

test fn variadic_method_contracts_check_defaults_and_inherited_implementations() {
    let definitions = """
        concept Keeping {
            fn keep[Ts...](self Self, value Int, ignored Ts...) Int
            ensures result == value

            fn default_keep[Ts...](self Self, value Int, ignored (Ts...)) Int
            ensures result == value {
                value
            }
        }
        impl Keeping for Bool {
            fn keep[Us...](self Bool, renamed Int, unused Us...) Int {
                renamed
            }
        }
        """
    discard accepted(concat(definitions, """
        fn main() {
            let value dyn Keeping = true
            assert value.keep(3) == 3
            assert value.keep(4, true, "text") == 4
            assert value.default_keep(5, (false, 1)) == 5
        }
        """))
    rejects(std.text.join(std.text.split(definitions, "renamed\n"), "0\n"))
    rejects(std.text.join(std.text.split(definitions, "renamed\n"), "discard unused\n        renamed\n"))
}

test fn variadic_contracts_revalidate_after_definition_cache_restore() {
    let source = """
        fn keep[Ts...](value Int, ignored Ts...) Int
        ensures result == value {
            value
        }
        pub fn answer() Int {
            keep(4, true) + keep(5)
        }
        """
    let initial = definition_cache()
    assert match cached_source(initial, source) {
        Result.Ok(_) => true
        Result.Err(failed) => {
            discard write_error(failed.diagnostic.message)
            false
        }
    }
    let cache = restored_definition_cache(initial)
    assert match cached_source(cache, concat("fn unrelated() {}\n", source)) {
        Result.Ok(_) => true
        Result.Err(_) => false
    }
    let invalid = std.text.join(std.text.split(source, "value\n"), "0\n")
    assert invalid != source
    assert match cached_source(cache, invalid) {
        Result.Err(_) => true
        Result.Ok(_) => false
    }
}

test fn erased_method_proofs_do_not_add_overloads_or_dynamic_slots() {
    let program = accepted("""
        concept Keeping {
            fn keep(self Self, value Int) Int {
                value
            }
            fn keep[Ts...](self Self, value Int, ignored Ts...) Int
            ensures result == value {
                value
            }
        }
        impl Keeping for Bool {}
        fn main() {
            let source dyn Keeping = true
            assert source.keep(7, false) == 7
        }
        """)
    let methods = get(get(program.witnesses, 0).methods, 0)
    assert methods == -1
    assert length(get(program.witnesses, 0).methods) == 2
    discard accepted("""
        concept Keeping {
            fn keep[Ts...](self Self, value Int, ignored Ts...) Int
            ensures result == value {
                value
            }
            fn keep[Ts...](self Self, value Int, ignored List[Ts]...) Int
            ensures result == value {
                value
            }
        }
        impl Keeping for Bool {}
        fn main() {
            let source dyn Keeping = true
            assert source.keep[Int](7, 8) == 7
            assert source.keep[Bool](9, [false]) == 9
        }
        """)
}
