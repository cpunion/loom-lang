test fn impl_method_headers_compare_self_and_closed_fragments_without_width_selection() {
    let source = """
        concept Consume {
            fn consume(self Self, value Int) Self
        }
        impl[Ts...] Consume for (Ts...) {
            fn consume(self (Ts...), value Int) (Ts...) {
                self
            }
        }
        """
    discard accepted(source)
    rejects(std.text.replace(source, "value Int) (Ts...)", "value Bool) (Ts...)"))
}

test fn impl_method_headers_alpha_rename_local_parameters_and_expand_self_associations() {
    let source = """
        concept Read {
            type Item[T]
            fn read[U](self Self, value Self.Item[U]) Self.Item[U]
        }
        impl[Ts...] Read for (Ts...) {
            type Item[T] = (T, (Ts...))
            fn read[V](self (Ts...), value (V, (Ts...))) (V, (Ts...)) {
                value
            }
        }
        """
    discard accepted(source)
}

test fn impl_method_headers_keep_independent_method_words_and_reject_unfilled_overloads() {
    discard accepted("""
        concept Keep {
            fn keep[Us...](self Self, values Us...) (Us...)
        }
        impl[Ts...] Keep for (Ts...) {
            fn keep[Vs...](self Self, values Vs...) (Vs...) {
                values
            }
        }
        """)
    rejects("""
        concept Consume {
            fn consume(self Self, value Int) Int
            fn consume(self Self, value Bool) Bool
        }
        impl[Ts...] Consume for (Ts...) {
            fn consume(self Self, value Int) Int {
                value
            }
        }
        """)
}

test fn impl_method_headers_inherit_domains_and_compare_resolved_projection_members() {
    discard accepted("""
        concept Source {
            type Item
        }
        concept Use {
            fn use[T Source](self Self, value T.Item) T.Item
        }
        impl[Ts...] Use for (Ts...) {
            fn use[U](self Self, value U.Source.Item) U.Source.Item {
                value
            }
        }
        """)
    discard accepted("""
        concept Source {}
        record Box[T Source] {
            value T
        }
        concept Use {
            fn use[T Source](self Self, value Box[T]) Box[T]
        }
        impl[Ts...] Use for (Ts...) {
            fn use[U](self Self, value Box[U]) Box[U] {
                value
            }
        }
        """)
}

test fn impl_method_headers_check_associated_domains_before_expanding_bindings() {
    let source = """
        concept Source {}
        concept Read {
            type Item[T Source]
            fn read[U Source](self Self, value Self.Item[U]) Int
        }
        impl[Ts...] Read for (Ts...) {
            type Item[T] = Int
            fn read[V](self Self, value Int) Int {
                value
            }
        }
        """
    discard accepted(source)
    rejects(std.text.replace(source, "fn read[U Source]", "fn read[U]"))
}

test fn impl_method_headers_try_overload_domains_without_leaking_requirements() {
    discard accepted("""
        concept First {
            type Item
        }
        concept Second {
            type Item
        }
        concept Use {
            fn use[T First](self Self, value T.Item) T.Item
            fn use[T Second](self Self, value T.Item) T.Item
        }
        impl[Ts...] Use for (Ts...) {
            fn use[U](self Self, value U.Second.Item) U.Second.Item {
                value
            }
            fn use[U](self Self, value U.First.Item) U.First.Item {
                value
            }
        }
        """)
}

test fn impl_method_headers_compare_scoped_family_binders_not_source_spellings() {
    let source = """
        concept Family {
            type Item[T]
        }
        concept Use {
            fn use[U](self Self, value dyn Family[Item[T] = (T, U)])
        }
        impl[Ts...] Use for (Ts...) {
            fn use[V](self Self, value dyn Family[Item[W] = (W, V)]) {}
        }
        """
    discard accepted(source)
    rejects(std.text.replace(source, "(W, V)", "(W, Bool)"))
    discard accepted("""
        concept Family {
            type Item[T]
        }
        concept Use {
            type Value[T]
            fn use[U](self Self, value Self.Value[U])
        }
        impl[Ts...] Use for (Ts...) {
            type Value[T] = dyn Family[Item[T] = T]
            fn use[V](self Self, value dyn Family[Item[W] = W]) {}
        }
        """)
}

test fn impl_method_headers_compare_family_captures_inside_symbolic_words() {
    let source = """
        concept Family {
            type Item[T]
        }
        concept Use {
            type Values
            fn use(self Self, values Self.Values)
        }
        impl[Ts...] Use for (Ts...) {
            type Values = (dyn Family[Item[U] = (U, Ts)]...)
            fn use(self Self, values (dyn Family[Item[V] = (V, Ts)]...)) {}
        }
        """
    discard accepted(source)
    rejects(std.text.replace(source, "(V, Ts)", "(V, Ts, Bool)"))
}

test fn impl_method_headers_restore_composite_arguments_without_losing_family_captures() {
    let source = """
        concept Family {
            type Item[T]
        }
        concept Source {
            type Item
        }
        record Holder[A, B, C, D, E] {
            a A
            b B
            c C
            d D
            e E
        }
        concept Use {
            type Value[T]
            fn use[U Source](self Self, value Self.Value[Holder[(U, Int), List[U], fn(U) U, Task[U], U.Item]])
        }
        impl[Ts...] Use for (Ts...) {
            type Value[T] = dyn Family[Item[Q] = (Q, T)]
            fn use[V](self Self, value dyn Family[Item[P] = (P, Holder[(V, Int), List[V], fn(V) V, Task[V], V.Source.Item])]) {
                discard value
            }
        }
        """
    discard accepted(source)
    rejects(std.text.replace(source, "(P, Holder[(V, Int)", "(P, Holder[(V, Bool)"))
}

test fn impl_method_headers_preserve_independent_groups_in_restored_family_arguments() {
    let source = """
        concept Family {
            type Item[T]
        }
        record Group[As..., Bs...] {
            left (As...)
            right (Bs...)
        }
        concept Use {
            type Value[T]
            fn use[U](self Self, value Self.Value[Group[(U, Int)..., (Bool, Text)...]])
        }
        impl[Ts...] Use for (Ts...) {
            type Value[T] = dyn Family[Item[Q] = (Q, T)]
            fn use[V](self Self, value dyn Family[Item[P] = (P, Group[(V, Int)..., (Bool, Text)...])]) {
                discard value
            }
        }
        """
    discard accepted(source)
    rejects(std.text.replace(source, "(V, Int)..., (Bool, Text)...", "(V, Int, Bool)..., (Text,)..."))
}

test fn impl_method_headers_check_erased_arguments_without_expanding_unused_words() {
    discard accepted("""
        concept Use {
            type Value[T]
            fn use(self Self, value Int)
        }
        impl[Ts...] Use for (Ts...) {
            type Value[T] = Int
            fn use(self Self, value Self.Value[(Ts...)]) {
                discard value
            }
        }
        """)
    rejects("""
        concept Tagged {}
        record Box[T Tagged] {
            value T
        }
        concept Use {
            type Value[T]
            fn use[U](self Self, value Int)
        }
        impl[Ts...] Use for (Ts...) {
            type Value[T] = Int
            fn use[V](self Self, value Self.Value[Box[V]]) {
                discard value
            }
        }
        """)
}
