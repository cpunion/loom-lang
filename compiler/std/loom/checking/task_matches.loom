fn task_bind(flow TaskFlow, local Int, borrowed Bool) {
    var index = get(flow.offsets, local)
    while index < get(flow.offsets, local + 1) {
        set(flow.locals, index, if borrowed { 3 } else { 1 })
        index = index + 1
    }
}

fn task_variant(env Environment, ty Int, variant Int) Bool {
    let fields = get(get(env.types, ty).variants, variant).fields
    var index = 0
    while index < length(fields) {
        if task_value(env, get(fields, index)) { return true }
        index = index + 1
    }
    false
}

fn task_match(flow TaskFlow, value Expr, allowed Bool, borrowing Bool, borrowed Bool) Result[Bool, Failure] {
    let input = get(value.children, 0)
    discard task_sequence(flow, value.children, task_value(flow.context.env, input.ty), borrowed)?
    if !input.falls {
        return Result.Ok(false)
    }
    let covered = new[Int]()
    let merged = task_branch(flow)
    var found = false
    var index = 0
    while index < length(value.arms) {
        let branch = task_branch(flow)
        let arm = get(value.arms, index)
        let body = arm.body
        discard task_match_bindings(branch, value, input.ty, arm, covered, borrowed)?
        discard task_sequence(branch, body, allowed, borrowing)?
        if all_fall(body) {
            discard task_match_consumed(branch, value, arm)?
            if found && !compatible_task_state(merged, branch) {
                return Result.Err(task_error(flow, value, "task consumption must agree on all continuing match arms"))
            }
            if found {
                merge_task_states(branch.locals, merged.locals)
            }
            task_join(merged, branch)
            found = true
        }
        index = index + 1
    }
    if found {
        task_join(flow, merged)
    }
    Result.Ok(task_value(flow.context.env, value.ty) && !borrowing)
}

fn task_match_bindings(flow TaskFlow, value Expr, ty Int, arm Arm, covered List[Int], borrowed Bool) Result[Bool, Failure] {
    if arm.variant >= 0 {
        push(covered, arm.variant)
        let fields = get(get(flow.context.env.types, ty).variants, arm.variant).fields
        var index = 0
        while index < length(fields) {
            let local = get(arm.bindings, index)
            if local >= 0 { task_bind(flow, local, borrowed) } else {
                if !borrowed && task_value(flow.context.env, get(fields, index)) {
                    return Result.Err(task_error(flow, value, "a Task-bearing match payload must be bound and consumed"))
                }
            }
            index = index + 1
        }
    } else {
        if arm.whole >= 0 { task_bind(flow, arm.whole, borrowed) } else {
            if !borrowed && task_value(flow.context.env, ty) {
                let shape = get(flow.context.env.types, ty)
                var drops = shape.kind != TypeKind.Enum
                var variant = 0
                while variant < length(shape.variants) {
                    drops = drops || (!resource_seen(covered, variant) && task_variant(flow.context.env, ty, variant))
                    variant = variant + 1
                }
                if drops { return Result.Err(task_error(flow, value, "a wildcard cannot discard Task-bearing variants")) }
            }
        }
    }
    Result.Ok(true)
}

fn task_binding_consumed(flow TaskFlow, value Expr, local Int) Result[Bool, Failure] {
    if local < 0 { return Result.Ok(true) }
    var index = get(flow.offsets, local)
    while index < get(flow.offsets, local + 1) {
        if get(flow.locals, index) == 1 {
            return Result.Err(task_error(flow, value, "a Task-bearing match payload must be awaited or transferred"))
        }
        if get(flow.locals, index) == 3 {
            set(flow.locals, index, 0)
        }
        index = index + 1
    }
    Result.Ok(true)
}

fn task_match_consumed(flow TaskFlow, value Expr, arm Arm) Result[Bool, Failure] {
    discard task_binding_consumed(flow, value, arm.whole)?
    var index = 0
    while index < length(arm.bindings) {
        discard task_binding_consumed(flow, value, get(arm.bindings, index))?
        index = index + 1
    }
    Result.Ok(true)
}
