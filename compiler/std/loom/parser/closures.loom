import std.loom.lexer.Kind
import std.loom.ast.Node
import std.loom.ast.NodeKind
import std.loom.source.Diagnostic
import std.list.new
import std.list.push
import std.result.Result

// Named parameter lists distinguish literals from structural function types.
// Empty lists need the following body to distinguish fn() from fn() { ... }.
fn function_expression(cursor Cursor) Result[Step, Diagnostic] {
    let asynchronous = word(cursor, "async")
    let start = if asynchronous { next(cursor) } else { cursor }
    if !word(start, "fn") { return Result.Err(error(start, "expected fn after async")) }
    match sequence(next(start), Kind.LParen, Kind.RParen, NodeKind.Parameters, Items.Parameters, false) {
        Result.Ok(parameters) => {
            let children = one(parameters.node)
            if asynchronous { push(children, done(cursor, start, NodeKind.Async, "", new[Node]()).node) }
            let parsed = function_contents(cursor, parameters.rest, children, "", false, false)
            match parsed {
                Result.Ok(value) => { return Result.Ok(value) }
                Result.Err(failed) => {
                    if asynchronous || std.list.length(parameters.node.children) != 0 {
                        return Result.Err(failed)
                    }
                }
            }
        }
        Result.Err(failed) => { if asynchronous { return Result.Err(failed) } }
    }
    type_ref(cursor)
}
