test fn function_types_preserve_omitted_results_and_higher_order_shape() {
    let tree = parsed("fn apply(action fn(Int) Int, value Int) Int { action(value) }\nfn choose() fn(Int) fn(Text) { callback }\nrecord Hooks { callback fn(Int) Int\nnotify fn(Text) }\n")
    let action = child(child(child(child(tree, 0), 1), 0), 0)
    assert action.kind == NodeKind.FunctionType
    assert child(child(action, 0), 0).value == "Int"
    assert child(child(action, 1), 0).value == "Int"
    let returned = child(child(child(tree, 1), 2), 0)
    assert returned.kind == NodeKind.FunctionType
    let nested = child(child(returned, 1), 0)
    assert nested.kind == NodeKind.FunctionType && length(child(nested, 1).children) == 0
    let hooks = child(tree, 2)
    assert length(child(child(child(hooks, 2), 0), 1).children) == 0
    discard rejected("fn explicit(action fn(Int) Unit) {}")
    discard rejected("fn named(action fn(value Int) Int) {}")
}

test fn arbitrary_callees_chain_without_changing_named_calls() {
    let tree = parsed("fn main() { let action = identity[Int]\nlet first = (action)(1)\nlet second = choose()(2)\nlet third = holder.action(3) }")
    let body = child(child(tree, 0), 2)
    let reference = child(child(body, 0), 0)
    assert reference.kind == NodeKind.Type && reference.value == "identity"
    assert child(reference, 0).value == "Int"
    let first = child(child(body, 1), 0)
    assert first.kind == NodeKind.Invoke && child(first, 0).value == "action"
    let second = child(child(body, 2), 0)
    assert second.kind == NodeKind.Invoke && child(second, 0).kind == NodeKind.Call
    assert child(child(body, 3), 0).kind == NodeKind.Call
}

test fn compile_time_parameters_preserve_types_spans_and_ordinary_calls() {
    let tree = parsed("fn repeat[T](value T, comptime count Int) T { repeat(value, count) }\nfn flags(comptime enabled Bool, comptime label Text) {}")
    let function = child(tree, 0)
    let parameters = child(function, 1)
    assert length(child(parameters, 0).children) == 1
    let count = child(parameters, 1)
    assert count.kind == NodeKind.Parameter && count.value == "count"
    assert child(count, 0).kind == NodeKind.Type && child(count, 0).value == "Int"
    let marker = child(count, 1)
    assert marker.kind == NodeKind.Comptime && length(marker.children) == 0
    assert marker.span.start == 22 && marker.span.end == 30
    assert count.span.start == 22 && count.span.end == 40
    let call = child(body(function), 0)
    assert call.kind == NodeKind.Call && length(child(call, 1).children) == 2
    assert child(child(call, 1), 1).kind == NodeKind.Name
    assert child(child(child(child(tree, 1), 1), 1), 0).value == "Text"
    discard rejected("fn f(action fn(comptime Int) Int) {}")
    discard rejected("fn f(count comptime Int) {}")
    discard rejected("fn f(comptime comptime count Int) {}")
    discard rejected("fn f(comptime count) {}")
}
