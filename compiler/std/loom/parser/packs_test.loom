test fn variadic_types_retain_pack_bounds_and_type_patterns() {
    let declaration = child(parsed("fn forward[R, Ts... Display](callback fn(Ts...) R, values Ts...) R { callback(values...) }"), 0)
    let pack = child(child(declaration, 0), 1)
    assert pack.kind == NodeKind.TypePack && pack.value == "Ts"
    assert child(pack, 0).value == "Display"
    let parameters = child(declaration, 1)
    assert child(child(parameters, 1), 0).kind == NodeKind.Spread
    discard parsed("async fn collect[Ts...](tasks Task[Ts]...) (Task[Ts]...) { tasks }")
    discard rejected("fn f[Ts....](values Ts...) {}")
}

test fn static_pack_iteration_retains_binding_target_and_body() {
    let declaration = child(parsed("fn visit[Ts...](values Ts...) { comptime for item in values { discard item } }"), 0)
    let loop = child(body(declaration), 0)
    assert loop.kind == NodeKind.ComptimeFor && loop.value == "item"
    assert child(loop, 0).kind == NodeKind.Name && child(loop, 0).value == "values"
    assert child(child(loop, 1), 0).kind == NodeKind.Discard
    discard rejected("fn visit[Ts...](values Ts...) { comptime for item values {} }")
    discard rejected("fn visit[Ts...](values Ts...) { comptime for item in values discard item }")
}
