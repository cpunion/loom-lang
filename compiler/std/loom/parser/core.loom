import std.loom.lexer.Kind
import std.loom.lexer.Token
import std.loom.lexer.lex
import std.loom.source.Span
import std.loom.source.Diagnostic
import std.loom.ast.Node
import std.loom.ast.NodeKind
import std.list.new
import std.list.get
import std.list.push
import std.result.Result
import std.text.concat

record Cursor { tokens List[Token] index Int }
record Step { rest Cursor node Node }
enum Items { Types Names Arguments Parameters Bindings }

fn token(cursor Cursor) Token { get(cursor.tokens, cursor.index) }
fn at(cursor Cursor, kind Kind) Bool { token(cursor).kind == kind }
fn word(cursor Cursor, value Text) Bool {
    at(cursor, Kind.Name) && token(cursor).value == value
}
fn next(cursor Cursor) Cursor {
    Cursor { tokens = cursor.tokens index = cursor.index + 1 }
}
fn newlines(cursor Cursor) Cursor {
    var rest = cursor
    while at(rest, Kind.Newline) { rest = next(rest) }
    rest
}
fn error(cursor Cursor, message Text) Diagnostic {
    Diagnostic { span = token(cursor).span message = message }
}
fn expect(cursor Cursor, kind Kind, label Text) Result[Cursor, Diagnostic] {
    if !at(cursor, kind) { return Result.Err(error(cursor, concat("expected ", label))) }
    Result.Ok(next(cursor))
}
fn done(start Cursor, rest Cursor, kind NodeKind, value Text, children List[Node]) Step {
    let begin = token(start).span.start
    let end = if rest.index > start.index { get(rest.tokens, rest.index - 1).span.end } else { begin }
    Step { rest = rest node = Node {
        kind = kind value = value children = children span = Span { start = begin end = end }
    } }
}
fn expression_end(value Step, end Int) Step {
    Step { rest = value.rest node = Node {
        kind = value.node.kind value = value.node.value children = value.node.children
        span = Span { start = value.node.span.start end = end }
    } }
}
fn one(value Node) List[Node] {
    let nodes = new[Node]()
    push(nodes, value)
    nodes
}
fn two(first Node, second Node) List[Node] {
    let nodes = one(first)
    push(nodes, second)
    nodes
}
fn reserved(value Text) Bool {
    value == "fn" || value == "pub" || value == "intrinsic" || value == "type" ||
    value == "where" || value == "record" || value == "enum" || value == "match" ||
    value == "test" || value == "import" || value == "let" || value == "var" ||
    value == "return" || value == "assert" || value == "discard" || value == "while" ||
    value == "break" || value == "continue" ||
    value == "if" || value == "else" || value == "requires" || value == "ensures" ||
    value == "true" || value == "false" || value == "comptime" || value == "defer" || value == "scoped" ||
    value == "concept" || value == "impl" || value == "for" || value == "implements" || value == "dyn"
}
fn name(cursor Cursor) Result[Step, Diagnostic] {
    if !at(cursor, Kind.Name) || reserved(token(cursor).value) {
        return Result.Err(error(cursor, "expected a name"))
    }
    Result.Ok(done(cursor, next(cursor), NodeKind.Name, token(cursor).value, new[Node]()))
}
fn path(cursor Cursor) Result[Step, Diagnostic] {
    let first = name(cursor)?
    var rest = first.rest
    var value = first.node.value
    while at(rest, Kind.Dot) && !at(next(rest), Kind.Number) {
        let part = name(next(rest))?
        value = concat(value, concat(".", part.node.value))
        rest = part.rest
    }
    Result.Ok(done(cursor, rest, NodeKind.Name, value, new[Node]()))
}
fn type_ref(cursor Cursor) Result[Step, Diagnostic] {
    if word(cursor, "fn") { return function_type(cursor) }
    if at(cursor, Kind.LParen) { return parenthesized(cursor, Items.Types, NodeKind.TupleType) }
    let dynamic = word(cursor, "dyn")
    let named = path(if dynamic { next(cursor) } else { cursor })?
    let args = if dynamic && at(named.rest, Kind.LBracket) {
        sequence(named.rest, Kind.LBracket, Kind.RBracket, NodeKind.TypeArguments, Items.Bindings, true)?
    } else { type_args(named.rest)? }
    Result.Ok(done(cursor, args.rest, if dynamic { NodeKind.DynType } else { NodeKind.Type }, named.node.value, args.node.children))
}
fn function_type(cursor Cursor) Result[Step, Diagnostic] {
    let params = sequence(next(cursor), Kind.LParen, Kind.RParen, NodeKind.Parameters, Items.Types, false)?
    var rest = params.rest
    let returns = new[Node]()
    if at(rest, Kind.LParen) || word(rest, "fn") || word(rest, "dyn") ||
        (at(rest, Kind.Name) && !reserved(token(rest).value)) {
        let returned = type_ref(rest)?
        if returned.node.value == "Unit" { return Result.Err(error(rest, "omit the Unit return annotation")) }
        push(returns, returned.node)
        rest = returned.rest
    }
    let output = done(params.rest, rest, NodeKind.ReturnType, "", returns)
    Result.Ok(done(cursor, rest, NodeKind.FunctionType, "", two(params.node, output.node)))
}
fn parameter(cursor Cursor) Result[Step, Diagnostic] {
    let compile_time = word(cursor, "comptime")
    let named = name(if compile_time { next(cursor) } else { cursor })?
    let ty = type_ref(named.rest)?
    let children = one(ty.node)
    if compile_time {
        push(children, done(cursor, next(cursor), NodeKind.Comptime, "", new[Node]()).node)
    }
    Result.Ok(done(cursor, ty.rest, NodeKind.Parameter, named.node.value, children))
}
fn type_parameter(cursor Cursor) Result[Step, Diagnostic] {
    let named = name(cursor)?
    var rest = named.rest
    let bounds = new[Node]()
    if at(rest, Kind.Name) && !reserved(token(rest).value) {
        var more = true
        while more {
            let bound = type_ref(rest)?
            push(bounds, bound.node)
            rest = bound.rest
            more = at(rest, Kind.Plus)
            if more { rest = newlines(next(rest)) }
        }
    }
    Result.Ok(done(cursor, rest, NodeKind.Name, named.node.value, bounds))
}
fn item(cursor Cursor, mode Items) Result[Step, Diagnostic] {
    match mode {
        Items.Types => type_ref(cursor)
        Items.Names => type_parameter(cursor)
        Items.Arguments => expr(cursor, 0, true, true)
        Items.Parameters => parameter(cursor)
        Items.Bindings => type_binding(cursor)
    }
}
fn type_binding(cursor Cursor) Result[Step, Diagnostic] {
    let named = name(cursor)?
    let ty = type_ref(expect(named.rest, Kind.Assign, "'=' after the associated type name")?)?
    Result.Ok(done(cursor, ty.rest, NodeKind.AssociatedType, named.node.value, one(ty.node)))
}
fn parenthesized(cursor Cursor, mode Items, tuple_kind NodeKind) Result[Step, Diagnostic] {
    let start = newlines(next(cursor))
    if at(start, Kind.RParen) { return Result.Err(error(start, "empty tuples are not supported")) }
    let first = item(start, mode)?
    var rest = newlines(first.rest)
    if !at(rest, Kind.Comma) {
        rest = expect(rest, Kind.RParen, "')'")?
        return Result.Ok(done(cursor, rest, first.node.kind, first.node.value, first.node.children))
    }
    let children = one(first.node)
    while at(rest, Kind.Comma) {
        rest = newlines(next(rest))
        if !at(rest, Kind.RParen) {
            let value = item(rest, mode)?
            push(children, value.node)
            rest = newlines(value.rest)
        }
    }
    rest = expect(rest, Kind.RParen, "')'")?
    Result.Ok(done(cursor, rest, tuple_kind, "", children))
}
fn sequence(cursor Cursor, open Kind, close Kind, kind NodeKind, mode Items, nonempty Bool) Result[Step, Diagnostic] {
    let opening = if open == Kind.LParen { "'('" } else { "'['" }
    let closing = if close == Kind.RParen { "')'" } else { "']'" }
    var rest = newlines(expect(cursor, open, opening)?)
    let children = new[Node]()
    if nonempty || !at(rest, close) {
        var more = true
        while more {
            let value = item(rest, mode)?
            push(children, value.node)
            rest = newlines(value.rest)
            more = at(rest, Kind.Comma)
            if more {
                rest = newlines(next(rest))
                more = !at(rest, close)
            }
        }
    }
    rest = expect(rest, close, closing)?
    Result.Ok(done(cursor, rest, kind, "", children))
}
fn type_args(cursor Cursor) Result[Step, Diagnostic] {
    if at(cursor, Kind.LBracket) {
        return sequence(cursor, Kind.LBracket, Kind.RBracket, NodeKind.TypeArguments, Items.Types, true)
    }
    Result.Ok(done(cursor, cursor, NodeKind.TypeArguments, "", new[Node]()))
}
// In expressions the same brackets denote type arguments or a container index.
// Parse their syntax once; the checker decides from the receiver's binding.
fn expression_args(cursor Cursor) Result[Step, Diagnostic] {
    if at(cursor, Kind.LBracket) {
        return sequence(cursor, Kind.LBracket, Kind.RBracket, NodeKind.TypeArguments, Items.Arguments, true)
    }
    Result.Ok(done(cursor, cursor, NodeKind.TypeArguments, "", new[Node]()))
}
fn bracket_arguments(node Node) Node {
    Node { kind = NodeKind.Arguments value = "" span = node.span children = node.children }
}
fn type_parameters(cursor Cursor) Result[Step, Diagnostic] {
    if at(cursor, Kind.LBracket) {
        return sequence(cursor, Kind.LBracket, Kind.RBracket, NodeKind.TypeParameters, Items.Names, true)
    }
    Result.Ok(done(cursor, cursor, NodeKind.TypeParameters, "", new[Node]()))
}

pub fn parse(text Text) Result[Node, Diagnostic] {
    let tokens = lex(text)?
    let start = Cursor { tokens = tokens index = 0 }
    var rest = newlines(start)
    let declarations = new[Node]()
    while !at(rest, Kind.Eof) {
        let declaration = if word(rest, "import") { import_decl(rest)? } else { declaration(rest)? }
        push(declarations, declaration.node)
        rest = newlines(declaration.rest)
    }
    Result.Ok(done(start, rest, NodeKind.File, "", declarations).node)
}
