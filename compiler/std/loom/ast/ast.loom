import std.loom.source.Span
import std.list.get
import std.list.length

// The source tree is compiler data, not a runtime representation for user values.
// Children preserve source order. Parameter/argument groups remain explicit;
// absent return annotations, contracts and else branches have no sentinel node.
pub enum NodeKind {
    File Import Record Enum Refined Function Public Test Intrinsic
    TypeParameters Parameters Parameter Type TypeArguments Arguments ReturnType
    Field Variant Requires Ensures Block Let Var Assign Return Assert Discard While
    Integer Text Bool Name Call Construct Unary Binary Select Try
    Match Arm Pattern Bindings Wildcard If Comptime
    TupleType Tuple Destructure Float
    Concept Impl Implements MethodCall DynType AssociatedType FunctionType Invoke
    Defer Bounds Break Continue List Apply Index IndexAssign Scoped Async Await
    RecordPattern RestPattern Spread TypePack
}

// TupleType/Tuple/List children are ordered elements. Destructure stores "let" or
// "var", with children [Bindings(tuple patterns...) or RecordPattern, initializer];
// binding patterns contain Names, Wildcards and recursive Tuples/RecordPatterns.
// Numeric Select values
// identify tuple positions; a parenthesized single item without a comma groups.
// Concept children include flags, associated types and functions with optional
// default bodies. Impl starts with concept and target Types, TypeParameters,
// then method bodies and associated bindings. TypeParameters retain Name
// children whose Type children are explicit bounds. Implements has [type,
// concept Type]; MethodCall has [receiver, TypeArguments, Arguments].
// DynType stores the concept path and source-ordered AssociatedType bindings.
// AssociatedType stores its name, optional TypeParameters and Bounds(type
// nodes), then an optional concept default or required impl type. Dyn bindings
// have one type child. Projections retain dotted Types with type arguments.
// FunctionType has [Parameters(type nodes), ReturnType(empty or one type)].
// A named Parameter has its type first, then an optional empty Comptime marker.
// Invoke has [callee, Arguments]; named calls retain Call. Expression brackets
// keep argument expressions until binding selects indexing or type application.
// Apply has [Name, Arguments]; Index has [receiver, Arguments]. Apply preserves
// the named receiver's span, including in explicit applications like identity[Int].
// IndexAssign has [Apply/Index target, value]; rebinding retains named Assign.
// Defer is a statement with one Block child; its span includes the keyword.
// Scoped has the same name/optional type/initializer shape as Let.
// Within match arms, Tuple contains patterns and Pattern contains Bindings of
// recursive patterns. Bare payload Names bind values; qualified paths or calls
// identify variants. The same source tree serves parsing, checking and tooling.
// RecordPattern stores the nominal path and source-ordered Field(name, pattern)
// children, with an optional final RestPattern for explicitly omitted fields.
// Spread has one value/type child. TypePack names a variadic type parameter;
// its children are the same explicit concept bounds as an ordinary parameter.

pub record Node {
    kind NodeKind
    value Text
    span Span
    children List[Node]
}

// Checks direct children, for example a declaration's Public or Test marker.
pub fn has(node Node, kind NodeKind) Bool {
    var index = 0
    while index < length(node.children) {
        if get(node.children, index).kind == kind { return true }
        index = index + 1
    }
    false
}

// Exact structural equality includes revision-relative spans, not durable IDs.
pub fn same(left Node, right Node) Bool {
    if left.kind != right.kind || left.value != right.value ||
        left.span.start != right.span.start || left.span.end != right.span.end ||
        length(left.children) != length(right.children) { return false }
    var index = 0
    while index < length(left.children) {
        if !same(get(left.children, index), get(right.children, index)) { return false }
        index = index + 1
    }
    true
}
