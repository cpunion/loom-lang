import std.loom.source.Span
import std.list.get
import std.list.length

// The source tree is compiler data, not a runtime representation for user values.
// Children preserve source order. Parameter/argument groups remain explicit;
// absent return annotations, contracts and else branches have no sentinel node.
pub enum NodeKind {
    File Import Record Enum Refined Function Public Test Intrinsic
    TypeParameters Parameters Parameter Type TypeArguments Arguments ReturnType
    Field Variant Requires Ensures Block Let Var Assign Return Assert Discard While
    Integer Text Bool Name Call Construct Unary Binary Select Try
    Match Arm Pattern Bindings Wildcard If Comptime
    TupleType Tuple Destructure
}

// TupleType/Tuple children are ordered elements. Destructure stores "let" or
// "var", with children [Bindings(Name...), initializer]. Numeric Select values
// identify tuple positions; a parenthesized single item without a comma groups.

pub record Node {
    kind NodeKind
    value Text
    span Span
    children List[Node]
}

// Checks direct children, for example a declaration's Public or Test marker.
pub fn has(node Node, kind NodeKind) Bool {
    var index = 0
    while index < length(node.children) {
        if get(node.children, index).kind == kind { return true }
        index = index + 1
    }
    false
}

// Exact structural equality includes revision-relative spans, not durable IDs.
pub fn same(left Node, right Node) Bool {
    if left.kind != right.kind || left.value != right.value ||
        left.span.start != right.span.start || left.span.end != right.span.end ||
        length(left.children) != length(right.children) { return false }
    var index = 0
    while index < length(left.children) {
        if !same(get(left.children, index), get(right.children, index)) { return false }
        index = index + 1
    }
    true
}
