import std.text.contains

fn credential_fixture(text Text) Result[Option[Text], Text] {
    let bytes = std.bytes.new()
    append_text(bytes, text)
    credential_response(credential_scope("https://example.com:443/team/repo.git"), bytes)
}

test fn credential_requests_and_basic_headers_use_exact_utf8_bytes() {
    let scope = credential_scope("https://example.com:443/team/repo.git")
    assert std.bytes.to_text(credential_request(scope)) == "protocol=https\nhost=example.com:443\npath=team/repo.git\n\n"
    assert basic_header("", "") == "Authorization: Basic Og=="
    assert basic_header("a", "") == "Authorization: Basic YTo="
    assert basic_header("a", "b") == "Authorization: Basic YTpi"
    assert basic_header("Aladdin", "open sesame") == "Authorization: Basic QWxhZGRpbjpvcGVuIHNlc2FtZQ=="
    assert basic_header("", "é") == "Authorization: Basic OsOp"
    assert match credential_fixture("protocol=https\nhost=example.com:443\npath=team/repo.git\nusername=a\npassword=b=c\n\n") {
        Result.Ok(value) => match value {
            Option.Some(header) => header == basic_header("a", "b=c")
            Option.None => false
        }
        Result.Err(_) => false
    }
    assert match credential_fixture("username=a\r\npassword=b\r\n\r\n") {
        Result.Ok(value) => match value {
            Option.Some(header) => header == basic_header("a", "b")
            Option.None => false
        }
        Result.Err(_) => false
    }
    assert match credential_fixture("") {
        Result.Ok(value) => match value {
            Option.None => true,
            Option.Some(_) => false
        }
        Result.Err(_) => false
    }
}

test fn credential_scope_and_format_failures_never_echo_values() {
    let invalid = new[Text]()
    push(invalid, "protocol=http\n")
    push(invalid, "host=elsewhere.example\n")
    push(invalid, "path=other/repo.git\n")
    push(invalid, "url=https://example.com:443/other\n")
    push(invalid, "username=a:b\npassword=secret-marker\n")
    push(invalid, "username=a\nusername=secret-marker\npassword=b\n")
    push(invalid, "username=a\npassword=secret-marker\0\n")
    push(invalid, "password=secret-marker\n")
    push(invalid, "quit=true\n")
    push(invalid, "authtype=secret-marker\ncredential=secret-marker\n")
    push(invalid, "secret-marker\n")
    var index = 0
    while index < length(invalid) {
        match credential_fixture(get(invalid, index)) {
            Result.Err(message) => {
                assert !std.text.contains(message, "secret-marker")
                assert !std.text.contains(message, "elsewhere.example")
            }
            Result.Ok(_) => {
                assert false
            }
        }
        index = index + 1
    }
    let invalid_utf8 = std.bytes.new()
    std.bytes.push(invalid_utf8, 255)
    assert match credential_response(credential_scope("https://example.com/repo"), invalid_utf8) {
        Result.Err(_) => true
        Result.Ok(_) => false
    }
}
