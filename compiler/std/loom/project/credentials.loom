import std.process.capture_input
import std.process.capture
import std.process.EnvChange
import std.process.ExitStatus
import std.process.Options

record CredentialScope {
    url Text
    host Text
    path Text
}

// fetch_snapshot validates the complete HTTPS URL before reaching this code.
fn credential_scope(url Text) CredentialScope {
    var boundary = 8
    while boundary < length(url) && byte(url, boundary) != 47 {
        boundary = boundary + 1
    }
    CredentialScope {
        url = url
        host = slice(url, 8, boundary)
        path = slice(url, boundary + 1, length(url))
    }
}

fn credential_request(scope CredentialScope) Bytes {
    let input = std.bytes.new()
    append_text(input, "protocol=https\nhost=")
    append_text(input, scope.host)
    append_text(input, "\npath=")
    append_text(input, scope.path)
    append_text(input, "\n\n")
    input
}

fn credential_value(value Text, username Bool) Bool {
    var index = 0
    while index < length(value) {
        let current = byte(value, index)
        if current < 32 || current == 127 || (username && current == 58) {
            return false
        }
        index = index + 1
    }
    true
}

// HTTP Basic encodes UTF-8 bytes; it is not encryption. Only a verified HTTPS
// fetch with redirects disabled may receive this header.
fn basic_header(username Text, password Text) Text {
    let alphabet = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
    let input = concat(username, concat(":", password))
    let output = std.bytes.new()
    append_text(output, "Authorization: Basic ")
    var index = 0
    while index < length(input) {
        let remaining = length(input) - index
        let a = byte(input, index)
        let b = if remaining > 1 {
            byte(input, index + 1)
        } else {
            0
        }
        let c = if remaining > 2 {
            byte(input, index + 2)
        } else {
            0
        }
        std.bytes.push(output, byte(alphabet, a / 4))
        std.bytes.push(output, byte(alphabet, (a % 4) * 16 + b / 16))
        std.bytes.push(output, if remaining > 1 {
                byte(alphabet, (b % 16) * 4 + c / 64)
            } else {
                61
            })
        std.bytes.push(output, if remaining > 2 {
                byte(alphabet, c % 64)
            } else {
                61
            })
        index = index + 3
    }
    std.bytes.to_text(output)
}

fn credential_response(scope CredentialScope, output Bytes) Result[Option[Text], Text] {
    if std.bytes.length(output) > 65535 {
        return Result.Err("credential tool response is too large")
    }
    let text = match std.bytes.decode_utf8(output) {
        Result.Ok(value) => value
        Result.Err(_) => {
            return Result.Err("credential tool response must be UTF-8")
        }
    }
    var username = ""
    var password = ""
    var has_username = false
    var has_password = false
    var quit = false
    let lines = parts(text, 10)
    var index = 0
    var ended = false
    while index < length(lines) && !ended {
        var line = get(lines, index)
        if ends_with(line, "\r") {
            line = slice(line, 0, length(line) - 1)
        }
        if line == "" {
            ended = true
        } else {
            var split = 0
            while split < length(line) && byte(line, split) != 61 {
                split = split + 1
            }
            if split == 0 || split == length(line) {
                return Result.Err("invalid credential tool response")
            }
            let key = slice(line, 0, split)
            let value = slice(line, split + 1, length(line))
            if !credential_value(value, key == "username") {
                return Result.Err("invalid credential tool value")
            }
            if (key == "protocol" && value != "https") || (key == "host" && value != scope.host) ||
            (key == "path" && value != scope.path) || (key == "url" && value != scope.url) {
                return Result.Err("credential tool changed the requested source scope")
            }
            if key == "username" {
                if has_username {
                    return Result.Err("duplicate credential tool field")
                }
                username = value
                has_username = true
            }
            if key == "password" {
                if has_password {
                    return Result.Err("duplicate credential tool field")
                }
                password = value
                has_password = true
            }
            if key == "authtype" || key == "credential" {
                return Result.Err("credential tool must return a username and password")
            }
            if key == "quit" && (value == "true" || value == "1") {
                quit = true
            }
        }
        index = index + 1
    }
    if has_username && has_password {
        return Result.Ok(Option.Some(basic_header(username, password)))
    }
    if quit || has_username || has_password {
        return Result.Err("credential tool did not supply a complete credential")
    }
    Result.Ok(Option.None)
}

fn source_credential(tool Text, url Text) Result[Option[Text], Text] {
    if tool == "" {
        return Result.Ok(Option.None)
    }
    let scope = credential_scope(url)
    let arguments = new[Text]()
    push(arguments, tool)
    push(arguments, "get")
    // This explicitly selected host tool inherits its ordinary host context,
    // unlike Git's isolated transport. It must be trusted and noninteractive.
    // No shell, store/erase operation, or manifest-selected executable is used.
    let output = match capture_input(arguments, credential_request(scope)) {
        Result.Ok(value) => value
        Result.Err(_) => {
            return Result.Err("cannot invoke Git credential tool")
        }
    }
    if !match output.status {
        ExitStatus.Exited(code) => code == 0
        ExitStatus.Terminated => false
    } {
        return Result.Err("Git credential tool failed; output was suppressed")
    }
    credential_response(scope, output.stdout)
}

fn authenticated_fetch(session GitSession, arguments List[Text], url Text, credential Option[Text]) Result[Bytes, Text] {
    match credential {
        Option.None => git_output(session, arguments)
        Option.Some(header) => {
            let changes = new[EnvChange]()
            var index = 0
            while index < length(session.options.environment) {
                push(changes, get(session.options.environment, index))
                index = index + 1
            }
            // Secret configuration exists only in this fetch child's environment,
            // never argv, a config file, lock, cache identity or diagnostic.
            child_setting(changes, "GIT_CONFIG_COUNT", "1")
            child_setting(changes, "GIT_CONFIG_KEY_0", concat("http.", concat(url, ".extraHeader")))
            child_setting(changes, "GIT_CONFIG_VALUE_0", header)
            let options = Options {
                directory = session.options.directory
                clear_environment = true
                environment = changes
            }
            match capture(git_arguments(session, arguments), options) {
                Result.Ok(output) => git_success(output)
                Result.Err(_) => Result.Err("cannot invoke authenticated Git fetch")
            }
        }
    }
}
