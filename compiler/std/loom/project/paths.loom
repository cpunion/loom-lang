import std.text.byte
import std.text.slice
import std.text.length
import std.text.concat
import std.text.starts_with
import std.text.ends_with
import std.list.new
import std.list.get
import std.list.push
import std.list.set
import std.list.length

fn last_dot(path Text) Int {
    var index = length(path)
    while index > 0 {
        index = index - 1
        if byte(path, index) == 46 { return index }
    }
    -1
}
pub fn name(path Text) Text {
    let index = last_dot(path)
    if index < 0 { path } else { slice(path, index + 1, length(path)) }
}
pub fn package(path Text) Text {
    let index = last_dot(path)
    if index < 0 { "" } else { slice(path, 0, index) }
}
pub fn qualify(package Text, name Text) Text {
    if package == "" { name } else { concat(package, concat(".", name)) }
}

// Filesystem spelling operations on absolute canonical paths. Keep Windows
// verbatim prefixes and native separators; backslash remains an ordinary Unix
// filename character rather than being globally rewritten.
pub fn is_windows_path(path Text) Bool {
    starts_with(path, "\\\\") || (length(path) >= 3 && byte(path, 1) == 58 &&
        (byte(path, 2) == 92 || byte(path, 2) == 47))
}
fn separator(path Text) Int {
    if starts_with(path, "\\\\") || (length(path) >= 3 && byte(path, 1) == 58 && byte(path, 2) == 92) { 92 } else { 47 }
}
pub fn join_path(base Text, part Text) Text {
    let slash = if separator(base) == 92 { "\\" } else { "/" }
    concat(base, concat(if ends_with(base, slash) { "" } else { slash }, part))
}
fn root_length(path Text) Int {
    if is_windows_path(path) && byte(path, 1) == 58 { return 3 }
    if separator(path) == 47 { return 1 }
    var offset = 2
    if starts_with(path, "\\\\?\\") {
        if starts_with(path, "\\\\?\\UNC\\") { offset = 8 } else {
            offset = 4
            while offset < length(path) && byte(path, offset) != 92 { offset = offset + 1 }
            return if offset < length(path) { offset + 1 } else { offset }
        }
    }
    // UNC roots include both the server and share, never just the server.
    var component = 0
    while component < 2 {
        while offset < length(path) && byte(path, offset) != 92 { offset = offset + 1 }
        if offset < length(path) { offset = offset + 1 }
        component = component + 1
    }
    offset
}
fn parent(path Text) Text {
    let root = root_length(path)
    var offset = length(path)
    while offset > root {
        offset = offset - 1
        if byte(path, offset) == separator(path) { return slice(path, 0, offset) }
    }
    slice(path, 0, root)
}
fn inside(path Text, root Text) Bool { path == root || starts_with(path, join_path(root, "")) }
fn parts(value Text, separator Int) List[Text] {
    let values = new[Text]()
    var start = 0
    var offset = 0
    while offset <= length(value) {
        if offset == length(value) || byte(value, offset) == separator {
            push(values, slice(value, start, offset))
            start = offset + 1
        }
        offset = offset + 1
    }
    values
}
fn contains(values List[Text], value Text, count Int) Bool {
    var index = 0
    while index < count {
        if get(values, index) == value { return true }
        index = index + 1
    }
    false
}
fn before(left Text, right Text) Bool {
    var index = 0
    while index < length(left) && index < length(right) {
        if byte(left, index) != byte(right, index) { return byte(left, index) < byte(right, index) }
        index = index + 1
    }
    length(left) < length(right)
}
fn include(values List[Text], value Text) {
    if contains(values, value, length(values)) { return }
    var position = length(values)
    push(values, value)
    while position > 0 && before(value, get(values, position - 1)) {
        set(values, position, get(values, position - 1))
        position = position - 1
    }
    set(values, position, value)
}
