import std.list.new
import std.list.get
import std.list.push
import std.list.length

fn copy_node(node Node) Node {
    let children = new[Node](length(node.children))
    var index = 0
    while index < length(node.children) {
        push(children, copy_node(get(node.children, index)))
        index = index + 1
    }
    Node {
        kind = node.kind
        value = node.value
        span = node.span
        children = children
    }
}

pub fn snapshot(project Project) Project {
    let modules = new[ModuleInstance](length(project.modules))
    var index = 0
    while index < length(project.modules) {
        push(modules, get(project.modules, index))
        index = index + 1
    }
    let packages = new[Package](length(project.packages))
    index = 0
    while index < length(project.packages) {
        let package = get(project.packages, index)
        let imports = new[PackageImport](length(package.imports))
        var edge = 0
        while edge < length(package.imports) {
            push(imports, get(package.imports, edge))
            edge = edge + 1
        }
        push(packages, Package {
                instance = package.instance
                relative = package.relative
                imports = imports
            })
        index = index + 1
    }
    let files = new[SourceFile](length(project.files))
    index = 0
    while index < length(project.files) {
        let file = get(project.files, index)
        push(files, SourceFile {
                package = file.package
                path = file.path
                text = file.text
                tree = copy_node(file.tree)
                test_only = file.test_only
                trusted_std = file.trusted_std
            })
        index = index + 1
    }
    Project {
        files = files
        modules = modules
        packages = packages
        root = project.root
    }
}
