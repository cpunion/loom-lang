test fn empty_ranges_and_copies_have_immutable_shape() {
    let source = [1, 2]
    assert length(capture(source, 1, 1)) == 0
    let first = capture(source)
    let alias = first
    std.list.push(source, 3)
    set(alias, 0, 4)
    assert get(first, 0) == 4 && source[0] == 4 && length(alias) == 2
}

import std.list.push

fn bounded_length[T](view View[T]) Int
ensures result >= 0
{
    length(view)
}

test fn arbitrary_view_arguments_carry_the_immutable_range_constraint() {
    let source = ["first", "second"]
    let view = capture(source, 1, 2)
    std.list.push(source, "third")
    set(view, 0, "updated")
    assert bounded_length(view) == 1 && source[1] == "updated"
    assert bounded_length(capture(source, 2, 2)) == 0
}
