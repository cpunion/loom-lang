import std.list.length
import std.list.get
import std.list.push
import std.text.concat

fn shared_edits() (List[Int], List[Int]) {
    let values = [1, 2, 3]
    let alias = values
    match take_last(values) {
        Option.Some(pair) => {
            let item, rest = pair
            assert item == 3 && length(alias) == 2
            discard append(rest, 7)
        }
        Option.None => {
            assert false
        }
    }
    (values, alias)
}

fn remove_all(values List[Int]) Int {
    var sum = 0
    while true {
        match take_last(values) {
            Option.Some(pair) => {
                sum = sum + pair.0
            }
            Option.None => {
                return sum
            }
        }
    }
}

test fn transfer_operations_preserve_shared_headers_and_reuse_removed_slots() {
    let values, alias = shared_edits()
    assert length(values) == 3 && get(alias, 2) == 7
    push(alias, 9)
    assert length(values) == 4
    let empty List[Text] = []
    assert match take_last(empty) {
        Option.None => true,
        _ => false
    }
    assert remove_all([1, 2, 3]) == 6
}

test fn compile_time_removal_reifies_only_live_elements_and_preserves_aliases() {
    let values, alias = comptime {
        shared_edits()
    }
    assert length(values) == 3 && get(values, 2) == 7
    push(alias, 9)
    assert length(values) == 4
    let again, other = comptime {
        shared_edits()
    }
    assert length(again) == 3 && length(other) == 3
    let shortened = comptime {
        let values = ["first", "removed"]
        discard take_last(values)
        values
    }
    assert length(shortened) == 1 && get(shortened, 0) == "first"
    assert comptime {
        remove_all([1, 2, 3])
    } == 6
}

fn replaced() (Text, List[Text], List[Text]) {
    let values = [concat("old", " value"), "untouched"]
    let alias = values
    let old, updated = replace(values, 0, concat("new", " value"))
    (old, updated, alias)
}

test fn replacement_preserves_the_displaced_value_and_shared_header() {
    let old, updated, alias = replaced()
    assert old == "old value" && updated[0] == "new value"
    assert length(updated) == 2 && alias[0] == "new value" && alias[1] == "untouched"
    let before, after, shared = comptime {
        replaced()
    }
    assert before == "old value" && after[0] == "new value"
    shared[1] = "changed"
    assert after[1] == "changed"
}
