import std.list.length
import std.list.get
import std.list.push
import std.list.set
import std.list.clone
import std.list.generate
import std.result.Result
import std.result.ConstraintError

// The private state prevents callers from shrinking the shared List header.
// Copies of NonEmpty still share that header and observe permitted edits.
pub record NonEmpty[T] {
    state State[T]
}

record State[T] {
    values Values[T]
}

type Values[T] = List[T] where std.list.length(self) > 0

type Count = Int where self > 0

pub fn new[T](first T) NonEmpty[T] {
    NonEmpty {
        state = State {
            values = Values([first])
        }
    }
}

// Explicitly copy the outer List: retaining the source header would let an
// existing alias remove the last element after this boundary check.
pub fn copy_from[T](source List[T]) Result[NonEmpty[T], ConstraintError] {
    match Values(std.list.clone(source)) {
        Result.Ok(values) => Result.Ok(NonEmpty {
                state = State {
                    values = values
                }
            })
        Result.Err(error) => Result.Err(error)
    }
}

pub fn length[T](values NonEmpty[T]) Int
ensures result > 0
{
    std.list.length(values.state.values)
}

pub fn first[T](values NonEmpty[T]) T {
    std.list.get(values.state.values, 0)
}

pub fn set_first[T](values NonEmpty[T], item T) {
    std.list.set(values.state.values, 0, item)
}

pub fn push[T](values NonEmpty[T], item T) {
    std.list.push(values.state.values, item)
}

// Capture the initial range before invoking user code. Later reads observe
// edits to unread elements; appends are not visited. No empty case is needed.
pub fn map[T, U](values NonEmpty[T], transform fn(T) U) NonEmpty[U] {
    let count = Count(length(values))
    NonEmpty {
        state = State {
            values = Values(std.list.generate(count, fn(index Int) U {
                        transform(std.list.get(values.state.values, index))
                    }))
        }
    }
}

// Unlike assignment, clone creates an independent outer header. Elements
// retain ordinary sharing, including recursive data and function captures.
pub fn clone[T](values NonEmpty[T]) NonEmpty[T] {
    map(values, fn(value T) T {
            value
        })
}

// Leaving the constrained API requires an explicit outer copy, not a writable
// alias of its protected header. The returned List may be resized freely.
pub fn to_list[T](values NonEmpty[T]) List[T] {
    std.list.clone(values.state.values)
}
