import std.reflect.describe
import std.reflect.Kind
import std.reflect.predicates.implies

fn refined_column_base[T, Base]() Bool {
    let target = describe[T]().types[0].kind
    let base = describe[Base]().types[0].kind
    target == Kind.Refined && base != Kind.Opaque && base != Kind.Refined &&
    implies[T, Base]()
}

// Explicit delegation to a base codec, not an automatic conformance or a
// representation/compatibility proof. Opaque and mismatched types reject.
pub fn encode_refined_column[T, Base ColumnValue](value T) Result[Value, CodecError] {
    comptime if refined_column_base[T, Base]() {
        let base Base = value
        base.to_column()
    } else {
        Result.Err(CodecError.Rejected)
    }
}

// A separate ordinary parameter keeps construction dependent only on Base's
// guarantees, not on incidental observations of a particular decoder call.
fn checked_refined_column[T, Base](value Base) Result[T, CodecError] {
    comptime if implies[Base, T]() {
        Result.Ok(T(value))
    } else {
        match T(value) {
            Result.Ok(checked) => Result.Ok(checked)
            Result.Err(_) => Result.Err(CodecError.Rejected)
        }
    }
}

pub fn decode_refined_column[T, Base ColumnValue](value Value) Result[T, CodecError] {
    comptime if refined_column_base[T, Base]() {
        checked_refined_column[T, Base](ColumnValue.from_column[Base](value)?)
    } else {
        Result.Err(CodecError.Rejected)
    }
}
