async fn result_after(value Int, delay Int, success Bool) Result[Int, Int] {
    if delay > 0 {
        sleep_ms(delay).await
    }
    if success {
        Result.Ok(value)
    } else {
        Result.Err(value)
    }
}

test async fn first_ok_skips_errors_and_preserves_input_order_if_all_fail() {
    assert match first_ok([result_after(1, 0, false), result_after(2, 1, true)]).await {
        Result.Ok(value) => value == 2
        Result.Err(_) => false
    }
    match first_ok([result_after(1, 3, false), result_after(2, 0, false)]).await {
        Result.Err(errors) => {
            assert length(errors) == 2 && errors[0] == 1 && errors[1] == 2
        }
        Result.Ok(_) => {
            assert false
        }
    }
    assert match first_ok[Int, Int]([]).await {
        Result.Err(errors) => length(errors) == 0
        Result.Ok(_) => false
    }
}

async fn pending_result(events List[Text], fail Bool) Result[Int, Int] {
    defer {
        std.list.push(events, "drained")
        if fail {
            fault_text("result cleanup failed")
        }
    }
    sleep_ms(10000).await
    Result.Ok(0)
}

test async fn first_ok_drains_losers_and_does_not_hide_cleanup_faults() {
    let events = new[Text]()
    let loser = pending_result(events, false)
    sleep_ms(1).await
    assert match first_ok([loser, result_after(7, 0, true)]).await {
        Result.Ok(value) => value == 7
        Result.Err(_) => false
    }
    assert length(events) == 1
    let broken = pending_result(events, true)
    sleep_ms(1).await
    match outcome(first_ok([broken, result_after(8, 0, true)])).await {
        Outcome.Faulted(error) => {
            assert contains(error.message, "result cleanup failed")
        }
        _ => {
            assert false
        }
    }
    assert length(events) == 2
}
