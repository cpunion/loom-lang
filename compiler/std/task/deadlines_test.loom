import std.task.deadline.at
import std.task.deadline.after_ns
import std.time.monotonic_ns

test async fn deadlines_preserve_completed_faulted_and_empty_outcomes() {
    match after_ns(successful(), 10000000000).await {
        Outcome.Completed(value) => {
            assert value == "typed result"
        }
        _ => {
            assert false
        }
    }
    match at(failed(), monotonic_ns() + 10000000000).await {
        Outcome.Faulted(error) => {
            assert contains(error.message, "assertion failed")
        }
        _ => {
            assert false
        }
    }
    match after_ns(sleep_ms(0), 10000000000).await {
        Outcome.Completed(_) => {
        }
        _ => {
            assert false
        }
    }
    let completed = nested()
    sleep_ms(1).await
    // Even an already-expired deadline cannot erase a completed Task payload.
    match at(completed, 0).await {
        Outcome.Completed(child) => {
            assert child.await == "typed result"
        }
        _ => {
            assert false
        }
    }
}

test async fn deadlines_drain_subtrees_and_report_cleanup_faults() {
    let events = ["begin"]
    let pending = pending_parent(events)
    sleep_ms(5).await
    match at(pending, monotonic_ns()).await {
        Outcome.Cancelled => {
        }
        _ => {
            assert false
        }
    }
    assert events[1] == "child started"
    assert events[2] == "child cleaned"
    assert events[3] == "parent cleaned"
    let broken = cleanup_failure(events)
    sleep_ms(5).await
    match after_ns(broken, 0).await {
        Outcome.Faulted(error) => {
            assert contains(error.message, "assertion failed")
            assert events[4] == "remaining cleanup"
        }
        _ => {
            assert false
        }
    }
}

test async fn cancelling_a_deadline_waiter_drains_its_child_and_timer() {
    let events = ["begin"]
    let pending = after_ns(pending_parent(events), 10000000000)
    sleep_ms(5).await
    match cancel(pending) {
        Outcome.Cancelled => {
        }
        _ => {
            assert false
        }
    }
    assert events[2] == "child cleaned"
    assert events[3] == "parent cleaned"
    assert successful().await == "typed result"
}

test async fn cancellation_signals_preserve_terminal_values_and_primary_faults() {
    let signal = successful()
    let completed = nested()
    sleep_ms(1).await
    // The signal completed first, but cancelling terminal work keeps its result.
    match cancel_when(completed, signal).await {
        Outcome.Completed(child) => {
            assert child.await == "typed result"
        }
        _ => {
            assert false
        }
    }
    let fail_primary = async fn() Int {
        fault_text("primary cancellation failure")
        0
    }
    let events = ["begin"]
    let primary = fail_primary()
    let broken_signal = cleanup_failure(events)
    sleep_ms(5).await
    match cancel_when(primary, broken_signal).await {
        Outcome.Faulted(error) => {
            assert contains(error.message, "primary cancellation failure")
            assert events[1] == "remaining cleanup"
        }
        _ => {
            assert false
        }
    }
    let pending = pending_parent(events)
    sleep_ms(5).await
    // A failed signal is terminal too; its diagnostic is not the work's result.
    match cancel_when(pending, failed()).await {
        Outcome.Cancelled => {
            assert events[3] == "child cleaned"
            assert events[4] == "parent cleaned"
        }
        _ => {
            assert false
        }
    }
}
