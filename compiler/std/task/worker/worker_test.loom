import std.list.get
import std.list.set
import std.list.push
import std.list.length
import std.list.new
import std.list.clone
import std.bytes.new
import std.bytes.length
import std.bytes.push
import std.time.sleep_ns
import std.sync.mutex.new
import std.sync.mutex.lock
import std.task.Outcome
import std.task.cancel
import std.task.outcome
import std.text.concat
import std.text.contains
import std.process.arguments

async fn started(flags List[Int]) {
    while get(flags, 0) == 0 {
        sleep_ns(0).await
    }
}

test async fn shared_accesses_do_not_make_compound_updates_atomic() {
    let value = [0]
    let flags = [0, 0]
    let worker = run(fn() {
            let before = get(value, 0)
            set(flags, 0, 1)
            while get(flags, 1) == 0 {
            }
            set(value, 0, before + 1)
        })
    started(flags).await
    let before = get(value, 0)
    set(flags, 1, 1)
    set(value, 0, before + 1)
    worker.await
    assert get(value, 0) == 1
}

enum Payload {
    Number(Int)
    Label(Text, List[Int])
}

record Item {
    value Payload
    name Text
}

test async fn moving_shared_graphs_keep_aggregate_publication_and_captures_typed() {
    let values = std.list.new[Item]()
    let bytes = std.bytes.new()
    let mutex = std.sync.mutex.new()
    var count = 0
    var latest = Item {
        value = Payload.Number(0)
        name = "shared payload"
    }
    let append = fn() Text {
        var index = 0
        while index < 24 {
            let text = concat("shared ", "payload")
            let value = if index % 2 == 0 {
                Payload.Number(index)
            } else {
                Payload.Label(text, [index])
            }
            push(values, Item {
                    value = value
                    name = text
                })
            latest = Item {
                value = value
                name = text
            }
            std.bytes.push(bytes, 65)
            {
                scoped guard = lock(mutex)
                count = count + 1
            }
            index = index + 1
        }
        concat("worker ", "done")
    }
    let first = run(append)
    let second = run(append)
    while count < 48 {
        let snapshot = latest
        assert snapshot.name == "shared payload"
        match snapshot.value {
            Payload.Number(value) => {
                assert value % 2 == 0
            }
            Payload.Label(text, numbers) => {
                assert text == snapshot.name && get(numbers, 0) % 2 == 1
            }
        }
        sleep_ns(0).await
    }
    let a, b = (first, second).await
    assert a == "worker done" && b == a
    assert length(values) == 48 && std.bytes.length(bytes) == 48 && count == 48
    var index = 0
    while index < length(values) {
        let item = get(values, index)
        assert item.name == "shared payload"
        match item.value {
            Payload.Number(value) => {
                assert value % 2 == 0
            }
            Payload.Label(text, numbers) => {
                assert text == item.name && get(numbers, 0) % 2 == 1
            }
        }
        index = index + 1
    }
}

test async fn worker_cancellation_and_faults_drain_before_releasing_shared_state() {
    let flags = [0, 0]
    let mutex = std.sync.mutex.new()
    let worker = run(fn() Int {
            scoped guard = lock(mutex)
            defer {
                set(flags, 1, 1)
            }
            set(flags, 0, 1)
            while true {
            }
            0
        })
    started(flags).await
    match cancel(worker) {
        Outcome.Cancelled => {
        }
        _ => {
            assert false
        }
    }
    assert get(flags, 1) == 1
    {
        scoped guard = lock(mutex)
    }
    let failure = outcome(run(fn() Int {
                scoped guard = lock(mutex)
                defer {
                    set(flags, 1, 2)
                }
                assert false
                0
            })).await
    match failure {
        Outcome.Faulted(error) => {
            assert contains(error.message, "assertion failed")
        }
        _ => {
            assert false
        }
    }
    assert get(flags, 1) == 2
    scoped guard = lock(mutex)
}

test async fn worker_results_keep_their_types_and_scalar_contracts() {
    let text, values = (run(fn() Text {
                concat("typed ", "result")
            }), run(fn() List[Int] {
                [1, 2, 3]
            })).await
    assert text == "typed result" && values[2] == 3
    assert run(fn() Int {
            identity(7)
        }).await == 7
    assert run(fn() Int {
            length(arguments())
        }).await > 0
}

test async fn cancellation_retains_cleanup_faults_and_cannot_wait_on_parent_mutex() {
    let flags = [0, 0]
    let mutex = std.sync.mutex.new()
    let worker = run(fn() {
            defer {
                assert false
            }
            set(flags, 0, 1)
            while get(flags, 1) == 0 {
            }
            scoped guard = lock(mutex)
            assert false
        })
    started(flags).await
    scoped guard = lock(mutex)
    set(flags, 1, 1)
    match cancel(worker) {
        Outcome.Faulted(error) => {
            assert contains(error.message, "assertion failed")
        }
        _ => {
            assert false
        }
    }
}

fn identity(value Int) Int
ensures result == value
{
    value
}

fn local_values() List[Int]
ensures length(result) == 3 && get(result, 1) == 7
{
    let values = local_seed()
    let alias = values
    push(alias, 3)
    set(values, 1, 7)
    values
}

fn local_seed() List[Int]
ensures length(result) == 2 && get(result, 1) == 2
{
    [1, 2]
}

fn scalar_step(value Int) Int
ensures result == value
{
    value
}

fn local_count() Int
ensures result == 3
{
    let values = [1, 2]
    push(values, scalar_step(3))
    length(values)
}

fn shared_count(values List[Int]) Int
requires length(values) >= 0
ensures result >= 0 && length(values) >= 0 && old(length(values)) >= 0
{
    length(values)
}

record CountSnapshot {
    value Int
}

fn same_count(value Int) Bool {
    let first = value
    var second = first
    second = value
    first == second
}

fn same_record(value CountSnapshot) Bool {
    same_count(value.value)
}

fn count_snapshot(values List[Int]) Bool {
    let count = length(values)
    if count == 0 {
        count == 0
    } else {
        count > 0
    }
}

fn shared_snapshots(values List[Int]) Int
requires same_count(length(values))
ensures same_count(length(values)) && same_count(old(length(values))) &&
same_record(CountSnapshot {
        value = length(values)
    }) && count_snapshot(values)
{
    length(values)
}

fn shared_handle(values List[Int]) List[Int]
ensures length(result) >= 0
{
    values
}

test async fn shared_contracts_use_independent_current_and_entry_observations() {
    let values = [1, 2]
    let count, alias = (run(fn() Int {
                shared_count(values)
            }), run(fn() List[Int] {
                shared_handle(values)
            })).await
    assert count == 2 && length(alias) == 2
    push(alias, 3)
    assert length(values) == 3
    assert run(fn() Int {
            shared_snapshots(values)
        }).await == 3
}

test async fn private_storage_retains_required_proofs_inside_workers() {
    let values, count = (run(local_values), run(local_count)).await
    assert length(values) == count && get(values, 1) == 7
    assert run(fn() Int {
            local_loop(12)
        }).await == 12
    assert run(rebound_count).await == 3
}

fn rebound_values(choice Bool) List[Int]
ensures length(result) >= 0
{
    var values = [1]
    if choice {
        values = [2, 3]
    }
    values
}

fn rebound_count() Int
ensures result >= 1
{
    let values = rebound_values(true)
    push(values, 4)
    length(values)
}

fn local_loop(limit Int) Int
requires limit >= 0 && limit <= 32
ensures result == limit
{
    let values = std.list.new[Int]()
    var index = 0
    while index < limit {
        push(values, index)
        index = index + 1
    }
    length(values)
}

record CopiedValues {
    values List[Int]
}

fn copied_values(values List[Int]) CopiedValues {
    CopiedValues {
        values = clone(values)
    }
}

fn extended_copy(values List[Int]) Int
ensures result >= 1
{
    let copied = copied_values(values).values
    push(copied, 7)
    length(copied)
}

fn independent_copy(values List[Int]) Int
ensures result == 0
{
    let copied = clone(values)
    let before = length(copied)
    push(values, 9)
    length(copied) - before
}

test async fn explicit_scalar_copies_keep_private_proofs() {
    let values = [1, 2]
    assert run(fn() Int {
            extended_copy(values)
        }).await == 3
    assert length(values) == 2
    assert run(fn() Int {
            independent_copy(values)
        }).await == 0
    assert length(values) == 3
}

record CopiedRows {
    values List[List[Int]]
}

fn copied_rows(values List[List[Int]]) CopiedRows {
    CopiedRows {
        values = clone(values)
    }
}

fn extended_rows(values List[List[Int]]) Int
ensures result >= 1
{
    let copied = copied_rows(values).values
    push(copied, [7])
    length(copied)
}

fn retained_outer(values List[Int]) Int
ensures result == 1
{
    let nested = [values]
    push(values, 9)
    length(nested)
}

fn retained_inner() Int
ensures result == 2
{
    let values = [1]
    let nested = std.list.new[List[Int]]()
    push(nested, values)
    set(nested, 0, values)
    push(get(nested, 0), 2)
    length(values)
}

fn rebound_rows(choice Bool) List[List[Int]]
ensures length(result) >= 0
{
    var values = [[1]]
    if choice {
        values = [[2, 3]]
    }
    values
}

fn extended_rebound_rows() Int
ensures result >= 1
{
    let values = rebound_rows(true)
    push(values, [4])
    length(values)
}

test async fn private_outer_storage_does_not_isolate_shared_elements() {
    let values = [1, 2]
    let nested = [values]
    assert run(fn() Int {
            extended_rows(nested)
        }).await == 2
    assert length(nested) == 1
    assert run(fn() Int {
            retained_outer(values)
        }).await == 1
    assert run(retained_inner).await == 2
    assert run(extended_rebound_rows).await == 2
    let copied = run(fn() List[List[Int]] {
            clone(nested)
        }).await
    push(get(copied, 0), 11)
    assert length(values) == 4 && length(nested) == 1
    push(copied, [12])
    assert length(nested) == 1 && length(copied) == 2
}
