// Policies stay in Loom. Runtime only supplies terminal notifications, typed
// extraction, and subtree drain. A helper Task is per group, not per element.
async fn collect[T](tasks List[Task[T]], fail_fast Bool) List[Option[Outcome[T]]] {
    let batch = watch(tasks)
    var pending = batch.slots
    var remaining = batch.count
    var slots = new[Option[Outcome[T]]]()
    var index = 0
    while index < remaining {
        slots = append(slots, Option.None)
        index = index + 1
    }
    while remaining > 0 {
        let index = task_next().await
        let task, rest = take_slot(pending, index)
        pending = rest
        let value = task_outcome(task).await
        let kept = if fail_fast {
            Outcome.Completed(completed(value))
        } else {
            value
        }
        slots = put_slot(slots, index, kept)
        remaining = remaining - 1
    }
    drain(pending, false)
    slots
}

pub async fn settled[T](tasks List[Task[T]]) List[Outcome[T]] {
    filled(collect(tasks, false).await)
}

pub async fn all[T](tasks List[Task[T]]) List[T] {
    var pending = collect(tasks, true).await
    var values = new[T]()
    while true {
        match take_last(pending) {
            Option.Some(pair) => {
                let value, rest = pair
                pending = rest
                match value {
                    Option.Some(value) => {
                        values = append(values, completed(value))
                    }
                    Option.None => {
                        fault_text("task result slot is empty")
                    }
                }
            }
            Option.None => {
                return values
            }
        }
    }
}

// A tuple retains the element types rather than erasing them into a List.
// Observe both children before suspending so a later-position failure can
// cancel a slow first child instead of waiting for input order.
pub async fn all[A, B](tasks (Task[A], Task[B])) (A, B) {
    let left, right = tasks
    let first_task = task_observe(left, 0)
    let second_task = task_observe(right, 1)
    if task_next().await == 0 {
        match task_outcome(first_task).await {
            Outcome.Completed(value) => {
                assert task_next().await == 1
                return (value, completed(task_outcome(second_task).await))
            }
            Outcome.Faulted(error) => {
                task_drain(second_task, true)
                fault_text(error.message)
            }
            Outcome.Cancelled => {
                task_drain(second_task, false)
                fault_text("task was cancelled")
            }
        }
    }
    match task_outcome(second_task).await {
        Outcome.Completed(value) => {
            assert task_next().await == 0
            (completed(task_outcome(first_task).await), value)
        }
        Outcome.Faulted(error) => {
            task_drain(first_task, true)
            fault_text(error.message)
        }
        Outcome.Cancelled => {
            task_drain(first_task, false)
            fault_text("task was cancelled")
        }
    }
}

pub async fn settled[A, B](tasks (Task[A], Task[B])) (Outcome[A], Outcome[B]) {
    let left, right = tasks
    let first_task = task_observe(left, 0)
    let second_task = task_observe(right, 1)
    if task_next().await == 0 {
        let first = task_outcome(first_task).await
        assert task_next().await == 1
        return (first, task_outcome(second_task).await)
    }
    let second = task_outcome(second_task).await
    assert task_next().await == 0
    (task_outcome(first_task).await, second)
}

async fn first[T](tasks List[Task[T]], success_only Bool) Outcome[T] {
    let batch = watch(tasks)
    var pending = batch.slots
    var remaining = batch.count
    if remaining == 0 {
        fault_text("any/race requires at least one task")
    }
    var failure = "no task completed successfully"
    var failed = false
    while remaining > 0 {
        let index = task_next().await
        let task, rest = take_slot(pending, index)
        pending = rest
        match task_outcome(task).await {
            Outcome.Completed(value) => {
                drain(pending, false)
                return Outcome.Completed(value)
            }
            Outcome.Faulted(error) => {
                if !success_only {
                    drain(pending, true)
                    return Outcome.Faulted(error)
                }
                if !failed {
                    failure = error.message
                    failed = true
                }
            }
            Outcome.Cancelled => {
                if !success_only {
                    drain(pending, false)
                    return Outcome.Cancelled
                }
            }
        }
        remaining = remaining - 1
    }
    drain(pending, false)
    fault_text(failure)
}

pub async fn any[T](tasks List[Task[T]]) T {
    completed(first(tasks, true).await)
}

pub async fn race[T](tasks List[Task[T]]) Outcome[T] {
    first(tasks, false).await
}

// Fixed-size homogeneous pairs use the same source policies as dynamic Lists.
// Separate arguments keep an empty List literal unambiguous for callers.
pub async fn any[T](first Task[T], second Task[T]) T {
    any([first, second]).await
}

pub async fn race[T](first Task[T], second Task[T]) Outcome[T] {
    race([first, second]).await
}
