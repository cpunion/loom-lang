// Policies stay in Loom. Runtime only supplies terminal notifications, typed
// extraction, and subtree drain. A helper Task is per group, not per element.
import std.resource.generate
import std.list.length

async fn collect[T](tasks List[Task[T]], fail_fast Bool) Batch[T]
ensures result.count == old(length(tasks)) && length(result.slots) == result.count {
    let batch = watch(tasks)
    var remaining = batch.count
    while remaining > 0 {
        match task_next_terminal().await {
            TaskTerminal.Faulted(error) => {
                if fail_fast {
                    drain(batch.slots, true)
                    fault_text(error.message)
                }
            }
            TaskTerminal.Cancelled => {
                if fail_fast {
                    drain(batch.slots, false)
                    fault_text("task was cancelled")
                }
            }
            TaskTerminal.Completed => {
            }
        }
        remaining = remaining - 1
    }
    batch
}

pub async fn settled[T](tasks List[Task[T]]) List[Outcome[T]]
ensures length(result) == old(length(tasks)) {
    let batch = collect(tasks, false).await
    let count = batch.count
    generate(count, batch.slots,
        fn(index Int, pending List[Option[Task[T]]]) (Outcome[T], List[Option[Task[T]]]) {
            let task, rest = take_slot(pending, count - 1 - index)
            (task_ready_outcome(task), rest)
        }, fn(pending List[Option[Task[T]]]) {
            drain(pending, false)
        })
}

pub async fn all[T](tasks List[Task[T]]) List[T]
ensures length(result) == old(length(tasks)) {
    let batch = collect(tasks, true).await
    let count = batch.count
    generate(count, batch.slots,
        fn(index Int, pending List[Option[Task[T]]]) (T, List[Option[Task[T]]]) {
            let task, rest = take_slot(pending, count - 1 - index)
            (task_ready_result(task), rest)
        }, fn(pending List[Option[Task[T]]]) {
            drain(pending, false)
        })
}

// Selection never erases a typed result. Once every child has completed, a
// single helper transfers their handles and extracts values in input order.
async fn tuple_values[Ts...](tasks (Task[Ts]...)) (Ts...) {
    comptime map task in tasks {
        task.await
    }
}

fn drain_tuple[Ts...](suppress Bool, tasks (Task[Ts]...)) {
    comptime for task in tasks {
        task_drain(task, suppress)
    }
}

pub async fn all[Ts...](tasks (Task[Ts]...)) (Ts...) {
    var count = 0
    let observed = comptime map task in tasks {
        let index = count
        count = count + 1
        task_observe(task, index)
    }
    var remaining = count
    while remaining > 0 {
        match task_next_terminal().await {
            TaskTerminal.Completed => {
                remaining = remaining - 1
            }
            TaskTerminal.Faulted(error) => {
                drain_tuple(true, observed)
                fault_text(error.message)
            }
            TaskTerminal.Cancelled => {
                drain_tuple(false, observed)
                fault_text("task was cancelled")
            }
        }
    }
    tuple_values(observed).await
}

// The input Tasks are already hot. Awaiting their outcomes in input order
// retains concurrent execution and never cancels a sibling on a fault.
pub async fn settled[Ts...](tasks (Task[Ts]...)) (Outcome[Ts]...) {
    comptime map task in tasks {
        task_outcome(task).await
    }
}

async fn first[T](tasks List[Task[T]], success_only Bool) Task[T] {
    let batch = watch(tasks)
    var pending = batch.slots
    var remaining = batch.count
    if remaining == 0 {
        fault_text("any/race requires at least one task")
    }
    var failure = "no task completed successfully"
    var failed = false
    while remaining > 0 {
        let index, terminal = task_next_event().await
        let task, rest = take_slot(pending, index)
        pending = rest
        match terminal {
            TaskTerminal.Completed => {
                drain(pending, false)
                return task
            }
            TaskTerminal.Faulted(error) => {
                if !success_only {
                    drain(pending, true)
                    return task
                }
                task_drain(task, true)
                if !failed {
                    failure = error.message
                    failed = true
                }
            }
            TaskTerminal.Cancelled => {
                if !success_only {
                    drain(pending, false)
                    return task
                }
                task_drain(task, false)
            }
        }
        remaining = remaining - 1
    }
    drain(pending, false)
    fault_text(failure)
}

pub async fn any[T](tasks List[Task[T]]) T {
    first(tasks, true).await.await
}

pub async fn race[T](tasks List[Task[T]]) Outcome[T] {
    task_outcome(first(tasks, false).await).await
}

// Fixed-size homogeneous pairs use the same source policies as dynamic Lists.
// Separate arguments keep an empty List literal unambiguous for callers.
pub async fn any[T](first Task[T], second Task[T]) T {
    any([first, second]).await
}

pub async fn race[T](first Task[T], second Task[T]) Outcome[T] {
    race([first, second]).await
}
