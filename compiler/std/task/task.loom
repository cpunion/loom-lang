import std.resource.Dispose

pub record TaskFault {
    message Text
}

pub enum Outcome[T] {
    Completed(T)
    Faulted(TaskFault)
    Cancelled
}

// The compiler drains the active MustScope payload after this container hook.
impl[T] Dispose for Outcome[T] {
    fn dispose(self Outcome[T]) {
    }
}

async intrinsic fn task_outcome[T](task Task[T]) Outcome[T]

intrinsic fn task_cancel[T](task Task[T]) Outcome[T]

// Only called after terminal notification; these do not create another Task.
intrinsic fn task_ready_result[T](task Task[T]) T

intrinsic fn task_ready_outcome[T](task Task[T]) Outcome[T]

// Result.Err is a completed value. Only child execution/cleanup faults become
// fault data; OOM and unexpected runtime failures still terminate the process.
pub async fn outcome[T](task Task[T]) Outcome[T] {
    task_outcome(task).await
}

// Consume the handle and drain before returning. Already-terminal children keep
// their real outcome; a cancellation cleanup fault is Faulted, not Cancelled.
pub fn cancel[T](task Task[T]) Outcome[T] {
    task_cancel(task)
}
