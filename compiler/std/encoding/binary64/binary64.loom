import std.bytes.new
import std.bytes.get
import std.bytes.push
import std.bytes.length
import std.float.from_int
import std.float.to_int
import std.float.is_nan
import std.result.Result

pub enum DecodeError {
    WrongWidth
}

fn scale(value Float, power Int) Float {
    var output = value
    var remaining = if power < 0 {
        -power
    } else {
        power
    }
    var factor = if power < 0 {
        0.5
    } else {
        2.0
    }
    while remaining > 0 {
        if (remaining & 1) != 0 {
            output = output * factor
        }
        remaining = remaining >> 1
        if remaining > 0 {
            factor = factor * factor
        }
    }
    output
}

// Exactly eight big-endian IEEE 754 bytes. All bit patterns are accepted;
// NaN payload/sign information is not preserved by the Float value interface.
pub fn decode_be(value Bytes) Result[Float, DecodeError] {
    if length(value) != 8 {
        return Result.Err(DecodeError.WrongWidth)
    }
    let negative = get(value, 0) >= 128
    let exponent = (get(value, 0) & 127) * 16 + (get(value, 1) >> 4)
    var fraction = get(value, 1) & 15
    var index = 2
    while index < 8 {
        fraction = fraction * 256 + get(value, index)
        index = index + 1
    }
    if exponent == 2047 {
        if fraction != 0 {
            return Result.Ok(0.0 / 0.0)
        }
        return Result.Ok(if negative {
                -1.0 / 0.0
            } else {
                1.0 / 0.0
            })
    }
    let significand = if exponent == 0 {
        from_int(fraction)
    } else {
        from_int(fraction) + 4503599627370496.0
    }
    let power = if exponent == 0 {
        -1074
    } else {
        exponent - 1075
    }
    let output = scale(significand, power)
    Result.Ok(if negative {
            -output
        } else {
            output
        })
}

fn integer(value Float) Int {
    match to_int(value) {
        Result.Ok(value) => value
        Result.Err(_) => {
            assert false
            0
        }
    }
}

// A fresh eight-byte buffer. Finite values, infinities and zero signs round
// trip exactly; every NaN encodes as the canonical quiet NaN 7ff8000000000000.
// The implementation uses ordinary pure arithmetic, including in CTFE.
pub fn encode_be(value Float) Bytes {
    let negative = value < 0.0 || (value == 0.0 && 1.0 / value < 0.0)
    var magnitude = if negative {
        -value
    } else {
        value
    }
    var exponent = 0
    var fraction = 0
    if is_nan(value) {
        exponent = 2047
        fraction = 2251799813685248
    } else {
        if magnitude == 1.0 / 0.0 {
            exponent = 2047
        } else {
            if magnitude < 2.2250738585072014e-308 {
                fraction = integer(magnitude / 5e-324)
            } else {
                exponent = 1023
                // Coarse powers of two keep the worst case below 80 exact
                // scaling steps, without penalizing ordinary values near one.
                while magnitude >= 18446744073709551616.0 {
                    magnitude = magnitude / 18446744073709551616.0
                    exponent = exponent + 64
                }
                while magnitude < 1.0 / 18446744073709551616.0 {
                    magnitude = magnitude * 18446744073709551616.0
                    exponent = exponent - 64
                }
                while magnitude >= 2.0 {
                    magnitude = magnitude * 0.5
                    exponent = exponent + 1
                }
                while magnitude < 1.0 {
                    magnitude = magnitude * 2.0
                    exponent = exponent - 1
                }
                fraction = integer((magnitude - 1.0) * 4503599627370496.0)
            }
        }
    }
    let output = new()
    push(output, (if negative {
                128
            } else {
                0
            }) + exponent / 16)
    push(output, (exponent % 16) * 16 + (fraction >> 48))
    var shift = 40
    while shift >= 0 {
        push(output, (fraction >> shift) & 255)
        shift = shift - 8
    }
    output
}
