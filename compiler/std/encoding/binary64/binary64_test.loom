import std.encoding.hex.encode
import std.encoding.hex.decode
import std.bytes.set

fn decoded(value Text) Float {
    let bytes = match decode(value) {
        Result.Ok(bytes) => bytes
        Result.Err(_) => {
            assert false
            new()
        }
    }
    match decode_be(bytes) {
        Result.Ok(value) => value
        Result.Err(_) => {
            assert false
            0.0
        }
    }
}

fn exact(value Float, expected Text) {
    assert encode(encode_be(value)) == expected
    assert decoded(expected) == value
    if value == 0.0 {
        assert 1.0 / decoded(expected) == 1.0 / value
    }
}

test fn binary64_encodes_known_ieee_values_and_extremes() {
    exact(0.0, "0000000000000000")
    exact(-0.0, "8000000000000000")
    exact(1.0, "3ff0000000000000")
    exact(-1.5, "bff8000000000000")
    exact(0.1, "3fb999999999999a")
    exact(5e-324, "0000000000000001")
    exact(-5e-324, "8000000000000001")
    exact(2.225073858507201e-308, "000fffffffffffff")
    exact(2.2250738585072014e-308, "0010000000000000")
    exact(1.7976931348623157e308, "7fefffffffffffff")
    exact(1.0 / 0.0, "7ff0000000000000")
    exact(-1.0 / 0.0, "fff0000000000000")
    assert encode(encode_be(0.0 / 0.0)) == "7ff8000000000000"
    assert is_nan(decoded("7ff0000000000001")) && is_nan(decoded("fff8000000000010"))
    assert match decode_be(new()) {
        Result.Err(DecodeError.WrongWidth) => true
        _ => false
    }
}

test fn binary64_roundtrips_sampled_patterns_and_returns_fresh_buffers() {
    var state = 12345
    var sample = 0
    while sample < 128 {
        let bytes = new()
        var index = 0
        while index < 8 {
            state = (state * 1664525 + 1013904223) & 4294967295
            push(bytes, state >> 24)
            index = index + 1
        }
        let value = match decode_be(bytes) {
            Result.Ok(value) => value
            Result.Err(_) => {
                assert false
                0.0
            }
        }
        if !is_nan(value) {
            assert encode(encode_be(value)) == encode(bytes)
        }
        sample = sample + 1
    }
    let first = encode_be(1.5)
    std.bytes.set(first, 0, 0)
    assert encode(encode_be(1.5)) == "3ff8000000000000"
}

test fn binary64_is_ordinary_compile_time_source_code() {
    let normal, zero, tiny = comptime {
        (encode_be(-1.5), decoded("8000000000000000"), encode_be(5e-324))
    }
    assert encode(normal) == "bff8000000000000"
    assert 1.0 / zero == -1.0 / 0.0
    assert encode(tiny) == "0000000000000001"
}
