import std.option.Option
import std.resource.MustScope
import std.resource.Dispose
import std.list.new
import std.list.push
import std.list.get
import std.list.set
import std.bytes.get
import std.bytes.push
import std.bytes.new
import std.bytes.length
import std.bytes.decode_utf8
import std.file.FileError
import std.result.Result
import std.iter.Iterator

intrinsic fn open(path Text) Int

intrinsic fn read(handle Int, buffer Bytes, limit Int) Int

intrinsic fn close(handle Int) Int

pub record Lines {
    file LineFile
}

// The private resource payload prevents a projection being used to create
// another owner. Cursor/buffer state remains inaccessible outside this package.
record LineFile {
    state LineState
}

record LineState {
    worker Bool
    handle List[Int]
    chunk List[Bytes]
    cursor List[Int]
    ended List[Bool]
    pending List[Option[FileError]]
}

fn line_cell[T](value T) List[T] {
    let cell = std.list.new[T]()
    std.list.push(cell, value)
    cell
}

fn line_state(handle Int, worker Bool) LineState {
    let pending Option[FileError] = Option.None
    LineState {
        worker = worker
        handle = line_cell(handle)
        chunk = line_cell(std.bytes.new())
        cursor = line_cell(0)
        ended = line_cell(false)
        pending = line_cell(pending)
    }
}

// Open once; pull/decode one line at a time. The caller must enter scoped.
pub fn read(path Text) Result[Lines, FileError] {
    let handle = open(path)
    if handle < 0 {
        return Result.Err(FileError.Open)
    }
    Result.Ok(Lines {
            file = LineFile {
                state = line_state(handle, false)
            }
        })
}

fn release_lines(state LineState) Int {
    let handle = get(state.handle, 0)
    set(state.handle, 0, -1)
    set(state.ended, 0, true)
    handle
}

fn close_lines(state LineState) Int {
    let handle = release_lines(state)
    if handle < 0 {
        return 0
    }
    if state.worker {
        file_abort(handle)
    } else {
        close(handle)
    }
}

// Explicit close reports failure; scoped cleanup remains the fallback.
pub fn close(value Lines) Result[Int, FileError] {
    let status = close_lines(value.file.state)
    if status < 0 {
        return Result.Err(FileError.Close)
    }
    Result.Ok(status)
}

fn line_failure(state LineState, error FileError) Option[Result[Text, FileError]] {
    discard close_lines(state)
    set(state.pending, 0, Option.None)
    Option.Some(Result.Err(error))
}

fn decoded_line(state LineState, bytes Bytes) Option[Result[Text, FileError]] {
    match std.bytes.decode_utf8(bytes) {
        Result.Ok(value) => Option.Some(Result.Ok(value))
        Result.Err(_) => line_failure(state, FileError.Utf8)
    }
}

fn pending_line(state LineState) Option[Result[Text, FileError]] {
    match get(state.pending, 0) {
        Option.Some(error) => {
            set(state.pending, 0, Option.None)
            Option.Some(Result.Err(error))
        }
        Option.None => Option.None
    }
}

// Consume only the current chunk. Both I/O modes use the same line framing.
fn buffered_line(state LineState, output Bytes, carried Bool) (Bool, Bool) {
    let chunk = get(state.chunk, 0)
    var cursor = get(state.cursor, 0)
    var carriage = carried
    while cursor < std.bytes.length(chunk) {
        let byte = std.bytes.get(chunk, cursor)
        cursor = cursor + 1
        if byte == 10 {
            set(state.cursor, 0, cursor)
            return (true, false)
        }
        if carriage {
            std.bytes.push(output, 13)
        }
        carriage = byte == 13
        if !carriage {
            std.bytes.push(output, byte)
        }
    }
    set(state.cursor, 0, cursor)
    (false, carriage)
}

fn finished_line(state LineState, output Bytes, carriage Bool, status Int) Option[Result[Text, FileError]] {
    if status < 0 {
        set(state.pending, 0, Option.Some(FileError.Close))
    }
    if carriage {
        std.bytes.push(output, 13)
    }
    if std.bytes.length(output) != 0 {
        return decoded_line(state, output)
    }
    pending_line(state)
}

// LF ends a line; a preceding CR is removed. A bare CR is ordinary content.
// Final unterminated content is returned, but no extra item follows a final LF.
// Errors are yielded once, never confused with EOF. Each Text is an isolated copy.
pub fn next(value Lines) Option[Result[Text, FileError]] {
    let state = value.file.state
    if get(state.ended, 0) {
        return pending_line(state)
    }
    let output = std.bytes.new()
    var carriage = false
    while true {
        let ready, carried = buffered_line(state, output, carriage)
        carriage = carried
        if ready {
            return decoded_line(state, output)
        }
        let buffer = std.bytes.new()
        let count = read(get(state.handle, 0), buffer, 8192)
        if count < 0 {
            return line_failure(state, FileError.Read)
        }
        if count == 0 {
            return finished_line(state, output, carriage, close_lines(state))
        }
        set(state.chunk, 0, buffer)
        set(state.cursor, 0, 0)
    }
    Option.None
}

impl MustScope for Lines {
}

impl Dispose for Lines {
    fn dispose(self Lines) {
    }
}

impl MustScope for LineFile {
}

impl Dispose for LineFile {
    fn dispose(self LineFile) {
        discard close_lines(self.state)
    }
}

impl Iterator for Lines {
    type Item = Result[Text, FileError]

    fn next(self Lines) Option[Result[Text, FileError]] {
        next(self)
    }
}
