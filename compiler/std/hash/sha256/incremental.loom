import std.bytes.length
import std.bytes.get
import std.bytes.set
import std.list.get
import std.list.set

record State {
    chain Chain
    size Int
    used Int
    pending Bytes
    words List[Int]
    k List[Int]
}

// Assignment shares this mutable state. Serialize updates and snapshots.
pub record Hasher {
    state List[State]
}

pub fn new_hasher() Hasher {
    Hasher {
        state = [State {
                chain = initial()
                size = 0
                used = 0
                pending = zeroes(64)
                words = new_words()
                k = constants()
            }]
    }
}

pub fn update(hasher Hasher, value Bytes) {
    update(hasher, value, 0, length(value))
}

// Consume [start, end) now, without retaining or modifying the input buffer.
pub fn update(hasher Hasher, value Bytes, start Int, end Int) {
    assert start >= 0 && end >= start && end <= length(value)
    let state = get(hasher.state, 0)
    let count = end - start
    assert count < 2305843009213693952 - state.size
    var chain = state.chain
    var used = state.used
    var offset = start
    if used > 0 {
        while used < 64 && offset < end {
            set(state.pending, used, get(value, offset))
            used = used + 1
            offset = offset + 1
        }
        if used == 64 {
            load_block(state.words, state.pending, 0)
            chain = compress(chain, state.words, state.k)
            used = 0
        }
    }
    while end - offset >= 64 {
        load_block(state.words, value, offset)
        chain = compress(chain, state.words, state.k)
        offset = offset + 64
    }
    while offset < end {
        set(state.pending, used, get(value, offset))
        used = used + 1
        offset = offset + 1
    }
    set(hasher.state, 0, State {
            chain = chain
            size = state.size + count
            used = used
            ..state
        })
}

// A nondestructive snapshot: updates may continue after digest/hex, and each
// returned digest is fresh. Padding never changes the live chain or its tail.
pub fn digest(hasher Hasher) Bytes {
    let state = get(hasher.state, 0)
    finish(state.chain, state.pending, 0, state.used, state.size, new_words(), state.k)
}

pub fn hex(hasher Hasher) Text {
    encode(digest(hasher))
}
