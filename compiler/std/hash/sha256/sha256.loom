import std.bytes.length
import std.bytes.get
import std.bytes.push
import std.bytes.to_text
import std.text.byte

// Fresh 32-byte digest; input is not modified or retained. Scratch stays fixed
// size. SHA-256 accepts fewer than 2^61 bytes; a larger message faults.
pub fn digest(value Bytes) Bytes {
    digest(value, 0, length(value))
}

pub fn digest(value Bytes, start Int, end Int) Bytes {
    assert start >= 0 && end >= start && end <= length(value)
    let size = end - start
    assert size < 2305843009213693952
    let words = new_words()
    let k = constants()
    var chain = initial()
    var offset = 0
    let full = size / 64 * 64
    while offset < full {
        load_block(words, value, start + offset)
        chain = compress(chain, words, k)
        offset = offset + 64
    }
    finish(chain, value, start + full, size - full, size, words, k)
}

fn encode(hashed Bytes) Text {
    let output = std.bytes.new()
    var index = 0
    while index < 32 {
        let current = get(hashed, index)
        push(output, byte("0123456789abcdef", current >> 4))
        push(output, byte("0123456789abcdef", current & 15))
        index = index + 1
    }
    to_text(output)
}

pub fn hex(value Bytes) Text {
    encode(digest(value))
}

pub fn hex(value Bytes, start Int, end Int) Text {
    encode(digest(value, start, end))
}
