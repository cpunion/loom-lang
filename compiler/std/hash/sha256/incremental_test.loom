test fn incremental_updates_cross_padding_and_block_boundaries() {
    let value = input("prefix:")
    var index = 0
    while index < 1024 {
        push(value, index % 256)
        index = index + 1
    }
    let sizes = [0, 1, 55, 56, 63, 64, 65, 119, 120, 127, 128, 129, 1024]
    let steps = [1, 7, 63, 64, 65]
    var size_index = 0
    while size_index < std.list.length(sizes) {
        let size = std.list.get(sizes, size_index)
        let expected = hex(value, 7, 7 + size)
        var step_index = 0
        while step_index < std.list.length(steps) {
            let hasher = new_hasher()
            let step = std.list.get(steps, step_index)
            var offset = 0
            while offset < size {
                let end = if size - offset < step {
                    size
                } else {
                    offset + step
                }
                update(hasher, value, 7 + offset, 7 + offset)
                update(hasher, value, 7 + offset, 7 + end)
                offset = end
            }
            assert hex(hasher) == expected
            assert hex(hasher) == expected
            let state = std.list.get(hasher.state, 0)
            assert state.size == size && state.used == size % 64
            assert std.bytes.length(state.pending) == 64 && std.list.length(state.words) == 64
            step_index = step_index + 1
        }
        size_index = size_index + 1
    }
}

test fn snapshots_are_fresh_nondestructive_and_assignments_share_updates() {
    let hasher = new_hasher()
    assert hex(hasher) == "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855"
    let source = input("abc")
    update(hasher, source, 0, 1)
    update(hasher, source, 1, 3)
    let expected = "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad"
    assert hex(hasher) == expected
    set(source, 0, 122)
    let snapshot = digest(hasher)
    set(snapshot, 0, 0)
    assert hex(hasher) == expected
    let alias = hasher
    update(alias, input("def"))
    assert hex(hasher) == hex(input("abcdef"))
    assert hex(alias) == hex(hasher)
    let folded = comptime {
        let state = new_hasher()
        update(state, input("a"))
        update(state, input("bc"))
        hex(state)
    }
    assert folded == expected
    // Exercise high-bit length encoding without allocating an enormous input.
    let maximum = 2305843009213693951
    assert padded_byte(std.bytes.new(), 0, 56, 0, 64, maximum) == 255
    assert padded_byte(std.bytes.new(), 0, 63, 0, 64, maximum) == 248
}

test fn incremental_million_byte_vector_retains_only_a_fixed_tail() {
    let hasher = new_hasher()
    let block = std.bytes.new()
    var index = 0
    while index < 4096 {
        push(block, 97)
        index = index + 1
    }
    index = 0
    while index < 244 {
        update(hasher, block)
        index = index + 1
    }
    update(hasher, block, 0, 576)
    assert hex(hasher) == "cdc76e5c9914fb9281a1c7e284d73e67f1809a48a497200e046d39ccc7112cd0"
    let state = std.list.get(hasher.state, 0)
    assert state.size == 1000000 && state.used == 0
    assert std.bytes.length(state.pending) == 64
}
