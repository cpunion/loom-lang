import std.stream.Stream
import std.stream.take
import std.stream.map
import std.stream.collect
import std.resource.MustScope
import std.resource.Dispose
import std.option.Option
import std.list.length

record Counter {
    remaining List[Int]
}

fn create(count Int) Counter {
    Counter {
        remaining = [count]
    }
}

fn create(count Int, extra Int) Counter {
    Counter {
        remaining = [count + extra]
    }
}

impl Stream for Counter {
    type Item = Int

    async fn next(self Counter) Option[Int] {
        let remaining = self.remaining[0]
        if remaining <= 0 {
            return Option.None
        }
        self.remaining[0] = remaining - 1
        Option.Some(remaining)
    }
}

impl MustScope for Counter {
}

impl Dispose for Counter {
    fn dispose(self Counter) {
    }
}

async fn doubled(value Int) Int {
    value * 2
}

async fn doubled(first Int, second Int) Int {
    first + second
}

test async fn stream_factories_and_async_callbacks_use_declared_arity() {
    {
        scoped source = take(create, 4, 2)
        let values = collect(source).await
        assert length(values) == 2 && values[0] == 4 && values[1] == 3
    }
    {
        scoped source = std.stream.map(create, 3, doubled)
        let values = collect(source).await
        assert length(values) == 3 && values[0] == 6 && values[2] == 2
    }
}
