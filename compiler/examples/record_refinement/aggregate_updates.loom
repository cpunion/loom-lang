record UpdateBatch {
    nested (List[Int], Bool)
    notes List[Int]
}

fn update_batch(batch UpdateBatch, value Int) {
    fill_positive(batch.nested.0, value)
    batch.notes[0] = -1
}

fn publish_batch(events List[Int]) Result[PositiveValues, ConstraintError] {
    let batch = UpdateBatch {
        nested = ([1, 2], true)
        notes = [0]
    }
    let alias = batch
    defer {
        update_batch(alias, 6)
        push(events, values_sum(batch.nested.0))
    }
    let published = PositiveValues(batch.nested.0)
    update_batch({
            push(events, 1)
            alias
        }, {
            push(events, 2)
            5
        })
    assert length(events) == 2 && events[0] == 1 && events[1] == 2
    assert batch.notes[0] == -1 && values_sum(batch.nested.0) == 10
    published
}

fn aggregate_update_scope() Bool {
    let events List[Int] = []
    let published = publish_batch(events)
    assert length(events) == 3 && events[2] == 12
    match published {
        Result.Ok(values) => values_sum(values) == 12
        Result.Err(_) => false
    }
}

test fn aggregate_updates_preserve_shared_headers_at_compile_time() {
    assert comptime {
        aggregate_update_scope()
    }
}

fn publish_entry_batch(notes List[Int]) Result[PositiveValues, ConstraintError] {
    let batch = UpdateBatch {
        nested = ([1, 2], true)
        notes = notes
    }
    let published = PositiveValues(batch.nested.0)
    update_batch(batch, 4)
    published
}

fn entry_update_scope() Bool {
    let notes = [0]
    let published = publish_entry_batch(notes)
    notes[0] == -1 && match published {
        Result.Ok(values) => values_sum(values) == 8
        Result.Err(_) => false
    }
}

test fn aggregate_updates_retain_entry_handle_chronology() {
    assert entry_update_scope()
    assert comptime {
        entry_update_scope()
    }
}

test async fn aggregate_updates_keep_aliases_across_suspension() {
    let batch = UpdateBatch {
        nested = ([1, 2], true)
        notes = [0]
    }
    let published = PositiveValues(batch.nested.0)
    sleep_ms(1).await
    update_batch(batch, 4)
    assert batch.notes[0] == -1 && match published {
        Result.Ok(values) => values_sum(values) == 8
        Result.Err(_) => false
    }
}
