import std.result.Result
import std.result.ConstraintError

record Inner {
    count Int
}

record Snapshot {
    inner Inner
    active Bool
}

type ActiveCount = Snapshot where self.inner.count >= 0 && self.active

record Quote {
    amount Float
    active Bool
}

type ValidQuote = Quote where self.amount >= 0.0 && self.amount <= 100.0 && self.active

fn fixed_quote() ValidQuote {
    ValidQuote(Quote {
            amount = 10.5
            active = true
        })
}

fn checked_quote(amount Float) Result[ValidQuote, ConstraintError] {
    ValidQuote(Quote {
            amount = amount
            active = true
        })
}

fn checked(value Snapshot) Result[ActiveCount, ConstraintError] {
    ActiveCount(value)
}

fn copy(value ActiveCount) ActiveCount
ensures result.inner.count == value.inner.count
{
    ActiveCount(value)
}

fn widened(value ActiveCount) Snapshot {
    value
}

fn prepared() ActiveCount {
    comptime {
        ActiveCount(Snapshot {
                inner = Inner {
                    count = 7
                }
                active = true
            })
    }
}

fn main() {
    assert match checked(Snapshot {
            inner = Inner {
                count = 3
            }
            active = true
        }) {
        Result.Ok(valid) => {
            let plain = widened(copy(valid))
            plain.inner.count == 3 && plain.active
        },
        _ => false
    }
    assert match checked(Snapshot {
            inner = Inner {
                count = -1
            }
            active = true
        }) {
        Result.Err(_) => true,
        _ => false
    }
    assert prepared().inner.count == 7
    assert fixed_quote().amount == 10.5
    assert match checked_quote(-1.0) {
        Result.Err(_) => true,
        _ => false
    }
}
