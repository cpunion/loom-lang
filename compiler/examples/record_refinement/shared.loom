import std.list.push
import std.list.length
import std.text.length
import std.bytes.new
import std.bytes.push

record SharedDetails {
    count Int
    values List[Int]
}

record SharedSnapshot {
    details SharedDetails
    name Text
    bytes Bytes
}

fn positive_count(value Int) Bool {
    value > 0
}

fn positive_snapshot(value SharedSnapshot) Bool {
    let copy = value
    positive_count(copy.details.count)
}

type NamedCount = SharedSnapshot where positive_snapshot(self) && std.text.length(self.name) > 0

fn shared_snapshot(value SharedSnapshot) Result[NamedCount, ConstraintError] {
    NamedCount(value)
}

fn tracked_values(values List[Int], trace List[Int]) List[Int] {
    push(trace, 1)
    values
}

fn tracked_bytes(bytes Bytes, trace List[Int]) Bytes {
    push(trace, 2)
    bytes
}

fn direct_shared_snapshot(values List[Int], bytes Bytes, trace List[Int], count Int) NamedCount
requires count > 0
{
    NamedCount(SharedSnapshot {
            details = SharedDetails {
                values = tracked_values(values, trace)
                count = count
            }
            name = "sample"
            bytes = tracked_bytes(bytes, trace)
        })
}

fn observed_count(value NamedCount) Int
ensures result > 0
{
    value.details.count
}

fn update_unobserved(value NamedCount) Int {
    value.details.values[0] = 9
    push(value.details.values, 10)
    value.bytes[0] = 65
    observed_count(value)
}

fn shared_invariant_scope() Bool {
    let list = [1]
    let bytes = std.bytes.new()
    std.bytes.push(bytes, 100)
    let trace List[Int] = []
    let direct = direct_shared_snapshot(list, bytes, trace, 3)
    assert length(trace) == 2 && trace[0] == 1 && trace[1] == 2
    assert direct.details.count == 3
    let source = SharedSnapshot {
        details = SharedDetails {
            count = 3
            values = list
        }
        name = "sample"
        bytes = bytes
    }
    let valid = match shared_snapshot(source) {
        Result.Ok(value) => value
        Result.Err(_) => {
            assert false
            return false
        }
    }
    assert update_unobserved(valid) == 3
    assert list[0] == 9 && list[1] == 10 && bytes[0] == 65
    list[0] = -7
    push(list, 11)
    assert direct.details.values[0] == -7 && length(direct.details.values) == 3
    assert direct.bytes[0] == 65 && direct.details.count == 3
    let widened SharedSnapshot = valid
    assert widened.details.values[0] == -7 && length(widened.details.values) == 3
    assert valid.details.count == 3 && source.details.count == 3
    let invalid = SharedSnapshot {
        details = SharedDetails {
            count = 0
            values = list
        }
        ..source
    }
    assert match shared_snapshot(invalid) {
        Result.Err(_) => true
        _ => false
    }
    true
}
