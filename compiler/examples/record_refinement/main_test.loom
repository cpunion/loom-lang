test fn checked_record_refinement_survives_copy_and_weakening() {
    assert match checked(Snapshot {
            inner = Inner {
                count = 5
            }
            active = true
        }) {
        Result.Ok(valid) => widened(copy(valid)).inner.count == 5,
        _ => false
    }
    assert match checked(Snapshot {
            inner = Inner {
                count = 0
            }
            active = false
        }) {
        Result.Err(_) => true,
        _ => false
    }
    assert prepared().inner.count == 7
    assert fixed_quote().amount == 10.5
    assert match checked_quote(3.5) {
        Result.Ok(value) => value.amount == 3.5,
        _ => false
    }
}
