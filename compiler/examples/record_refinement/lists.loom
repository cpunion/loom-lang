import std.list.clone
import std.list.reverse
import std.list.set

fn all_positive(values List[Int]) Bool {
    var index = 0
    while index < length(values) {
        if values[index] <= 0 {
            return false
        }
        index = index + 1
    }
    true
}

type PositiveValues = List[Int] where length(self) > 0 && all_positive(self)

type PositiveElement = Int where self > 0

type PositiveHead = List[Int] where length(self) > 0 && self[0] > 0

fn replace_positive(values PositiveValues, index Int, value PositiveElement) {
    values[index] = value
}

fn replace_guarded(values PositiveValues, index Int, value Int) {
    if value <= 0 {
        return
    }
    let replacement = value
    set(values, index, replacement)
}

fn replace_twice(values List[Int], index Int, value Int) {
    let alias = values
    alias[index] = value
    set(alias, index, value)
}

fn fill_positive(values List[Int], value Int) {
    if value <= 0 {
        return
    }
    var index = 0
    while index < length(values) {
        replace_twice(values, index, value)
        index = index + 1
    }
}

fn pair_length(values List[Int]) Bool {
    let inspect = fn() Int {
        length(values)
    }
    inspect() == 2
}

type IntPair = List[Int] where pair_length(self)

fn has_values(values List[Int]) Bool {
    length(values) > 0
}

type NonEmptyValues = List[Int] where has_values(self)

fn add_two(values List[Int], value Int) {
    push(values, value)
    push(values, value)
}

fn append_positive(values List[Int], value Int) {
    if value <= 0 {
        return
    }
    add_two(values, value)
}

fn positive_copy(values List[Int]) Result[PositiveValues, ConstraintError] {
    PositiveValues(clone(values))
}

fn positive_pair(first Int, second Int) Result[PositiveValues, ConstraintError] {
    PositiveValues([first, second])
}

fn values_sum(values List[Int]) Int {
    var total = 0
    var index = 0
    while index < length(values) {
        total = total + values[index]
        index = index + 1
    }
    total
}

fn list_constraint_scope() Bool {
    let source = [1, 2, 3]
    let valid = match positive_copy(source) {
        Result.Ok(value) => value
        Result.Err(_) => {
            assert false
            return false
        }
    }
    let alias = valid
    source[0] = -1
    push(source, 0)
    assert alias[0] == 1 && values_sum(alias) == 6
    assert length(valid) == 3
    let copy = clone(valid)
    copy[0] = -9
    assert valid[0] == 1
    assert match positive_pair(1, -1) {
        Result.Err(_) => true
        Result.Ok(_) => false
    }
    let literal = PositiveValues([2, 3])
    assert values_sum(literal) == 5
    let literal_alias = literal
    replace_positive(literal, 0, PositiveElement(4))
    set(literal_alias, 1, PositiveElement(5))
    replace_guarded(literal_alias, 0, 4)
    replace_guarded(literal, 0, -1)
    assert literal[0] == 4 && values_sum(literal_alias) == 9
    replace_twice(literal_alias, 0, PositiveElement(6))
    fill_positive(literal_alias, 7)
    fill_positive(literal, -1)
    assert literal[0] == 7 && values_sum(literal_alias) == 14
    push(literal, PositiveElement(8))
    append_positive(literal_alias, 9)
    append_positive(literal, -1)
    assert length(literal_alias) == 5 && values_sum(literal) == 40
    let head = PositiveHead([1, -1])
    let head_alias = head
    set(head, 0, PositiveElement(3))
    head_alias[1] = -2
    assert head[0] == 3 && head[1] == -2
    push(head_alias, -3)
    assert length(head) == 3 && head[0] == 3 && head[2] == -3
    let pair = IntPair([1, 2])
    let pair_alias = pair
    pair[0] = -7
    assert pair_alias[0] == -7
    reverse(pair)
    set(pair, 0, 9)
    assert pair_alias[0] == 9 && pair_alias[1] == -7
    assert length(pair) == 2
    let growing = NonEmptyValues([1])
    let growing_alias = growing
    add_two(growing, 2)
    growing[0] = -1
    assert length(growing_alias) == 3 && values_sum(growing_alias) == 3
    true
}

async fn retain_positive_values(values PositiveValues) PositiveValues {
    values
}

async fn retain_pair(values IntPair) IntPair {
    reverse(values)
    values
}

test async fn list_constraints_survive_task_handoff_and_moving_collection() {
    let original = PositiveValues([3, 4])
    let child = retain_positive_values(original)
    let alias = original
    let copied = clone(original)
    copied[0] = -3
    replace_positive(alias, 0, PositiveElement(5))
    let returned = child.await
    assert returned[0] == 5 && values_sum(alias) == 9
    let pair = IntPair([5, 6])
    let pair_child = retain_pair(pair)
    pair[0] = 7
    let pair_returned = pair_child.await
    assert pair[0] == 6 && pair_returned[1] == 7
}
