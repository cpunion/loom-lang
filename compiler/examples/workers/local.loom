import std.bytes.new
import std.bytes.push
import std.bytes.length
import std.list.new
import std.list.push
import std.list.length
import std.list.clone

// Storage created inside one invocation needs neither implicit copying nor
// shared-access locks. Its ordinary GC roots and cancellation points remain.
fn private_buffers() Int {
    let values = std.list.new[Int]()
    let alias = values
    let bytes = std.bytes.new()
    var index = 0
    while index < 32 {
        buffer_step(alias, bytes, index)
        index = index + 1
    }
    std.list.length(values) + std.bytes.length(bytes) + values[7]
}

fn buffer_step(values List[Int], bytes Bytes, value Int) {
    std.list.push(values, value)
    std.bytes.push(bytes, value)
}

fn private_seed() List[Int]
ensures std.list.length(result) == 2 && result[1] == 2
{
    [1, 2]
}

fn private_result() List[Int]
ensures std.list.length(result) == 3 && result[1] == 7
{
    let values = private_seed()
    std.list.push(values, 3)
    std.list.set(values, 1, 7)
    values
}

// Entry, old and current lengths are independent reads of shared storage.
// Nonnegativity survives interference; equality between these reads does not.
fn observed_count(values List[Int]) Int
requires std.list.length(values) >= 0
ensures result >= 0 && std.list.length(values) >= 0 && old(std.list.length(values)) >= 0
{
    std.list.length(values)
}

fn same_count(value Int) Bool {
    value == value
}

// This argument is read once; repeated use by a pure helper is stable. Writing
// length(values) == length(values) instead would make two independent reads.
fn observed_snapshot(values List[Int]) Int
ensures same_count(std.list.length(values)) && same_count(old(std.list.length(values)))
{
    std.list.length(values)
}

// Explicit copying isolates this outer List, not any shared elements it holds.
// No value postcondition is invented for clone; the checked body proves origin.
fn extended_copy(values List[Int]) Int
ensures result >= 1
{
    let copied = clone(values)
    std.list.push(copied, 7)
    std.list.length(copied)
}
