fn padded_measurement[Us...Measurement](values (Us...)) Int
ensures result >= 0 {
    measured(true, values..., 1)
}

fn joined_measurement[Us...Measurement, Vs...Measurement](left (Us...), right (Vs...)) Int
ensures result >= 0 {
    measured(true, left..., right...)
}

async fn composed_async_measurement[Us...Measurement](values (Us...)) Int
ensures result >= 0 {
    discard item(0).await
    measured(true, values..., 1)
}

record MeasuredBox[T] {
    value T
}

impl[T] Measurement for MeasuredBox[T] {
    fn measure(self MeasuredBox[T]) Int {
        1
    }
}

fn boxed_measurement[Us...](values (MeasuredBox[Us]...)) Int
ensures result >= 0 {
    padded_measurement(values)
}

async fn boxed_async_measurement[Us...](values (MeasuredBox[Us]...)) Int
ensures result >= 0 {
    composed_async_measurement(values).await
}

fn direct_boxed_measurement[Tag, Us...](values (MeasuredBox[Us]...)) Int
ensures result >= 0 {
    let MeasuredBox = comptime {
        Bool
    }
    var total = 0
    comptime for item in values {
        let pair = item.inspect[Tag](item.measure())
        let grouped = item.grouped(pair.0, (1, true), pack())
        total = total + item.preserve(grouped.0, true, "context")
        assert item.echo[Tag]("checked", 7) == "checked"
    }
    total
}

fn forwarded_boxed_measurement[Us...](values (MeasuredBox[Us]...)) Int
ensures result >= 0 {
    direct_boxed_measurement[Bool, Us...](values)
}

fn mixed_measurement[Tag, Us...Measurement, Vs...](log List[Int], left (Us...), right (Vs...),
    values (Bool, Us..., MeasuredBox[Vs]..., Us..., Bool)) Int
ensures result >= 0 {
    let MeasuredBox = comptime {
        Bool
    }
    var total = 0
    comptime for index, item in values {
        let pair = item.inspect[Tag](item.measure())
        let grouped = item.grouped(pair.0, (1, true), pack())
        total = total + item.preserve(grouped.0, true, "context") + index
        push(log, index)
    }
    total
}

fn forwarded_mixed_measurement[Us...Measurement, Vs...](log List[Int], left (Us...), right (Vs...),
    values (Bool, Us..., MeasuredBox[Vs]..., Us..., Bool)) Int
ensures result >= 0 {
    mixed_measurement[Bool, Us..., Vs...](log, left, right, values)
}

concept MixedMeasurement {
    fn total[Ts...](self Self, values (Bool, MeasuredBox[Ts]..., Bool)) Int
    ensures result >= 0 {
        0
    }
}

impl MixedMeasurement for Text {
    fn total[Us...](self Text, values (Bool, MeasuredBox[Us]..., Bool)) Int {
        var sum = 0
        comptime for item in values {
            sum = sum + item.measure()
        }
        sum
    }
}

fn exercise_composed_bounds() {
    assert padded_measurement(pack()) == 2
    assert padded_measurement((40,)) == 42
    assert joined_measurement((true,), (40,)) == 42
    assert joined_measurement(pack(), pack()) == 1
    assert comptime {
        padded_measurement((40,))
    } == 42
    let callback fn((Int,)) Int = padded_measurement
    assert callback((40,)) == 42
    assert boxed_measurement(pack()) == 2
    assert boxed_measurement((MeasuredBox {
                value = "text"
            }, MeasuredBox {
                value = true
            })) == 4
    assert comptime {
        boxed_measurement((MeasuredBox {
                    value = 7
                },))
    } == 3
    let boxed fn((MeasuredBox[Text],)) Int = boxed_measurement
    assert boxed((MeasuredBox {
                value = "callback"
            },)) == 3
    assert direct_boxed_measurement[Bool](pack()) == 0
    let boxes = (MeasuredBox {
            value = "text"
        }, MeasuredBox {
            value = true
        })
    assert direct_boxed_measurement[Int, Text, Bool](boxes) == 2
    assert forwarded_boxed_measurement(boxes) == 2
    assert comptime {
        direct_boxed_measurement[Bool, Int]((MeasuredBox {
                    value = 7
                },))
    } == 1
    let direct fn((MeasuredBox[Text],)) Int = direct_boxed_measurement[Bool, Text]
    assert direct((MeasuredBox {
                value = "callback"
            },)) == 1

    let log List[Int] = []
    assert mixed_measurement[Bool](log, pack(), pack(), (true, false)) == 2
    assert forwarded_mixed_measurement(log, (40,), ("text", true),
        (true, 40, boxes..., 42, false)) == 100
    assert length(log) == 8
    assert log[0] == 0 && log[1] == 1
    assert log[2] == 0 && log[3] == 1 && log[7] == 5
    assert comptime {
        mixed_measurement[Bool, Int]([], (4,), pack(), (true, 4, 5, false))
    } == 16
    let mixed fn(List[Int], (Bool,), (Text,), (Bool, Bool, MeasuredBox[Text], Bool, Bool)) Int = mixed_measurement[Bool, Bool, Text]
    assert mixed([], (true,), ("text",), (true, true, MeasuredBox {
                value = "callback"
            }, false, false)) == 13
    let receiver dyn MixedMeasurement = "override"
    assert receiver.total((true, MeasuredBox {
                value = "dynamic"
            }, false)) == 2
}
