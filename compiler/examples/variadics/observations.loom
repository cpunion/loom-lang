record Reading {
    amount Int
    valid Bool
    label Text
}

concept Measurement {
    fn measure(self Self) Int
    ensures result >= 0

    fn preserve[Us...](self Self, input Int, ignored Us...) Int
    requires input >= 0
    ensures result == old(input) {
        comptime for item in ignored {
            discard item
        }
        input
    }

    fn nonnegative(self Self, input Int) Bool
    ensures result == (input >= 0) {
        input >= 0
    }

    fn inspect[Tag](self Self, input Int) (Int, Bool)
    requires input >= 0
    ensures result.0 == input && result.1 {
        (input, true)
    }

    fn echo[Tag](self Self, input Text, comptime marker Int) Text
    ensures result == input {
        input
    }

    fn grouped[As..., Bs...](self Self, input Int, left (As...), right (Bs...)) (Int, Bool)
    requires input >= 0
    ensures result.0 == input && result.1 {
        comptime for item in left {
            discard item
        }
        comptime for item in right {
            discard item
        }
        (input, true)
    }

    fn note[Us...](self Self, log List[Int], input Int, ignored Us...)
    ensures length(log) == old(length(log)) + 1 {
        push(log, input)
        comptime for item in ignored {
            discard item
        }
    }
}

impl Measurement for Bool {
    fn measure(self Bool) Int {
        if self {
            1
        } else {
            0
        }
    }
}

impl Measurement for Int {
    fn measure(self Int) Int {
        if self < 0 {
            0
        } else {
            self
        }
    }
}

record Weight {
    amount Int
}

impl Measurement for Weight {
    fn measure(self Weight) Int {
        if self.amount < 0 {
            0
        } else {
            self.amount
        }
    }
}

fn measured[Ts...Measurement](values Ts...) Int
ensures result >= 0 {
    var total = 0
    comptime for item in values {
        let amount = item.measure()
        assert item.nonnegative(amount)
        total = total + item.preserve(amount, true, 7)
    }
    total
}

fn recorded[Ts...Measurement](log List[Int], values Ts...)
ensures length(log) >= old(length(log)) {
    comptime for index, item in values {
        item.note(log, index, true, 7)
    }
}

fn recorded_dyn(log List[Int], source dyn Measurement)
ensures length(log) >= old(length(log)) {
    source.note(log, 9)
}

fn inspected[Tag, Ts...Measurement](input Int, label Text, values Ts...) Reading
requires input >= 0
ensures result.amount >= input && result.valid && result.label == label {
    var state = Reading {
        amount = input
        valid = true
        label = label
    }
    comptime for item in values {
        let pair = item.inspect[Tag](item.measure())
        let grouped = item.grouped(pair.0, (1, true), pack())
        state = Reading {
            amount = state.amount + grouped.0
            valid = state.valid && pair.1 && grouped.1
            label = item.echo[Tag](state.label, 7)
        }
    }
    state
}

concept Measured {
    fn pairs[As...Measurement, Bs...Measurement](self Self, left (As...), right (Bs...)) (Int, Int)
    ensures result.0 >= 0 && result.1 >= 0

    fn total[Ts...Measurement](self Self, values Ts...) Int
    ensures result >= 0 {
        var total = 0
        comptime for item in values {
            total = total + item.measure()
        }
        total
    }
}

impl Measured for Bool {
    fn pairs[Us..., Vs...](self Bool, first (Us...), second (Vs...)) (Int, Int) {
        var a = 0
        var b = 0
        comptime for item in first {
            a = a + item.measure()
            comptime for other in second {
                b = b + other.preserve(other.measure())
            }
        }
        (a, b)
    }
}

fn exercise_pack_observations() {
    assert measured() == 0
    let weight = Weight {
        amount = 4
    }
    assert measured(2, true, weight, -1) == 7
    assert comptime {
        measured(2, true, Weight {
                amount = 4
            })
    } == 7
    let callback fn(Int, Bool, Weight) Int = measured
    assert callback(2, true, weight) == 7
    let empty = inspected[Bool](2, "empty")
    assert empty.amount == 2 && empty.valid && empty.label == "empty"
    let inspect fn(Int, Text, Int, Bool, Weight) Reading = inspected[Bool, Int, Bool, Weight]
    let reading = inspect(2, "mixed", 2, true, weight)
    assert reading.amount == 9 && reading.valid && reading.label == "mixed"
    assert comptime {
        inspected[Int, Bool](3, "static", true)
    }.amount == 4

    let source dyn Measured = true
    assert source.total() == 0 && source.total(2, true, weight) == 7
    let pair = source.pairs((true, 2), (weight, false))
    assert pair.0 == 3 && pair.1 == 8
    assert source.pairs(pack(), (weight,)).1 == 0
    assert source.pairs((weight,), pack()).0 == 4

    let log List[Int] = []
    assert measured(mark(log, 2), mark(log, 3), true) == 6
    assert length(log) == 2 && log[0] == 2 && log[1] == 3
    let observation dyn Measurement = true
    assert observation.preserve(4, mark(log, 5), mark(log, 6), false) == 4
    assert length(log) == 4 && log[2] == 5 && log[3] == 6
    recorded(log)
    recorded(log, 2, true)
    assert length(log) == 6 && log[4] == 0 && log[5] == 1
    recorded_dyn(log, observation)
    assert length(log) == 7 && log[6] == 9
    assert comptime {
        let log List[Int] = []
        recorded(log, 1, true)
        length(log)
    } == 2
}
