fn counted[Ts...](values Ts...) Int
ensures result >= 0 {
    var total = 0
    comptime for item in values {
        discard item
        total = total + 1
    }
    total
}

fn type_count[Ts...](values (Ts...)) Int
ensures result >= 0 {
    var total = 0
    comptime for T in Ts {
        total = total + 1
    }
    total
}

fn append_indices[Ts...](log List[Int], values (Ts...)) Int
ensures result >= 0 && length(log) >= old(length(log)) {
    var total = 0
    let alias = log
    comptime for index, item in values {
        discard item
        push(alias, index)
        total = total + 1
    }
    total
}

concept Counted {
    fn counts[As..., Bs...](self Self, left (As...), right (Bs...)) (Int, Int)
    ensures result.0 >= 0 && result.1 >= 0

    fn indices[Ts...](self Self, values Ts...) Int
    ensures result >= 0 {
        var total = 0
        comptime for index, item in values {
            discard item
            total = total + index
        }
        total
    }
}

impl Counted for Bool {
    fn counts[Us..., Vs...](self Bool, first (Us...), second (Vs...)) (Int, Int) {
        var outer = 0
        var pairs = 0
        comptime for item in first {
            discard item
            outer = outer + 1
            comptime for other in second {
                discard other
                pairs = pairs + 1
            }
        }
        (outer, pairs)
    }
}

fn exercise_pack_induction() {
    assert counted() == 0 && counted(true, "two", [3]) == 3
    assert type_count((true, 2, "three")) == 3
    assert comptime {
        counted(false, "text")
    } == 2
    let callback fn(Int, Bool) Int = counted
    assert callback(4, true) == 2

    let source dyn Counted = true
    let first = source.counts((1, true), ("a", "b", false))
    let second = source.counts((1,), ("a", "b", false))
    assert first.0 == 2 && first.1 == 6
    assert second.0 == 1 && second.1 == 3
    assert source.indices() == 0 && source.indices(1, true, "three") == 3
    assert source.counts(pack(), (1,)).1 == 0
    assert source.counts((1,), pack()).1 == 0

    let log = [42]
    assert append_indices(log, (true, 1, "three")) == 3
    assert length(log) == 4 && log[0] == 42
    assert log[1] == 0 && log[2] == 1 && log[3] == 2
    assert counted(mark(log, 4), mark(log, 5)) == 2
    assert length(log) == 6 && log[4] == 4 && log[5] == 5
}
