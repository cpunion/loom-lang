import std.int.to_text
import std.io.write_text
import std.list.get
import std.list.length
import std.list.new
import std.list.push
import std.process.exit_code
import std.result.Result
import std.text.concat

// Skip negative entries and stop before the running total exceeds the limit.
fn sum_until(values List[Int], limit Int) Int {
    var total = 0
    var index = 0
    while index < length(values) {
        let value = get(values, index)
        index = index + 1
        if value < 0 {
            continue
        }
        if total + value > limit {
            break
        }
        total = total + value
    }
    total
}

fn sample() List[Int] {
    let values = new[Int]()
    push(values, 1)
    push(values, -9)
    push(values, 3)
    push(values, 4)
    push(values, 8)
    values
}

fn main() {
    let total = sum_until(sample(), 10)
    match write_text(concat(to_text(total), "\n")) {
        Result.Ok(_) => {
        }
        Result.Err(_) => {
            exit_code(1)
        }
    }
}
