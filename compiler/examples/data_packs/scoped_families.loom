concept ScopedFamily {
    type Item[T]
    fn echo[T](self Self, value Self.Item[T]) Self.Item[T]
}

record ScopedCapture[T] {
    tag T
}

impl[T] ScopedFamily for ScopedCapture[T] {
    type Item[U] = (T, U)

    fn echo[U](self ScopedCapture[T], value (T, U)) (T, U) {
        value
    }
}

impl ScopedFamily for Bool {
    type Item[U] = U

    fn echo[U](self Bool, value U) U {
        value
    }
}

record ScopedFamilies[Ts...] {
    sources (Ts...)
    values (dyn ScopedFamily[Item[U] = (Ts, U)]...)
}

record ShadowedFamily[Ts...] {
    sources (Ts...)
    value dyn ScopedFamily[Item[Ts] = Ts]
}

fn exercise_scoped_families() {
    let first dyn ScopedFamily[Item[U] = (Int, U)] = ScopedCapture {
        tag = 1
    }
    let second dyn ScopedFamily[Item[U] = (Bool, U)] = ScopedCapture {
        tag = true
    }
    let rows = ScopedFamilies {
        sources = (1, true)
        values = (first, second)
    }
    let a = rows.values.0.echo[Text]((42, "answer"))
    let b = rows.values.1.echo[Int]((true, 7))
    assert a.0 == 42 && a.1 == "answer"
    assert b.0 && b.1 == 7
    let blank = packet()
    let empty = ScopedFamilies {
        sources = blank.values
        values = blank.values
    }
    discard empty.values
    let shadow = ShadowedFamily {
        sources = (1, "mixed")
        value = true
    }
    assert shadow.value.echo[Int](9) == 9
}
