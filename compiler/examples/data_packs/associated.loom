concept Source {
    type Item
    type Wrap[T]
    fn first(self Self) Self.Item
}

impl Source for Int {
    type Item = Text
    type Wrap[T] = (Int, T)

    fn first(self Int) Text {
        "integer"
    }
}

impl Source for Bool {
    type Item = Int
    type Wrap[T] = List[T]

    fn first(self Bool) Int {
        if self {
            42
        } else {
            0
        }
    }
}

record Produced[Tag, Ts...Source] {
    tag Tag
    sources (Ts...)
    items (Ts.Item...)
    wrapped (Ts.Source.Wrap[Ts]...)
}

enum Outputs[Ts...Source] {
    Items(Ts.Item...)
    Empty
}

fn extract[Ts...Source](sources Ts...) (Ts.Item...) {
    comptime map source in sources {
        source.first()
    }
}

fn projected[Ts...Source](values Ts.Item...) (Ts.Item...) {
    values
}

async fn associated() {
    let shared = [true]
    let produced = Produced {
        tag = "associated",
        sources = (1, true),
        items = extract(1, true),
        wrapped = ((1, 3), shared)
    }
    let resumed = echo(produced).await
    assert resumed.items.0 == "integer" && resumed.items.1 == 42
    assert resumed.wrapped.0.1 == 3 && resumed.wrapped.1[0]
    shared[0] = false
    assert !resumed.wrapped.1[0]

    let constant = comptime {
        extract(7, true)
    }
    assert constant.0 == "integer" && constant.1 == 42
    let callback = projected[Int, Bool]
    assert callback("explicit", 9).1 == 9

    let output Outputs[Int, Bool] = Outputs.Items("result", 42)
    assert match echo(output).await {
        Outputs.Items(text, number) => text == "result" && number == 42
        Outputs.Empty => false
    }
    let empty = extract()
    discard Produced {
        tag = 0,
        sources = empty,
        items = empty,
        wrapped = empty
    }
}
