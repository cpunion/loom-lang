test async fn lines_arrive_before_eof_and_preserve_split_utf8_after_cancellation() {
    assert match trial().await {
        Result.Ok(value) => value,
        _ => false
    }
}

test async fn async_owned_pipeline_closes_once_without_decoding_the_suffix() {
    assert match owned_trial().await {
        Result.Ok(value) => value,
        _ => false
    }
}
