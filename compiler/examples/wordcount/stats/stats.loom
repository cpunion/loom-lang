import std.text.codepoint
import std.text.length
import std.text.width
import std.unicode.is_whitespace

pub record Summary {
    lines Int
    words Int
    bytes Int
}

// Like wc, lines count LF characters, including the LF in a CRLF pair.
// Words are separated by Unicode whitespace; byte counts use UTF-8.
pub fn summarize(text Text) Summary {
    var lines = 0
    var words = 0
    var in_word = false
    var offset = 0
    while offset < length(text) {
        let scalar = codepoint(text, offset)
        if scalar == 10 {
            lines = lines + 1
        }
        let space = is_whitespace(scalar)
        if !space && !in_word {
            words = words + 1
        }
        in_word = !space
        offset = offset + width(text, offset)
    }
    Summary {
        lines = lines
        words = words
        bytes = length(text)
    }
}
