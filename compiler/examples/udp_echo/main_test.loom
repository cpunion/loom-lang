test async fn datagram_echo_uses_the_native_reactor() {
    assert match exercise().await {
        Result.Ok(value) => value
        Result.Err(_) => false
    }
}

test async fn local_multicast_delivers_through_the_native_reactor() {
    assert match exercise_multicast().await {
        Result.Ok(value) => value
        Result.Err(_) => false
    }
}
