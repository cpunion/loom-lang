import std.list.length
import std.list.push

fn opaque_independent[T](state T, effect fn(T)) Int
ensures result == 1 {
    let fresh = [7]
    effect(state)
    length(fresh)
}

fn opaque_generated[S, T](count Int, state S, next fn(S) (S, T)) List[T]
requires count >= 0 && count <= 100
ensures length(result) == count {
    let output List[T] = []
    var current = state
    var index = 0
    while index < count {
        let changed, value = next(current)
        current = changed
        push(output, value)
        index = index + 1
    }
    output
}

fn opaque_exercise() {
    let shared = [0]
    assert opaque_independent(shared, fn(state List[Int]) {
            state[0] = state[0] + 1
        }) == 1
    assert shared[0] == 1
    let values = opaque_generated(3, shared, fn(state List[Int]) (List[Int], List[Int]) {
            state[0] = state[0] + 1
            (state, state)
        })
    assert length(values) == 3 && shared[0] == 4
    assert values[0][0] == 4 && values[2][0] == 4
    shared[0] = 9
    assert values[1][0] == 9
    let empty = opaque_generated(0, 7, fn(state Int) (Int, Int) {
            assert false
            (state, state)
        })
    assert length(empty) == 0
    let evaluated = comptime {
        opaque_generated(3, 0, fn(state Int) (Int, Int) {
                (state + 1, state)
            })
    }
    assert evaluated[0] == 0 && evaluated[2] == 2
}
