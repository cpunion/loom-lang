record Count {
    position Int
    total Int
}

fn reach(limit Int) Int
ensures result >= limit && result >= 0
{
    var i = 0
    while true {
        if i >= limit {
            break
        }
        i = i + 1
    }
    i
}

fn count_selected(limit Int) Count
requires limit >= 0
ensures result.position == limit && result.total >= 0
{
    var i = 0
    var total = 0
    while i < limit {
        i = i + 1
        if i < 3 {
            continue
        }
        total = total + i
    }
    Count {
        position = i
        total = total
    }
}

fn nested_jumps(limit Int) Int
ensures result >= 0
{
    var i = 0
    var total = 0
    while i < limit {
        i = i + 1
        var j = 0
        while j < 2 {
            j = j + 1
            if j == 1 {
                continue
            }
            total = total + 1
            break
        }
        if i < 3 {
            continue
        }
        total = total + 1
    }
    total
}

fn control_exercise() {
    assert reach(-3) == 0
    assert reach(7) == 7
    let count = count_selected(4)
    assert count.position == 4 && count.total == 7
    assert nested_jumps(0) == 0
    assert nested_jumps(4) == 6
    assert deferred_count(4) == 4
    assert cleanup_snapshot() == 7
}

fn deferred_count(limit Int) Int
requires limit >= 0
ensures result == limit
{
    var i = 0
    while i < limit {
        defer {
            i = i + 1
        }
        continue
    }
    i
}

fn cleanup_snapshot() Int
ensures result == 7
{
    var value = 7
    while true {
        defer {
            value = -1
        }
        return value
    }
}
