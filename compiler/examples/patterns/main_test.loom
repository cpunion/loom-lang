test fn nested_value_patterns_work_at_runtime_and_compile_time() {
    guard_values()
    exercise_values()
    literal_values()
    multiline_values()
    record_values()
    record_bindings()
    comptime {
        guard_values()
        exercise_values()
        literal_values()
        multiline_values()
        record_values()
        record_bindings()
    }
}

test async fn nested_task_patterns_transfer_once_and_keep_cleanup() {
    guard_tasks().await
    exercise_tasks().await
    literal_tasks().await
    record_tasks().await
    record_task_bindings().await
}
