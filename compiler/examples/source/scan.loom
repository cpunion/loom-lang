import std.list.new
import std.list.push
import std.text.byte
import std.text.length

enum Kind {
    Name
    Number
    Symbol
}

record Token {
    kind Kind
    start Int
    end Int
}

fn letter(byte Int) Bool {
    (byte >= 65 && byte <= 90) || (byte >= 97 && byte <= 122) || byte == 95
}

fn digit(byte Int) Bool { byte >= 48 && byte <= 57 }

// A small ASCII token scanner, not the complete Loom lexer.
fn scan(source Text) List[Token] {
    let tokens = new[Token]()
    var offset = 0
    let size = length(source)
    while offset < size {
        let start = offset
        let current = byte(source, offset)
        offset = offset + 1
        if current > 32 {
            var kind = Kind.Symbol
            if letter(current) {
                kind = Kind.Name
                while offset < size && (letter(byte(source, offset)) || digit(byte(source, offset))) {
                    offset = offset + 1
                }
            } else {
                if digit(current) {
                    kind = Kind.Number
                    while offset < size && digit(byte(source, offset)) {
                        offset = offset + 1
                    }
                }
            }
            push(tokens, Token { kind = kind start = start end = offset })
        }
    }
    tokens
}

test fn empty_source() {
    discard scan("")
}
