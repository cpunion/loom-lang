import std.io.read_bytes
import std.io.write_bytes
import std.io.write_error
import std.bytes.new
import std.process.exit_code
import std.result.Result

// A binary-safe stdin-to-stdout filter. Like read_text, read_bytes buffers to
// EOF; it is not a bounded-memory streaming reader.
fn main() {
    let bytes = match read_bytes() {
        Result.Ok(value) => value
        Result.Err(_) => {
            discard write_error("cannot read stdin\n")
            exit_code(1)
            return
        }
    }
    match write_bytes(bytes) {
        Result.Ok(_) => {
        }
        Result.Err(_) => {
            discard write_error("cannot write stdout\n")
            exit_code(1)
        }
    }
}

test fn empty_output_is_a_successful_write() {
    assert match write_bytes(new()) {
        Result.Ok(count) => count == 0
        Result.Err(_) => false
    }
}
