import std.list.length
import std.list.get
import std.list.set

// These are ordinary runtime functions. Proofs derive bounded scans and finite
// histogram laws from their checked bodies, not from these helper names.
fn ordered(values List[Int]) Bool {
    var index = 1
    while index < length(values) {
        if get(values, index - 1) > get(values, index) {
            return false
        }
        index = index + 1
    }
    true
}

fn occurrences(values List[Int], needle Int) Int {
    var index = 0
    var count = 0
    while index < length(values) {
        if get(values, index) == needle {
            count = count + 1
        }
        index = index + 1
    }
    count
}

fn same_counts(first List[Int], second List[Int]) Bool {
    var index = 0
    while index < length(first) {
        if occurrences(first, get(first, index)) != occurrences(second, get(first, index)) {
            return false
        }
        index = index + 1
    }
    true
}

fn permutation(first List[Int], second List[Int]) Bool {
    length(first) == length(second) && same_counts(first, second)
}

fn swap(values List[Int], first Int, second Int)
requires first >= 0 && first < length(values)
requires second >= 0 && second < length(values)
ensures permutation(values, old(values))
{
    let before = get(values, first)
    let after = get(values, second)
    set(values, first, after)
    set(values, second, before)
}

fn reverse(values List[Int])
ensures permutation(values, old(values))
{
    var index = 0
    while index < length(values) - index {
        swap(values, index, length(values) - index - 1)
        index = index + 1
    }
}

fn sort(values List[Int]) List[Int]
ensures ordered(result)
ensures permutation(result, old(values))
{
    var end = length(values)
    while end > 1 {
        var index = 1
        while index < end {
            let left = get(values, index - 1)
            let right = get(values, index)
            if left > right {
                set(values, index - 1, right)
                set(values, index, left)
            }
            index = index + 1
        }
        end = end - 1
    }
    values
}

fn unchanged_order(values List[Int]) List[Int]
ensures ordered(result) == ordered(old(values))
{
    values
}

fn quantified_cases() {
    let values = [3, -1, 2, -1]
    let alias = values
    reverse(values)
    assert permutation(alias, [3, -1, 2, -1])
    let sorted = sort(values)
    assert ordered(sorted) && permutation(sorted, [3, -1, 2, -1])
    assert alias[0] == -1 && alias[1] == -1 && alias[2] == 2 && alias[3] == 3
    assert occurrences(alias, -1) == 2
    assert ordered(unchanged_order(alias))
    swap(values, 0, 0)
    let empty List[Int] = []
    discard sort(empty)
    reverse(empty)
    assert ordered(empty) && permutation(empty, [])
    assert ordered(sort([7]))
}

test fn sorting_and_permutation_are_proved_and_run_as_ordinary_code() {
    quantified_cases()
}
