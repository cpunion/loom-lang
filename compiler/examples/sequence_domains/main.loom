import std.list.length
import std.bytes.length
import std.text.length
import std.text.to_bytes

record Row {
    amount Int
    label Text
}

fn machine_range(values List[Int]) Bool {
    var index = 0
    while index < length(values) {
        if values[index] < -9223372036854775808 || values[index] > 9223372036854775807 {
            return false
        }
        index = index + 1
    }
    true
}

fn byte_range(values Bytes) Bool {
    var index = 0
    while index < length(values) {
        if values[index] < 0 || values[index] > 255 {
            return false
        }
        index = index + 1
    }
    true
}

fn row_range(values List[Row]) Bool {
    var index = 0
    while index < length(values) {
        let row = values[index]
        if row.amount < -9223372036854775808 || row.amount > 9223372036854775807 || length(row.label) < 0 {
            return false
        }
        index = index + 1
    }
    true
}

fn typed_storage(values List[Int], bytes Bytes, rows List[Row]) Bool
ensures result && machine_range(values) && byte_range(bytes) && row_range(rows)
{
    true
}

fn ordered(values List[Int]) Bool {
    var index = 1
    while index < length(values) {
        if values[index - 1] > values[index] {
            return false
        }
        index = index + 1
    }
    true
}

type Sorted = List[Int] where ordered(self)

fn opaque_size[T](values List[T]) Bool {
    var remaining = length(values)
    var total = 0
    while remaining > 0 {
        total = total + remaining
        remaining = remaining - 1
    }
    total >= 0
}

fn all_sevens(values List[Int]) Bool {
    var index = 0
    while index < length(values) {
        if values[index] != 7 {
            return false
        }
        index = index + 1
    }
    true
}

type Sevens = List[Int] where opaque_size(self) && length(self) > 0 && all_sevens(self)

fn preserve_sevens(values Sevens) {
    values[0] = 7
}

type DecimalHeader = List[Float] where opaque_size(self) && length(self) > 0 && self[0] == 7.25

fn preserve_decimal(values DecimalHeader) {
    values[0] = 7.25
}

type NegativeZeroHeader = List[Float] where opaque_size(self) && length(self) > 0 && self[0] == 0.0 && 1.0 / self[0] < 0.0

fn preserve_negative_zero(values NegativeZeroHeader) {
    values[0] = -0.0
}

fn set_last(values List[Int]) {
    values[length(values) - 1] = 9223372036854775807
}

fn extend_endpoints(values Sorted) {
    values[0] = -9223372036854775808
    values[length(values) - 1] = 9223372036854775807
}

fn exercise() {
    let sevens = Sevens([7, 7])
    preserve_sevens(sevens)
    assert all_sevens(sevens)
    let decimals = DecimalHeader([7.25, -0.0])
    let decimal_alias = decimals
    preserve_decimal(decimals)
    assert decimal_alias[0] == 7.25 && 1.0 / decimal_alias[1] < 0.0
    let zero = NegativeZeroHeader([-0.0])
    preserve_negative_zero(zero)
    assert 1.0 / zero[0] < 0.0
    let extremes = [-9223372036854775808, 0, 9223372036854775807]
    let rows = [Row {
            amount = -9223372036854775808
            label = ""
        }, Row {
            amount = 9223372036854775807
            label = "hé"
        }]
    let bytes = to_bytes("\0ÿ")
    bytes[1] = 255
    assert typed_storage(extremes, bytes, rows)
    assert typed_storage([], to_bytes(""), [])
    let sorted = Sorted([-1, 0, 1])
    let alias = sorted
    extend_endpoints(sorted)
    assert alias[0] == -9223372036854775808 && alias[2] == 9223372036854775807
    let forwarded = Sorted([-1, 0, 1])
    set_last(forwarded)
    assert forwarded[2] == 9223372036854775807
}

fn main() {
    exercise()
}
