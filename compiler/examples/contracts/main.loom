fn positive(value Int) Bool {
    value > 0
}

// Calling this predicate requires proof that its argument is positive.
fn admitted(value Int) Bool
requires value > 0 {
    true
}

fn good(value Int) Int
requires positive(value)
ensures result == value && admitted(result)
{
    value
}

fn forward(value Int) Int
requires positive(value)
ensures result == value
{
    good(value)
}

fn between(value Int, low Int, high Int) Bool {
    if value < low {
        return false
    }
    if value > high {
        return false
    }
    true
}

fn bounded(value Int, low Int, high Int) Int
requires between(value, low, high)
ensures between(result, low, high)
{
    value
}

fn minimum(a Int, b Int) Int {
    if a <= b {
        a
    } else {
        b
    }
}

fn lower(a Int, b Int) Int
ensures result <= a && result <= b
{
    minimum(a, b)
}

fn main() {
    assert good(7) == 7
    assert forward(7) == 7
    assert comptime {
        good(7)
    } == 7
    assert bounded(12, 10, 20) == 12
    assert lower(7, 3) == 3
    assert comptime {
        lower(3, 7)
    } == 3
}
