async fn borrowed_leaf_work(value Leaf, delay Int) Int {
    push(value.trace, 70)
    defer {
        push(value.trace, 80)
    }
    sleep_ms(delay).await
    value.id
}

fn forward_leaf_work(value Leaf, delay Int) Task[Int] {
    borrowed_leaf_work(value, delay)
}

fn forward_leaf_callback[T MustScope](value T, delay Int,
    work fn(T, Int) Task[Int]) Task[Int] {
    work(value, delay)
}

test async fn synchronous_forwarding_keeps_the_callers_owner_until_await_completes() {
    let trace List[Int] = []
    {
        scoped value = acquire(3, trace)
        let callback fn(Leaf, Int) Task[Int] = forward_leaf_work
        assert callback(value, 0).await == 3
        assert forward_leaf_callback(value, 0, borrowed_leaf_work).await == 3
        assert length(trace) == 5 && trace[4] == 80
    }
    assert length(trace) == 6 && trace[5] == 3
}

async fn owning_forwarded_work(trace List[Int], fault Bool) {
    scoped value = acquire(4, trace)
    if fault {
        discard forward_leaf_callback(value, 0, faulting_leaf_work).await
    } else {
        discard forward_leaf_work(value, 10000).await
    }
}

async fn faulting_leaf_work(value Leaf, delay Int) Int {
    push(value.trace, 70)
    defer {
        push(value.trace, 80)
    }
    sleep_ms(delay).await
    assert false
    value.id
}

test async fn forwarded_borrows_drain_before_owner_cleanup_on_fault_and_cancellation() {
    let trace List[Int] = []
    let pending = owning_forwarded_work(trace, false)
    while length(trace) < 2 {
        sleep_ms(0).await
    }
    assert match cancel(pending) {
        Outcome.Cancelled => true
        _ => false
    }
    assert length(trace) == 4 && trace[0] == 40 && trace[1] == 70 &&
    trace[2] == 80 && trace[3] == 4
    assert match outcome(owning_forwarded_work(trace, true)).await {
        Outcome.Faulted(error) => contains(error.message, "resource_task_forwarding_test.loom:")
        _ => false
    }
    assert length(trace) == 8 && trace[6] == 80 && trace[7] == 4
}
