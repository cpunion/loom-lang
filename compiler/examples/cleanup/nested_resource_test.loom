fn nested_attempt(trace List[Int], choice Int) Result[(AcquiredPair, Bool), PatternIssue] {
    if choice < 0 {
        return Result.Err(PatternIssue.Failed(choice))
    }
    Result.Ok((acquired_pair(trace), choice == 0))
}

fn nested_selected(trace List[Int], choice Int) Leaf {
    match nested_attempt(trace, choice) {
        Result.Ok((AcquiredPair.Pair(first, second), true)) => {
            scoped held = second
            first
        }
        Result.Ok((AcquiredPair.Pair(first, second), false)) => {
            scoped held = first
            second
        }
        Result.Err(PatternIssue.Failed(_)) => acquire(3, trace)
    }
}

fn nested_whole(trace List[Int], choice Int) (AcquiredPair, Bool) {
    match nested_attempt(trace, choice) {
        Result.Ok((AcquiredPair.Pair(first, second), true)) => (AcquiredPair.Pair(second, first), true)
        Result.Ok(rest) => rest
        Result.Err(PatternIssue.Failed(_)) => (acquired_pair(trace), false)
    }
}

fn nested_trial() Bool {
    var choice = -1
    while choice < 2 {
        let trace List[Int] = []
        {
            scoped selected = nested_selected(trace, choice)
            assert selected.id == if choice < 0 {
                3
            } else {
                choice + 1
            }
        }
        if choice < 0 {
            assert length(trace) == 2 && trace[0] == 30 && trace[1] == 3
        } else {
            assert length(trace) == 4 && trace[0] == 10 && trace[1] == 20
            assert trace[2] == 2 - choice && trace[3] == choice + 1
        }
        let rebuilt List[Int] = []
        {
            scoped selected = nested_whole(rebuilt, choice)
            match selected {
                (AcquiredPair.Pair(first, second), flag) => {
                    assert first.id + second.id == 3
                    assert flag == (choice == 0)
                }
            }
        }
        assert length(rebuilt) == 4 && rebuilt[0] == 10 && rebuilt[1] == 20
        assert rebuilt[2] == if choice == 0 {
            1
        } else {
            2
        }
        assert rebuilt[2] + rebuilt[3] == 3
        choice = choice + 1
    }
    true
}

test fn nested_resource_patterns_forward_rebuild_and_borrow_once() {
    assert nested_trial()
    assert comptime {
        nested_trial()
    }
}

async fn nested_rebuild(trace List[Int], fail Bool, wait Bool) PatternWrapped {
    match nested_attempt(trace, 0) {
        Result.Ok((AcquiredPair.Pair(first, second), _)) => {
            scoped held = second
            PatternWrapped {
                label = reconstruction_label(trace, fail, wait).await
                inner = first
            }
        }
        Result.Err(PatternIssue.Failed(_)) => PatternWrapped {
            label = 0
            inner = acquire(3, trace)
        }
    }
}

test async fn nested_resource_patterns_keep_guards_through_faults_and_cancellation() {
    let failed List[Int] = []
    {
        scoped selected = outcome(nested_rebuild(failed, true, false)).await
        assert match selected {
            Outcome.Faulted(_) => true
            _ => false
        }
    }
    assert length(failed) == 5 && failed[2] == 99 && failed[3] == 1 && failed[4] == 2

    let cancelled List[Int] = []
    let pending = nested_rebuild(cancelled, false, true)
    while length(cancelled) < 3 {
        sleep_ms(0).await
    }
    {
        scoped selected = cancel(pending)
        assert match selected {
            Outcome.Cancelled => true
            _ => false
        }
    }
    assert length(cancelled) == 5 && cancelled[2] == 99 && cancelled[3] == 1 && cancelled[4] == 2
}
