import std.resource.MustScope
import std.resource.Dispose
import std.resource.generate
import std.list.push
import std.list.length

record ContractHandle {
    id Int
    closed List[Int]
}

impl MustScope for ContractHandle {
}

impl Dispose for ContractHandle {
    fn dispose(self ContractHandle) {
        push(self.closed, self.id)
    }
}

fn contract_handle_id(value ContractHandle) Int {
    value.id
}

fn contract_handle(id Int, closed List[Int]) ContractHandle
ensures contract_handle_id(result) == id {
    ContractHandle {
        id = id
        closed = closed
    }
}

fn forward_contract_handle(id Int, closed List[Int]) ContractHandle
ensures contract_handle_id(result) == id {
    contract_handle(id, closed)
}

test fn synchronous_resource_contracts_preserve_transfer_and_scope_cleanup() {
    let closed List[Int] = []
    {
        scoped first = forward_contract_handle(7, closed)
        scoped second = contract_handle(8, closed)
        assert contract_handle_id(first) == 7
        assert contract_handle_id(second) == 8
        assert length(closed) == 0
    }
    assert length(closed) == 2 && closed[0] == 8 && closed[1] == 7
}

fn generated_contract_handles(count Int, closed List[Int]) List[ContractHandle]
requires count >= 0
ensures length(result) == count {
    generate(count, fn(index Int) ContractHandle {
            contract_handle(index, closed)
        })
}

fn stateful_contract_handles(count Int, closed List[Int]) List[ContractHandle]
requires count >= 0
ensures length(result) == count {
    generate(count, closed, fn(index Int, state List[Int]) (ContractHandle, List[Int]) {
            (contract_handle(index, state), state)
        }, fn(state List[Int]) {
            discard state
        })
}

test fn generated_resource_lengths_compose_without_losing_reverse_cleanup() {
    let closed List[Int] = []
    {
        scoped handles = generated_contract_handles(3, closed)
        assert length(handles) == 3 && length(closed) == 0
    }
    assert length(closed) == 3 && closed[0] == 2 && closed[2] == 0
    {
        scoped handles = stateful_contract_handles(2, closed)
        assert length(handles) == 2 && length(closed) == 3
    }
    assert length(closed) == 5 && closed[3] == 1 && closed[4] == 0
}
