import std.task.any
import std.task.race

test async fn resource_selection_drains_completed_losers_before_scoped_extraction() {
    let trace List[Int] = []
    let first = acquire_async(1, trace)
    let second = acquire_async(2, trace)
    while length(trace) < 2 {
        sleep_ms(0).await
    }
    {
        scoped winner = any([first, second]).await
        assert winner.id == 1
        assert length(trace) == 3 && trace[2] == 2
    }
    assert length(trace) == 4 && trace[3] == 1
    let race_first = acquire_async(3, trace)
    let race_second = acquire_async(4, trace)
    while length(trace) < 6 {
        sleep_ms(0).await
    }
    {
        scoped selected = race(race_first, race_second).await
        match selected {
            Outcome.Completed(value) => {
                assert value.id == 3
            }
            _ => {
                assert false
            }
        }
        assert length(trace) == 7 && trace[6] == 4
    }
    assert length(trace) == 8 && trace[7] == 3
}

async fn selection_failure(trace List[Int]) Leaf {
    assert false
    acquire(9, trace)
}

test async fn any_ignores_failed_producers_without_borrowing_the_success_payload() {
    let trace List[Int] = []
    {
        scoped winner = any(selection_failure(trace), acquire_async(1, trace)).await
        assert winner.id == 1 && length(trace) == 1
    }
    assert length(trace) == 2 && trace[1] == 1
}

test async fn race_retains_the_first_fault_and_drains_completed_resource_losers() {
    let trace List[Int] = []
    let failed = selection_failure(trace)
    let completed = acquire_async(1, trace)
    while length(trace) < 1 {
        sleep_ms(0).await
    }
    {
        scoped selected = race([failed, completed]).await
        match selected {
            Outcome.Faulted(error) => {
                assert contains(error.message, "task_resource_selection_test.loom:")
            }
            _ => {
                assert false
            }
        }
        assert length(trace) == 2 && trace[1] == 1
    }
    assert length(trace) == 2
}

test async fn loser_cleanup_failure_also_disposes_the_untransferred_winner() {
    let trace List[Int] = []
    let first = acquire_pair_async(trace, false)
    let second = acquire_pair_async(trace, true)
    while length(trace) < 4 {
        sleep_ms(0).await
    }
    {
        scoped selected = outcome(any([first, second])).await
        match selected {
            Outcome.Faulted(error) => {
                assert contains(error.message, "resource_test.loom:")
            }
            _ => {
                assert false
            }
        }
    }
    assert length(trace) == 10
    assert trace[4] == 3 && trace[5] == 2 && trace[6] == 1
    assert trace[7] == 3 && trace[8] == 2 && trace[9] == 1
}
