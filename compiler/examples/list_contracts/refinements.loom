import std.list.clone
import std.list.length
import std.list.push
import std.result.Result
import std.result.ConstraintError
import std.time.sleep_ms

type Nonempty[T] = List[T] where length(self) > 0

fn singleton[T](value T) Nonempty[T] {
    Nonempty([value])
}

fn copied_nonempty[T](input List[T]) Result[Nonempty[T], ConstraintError] {
    Nonempty(clone(input))
}

fn replace_first[T](values Nonempty[T], value T) {
    values[0] = value
}

fn append_value[T](values Nonempty[T], value T) {
    push(values, value)
}

fn first_nested_value(values List[List[Int]]) Int {
    values[0][0]
}

fn first_value[T](values List[T]) T {
    values[0]
}

fn first[T](values Nonempty[T]) T {
    first_value(values)
}

async fn exercise_generic_extents() {
    let inner = [1]
    let outer = singleton(inner)
    let alias = outer
    inner[0] = -1
    push(inner, 2)
    assert length(outer) == 1
    replace_first(alias, [7, 8, 9])
    append_value(outer, inner)
    sleep_ms(1).await
    assert length(alias) == 2
    let empty List[List[Int]] = []
    assert match copied_nonempty(empty) {
        Result.Ok(_) => false
        Result.Err(_) => true
    }
    let input = [inner]
    assert match copied_nonempty(input) {
        Result.Ok(value) => {
            push(input, [9])
            inner[0] = 7
            assert length(value) == 1
            let row = first(value)
            row[0] = 8
            assert inner[0] == 8
            first_nested_value(value) == 8
        }
        Result.Err(_) => false
    }
}

test async fn generic_extent_constraints_preserve_shared_nested_elements() {
    exercise_generic_extents().await
}

record Account {
    amount Int
    notes List[Int]
}

fn positive_accounts(values List[Account]) Bool {
    var index = 0
    while index < length(values) {
        if values[index].amount <= 0 {
            return false
        }
        index = index + 1
    }
    length(values) > 0
}

type PositiveAccounts = List[Account] where positive_accounts(self)

fn checked_accounts(values List[Account]) Result[PositiveAccounts, ConstraintError] {
    PositiveAccounts(clone(values))
}

fn first_account(values PositiveAccounts) Account {
    values[0]
}

async fn exercise_observed_fields() {
    let notes = [1]
    let input = [Account {
            amount = 10
            notes = notes
        }]
    assert match checked_accounts(input) {
        Result.Ok(values) => {
            input[0] = Account {
                amount = -1
                notes = []
            }
            let row = first_account(values)
            row.notes[0] = -2
            push(notes, 3)
            sleep_ms(1).await
            assert length(values) == 1 && values[0].amount == 10
            notes[0] == -2 && length(row.notes) == 2
        }
        Result.Err(_) => false
    }
    assert match checked_accounts(input) {
        Result.Ok(_) => false
        Result.Err(_) => true
    }
}

test async fn immutable_element_fields_survive_unobserved_shared_updates() {
    exercise_observed_fields().await
}
