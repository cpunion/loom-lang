import std.list.generate
import std.int.to_text

type GeneratedPair[T] = List[T] where length(self) == 2

fn generated_pair[T](create fn(Int) T) GeneratedPair[T] {
    GeneratedPair(generate(2, create))
}

fn generated_count[T](count Int, create fn(Int) T) Int
requires count >= 0
ensures result == count
{
    length(generate(count, create))
}

async fn exercise_generated() {
    let trace = new[Int]()
    let pair = generated_pair(fn(index Int) Text {
            push(trace, index)
            to_text(index)
        })
    assert length(pair) == 2 && get(pair, 0) == "0" && get(pair, 1) == "1"
    assert length(trace) == 2 && trace[0] == 0 && trace[1] == 1
    sleep_ms(1).await
    assert length(pair) == 2 && get(pair, 1) == "1"
    assert generated_count(0, to_text) == 0
    assert generated_count(3, to_text) == 3
}

test async fn source_generation_composes_a_proved_shape_without_runtime_rechecking() {
    exercise_generated().await
}
