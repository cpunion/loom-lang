test fn empty_and_heterogeneous_packs_keep_source_order() {
    let events = labels()
    assert length(events) == 6
    assert events[0] == "arg-1" && events[1] == "arg-2" && events[2] == "arg-3"
    assert events[3] == "42" && events[4] == "text" && events[5] == "boolean"
    let captured = captured_labels(7, "captured", true)
    assert captured[0] == "7" && captured[1] == "captured" && captured[2] == "boolean"
    let tuple = tuple_labels((9, true))
    assert tuple[0] == "9" && tuple[1] == "boolean" && tuple[2] == "local" && tuple[3] == "7"
}

test fn nested_tuple_iterations_keep_distinct_closure_captures() {
    let outer = (1, 2)
    let inner = (10, 20)
    var total = 0
    comptime for left in outer {
        comptime for right in inner {
            let read = fn() Int {
                left + right
            }
            total = total + read()
        }
    }
    assert total == 66
}

fn nested_pack_closures[Ts...Label](output List[Text], values Ts...) {
    comptime for outer in values {
        let inner = (0,)
        comptime for item in inner {
            discard item
            let closure = fn() Text {
                outer.label()
            }
            push(output, closure())
        }
    }
}

test fn tuple_loop_inside_pack_keeps_outer_closure_identity() {
    let output List[Text] = []
    nested_pack_closures(output, 7, true)
    assert length(output) == 2
    assert output[0] == "7" && output[1] == "boolean"
}

fn nested_tuple_closures(output List[Text], values (Int, Bool)) {
    comptime for outer in values {
        let inner = (0,)
        comptime for item in inner {
            discard item
            let closure = fn() Text {
                outer.label()
            }
            push(output, closure())
        }
    }
}

test fn nested_tuple_loops_keep_outer_closure_identity() {
    let output List[Text] = []
    nested_tuple_closures(output, (7, true))
    assert length(output) == 2
    assert output[0] == "7" && output[1] == "boolean"
}

fn count_int_types[Ts...](values Ts...) Int {
    var total = 0
    comptime for T in Ts {
        comptime if T == Int {
            total = total + 1
        }
    }
    total
}

fn type_callbacks[Ts...](values Ts...) {
    let callbacks = comptime map T in Ts {
        let T = 10
        fn(value T) Int {
            discard value
            T
        }
    }
    assert callbacks.0(values.0) == 10
    assert callbacks.1(values.1) == 10
}

fn crossed_type_and_value_packs[Ts...](values Ts...) Int {
    var total = 0
    comptime for T in Ts {
        comptime for value in values {
            discard value
            let reader = fn() Int {
                comptime if T == Int {
                    1
                } else {
                    0
                }
            }
            total = total + reader()
        }
    }
    total
}

fn nested_type_binding[Ts...](values Ts...) Int {
    var total = 0
    comptime for T in Ts {
        comptime for T in Ts {
            comptime if T == Int {
                total = total + 1
            }
        }
    }
    total
}

test fn selected_type_pack_iteration_uses_only_static_structure() {
    assert count_int_types() == 0
    assert count_int_types(1, true, 2, "text") == 2
    type_callbacks(7, true)
    assert crossed_type_and_value_packs(7, true) == 2
    assert nested_type_binding(7, true) == 2
}
