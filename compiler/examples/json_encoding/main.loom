import std.json.encode
import std.json.decode
import std.json.DecodeError
import std.json.parse
import std.json.Value
import std.json.WriteError
import std.result.Result

pub record Order {
    id Int
    items List[Text]
    total Money
}

pub type Money = Float where self >= 0.0

pub record InputOrder {
    id Int
    items List[Text]
    total Float
}

record Secret {
    password Text
}

fn example() {
    let order = Order {
        total = Money(12.5)
        items = ["tea", "cake"]
        id = 42
    }
    let text = match encode(order) {
        Result.Ok(value) => value
        Result.Err(_) => {
            assert false
            ""
        }
    }
    assert text == """
        {"id":42,"items":["tea","cake"],"total":12.5}
        """
    match parse(text) {
        Result.Ok(Value.Object(_)) => {
        }
        _ => {
            assert false
        }
    }
    let decoded = match decode[InputOrder](text) {
        Result.Ok(value) => value
        Result.Err(_) => {
            assert false
            InputOrder {
                id = 0,
                items = [],
                total = 0.0
            }
        }
    }
    assert decoded.id == order.id && decoded.items[1] == "cake" && decoded.total == 12.5
    // JSON does not bypass constrained construction; validate at that boundary.
    match decode[Order](text) {
        Result.Err(DecodeError.UnsupportedType) => {
        }
        _ => {
            assert false
        }
    }
    // A foreign library cannot expose a private application's record fields.
    match encode(Secret {
            password = "hidden"
        }) {
        Result.Err(WriteError.UnsupportedType) => {
        }
        _ => {
            assert false
        }
    }
    match decode[Secret]("""
        {"password":"hidden"}
        """) {
        Result.Err(DecodeError.UnsupportedType) => {
        }
        _ => {
            assert false
        }
    }
}

fn main() {
    example()
}

test fn encode_public_record_without_runtime_reflection() {
    example()
}
