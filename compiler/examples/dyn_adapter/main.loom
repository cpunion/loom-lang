import std.text.concat

concept Source {
    fn value(self Self) Int
}

concept Readable {
    fn read(self Self) Int
}

concept Numbered {
    type Value
    fn number(self Self) Self.Value
}

impl Source for Int {
    fn value(self Int) Int {
        self
    }
}

record Labeled {
    label Text
}

impl Source for Labeled {
    fn value(self Labeled) Int {
        if self.label == "hello" {
            42
        } else {
            0
        }
    }
}

record ReadableView {
    source dyn Source
}

impl Readable for ReadableView {
    fn read(self ReadableView) Int {
        self.source.value()
    }
}

// A second explicit adapter can target the erased source type directly.
// Its witness wraps dyn Source; it never asks for the hidden concrete type.
impl Numbered for dyn Source {
    type Value = Int
    fn number(self dyn Source) Int {
        self.value()
    }
}

// Explicit source adapter: the target evidence belongs to ReadableView.
// The hidden concrete type inside dyn Source is never discovered at runtime.
fn as_readable(source dyn Source) dyn Readable {
    ReadableView {
        source = source
    }
}

test fn adapted_dynamic_value() {
    let source dyn Source = 42
    let readable = as_readable(source)
    assert readable.read() == 42
    let numbered dyn Numbered[Value = Int] = source
    assert numbered.number() == 42
}

test fn nested_erased_payload_survives_moving_gc() {
    let source dyn Source = Labeled {
        label = concat("hel", "lo")
    }
    let numbered dyn Numbered[Value = Int] = source
    var index = 0
    while index < 64 {
        discard concat("temporary", " text")
        index = index + 1
    }
    assert numbered.number() == 42
}

fn main() {
    let source dyn Source = 41
    assert as_readable(source).read() == 41
    let numbered dyn Numbered[Value = Int] = source
    assert numbered.number() == 41
}
