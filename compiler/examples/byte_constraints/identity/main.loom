import std.bytes.is_utf8
import std.bytes.clone
import std.bytes.decode_utf8
import std.bytes.new
import std.bytes.push
import std.list.clone
import std.list.length
import std.list.push
import std.text.to_bytes
import std.result.Result
import std.result.ConstraintError

fn checksum(values List[Int]) Int {
    var total = 0
    var index = 0
    while index < length(values) {
        total = total * 31 + values[index]
        index = index + 1
    }
    total
}

type Checked = List[Int] where checksum(self) == 7

type Utf8 = Bytes where is_utf8(self)

fn checked_numbers(input List[Int]) Result[Checked, ConstraintError] {
    Checked(clone(input))
}

fn checked_text(input Bytes) Result[Utf8, ConstraintError] {
    Utf8(clone(input))
}

fn copied_through_scratch(input Int) Int
ensures result == input
{
    let scratch List[Int] = []
    push(scratch, input)
    let containers = [scratch]
    let alias = containers[0]
    alias[0] = 0
    scratch[0] = input
    alias[0]
}

fn copied_through_bytes(input Int) Int
ensures result == input
{
    let scratch = new()
    push(scratch, input)
    scratch[0] = 0
    scratch[0] = input
    scratch[0]
}

fn unchanged_numbers(value Checked) {
    value[0] = {
        let saved = value[0]
        saved + 0
    }
    value[0] = copied_through_scratch(value[0])
    value[0] = {
        let action = copied_through_scratch
        action(value[0])
    }
}

fn unchanged_text(value Utf8) {
    value[0] = {
        let saved = value[0]
        saved + 0
    }
    value[0] = copied_through_scratch(value[0])
    value[0] = copied_through_bytes(value[0])
    value[0] = {
        let action = copied_through_bytes
        action(value[0])
    }
}

fn main() {
    match checked_numbers([7]) {
        Result.Ok(value) => {
            unchanged_numbers(value)
            assert value[0] == 7
        }
        Result.Err(_) => {
            assert false
        }
    }
    match checked_text(to_bytes("hé")) {
        Result.Ok(value) => {
            unchanged_text(value)
            assert match decode_utf8(value) {
                Result.Ok(text) => text == "hé"
                Result.Err(_) => false
            }
        }
        Result.Err(_) => {
            assert false
        }
    }
}
