import std.task.all
import std.task.settled
import std.task.any
import std.task.race
import std.task.Outcome
import std.time.sleep_ms
import std.list.new
import std.list.length
import std.list.transfer.append
import std.env.get
import std.int.parse
import std.option.Option
import std.result.Result
import std.io.write_text
import std.resource.Dispose
import std.resource.MustScope
import std.list.push

async fn item(value Int) Int {
    sleep_ms(value % 3).await
    value
}

async fn label() Text {
    "ready"
}

record Lease {
    id Int
    closed List[Int]
}

impl MustScope for Lease {
}

impl Dispose for Lease {
    fn dispose(self Lease) {
        push(self.closed, self.id)
    }
}

async fn lease(id Int, closed List[Int]) Lease {
    sleep_ms(0).await
    Lease {
        id = id
        closed = closed
    }
}

fn start(count Int) List[Task[Int]] {
    var tasks = new[Task[Int]]()
    var index = 0
    while index < count {
        tasks = append(tasks, item(index))
        index = index + 1
    }
    tasks
}

fn count() Int {
    match get("LOOM_TASK_COUNT") {
        Result.Ok(found) => {
            match found {
                Option.Some(text) => {
                    match parse(text) {
                        Result.Ok(value) => {
                            assert value >= 0 && value <= 1000
                            value
                        }
                        _ => {
                            assert false
                            0
                        }
                    }
                }
                Option.None => 5
            }
        }
        _ => 5
    }
}

async fn main() {
    let closed List[Int] = []
    {
        scoped values = all((lease(1, closed), label(), lease(2, closed))).await
        assert values.0.id == 1 && values.1 == "ready" && values.2.id == 2
        assert length(closed) == 0
    }
    assert length(closed) == 2 && closed[0] == 2 && closed[1] == 1
    let number, text, _ = all((item(7), label(), sleep_ms(0))).await
    assert number == 7 && text == "ready"
    let first, second = settled((item(8), label())).await
    match first {
        Outcome.Completed(value) => {
            assert value == 8
        }
        _ => {
            assert false
        }
    }
    match second {
        Outcome.Completed(value) => {
            assert value == "ready"
        }
        _ => {
            assert false
        }
    }
    assert any(item(7), item(8)).await >= 7
    match race(item(1), item(2)).await {
        Outcome.Completed(value) => {
            assert value == 1 || value == 2
        }
        _ => {
            assert false
        }
    }
    let count = count()
    let values = all(start(count)).await
    let outcomes = settled(start(count)).await
    assert length(values) == count && length(outcomes) == count
    var index = 0
    while index < count {
        assert values[index] == index
        match outcomes[index] {
            Outcome.Completed(value) => {
                assert value == index
            }
            _ => {
                assert false
            }
        }
        index = index + 1
    }
    if count > 0 {
        let winner = any(start(count)).await
        assert winner >= 0 && winner < count
        match race(start(count)).await {
            Outcome.Completed(value) => {
                assert value >= 0 && value < count
            }
            _ => {
                assert false
            }
        }
    }
    discard write_text("joins finished\n")
}
