module lcir_async_cleanup

import std.resource.Dispose
import std.resource.MustScope

record Resource {
    value Int
}

impl Dispose for Resource {
    method dispose(mut self) {
        assert self.value == 7
        self.value = 0
    }
}

impl MustScope for Resource {}

async fn delayed(value Int) Int {
    Task.sleep(1).await
    value
}

async fn normalCleanup() Int {
    var order = 0
    {
        defer {
            order = order * 10 + 1
        }
        defer {
            order = order * 10 + 2
        }
        let value = delayed(7).await
        assert value == 7
        Unit
    }
    order
}

async fn scopedCleanup() {
    {
        scoped resource = Resource { value = 7 }
        Task.sleep(1).await
        assert resource.value == 7
        Unit
    }
}

async fn failsAfterSuspension() {
    Task.sleep(0).await
    assert false
}

async fn waitsWithCleanup(marker Int) {
    defer {
        assert marker == 2
        Unit
    }
    Task.sleep(100).await
}

pub async fn faultCleanupMain() {
    let marker = 1
    defer {
        assert marker == 2
        Unit
    }
    failsAfterSuspension().await
}

pub async fn cancellationMain() {
    let failed, waited = Task.all(failsAfterSuspension(), waitsWithCleanup(1)).await
    discard failed
    discard waited
}

async fn exercise() {
    let order = normalCleanup().await
    assert order == 21
    scopedCleanup().await
}

pub async fn main() {
    exercise().await
}

test async fn cleanupAcrossSuspension() {
    exercise().await
}
