record Envelope {
    text Text
    flag Bool
}

type Label = Text where true
type Packet = Bytes where true

fn impossible() {
    impossible()
}

async fn allocationPressure() Bool {
    var allocated = "x"
    for index in 0..17 {
        discard index
        allocated = allocated.concat(allocated)
    }
    allocated.length() == 131072
}

async fn echoText(value Text) Text {
    value
}

async fn echoLabel(value Label) Label {
    Task.sleep(0).await
    value
}

async fn echoPacket(value Packet) Packet {
    Task.sleep(0).await
    value
}

fn revealLabel(value Label) Text {
    value
}

fn revealPacket(value Packet) Bytes {
    value
}

async fn echoEnvelope(value Envelope) Envelope {
    value
}

async fn echoInt(value Int) Int {
    value
}

async fn precreatedChildren() Bool {
    let first = echoInt(20)
    let second = echoInt(22)
    let left = first.await
    let right = second.await
    left == 20 && right == 22
}

pub async fn main() {
    let marker = "typed ".concat("root")
    let label = Label("typed ".concat("root"))
    let packet = Packet("loom".encode_utf8())
    let observed = allocationPressure().await
    let immediateReady = precreatedChildren().await
    let echoed = echoText(marker).await
    let revealedLabel = revealLabel(echoLabel(label).await)
    let packetLength = revealPacket(echoPacket(packet).await).length()
    let envelope = echoEnvelope(Envelope { text = echoed, flag = observed && immediateReady }).await
    if envelope.flag && envelope.text == "typed root" && revealedLabel == "typed root" && packetLength == 4 {
        Unit
    } else {
        impossible()
    }
}
