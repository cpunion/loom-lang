module lcir_projected_places

record Cell { value Int }

record Pair {
    left Cell
    right Cell
}

record Holder {
    pair Pair
    enabled Bool
}

impl Cell {
    method set(mut self, next Int) Int {
        self.value = next
        self.value
    }

    method setAndKeep[T](mut self, next Int, value T) T {
        self.value = next
        value
    }
}

impl Holder {
    method setEnabled(mut self, next Bool) {
        self.enabled = next
    }
}

fn nestedSibling() Holder {
    var holder = Holder {
        pair = Pair {
            left = Cell { value = 1 },
            right = Cell { value = 2 },
        },
        enabled = false,
    }
    discard holder.pair.left.set(holder.pair.right.set(12))
    let kept = holder.pair.right.setAndKeep(17, true)
    holder.setEnabled(kept)
    holder
}

fn looped(size Int) Holder {
    var holder = Holder {
        pair = Pair {
            left = Cell { value = 9 },
            right = Cell { value = 20 },
        },
        enabled = true,
    }
    for index in 0..size {
        discard holder.pair.left.set(index)
        Unit
    }
    holder
}

pub fn projectedResult() Int {
    let nested = nestedSibling()
    let loopResult = looped(4)
    if nested.pair.left.value == 12 && nested.pair.right.value == 17 && nested.enabled && loopResult.pair.left.value == 3 && loopResult.pair.right.value == 20 && loopResult.enabled {
        42
    } else {
        0
    }
}

pub fn crossTarget() {
    discard projectedResult()
}

fn verify() {
    if projectedResult() == 42 {
        Unit
    } else {
        discard 1 / 0
        Unit
    }
}

pub fn main() {
    verify()
}

test fn projectedPlaces() {
    verify()
}
