module lcir_typed_textmap

enum Problem { WrongValue }

record Pair {
    label Text
    count Int
}

enum Choice {
    Number(Int)
    Label(Text)
    Pairing(Pair)
}

fn join(left Text, right Text) Text { left.concat(right) }

fn verdict(condition Bool) Result[Unit, Problem] {
    if condition { Ok(Unit) } else { Err(Problem.WrongValue) }
}

fn intEntry(map TextMap[Int], index Int, expectedKey Text, expectedValue Int) Bool {
    match map.entry_at(index) {
        Some(entry) => {
            let key, value = entry
            key == expectedKey && value == expectedValue
        }
        None => false
    }
}

fn noIntEntry(map TextMap[Int], index Int) Bool {
    match map.entry_at(index) { None => true, Some(_) => false }
}

fn pairEntry(map TextMap[Pair], index Int) Bool {
    match map.entry_at(index) {
        Some(entry) => {
            let key, value = entry
            key == "pair" && value.label == "Pair" && value.count == 7
        }
        None => false
    }
}

fn verify() Result[Unit, Problem] {
    let empty = TextMap[Int]()
    let first = empty.insert("z", 9)
    let alias = first
    let ordered = first.insert("a", 1)
    let orderedFirst = ordered.entry_at(0)
    let replaced = ordered.insert("z", 10)
    let reverse_order = TextMap[Int]().insert("a", 1).insert("z", 9)
    let missing_removed = ordered.remove("missing")
    let existing_removed = ordered.remove("z")
    let last_removed = first.remove("z")
    let middle_source = TextMap[Int]().insert("z", 3).insert("m", 2).insert("a", 1)
    let middle_removed = middle_source.remove("m")
    let units = TextMap[Unit]().insert("z", Unit).insert("a", Unit)
    let same_units = TextMap[Unit]().insert("a", Unit).insert("z", Unit)

    let text = TextMap[Text]().insert("name", join("Lo", "om"))
    let pair = Pair { label = join("Pa", "ir"), count = 7 }
    let pairs = TextMap[Pair]().insert("pair", pair)
    let choices = TextMap[Choice]().insert("number", Choice.Number(12)).insert(
    "label",
    Choice.Label(join("Ty", "ped"))
    ).insert("pair", Choice.Pairing(pair))
    let lists = TextMap[List[Text]]().insert("items", [join("Nes", "ted"), "List"])
    let inner = TextMap[Int]().insert("answer", 42)
    let nested = TextMap[TextMap[Int]]().insert("inner", inner)

    var moving = TextMap[Pair]().insert(
    "drop",
    Pair { label = join("Re", "move"), count = -1 }
    ).insert("moving", Pair { label = join("Mo", "ved"), count = 0 })
    for index in 0..2048 {
        moving = moving.remove("drop")
        moving = moving.insert(
        "drop",
        Pair { label = join("Re", "move"), count = index }
        ).insert(
        "moving",
        Pair { label = join("Mo", "ved"), count = index }
        )
        Unit
    }
    let moving_alias = moving
    let moved_remove = moving.remove("drop")
    let moved_missing = moved_remove.remove("missing")

    verdict(
    empty.length() == 0
    && first.length() == 1
    && ordered.length() == 2
    && replaced.length() == 2
    && alias.length() == 1
    && empty.contains("missing") == false
    && ordered.contains("a")
    && ordered.contains("z")
    && ordered.contains("missing") == false
    && ordered == reverse_order
    && ordered != replaced
    && missing_removed == ordered
    && existing_removed.length() == 1
    && existing_removed.contains("a")
    && existing_removed.contains("z") == false
    && last_removed.length() == 0
    && last_removed == empty
    && middle_removed.length() == 2
    && middle_removed.contains("a")
    && middle_removed.contains("m") == false
    && middle_removed.contains("z")
    && units == same_units
    && alias.contains("z")
    && match alias.get("z") { Some(value) => value == 9, None => false }
    && match ordered.get("a") { Some(value) => value == 1, None => false }
    && match replaced.get("z") { Some(value) => value == 10, None => false }
    && match replaced.get("missing") { None => true, Some(_) => false }
    && match orderedFirst { Some(_) => true, None => false }
    && intEntry(ordered, 0, "a", 1)
    && intEntry(ordered, 1, "z", 9)
    && intEntry(replaced, 1, "z", 10)
    && noIntEntry(empty, 0)
    && noIntEntry(ordered, -1)
    && noIntEntry(ordered, 2)
    && match text.get("name") { Some(value) => value == "Loom", None => false }
    && match pairs.get("pair") {
        Some(value) => value.label == "Pair" && value.count == 7,
        None => false
    }
    && pairEntry(pairs, 0)
    && match choices.get("number") {
        Some(Choice.Number(value)) => value == 12,
        _ => false
    }
    && match choices.get("label") {
        Some(Choice.Label(value)) => value == "Typed",
        _ => false
    }
    && match choices.get("pair") {
        Some(Choice.Pairing(value)) => value.label == "Pair" && value.count == 7,
        _ => false
    }
    && match lists.get("items") {
        Some(value) => value.length() == 2 && match value.get(0) {
            Some(item) => item == "Nested",
            None => false
        },
        None => false
    }
    && match nested.get("inner") {
        Some(value) => match value.get("answer") {
            Some(answer) => answer == 42,
            None => false
        },
        None => false
    }
    && text == TextMap[Text]().insert("name", "Loom")
    && pairs == TextMap[Pair]().insert(
        "pair",
        Pair { label = "Pair", count = 7 }
    )
    && choices == TextMap[Choice]().insert(
        "pair",
        Choice.Pairing(pair)
    ).insert("label", Choice.Label("Typed")).insert("number", Choice.Number(12))
    && lists == TextMap[List[Text]]().insert("items", ["Nested", "List"])
    && nested == TextMap[TextMap[Int]]().insert(
        "inner",
        TextMap[Int]().insert("answer", 42)
    )
    && moving_alias.length() == 2
    && moving_alias.contains("drop")
    && moved_remove.length() == 1
    && moved_remove.contains("drop") == false
    && moved_missing == moved_remove
    && match moved_remove.get("moving") {
        Some(value) => value.label == "Moved" && value.count == 2047,
        None => false
    }
    )
}

pub fn main() {
    match verify() {
        Ok(_) => Unit
        Err(_) => {
            assert false
            Unit
        }
    }
}

test fn typedTextMap() Result[Unit, Problem] { verify() }
