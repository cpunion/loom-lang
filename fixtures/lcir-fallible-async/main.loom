module lcir_fallible_async

enum Problem { Wrong }

fn checkedDivide(value Int, divisor Int) Int {
    value / divisor
}

fn selectOutcome(value Text, succeeds Bool) Result[Text, Problem] {
    if succeeds { Ok(value) } else { Err(Problem.Wrong) }
}

async fn outcome(value Text, succeeds Bool) Result[Text, Problem] {
    let selected = selectOutcome(value, succeeds)
    var pressure = "y"
    for index in 0..17 {
        discard index
        pressure = pressure.concat(pressure)
    }
    let pressureLength = pressure.length()
    assert pressureLength == 131072
    selected
}

async fn checkedAnswer(value Int, divisor Int) Int
    requires divisor != 0
    ensures result == 42
{
    var pressure = "x"
    for index in 0..17 {
        discard index
        pressure = pressure.concat(pressure)
    }
    let pressureLength = pressure.length()
    assert pressureLength == 131072
    checkedDivide(value, divisor)
}

async fn verify() Bool {
    let marker = "typed".concat(" result")
    let completedTask = outcome(marker, true)
    let rejectedTask = outcome("inactive", false)
    let relocationTask = checkedAnswer(84, 2)
    let completed = completedTask.await
    let rejected = rejectedTask.await
    let relocatedAnswer = relocationTask.await
    let answer = checkedAnswer(84, 2).await
    match completed {
        Ok(value) => match rejected {
            Ok(_) => false
            Err(_) => {
                let decorated = marker.concat("!")
                let duplicated = marker.concat(marker)
                decorated == "typed result!" &&
                    duplicated == "typed resulttyped result" &&
                    value == "typed result" &&
                    relocatedAnswer == 42 && answer == 42
            }
        }
        Err(_) => false
    }
}

pub async fn main() {
    let valid = verify().await
    assert valid
}

test async fn fallibleTaskAndResult() Result[Unit, Problem] {
    if verify().await {
        Ok(Unit)
    } else {
        Err(Problem.Wrong)
    }
}
