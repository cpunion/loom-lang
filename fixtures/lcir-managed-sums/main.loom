enum Problem { WrongText }

record Pair {
    left Text
    right Text
}

enum Envelope { Wrapped(Text) }

concept ReplaceSum {
    method replaceSum(mut self, fail Bool)
}

impl ReplaceSum for Envelope {
    method replaceSum(mut self, fail Bool) {
        self = Envelope.Wrapped("Keep")
        assert !fail
    }
}

impl ReplaceSum for Option[Text] {
    method replaceSum(mut self, fail Bool) {
        self = Some("Keep")
        assert !fail
    }
}

impl ReplaceSum for Result[Pair, Problem] {
    method replaceSum(mut self, fail Bool) {
        self = Ok(Pair { left = "Keep", right = "Keep" })
        assert !fail
    }
}

enum Nested {
    Optional(Option[Text])
    Outcome(Result[Pair, Problem])
    Alias(Text, Text)
}

enum Plain {
    One(Int)
    Empty
}

record Holder { state Nested }

fn join(left Text, right Text) Text { left.concat(right) }

fn collectPressure() Text { join("small", "pressure") }

fn retainContract(input Option[Text], pressure Text) Option[Text]
    requires match input {
        Some("Keep") => true
        Some(_) => false
        None => false
    }
    ensures match result {
        Some(current) => match old(input) {
            Some(previous) => current == previous
            None => false
        }
        None => false
    }
{
    discard pressure.length()
    input
}

fn retainOption(input Option[Text], takeInput Bool) Option[Text] {
    let fallback = Some("Fallback")
    let selected = if takeInput { input } else { fallback }
    let pressure = collectPressure()
    discard pressure.length()
    selected
}

fn retainResult(input Result[Pair, Problem]) Result[Pair, Problem] {
    let pressure = collectPressure()
    discard pressure.length()
    input
}

fn retainEnvelope(input Envelope) Envelope {
    let pressure = collectPressure()
    discard pressure.length()
    input
}

fn retainNested(input Nested, takeInput Bool) Nested {
    let fallback = Nested.Alias("Fallback", "Fallback")
    let selected = if takeInput { input } else { fallback }
    let pressure = collectPressure()
    discard pressure.length()
    selected
}

impl Holder {
    method relocate(mut self) {
        self.state = retainNested(self.state, true)
    }
}

fn optionText(input Option[Text]) Text {
    let pressure = collectPressure()
    discard pressure.length()
    match input {
        Some(text) => text
        None => "Missing"
    }
}

fn resultPair(input Result[Pair, Problem]) Pair {
    let pressure = collectPressure()
    discard pressure.length()
    match input {
        Ok(pair) => pair
        Err(_) => Pair { left = "Missing", right = "Missing" }
    }
}

fn envelopeText(input Envelope) Text {
    let pressure = collectPressure()
    discard pressure.length()
    match input {
        Wrapped(text) => text
    }
}

fn nestedPair(input Nested) Pair {
    let pressure = collectPressure()
    discard pressure.length()
    match input {
        Optional(Some(text)) => Pair { left = text, right = text }
        Optional(None) => Pair { left = "Missing", right = "Missing" }
        Outcome(Ok(pair)) => pair
        Outcome(Err(_)) => Pair { left = "Missing", right = "Missing" }
        Alias(left, right) => Pair { left = left, right = right }
    }
}

fn pointerFree(input Plain) Int {
    let pressure = collectPressure()
    discard pressure.length()
    match input {
        One(number) => number
        Empty => 0
    }
}

fn initialPairResult() Result[Pair, Problem] { Err(Problem.WrongText) }

fn verifyMutableSumReceivers() Bool {
    var envelope = Envelope.Wrapped("Before")
    var optional = Some("Before")
    var outcome = initialPairResult()
    envelope.replaceSum(false)
    optional.replaceSum(false)
    outcome.replaceSum(false)
    let envelopeMatches = envelopeText(envelope) == "Keep"
    let optionMatches = optionText(optional) == "Keep"
    let pair = resultPair(outcome)
    envelopeMatches && optionMatches && pair.left == "Keep" && pair.right == "Keep"
}

fn verify() Result[Unit, Problem] {
    let kept = join("K", "eep")
    let contracted = retainContract(Some(kept), collectPressure())
    let fromContract = optionText(contracted)
    let optional = retainOption(Some(kept), true)
    let fromOption = optionText(optional)
    let outcome = retainResult(Ok(Pair { left = kept, right = kept }))
    let fromResult = resultPair(outcome)
    let envelope = retainEnvelope(Envelope.Wrapped(kept))
    let fromEnvelope = envelopeText(envelope)
    var holder = Holder { state = Nested.Alias(kept, kept) }
    holder.relocate()
    let fromAlias = nestedPair(holder.state)
    let fromNestedOption = nestedPair(retainNested(Nested.Optional(Some(kept)), true))
    let fromNestedResult = nestedPair(retainNested(Nested.Outcome(Ok(Pair { left = kept, right = kept })), true))
    if fromContract == "Keep" && fromOption == "Keep" && fromResult.left == "Keep" && fromResult.right == "Keep" && fromEnvelope == "Keep" && fromAlias.left == "Keep" && fromAlias.right == "Keep" && fromNestedOption.left == "Keep" && fromNestedOption.right == "Keep" && fromNestedResult.left == "Keep" && fromNestedResult.right == "Keep" && pointerFree(Plain.One(42)) == 42 && verifyMutableSumReceivers() {
        Ok(Unit)
    } else {
        Err(Problem.WrongText)
    }
}

fn verdict(condition Bool) Result[Unit, Problem] {
    if condition { Ok(Unit) } else { Err(Problem.WrongText) }
}

pub fn main() {
    discard verify()
}
