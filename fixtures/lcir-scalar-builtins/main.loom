module lcir_scalar_builtins

import standard.float.format_float
import standard.float.is_finite
import standard.float.parse_float
import standard.int.parse_int
import standard.time.milliseconds

fn parsedIntEquals(input Text, expected Int) Bool {
    match parse_int(input) {
        Ok(value) => value == expected
        Err(_) => false
    }
}

fn parsedFloatEquals(input Text, expected Float) Bool {
    match parse_float(input) {
        Ok(value) => value == expected
        Err(_) => false
    }
}

fn scalarBuiltins() Unit {
    let managedDigits = "9".concat("223372036854775807")
    assert parsedIntEquals(managedDigits, 9223372036854775807)
    assert match parse_int("17x") {
        Err(ParseIntError.InvalidSyntax) => true
        _ => false
    }
    assert match parse_int("9223372036854775808") {
        Err(ParseIntError.OutOfRange) => true
        _ => false
    }

    assert parsedFloatEquals("1.25e2", 125.0)
    assert match parse_float("1") {
        Err(standard.float.ParseFloatError.InvalidSyntax) => true
        _ => false
    }
    assert match parse_float("1e999") {
        Err(standard.float.ParseFloatError.OutOfRange) => true
        _ => false
    }
    assert is_finite(1.25)
    assert !is_finite(1.0 / 0.0)

    let kept = "K".concat("eep")
    let rendered = format_float(1.25)
    assert kept == "Keep"
    assert rendered == "1.25"

    let delay = milliseconds(42)
    assert delay.as_milliseconds() == 42
    Unit
}

pub fn main() Unit {
    scalarBuiltins()
}

test fn typedScalarBuiltins() Unit {
    scalarBuiltins()
}
