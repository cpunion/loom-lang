dyn concept Metric {
    method read(self) Int
    method cold(self) Int
}

dyn concept Advance {
    method advance(mut self) Int
    method store(mut self, value Int) Int
    method storeThenFail(mut self, value Int)
    method read(self) Int
}

record Counter {
    value Int
    label Text
}

record Offset {
    value Int
}

impl Metric for Counter {
    method read(self) Int { self.value }
    method cold(self) Int { 7001 }
}

impl Advance for Counter {
    method advance(mut self) Int {
        self.value = self.value + 1
        self.value
    }

    method store(mut self, value Int) Int {
        self.value = value
        self.value
    }

    method storeThenFail(mut self, value Int) {
        self.value = value
        assert false
    }

    method read(self) Int { self.value }
}

impl Metric for Offset {
    method read(self) Int { self.value + 100 }
    method cold(self) Int { 7002 }
}

impl Advance for Offset {
    method advance(mut self) Int {
        self.value = self.value + 2
        self.value
    }

    method store(mut self, value Int) Int {
        self.value = value
        self.value
    }

    method storeThenFail(mut self, value Int) {
        self.value = value
        assert false
    }

    method read(self) Int { self.value }
}

record Holder {
    item dyn Metric
}

record AdvanceSlot {
    item dyn Advance
}

record AdvanceHolder {
    slot AdvanceSlot
    guard Int
}

impl AdvanceHolder {
    method advanceStored(mut self) Int {
        self.slot.item.advance()
    }
}

record SiblingCell {
    value Int
}

record MutationSlot {
    item dyn Advance
    sibling SiblingCell
}

record MutationHolder {
    slot MutationSlot
    guard Int
}

impl SiblingCell {
    method set(mut self, value Int) Int {
        self.value = value
        self.value
    }
}

fn measure(metric Metric) Int {
    metric.read()
}

fn eraseCounter(value Counter) dyn Metric {
    value
}

fn eraseOffset(value Offset) dyn Metric {
    value
}

fn eraseCounterAdvance(value Counter) dyn Advance {
    value
}

fn eraseOffsetAdvance(value Offset) dyn Advance {
    value
}

fn chooseAdvance(counter Bool, value Int) dyn Advance {
    if counter {
        Counter { value = value, label = "ordered" }
    } else {
        Offset { value = value }
    }
}

fn advanceOne(value Advance) Int {
    value.advance()
}

fn forceRelocation() {
    for index in 0..5000 {
        discard eraseCounter(Counter { value = index, label = "pressure" })
        Unit
    }
}

fn verify() {
    let first = Counter { value = 41, label = "first" }
    let second = Offset { value = 1 }
    let firstValue = measure(first)
    let secondValue = measure(second)
    assert firstValue == 41
    assert secondValue == 101

    let held = Holder { item = first }
    let heldValue = held.item.read()
    assert heldValue == 41

    let values = [
        eraseCounter(first),
        eraseOffset(second),
    ]
    let length = values.length()
    assert length == 2
    match values.get(0) {
        Some(value) => {
            let read = value.read()
            assert read == 41
            Unit
        }
        None => {
            assert false
            Unit
        }
    }

    var source = eraseCounterAdvance(Counter { value = 0, label = "source" })
    var copied = source
    forceRelocation()
    let copiedFirst = advanceOne(copied)
    let copiedSecond = advanceOne(copied)
    let sourceFirst = advanceOne(source)
    assert copiedFirst == 1
    assert copiedSecond == 2
    assert sourceFirst == 1

    var offset = eraseOffsetAdvance(Offset { value = 100 })
    let offsetFirst = advanceOne(offset)
    assert offsetFirst == 102

    var stored = AdvanceHolder {
        slot = AdvanceSlot {
            item = eraseCounterAdvance(Counter { value = 0, label = "stored" }),
        },
        guard = 73,
    }
    var storedCopy = stored
    forceRelocation()
    let storedCopyFirst = storedCopy.advanceStored()
    let storedCopySecond = storedCopy.advanceStored()
    let storedCopyThird = advanceOne(storedCopy.slot.item)
    let storedFirst = stored.advanceStored()
    let storedGuard = stored.guard
    let storedCopyGuard = storedCopy.guard
    assert storedCopyFirst == 1
    assert storedCopySecond == 2
    assert storedCopyThird == 3
    assert storedFirst == 1
    assert storedGuard == 73
    assert storedCopyGuard == 73

    var storedOffset = AdvanceHolder {
        slot = AdvanceSlot {
            item = eraseOffsetAdvance(Offset { value = 100 }),
        },
        guard = 91,
    }
    let storedOffsetFirst = storedOffset.advanceStored()
    let storedOffsetGuard = storedOffset.guard
    assert storedOffsetFirst == 102
    assert storedOffsetGuard == 91

    var ordered = MutationHolder {
        slot = MutationSlot {
            item = chooseAdvance(true, 5),
            sibling = SiblingCell { value = 7 },
        },
        guard = 101,
    }
    let orderedResult = ordered.slot.item.store(ordered.slot.sibling.set(12))
    let orderedItem = ordered.slot.item.read()
    let orderedSibling = ordered.slot.sibling.value
    let orderedGuard = ordered.guard
    assert orderedResult == 12
    assert orderedItem == 12
    assert orderedSibling == 12
    assert orderedGuard == 101
}

pub fn projectedFaultMain() {
    var holder = MutationHolder {
        slot = MutationSlot {
            item = chooseAdvance(true, 1),
            sibling = SiblingCell { value = 2 },
        },
        guard = 103,
    }
    defer {
        let item = holder.slot.item.read()
        let sibling = holder.slot.sibling.value
        let guard = holder.guard
        assert item == 23 && sibling == 23 && guard == 103
    }
    holder.slot.item.storeThenFail(holder.slot.sibling.set(23))
}

pub fn main() {
    verify()
}
