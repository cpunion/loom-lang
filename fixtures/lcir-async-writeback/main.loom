dyn concept Advance {
    method advance(mut self) Int
}

dyn concept Source {
    method next(mut self) Int
    method label(self) Text
}

record Counter {
    value Int
}

record Offset {
    value Int
}

record OwnedCounter {
    value Int
    label Text
}

record ManagedLabel {
    value Text
}

impl Counter {
    method add(mut self, amount Int) Int {
        self.value = self.value + amount
        self.value
    }
}

impl ManagedLabel {
    method append(mut self, suffix Text) Text {
        self.value = self.value.concat(suffix)
        self.value
    }

    method appendThenFail(mut self, suffix Text) {
        self.value = self.value.concat(suffix)
        discard 1 / 0
    }
}

impl Advance for Counter {
    method advance(mut self) Int {
        self.value = self.value + 1
        self.value
    }
}

impl Advance for Offset {
    method advance(mut self) Int {
        self.value = self.value + 2
        self.value
    }
}

impl Source for OwnedCounter {
    method next(mut self) Int {
        self.value = self.value + 1
        self.value
    }

    method label(self) Text {
        self.label
    }
}

fn eraseCounter(value Counter) dyn Advance {
    value
}

fn eraseOffset(value Offset) dyn Advance {
    value
}

async fn allocationPressure() Bool {
    var allocated = "x"
    for index in 0..17 {
        discard index
        allocated = allocated.concat(allocated)
    }
    allocated.length() == 131072
}

async fn takeOwnedSource(source Source) Text {
    let survived = allocationPressure().await
    assert survived
    let next = source.next()
    assert next == 1
    source.label()
}

async fn makeOwnedSource() dyn Source {
    Task.sleep(0).await
    OwnedCounter { value = 4, label = "re".concat("turned") }
}

async fn verifyWriteback() {
    var counter = Counter { value = 1 }
    let before = counter.add(2)
    let beforeStored = counter.value
    assert before == 3
    assert beforeStored == 3

    Task.sleep(0).await

    let after = counter.add(4)
    let afterStored = counter.value
    assert after == 7
    assert afterStored == 7

    var label = ManagedLabel { value = "managed" }
    let appended = label.append(" frame")
    assert appended == "managed frame"
    let survived = allocationPressure().await
    let storedLabel = label.value
    assert survived
    assert storedLabel == "managed frame"

    var first = eraseCounter(Counter { value = 10 })
    var second = eraseOffset(Offset { value = 20 })
    let firstValue = first.advance()
    let secondValue = second.advance()
    assert firstValue == 11
    assert secondValue == 22

    let original = OwnedCounter { value = 0, label = "owned".concat(" source") }
    let observedLabel = takeOwnedSource(original).await
    assert observedLabel == "owned source"
    assert original.value == 0
    assert original.label == "owned source"

    var returned = makeOwnedSource().await
    let returnedValue = returned.next()
    let returnedLabel = returned.label()
    assert returnedValue == 5
    assert returnedLabel == "returned"
}

pub async fn faultWritebackMain() {
    var label = ManagedLabel { value = "fault" }
    defer {
        let cleaned = label.value
        assert cleaned == "fault writeback"
        Unit
    }
    Task.sleep(0).await
    label.appendThenFail(" writeback")
}

async fn completesOnce() {
}

async fn failsAfterSuspension() {
    completesOnce().await
    assert false
}

async fn waitsAfterWriteback() {
    var label = ManagedLabel { value = "ready" }
    let appended = label.append(" cancellation")
    assert appended == "ready cancellation"
    defer {
        let cleaned = label.value
        assert cleaned == "ready cancellation"
        Unit
    }
    completesOnce().await
}

pub async fn cancellationAfterWritebackMain() {
    let failed, waited = Task.all(failsAfterSuspension(), waitsAfterWriteback()).await
    discard failed
    discard waited
}

pub async fn main() {
    verifyWriteback().await
}
