module standard.resource

concept Dispose {
    method dispose(mut self) Unit
}

concept MustScope {}
concept NoSuspend {}

record Resource {
    value Int
}

impl Dispose for Resource {
    method dispose(mut self) Unit {
        assert self.value > 0
        self.value = 0
        Unit
    }
}

impl MustScope for Resource {}

fn requireEqual(actual Int, expected Int) Unit
    requires actual == expected
{
    Unit
}

record Counter {
    value Int
    invariant self.value >= 0
}

impl Counter {
    method replaceAfterCleanup(mut self, target Int) Unit
        requires target >= 0
        ensures old(self.value) == 1
        ensures self.value == target
    {
        self.value = 0
        defer {
            self.value = target
        }
        return Unit
    }
}

fn exercise() Unit {
    var order = 0
    {
        defer {
            order = order * 10 + 1
        }
        defer {
            order = order * 10 + 2
        }
        Unit
    }
    requireEqual(order, 21)

    if true {
        defer {
            order = 34
        }
        Unit
    } else {
        order = 99
        Unit
    }
    requireEqual(order, 34)

    var counter = Counter { value = 1 }
    counter.replaceAfterCleanup(8)
    requireEqual(counter.value, 8)

    scoped resource = Resource { value = 7 }
    Unit
}

pub fn main() Unit
    requires true
    ensures true
{
    exercise()
}

test fn lexicalCleanup() Unit {
    exercise()
}
