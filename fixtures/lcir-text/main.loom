fn identity[T](value T) T { value }

fn score(value Text) Int {
    if value.length() == 6 && value.contains("界") && value == "hello界" && value != "other" {
        42
    } else {
        0
    }
}

fn verify() {
    if score(identity("hello界")) == 42 {
        Unit
    } else {
        discard 1 / 0
        Unit
    }
}

pub fn main() {
    verify()
}
