async fn completedText(label Text) Text {
    label.concat(" completed")
}

async fn faultedText(label Text) Text {
    let length = label.length()
    assert length == 0
    label
}

async fn slowManagedLoser(marker Int) Text {
    defer {
        assert marker == 73
        Unit
    }
    Task.sleep(100).await
    "slow".concat(" loser")
}

async fn fastManagedWinner() Text {
    "fast".concat(" winner")
}

async fn completedUnit() {
}

async fn exerciseSettled() {
    let firstFailure, completed, secondFailure = Task.settled(
    faultedText("first"),
    completedText("middle"),
    faultedText("second")
    ).await

    let firstCode, firstMessage = match firstFailure {
        Completed(_) => {
            assert false
            ("unreachable", "unreachable")
        }
        Faulted(fault) => (fault.code(), fault.message())
        Cancelled => {
            assert false
            ("unreachable", "unreachable")
        }
    }
    let completedValue = match completed {
        Completed(value) => value
        Faulted(_) => {
            assert false
            "unreachable"
        }
        Cancelled => {
            assert false
            "unreachable"
        }
    }
    let secondCode, secondMessage = match secondFailure {
        Completed(_) => {
            assert false
            ("unreachable", "unreachable")
        }
        Faulted(fault) => (fault.code(), fault.message())
        Cancelled => {
            assert false
            ("unreachable", "unreachable")
        }
    }

    assert completedValue == "middle completed"
    assert secondCode == "AssertionFault"
    assert secondMessage == "assertion was not satisfied"

    let laterJoin = Task.settled(
    faultedText("later"),
    completedText("later")
    )
    let laterFailure, laterCompleted = laterJoin.await
    match laterFailure {
        Completed(_) => {
            assert false
            Unit
        }
        Faulted(fault) => {
            let code = fault.code()
            let message = fault.message()
            assert code == "AssertionFault"
            assert message == "assertion was not satisfied"
            Unit
        }
        Cancelled => {
            assert false
            Unit
        }
    }
    match laterCompleted {
        Completed(value) => {
            assert value == "later completed"
            Unit
        }
        Faulted(_) => {
            assert false
            Unit
        }
        Cancelled => {
            assert false
            Unit
        }
    }

    // These managed Text leaves came from the first captured fault. They must
    // remain rooted across the later await and its two outcome-capture
    // safepoints.
    assert firstCode == "AssertionFault"
    assert firstMessage == "assertion was not satisfied"

    let listOutcomes = Task.settled([
    faultedText("list failure"),
    completedText("list success")
    ]).await
    let listLength = listOutcomes.length()
    assert listLength == 2
}

async fn exerciseRace() {
    // Unit has no payload storage. This keeps the zero-sized Task result on
    // the same exact outcome ABI instead of giving it a special source path.
    let unitWinner = Task.race(completedUnit()).await
    match unitWinner {
        Completed(value) => value
        Faulted(_) => {
            assert false
            Unit
        }
        Cancelled => {
            assert false
            Unit
        }
    }

    let completedRace = Task.race(
    slowManagedLoser(73),
    fastManagedWinner()
    )
    let completedWinner = completedRace.await
    match completedWinner {
        Completed(value) => {
            assert value == "fast winner"
            Unit
        }
        Faulted(_) => {
            assert false
            Unit
        }
        Cancelled => {
            assert false
            Unit
        }
    }

    // The first child suspends, so the second child is the deterministic
    // nonzero winner. Finalizing the race cancels and drains the first child,
    // including its registered defer cleanup.
    let faultWinner = Task.race([
    slowManagedLoser(73),
    faultedText("race failure")
    ]).await
    match faultWinner {
        Completed(_) => {
            assert false
            Unit
        }
        Faulted(fault) => {
            let code = fault.code()
            let message = fault.message()
            assert code == "AssertionFault"
            assert message == "assertion was not satisfied"
            Unit
        }
        Cancelled => {
            assert false
            Unit
        }
    }
}

async fn exerciseOutcomes() {
    exerciseSettled().await
    exerciseRace().await
}

pub async fn main() {
    exerciseOutcomes().await
}
