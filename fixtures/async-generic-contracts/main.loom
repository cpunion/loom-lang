module async_generic_contracts

concept Measure {
    method measure(self) Int
}

record Number {
    value Int
}

impl Measure for Number {
    method measure(self) Int { self.value }
}

record Boxed[T] {
    value T
}

impl[T: Measure] Measure for Boxed[T] {
    method measure(self) Int { self.value.measure() }
}

async fn measured[T: Measure](value T, minimum Int) Int
    requires minimum >= 0
    ensures result >= minimum
{
    Task.sleep(1).await
    value.measure() + minimum
}

async fn violatesPostcondition[T: Measure](value T, minimum Int) Int
    ensures result > minimum
{
    Task.sleep(1).await
    value.measure()
}

async fn slow[T: Measure](value T) Int {
    Task.sleep(100).await
    value.measure()
}

async fn fast() Int {
    Task.sleep(1).await
    2
}

test async fn generic_async_contracts_and_cancellation() {
    let success, precondition, postcondition = Task.settled(
        measured(Boxed { value = Number { value = 2 } }, 3),
        measured(Number { value = 2 }, -1),
        violatesPostcondition(Number { value = 1 }, 1)
    ).await

    match success {
        Completed(value) => {
            assert value == 5
            Unit
        }
        Faulted(_) => {
            assert false
            Unit
        }
        Cancelled => {
            assert false
            Unit
        }
    }
    match precondition {
        Completed(_) => {
            assert false
            Unit
        }
        Faulted(fault) => {
            let code = fault.code()
            assert code == "PreconditionFault"
            Unit
        }
        Cancelled => {
            assert false
            Unit
        }
    }
    match postcondition {
        Completed(_) => {
            assert false
            Unit
        }
        Faulted(fault) => {
            let code = fault.code()
            assert code == "PostconditionFault"
            Unit
        }
        Cancelled => {
            assert false
            Unit
        }
    }

    let winner = Task.any(slow(Boxed { value = Number { value = 9 } }), fast()).await
    assert winner == 2
}
