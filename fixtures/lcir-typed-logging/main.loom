import std.log.debug
import std.log.error
import std.log.info
import std.log.LogLevel
import std.log.warn
import std.log.write

fn selectedLevel(useWarn Bool) LogLevel {
    if useWarn { LogLevel.Warn } else { LogLevel.Info }
}

fn emitCanonicalLogs() {
    debug("debug \"line\"")
    info("information")
    warn("warning")
    error("error")
    write(
        selectedLevel(true),
        "event\nline",
        TextMap[Text]().insert("z", "last").insert("a", "first")
    )
}

pub fn main() { emitCanonicalLogs() }
