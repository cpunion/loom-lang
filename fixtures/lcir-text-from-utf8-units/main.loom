fn requireText(units List[Int], expected Text) {
    match Text.from_utf8_units(units) {
        Ok(value) => { assert value == expected }
        Err(InvalidUtf8) => { assert false }
    }
}

fn requireInvalid(units List[Int]) {
    match Text.from_utf8_units(units) {
        Err(InvalidUtf8) => {}
        Ok(_) => { assert false }
    }
}

fn verifyUtf8Units() {
    requireText(List[Int](), "")
    requireText([65, 231, 149, 140, 240, 159, 153, 130], "A界🙂")
    requireInvalid([-1])
    requireInvalid([256])
    requireInvalid([195, 40])
}

fn verifyMovingSource() {
    let units = [65, 231, 149, 140, 240, 159, 153, 130]
    let retained = units
    for index in 0..4096 {
        requireText(units, "A界🙂")
        assert index >= 0
    }
    let retainedLength = retained.length()
    assert retainedLength == 8
    match retained.get(7) {
        Some(value) => { assert value == 130 }
        None => { assert false }
    }
}

pub fn main() {
    verifyUtf8Units()
    verifyMovingSource()
}
