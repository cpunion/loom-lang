import std.float.__from_int
import std.float.__format
import std.float.__is_finite
import std.float.__parse
import std.float.__to_int

/// Describes why Text cannot be parsed as a Float.
pub enum ParseFloatError {
    InvalidSyntax
    OutOfRange
}

/// Describes why a Float cannot be represented as an Int.
pub enum FloatToIntError {
    NonFinite
    OutOfRange
}

/// Converts Int to IEEE-754 binary64 using round-to-nearest, ties-to-even.
pub fn from_int(value Int) Float {
    __from_int(value)
}

/// Truncates Float toward zero when the result is representable as Int.
pub fn to_int(value Float) Result[Int, FloatToIntError] {
    let converted, status = __to_int(value)
    if status == 0 {
        return Ok(converted)
    }
    if status == 1 {
        return Err(FloatToIntError.NonFinite)
    }
    Err(FloatToIntError.OutOfRange)
}

/// Parses the complete Text value as an IEEE-754 binary64 Float.
pub fn parse_float(text Text) Result[Float, ParseFloatError] {
    let value, status = __parse(text)
    if status == 0 {
        return Ok(value)
    }
    if status == 1 {
        return Err(ParseFloatError.InvalidSyntax)
    }
    Err(ParseFloatError.OutOfRange)
}

/// Formats a Float as its shortest round-tripping decimal representation.
pub fn format_float(value Float) Text {
    __format(value)
}

/// Reports whether a Float is neither infinite nor NaN.
pub fn is_finite(value Float) Bool {
    __is_finite(value)
}
