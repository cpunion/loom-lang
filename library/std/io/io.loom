import std.io.__write_stdout

/// Describes a recoverable operating-system I/O failure.
pub enum IoErrorKind {
    NotFound
    PermissionDenied
    AlreadyExists
    InvalidInput
    ConnectionRefused
    ConnectionReset
    TimedOut
    UnexpectedEof
    Closed
    Other
}

/// A recoverable operating-system I/O failure produced by fallible I/O operations.
/// Its fields are ordinary values and may also be read through the convenience methods.
pub record IoError {
    kind IoErrorKind
    message Text
}

impl IoError {
    /// Returns the stable category of this I/O failure.
    pub method kind(self) IoErrorKind {
        self.kind
    }

    /// Returns the platform-provided detail for this I/O failure.
    pub method message(self) Text {
        self.message
    }
}

/// Writes Text to the process standard-output stream without adding a delimiter.
pub fn write(text Text) {
    __write_stdout(text)
}

/// Writes Text followed by one line-feed to the process standard-output stream.
pub fn write_line(text Text) {
    __write_stdout(text.concat("\n"))
}
