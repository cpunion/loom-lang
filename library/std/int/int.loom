/// Describes why a complete decimal Int spelling could not be parsed.
pub enum ParseIntError {
    InvalidSyntax
    OutOfRange
}

/// Returns the smaller of two Int values.
pub fn minimum(left Int, right Int) Int {
    if left < right { left } else { right }
}

/// Returns the larger of two Int values.
pub fn maximum(left Int, right Int) Int {
    if left > right { left } else { right }
}

/// Parses one complete decimal Int spelling.
pub fn parse_int(text Text) Result[Int, ParseIntError] {
    let bytes = text.encode_utf8()
    let length = bytes.length()
    if length == 0 {
        return Err(ParseIntError.InvalidSyntax)
    }

    let first = match bytes.get(0) {
        Some(value) => value
        None => { return Err(ParseIntError.InvalidSyntax) }
    }
    let negative = first == 45
    let start = if negative || first == 43 { 1 } else { 0 }
    if start == length {
        return Err(ParseIntError.InvalidSyntax)
    }

    let multiply_limit = -922337203685477580
    let final_digit_limit = if negative { 8 } else { 7 }
    var accumulated = 0
    var out_of_range = false
    for index in start..length {
        let byte = match bytes.get(index) {
            Some(value) => value
            None => { return Err(ParseIntError.InvalidSyntax) }
        }
        if byte < 48 || byte > 57 {
            return Err(ParseIntError.InvalidSyntax)
        }

        if !out_of_range {
            let digit = byte - 48
            if accumulated < multiply_limit || (accumulated == multiply_limit && digit > final_digit_limit) {
                out_of_range = true
            } else {
                accumulated = accumulated * 10 - digit
            }
        }
    }

    if out_of_range {
        return Err(ParseIntError.OutOfRange)
    }

    let parsed = if negative { accumulated } else { -accumulated }
    Ok(parsed)
}
