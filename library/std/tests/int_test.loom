import std.int.ParseIntError
import std.int.maximum
import std.int.minimum
import std.int.parse_int

test fn integer_helpers() {
    let smaller = minimum(4, 9)
    let larger = maximum(4, 9)
    assert smaller == 4
    assert larger == 9
}

test fn integer_parsing() {
    let positive = match parse_int("42") {
        Ok(value) => value == 42
        Err(_) => false
    }
    let negative = match parse_int("-7") {
        Ok(value) => value == -7
        Err(_) => false
    }
    let invalid = match parse_int("") {
        Err(ParseIntError.InvalidSyntax) => true
        _ => false
    }
    let overflow = match parse_int("9223372036854775808") {
        Err(ParseIntError.OutOfRange) => true
        _ => false
    }
    assert positive
    assert negative
    assert invalid
    assert overflow
}
